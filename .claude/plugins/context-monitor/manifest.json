{
  "name": "cursor-framework-context-monitor",
  "version": "1.0.0",
  "description": "Token budget analyzer, session memory inspector, and context routing telemetry",
  "author": "Cursor Enterprise Framework",
  "activationEvents": [
    "onCommand:cursor-framework.context-monitor.stats",
    "onCommand:cursor-framework.context-monitor.inspectPrompt",
    "onCommand:cursor-framework.context-monitor.tokenBudget",
    "onCommand:cursor-framework.context-monitor.redisStats",
    "onCommand:cursor-framework.context-monitor.clearSession"
  ],
  "main": "index.js",
  "contributes": {
    "commands": [
      {
        "command": "cursor-framework.context-monitor.stats",
        "title": "Cursor Framework: Session Memory Stats",
        "category": "Cursor Framework"
      },
      {
        "command": "cursor-framework.context-monitor.inspectPrompt",
        "title": "Cursor Framework: Inspect Context Prompt",
        "category": "Cursor Framework"
      },
      {
        "command": "cursor-framework.context-monitor.tokenBudget",
        "title": "Cursor Framework: Token Budget Analysis",
        "category": "Cursor Framework"
      },
      {
        "command": "cursor-framework.context-monitor.redisStats",
        "title": "Cursor Framework: Redis Observability",
        "category": "Cursor Framework"
      },
      {
        "command": "cursor-framework.context-monitor.clearSession",
        "title": "Cursor Framework: Clear Session Memory",
        "category": "Cursor Framework"
      }
    ],
    "configuration": {
      "title": "Cursor Framework Context Monitor",
      "properties": {
        "cursorFramework.contextMonitor.maxTokens": {
          "type": "number",
          "default": 4000,
          "description": "Default token budget threshold for context injection."
        }
      }
    }
  }
}
