<Window x:Class="CursorSetupWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CursorSetupWpf.ViewModels"
        xmlns:views="clr-namespace:CursorSetupWpf.Views"
        Title="Cursor Enterprise Framework — Setup"
        Width="1200" Height="860"
        MinWidth="960" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Icon="setup.ico"
        Background="{StaticResource FormBackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- === LEFT NAVIGATION SIDEBAR === -->
        <Border Grid.Column="0" Background="{StaticResource NavBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand header -->
                <Border Grid.Row="0" Padding="20,24,20,20">
                    <StackPanel>
                        <!-- Indigo accent bar + title -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="4" CornerRadius="2"
                                    Background="{StaticResource Indigo600Brush}"
                                    Margin="0,0,12,0"/>
                            <TextBlock Text="Cursor Enterprise"
                                      FontFamily="{StaticResource UIFont}"
                                      FontSize="17" FontWeight="SemiBold"
                                      Foreground="White"/>
                        </StackPanel>
                        <TextBlock Text="Framework Setup"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="13"
                                   Foreground="{StaticResource Slate500Brush}"
                                   Margin="16,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Divider -->
                <Border Grid.Row="0" VerticalAlignment="Bottom"
                        BorderBrush="{StaticResource Slate800Brush}"
                        BorderThickness="0,0,0,1"/>

                <!-- Navigation items -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavItems}"
                         SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,12,0,0">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="8,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid x:Name="root">
                                            <!-- Active indicator bar (left edge) -->
                                            <Border x:Name="activeBar" Width="3"
                                                    Background="{StaticResource Indigo600Brush}"
                                                    CornerRadius="0,3,3,0"
                                                    HorizontalAlignment="Left"
                                                    Margin="0,8" Opacity="0"/>

                                            <!-- Content -->
                                            <Border x:Name="bg" Padding="16,12"
                                                    Background="Transparent"
                                                    CornerRadius="8" Margin="0,2">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Icon}"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="18"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Slate400Brush}"
                                                               Margin="0,0,12,0"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background"
                                                        Value="{StaticResource Slate800Brush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="activeBar" Property="Opacity" Value="1"/>
                                                <Setter TargetName="bg" Property="Background"
                                                        Value="{StaticResource Slate800Brush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       FontFamily="{StaticResource UIFont}"
                                       FontSize="14"
                                       Foreground="{StaticResource Slate300Brush}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Language selector -->
                <Border Grid.Row="2" Padding="20,12,20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ngôn ngữ"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource Slate400Brush}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  MinWidth="130"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- === MAIN CONTENT AREA === -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="280"/>
            </Grid.RowDefinitions>

            <!-- Page content (switched by SelectedNavIndex) -->
            <Grid Grid.Row="0" Background="{StaticResource ContentBackgroundBrush}">
                <!-- Fade transition between pages -->
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                From="0" To="1" Duration="0:0:0.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <!-- Page switcher -->
                <Grid>
                    <views:InstallView Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0, FallbackValue=Visible}"/>
                    <views:ComponentsView Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=1, FallbackValue=Collapsed}"/>
                    <views:AdvancedView Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=2, FallbackValue=Collapsed}"/>
                    <views:HooksView Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=3, FallbackValue=Collapsed}"/>
                    <views:GuideView Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=4, FallbackValue=Collapsed}"/>
                </Grid>
            </Grid>

            <!-- === BOTTOM PANEL === -->
            <Border Grid.Row="1" Background="White"
                    BorderBrush="{StaticResource Slate200Brush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Summary row -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding SummaryText}"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Slate900Brush}"
                               Margin="0,10,0,0"
                               VerticalAlignment="Center"/>

                    <!-- Step progress indicator — full row -->
                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Step 1 -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Grid>
                                <Ellipse Width="26" Height="26" Fill="{Binding Step1Fill}"/>
                                <TextBlock Text="{Binding Step1Text}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Step1Label}"
                                       FontSize="11"
                                       Foreground="{StaticResource Slate500Brush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Line 1-2 -->
                        <Border Grid.Column="1" Height="2" Width="50"
                                Background="{Binding StepLine1Fill}"
                                VerticalAlignment="Center" Margin="6,0"/>

                        <!-- Step 2 -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Grid>
                                <Ellipse Width="26" Height="26" Fill="{Binding Step2Fill}"/>
                                <TextBlock Text="{Binding Step2Text}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Step2Label}"
                                       FontSize="11"
                                       Foreground="{StaticResource Slate500Brush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Line 2-3 -->
                        <Border Grid.Column="3" Height="2" Width="50"
                                Background="{Binding StepLine2Fill}"
                                VerticalAlignment="Center" Margin="6,0"/>

                        <!-- Step 3 -->
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <Grid>
                                <Ellipse Width="26" Height="26" Fill="{Binding Step3Fill}"/>
                                <TextBlock Text="{Binding Step3Text}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Step3Label}"
                                       FontSize="11"
                                       Foreground="{StaticResource Slate500Brush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Line 3-4 -->
                        <Border Grid.Column="5" Height="2" Width="50"
                                Background="{Binding StepLine3Fill}"
                                VerticalAlignment="Center" Margin="6,0"/>

                        <!-- Step 4 -->
                        <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                            <Grid>
                                <Ellipse Width="26" Height="26" Fill="{Binding Step4Fill}"/>
                                <TextBlock Text="{Binding Step4Text}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Step4Label}"
                                       FontSize="11"
                                       Foreground="{StaticResource Slate500Brush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Status indicator at right -->
                        <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                     Fill="{StaticResource Emerald600Brush}"/>
                            <TextBlock Text="{Binding StatusText}"
                                       FontFamily="{StaticResource UIFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource Slate500Brush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Thin separator -->
                    <Border Grid.Row="2" Height="1"
                            Background="{StaticResource Slate200Brush}"
                            Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- === LOG + BUTTONS === -->
            <Border Grid.Row="2" Background="{StaticResource LogBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Log output -->
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Auto"
                                  Padding="24,12">
                        <ItemsControl ItemsSource="{Binding LogLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="12"
                                               Foreground="{Binding Converter={StaticResource LogLevelToBrush}}"
                                               TextWrapping="NoWrap"
                                               Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Button strip -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Slate900Brush}"
                            Padding="24,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Install button centered -->
                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding InstallCommand}"
                                    MinWidth="160">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8FB;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding InstallButtonText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
