<Window x:Class="CursorSetupWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CursorSetupWpf.ViewModels"
        xmlns:views="clr-namespace:CursorSetupWpf.Views"
        Title="{Binding WindowTitle}"
        Width="1360" Height="900"
        MinWidth="1080" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Icon="setup.ico"
        Background="{StaticResource FormBackgroundBrush}"
        Focusable="True">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- === LEFT NAVIGATION SIDEBAR ===
             Dark sidebar with accent indicator -->
        <Border Grid.Column="0" Background="{StaticResource NavBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Top Section (Brand + Vibe Coder) -->
                <StackPanel Grid.Row="0">
                    <Border Padding="18,18,18,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="4" Height="20" CornerRadius="2"
                                        Background="{StaticResource Indigo500Brush}"
                                        Effect="{StaticResource IndigoGlow}"
                                        Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding AppBrand}"
                                           FontFamily="{StaticResource UIFont}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="White"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AppBrandSubtitle}"
                                       FontFamily="{StaticResource UIFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource Slate400Brush}"
                                       TextWrapping="Wrap"
                                       Margin="14,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Vibe Coder Selector -->
                    <Border Padding="16,4,16,12">
                        <Border Background="{StaticResource Slate800Brush}" CornerRadius="8" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="&#xE945;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{StaticResource Indigo400Brush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding VibeCoderTitle}"
                                               FontFamily="{StaticResource UIFont}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Slate400Brush}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AvailableAgents}"
                                              SelectedItem="{Binding SelectedAgent}"
                                              DisplayMemberPath="DisplayName"
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              FontSize="11"
                                              MinWidth="160"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- Divider -->
                    <Border BorderBrush="{StaticResource Slate800Brush}"
                            BorderThickness="0,0,0,1"/>
                </StackPanel>

                <!-- Navigation items -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding NavItems}"
                         SelectedIndex="{Binding SelectedNavIndex, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,8,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="8,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Padding="14,9"
                                                Background="Transparent"
                                                CornerRadius="8" Margin="0,1">
                                            <Grid>
                                                <Border x:Name="activeBar" Width="3"
                                                        Background="{StaticResource Indigo500Brush}"
                                                        CornerRadius="0,3,3,0"
                                                        HorizontalAlignment="Left"
                                                        Margin="-16,8"
                                                        Opacity="0"/>
                                                <StackPanel Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Icon}"
                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="16"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Slate400Brush}"
                                                               Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontFamily="{StaticResource UIFont}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Slate300Brush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background"
                                                        Value="{StaticResource Slate800Brush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="activeBar" Property="Opacity" Value="1"/>
                                                <Setter TargetName="bg" Property="Background"
                                                        Value="{StaticResource Slate800Brush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Language selector + version chip -->
                <Border Grid.Row="2" Padding="20,12,20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding LanguageLabel}"
                                       FontFamily="{StaticResource UIFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource Slate400Brush}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource DarkComboBoxStyle}"
                                      MinWidth="130"/>
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource Slate800Brush}" CornerRadius="6" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource Emerald500Brush}"
                                         Effect="{StaticResource EmeraldGlow}"
                                         Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding VersionChip}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Slate300Brush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- === MAIN CONTENT AREA === -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Operational header: make the safe packaging boundary visible
                 before a user starts an install. Only shown on Install page. -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="28,16"
                    Visibility="{Binding IsInstallPage, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding SafetyTitle}"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate900Brush}"/>
                        <TextBlock Text="{Binding SafetyBody}"
                                   FontFamily="{StaticResource UIFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource Slate500Brush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1"
                            Background="{StaticResource Warning100Brush}"
                            BorderBrush="{StaticResource Warning500Brush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,7"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8"
                                     Fill="{StaticResource Warning600Brush}"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SafetyBadge}"
                                       FontFamily="{StaticResource UIFont}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Warning600Brush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Page content (0 to 14 mapped 1:1 with NavItems) -->
            <Grid Grid.Row="1" Background="{StaticResource ContentBackgroundBrush}">
                <Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=0, FallbackValue=Visible}">
                        <views:InstallView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=1, FallbackValue=Collapsed}">
                        <views:VibeCodersView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=2, FallbackValue=Collapsed}">
                        <views:ComponentsView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=3, FallbackValue=Collapsed}">
                        <views:AdvancedView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=4, FallbackValue=Collapsed}">
                        <views:HooksView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=5, FallbackValue=Collapsed}">
                        <views:UtilitiesView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=6, FallbackValue=Collapsed}">
                        <views:McpServersView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=7, FallbackValue=Collapsed}">
                        <views:FrameworkView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=8, FallbackValue=Collapsed}">
                        <views:ProjectRunnerView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=9, FallbackValue=Collapsed}">
                        <views:ScriptGeneratorView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=10, FallbackValue=Collapsed}">
                        <views:ECCView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=11, FallbackValue=Collapsed}">
                        <views:BackupView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=12, FallbackValue=Collapsed}">
                        <views:UpdatesView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=13, FallbackValue=Collapsed}">
                        <views:SettingsView/>
                    </Grid>
                    <Grid Visibility="{Binding SelectedNavIndex, Converter={StaticResource IndexToVisibility}, ConverterParameter=14, FallbackValue=Collapsed}">
                        <views:GuideView/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- === BOTTOM PANEL (Step progress) - Only visible on Install page === -->
            <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource Slate200Brush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{Binding IsInstallPage, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{Binding SummaryText}"
                               FontFamily="{StaticResource UIFont}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource Slate900Brush}"
                               Margin="0,10,0,0"
                               VerticalAlignment="Center"/>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Step 1 -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Grid>
                                <Ellipse x:Name="step1Ring" Width="30" Height="30"
                                         Stroke="{Binding Step1Fill}" StrokeThickness="2"
                                         Fill="Transparent"/>
                                <Ellipse Width="26" Height="26" Fill="{Binding Step1Fill}"/>
                                <TextBlock Text="{Binding Step1Text}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Step1Label}"
                                       FontSize="11"
                                       Foreground="{StaticResource Slate500Brush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="1" Height="2" Width="50"
                                Background="{Binding StepLine1Fill}"
                                VerticalAlignment="Center" Margin="6,0"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Grid>
                                <Ellipse Width="30" Height="30"
                                         Stroke="{Binding Step2Fill}" StrokeThickness="2"
                                         Fill="Transparent"/>
                                <Ellipse Width="26" Height="26" Fill="{Binding Step2Fill}"/>
                                <TextBlock Text="{Binding Step2Text}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Step2Label}"
                                       FontSize="11"
                                       Foreground="{StaticResource Slate500Brush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="3" Height="2" Width="50"
                                Background="{Binding StepLine2Fill}"
                                VerticalAlignment="Center" Margin="6,0"/>

                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <Grid>
                                <Ellipse Width="30" Height="30"
                                         Stroke="{Binding Step3Fill}" StrokeThickness="2"
                                         Fill="Transparent"/>
                                <Ellipse Width="26" Height="26" Fill="{Binding Step3Fill}"/>
                                <TextBlock Text="{Binding Step3Text}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Step3Label}"
                                       FontSize="11"
                                       Foreground="{StaticResource Slate500Brush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Grid.Column="5" Height="2" Width="50"
                                Background="{Binding StepLine3Fill}"
                                VerticalAlignment="Center" Margin="6,0"/>

                        <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                            <Grid>
                                <Ellipse Width="30" Height="30"
                                         Stroke="{Binding Step4Fill}" StrokeThickness="2"
                                         Fill="Transparent"/>
                                <Ellipse Width="26" Height="26" Fill="{Binding Step4Fill}"/>
                                <TextBlock Text="{Binding Step4Text}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Step4Label}"
                                       FontSize="11"
                                       Foreground="{StaticResource Slate500Brush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                     Fill="{StaticResource Emerald500Brush}">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="2"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}"
                                       FontFamily="{StaticResource UIFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource Slate500Brush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="2" Height="1"
                            Background="{StaticResource Slate200Brush}"
                            Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- === COLLAPSIBLE OPERATIONAL LOG DRAWER === -->
            <Border Grid.Row="3" Background="{StaticResource LogBackgroundBrush}"
                    BorderBrush="{StaticResource Slate700Brush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar: always visible, clickable to expand/collapse -->
                    <Border Grid.Row="0" Background="{StaticResource Slate800Brush}"
                            BorderBrush="{StaticResource Slate700Brush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,8"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ToggleLogCommand}"/>
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LogExpandIcon}"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="{StaticResource Slate400Brush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding OperationalLogLabel}"
                                           FontFamily="{StaticResource UIFont}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Slate300Brush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Single-line live preview when collapsed -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LatestLogLine}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource Slate500Brush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="16,0,16,0"
                                       Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding StatusText}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource Slate400Brush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding LogToggleButtonText}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding ToggleLogCommand}"
                                        FontSize="10"
                                        Padding="8,3"
                                        Height="24"
                                        Foreground="{StaticResource Slate400Brush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Expanded Log View (Scrollable lines) -->
                    <Border Grid.Row="1" Height="140"
                            Visibility="{Binding IsLogExpanded, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Padding="20,10">
                            <ItemsControl ItemsSource="{Binding LogLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11"
                                                   Foreground="{Binding Converter={StaticResource LogLevelToBrush}}"
                                                   TextWrapping="NoWrap"
                                                   Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Bottom Action Bar (Install Button on Install page) -->
                    <Border Grid.Row="2"
                            Background="{StaticResource Slate900Brush}"
                            Padding="20,10"
                            Visibility="{Binding IsInstallPage, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding InstallCommand}"
                                    MinWidth="200">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8FB;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding InstallButtonText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- === TOAST LAYER (overlay on top of everything) === -->
        <views:ToastView Grid.Column="0" Grid.ColumnSpan="2"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         IsHitTestVisible="False"/>
    </Grid>
</Window>
