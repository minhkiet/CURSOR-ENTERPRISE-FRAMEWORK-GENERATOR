<UserControl x:Class="CursorSetupWpf.Views.ECCView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CursorSetupWpf.ViewModels"
             Background="{StaticResource ContentBackgroundBrush}">

    <!-- DataContext inherited from parent (MainWindow) - ECC properties accessed via DataContext.ECCViewModel -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28">
        <StackPanel MaxWidth="1000">

            <!-- === Header === -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <!-- Page Title: 24px, weight 600 -->
                    <TextBlock Text="{Binding DataContext.ECCViewModel.ECCTitle, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                               FontFamily="{StaticResource UIFont}" FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DataContext.ECCViewModel.ECCSubtitle, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                               FontFamily="{StaticResource UIFont}" FontSize="14"
                               Foreground="{StaticResource Neutral500Brush}"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource Indigo100Brush}" CornerRadius="8" Padding="12,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ECC v" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   Foreground="{StaticResource Indigo700Brush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.ECCVersion, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource Indigo800Brush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- === Vibe Coder Status Bar === -->
            <Border Background="{StaticResource Indigo50Brush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE945;"
                               FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{StaticResource Indigo500Brush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding DataContext.ECCViewModel.ActiveVibeCoderLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                               FontFamily="{StaticResource UIFont}" FontSize="12"
                               Foreground="{StaticResource Indigo700Brush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding DataContext.ECCViewModel.AvailableVibeTools, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              SelectedItem="{Binding DataContext.ECCViewModel.SelectedVibeTool, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              DisplayMemberPath="LocalizedName"
                              Style="{StaticResource ModernComboBoxStyle}"
                              FontSize="11"
                              MinWidth="160"
                              VerticalAlignment="Center"/>
                    <Border Grid.Column="3" Background="{StaticResource Indigo100Brush}" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10"
                                   Foreground="{StaticResource Indigo600Brush}">
                            <Run Text="{Binding DataContext.ECCViewModel.GateLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                            <Run Text=":"/>
                            <Run Text="{Binding DataContext.ECCViewModel.GatePrefix, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <TextBlock Grid.Column="4"
                               Text="{Binding DataContext.ECCViewModel.SelectedVibeCoder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               FontFamily="{StaticResource UIFont}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource Indigo800Brush}"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- === Status Cards === -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ECC Status -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.StatusLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="11"
                                   Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource Red500Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ECCViewModel.IsECCInstalled, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource Emerald500Brush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding DataContext.ECCViewModel.InstallStatusText, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                       FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Slate800Brush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- agents -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.AgentsLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="11"
                                   Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,4"/>
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Indigo600Brush}">
                            <Run Text="{Binding DataContext.ECCViewModel.AgentCount, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Skills -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0">
                    <StackPanel>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.SkillsLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="11"
                                   Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,4"/>
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Purple600Brush}">
                            <Run Text="{Binding DataContext.ECCViewModel.SkillCount, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Commands -->
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.CommandsLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="11"
                                   Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,4"/>
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Emerald600Brush}">
                            <Run Text="{Binding DataContext.ECCViewModel.CommandCount, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- === Quick Actions === -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="{Binding DataContext.ECCViewModel.CloneRepoLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding DataContext.ECCViewModel.CloneRepositoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,8,0"/>
                    <Button Content="{Binding DataContext.ECCViewModel.RefreshStatusLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding DataContext.ECCViewModel.RefreshStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <CheckBox Content="{Binding DataContext.ECCViewModel.EnableHooksLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                              IsChecked="{Binding DataContext.ECCViewModel.EnableHooks, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              Style="{StaticResource ModernCheckBoxStyle}"
                              VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <ComboBox ItemsSource="{Binding DataContext.ECCViewModel.Profiles, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             SelectedItem="{Binding DataContext.ECCViewModel.SelectedProfile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             DisplayMemberPath="Name"
                             Style="{StaticResource ModernComboBoxStyle}"
                             MinWidth="120"/>
                </StackPanel>
            </Grid>

            <!-- === Harness Selection === -->
            <TextBlock Text="{Binding DataContext.ECCViewModel.HarnessesTitle, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                       FontFamily="{StaticResource UIFont}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource Slate700Brush}" Margin="0,0,0,12"/>

            <ItemsControl ItemsSource="{Binding DataContext.ECCViewModel.HarnessItems, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,0,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Width="220" Margin="0,0,12,12" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                           FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,4"/>

                                <Ellipse Grid.Row="0" Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource Slate300Brush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Emerald500Brush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}"
                                           FontFamily="{StaticResource UIFont}" FontSize="11"
                                           Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap"
                                           Margin="0,0,0,8" MaxHeight="32"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{Binding StatusText}"
                                           FontFamily="{StaticResource UIFont}" FontSize="10"
                                           Foreground="{StaticResource Slate400Brush}"/>

                                <Button Grid.Row="2" Grid.Column="1" Content="{Binding DataContext.ECCViewModel.InstallButtonLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                        Command="{Binding DataContext.ECCViewModel.InstallHarnessCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="8,4" FontSize="10">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- === ECC Features === -->
            <TextBlock Text="{Binding DataContext.ECCViewModel.FeaturesTitle, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                       FontFamily="{StaticResource UIFont}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource Slate700Brush}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Hooks & Memory -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Indigo100Brush}"
                                HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource Indigo600Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.HooksMemoryLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.HooksMemoryDesc, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="11"
                                   Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- AgentShield -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Red100Brush}"
                                HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource Red500Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.AgentShieldLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.AgentShieldDesc, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="11"
                                   Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Workflow -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource Emerald100Brush}"
                                HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource Emerald600Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.WorkflowLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.WorkflowDesc, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="11"
                                   Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- === Install Commands Reference === -->
            <Border Style="{StaticResource CardStyle}" Background="{StaticResource Slate50Brush}">
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.ECCViewModel.InstallCommandsTitle, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                               FontFamily="{StaticResource UIFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.ClaudeCodeLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate600Brush}"/>
                        <TextBlock Grid.Column="1" Text="npx ecc-universal@2.2.2 install --profile core --target claude"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource Indigo600Brush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.CodexLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate600Brush}"/>
                        <TextBlock Grid.Column="1" Text="npx ecc-universal@2.2.2 install --profile core --target codex"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource Indigo600Brush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.CursorLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate600Brush}"/>
                        <TextBlock Grid.Column="1" Text="./install.sh --profile minimal --target cursor"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource Indigo600Brush}"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DataContext.ECCViewModel.GuidedSetupLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"
                                   FontFamily="{StaticResource UIFont}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate600Brush}"/>
                        <TextBlock Grid.Column="1" Text="npx ecc-universal@2.2.2 install --guided"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource Indigo600Brush}"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
