<UserControl x:Class="CursorSetupWpf.Views.McpServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:CursorSetupWpf.Helpers"
             xmlns:models="clr-namespace:CursorSetupWpf.Models"
             Background="{StaticResource ContentBackgroundBrush}">

    <UserControl.Resources>
        <helpers:BoolToBrushConverter x:Key="InstalledBrushConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="32,28,32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding McpTitle}"
                               FontFamily="{StaticResource UIFont}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding McpSubtitle}"
                               FontFamily="{StaticResource UIFont}" FontSize="14"
                               Foreground="{StaticResource Slate500Brush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CheckMcpStatusCommand}"
                            MinWidth="140" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding McpCheckStatusLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SyncMcpCommand}"
                            MinWidth="160">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding McpSyncAllLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Server list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,32">
            <StackPanel MaxWidth="980">
                <!-- Status banner -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20"
                        Background="{StaticResource Indigo50Brush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" CornerRadius="12"
                                Background="{StaticResource Indigo500Brush}"
                                Margin="0,0,16,0">
                            <TextBlock Text="&#xE968;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding McpConfigPathLabel}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource Slate500Brush}"/>
                            <TextBlock Text="{Binding McpLastSyncLabel}"
                                       FontFamily="{StaticResource UIFont}" FontSize="13"
                                       Foreground="{StaticResource Indigo600Brush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center"
                                Background="White" CornerRadius="20" Padding="14,6">
                            <TextBlock FontFamily="{StaticResource UIFont}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Indigo600Brush}">
                                <Run Text="{Binding InstalledCount, Mode=OneWay}"/>
                                <Run Text="/"/>
                                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding McpInstalledLabel, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <!-- Server cards -->
                <ItemsControl ItemsSource="{Binding McpServers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:McpServerStatus}">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status icon -->
                                    <Border Width="48" Height="48" CornerRadius="12"
                                            Background="{Binding IsInstalled, Converter={StaticResource InstalledBrushConverter}}"
                                            Margin="0,0,16,0">
                                        <TextBlock Text="{Binding StatusIcon}"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Slate900Brush}"/>
                                            <Border Margin="10,0,0,0" CornerRadius="6" Padding="8,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#D1FAE5"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                                <Setter Property="Background">
                                                                    <Setter.Value>
                                                                        <SolidColorBrush Color="#FEE2E2"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontFamily="{StaticResource UIFont}" FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#065F46"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                                    <Setter Property="Foreground" Value="#991B1B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <TextBlock.Text>
                                                        <Binding Path="StatusText"/>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   FontFamily="{StaticResource UIFont}" FontSize="12"
                                                   Foreground="{StaticResource Slate500Brush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Name, StringFormat='Server key: {0}'}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource Slate400Brush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding DataContext.OpenMcpConfigCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding ConfigPath}"
                                                Content="{Binding DataContext.McpOpenConfigLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Padding="12,6"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Tools list -->
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE71D;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource Indigo500Brush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding McpDiscoveredToolsLabel}"
                                       FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Slate900Brush}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding McpTools}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:McpToolEntry}">
                                    <Border Style="{StaticResource ChipStyle}" Margin="0,4,6,4" Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE71D;"
                                                       FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                       Foreground="{StaticResource Indigo600Brush}"
                                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource Indigo600Brush}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
