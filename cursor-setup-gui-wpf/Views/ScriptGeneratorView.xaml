<UserControl x:Class="CursorSetupWpf.Views.ScriptGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CursorSetupWpf.ViewModels"
             Background="{StaticResource ContentBackgroundBrush}">
    <UserControl.DataContext>
        <vm:ScriptGeneratorViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- LEFT PANEL: Template List                                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource NavBackgroundBrush}"
                BorderBrush="{StaticResource Slate800Brush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="20,20,20,12">
                    <StackPanel>
                        <TextBlock Text="{Binding ScriptGenTitle}"
                                   FontFamily="{StaticResource UIFont}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding ScriptGenSubtitle}"
                                   FontFamily="{StaticResource UIFont}" FontSize="11"
                                   Foreground="{StaticResource Slate400Brush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Category Filter -->
                <Border Grid.Row="1" Padding="16,0,16,12">
                    <StackPanel>
                        <TextBlock Text="{Binding ScriptGenFilterLabel}"
                                   FontFamily="{StaticResource UIFont}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate400Brush}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  DisplayMemberPath="Value"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Search -->
                <Border Grid.Row="2" Padding="16,0,16,12">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             FontSize="11">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </Border>

                <!-- Template List -->
                <ListBox Grid.Row="3"
                         ItemsSource="{Binding FilteredTemplates}"
                         SelectedItem="{Binding SelectedTemplate}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="0,0,0,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="8,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bg" Padding="12,10"
                                                Background="Transparent"
                                                CornerRadius="8" Margin="0,2">
                                            <Grid>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          VerticalAlignment="Top" HorizontalAlignment="Right"
                                                          Margin="0,-4,-4,0" Opacity="0.6"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="{StaticResource UIFont}" FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource Slate200Brush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               FontFamily="{StaticResource UIFont}" FontSize="10"
                                                               Foreground="{StaticResource Slate500Brush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxHeight="30" TextWrapping="Wrap"
                                                               Margin="0,2,16,0"/>
                                                    <Border Background="{Binding Category, Converter={StaticResource CategoryToColorBrush}}"
                                                            CornerRadius="4" Padding="6,2"
                                                            HorizontalAlignment="Left" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding Category}"
                                                                   FontFamily="{StaticResource UIFont}"
                                                                   FontSize="9" FontWeight="SemiBold"
                                                                   Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bg" Property="Background"
                                                        Value="{StaticResource Slate800Brush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bg" Property="Background"
                                                        Value="{StaticResource Indigo900Brush}"/>
                                                <Setter TargetName="bg" Property="BorderBrush"
                                                        Value="{StaticResource Indigo500Brush}"/>
                                                <Setter TargetName="bg" Property="BorderThickness" Value="0,0,0,2"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Select All / Deselect All -->
                <Border Grid.Row="4" Padding="16,12">
                    <StackPanel>
                        <Button Content="{Binding BtnSelectAll}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SelectAllCommand}"
                                Padding="12,6" FontSize="11" Margin="0,0,0,6"/>
                        <Button Content="{Binding BtnDeselectAll}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DeselectAllCommand}"
                                Padding="12,6" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- RIGHT PANEL: Script Editor & Output                              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── Options Bar ─── -->
            <Border Grid.Row="0" Background="White"
                    BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,0,0,1"
                    Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Project path -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ScriptGenProjectLabel}"
                                   FontFamily="{StaticResource UIFont}" FontSize="12"
                                   Foreground="{StaticResource Slate600Brush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 MinWidth="280" VerticalAlignment="Center"/>
                        <Button Content="..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding BrowseProjectCommand}"
                                Padding="8,4" FontSize="11" Margin="8,0,0,0"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Output dir -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="{Binding ScriptGenOutputLabel}"
                                   FontFamily="{StaticResource UIFont}" FontSize="12"
                                   Foreground="{StaticResource Slate600Brush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Text="{Binding OutputDir, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 MinWidth="200" VerticalAlignment="Center"/>
                        <Button Content="..."
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding BrowseOutputCommand}"
                                Padding="8,4" FontSize="11" Margin="8,0,0,0"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Use PowerShell -->
                    <CheckBox Grid.Column="2" Content="{Binding ScriptGenUsePsLabel}"
                              IsChecked="{Binding UsePowerShell}"
                              VerticalAlignment="Center" Margin="24,0,0,0"
                              FontFamily="{StaticResource UIFont}" FontSize="12"
                              Foreground="{StaticResource Slate700Brush}"/>

                    <!-- Selected count -->
                    <Border Grid.Column="3" Background="{StaticResource Indigo50Brush}"
                            CornerRadius="8" Padding="12,6" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock FontFamily="{StaticResource UIFont}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Indigo700Brush}">
                            <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding ScriptUnitsLabel, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>

                    <!-- Generate buttons -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0,0,0">
                        <Button Content="{Binding BtnGenerateSelected}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding GenerateSelectedCommand}"
                                Padding="14,7" FontSize="11" Margin="0,0,8,0"/>
                        <Button Content="{Binding BtnGenerateAll}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding GenerateAllCommand}"
                                Padding="14,7" FontSize="11"
                                ToolTip="{Binding ScriptGenGenerateAllTip}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ─── Main content: Preview + Blocks ─── -->
            <Grid Grid.Row="1" Margin="24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Block list for selected template -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="16,16,16,12">
                            <TextBlock Text="{Binding ScriptGenBlocksLabel}"
                                       FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding SelectedTemplate.Name}"
                                       FontFamily="{StaticResource UIFont}" FontSize="11"
                                       Foreground="{StaticResource Slate500Brush}"/>
                        </StackPanel>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SelectedTemplate.Blocks}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="8,2"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bg" Padding="12,10"
                                                        Background="{StaticResource Slate50Brush}"
                                                        CornerRadius="8" Margin="0,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  VerticalAlignment="Top" Margin="0,2,10,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontFamily="{StaticResource UIFont}" FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource Slate800Brush}"/>
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontFamily="{StaticResource UIFont}" FontSize="10"
                                                                       Foreground="{StaticResource Slate500Brush}"
                                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       MaxHeight="36"/>
                                                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                                       Foreground="{StaticResource Slate400Brush}"
                                                                       Margin="0,4,0,0">
                                                                <Run Text="{Binding Lines.Count, Mode=OneWay}"/>
                                                                <Run Text=" "/>
                                                                <Run Text="{Binding DataContext.CommandUnitsLabel, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bg" Property="Background"
                                                                Value="{StaticResource Indigo50Brush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Right: Script preview -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Preview header -->
                        <Border Grid.Row="0" Padding="16,12"
                                BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding ScriptGenPreviewLabel}"
                                               FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Slate800Brush}"/>
                                    <TextBlock Text="{Binding SelectedTemplate.FileName}"
                                               FontFamily="{StaticResource MonoFont}" FontSize="10"
                                               Foreground="{StaticResource Slate500Brush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="{Binding BtnCopyPreview}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding CopyPreviewCommand}"
                                            Padding="10,5" FontSize="10" Margin="0,0,6,0"/>
                                    <Button Content="{Binding BtnSavePreview}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SavePreviewCommand}"
                                            Padding="10,5" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Script content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Background="{StaticResource Slate900Brush}">
                            <TextBox Text="{Binding PreviewContent, Mode=OneWay}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     Foreground="#A5F3FC"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     Padding="16,12"
                                     VerticalScrollBarVisibility="Hidden"
                                     HorizontalScrollBarVisibility="Hidden"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ─── Bottom: Status & Results ─── -->
            <Border Grid.Row="2" Background="White"
                    BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,1,0,0"
                    Padding="24,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status message -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding StatusMessage}"
                               FontFamily="{StaticResource UIFont}" FontSize="12"
                               Foreground="{StaticResource Slate600Brush}"
                               VerticalAlignment="Center"/>

                    <!-- Open output folder button -->
                    <Button Grid.Column="1"
                            Content="{Binding BtnOpenOutput}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OpenOutputCommand}"
                            Padding="14,6" FontSize="11"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
