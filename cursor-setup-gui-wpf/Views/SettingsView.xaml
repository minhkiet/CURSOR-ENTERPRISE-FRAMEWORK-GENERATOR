<UserControl x:Class="CursorSetupWpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ContentBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="32,28,32,16">
            <StackPanel>
                <TextBlock Text="{Binding SettingsTitle}"
                           FontFamily="{StaticResource UIFont}" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding SettingsSubtitle}"
                           FontFamily="{StaticResource UIFont}" FontSize="14"
                           Foreground="{StaticResource Slate500Brush}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,32">
            <StackPanel MaxWidth="900">

                <!-- Appearance -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="&#xE790;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource Indigo500Brush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SettingsAppearanceLabel}"
                                       FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Slate900Brush}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding SettingsThemeLabel}"
                                   FontFamily="{StaticResource UIFont}" FontSize="12"
                                   Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,8"/>

                        <ComboBox ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  MinWidth="240" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Startup -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE7E8;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource Indigo500Brush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SettingsStartupLabel}"
                                       FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Slate900Brush}"/>
                        </StackPanel>

                        <CheckBox Content="{Binding SettingsAutostartLabel}"
                                  IsChecked="{Binding AutoStartWithWindows}"
                                  Style="{StaticResource ModernCheckBoxStyle}"/>
                        <TextBlock Text="{Binding SettingsAutostartDescLabel}"
                                   FontFamily="{StaticResource UIFont}" FontSize="12"
                                   Foreground="{StaticResource Slate500Brush}"
                                   Margin="30,4,0,0" TextWrapping="Wrap" MaxWidth="600"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- Notifications -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE91F;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource Indigo500Brush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SettingsNotificationsLabel}"
                                       FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Slate900Brush}"/>
                        </StackPanel>

                        <CheckBox Content="{Binding SettingsNotifyCompleteLabel}"
                                  IsChecked="{Binding NotifyOnComplete}"
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,8"/>
                        <CheckBox Content="{Binding SettingsNotifyErrorLabel}"
                                  IsChecked="{Binding NotifyOnError}"
                                  Style="{StaticResource ModernCheckBoxStyle}"/>
                    </StackPanel>
                </Border>

                <!-- Logs -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE756;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource Indigo500Brush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SettingsLoggingLabel}"
                                       FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Slate900Brush}"/>
                        </StackPanel>

                        <TextBlock Text="{Binding SettingsLogPathLabel}"
                                   FontFamily="{StaticResource UIFont}" FontSize="12"
                                   Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,6"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding LogFileLocation, Mode=TwoWay}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     IsReadOnly="True"
                                     Margin="0,0,8,0"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BrowseLogLocationCommand}"
                                    Content="{Binding SettingsBrowseLabel}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding SaveSettingsCommand}"
                        HorizontalAlignment="Right" MinWidth="160">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SettingsSaveLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
