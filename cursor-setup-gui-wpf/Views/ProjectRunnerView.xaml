<UserControl x:Class="CursorSetupWpf.Views.ProjectRunnerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ContentBackgroundBrush}">
    <UserControl.DataContext>
        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext"/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,28">
        <StackPanel MaxWidth="1000">

            <!-- === Header === -->
            <TextBlock Text="{Binding ProjectRunnerTitle}"
                       FontFamily="{StaticResource UIFont}" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding ProjectRunnerSubtitle}"
                       FontFamily="{StaticResource UIFont}" FontSize="13"
                       Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,24"/>

            <!-- === Status Banner === -->
            <Border x:Name="StatusBanner" CornerRadius="12" Padding="16,12" Margin="0,0,0,20"
                    Visibility="{Binding IsProjectRunnerRunning, Converter={StaticResource BoolToVisibility}}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#059669" Offset="0"/>
                        <GradientStop Color="#10B981" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="10" Height="10" Fill="#6EE7B7" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <BlurEffect Radius="4"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="Running framework command..."
                               FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="#D1FAE5" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelProjectRunnerCommand}"
                            Padding="16,6" FontSize="11"/>
                </Grid>
            </Border>

            <!-- === Project Selection === -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Binding ProjectRunnerSelectProjectLabel}"
                               FontFamily="{StaticResource UIFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,12"/>

                    <!-- Current Path Display -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProjectRunnerCurrentPathLabel}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource Slate500Brush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Border Grid.Column="1" Background="{StaticResource Slate50Brush}"
                                CornerRadius="6" Padding="12,8">
                            <TextBlock Text="{Binding SelectedProjectPath}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{StaticResource Slate700Brush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>

                    <!-- Browse Button -->
                    <Button Content="{Binding ProjectRunnerBrowseLabel}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding BrowseProjectPathCommand}"
                            HorizontalAlignment="Left" Padding="20,8"/>
                </StackPanel>
            </Border>

            <!-- === Quick Actions === -->
            <TextBlock Text="{Binding ProjectRunnerRunOnProjectLabel}"
                       FontFamily="{StaticResource UIFont}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource Slate700Brush}" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Scan -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Slate100Brush}"
                                HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource Slate600Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Scan" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Scan .cursor/ folder" FontFamily="{StaticResource UIFont}" FontSize="10"
                                   Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Content="Run" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RunProjectScanCommand}"
                                Padding="10,5" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Index -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Indigo100Brush}"
                                HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource Indigo600Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Build Index" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Generate INDEX.json" FontFamily="{StaticResource UIFont}" FontSize="10"
                                   Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Content="Run" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RunProjectIndexCommand}"
                                Padding="10,5" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Warm -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Amber100Brush}"
                                HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource Amber600Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Warm Cache" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Preload &amp; persist" FontFamily="{StaticResource UIFont}" FontSize="10"
                                   Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Content="Run" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RunProjectWarmCommand}"
                                Padding="10,5" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Stats -->
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                    <StackPanel>
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource Cyan100Brush}"
                                HorizontalAlignment="Left" Margin="0,0,0,10">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource Cyan600Brush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Stats" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,4"/>
                        <TextBlock Text="View statistics" FontFamily="{StaticResource UIFont}" FontSize="10"
                                   Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Button Content="Run" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RunProjectStatsCommand}"
                                Padding="10,5" FontSize="11"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- === Ask Section === -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Ask the Framework"
                               FontFamily="{StaticResource UIFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Slate800Brush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Run a natural language request through the workflow pipeline"
                               FontFamily="{StaticResource UIFont}" FontSize="12"
                               Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,12"/>

                    <TextBox Text="{Binding ProjectRunnerAskRequest, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource UIFont}" FontSize="13"
                             Padding="12,10" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="{StaticResource Slate50Brush}"
                             BorderBrush="{StaticResource Slate200Brush}"
                             BorderThickness="1" Margin="0,0,0,12">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Type your request here..." 
                                                                   Foreground="{StaticResource Slate400Brush}"
                                                                   FontStyle="Italic" Margin="12,10,0,0"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Content="Run Ask" Style="{StaticResource PrimaryButtonStyle}"
                             Command="{Binding RunProjectAskCommand}"
                             HorizontalAlignment="Left" Padding="24,10"/>
                </StackPanel>
            </Border>

            <!-- === Output Panel === -->
            <Border Style="{StaticResource CardStyle}" Background="{StaticResource Slate900Brush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Output" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate300Brush}"/>
                        <Button Content="Clear" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearProjectOutputCommand}"
                                HorizontalAlignment="Right" Padding="12,4" FontSize="10"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                                  HorizontalScrollBarVisibility="Auto" MaxHeight="400">
                        <TextBlock Text="{Binding ProjectRunnerOutput}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource Slate300Brush}"
                                   TextWrapping="Wrap" Padding="8"/>
                    </ScrollViewer>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
