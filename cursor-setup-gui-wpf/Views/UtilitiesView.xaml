<UserControl x:Class="CursorSetupWpf.Views.UtilitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ContentBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <TextBlock Text="{Binding UtilitiesTitle}" FontFamily="{StaticResource UIFont}" FontSize="24"
                       FontWeight="SemiBold" Foreground="{StaticResource Slate900Brush}"/>
            <TextBlock Text="{Binding UtilitiesSubtitle}" FontFamily="{StaticResource UIFont}" FontSize="14"
                       Foreground="{StaticResource Neutral500Brush}" Margin="0,5,0,22" TextWrapping="Wrap"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{Binding SkillImportTitle}" FontFamily="{StaticResource UIFont}" FontSize="17"
                               FontWeight="SemiBold" Foreground="{StaticResource Slate900Brush}"/>
                    <TextBlock Text="{Binding SkillImportSubtitle}" FontFamily="{StaticResource UIFont}" FontSize="12"
                               Foreground="{StaticResource Slate500Brush}" Margin="0,5,0,16" TextWrapping="Wrap"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SkillRepoLabel}" Foreground="{StaticResource Slate600Brush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding GithubRepository, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Tag="vd: owner/repository hoặc https://github.com/..." ToolTip="owner/repository or https://github.com/owner/repository"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SkillPathLabel}" Foreground="{StaticResource Slate600Brush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding GithubSkillPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Tag="vd: skills/my-skill" ToolTip="Repository-relative folder or SKILL.md path"/>
                        <TextBox Grid.Column="2" Text="{Binding GithubReference, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Tag="main" Margin="10,0,0,0" ToolTip="Branch or tag"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SkillNameLabel}" Foreground="{StaticResource Slate600Brush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding GithubSkillName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Tag="Tên skill đích (tùy chọn)"/>
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SkillWorkspaceLabel}" Foreground="{StaticResource Slate600Brush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding GithubWorkspaceRoot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Tag="Thư mục workspace"/>
                        <Button Grid.Column="2" Content="{Binding SkillBrowseLabel}" Style="{StaticResource GhostButtonStyle}" Command="{Binding BrowseWorkspaceRootCommand}" Margin="10,0,0,0"/>
                        <Button Grid.Column="3" Content="{Binding SkillOpenLabel}" Style="{StaticResource GhostButtonStyle}" Command="{Binding OpenWorkspaceRootCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SkillTargetLabel}" Foreground="{StaticResource Slate600Brush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding GithubTargetPath}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource Slate500Brush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding SkillValidateLabel}" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ValidateGithubSkillCommand}" Margin="0,0,8,0"/>
                            <Button Content="{Binding SkillImportLabel}" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding ImportGithubSkillCommand}" IsEnabled="{Binding CanImportGithubSkill}"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Background="{StaticResource Warning100Brush}" BorderBrush="{StaticResource Warning500Brush}"
                                BorderThickness="1" CornerRadius="7" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SkillRuntimeLabel}" Foreground="{StaticResource Warning600Brush}" FontSize="11"/>
                                <TextBlock Text="  " Foreground="{StaticResource Warning600Brush}"/>
                                <TextBlock Text="{Binding GithubRuntimeStatus}" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                                           Foreground="{StaticResource Warning600Brush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding GithubImportSummary}" Foreground="{StaticResource Slate600Brush}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding GithubImportOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Height="110" Style="{StaticResource ModernTextBoxStyle}" FontFamily="{StaticResource MonoFont}" FontSize="10" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding GovernanceToolsTitle}" FontFamily="{StaticResource UIFont}" FontSize="17"
                               FontWeight="SemiBold" Foreground="{StaticResource Slate900Brush}"/>
                    <TextBlock Text="Whole-ecosystem verdict remains BLOCKED until real owner, dependency and approval evidence exists. These utilities are read-only/operational checks."
                               FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}" Margin="0,5,0,14" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding OpenGovernanceLabel}" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenGovernanceCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding GovernanceScanLabel}" Style="{StaticResource GhostButtonStyle}" Command="{Binding RunGovernanceScanCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding RuntimeRefreshLabel}" Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshPythonRuntimeCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
