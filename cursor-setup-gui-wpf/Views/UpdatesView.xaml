<UserControl x:Class="CursorSetupWpf.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ContentBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="32,28,32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding UpdatesTitle}"
                               FontFamily="{StaticResource UIFont}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding UpdatesSubtitle}"
                               FontFamily="{StaticResource UIFont}" FontSize="14"
                               Foreground="{StaticResource Slate500Brush}"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding CheckForUpdatesCommand}" MinWidth="180">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding UpdatesCheckLabel}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,32">
            <StackPanel MaxWidth="900">

                <!-- Status banner -->
                <Border CornerRadius="16" Padding="24,20" Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#4F46E5" Offset="0"/>
                            <GradientStop Color="#7C3AED" Offset="0.5"/>
                            <GradientStop Color="#059669" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="56" Height="56" CornerRadius="14"
                                Background="#1AFFFFFF" Margin="0,0,20,0">
                            <TextBlock Text="&#xE895;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UpdateStatusText}"
                                       FontFamily="{StaticResource UIFont}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock Text="{Binding LastCheckedLabel}"
                                       FontFamily="{StaticResource UIFont}" FontSize="12"
                                       Foreground="#E0E7FF" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GlassButtonStyle}"
                                Command="{Binding DownloadUpdateCommand}"
                                VerticalAlignment="Center"
                                Content="{Binding UpdatesDownloadLabel}"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Border>

                <!-- Version comparison -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding UpdatesCurrentVersionLabel}"
                                       FontFamily="{StaticResource UIFont}" FontSize="12"
                                       Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding CurrentVersion}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource Slate900Brush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding UpdatesLatestVersionLabel}"
                                       FontFamily="{StaticResource UIFont}" FontSize="12"
                                       Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding LatestVersion}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="20" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource Slate900Brush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource Emerald600Brush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Changelog -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE8A5;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource Indigo500Brush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding UpdatesChangelogLabel}"
                                       FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Slate900Brush}"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ChangelogEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" CornerRadius="8" Margin="0,4"
                                            Background="{StaticResource Slate50Brush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Version}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{StaticResource Indigo600Brush}"
                                                       VerticalAlignment="Top" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Date, StringFormat='yyyy-MM-dd'}"
                                                           FontFamily="{StaticResource UIFont}" FontSize="11"
                                                           Foreground="{StaticResource Slate400Brush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Description}"
                                                           FontFamily="{StaticResource UIFont}" FontSize="13"
                                                           Foreground="{StaticResource Slate700Brush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
