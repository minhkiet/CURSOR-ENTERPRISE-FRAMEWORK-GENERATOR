<UserControl x:Class="CursorSetupWpf.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ContentBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel MaxWidth="900">

            <!-- === Welcome Banner === -->
            <Border CornerRadius="16" Padding="28,24" Margin="0,0,0,28">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0"/>
                        <GradientStop Color="#7C3AED" Offset="0.5"/>
                        <GradientStop Color="#059669" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Huong dan su dung"
                                   FontFamily="{StaticResource UIFont}" FontSize="22" FontWeight="Bold"
                                   Foreground="White" Margin="0,0,0,8"/>
                        <TextBlock Text="Cursor Enterprise Framework Setup - Cai dat trong 5 buoc don gian."
                                   FontFamily="{StaticResource UIFont}" FontSize="14"
                                   Foreground="#E0E7FF" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="64" Height="64" CornerRadius="16"
                            Background="#FFFFFF15" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="32"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- === Step-by-step Guide === -->
            <TextBlock Text="Cac buoc cai dat"
                       FontFamily="{StaticResource UIFont}" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,20"/>

            <!-- Step 1 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Ellipse Width="40" Height="40" Fill="{StaticResource Indigo600Brush}"/>
                    <TextBlock Text="1" FontFamily="{StaticResource UIFont}" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle Width="2" Height="60" Fill="{StaticResource Slate200Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-20"/>
                </Grid>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Chon duong dan cai dat"
                                   FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Nhan 'Duyet...' de chon thu muc hoac 'Tao thu muc' de tao thu muc .cursor moi. Duong dan mac dinh la ~/.cursor (thu muc cau hinh Cursor)."
                                   FontFamily="{StaticResource UIFont}" FontSize="13"
                                   Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource Indigo50Brush}" CornerRadius="8"
                                Padding="12,8" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Indigo500Brush}" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="Neu ban da cai framework truoc do, chuong trinh se hoi co ghi de file hien co hay khong."
                                           FontFamily="{StaticResource UIFont}" FontSize="12"
                                           Foreground="{StaticResource Indigo600Brush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Step 2 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Ellipse Width="40" Height="40" Fill="{StaticResource Indigo600Brush}"/>
                    <TextBlock Text="2" FontFamily="{StaticResource UIFont}" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle Width="2" Height="60" Fill="{StaticResource Slate200Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-20"/>
                </Grid>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Chon thanh phan muon cai"
                                   FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Chuyen sang tab Thanh phan de chon:"
                                   FontFamily="{StaticResource UIFont}" FontSize="13"
                                   Foreground="{StaticResource Slate600Brush}"/>
                        <StackPanel Margin="16,4,0,0">
                            <TextBlock Text="- rules: qui tac va nguyen tac phat trien" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                            <TextBlock Text="- skills: ky nang chuyen biet cho AI agent" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                            <TextBlock Text="- agents: Prompt cho Claude, GPT, Gemini" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                            <TextBlock Text="- commands: Lenh tat cho Cursor IDE" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                            <TextBlock Text="- hooks: Integration scripts cho automation" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                            <TextBlock Text="- knowledge: Co so tri thuc va tai lieu" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Step 3 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Ellipse Width="40" Height="40" Fill="{StaticResource Indigo600Brush}"/>
                    <TextBlock Text="3" FontFamily="{StaticResource UIFont}" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle Width="2" Height="60" Fill="{StaticResource Slate200Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-20"/>
                </Grid>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Cau hinh tuy chon nang cao"
                                   FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Tab Nang cao chua cac tai nguyen tuy chon. Tab Hooks cho phep bat/tat tich hop Python framework (cursor_framework) - bo chon neu khong can."
                                   FontFamily="{StaticResource UIFont}" FontSize="13"
                                   Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Step 4 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Ellipse Width="40" Height="40" Fill="{StaticResource Indigo600Brush}"/>
                    <TextBlock Text="4" FontFamily="{StaticResource UIFont}" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle Width="2" Height="60" Fill="{StaticResource Slate200Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-20"/>
                </Grid>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Kiem tra lai cac tuy chon"
                                   FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,6"/>
                        <TextBlock Text="Doc ky cac tuy chon da chon. Nhan 'Chon tat ca' / 'Bo chon tat ca' de nhanh chong dieu chinh. Thanh trang thai o duoi cho biet so thanh phan da chon."
                                   FontFamily="{StaticResource UIFont}" FontSize="13"
                                   Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Step 5 -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Ellipse Width="40" Height="40" Fill="{StaticResource Emerald600Brush}"/>
                    <TextBlock Text="5" FontFamily="{StaticResource UIFont}" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0"
                        Background="{StaticResource Emerald600Brush}" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="Nhan Install de bat dau cai dat"
                                   FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,0,0,6"/>
                        <TextBlock Text="Qua trinh cai dat se hien thi log chi tiet. Sau khi hoan tat, khoi dong lai Cursor IDE de tai cac thanh phan moi."
                                   FontFamily="{StaticResource UIFont}" FontSize="13"
                                   Foreground="#D1FAE5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- === About Framework === -->
            <Border Style="{StaticResource CardStyle}" Background="{StaticResource Slate100Brush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE946;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{StaticResource Slate500Brush}" VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock Text="Ve Cursor Enterprise Framework"
                                   FontFamily="{StaticResource UIFont}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate800Brush}"/>
                    </StackPanel>
                    <TextBlock Text="Cursor Enterprise Framework la bo cong cu phat trien AI-augmented cho Cursor IDE. Bao gom:"
                               FontFamily="{StaticResource UIFont}" FontSize="13"
                               Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Kien truc &amp; Thiet ke" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Clean Architecture, Hexagonal Architecture, CQRS, Event Sourcing, Domain-Driven Design" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="AI Agent Skills" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Karpathy coding discipline, Ponytail lazy senior, Vibe coding overlay, Frontend review" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Development Tools" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Build Memory, Knowledge Compiler, Project Indexer, Embeddings Builder" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Deployment &amp; Ops" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Vercel, Cloudflare, Docker, Kubernetes, Serverless, CI/CD templates" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
