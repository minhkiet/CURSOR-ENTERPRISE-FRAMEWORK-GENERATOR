<UserControl x:Class="CursorSetupWpf.Views.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CursorSetupWpf.ViewModels"
             Background="{StaticResource ContentBackgroundBrush}">

    <UserControl.DataContext>
        <vm:GuideViewModel/>
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28">
        <StackPanel MaxWidth="900">

            <!-- === Welcome Banner === -->
            <Border CornerRadius="16" Padding="28,24" Margin="0,0,0,28">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0"/>
                        <GradientStop Color="#7C3AED" Offset="0.5"/>
                        <GradientStop Color="#059669" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding WelcomeTitle}"
                                   FontFamily="{StaticResource UIFont}" FontSize="22" FontWeight="Bold"
                                   Foreground="White" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding WelcomeSubtitle}"
                                   FontFamily="{StaticResource UIFont}" FontSize="14"
                                   Foreground="#E0E7FF" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="64" Height="64" CornerRadius="16"
                            Background="#FFFFFF15" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WelcomeIcon}"
                                   FontFamily="Segoe MDL2 Assets" FontSize="32"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- === Step-by-step Guide === -->
            <TextBlock Text="{Binding StepsTitle}"
                       FontFamily="{StaticResource UIFont}" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,20"/>

            <!-- Step 1 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Ellipse Width="40" Height="40" Fill="{StaticResource Indigo600Brush}"/>
                    <TextBlock Text="1" FontFamily="{StaticResource UIFont}" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle Width="2" Height="60" Fill="{StaticResource Slate200Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-20"/>
                </Grid>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Step1Title}"
                                   FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Step1Description}"
                                   FontFamily="{StaticResource UIFont}" FontSize="13"
                                   Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap"/>
                        <Border Background="{StaticResource Indigo50Brush}" CornerRadius="8"
                                Padding="12,8" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding InfoIcon}"
                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="{StaticResource Indigo500Brush}" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Step1Tip}"
                                           FontFamily="{StaticResource UIFont}" FontSize="12"
                                           Foreground="{StaticResource Indigo600Brush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Step 2 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Ellipse Width="40" Height="40" Fill="{StaticResource Indigo600Brush}"/>
                    <TextBlock Text="2" FontFamily="{StaticResource UIFont}" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle Width="2" Height="60" Fill="{StaticResource Slate200Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-20"/>
                </Grid>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Step2Title}"
                                   FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Step2Description}"
                                   FontFamily="{StaticResource UIFont}" FontSize="13"
                                   Foreground="{StaticResource Slate600Brush}"/>
                        <StackPanel Margin="16,4,0,0">
                            <TextBlock Text="{Binding Step2Item1}" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                            <TextBlock Text="{Binding Step2Item2}" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                            <TextBlock Text="{Binding Step2Item3}" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                            <TextBlock Text="{Binding Step2Item4}" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                            <TextBlock Text="{Binding Step2Item5}" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                            <TextBlock Text="{Binding Step2Item6}" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Step 3 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Ellipse Width="40" Height="40" Fill="{StaticResource Indigo600Brush}"/>
                    <TextBlock Text="3" FontFamily="{StaticResource UIFont}" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle Width="2" Height="60" Fill="{StaticResource Slate200Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-20"/>
                </Grid>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Step3Title}"
                                   FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Step3Description}"
                                   FontFamily="{StaticResource UIFont}" FontSize="13"
                                   Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Step 4 -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Ellipse Width="40" Height="40" Fill="{StaticResource Indigo600Brush}"/>
                    <TextBlock Text="4" FontFamily="{StaticResource UIFont}" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle Width="2" Height="60" Fill="{StaticResource Slate200Brush}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,-20"/>
                </Grid>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Step4Title}"
                                   FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Step4Description}"
                                   FontFamily="{StaticResource UIFont}" FontSize="13"
                                   Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Step 5 -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid>
                    <Ellipse Width="40" Height="40" Fill="{StaticResource Emerald600Brush}"/>
                    <TextBlock Text="5" FontFamily="{StaticResource UIFont}" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="12,0,0,0"
                        Background="{StaticResource Emerald600Brush}" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="{Binding Step5Title}"
                                   FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="White" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding Step5Description}"
                                   FontFamily="{StaticResource UIFont}" FontSize="13"
                                   Foreground="#D1FAE5" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- === About Framework === -->
            <Border Style="{StaticResource CardStyle}" Background="{StaticResource Slate100Brush}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="{Binding InfoIcon}"
                                   FontFamily="Segoe MDL2 Assets" FontSize="20"
                                   Foreground="{StaticResource Slate500Brush}" VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding AboutTitle}"
                                   FontFamily="{StaticResource UIFont}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Slate800Brush}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AboutIntro}"
                               FontFamily="{StaticResource UIFont}" FontSize="13"
                               Foreground="{StaticResource Slate600Brush}" TextWrapping="Wrap"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding ArchitectureTitle}" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ArchitectureDesc}" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding AiAgentTitle}" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding AiAgentDesc}" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding DevToolsTitle}" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DevToolsDesc}" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding DeployOpsTitle}" FontFamily="{StaticResource UIFont}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DeployOpsDesc}" FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
