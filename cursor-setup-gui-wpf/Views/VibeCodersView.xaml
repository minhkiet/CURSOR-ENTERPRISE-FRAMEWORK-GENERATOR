<UserControl x:Class="CursorSetupWpf.Views.VibeCodersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource ContentBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding AgentHubTitle}" FontFamily="{StaticResource UIFont}" FontSize="24"
                               FontWeight="SemiBold" Foreground="{StaticResource Slate900Brush}"/>
                    <TextBlock Text="{Binding AgentHubSubtitle}" FontFamily="{StaticResource UIFont}" FontSize="14"
                               Foreground="{StaticResource Neutral500Brush}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource Slate100Brush}" BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <TextBlock Text="{Binding AgentFleetSummary}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource Slate600Brush}"/>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding AgentTitle}" FontFamily="{StaticResource UIFont}" FontSize="16"
                                   FontWeight="SemiBold" Foreground="{StaticResource Slate900Brush}"/>
                        <TextBlock Text="{Binding AgentSelectionHint}"
                                   FontFamily="{StaticResource UIFont}" FontSize="12" Foreground="{StaticResource Slate500Brush}"
                                   Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding AgentSelectAllLabel}" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding SelectAllAgentsCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding AgentDeselectAllLabel}" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding DeselectAllAgentsCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding AgentInstallSelectedLabel}" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding InstallSelectedAgentsCommand}" Margin="0,0,8,0"/>
                        <Button Content="{Binding AgentSyncSelectedLabel}" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding SyncSelectedMcpCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{Binding AvailableAgents}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,10,12" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource ModernCheckBoxStyle}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource UIFont}" FontSize="15"
                                                   FontWeight="SemiBold" Foreground="{StaticResource Slate900Brush}"/>
                                    </CheckBox>
                                    <Border Background="{Binding StatusBrush}" CornerRadius="6" Padding="8,4"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusLabel}" FontFamily="{StaticResource UIFont}" FontSize="10"
                                                   FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding InstallPath}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                           Foreground="{StaticResource Slate500Brush}" TextTrimming="CharacterEllipsis" Margin="0,10,0,8"/>
                                <Grid Grid.Row="2">
                                    <TextBlock Text="{Binding SupportSummary}" FontFamily="{StaticResource UIFont}" FontSize="11"
                                               Foreground="{StaticResource Slate500Brush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{Binding DataContext.AgentDocsLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource GhostButtonStyle}" FontSize="11" Padding="10,6"
                                                Command="{Binding DataContext.OpenAgentDocsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding InstallUrl}" Margin="0,0,6,0"/>
                                        <Button Content="{Binding DataContext.AgentOpenFolderLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Style="{StaticResource SecondaryButtonStyle}" FontSize="11" Padding="10,6"
                                                Command="{Binding DataContext.OpenAgentFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
