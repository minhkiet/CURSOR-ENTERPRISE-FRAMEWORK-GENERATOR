<UserControl x:Class="CursorSetupWpf.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CursorSetupWpf.Models"
             Background="{StaticResource ContentBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="32,28,32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding BackupTitle}"
                               FontFamily="{StaticResource UIFont}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource Slate900Brush}" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding BackupSubtitle}"
                               FontFamily="{StaticResource UIFont}" FontSize="14"
                               Foreground="{StaticResource Slate500Brush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding RefreshBackupsCommand}"
                            Content="{Binding BackupRefreshLabel}"
                            Padding="14,8" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CreateBackupCommand}" MinWidth="180">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding BackupCreateLabel}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,0,32,32">
            <StackPanel MaxWidth="980">

                <!-- Settings card -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource Indigo500Brush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding BackupConfigurationLabel}"
                                       FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Slate900Brush}"/>
                        </StackPanel>

                        <CheckBox Content="{Binding BackupAutoLabel}"
                                  IsChecked="{Binding AutoBackup}"
                                  Style="{StaticResource ModernCheckBoxStyle}"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="{Binding BackupLocationLabel}"
                                   FontFamily="{StaticResource UIFont}" FontSize="12"
                                   Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding BackupLocation, Mode=TwoWay}"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     IsReadOnly="True"
                                     Margin="0,0,8,0"/>
                            <Button Grid.Column="1"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding BrowseBackupLocationCommand}"
                                    Content="{Binding BackupBrowseLabel}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Backups list -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Foreground="{StaticResource Indigo500Brush}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding BackupSnapshotsLabel}"
                                       FontFamily="{StaticResource UIFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource Slate900Brush}"/>
                        </StackPanel>

                        <!-- Empty state -->
                        <Border Background="{StaticResource Slate50Brush}" CornerRadius="10"
                                Padding="40,30"
                                Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B7;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="40"
                                           Foreground="{StaticResource Slate300Brush}"
                                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding BackupEmptyLabel}"
                                           FontFamily="{StaticResource UIFont}" FontSize="13"
                                           Foreground="{StaticResource Slate500Brush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- List -->
                        <ItemsControl ItemsSource="{Binding Backups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:BackupSnapshot}">
                                    <Border Padding="14,12" CornerRadius="10" Margin="0,4"
                                            Background="{StaticResource Slate50Brush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="40" Height="40" CornerRadius="8"
                                                    Background="{StaticResource Indigo100Brush}"
                                                    Margin="0,0,14,0">
                                                <TextBlock Text="&#xE8B7;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="18"
                                                           Foreground="{StaticResource Indigo600Brush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{StaticResource UIFont}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Slate900Brush}"/>
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                           Foreground="{StaticResource Slate500Brush}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding DataContext.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding DataContext.BackupRestoreLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Padding="12,6" Margin="0,0,6,0"/>
                                                <Button Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding DataContext.BackupDeleteLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Padding="12,6"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
