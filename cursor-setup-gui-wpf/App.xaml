<Application x:Class="CursorSetupWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:CursorSetupWpf.Helpers"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/IndigoTheme.xaml"/>
                <ResourceDictionary Source="Resources/Styles/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <helpers:IndexToVisibilityConverter x:Key="IndexToVisibility"/>
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
            <helpers:InverseBoolConverter x:Key="InverseBool"/>
            <helpers:LogLevelToBrushConverter x:Key="LogLevelToBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
