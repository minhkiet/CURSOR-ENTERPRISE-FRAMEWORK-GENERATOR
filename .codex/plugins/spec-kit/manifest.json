{
  "name": "cursor-framework-spec-kit",
  "version": "1.0.0",
  "description": "Spec-Driven Development (SDD) workbench for Cursor Enterprise Framework",
  "author": "Cursor Enterprise Framework",
  "activationEvents": [
    "onCommand:cursor-framework.spec-kit.init",
    "onCommand:cursor-framework.spec-kit.list",
    "onCommand:cursor-framework.spec-kit.status",
    "onCommand:cursor-framework.spec-kit.validate",
    "onCommand:cursor-framework.spec-kit.constitution"
  ],
  "main": "index.js",
  "contributes": {
    "commands": [
      {
        "command": "cursor-framework.spec-kit.init",
        "title": "Cursor Framework: New Feature Specification (SDD)",
        "category": "Cursor Framework"
      },
      {
        "command": "cursor-framework.spec-kit.list",
        "title": "Cursor Framework: List All Specifications",
        "category": "Cursor Framework"
      },
      {
        "command": "cursor-framework.spec-kit.status",
        "title": "Cursor Framework: Feature Spec Status",
        "category": "Cursor Framework"
      },
      {
        "command": "cursor-framework.spec-kit.validate",
        "title": "Cursor Framework: Validate Specification",
        "category": "Cursor Framework"
      },
      {
        "command": "cursor-framework.spec-kit.constitution",
        "title": "Cursor Framework: View Project Constitution",
        "category": "Cursor Framework"
      }
    ]
  }
}
