#!/bin/bash
# Post-commit hook for Cursor Framework

YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo -e "${YELLOW}[Cursor Framework]${NC} Running post-commit tasks..."

FRAMEWORK_ROOT="${FRAMEWORK_ROOT:-.cursor}"

PYTHON_CMD="python"
command -v python3 &> /dev/null && PYTHON_CMD="python3"

if ! $PYTHON_CMD -c "import cursor_framework" 2>/dev/null; then
    exit 0
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
echo -e "${GREEN}✓${NC} Commit complete on branch: $BRANCH"

if command -v nohup &> /dev/null; then
    nohup $PYTHON_CMD -m cursor_framework warm --root "$FRAMEWORK_ROOT" > /dev/null 2>&1 &
fi

exit 0
