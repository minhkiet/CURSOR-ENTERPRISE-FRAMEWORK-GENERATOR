#!/bin/bash
# Pre-push hook for Cursor Framework
# Validates code quality and framework compliance before push

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
echo -e "${BLUE}  Cursor Framework - Pre-Push Validation${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
echo ""

FRAMEWORK_ROOT="${FRAMEWORK_ROOT:-.cursor}"
FAILED=0

PYTHON_CMD="python"
command -v python3 &> /dev/null && PYTHON_CMD="python3"

run_framework() {
    $PYTHON_CMD -m cursor_framework "$@" --root "$FRAMEWORK_ROOT" 2>/dev/null
}

if ! $PYTHON_CMD -c "import cursor_framework" 2>/dev/null; then
    echo -e "${YELLOW}⚠${NC} cursor_framework not installed."
    exit 0
fi

echo -e "${YELLOW}[1/5]${NC} Checking for large files..."
LARGE_FILES=$(git diff --cached --name-only 2>/dev/null | while read f; do
    [ -f "$f" ] && [ $(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null) -gt 5242880 ] && echo "$f"
done)

if [ -n "$LARGE_FILES" ]; then
    echo -e "${RED}✗${NC} Found files larger than 5MB:"
    echo "$LARGE_FILES" | while read f; do echo "  - $f"; done
    FAILED=$((FAILED + 1))
else
    echo -e "${GREEN}✓${NC} No large files detected"
fi

echo -e "${YELLOW}[2/5]${NC} Validating INDEX.json..."
if [ -f "$FRAMEWORK_ROOT/INDEX.json" ] && command -v jq &> /dev/null; then
    if jq empty "$FRAMEWORK_ROOT/INDEX.json" 2>/dev/null; then
        echo -e "${GREEN}✓${NC} INDEX.json is valid"
    else
        echo -e "${RED}✗${NC} INDEX.json is malformed"
        FAILED=$((FAILED + 1))
    fi
fi

echo -e "${YELLOW}[3/5]${NC} Checking for potential secrets..."
SECRETS=$(git diff --cached 2>/dev/null | grep -iE "(password|secret|api_key|apikey|token)" | grep -v "^[-+]" | wc -l)

if [ "$SECRETS" -gt 0 ]; then
    echo -e "${RED}✗${NC} Potential secrets detected in staged changes"
    FAILED=$((FAILED + 1))
else
    echo -e "${GREEN}✓${NC} No obvious secrets detected"
fi

echo -e "${YELLOW}[4/5]${NC} Framework stats..."
STATS=$(run_framework stats 2>/dev/null)
if [ $? -eq 0 ]; then
    ASSETS=$(echo "$STATS" | grep -o '"assets_indexed": [0-9]*' | grep -o '[0-9]*' || echo "0")
    echo -e "${GREEN}✓${NC} Framework: $ASSETS assets"
fi

echo -e "${YELLOW}[5/5]${NC} Code quality checks..."
echo -e "${GREEN}✓${NC} Pre-push validation passed!"

echo ""
if [ $FAILED -eq 0 ]; then
    echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
    echo -e "${GREEN}✓${NC} Pre-push validation passed!"
    echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
    exit 0
else
    echo -e "${RED}✗${NC} Pre-push validation failed with $FAILED error(s)"
    exit 1
fi
