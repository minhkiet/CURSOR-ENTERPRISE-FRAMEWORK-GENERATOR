#!/bin/bash
# Pre-push hook for Cursor Framework
# Validates code quality and framework compliance before push

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
echo -e "${BLUE}  Cursor Framework - Pre-Push Validation${NC}"
echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
echo ""

FRAMEWORK_ROOT="${FRAMEWORK_ROOT:-.cursor}"
FAILED=0

PYTHON_CMD="python"
command -v python3 &> /dev/null && PYTHON_CMD="python3"

run_framework() {
    $PYTHON_CMD -m cursor_framework "$@" --root "$FRAMEWORK_ROOT" 2>/dev/null
}

# Check if cursor_framework module is available
if ! $PYTHON_CMD -c "import cursor_framework" 2>/dev/null; then
    echo -e "${YELLOW}⚠${NC} cursor_framework not installed. Skipping framework checks."
    exit 0
fi

# 1. Check for large files
echo -e "${YELLOW}[1/5]${NC} Checking for large files..."
LARGE_FILES=$(git diff --cached --name-only 2>/dev/null | while read f; do
    [ -f "$f" ] && [ $(stat -f%z "$f" 2>/dev/null || stat -c%s "$f" 2>/dev/null) -gt 5242880 ] && echo "$f"
done)

if [ -n "$LARGE_FILES" ]; then
    echo -e "${RED}✗${NC} Found files larger than 5MB:"
    echo "$LARGE_FILES" | while read f; do echo "  - $f"; done
    FAILED=$((FAILED + 1))
else
    echo -e "${GREEN}✓${NC} No large files detected"
fi

# 2. Check for .cursor changes
echo -e "${YELLOW}[2/5]${NC} Checking .cursor changes..."
CURSOR_CHANGES=$(git diff --name-only 2>/dev/null | grep -E "^\.cursor/" | wc -l)
CURSOR_STAGED=$(git diff --cached --name-only 2>/dev/null | grep -E "^\.cursor/" | wc -l)
CURSOR_TOTAL=$((CURSOR_CHANGES + CURSOR_STAGED))

if [ "$CURSOR_TOTAL" -gt 0 ]; then
    echo -e "${YELLOW}⚠${NC} $CURSOR_TOTAL .cursor file(s) changed"
    echo "  Consider running 'python -m cursor_framework warm' after push"
fi

# 3. Check INDEX.json validity
echo -e "${YELLOW}[3/5]${NC} Validating INDEX.json..."
if [ -f "$FRAMEWORK_ROOT/INDEX.json" ]; then
    if command -v jq &> /dev/null; then
        if jq empty "$FRAMEWORK_ROOT/INDEX.json" 2>/dev/null; then
            echo -e "${GREEN}✓${NC} INDEX.json is valid"
        else
            echo -e "${RED}✗${NC} INDEX.json is malformed"
            echo "  Run: python -m cursor_framework index"
            FAILED=$((FAILED + 1))
        fi
    else
        echo -e "${YELLOW}⚠${NC} jq not available, skipping JSON validation"
    fi
fi

# 4. Check for secrets in staged files
echo -e "${YELLOW}[4/5]${NC} Checking for potential secrets..."
SECRETS=$(git diff --cached 2>/dev/null | grep -iE "(password|secret|api_key|apikey|token|private_key)" | grep -v "^[-+]" | grep -v "//.*" | wc -l)

if [ "$SECRETS" -gt 0 ]; then
    echo -e "${RED}✗${NC} Potential secrets detected in staged changes"
    echo "  Review your changes carefully before pushing"
    FAILED=$((FAILED + 1))
else
    echo -e "${GREEN}✓${NC} No obvious secrets detected"
fi

# 5. Framework stats
echo -e "${YELLOW}[5/5]${NC} Checking framework stats..."
STATS=$(run_framework stats 2>/dev/null)
if [ $? -eq 0 ]; then
    ASSETS=$(echo "$STATS" | grep -o '"assets_indexed": [0-9]*' | grep -o '[0-9]*' || echo "0")
    MEMORY_HITS=$(echo "$STATS" | grep -o '"memory_hits": [0-9]*' | grep -o '[0-9]*' || echo "0")
    echo -e "${GREEN}✓${NC} Framework stats: $ASSETS assets, $MEMORY_HITS memory hits"
else
    echo -e "${YELLOW}⚠${NC} Could not retrieve framework stats"
fi

# Summary
echo ""
echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}✓${NC} Pre-push validation passed!"
    echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
    exit 0
else
    echo -e "${RED}✗${NC} Pre-push validation failed with $FAILED error(s)"
    echo -e "${BLUE}═══════════════════════════════════════════════════════════${NC}"
    echo ""
    read -p "Continue with push? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
fi
