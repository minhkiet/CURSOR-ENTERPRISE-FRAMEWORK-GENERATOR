#!/bin/bash
# Post-commit hook for Cursor Framework
# Automatically updates framework stats and memory after commits

# Colors for output
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}[Cursor Framework]${NC} Running post-commit tasks..."

FRAMEWORK_ROOT="${FRAMEWORK_ROOT:-.cursor}"
MEMORY_PATH="${MEMORY_PATH:-.cache/memory.json}"

PYTHON_CMD="python"
command -v python3 &> /dev/null && PYTHON_CMD="python3"

# Function to run framework command
run_framework() {
    $PYTHON_CMD -m cursor_framework "$@" --root "$FRAMEWORK_ROOT" 2>/dev/null
}

# Check if cursor_framework module is available
if ! $PYTHON_CMD -c "import cursor_framework" 2>/dev/null; then
    exit 0
fi

# Get commit info
COMMIT_MSG=$(git log -1 --pretty=%B 2>/dev/null | head -n 1)
BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)

# Warm cache in background for future requests
if [ -d "$FRAMEWORK_ROOT" ]; then
    echo -e "${GREEN}✓${NC} Commit complete on branch: $BRANCH"
    echo -e "${GREEN}✓${NC} Commit message: ${COMMIT_MSG:0:50}..."
    
    # Persist session memory asynchronously
    if command -v nohup &> /dev/null; then
        nohup $PYTHON_CMD -m cursor_framework warm --root "$FRAMEWORK_ROOT" > /dev/null 2>&1 &
    fi
fi

echo -e "${YELLOW}[Cursor Framework]${NC} Post-commit tasks completed!"
exit 0
