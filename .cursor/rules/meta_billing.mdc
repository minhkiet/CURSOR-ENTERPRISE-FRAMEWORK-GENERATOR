**4. Dunning Management**

```typescript
// services/dunning.service.ts
export interface DunningPolicy {
  id: string;
  attempts: DunningAttempt[];
  finalAction: 'cancel' | 'suspend' | 'flag';
}

export interface DunningAttempt {
  day: number;
  action: 'email' | 'retry' | 'suspend';
  template?: string;
}

class DunningService {
  constructor(
    private invoiceService: InvoiceService,
    private emailService: EmailService,
    private subscriptionService: SubscriptionService
  ) {}

  async processOverdueInvoices(): Promise<void> {
    const overdueInvoices = await this.invoiceService.getOverdueInvoices();
    
    for (const invoice of overdueInvoices) {
      await this.evaluateDunningActions(invoice);
    }
  }

  private async evaluateDunningActions(invoice: Invoice): Promise<void> {
    const daysOverdue = differenceInDays(new Date(), invoice.dueDate);
    const policy = await this.getDunningPolicy(invoice.tenantId);

    for (const attempt of policy.attempts) {
      if (daysOverdue >= attempt.day) {
        await this.executeAttempt(invoice, attempt);
      }
    }

    // Check final action
    const maxDays = Math.max(...policy.attempts.map(a => a.day));
    if (daysOverdue > maxDays) {
      await this.executeFinalAction(invoice, policy.finalAction);
    }
  }

  private async executeAttempt(
    invoice: Invoice,
    attempt: DunningAttempt
  ): Promise<void> {
    // Check if already executed
    const alreadyExecuted = await this.hasAttemptBeenExecuted(invoice.id, attempt.day);
    if (alreadyExecuted) {
      return;
    }

    switch (attempt.action) {
      case 'email':
        await this.sendDunningEmail(invoice, attempt.template);
        break;
      case 'retry':
        await this.paymentService.retryPayment(invoice.id);
        break;
      case 'suspend':
        await this.subscriptionService.suspendSubscription(invoice.subscriptionId);
        break;
    }

    await this.recordAttemptExecuted(invoice.id, attempt.day);
  }

  private async sendDunningEmail(
    invoice: Invoice,
    template?: string
  ): Promise<void> {
    const tenant = await this.tenantService.getById(invoice.tenantId);
    const daysOverdue = differenceInDays(new Date(), invoice.dueDate);

    await this.emailService.send({
      to: tenant.billingEmail,
      subject: `Payment Overdue - Invoice ${invoice.number}`,
      template: template || 'dunning-reminder',
      data: {
        invoiceNumber: invoice.number,
        amount: invoice.total,
        dueDate: invoice.dueDate,
        daysOverdue,
        paymentUrl: await this.generatePaymentUrl(invoice)
      }
    });
  }

  private async executeFinalAction(
    invoice: Invoice,
    action: 'cancel' | 'suspend' | 'flag'
  ): Promise<void> {
    switch (action) {
      case 'cancel':
        await this.subscriptionService.cancelSubscription(
          invoice.subscriptionId,
          { reason: 'Payment failed' }
        );
        break;
      case 'suspend':
        await this.subscriptionService.suspendSubscription(invoice.subscriptionId);
        break;
      case 'flag':
        await this.flagAccountForReview(invoice.tenantId);
        break;
    }

    await this.eventBus.publish(new DunningFinalActionEvent(
      invoice.id,
      action
    ));
  }
}
