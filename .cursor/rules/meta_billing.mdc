**3. Payment Processing**

```typescript
// services/payment.service.ts
export interface PaymentMethod {
  id: string;
  tenantId: string;
  type: 'card' | 'bank_account';
  isDefault: boolean;
  card?: {
    brand: string;
    last4: string;
    expMonth: number;
    expYear: number;
  };
  bankAccount?: {
    bankName: string;
    last4: string;
    routingNumber: string;
  };
}

export class PaymentService {
  constructor(
    private paymentGateway: PaymentGateway,
    private paymentMethodRepository: PaymentMethodRepository,
    private invoiceService: InvoiceService
  ) {}

  async createPaymentMethod(
    tenantId: string,
    token: string,
    setAsDefault: boolean = true
  ): Promise<PaymentMethod> {
    // Create payment method with gateway
    const gatewayMethod = await this.paymentGateway.createPaymentMethod(token);

    // Create local record
    const paymentMethod = await this.paymentMethodRepository.create({
      tenantId,
      type: gatewayMethod.type,
      gatewayId: gatewayMethod.id,
      isDefault: setAsDefault,
      card: gatewayMethod.card,
      bankAccount: gatewayMethod.bankAccount,
      createdAt: new Date()
    });

    // Update default if needed
    if (setAsDefault) {
      await this.clearDefaultPaymentMethods(tenantId);
      await this.paymentMethodRepository.update(paymentMethod.id, { isDefault: true });
    }

    return paymentMethod;
  }

  async chargeInvoice(
    invoiceId: string,
    options: {
      paymentMethodId?: string;
      retry?: boolean;
    } = {}
  ): Promise<PaymentResult> {
    const invoice = await this.invoiceService.getInvoice(invoiceId);
    
    // Get payment method
    const paymentMethodId = options.paymentMethodId 
      || await this.getDefaultPaymentMethodId(invoice.tenantId);

    if (!paymentMethodId) {
      return { success: false, error: 'No payment method on file' };
    }

    try {
      // Charge with payment gateway
      const charge = await this.paymentGateway.charge({
        amount: Math.round(invoice.total * 100), // Convert to cents
        currency: invoice.currency,
        paymentMethodId,
        description: `Invoice ${invoice.number}`,
        metadata: {
          invoiceId: invoice.id,
          tenantId: invoice.tenantId
        }
      });

      // Mark invoice as paid
      await this.invoiceService.markAsPaid(invoiceId, charge.id);

      return {
        success: true,
        chargeId: charge.id,
        amount: charge.amount / 100
      };
    } catch (error) {
      // Log failed payment
      await this.logFailedPayment(invoiceId, error);

      // Update invoice status
      await this.invoiceService.markAsUncollectible(invoiceId);

      return {
        success: false,
        error: error.message
      };
    }
  }

  async retryPayment(invoiceId: string): Promise<PaymentResult> {
    const invoice = await this.invoiceService.getInvoice(invoiceId);
    
    // Get payment method
    const paymentMethod = await this.getDefaultPaymentMethod(invoice.tenantId);

    if (!paymentMethod) {
      return { success: false, error: 'No payment method on file' };
    }

    // Attempt charge
    const result = await this.chargeInvoice(invoiceId, {
      paymentMethodId: paymentMethod.id
    });

    if (!result.success) {
      // Schedule retry with exponential backoff
      await this.scheduleRetry(invoiceId);
    }

    return result;
  }

  async processRefund(
    tenantId: string,
    amount: number,
    options: {
      invoiceId?: string;
      reason?: string;
    } = {}
  ): Promise<RefundResult> {
    // Get original payment
    const originalPayment = await this.getLastSuccessfulPayment(tenantId);
    if (!originalPayment) {
      throw new NotFoundError('No successful payment found');
    }

    const refund = await this.paymentGateway.refund({
      chargeId: originalPayment.gatewayId,
      amount: Math.round(amount * 100),
      reason: options.reason
    });

    await this.paymentMethodRepository.createRefundRecord({
      tenantId,
      originalPaymentId: originalPayment.id,
      refundId: refund.id,
      amount,
      reason: options.reason
    });

    return {
      success: true,
      refundId: refund.id,
      amount: refund.amount / 100
    };
  }
}
