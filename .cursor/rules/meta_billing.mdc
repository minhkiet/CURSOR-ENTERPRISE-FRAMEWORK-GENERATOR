**5. Usage-Based Billing**

```typescript
// services/usage.service.ts
export interface UsageRecord {
  id: string;
  tenantId: string;
  metric: string;
  quantity: number;
  timestamp: Date;
  periodStart: Date;
  periodEnd: Date;
}

export interface MeteredBillingConfig {
  metric: string;
  displayName: string;
  unit: string;
  pricing: {
    tiers: Array<{
      upTo: number | null;
      unitPrice: number;
    }>;
  };
}

class UsageBasedBillingService {
  constructor(
    private usageRepository: UsageRepository,
    private invoiceService: InvoiceService
  ) {}

  async recordUsage(
    tenantId: string,
    metric: string,
    quantity: number,
    options: {
      timestamp?: Date;
      idempotencyKey?: string;
    } = {}
  ): Promise<UsageRecord> {
    // Check for duplicate (idempotency)
    if (options.idempotencyKey) {
      const existing = await this.usageRepository.findByIdempotencyKey(
        tenantId,
        options.idempotencyKey
      );
      if (existing) {
        return existing;
      }
    }

    // Get current period
    const period = await this.getCurrentBillingPeriod(tenantId);

    const record = await this.usageRepository.create({
      tenantId,
      metric,
      quantity,
      timestamp: options.timestamp || new Date(),
      periodStart: period.start,
      periodEnd: period.end,
      idempotencyKey: options.idempotencyKey
    });

    // Publish event for real-time tracking
    await this.eventBus.publish(new UsageRecordedEvent(
      tenantId,
      metric,
      quantity
    ));

    return record;
  }

  async getUsageSummary(
    tenantId: string,
    period?: BillingPeriod
  ): Promise<UsageSummary> {
    const billingPeriod = period || await this.getCurrentBillingPeriod(tenantId);

    const usage = await this.usageRepository.getByTenantAndPeriod(
      tenantId,
      billingPeriod.start,
      billingPeriod.end
    );

    // Group by metric
    const byMetric = new Map<string, number>();
    for (const record of usage) {
      const current = byMetric.get(record.metric) || 0;
      byMetric.set(record.metric, current + record.quantity);
    }

    // Calculate costs
    const costs: Record<string, number> = {};
    for (const [metric, quantity] of byMetric) {
      const config = await this.getMeteredConfig(metric);
      costs[metric] = this.calculateTieredCost(quantity, config.pricing.tiers);
    }

    return {
      tenantId,
      period: billingPeriod,
      byMetric: Object.fromEntries(byMetric),
      costs,
      totalCost: Object.values(costs).reduce((sum, c) => sum + c, 0)
    };
  }

  async generateUsageInvoice(
    tenantId: string,
    period: BillingPeriod
  ): Promise<Invoice> {
    const summary = await this.getUsageSummary(tenantId, period);

    const lineItems: InvoiceLineItem[] = [];
    for (const [metric, quantity] of Object.entries(summary.byMetric)) {
      const config = await this.getMeteredConfig(metric);
      lineItems.push({
        description: `${config.displayName} - ${quantity} ${config.unit}`,
        quantity,
        unitPrice: summary.costs[metric] / quantity,
        amount: summary.costs[metric]
      });
    }

    const subtotal = summary.totalCost;
    const tax = await this.taxService.calculateTax(tenantId, subtotal);

    return this.invoiceRepository.create({
      tenantId,
      subscriptionId: null, // Usage-based
      number: await this.generateInvoiceNumber(),
      status: InvoiceStatus.OPEN,
      currency: 'USD',
      subtotal,
      tax,
      total: subtotal + tax,
      dueDate: addDays(new Date(), 30),
      lineItems,
      createdAt: new Date(),
      updatedAt: new Date()
    });
  }

  private calculateTieredCost(
    quantity: number,
    tiers: Array<{ upTo: number | null; unitPrice: number }>
  ): number {
    let cost = 0;
    let remaining = quantity;

    for (const tier of tiers) {
      const tierQuantity = tier.upTo 
        ? Math.min(remaining, tier.upTo)
        : remaining;
      
      cost += tierQuantity * tier.unitPrice;
      remaining -= tierQuantity;

      if (remaining <= 0) break;
    }

    return cost;
  }
}
```

## Workflow

**Phase 1: Pricing Design**

Define pricing models. Create plans. Configure features. Set up trials.

**Phase 2: Payment Integration**

Select payment gateway. Implement integration. Configure webhooks. Set up payment methods.

**Phase 3: Billing Logic**

Implement subscriptions. Build invoice generation. Add tax calculations. Configure proration.

**Phase 4: Dunning**

Design dunning policy. Implement retries. Build notifications. Configure final actions.

**Phase 5: Reporting**

Build MRR/ARR tracking. Create revenue reports. Set up dashboards. Configure alerts.

**Phase 6: Self-Service**

Build customer portal. Add plan management. Implement invoice downloads. Enable payment updates.

