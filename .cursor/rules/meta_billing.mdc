**2. Invoice Generation**

```typescript
// services/invoice.service.ts
export interface Invoice {
  id: string;
  tenantId: string;
  subscriptionId: string;
  number: string;
  status: InvoiceStatus;
  currency: string;
  subtotal: number;
  tax: number;
  total: number;
  dueDate: Date;
  paidAt?: Date;
  lineItems: InvoiceLineItem[];
  createdAt: Date;
  updatedAt: Date;
}

export enum InvoiceStatus {
  DRAFT = 'draft',
  OPEN = 'open',
  PAID = 'paid',
  VOID = 'void',
  UNCOLLECTIBLE = 'uncollectible'
}

export interface InvoiceLineItem {
  description: string;
  quantity: number;
  unitPrice: number;
  amount: number;
  taxRate?: number;
  period?: { start: Date; end: Date };
}

export class InvoiceService {
  constructor(
    private invoiceRepository: InvoiceRepository,
    private subscriptionService: SubscriptionService,
    private taxService: TaxService,
    private pdfService: PDFService,
    private emailService: EmailService
  ) {}

  async generateInvoice(subscriptionId: string): Promise<Invoice> {
    const subscription = await this.subscriptionService.getSubscription(subscriptionId);
    const plan = await this.planService.getPlan(subscription.planId);

    // Create line items
    const lineItems: InvoiceLineItem[] = [
      {
        description: `${plan.name} - ${plan.billingInterval}ly subscription`,
        quantity: 1,
        unitPrice: plan.price,
        amount: plan.price,
        period: {
          start: subscription.currentPeriodStart,
          end: subscription.currentPeriodEnd
        }
      }
    ];

    // Calculate subtotal
    const subtotal = lineItems.reduce((sum, item) => sum + item.amount, 0);

    // Calculate tax
    const taxAmount = await this.taxService.calculateTax(
      subscription.tenantId,
      subtotal
    );

    // Generate invoice number
    const invoiceNumber = await this.generateInvoiceNumber();

    // Create invoice
    const invoice = await this.invoiceRepository.create({
      tenantId: subscription.tenantId,
      subscriptionId,
      number: invoiceNumber,
      status: InvoiceStatus.OPEN,
      currency: 'USD',
      subtotal,
      tax: taxAmount,
      total: subtotal + taxAmount,
      dueDate: addDays(new Date(), 30),
      lineItems,
      createdAt: new Date(),
      updatedAt: new Date()
    });

    // Send invoice email
    await this.sendInvoiceEmail(invoice);

    return invoice;
  }

  async generateProrationInvoice(
    subscriptionId: string,
    amount: number,
    newPlan: Plan
  ): Promise<Invoice> {
    const subscription = await this.subscriptionService.getSubscription(subscriptionId);

    const lineItems: InvoiceLineItem[] = [
      {
        description: `Proration for ${newPlan.name}`,
        quantity: 1,
        unitPrice: amount,
        amount,
        period: {
          start: new Date(),
          end: subscription.currentPeriodEnd
        }
      }
    ];

    const subtotal = amount;
    const taxAmount = await this.taxService.calculateTax(
      subscription.tenantId,
      subtotal
    );

    const invoiceNumber = await this.generateInvoiceNumber();

    return this.invoiceRepository.create({
      tenantId: subscription.tenantId,
      subscriptionId,
      number: invoiceNumber,
      status: InvoiceStatus.OPEN,
      currency: 'USD',
      subtotal,
      tax: taxAmount,
      total: subtotal + taxAmount,
      dueDate: addDays(new Date(), 7),
      lineItems,
      createdAt: new Date(),
      updatedAt: new Date()
    });
  }

  async markAsPaid(invoiceId: string, paymentId: string): Promise<Invoice> {
    const invoice = await this.invoiceRepository.findById(invoiceId);
    if (!invoice) {
      throw new NotFoundError('Invoice not found');
    }

    const updated = await this.invoiceRepository.update(invoiceId, {
      status: InvoiceStatus.PAID,
      paidAt: new Date(),
      updatedAt: new Date()
    });

    await this.eventBus.publish(new InvoicePaidEvent(invoiceId, paymentId));

    return updated;
  }

  async voidInvoice(invoiceId: string): Promise<Invoice> {
    const invoice = await this.invoiceRepository.findById(invoiceId);
    if (!invoice) {
      throw new NotFoundError('Invoice not found');
    }

    if (invoice.status === InvoiceStatus.PAID) {
      throw new ValidationError('Cannot void a paid invoice');
    }

    const updated = await this.invoiceRepository.update(invoiceId, {
      status: InvoiceStatus.VOID,
      updatedAt: new Date()
    });

    await this.eventBus.publish(new InvoiceVoidedEvent(invoiceId));

    return updated;
  }

  async generatePDF(invoiceId: string): Promise<Buffer> {
    const invoice = await this.invoiceRepository.findById(invoiceId);
    if (!invoice) {
      throw new NotFoundError('Invoice not found');
    }

    const tenant = await this.tenantService.getById(invoice.tenantId);

    return this.pdfService.generateFromTemplate('invoice', {
      invoiceNumber: invoice.number,
      issueDate: invoice.createdAt,
      dueDate: invoice.dueDate,
      company: {
        name: 'Your Company',
        address: '123 Business St',
        city: 'San Francisco, CA 94102'
      },
      customer: {
        name: tenant.name,
        address: tenant.billingAddress
      },
      lineItems: invoice.lineItems,
      subtotal: invoice.subtotal,
      tax: invoice.tax,
      total: invoice.total,
      currency: invoice.currency
    });
  }

  async sendInvoiceEmail(invoice: Invoice): Promise<void> {
    const tenant = await this.tenantService.getById(invoice.tenantId);
    const billingEmail = tenant.billingEmail || tenant.ownerEmail;

    const pdfBuffer = await this.generatePDF(invoice.id);

    await this.emailService.sendWithAttachment({
      to: billingEmail,
      subject: `Invoice ${invoice.number} from Your Company`,
      template: 'invoice-notification',
      attachments: [{
        filename: `invoice-${invoice.number}.pdf`,
        content: pdfBuffer
      }]
    });
  }

  private async generateInvoiceNumber(): Promise<string> {
    const year = new Date().getFullYear();
    const lastInvoice = await this.invoiceRepository.findLastOfYear(year);
    const sequence = (lastInvoice?.number.split('-')[2] || 0) + 1;
    
    return `INV-${year}-${String(sequence).padStart(4, '0')}`;
  }
}
