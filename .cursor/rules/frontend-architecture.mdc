```typescript
// hooks/useOrders.ts
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { orderService } from '@/services/order.service';
import { queryKeys } from '@/lib/api/queryKeys';
import type { CreateOrderRequest, OrderFilters } from '@/types/order';

export function useOrders(filters: OrderFilters) {
  return useQuery({
    queryKey: queryKeys.orders.list(filters),
    queryFn: () => orderService.getOrders(filters),
    placeholderData: (previousData) => previousData,
  });
}

export function useOrder(orderId: string) {
  return useQuery({
    queryKey: queryKeys.orders.detail(orderId),
    queryFn: () => orderService.getOrder(orderId),
    enabled: !!orderId,
  });
}

export function useCreateOrder() {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: (data: CreateOrderRequest) => orderService.createOrder(data),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: queryKeys.orders.all });
    },
  });
}

export function useCancelOrder() {
  const queryClient = useQueryClient();
  
  return useMutation({
    mutationFn: (orderId: string) => orderService.cancelOrder(orderId),
    onMutate: async (orderId) => {
      // Optimistic update
      await queryClient.cancelQueries({ queryKey: queryKeys.orders.detail(orderId) });
      
      const previousOrder = queryClient.getQueryData(queryKeys.orders.detail(orderId));
      
      queryClient.setQueryData(queryKeys.orders.detail(orderId), {
        ...previousOrder,
        status: 'cancelled',
      });
      
      return { previousOrder };
    },
    onError: (err, orderId, context) => {
      // Rollback on error
      if (context?.previousOrder) {
        queryClient.setQueryData(
          queryKeys.orders.detail(orderId),
          context.previousOrder
        );
      }
    },
    onSettled: () => {
      queryClient.invalidateQueries({ queryKey: queryKeys.orders.all });
    },
  });
}
```

**5. Error Boundary Pattern**

```tsx
// components/ErrorBoundary/ErrorBoundary.tsx
import React, { Component, ReactNode, ErrorInfo } from 'react';

interface Props {
  children: ReactNode;
  fallback?: ReactNode;
  onError?: (error: Error, errorInfo: ErrorInfo) => void;
}

interface State {
  hasError: boolean;
  error: Error | null;
}

export class ErrorBoundary extends Component<Props, State> {
  constructor(props: Props) {
    super(props);
    this.state = { hasError: false, error: null };
  }

  static getDerivedStateFromError(error: Error): State {
    return { hasError: true, error };
  }

  componentDidCatch(error: Error, errorInfo: ErrorInfo) {
    // Log error to monitoring service
    console.error('ErrorBoundary caught an error:', error, errorInfo);
    this.props.onError?.(error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      if (this.props.fallback) {
        return this.props.fallback;
      }

      return (
        <div className="error-boundary">
          <h1>Something went wrong</h1>
          <p>We're sorry for the inconvenience.</p>
          <button onClick={() => window.location.reload()}>
            Reload page
          </button>
          {process.env.NODE_ENV === 'development' && this.state.error && (
            <pre>{this.state.error.toString()}</pre>
          )}
        </div>
      );
    }

    return this.props.children;
  }
}

// Usage in app
<ErrorBoundary
  onError={(error, info) => {
    // Send to error tracking
    Sentry.captureException(error, { extra: info });
  }}
>
  <App />
</ErrorBoundary>
```

**6. Performance Optimization**

```typescript
// hooks/useVirtualList.ts
import { useState, useEffect, useRef, useCallback } from 'react';

interface VirtualListOptions {
  itemCount: number;
  itemHeight: number | ((index: number) => number);
  overscan?: number;
}

export function useVirtualList<T>({
  itemCount,
  itemHeight,
  overscan = 3,
}: VirtualListOptions) {
  const [scrollTop, setScrollTop] = useState(0);
  const [containerHeight, setContainerHeight] = useState(0);
  const containerRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    const container = containerRef.current;
    if (!container) return;

    const resizeObserver = new ResizeObserver((entries) => {
      setContainerHeight(entries[0].contentRect.height);
    });

    resizeObserver.observe(container);
    setContainerHeight(container.clientHeight);

    return () => resizeObserver.disconnect();
  }, []);

  const getItemHeight = useCallback(
    (index: number) => {
      return typeof itemHeight === 'function' ? itemHeight(index) : itemHeight;
    },
    [itemHeight]
  );

  const totalHeight = useCallback(() => {
    return Array.from({ length: itemCount }, (_, i) => getItemHeight(i)).reduce(
      (sum, height) => sum + height,
      0
    );
  }, [itemCount, getItemHeight]);

  const getVisibleRange = useCallback(() => {
    let startIndex = 0;
    let height = 0;

    for (let i = 0; i < itemCount; i++) {
      height += getItemHeight(i);
      if (height > scrollTop) {
        startIndex = Math.max(0, i - overscan);
        break;
      }
    }

    let endIndex = itemCount - 1;
    height = 0;

    for (let i = startIndex; i < itemCount; i++) {
      height += getItemHeight(i);
      if (height > scrollTop + containerHeight) {
        endIndex = Math.min(itemCount - 1, i + overscan);
        break;
      }
    }

    return { startIndex, endIndex };
  }, [scrollTop, containerHeight, itemCount, getItemHeight, overscan]);

  const visibleRange = getVisibleRange();
  const offsetY = Array.from(
    { length: visibleRange.startIndex },
    (_, i) => getItemHeight(i)
  ).reduce((sum, height) => sum + height, 0);

  return {
    containerRef,
    scrollTop,
    setScrollTop,
    visibleRange,
    offsetY,
    totalHeight: totalHeight(),
  };
}
```

## Workflow

**Phase 1: Architecture Design**

Define project structure. Choose tech stack. Set up tooling. Define patterns.

**Phase 2: Component Library**

Build UI components. Create documentation. Set up design tokens. Ensure accessibility.

**Phase 3: Feature Development**

Implement features. Use feature modules. Follow patterns. Test thoroughly.

**Phase 4: Integration**

Connect to APIs. Implement state. Add routing. Handle errors.

**Phase 5: Optimization**

Performance audit. Optimize rendering. Add lazy loading. Test performance.

**Phase 6: Polish**

Accessibility audit. Cross-browser testing. Mobile optimization. Documentation.

## Skill Integration for Frontend Development

Mọi task frontend phải được thực hiện với skill system chuẩn kép:

### Frontend Taste Skill (.cursor/skills/frontend-taste/)
Cho landing pages, portfolios, marketing sites, và greenfield builds. Include:
- **Pre-Review Gate (Section 0):** Brief inference, design read declaration, dial setting (VARIANCE/MOTION/DENSITY), anti-default check, design system selection
- **3 Dials System:** DESIGN_VARIANCE (1-10), MOTION_INTENSITY (1-10), VISUAL_DENSITY (1-10)
- **Design Engineering:** Typography, color calibration, layout discipline, interactive states, content rules
- **Animation Standards:** GSAP canonical patterns (Sticky-Stack, Horizontal-Pan), Motion alternatives, forbidden patterns
- **Performance & Accessibility:** Hardware acceleration, reduced motion, dark mode, Core Web Vitals
- **Post-Review Gate (Section 6):** 60+ checklist items across correctness, design, a11y, performance, states

### Frontend Redesign Skill (.cursor/skills/frontend-redesign/)
Cho việc upgrade website/app hiện có. Include:
- **Pre-Audit Gate:** Codebase scan, brand token extraction, redesign mode classification (preserve vs overhaul)
- **Design Audit:** 50+ checklist items across typography, color, layout, interactivity, content, components, icons, code quality
- **Upgrade Techniques:** Typography, layout, motion, surface upgrades
- **Fix Priority:** Font swap > Color cleanup > Hover states > Layout > Generic components > States > Polish
- **Post-Redesign Audit:** Functionality preserved, design quality, accessibility, SEO preserved, code quality

### Full Output Skill (.cursor/skills/full-output/)
Cho mọi task cần đầy đủ output. Include:
- **Pre-Generation Scope Lock:** Count deliverables, lock the list
- **Banned Patterns:** `// ...`, `// TODO`, skeleton when full impl requested, "continue later"
- **Cross-Check:** Verify deliverable count matches scope before output
- **Handling Long Outputs:** Clean breakpoint, PAUSE marker, resume exactly where stopped

### Frontend Review Skill (.cursor/skills/frontend-review/)
Mandatory dual-gate review cho mọi frontend task:
- **Pre-Review Gate:** Scope analysis, quality plan, checklist
- **Post-Review Gate:** 60+ items across correctness, design & taste, accessibility, performance, state & interaction, testing, full-output
- **Review Output Format:** [PRE-REVIEW] summary at start, [POST-REVIEW] summary at delivery
- **Review Failures:** Do NOT deliver until all boxes pass

### Skill Execution Flow
```
Task nhận vào
  → Context Router phát hiện frontend trigger
  → Load applicable skill(s)
  → [PRE-REVIEW] gate chạy (scope, design direction, checklist)
  → Implementation
  → [POST-REVIEW] gate chạy (60+ quality gates)
  → Nếu fail → fix → re-run gate
  → Deliver khi TẤT CẢ gates pass
```

