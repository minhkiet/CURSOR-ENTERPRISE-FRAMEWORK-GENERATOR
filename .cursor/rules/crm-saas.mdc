// entities/Activity.ts
export interface Activity {
  id: string;
  tenantId: string;
  
  type: ActivityType;
  subject: string;
  description?: string;
  
  // Relationships
  entityType: 'lead' | 'contact' | 'account' | 'opportunity';
  entityId: string;
  userId: string;
  
  // Details
  dueDate?: Date;
  completedAt?: Date;
  location?: string;
  attendees?: string[];
  
  // Metadata
  createdAt: Date;
  updatedAt: Date;
}

export enum ActivityType {
  CALL = 'call',
  EMAIL = 'email',
  MEETING = 'meeting',
  TASK = 'task',
  NOTE = 'note',
  LEAD_CREATED = 'lead_created',
  LEAD_UPDATED = 'lead_updated',
  OPPORTUNITY_CREATED = 'opportunity_created',
  OPPORTUNITY_STAGE_CHANGED = 'opportunity_stage_changed'
}

// services/activity.service.ts
export class ActivityService {
  async logActivity(data: CreateActivityDTO): Promise<Activity> {
    const activity = await this.activityRepository.create({
      ...data,
      createdAt: new Date()
    });

    // Update related entity's last activity
    await this.updateEntityLastActivity(data.entityType, data.entityId);

    return activity;
  }

  async getActivitiesForEntity(
    entityType: string,
    entityId: string,
    options: { page?: number; limit?: number; types?: ActivityType[] } = {}
  ): Promise<PaginatedResult<Activity>> {
    return this.activityRepository.findByEntity(entityType, entityId, options);
  }

  async getUpcomingActivities(userId: string): Promise<Activity[]> {
    const now = new Date();
    return this.activityRepository.findUpcoming(userId, {
      dueDate: { $gte: now },
      completedAt: null
    });
  }

  async completeActivity(id: string): Promise<Activity> {
    const activity = await this.activityRepository.findById(id);
    if (!activity) {
      throw new NotFoundError('Activity not found');
    }

    return this.activityRepository.update(id, {
      completedAt: new Date()
    });
  }

  async getActivityTimeline(
    entityType: string,
    entityId: string
  ): Promise<ActivityTimeline> {
    const activities = await this.activityRepository.findByEntity(
      entityType,
      entityId,
      { limit: 100, orderBy: 'createdAt', order: 'DESC' }
    );

    // Group by date
    const grouped = this.groupActivitiesByDate(activities.items);

    return {
      entityType,
      entityId,
      grouped,
      total: activities.total
    };
  }

  private groupActivitiesByDate(
    activities: Activity[]
  ): Map<string, Activity[]> {
    const grouped = new Map<string, Activity[]>();

    for (const activity of activities) {
      const dateKey = activity.createdAt.toISOString().split('T')[0];
      const existing = grouped.get(dateKey) || [];
      existing.push(activity);
      grouped.set(dateKey, existing);
    }

    return grouped;
  }
}
