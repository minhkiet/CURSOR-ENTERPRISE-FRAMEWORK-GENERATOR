**2. Lead Service**

```typescript
// services/lead.service.ts
export class LeadService {
  constructor(
    private leadRepository: LeadRepository,
    private activityService: ActivityService,
    private scoringService: LeadScoringService,
    private eventBus: EventBus
  ) {}

  async createLead(data: CreateLeadDTO): Promise<Lead> {
    // Validate email uniqueness
    const existing = await this.leadRepository.findByEmail(data.email);
    if (existing) {
      throw new ConflictError('Lead with this email already exists');
    }

    // Calculate initial score
    const score = await this.scoringService.calculateScore(data);

    // Create lead
    const lead = await this.leadRepository.create({
      ...data,
      status: LeadStatus.NEW,
      score,
      createdAt: new Date()
    });

    // Log activity
    await this.activityService.log({
      type: ActivityType.LEAD_CREATED,
      entityType: 'lead',
      entityId: lead.id,
      details: { source: data.source }
    });

    // Publish event
    await this.eventBus.publish(new LeadCreatedEvent(lead));

    return lead;
  }

  async updateLead(id: string, data: UpdateLeadDTO): Promise<Lead> {
    const lead = await this.leadRepository.findById(id);
    if (!lead) {
      throw new NotFoundError('Lead not found');
    }

    // Update lead
    const updated = await this.leadRepository.update(id, data);

    // Recalculate score if relevant fields changed
    if (this.shouldRescore(data)) {
      updated.score = await this.scoringService.calculateScore(updated);
      await this.leadRepository.update(id, { score: updated.score });
    }

    // Log activity
    await this.activityService.log({
      type: ActivityType.LEAD_UPDATED,
      entityType: 'lead',
      entityId: id,
      details: data
    });

    return updated;
  }

  async qualifyLead(id: string): Promise<Lead> {
    const lead = await this.leadRepository.findById(id);
    if (!lead) {
      throw new NotFoundError('Lead not found');
    }

    if (lead.status !== LeadStatus.CONTACTED) {
      throw new ValidationError('Lead must be contacted before qualification');
    }

    const updated = await this.leadRepository.update(id, {
      status: LeadStatus.QUALIFIED,
      qualifiedAt: new Date()
    });

    // Publish event
    await this.eventBus.publish(new LeadQualifiedEvent(updated));

    return updated;
  }

  async convertLead(id: string, convertData: ConvertLeadDTO): Promise<ConvertResult> {
    const lead = await this.leadRepository.findById(id);
    if (!lead) {
      throw new NotFoundError('Lead not found');
    }

    if (lead.status === LeadStatus.CONVERTED) {
      throw new ConflictError('Lead already converted');
    }

    // Create account
    const account = await this.accountService.createAccount({
      tenantId: lead.tenantId,
      name: convertData.accountName || lead.company || `${lead.firstName} ${lead.lastName}`,
      type: AccountType.PROSPECT,
      ownerId: lead.ownerId
    });

    // Create contact
    const contact = await this.contactService.createContact({
      tenantId: lead.tenantId,
      firstName: lead.firstName,
      lastName: lead.lastName,
      email: lead.email,
      phone: lead.phone,
      accountId: account.id,
      ownerId: lead.ownerId
    });

    // Create opportunity if specified
    let opportunity: Opportunity | undefined;
    if (convertData.createOpportunity && convertData.opportunityData) {
      opportunity = await this.opportunityService.createOpportunity({
        ...convertData.opportunityData,
        accountId: account.id,
        ownerId: lead.ownerId
      });
    }

    // Update lead status
    await this.leadRepository.update(id, {
      status: LeadStatus.CONVERTED,
      convertedAt: new Date(),
      convertedAccountId: account.id,
      convertedContactId: contact.id
    });

    return {
      account,
      contact,
      opportunity
    };
  }

  async assignLead(id: string, ownerId: string): Promise<Lead> {
    const lead = await this.leadRepository.findById(id);
    if (!lead) {
      throw new NotFoundError('Lead not found');
    }

    const updated = await this.leadRepository.update(id, {
      ownerId,
      assignedAt: new Date()
    });

    // Notify new owner
    await this.notificationService.notifyUser(ownerId, {
      type: NotificationType.LEAD_ASSIGNED,
      title: 'New Lead Assigned',
      message: `A new lead has been assigned to you`,
      entityType: 'lead',
      entityId: id
    });

    return updated;
  }

  private shouldRescore(data: UpdateLeadDTO): boolean {
    const rescoreFields = ['company', 'title', 'source', 'industry'];
    return rescoreFields.some(field => field in data);
  }
}
```

**3. Pipeline Management**

```typescript
// services/pipeline.service.ts
export interface PipelineStage {
  id: string;
  name: string;
  order: number;
  probability: number;
  color: string;
}

export interface Pipeline {
  id: string;
  name: string;
  stages: PipelineStage[];
}

export class PipelineService {
  constructor(
    private opportunityRepository: OpportunityRepository
  ) {}

  async getOpportunitiesInStage(
    pipelineId: string,
    stageId: string,
    options: { page?: number; limit?: number } = {}
  ): Promise<PaginatedResult<Opportunity>> {
    return this.opportunityRepository.findByStage(pipelineId, stageId, options);
  }

  async moveOpportunity(
    opportunityId: string,
    targetStageId: string
  ): Promise<Opportunity> {
    const opportunity = await this.opportunityRepository.findById(opportunityId);
    if (!opportunity) {
      throw new NotFoundError('Opportunity not found');
    }

    const pipeline = await this.getPipeline(opportunity.pipelineId);
    const targetStage = pipeline.stages.find(s => s.id === targetStageId);
    
    if (!targetStage) {
      throw new NotFoundError('Target stage not found');
    }

    const updated = await this.opportunityRepository.update(opportunityId, {
      stage: targetStage.name,
      probability: targetStage.probability,
      stageOrder: targetStage.order
    });

    // Publish event
    await this.eventBus.publish(new OpportunityStageChangedEvent(
      opportunityId,
      opportunity.stage,
      targetStage.name
    ));

    return updated;
  }

  async getPipelineAnalytics(pipelineId: string): Promise<PipelineAnalytics> {
    const opportunities = await this.opportunityRepository.findByPipeline(pipelineId);
    const pipeline = await this.getPipeline(pipelineId);

    const stageAnalytics = pipeline.stages.map(stage => {
      const stageOpps = opportunities.filter(o => o.stage === stage.name);
      const totalAmount = stageOpps.reduce((sum, o) => sum + o.amount, 0);
      const weightedAmount = stageOpps.reduce(
        (sum, o) => sum + o.amount * (stage.probability / 100),
        0
      );

      return {
        stageId: stage.id,
        stageName: stage.name,
        count: stageOpps.length,
        totalAmount,
        weightedAmount,
        averageAmount: stageOpps.length > 0 
          ? totalAmount / stageOpps.length 
          : 0
      };
    });

    return {
      pipelineId,
      totalOpportunities: opportunities.length,
      totalValue: opportunities.reduce((sum, o) => sum + o.amount, 0),
      weightedValue: opportunities.reduce(
        (sum, o) => sum + o.amount * (o.probability / 100),
        0
      ),
      stageAnalytics
    };
  }

  async forecastRevenue(
    pipelineId: string,
    forecastDate: Date
  ): Promise<RevenueForecast> {
    const opportunities = await this.opportunityRepository.findByPipeline(pipelineId);
    
    // Categorize by expected close date
    const byMonth = new Map<string, number>();
    
    for (const opp of opportunities) {
      if (opp.stage === OpportunityStage.CLOSED_WON) continue;
      if (opp.stage === OpportunityStage.CLOSED_LOST) continue;
      
      const monthKey = `${opp.closeDate.getFullYear()}-${String(opp.closeDate.getMonth() + 1).padStart(2, '0')}`;
      const current = byMonth.get(monthKey) || 0;
      byMonth.set(
        monthKey, 
        current + (opp.amount * opp.probability / 100)
      );
    }

    return {
      forecastDate,
      monthlyForecast: Array.from(byMonth.entries()).map(([month, amount]) => ({
        month,
        amount: Math.round(amount)
      })),
      totalForecast: Array.from(byMonth.values()).reduce((sum, a) => sum + a, 0)
    };
  }
}
