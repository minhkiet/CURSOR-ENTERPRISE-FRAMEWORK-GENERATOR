**6. Reporting Dashboard**

```typescript
// services/crm-dashboard.service.ts
export interface CRMDashboard {
  overview: DashboardOverview;
  salesPipeline: PipelineSummary;
  topPerformers: SalesRepPerformance[];
  recentActivities: ActivitySummary[];
  forecasts: ForecastSummary;
}

export interface DashboardOverview {
  totalLeads: number;
  newLeadsThisWeek: number;
  totalOpportunities: number;
  pipelineValue: number;
  closedWonThisMonth: number;
  closedWonValue: number;
  conversionRate: number;
}

export class CRMDashboardService {
  async getDashboard(tenantId: string, userId: string): Promise<CRMDashboard> {
    const [
      overview,
      salesPipeline,
      topPerformers,
      recentActivities,
      forecasts
    ] = await Promise.all([
      this.getOverview(tenantId),
      this.getSalesPipeline(tenantId),
      this.getTopPerformers(tenantId),
      this.getRecentActivities(tenantId),
      this.getForecasts(tenantId)
    ]);

    return {
      overview,
      salesPipeline,
      topPerformers,
      recentActivities,
      forecasts
    };
  }

  private async getOverview(tenantId: string): Promise<DashboardOverview> {
    const weekAgo = subDays(new Date(), 7);
    const monthStart = startOfMonth(new Date());

    const [
      totalLeads,
      newLeadsThisWeek,
      totalOpportunities,
      pipelineValue,
      closedWon,
      closedWonValue,
      totalClosed
    ] = await Promise.all([
      this.leadRepository.count({ tenantId }),
      this.leadRepository.count({ tenantId, createdAt: { gte: weekAgo } }),
      this.opportunityRepository.count({ 
        tenantId, 
        stage: { $nin: ['closed_won', 'closed_lost'] } 
      }),
      this.opportunityRepository.sumAmount({ tenantId }),
      this.opportunityRepository.count({
        tenantId,
        stage: 'closed_won',
        closedAt: { gte: monthStart }
      }),
      this.opportunityRepository.sumAmount({
        tenantId,
        stage: 'closed_won',
        closedAt: { gte: monthStart }
      }),
      this.leadRepository.count({
        tenantId,
        status: 'converted'
      })
    ]);

    return {
      totalLeads,
      newLeadsThisWeek,
      totalOpportunities,
      pipelineValue,
      closedWonThisMonth: closedWon,
      closedWonValue,
      conversionRate: totalLeads > 0 
        ? (totalClosed / totalLeads) * 100 
        : 0
    };
  }

  async getSalesRepPerformance(
    tenantId: string,
    options: { startDate?: Date; endDate?: Date } = {}
  ): Promise<SalesRepPerformance[]> {
    const reps = await this.userRepository.findByRole(tenantId, 'sales_rep');
    
    const performances = await Promise.all(
      reps.map(async (rep) => {
        const [opportunities, closedWon, closedWonValue] = await Promise.all([
          this.opportunityRepository.countByOwner(rep.id, options),
          this.opportunityRepository.countByOwner(rep.id, {
            ...options,
            stage: 'closed_won'
          }),
          this.opportunityRepository.sumAmountByOwner(rep.id, {
            ...options,
            stage: 'closed_won'
          })
        ]);

        return {
          userId: rep.id,
          userName: rep.name,
          avatar: rep.avatar,
          totalOpportunities: opportunities,
          closedWon,
          closedWonValue,
          conversionRate: opportunities > 0 
            ? (closedWon / opportunities) * 100 
            : 0
        };
      })
    );

    return performances.sort((a, b) => b.closedWonValue - a.closedWonValue);
  }
}
```

## Workflow

**Phase 1: Requirements Analysis**

Define CRM scope. Identify user roles. Plan integrations. Define KPIs.

**Phase 2: Data Model Design**

Design entities. Define relationships. Plan indexes. Design for multi-tenancy.

**Phase 3: Core Features**

Implement leads. Build contacts. Create accounts. Set up opportunities.

**Phase 4: Workflow Automation**

Define workflows. Implement triggers. Create actions. Test automations.

**Phase 5: Reporting**

Build dashboards. Create reports. Set up analytics. Configure forecasting.

**Phase 6: Integration**

Connect email. Integrate telephony. Link ERP. Enable API.

