    request_lower = request.lower()
    
    for auth_type, pattern in AUTH_PATTERNS.items():
        keywords = (
            pattern.get("vi_keywords", []) +
            pattern.get("en_keywords", []) +
            pattern.get("zh_keywords", []) +
