def detect_auth_intent(request: str, language: str = "en") -> dict:
    """
    Detect authentication-related intent
    Returns: {
        "is_auth_task": bool,
        "auth_type": str | None,
        "criticality": str,
        "required_skills": list,
        "clarification_questions": list
    }
