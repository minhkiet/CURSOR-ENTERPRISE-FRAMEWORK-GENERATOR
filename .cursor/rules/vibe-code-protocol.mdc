## PHẦN J: DYNAMIC CONFIDENCE & RETRY LOGIC

### J.1 Dynamic Confidence Thresholds

```python
BASE_CONFIDENCE_THRESHOLDS = {
    "frontend-taste": 0.75,
    "frontend-redesign": 0.75,
    "full-output": 0.80,
    "frontend-review": 0.70,
    "security-review": 0.85,
    "vietnam-payment-review": 0.90,
    "karpathy-coding": 0.75,
    "ponytail": 0.80,
    "visual-explainer": 0.85
}


def calculate_dynamic_threshold(
    skill_name: str,
    request: str,
    context: dict
) -> float:
    """
    Calculate dynamic confidence threshold based on context
    """
    base = BASE_CONFIDENCE_THRESHOLDS.get(skill_name, 0.7)
    
    word_count = len(request.split())
    adjustments = []
    
    # Short requests need lower threshold (harder to detect)
    if word_count < 5:
        adjustments.append(-0.10)
    elif word_count < 10:
        adjustments.append(-0.05)
    
    # Technical requests can use higher threshold
    if context.get("has_technical_context"):
        adjustments.append(0.05)
    
    # Mixed language - harder to detect
    if context.get("is_mixed_language"):
        adjustments.append(-0.05)
    
    # Has explicit keywords - easier to detect
    if context.get("has_explicit_keywords"):
        adjustments.append(0.10)
    
    # Critical domains need higher threshold
    if skill_name in ["security-review", "vietnam-payment-review"]:
        adjustments.append(0.05)
    
    # Auth tasks are critical
    if context.get("is_auth_task"):
        adjustments.append(0.05)
    
    final_threshold = base + sum(adjustments)
    
    # Clamp to reasonable range
    return max(0.50, min(0.95, final_threshold))


def apply_dynamic_threshold(
    skill_discovery: dict,
    request: str,
    context: dict
) -> dict:
    """
    Re-evaluate skills with dynamic thresholds
    """
    updated_skills = []
    
    for skill in skill_discovery.get("skills", []):
        skill_name = skill["name"]
        base_confidence = skill.get("confidence", 0)
        
        dynamic_threshold = calculate_dynamic_threshold(
            skill_name, request, context
        )
        
        # Check if skill still passes with dynamic threshold
        passes_threshold = base_confidence >= dynamic_threshold
        
        updated_skills.append({
            **skill,
            "dynamic_threshold": dynamic_threshold,
            "passes_dynamic": passes_threshold,
            "threshold_applied": "dynamic",
            "original_threshold": skill_discovery.get("thresholds", {}).get(skill_name, dynamic_threshold)
        })
    
    return {
        **skill_discovery,
        "skills": updated_skills,
        "context_applied": True
    }
```

### J.2 Retry Logic with Fallback

```python
EXECUTION_STRATEGIES = {
    "primary": {
        "name": "Full Implementation",
        "description": "Complete implementation with all detected skills and rules",
        "aggressiveness": "HIGH"
    },
    
    "fallback_conservative": {
        "name": "Conservative Fallback",
        "description": "Simplified implementation focusing on core functionality",
        "aggressiveness": "MEDIUM",
        "rules": ["karpathy-coding"],  # Only essential rules
        "skills": ["karpathy-coding"]
    },
    
    "fallback_minimal": {
        "name": "Minimal Fallback",
        "description": "Minimal working implementation",
        "aggressiveness": "LOW",
        "rules": [],
        "skills": ["karpathy-coding"]
    }
}


def execute_with_retry(
    request: str,
    context: dict,
    max_retries: int = 2
) -> dict:
    """
    Execute with retry logic and fallback strategies
    """
    execution_log = []
    current_strategy = "primary"
    
    for attempt in range(max_retries + 1):
        execution_log.append({
            "attempt": attempt + 1,
            "strategy": current_strategy,
            "timestamp": datetime.now().isoformat()
        })
        
        try:
            # Run pre-execution validation
            validation = pre_execution_validation(
                request, context
            )
            
            if not validation["can_proceed"]:
                if attempt < max_retries:
                    current_strategy = get_next_strategy(current_strategy)
                    execution_log[-1]["reason"] = "validation_failed_switching_strategy"
                    continue
                else:
                    return {
                        "success": False,
                        "error": "validation_failed",
                        "failed_checks": validation["blocking_issues"],
                        "execution_log": execution_log
                    }
            
            # Execute with current strategy
            result = execute_with_strategy(
                request, context, current_strategy
            )
            
            if result["success"]:
                return {
                    **result,
                    "execution_log": execution_log,
                    "final_strategy": current_strategy,
                    "attempts_used": attempt + 1
                }
            
            # On failure, try fallback
            if attempt < max_retries:
                current_strategy = get_next_strategy(current_strategy)
                execution_log[-1]["reason"] = "execution_failed_switching_strategy"
                execution_log[-1]["error"] = result.get("error")
                
        except Exception as e:
            execution_log[-1]["error"] = str(e)
            execution_log[-1]["exception"] = True
            
            if attempt < max_retries:
                current_strategy = get_next_strategy(current_strategy)
            else:
                return {
                    "success": False,
                    "error": str(e),
                    "execution_log": execution_log,
                    "exhausted_fallbacks": True
                }
    
    return {
        "success": False,
        "error": "all_strategies_exhausted",
        "execution_log": execution_log
    }


def get_next_strategy(current: str) -> str:
    """Get next fallback strategy"""
    strategy_order = ["primary", "fallback_conservative", "fallback_minimal"]
    current_idx = strategy_order.index(current) if current in strategy_order else 0
    
    if current_idx < len(strategy_order) - 1:
        return strategy_order[current_idx + 1]
    
    return "fallback_minimal"


def execute_with_strategy(
    request: str,
    context: dict,
    strategy: str
) -> dict:
    """
    Execute vibe code with specific strategy
    """
    strategy_config = EXECUTION_STRATEGIES.get(strategy, EXECUTION_STRATEGIES["primary"])
    
    # Limit rules and skills based on strategy
    active_rules = strategy_config.get("rules", context.get("active_rules", []))
    active_skills = strategy_config.get("skills", context.get("active_skills", []))
    
    # Execute implementation
    result = execute_vibe_code(
        request,
        {
            **context,
            "active_rules": active_rules,
            "active_skills": active_skills,
            "strategy": strategy,
            "aggressiveness": strategy_config["aggressiveness"]
        }
    )
    
    return result
```

