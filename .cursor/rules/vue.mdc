**2. Component with Composition API**

```vue
<!-- components/features/users/UserProfile.vue -->
<script setup lang="ts">
import { ref, computed, onMounted, watch } from 'vue';
import type { User } from '@/types/user';
import { useUserStore } from '@/stores/user';
import { formatDate } from '@/utils/date';

interface Props {
  userId: string;
  showActions?: boolean;
}

const props = withDefaults(defineProps<Props>(), {
  showActions: true
});

const emit = defineEmits<{
  (e: 'update', user: User): void;
  (e: 'delete', userId: string): void;
}>();

// State
const user = ref<User | null>(null);
const isLoading = ref(false);
const error = ref<string | null>(null);

// Composables
const userStore = useUserStore();

// Computed
const fullName = computed(() => {
  if (!user.value) return '';
  return `${user.value.firstName} ${user.value.lastName}`;
});

const displayRole = computed(() => {
  if (!user.value) return '';
  return user.value.role.replace('_', ' ').toUpperCase();
});

// Methods
async function fetchUser() {
  isLoading.value = true;
  error.value = null;
  
  try {
    user.value = await userStore.getUser(props.userId);
  } catch (e) {
    error.value = e instanceof Error ? e.message : 'Failed to load user';
  } finally {
    isLoading.value = false;
  }
}

function handleUpdate() {
  if (user.value) {
    emit('update', user.value);
  }
}

function handleDelete() {
  emit('delete', props.userId);
}

// Lifecycle
onMounted(() => {
  fetchUser();
});

// Watchers
watch(() => props.userId, () => {
  fetchUser();
});
</script>

<template>
  <div v-if="isLoading" class="loading">
    Loading user...
  </div>
  
  <div v-else-if="error" class="error">
    {{ error }}
  </div>
  
  <div v-else-if="user" class="user-profile">
    <div class="header">
