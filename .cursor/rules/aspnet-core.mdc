**2. Clean Architecture Layers**

```csharp
// Domain/Entities/Order.cs
namespace Domain.Entities;

public class Order : BaseEntity
{
    public Guid CustomerId { get; private set; }
    public OrderStatus Status { get; private set; }
    public decimal Total { get; private set; }
    public ShippingAddress ShippingAddress { get; private set; }
    
    private readonly List<OrderItem> _items = new();
    public IReadOnlyCollection<OrderItem> Items => _items.AsReadOnly();
    
    private readonly List<OrderEvent> _events = new();
    public IReadOnlyCollection<OrderEvent> Events => _events.AsReadOnly();
    
    // Domain logic
    public static Order Create(
        Guid customerId,
        ShippingAddress shippingAddress)
    {
        var order = new Order
        {
            Id = Guid.NewGuid(),
            CustomerId = customerId,
            Status = OrderStatus.Pending,
            ShippingAddress = shippingAddress,
            CreatedAt = DateTime.UtcNow
        };
        
        order.AddDomainEvent(new OrderCreatedEvent(order));
        
        return order;
    }
    
    public void AddItem(Product product, int quantity, decimal price)
    {
        var item = OrderItem.Create(this.Id, product, quantity, price);
        _items.Add(item);
        RecalculateTotal();
    }
    
    public void RecalculateTotal()
    {
        Total = _items.Sum(i => i.Subtotal);
    }
    
    public bool CanBeCancelled() =>
        Status == OrderStatus.Pending || Status == OrderStatus.Confirmed;
}
```

