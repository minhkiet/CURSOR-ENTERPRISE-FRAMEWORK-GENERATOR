**4. Error Handling Pattern**

```json
{
  "name": "API Integration with Error Handling",
  "nodes": [
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300]
    },
    {
      "name": "Try Block",
      "type": "n8n-nodes-base.wait",
      "position": [500, 300],
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      }
    },
    {
      "name": "API Call",
      "type": "n8n-nodes-base.httpRequest",
      "position": [750, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.API_URL }}/process",
        "options": {
          "timeout": 30000,
          "retry": {
            "maxRetries": 3,
            "retryWaitMax": 10000
          }
        }
      }
    },
    {
      "name": "Success Path",
      "type": "n8n-nodes-base.noOp",
      "position": [1000, 200],
      "parameters": {}
    },
    {
      "name": "Retry Handler",
      "type": "n8n-nodes-base.errorTrigger",
      "position": [1000, 400],
      "parameters": {}
    },
    {
      "name": "Send Alert",
      "type": "n8n-nodes-base.slack",
      "position": [1250, 400],
      "parameters": {
        "channel": "#alerts",
        "text": "=: Execution failed: {{ $json.execution.id }}"
      }
    },
    {
      "name": "Queue for Retry",
      "type": "n8n-nodes-base.redis",
      "position": [1250, 600],
      "parameters": {
        "operation": "lpush",
        "key": "retry-queue",
        "value": "={{ JSON.stringify($json.execution) }}"
      }
    }
  ]
}
```

