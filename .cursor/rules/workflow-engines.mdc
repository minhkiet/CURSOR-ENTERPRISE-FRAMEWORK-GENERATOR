**2. Job Definitions**

```typescript
// jobs/order/order-confirmation.job.ts
import { eventTrigger, interval, Job } from '@trigger.dev/sdk';
import { z } from 'zod';
import { Resend } from '@trigger.dev/resend';
import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();
const resend = new Resend(process.env.RESEND_API_KEY);

export const orderConfirmationJob = new Job({
  id: 'order-confirmation',
  name: 'Send Order Confirmation',
  version: '1.0.0',
  trigger: eventTrigger({
    name: 'order.created',
    schema: z.object({
      orderId: z.string(),
      customerId: z.string(),
      email: z.string().email(),
      items: z.array(z.object({
        productId: z.string(),
        name: z.string(),
        quantity: z.number(),
        price: z.number()
      })),
      total: z.number(),
      shippingAddress: z.object({
        street: z.string(),
        city: z.string(),
        country: z.string(),
        postalCode: z.string()
      })
    })
  }),
  
  async run(trigger, io) {
    const { orderId, customerId, email, items, total, shippingAddress } = trigger.payload;

    await io.logger.info('Processing order confirmation', { orderId, customerId });

    // Generate order details
    const orderDetails = await io.runTask('generate-order-details', async () => {
      return {
        orderId,
        items,
        total,
        estimatedDelivery: calculateDeliveryDate(),
        trackingUrl: `https://tracking.example.com/${orderId}`
      };
    }, { 
      name: 'Generate Order Details',
      timeout: '10s'
    });

    // Send confirmation email
    await io.runTask('send-confirmation-email', async () => {
      await resend.emails.send({
        from: 'orders@example.com',
        to: email,
        subject: `Order Confirmation - ${orderId}`,
        html: generateConfirmationEmailHtml({
          orderId,
          items,
          total,
          ...orderDetails
        })
      });
    }, {
      name: 'Send Email',
      timeout: '30s',
      retry: {
        maxAttempts: 3,
        minTimeout: '10s',
        maxTimeout: '5m',
        factor: 2
      }
    });

    // Update database
    await io.runTask('update-order-status', async () => {
      await prisma.order.update({
        where: { id: orderId },
        data: { 
          confirmationSentAt: new Date(),
          status: 'confirmed'
        }
      });
    }, {
      name: 'Update Database',
      timeout: '5s'
    });

    await io.logger.info('Order confirmation completed', { orderId });
  }
});

// Helper function
function calculateDeliveryDate(): string {
  const delivery = new Date();
  delivery.setDate(delivery.getDate() + 5);
  return delivery.toLocaleDateString('en-US', { 
    weekday: 'long',
    month: 'long',
    day: 'numeric'
  });
}

function generateConfirmationEmailHtml(data: any): string {
  return `
    <h1>Order Confirmation</h1>
    <p>Thank you for your order!</p>
    <p><strong>Order ID:</strong> ${data.orderId}</p>
    <p><strong>Total:</strong> $${data.total.toFixed(2)}</p>
    <p><strong>Estimated Delivery:</strong> ${data.estimatedDelivery}</p>
  `;
}
```

**3. Scheduled Jobs**

```typescript
// jobs/reporting/daily-report.job.ts
import { scheduleEvent, Job } from '@trigger.dev/sdk';
import { z } from 'zod';

export const dailyReportJob = new Job({
  id: 'daily-report',
  name: 'Generate Daily Report',
  version: '1.0.0',
  trigger: scheduleEvent({
    cron: '0 8 * * *',  // Daily at 8 AM UTC
    timezone: 'UTC'
  }),
  
  async run(trigger, io) {
    const reportDate = new Date().toISOString().split('T')[0];
    
    await io.logger.info('Starting daily report generation', { reportDate });

    // Fetch metrics from various sources
    const salesData = await io.runTask('fetch-sales-data', async () => {
      return await fetch(`${process.env.API_URL}/reports/sales?date=${reportDate}`)
        .then(res => res.json());
    }, { name: 'Fetch Sales', timeout: '30s' });

    const userMetrics = await io.runTask('fetch-user-metrics', async () => {
      return await fetch(`${process.env.API_URL}/reports/users?date=${reportDate}`)
        .then(res => res.json());
    }, { name: 'Fetch Users', timeout: '30s' });

    const operationalMetrics = await io.runTask('fetch-operational-metrics', async () => {
      return await fetch(`${process.env.API_URL}/reports/operations?date=${reportDate}`)
        .then(res => res.json());
    }, { name: 'Fetch Operations', timeout: '30s' });

    // Generate report
    const report = await io.runTask('generate-report', async () => {
      return {
        date: reportDate,
        summary: {
          totalSales: salesData.total,
          totalOrders: salesData.orderCount,
          newUsers: userMetrics.newUsers,
          activeUsers: userMetrics.activeUsers,
          avgResponseTime: operationalMetrics.avgResponseTime,
          errorRate: operationalMetrics.errorRate
        },
        generatedAt: new Date().toISOString()
      };
    }, { name: 'Generate Report', timeout: '10s' });

    // Send report via Slack
    await io.runTask('send-slack-notification', async () => {
      await fetch(process.env.SLACK_WEBHOOK_URL!, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          blocks: [
            { type: 'header', text: { type: 'plain_text', text: 'Daily Report' } },
            { type: 'section', fields: [
              { type: 'mrkdwn', text: `*Sales:* $${report.summary.totalSales}` },
              { type: 'mrkdwn', text: `*Orders:* ${report.summary.totalOrders}` },
              { type: 'mrkdwn', text: `*New Users:* ${report.summary.newUsers}` },
              { type: 'mrkdwn', text: `*Active Users:* ${report.summary.activeUsers}` }
            ]}
          ]
        })
      });
    }, {
      name: 'Send Slack',
      timeout: '10s',
      retry: { maxAttempts: 3 }
    });

    await io.logger.info('Daily report completed', { reportDate, report });
  }
});
