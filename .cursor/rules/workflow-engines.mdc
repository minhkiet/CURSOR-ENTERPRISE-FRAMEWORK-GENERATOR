```typescript
// triggers/webhook/stripe.trigger.ts
import { Job } from '@trigger.dev/sdk';
import { z } from 'zod';
import Stripe from 'stripe';

const stripe = new Stripe(process.env.STRIPE_SECRET_KEY!);

export const stripeWebhookJob = new Job({
  id: 'stripe-webhook',
  name: 'Stripe Webhook Handler',
  version: '1.0.0',
  trigger: {
    // Custom webhook endpoint
    schema: z.object({
      type: z.string(),
      data: z.object({
        object: z.any()
      })
    })
  },
  
  async run(trigger, io) {
    const { type, data } = trigger.payload;

    await io.logger.info('Processing Stripe webhook', { type, eventId: data.object.id });

    switch (type) {
      case 'payment_intent.succeeded':
        await handlePaymentSuccess(data.object, io);
        break;
        
      case 'payment_intent.payment_failed':
        await handlePaymentFailure(data.object, io);
        break;
        
      case 'customer.subscription.created':
        await handleSubscriptionCreated(data.object, io);
        break;
        
      case 'customer.subscription.deleted':
        await handleSubscriptionDeleted(data.object, io);
        break;
        
      case 'invoice.payment_succeeded':
        await handleInvoicePaid(data.object, io);
        break;
        
      default:
        await io.logger.info('Unhandled Stripe event type', { type });
    }
  }
});

async function handlePaymentSuccess(paymentIntent: Stripe.PaymentIntent, io: any) {
  await io.runTask('update-order-status', async () => {
    // Update order status to paid
    await db.order.update({
      where: { stripePaymentId: paymentIntent.id },
      data: { 
        status: 'paid',
        paidAt: new Date()
      }
    });
  }, { name: 'Update Order', timeout: '10s' });

  await io.logger.info('Payment succeeded', { 
    paymentIntentId: paymentIntent.id,
    amount: paymentIntent.amount 
  });
}

async function handlePaymentFailure(paymentIntent: Stripe.PaymentIntent, io: any) {
  await io.runTask('handle-payment-failure', async () => {
    await db.order.update({
      where: { stripePaymentId: paymentIntent.id },
      data: { 
        status: 'payment_failed',
        failureMessage: paymentIntent.last_payment_error?.message
      }
    });
    
    // Send notification to customer
    await emailService.sendPaymentFailureNotification(
      paymentIntent.metadata.customerId,
      paymentIntent.last_payment_error?.message || 'Payment failed'
    );
  }, { name: 'Handle Failure', timeout: '10s' });

  await io.logger.warn('Payment failed', { 
    paymentIntentId: paymentIntent.id,
    error: paymentIntent.last_payment_error 
  });
}
