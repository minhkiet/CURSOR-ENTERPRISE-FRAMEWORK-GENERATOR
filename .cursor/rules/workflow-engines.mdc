**5. Batch Processing**

```typescript
// jobs/user/user-sync.job.ts
import { Job } from '@trigger.dev/sdk';
import { z } from 'zod';

export const userSyncJob = new Job({
  id: 'user-sync',
  name: 'Sync Users to External CRM',
  version: '1.0.0',
  trigger: {
    schema: z.object({
      batchId: z.string().optional()
    })
  },
  
  async init() {
    return { apiKey: process.env.CRM_API_KEY };
  },
  
  async run(trigger, io, init) {
    await io.logger.info('Starting user sync', { batchId: trigger.payload.batchId });

    // Get users to sync
    const users = await io.runTask('fetch-users', async () => {
      return await db.user.findMany({
        where: { 
          syncedAt: null,
          status: 'active'
        },
        take: 1000
      });
    }, { name: 'Fetch Users', timeout: '30s' });

    if (users.length === 0) {
      await io.logger.info('No users to sync');
      return { synced: 0 };
    }

    // Process in batches
    const batchSize = 50;
    let syncedCount = 0;

    for (let i = 0; i < users.length; i += batchSize) {
      const batch = users.slice(i, i + batchSize);
      
      await io.runTask(`sync-batch-${i / batchSize}`, async () => {
        // Call CRM API
        const response = await fetch(`${process.env.CRM_API_URL}/contacts/batch`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${init.apiKey}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            contacts: batch.map(user => ({
              email: user.email,
              firstName: user.firstName,
              lastName: user.lastName,
              externalId: user.id
            }))
          })
        });

        if (!response.ok) {
          throw new Error(`CRM API failed: ${response.status}`);
        }

        const result = await response.json();
        
        // Update synced status
        await db.user.updateMany({
          where: { id: { in: batch.map(u => u.id) } },
          data: { syncedAt: new Date() }
        });

        return { synced: batch.length, result };
      }, {
        name: `Sync Batch ${i / batchSize}`,
        timeout: '60s',
        retry: { maxAttempts: 3 }
      });

      syncedCount += batch.length;
      
      await io.logger.info('Batch synced', { 
        batchIndex: i / batchSize, 
        syncedCount 
      });
    }

    return { synced: syncedCount };
  }
});
