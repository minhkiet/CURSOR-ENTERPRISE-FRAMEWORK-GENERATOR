# Anti Patterns

## Authentication Anti-Patterns

### 1. Storing Passwords in Plain Text

```typescript
// Không nên
const user = { email: 'user@example.com', password: 'plaintextpassword' };

// Nên
const user = { email: 'user@example.com', passwordHash: await bcrypt.hash(password, 12) };
```

### 2. Using MD5 hoặc SHA1 cho Passwords

```typescript
// Không nên
const hash = crypto.createHash('md5').update(password).digest('hex');

// Nên
const hash = await bcrypt.hash(password, 12);
```

### 3. JWT Without Expiration

```typescript
// Không nên
const token = jwt.sign({ userId }, secret);

// Nên
const token = jwt.sign({ userId }, secret, { expiresIn: '15m' });
```

### 4. Storing Tokens in LocalStorage

```typescript
// Không nên
localStorage.setItem('token', token);

// Nên
res.cookie('token', token, { httpOnly: true, secure: true, sameSite: 'strict' });
```

### 5. Weak Password Reset Flow

```typescript
// Không nên
const token = user.id;

// Nên
const token = randomBytes(32).toString('hex');
```

## Authorization Anti-Patterns

### 1. Hardcoded Role Checks

```typescript
// Không nên
if (req.user.role === 'ADMIN') { /* action */ }

// Nên
if (await permissionService.hasPermission(req.user.id, Permission.USER_MANAGE)) { /* action */ }
```

### 2. Client-Side Authorization Only

```typescript
// Không nên
const canDelete = user.role === 'admin';

// Nên
async function deletePost(req: Request, res: Response) {
    const canDelete = await permissionService.canDelete(req.user.id, req.params.id);
    if (!canDelete) throw new AuthorizationError();
}
```

### 3. Missing Default Deny

```typescript
// Không nên
async function accessResource(userId: string, resourceId: string) {
    return resource; // No check!
}

// Nên
async function accessResource(userId: string, resourceId: string) {
    const hasAccess = await permissionService.canAccess(userId, resourceId);
    if (!hasAccess) throw new AuthorizationError('Access denied');
    return resource;
}
```

### 4. Permission Proliferation

```typescript
// Không nên - too many granular permissions
Permission.POST_UPDATE_OWN
Permission.POST_UPDATE_TEAM
Permission.POST_UPDATE_PUBLIC
Permission.POST_UPDATE_PRIVATE

// Nên - logical grouping
Permission.POST_UPDATE
Permission.POST_MANAGE
```

### 5. No Audit Trail

```typescript
// Không nên
async function deleteUser(id: string) {
    await db.users.delete(id);
}

// Nên
async function deleteUser(id: string, deletedBy: string, reason: string) {
    await auditLog.log({ userId: deletedBy, action: 'DELETE', resource: id, reason });
    await db.users.delete(id);
}
```

