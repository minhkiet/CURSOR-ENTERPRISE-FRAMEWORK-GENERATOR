```typescript
class ScopeAuthorization {
    validateScope(requiredScopes: string[]): RequestHandler {
        return async (req: Request, res: Response, next: NextFunction) => {
            const tokenScopes = req.authInfo?.scope || [];
            const hasAllScopes = requiredScopes.every(scope =>
                tokenScopes.includes(scope)
            );

            if (!hasAllScopes) {
                return res.status(403).json({
                    error: {
                        code: 'INSUFFICIENT_SCOPE',
                        message: `Required scopes: ${requiredScopes.join(', ')}`
                    }
                });
            }

            next();
        };
    }
}
```

### 9. Delegation và Impersonation

Allow authorized users to act on behalf of others.

```typescript
class ImpersonationService {
    constructor(private auditLog: AuditLogService) {}

    async startImpersonation(
        adminUserId: string,
        targetUserId: string,
        reason: string
    ): Promise<ImpersonationSession> {
        const admin = await this.userService.findById(adminUserId);
        if (!admin.roles.includes('ADMIN')) {
            throw new AuthorizationError('Admin privileges required');
        }

        const targetUser = await this.userService.findById(targetUserId);
        if (targetUser.roles.includes('SUPER_ADMIN')) {
            throw new AuthorizationError('Cannot impersonate super admin');
        }

        const session: ImpersonationSession = {
            id: nanoid(),
            adminUserId,
            targetUserId,
            reason,
            startedAt: new Date(),
            expiresAt: new Date(Date.now() + 30 * 60 * 1000),
            originalPermissions: admin.permissions
        };

        await this.auditLog.log('IMPERSONATION_STARTED', { adminUserId, targetUserId, reason });
        return session;
    }

    getEffectiveIdentity(
        requestUserId: string,
        impersonation?: ImpersonationSession
    ): Identity {
        if (impersonation) {
            return {
                userId: impersonation.targetUserId,
                isImpersonating: true,
                impersonatedBy: impersonation.adminUserId
            };
        }
        return { userId: requestUserId, isImpersonating: false };
    }
}
```

### 10. Audit Logging

Track authorization decisions for security.

```typescript
interface AuthorizationAuditLog {
    id: string;
    timestamp: Date;
    userId: string;
    action: string;
    resource: { type: string; id: string };
    decision: 'PERMIT' | 'DENY';
    reason: string;
    context: { ip: string; userAgent: string; sessionId: string };
    evaluationDetails?: { roles: string[]; permissions: string[]; policies: string[] };
}

class AuthorizationAuditService {
    constructor(
        private auditRepository: AuditRepository,
        private logger: Logger
    ) {}

    async logAccessDecision(log: AuthorizationAuditLog): Promise<void> {
        await this.auditRepository.save(log);

        this.logger.info('Authorization decision', {
            type: 'AUTHORIZATION',
            userId: log.userId,
            action: log.action,
            decision: log.decision,
            reason: log.reason
        });

        if (log.decision === 'DENY') {
            await this.alertService.alert('ACCESS_DENIED', {
                userId: log.userId,
                action: log.action,
                resource: log.resource,
                reason: log.reason
            });
        }
    }
}
```

### 11. Centralized Permission Service

```typescript
class PermissionService {
    constructor(
        private roleRepository: RoleRepository,
        private cache: RedisClient
    ) {}

    async hasPermission(userId: string, permission: Permission): Promise<boolean> {
        const userPermissions = await this.getUserPermissions(userId);
        return userPermissions.includes(permission);
    }

    async hasAllPermissions(userId: string, permissions: Permission[]): Promise<boolean> {
        const userPermissions = await this.getUserPermissions(userId);
        return permissions.every(p => userPermissions.includes(p));
    }

    async hasAnyPermission(userId: string, permissions: Permission[]): Promise<boolean> {
        const userPermissions = await this.getUserPermissions(userId);
        return permissions.some(p => userPermissions.includes(p));
    }

    private async getUserPermissions(userId: string): Promise<Permission[]> {
        const cached = await this.cache.get(`permissions:${userId}`);
        if (cached) return JSON.parse(cached);

        const user = await this.userRepository.findByIdWithRoles(userId);
        const permissions = getEffectivePermissions(user.primaryRole);

        await this.cache.setex(`permissions:${userId}`, 300, JSON.stringify(permissions));
        return permissions;
    }
}
```

### 12. Policy Engine

```typescript
class PolicyEngine {
    constructor(
        private policies: Policy[],
        private abacEngine: ABACEngine
    ) {}

    async evaluate(
        subject: SubjectAttributes,
        resource: any,
        action: string,
        environment?: EnvironmentAttributes
    ): Promise<AuthorizationDecision> {
        const hasPermission = this.checkRBAC(subject, action);
        if (!hasPermission) {
            return { allowed: false, reason: 'Permission denied by RBAC' };
        }

        const env = environment || this.getDefaultEnvironment();
        const abacResult = this.abacEngine.evaluate(subject, resource, action, env);

        if (!abacResult) {
            return { allowed: false, reason: 'Permission denied by ABAC policy' };
        }

        return { allowed: true };
    }

    private checkRBAC(subject: SubjectAttributes, action: string): boolean {
        const requiredPermission = this.getPermissionForAction(action);
        return subject.permissions.includes(requiredPermission);
    }
}
```

