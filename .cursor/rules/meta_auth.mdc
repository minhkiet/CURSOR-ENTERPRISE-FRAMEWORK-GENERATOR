### 5. Session Management

Secure session handling.

```typescript
import session from 'express-session';
import RedisStore from 'connect-redis';

class SessionService {
    constructor(private redis: RedisClient) {}

    getSessionConfig(): session.SessionOptions {
        return {
            store: new RedisStore({ client: this.redis, prefix: 'session:' }),
            secret: process.env.SESSION_SECRET!,
            name: 'cursor.sid',
            resave: false,
            saveUninitialized: false,
            cookie: {
                secure: process.env.NODE_ENV === 'production',
                httpOnly: true,
                sameSite: 'strict',
                maxAge: 24 * 60 * 60 * 1000, // 24 hours
                path: '/'
            },
            genid: () => nanoid(32)
        };
    }

    async invalidateSession(sessionId: string): Promise<void> {
        await this.redis.del(`session:${sessionId}`);
    }

    async refreshSession(sessionId: string): Promise<void> {
        const sessionData = await this.redis.get(`session:${sessionId}`);
        if (sessionData) {
            await this.redis.expire(`session:${sessionId}`, 24 * 60 * 60);
        }
    }
}
```

### 6. Multi-Factor Authentication

MFA implementation với TOTP và backup codes.

```typescript
import speakeasy from 'speakeasy';
import QRCode from 'qrcode';
import { authenticator } from 'otplib';

class MFAService {
    constructor(
        private userService: UserService,
        private redis: RedisClient
    ) {}

    async generateMFASecret(userId: string): Promise<{
        secret: string;
        qrCode: string;
        backupCodes: string[];
    }> {
        const secret = authenticator.generateSecret();

        const backupCodes = Array.from({ length: 10 }, () =>
            randomBytes(8).toString('hex').toUpperCase()
        );

        const hashedBackupCodes = await Promise.all(
            backupCodes.map(code => bcrypt.hash(code, 10))
        );

        const user = await this.userService.findById(userId);
        const qrCode = await QRCode.toDataURL(
            authenticator.keyuri(user.email, 'Cursor', secret)
        );

        await this.redis.setex(`mfa:pending:${userId}`, 600, JSON.stringify({
            secret,
            backupCodes: hashedBackupCodes
        }));

        return { secret, qrCode, backupCodes };
    }

    async enableMFA(userId: string, token: string): Promise<boolean> {
        const pending = await this.redis.get(`mfa:pending:${userId}`);
        if (!pending) throw new AuthError('No pending MFA setup');

        const { secret } = JSON.parse(pending);
        const isValid = authenticator.verify({ token, secret });
        if (!isValid) throw new InvalidTokenError('Invalid MFA token');

        await this.userService.update(userId, {
            mfaEnabled: true,
            mfaSecret: await this.encryptSecret(secret)
        });

        await this.redis.del(`mfa:pending:${userId}`);
        await this.logSecurityEvent(userId, 'MFA_ENABLED');

        return true;
    }

    async verifyMFA(userId: string, token: string): Promise<boolean> {
        const user = await this.userService.findById(userId);
        if (!user.mfaEnabled) return false;

        const secret = await this.decryptSecret(user.mfaSecret);

        if (this.isBackupCode(token)) {
            return this.verifyBackupCode(userId, token);
        }

        return authenticator.verify({ token, secret });
    }
}
```

### 7. Credential Stuffing Protection

Protection against credential stuffing attacks.

```typescript
class CredentialStuffingProtection {
    constructor(
        private redis: RedisClient,
        private config: SecurityConfig
    ) {}

    async checkLoginAttempt(
        identifier: string,
        ip: string
    ): Promise<{ blocked: boolean; reason?: string }> {
        const ipAttempts = await this.redis.get(`login:failed:ip:${ip}`);
        if (ipAttempts && parseInt(ipAttempts) >= this.config.maxIpAttempts) {
            return { blocked: true, reason: 'Too many attempts from this IP' };
        }

        const accountAttempts = await this.redis.get(`login:failed:${identifier}`);
        if (accountAttempts && parseInt(accountAttempts) >= this.config.maxAccountAttempts) {
            return { blocked: true, reason: 'Account temporarily locked' };
        }

        return { blocked: false };
    }

    async recordFailedAttempt(identifier: string, ip: string): Promise<void> {
        await Promise.all([
            this.redis.incr(`login:failed:${identifier}`),
            this.redis.expire(`login:failed:${identifier}`, this.config.lockoutDuration),
            this.redis.incr(`login:failed:ip:${ip}`),
            this.redis.expire(`login:failed:ip:${ip}`, this.config.lockoutDuration)
        ]);
    }

    async recordSuccessfulLogin(userId: string, ip: string): Promise<void> {
        await Promise.all([
            this.redis.del(`login:failed:${userId}`),
            this.redis.del(`login:failed:${ip}`)
        ]);
    }
}
```

### 8. Magic Link Authentication

Passwordless authentication via email links.

```typescript
class MagicLinkService {
    constructor(
        private redis: RedisClient,
        private emailService: EmailService,
        private tokenService: TokenService
    ) {}

    async sendMagicLink(email: string): Promise<void> {
        const rateLimitKey = `magiclink:rate:${email}`;
        const attempts = await this.redis.incr(rateLimitKey);
        if (attempts > 5) throw new RateLimitError('Too many requests');
        await this.redis.expire(rateLimitKey, 3600);

        const token = randomBytes(32).toString('hex');
        const hashedToken = createHash('sha256').update(token).digest('hex');

        await this.redis.setex(`magiclink:${hashedToken}`, 900, JSON.stringify({
            email,
            createdAt: Date.now()
        }));

        const loginUrl = `${this.config.appUrl}/auth/magic-link/verify?token=${token}`;
        await this.emailService.send({
            to: email,
            template: 'magic-link',
            data: { loginUrl }
        });
    }

    async verifyMagicLink(token: string): Promise<TokenPair> {
        const hashedToken = createHash('sha256').update(token).digest('hex');
        const data = await this.redis.get(`magiclink:${hashedToken}`);

        if (!data) throw new InvalidTokenError('Invalid or expired magic link');

        const { email } = JSON.parse(data);
        await this.redis.del(`magiclink:${hashedToken}`);

        const user = await this.userService.findByEmail(email);
        if (!user) throw new AuthError('User not found');

        return this.tokenService.generateTokens(user);
    }
}
```

### 9. Biometric Authentication

Biometric authentication với WebAuthn.

```typescript
class BiometricService {
    constructor(
        private keyStore: KeyStore,
        private userService: UserService
    ) {}

    async registerCredential(
        userId: string,
        credential: PublicKeyCredentialCreationOptions
    ): Promise<{ credentialId: string; publicKey: string }> {
        const keyPair = await crypto.subtle.generateKey(
            { name: 'ECDSA', namedCurve: 'P-256' },
            true,
            ['sign', 'verify']
        );

        const publicKeyBuffer = await crypto.subtle.exportKey('spki', keyPair.publicKey);
        const publicKey = Buffer.from(publicKeyBuffer).toString('base64');

        await this.keyStore.store(userId, {
            credentialId: credential.id,
            publicKey,
            counter: 0
        });

        return { credentialId: credential.id, publicKey };
    }

    async authenticate(
        userId: string,
        assertion: AuthenticatorAssertionResponse
    ): Promise<boolean> {
        const storedKey = await this.keyStore.get(userId);
        if (!storedKey) throw new AuthError('No biometric credential registered');

        const data = new TextEncoder().encode(
            JSON.stringify(assertion.authenticatorData) + assertion.clientDataJSON
        );

        const signatureValid = await crypto.subtle.verify(
            { name: 'ECDSA', hash: 'SHA-256' },
            storedKey.publicKey,
            assertion.signature,
            data
        );

        if (!signatureValid) throw new AuthError('Biometric verification failed');

        await this.keyStore.update(userId, { counter: assertion.authenticatorData.counter });
        return true;
    }
}
```

