### 2. Service Communication Pattern

```typescript
// Base Service Client
export class ServiceClient<T> {
    constructor(
        private serviceName: string,
        private discovery: ServiceDiscovery,
        private options: ClientOptions = {}
    ) {}

    async call(method: string, ...args: any[]): Promise<T> {
        const url = await this.discovery.findService(this.serviceName);
        
        const breaker = new CircuitBreaker(
            async () => this.execute(url, method, args),
            this.options.circuitBreaker
        );

        return breaker.fire();
    }

    private async execute(url: string, method: string, args: any[]) {
        const response = await fetch(`${url}/${method}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-Correlation-ID': getCorrelationId()
            },
            body: JSON.stringify({ args }),
            signal: AbortSignal.timeout(this.options.timeout || 30000)
        });

        if (!response.ok) {
            throw new ServiceError(this.serviceName, response.status);
        }

        return response.json();
    }
}

// User Service Client
export class UserServiceClient extends ServiceClient<UserAPI> {
    constructor(discovery: ServiceDiscovery) {
        super('user-service', discovery);
    }

    async getUser(id: string): Promise<User> {
        return this.call('getUser', id);
    }

    async createUser(data: CreateUserDto): Promise<User> {
        return this.call('createUser', data);
    }

    async updateUser(id: string, data: UpdateUserDto): Promise<User> {
        return this.call('updateUser', id, data);
    }
}
```

### 3. Saga Orchestration

```typescript
// Saga Manager
interface SagaStep {
    name: string;
    execute: () => Promise<void>;
    compensate: () => Promise<void>;
}

class OrderSaga {
    private steps: SagaStep[] = [
        {
            name: 'reserve-inventory',
            execute: () => this.inventoryService.reserve(this.orderId),
            compensate: () => this.inventoryService.release(this.orderId)
        },
        {
            name: 'process-payment',
            execute: () => this.paymentService.charge(this.orderId),
            compensate: () => this.paymentService.refund(this.orderId)
        },
        {
            name: 'create-shipment',
            execute: () => this.shippingService.create(this.orderId),
            compensate: () => this.shippingService.cancel(this.orderId)
        },
        {
            name: 'send-notification',
            execute: () => this.notificationService.send(this.orderId),
            compensate: () => {} // No compensation needed
        }
    ];

    async execute(): Promise<void> {
        const executedSteps: SagaStep[] = [];

        try {
            for (const step of this.steps) {
                await step.execute();
                executedSteps.push(step);
            }
        } catch (error) {
            // Compensate in reverse order
            for (const step of executedSteps.reverse()) {
                try {
                    await step.compensate();
                } catch (compensateError) {
                    logger.error(`Compensation failed for ${step.name}`, {
                        error: compensateError
                    });
                    await this.sagaRepository.recordFailure(step.name, compensateError);
                }
            }
            throw error;
        }
    }
}
```

