### 4. Service Discovery

Implement service discovery để locate services dynamically.

```typescript
// Service Registry Implementation
import { Registry } from './registry';

class ServiceDiscovery {
    private registry: Registry;

    async findService(serviceName: string): Promise<string> {
        const instances = await this.registry.getInstances(serviceName);
        
        if (instances.length === 0) {
            throw new Error(`No instances found for ${serviceName}`);
        }

        // Load balancing strategy: round-robin
        const instance = this.selectInstance(instances);
        return `http://${instance.host}:${instance.port}`;
    }

    private selectInstance(instances: Instance[]): Instance {
        // Round-robin or weighted random
        const index = Math.floor(Math.random() * instances.length);
        return instances[index];
    }
}

// Registration
const userService = new UserService();
userService.register('user-service', 3000);
```

### 5. Asynchronous Communication

Sử dụng message queues cho async communication giữa services.

```typescript
// Message Producer
import { RabbitMQ } from 'rabbitmq-client';

const queue = new RabbitMQ({
    url: process.env.RABBITMQ_URL
});

await queue.publish('order.created', {
    orderId: '12345',
    userId: '67890',
    items: [...],
    timestamp: new Date().toISOString()
});

// Message Consumer
await queue.subscribe('order.created', async (msg) => {
    const { orderId, userId } = msg;
    
    // Process the order event
    await inventoryService.reserveItems(orderId);
    await notificationService.sendOrderConfirmation(userId, orderId);
    
    await queue.ack(msg);
});
```

### 6. Circuit Breaker Pattern

Implement circuit breaker để prevent cascading failures.

```typescript
import CircuitBreaker from 'opossum';

const options = {
    timeout: 3000,
    errorThresholdPercentage: 50,
    resetTimeout: 30000
};

const breaker = new CircuitBreaker(paymentService.processPayment, options);

breaker.fallback(() => {
    return { status: 'queued', message: 'Payment processing delayed' };
});

breaker.on('open', () => {
    logger.warn('Circuit breaker opened for payment service');
});

breaker.on('close', () => {
    logger.info('Circuit breaker closed for payment service');
});

// Usage
app.post('/checkout', async (req, res) => {
    const result = await breaker.fire(req.body);
    res.json(result);
});
```

### 7. Strangler Fig Pattern

Incremental migration từ monolith sang microservices.

```
┌──────────────────────────────────────────────────────────┐
│                    Migration Strategy                    │
│                                                          │
│  Phase 1          Phase 2          Phase 3               │
│  ┌────────┐      ┌────────┐      ┌────────┐             │
│  │Monolith│      │Monolith│      │Monolith│             │
│  │ + New  │  ->  │  (shrinking)│  │(decommissioned)│     │
│  │ Service│      │ + Service │  │ + Services │            │
│  └────────┘      └────────┘      └────────┘             │
└──────────────────────────────────────────────────────────┘
```

### 8. Event Sourcing

Use event sourcing để capture state changes as events.

```typescript
// Event Store
interface Event {
    id: string;
    aggregateId: string;
    type: string;
    payload: any;
    timestamp: Date;
    metadata: {
        correlationId: string;
        causationId: string;
    };
}

// Order Aggregate
class OrderAggregate {
    private events: Event[] = [];
    private state: OrderState;

    createOrder(orderData: OrderData): void {
        this.events.push({
            id: uuid(),
            aggregateId: this.id,
            type: 'ORDER_CREATED',
            payload: orderData,
            timestamp: new Date(),
            metadata: {}
        });
    }

    confirmPayment(paymentId: string): void {
        this.events.push({
            id: uuid(),
            aggregateId: this.id,
            type: 'ORDER_PAYMENT_CONFIRMED',
            payload: { paymentId },
            timestamp: new Date(),
            metadata: {}
        });
    }

    ship(shipmentId: string): void {
        this.events.push({
            id: uuid(),
            aggregateId: this.id,
            type: 'ORDER_SHIPPED',
            payload: { shipmentId },
            timestamp: new Date(),
            metadata: {}
        });
    }
}
```

