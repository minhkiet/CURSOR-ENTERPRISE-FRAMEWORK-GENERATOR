## Anti Patterns

### 1. Shared Database

```typescript
// Không nên - shared database giữa services
class OrderService {
    constructor(private db: SharedDatabase) {}

    async getOrder(id: string) {
        // Direct access to shared database
        return this.db.query('SELECT * FROM orders WHERE id = ?', [id]);
    }
}

// Service A writes to shared table
await db.query('INSERT INTO shared_table VALUES (?)', [data]);

// Service B also reads from same table
const data = await db.query('SELECT * FROM shared_table');
```

### 2. Chatty Services

```typescript
// Không nên - quá nhiều synchronous calls
async function getOrderDetails(orderId: string) {
    const order = await orderService.getOrder(orderId);
    
    // Chatty - nhiều calls riêng lẻ
    const user = await userService.getUser(order.userId);
    const items = await orderService.getOrderItems(orderId);
    
    for (const item of items) {
        const product = await catalogService.getProduct(item.productId);
        const inventory = await inventoryService.getStock(item.productId);
        item.product = product;
        item.inventory = inventory;
    }
    
    return { order, user, items };
}

// Nên - batch hoặc aggregate response
async function getOrderDetails(orderId: string) {
    return await orderService.getOrderFull(orderId); // Single call
}
```

### 3. God Services

```typescript
// Không nên - một service làm quá nhiều thứ
class MonolithicService {
    async handleUserAction() { /* user logic */ }
    async handleOrderAction() { /* order logic */ }
    async handlePaymentAction() { /* payment logic */ }
    async handleShippingAction() { /* shipping logic */ }
    async handleInventoryAction() { /* inventory logic */ }
    async handleNotificationAction() { /* notification logic */ }
}
```

### 4. Hard-coded Dependencies

```typescript
// Không nên
const paymentService = 'http://payment-service:3000/api';

// Nên - service discovery
const paymentServiceUrl = await serviceDiscovery.findService('payment-service');
const paymentService = new PaymentServiceClient(paymentServiceUrl);
```

### 5. Ignoring Failure Modes

```typescript
// Không nên - không handle failures
async function processOrder(orderId: string) {
    await paymentService.charge(orderId);
    await inventoryService.reserve(orderId);
    await shippingService.schedule(orderId);
    await notificationService.send(orderId);
}

// Nên - comprehensive error handling
async function processOrder(orderId: string) {
    try {
        await paymentService.charge(orderId);
    } catch (error) {
        logger.error('Payment failed', { orderId, error });
        await sagaManager.compensate(orderId, 'payment');
        throw error;
    }
}
```

