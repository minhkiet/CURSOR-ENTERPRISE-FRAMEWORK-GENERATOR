## Ví dụ

### Ví dụ 1: User Service với Full Implementation

```typescript
// src/index.ts
import express from 'express';
import { loadConfig } from './config';
import { createDatabase } from './database';
import { createRedisClient } from './cache';
import { setupTracing } from './tracing';
import { UserController } from './controllers/user.controller';
import { AuthController } from './controllers/auth.controller';
import { errorHandler, notFoundHandler } from './middleware';
import { healthCheck } from './health';

const config = loadConfig();
const app = express();

async function bootstrap() {
    // Setup infrastructure
    const db = await createDatabase(config.database);
    const redis = createRedisClient(config.redis);
    const tracer = setupTracing(config.tracing);

    // Setup middleware
    app.use(express.json());
    app.use(tracer.middleware());
    app.use(healthCheck());

    // Setup controllers
    const userController = new UserController(db, redis);
    const authController = new AuthController(db, redis);

    // Setup routes
    app.post('/api/users', userController.create);
    app.get('/api/users/:id', userController.getById);
    app.put('/api/users/:id', userController.update);
    app.delete('/api/users/:id', userController.delete);
    app.post('/api/auth/login', authController.login);
    app.post('/api/auth/refresh', authController.refresh);

    // Error handling
    app.use(notFoundHandler);
    app.use(errorHandler);

    // Start server
    const port = config.service.port;
    app.listen(port, () => {
        console.log(`User service listening on port ${port}`);
    });
}

bootstrap().catch(console.error);
```

```typescript
// src/controllers/user.controller.ts
export class UserController {
    constructor(
        private db: Database,
        private cache: Redis
    ) {}

    async create(req: Request, res: Response, next: NextFunction) {
        try {
            const { name, email, password } = req.body;

            const existingUser = await this.db.users.findByEmail(email);
            if (existingUser) {
                throw new ConflictError('User already exists');
            }

            const hashedPassword = await bcrypt.hash(password, 12);
            const user = await this.db.users.create({
                name,
                email,
                passwordHash: hashedPassword
            });

            res.status(201).json({
                id: user.id,
                name: user.name,
                email: user.email,
                createdAt: user.createdAt
            });
        } catch (error) {
            next(error);
        }
    }

    async getById(req: Request, res: Response, next: NextFunction) {
        try {
            const { id } = req.params;

            // Check cache first
            const cached = await this.cache.get(`user:${id}`);
            if (cached) {
                return res.json(JSON.parse(cached));
            }

            const user = await this.db.users.findById(id);
            if (!user) {
                throw new NotFoundError('User not found');
            }

            // Cache for 5 minutes
            await this.cache.setex(`user:${id}`, 300, JSON.stringify(user));

            res.json({
                id: user.id,
                name: user.name,
                email: user.email,
                profile: user.profile,
                createdAt: user.createdAt
            });
        } catch (error) {
            next(error);
        }
    }
}
```

### Ví dụ 2: Order Service với Event Publishing

```typescript
// src/services/order.service.ts
export class OrderService {
    constructor(
        private db: Database,
        private eventBus: EventBus,
        private inventoryClient: InventoryServiceClient,
        private paymentClient: PaymentServiceClient
    ) {}

    async createOrder(userId: string, items: OrderItem[]): Promise<Order> {
        // Validate user exists
        const user = await this.userClient.getUser(userId);
        if (!user) {
            throw new ValidationError('User not found');
        }

        // Check inventory availability
        const inventoryCheck = await this.inventoryClient.checkAvailability(items);
        if (!inventoryCheck.available) {
            throw new ValidationError('Items not available');
        }

        // Create order
        const order = await this.db.transaction(async (tx) => {
            const newOrder = await tx.orders.create({
                userId,
                status: 'pending',
                items,
                total: inventoryCheck.total
            });

            // Reserve inventory
            await this.inventoryClient.reserveItems(order.id, items);

            return newOrder;
        });

        // Publish event
        await this.eventBus.publish('order.created', {
            orderId: order.id,
            userId,
            items,
            total: order.total,
            timestamp: new Date().toISOString()
        });

        return order;
    }

    async processPayment(orderId: string, paymentData: PaymentData): Promise<Order> {
        const order = await this.db.orders.findById(orderId);
        if (!order) {
            throw new NotFoundError('Order not found');
        }

        if (order.status !== 'pending') {
            throw new ValidationError('Order cannot be paid');
        }

        // Process payment
        const payment = await this.paymentClient.charge({
            orderId,
            amount: order.total,
            ...paymentData
        });

        // Update order
        order.status = 'paid';
        order.paymentId = payment.id;
        await order.save();

        // Publish event
        await this.eventBus.publish('order.paid', {
            orderId,
            paymentId: payment.id,
            timestamp: new Date().toISOString()
        });

        return order;
    }
}
```

### Ví dụ 3: Notification Service với Async Processing

```typescript
// src/workers/notification.worker.ts
export class NotificationWorker {
    constructor(
        private queue: Queue,
        private emailService: EmailService,
        private smsService: SMSService,
        private pushService: PushService
    ) {}

    async start() {
        // Subscribe to events
        this.queue.subscribe('order.created', this.handleOrderCreated.bind(this));
        this.queue.subscribe('order.shipped', this.handleOrderShipped.bind(this));
        this.queue.subscribe('user.verification', this.handleUserVerification.bind(this));
    }

    private async handleOrderCreated(event: OrderCreatedEvent) {
        const { orderId, userId, total } = event;

        const user = await this.userClient.getUser(userId);

        await this.emailService.send({
            to: user.email,
            template: 'order-confirmation',
            data: {
                orderId,
                total,
                items: event.items
            }
        });

        await this.pushService.send(user.pushToken, {
            title: 'Order Confirmed',
            body: `Your order #${orderId} has been confirmed`
        });
    }

    private async handleOrderShipped(event: OrderShippedEvent) {
        const { orderId, trackingNumber } = event;

        const order = await this.orderClient.getOrder(orderId);
        const user = await this.userClient.getUser(order.userId);

        await this.emailService.send({
            to: user.email,
            template: 'order-shipped',
            data: {
                orderId,
                trackingNumber,
                carrier: event.carrier
            }
        });

        await this.smsService.send(user.phone, {
            message: `Your order #${orderId} has been shipped! Track: ${trackingNumber}`
        });
    }

    private async handleUserVerification(event: UserVerificationEvent) {
        const { userId, verificationCode } = event;

        const user = await this.userClient.getUser(userId);

        await this.emailService.send({
            to: user.email,
            template: 'email-verification',
            data: { verificationCode }
        });
    }
}
