**5. Security Scanning in CI/CD**

```yaml
# .github/workflows/docker.yml
name: Docker Build and Scan

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build-and-scan:
    runs-on: ubuntu-latest
    
    steps:
      - uses: actions/checkout@v4
      
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      
      - name: Build Docker image
        uses: docker/build-push-action@v5
        with:
          context: .
          push: false
          load: true
          tags: app:${{ github.sha }}
      
      - name: Run Trivy vulnerability scanner
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: 'app:${{ github.sha }}'
          format: 'sarif'
          output: 'trivy-results.sarif'
          severity: 'CRITICAL,HIGH'
      
      - name: Upload Trivy results to GitHub Security
        uses: github/codeql-action/upload-sarif@v2
        with:
          sarif_file: 'trivy-results.sarif'
      
      - name: Scan for secrets
        uses: trufflesecurity/trufflehog@main
        with:
          path: ./
          base: ${{ github.event.repository.default_branch }}
      
      - name: Docker Scout
        uses: docker/scout-action@v1
        with:
          command: cves
          image: app:${{ github.sha }}
          only-fixed: true
          exit-code: '1'
```

**6. Resource Limits in Kubernetes**

```yaml
# kubernetes/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: api-service
spec:
  replicas: 3
  selector:
    matchLabels:
      app: api
  template:
    metadata:
      labels:
        app: api
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1001
        fsGroup: 1001
      containers:
        - name: api
          image: api-service:latest
          ports:
            - containerPort: 3000
          resources:
            requests:
              memory: "256Mi"
              cpu: "100m"
            limits:
              memory: "512Mi"
              cpu: "500m"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          livenessProbe:
            httpGet:
              path: /health
              port: 3000
            initialDelaySeconds: 10
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /ready
              port: 3000
            initialDelaySeconds: 5
            periodSeconds: 5
            failureThreshold: 3
          env:
            - name: NODE_ENV
              value: "production"
            - name: PORT
              value: "3000"
```

**7. Docker Registry Configuration**

```yaml
# docker-compose.yml - Registry
services:
  registry:
    image: registry:2
    ports:
      - "5000:5000"
    environment:
      REGISTRY_AUTH: htpasswd
      REGISTRY_AUTH_HTPASSWD_REALM: Registry
      REGISTRY_AUTH_HTPASSWD_PATH: /auth/htpasswd
    volumes:
      - registry_data:/var/lib/registry
      - ./auth:/auth

  registry-ui:
    image: joxit/docker-registry-ui:latest
    ports:
      - "8080:80"
    environment:
      REGISTRY_URL: http://registry:5000
    depends_on:
      - registry

volumes:
  registry_data:
```

```bash
# Generate htpasswd credentials
docker run --rm \
  -v $(pwd)/auth:/auth \
  alpine sh -c "apk add --no-cache apache2-utils && htpasswd -Bc /auth/htpasswd admin"

# Push to registry
docker login registry.example.com
docker tag app:latest registry.example.com/app:v1.0.0
docker push registry.example.com/app:v1.0.0
```

## Workflow

**Phase 1: Dockerfile Creation**

Create optimized Dockerfile. Use multi-stage builds. Add security best practices. Configure health checks.

**Phase 2: Docker Compose Setup**

Create development environment. Configure services. Set up networking. Add dependencies.

**Phase 3: Security Hardening**

Add security scanning. Configure secrets. Set resource limits. Enable audit logging.

**Phase 4: CI/CD Integration**

Set up build pipeline. Add security scanning. Configure registry. Set up deployments.

**Phase 5: Monitoring**

Configure logging driver. Set up metrics. Add health checks. Monitor resource usage.

