## Ví dụ

### Ví dụ 1: GitLab CI Pipeline

```yaml
# .gitlab-ci.yml
stages:
  - lint
  - test
  - build
  - deploy

variables:
  DOCKER_DRIVER: overlay2

lint:
  stage: lint
  image: node:18-alpine
  script:
    - npm ci
    - npm run lint
    - npm run type-check

unit-test:
  stage: test
  image: node:18-alpine
  services:
    - postgres:15-alpine
  script:
    - npm ci
    - npm run test:unit -- --coverage
  coverage: '/All files[^|]*\|[^|]*\s+([\d\.]+)/'
  artifacts:
    reports:
      junit: junit.xml
      coverage_report: cobertura:coverage/cobertura-coverage.xml

build:
  stage: build
  image: docker:latest
  services:
    - docker:dind
  script:
    - docker build -t $CI_REGISTRY_IMAGE:$CI_COMMIT_SHA .
    - docker push $CI_REGISTRY_IMAGE:$CI_COMMIT_SHA
  only:
    - main

deploy-staging:
  stage: deploy
  image: bitnami/kubectl:latest
  script:
    - kubectl apply -f k8s/staging/
    - kubectl rollout status deployment/api -n staging
  environment:
    name: staging
    url: https://staging.example.com
  only:
    - main

deploy-production:
  stage: deploy
  image: bitnami/kubectl:latest
  script:
    - kubectl apply -f k8s/production/
    - kubectl rollout status deployment/api -n production
  environment:
    name: production
    url: https://example.com
  when: manual
  only:
    - main
```

### Ví dụ 2: Azure DevOps Pipeline

```yaml
# azure-pipelines.yml
trigger:
  - main
  - develop

pr:
  - main

variables:
  nodeVersion: '18.x'
  dockerRegistryServiceConnection: 'docker-registry'
  imageRepository: 'api'
  dockerfilePath: '$(Build.SourcesDirectory)/Dockerfile'
  tag: '$(Build.BuildId)'

stages:
  - stage: Build
    displayName: Build and Test
    jobs:
      - job: Build
        displayName: Build
        pool:
          vmImage: 'ubuntu-latest'
        steps:
          - task: NodeTool@0
            inputs:
              versionSpec: $(nodeVersion)
            displayName: 'Install Node.js'

          - script: |
              npm ci
              npm run lint
              npm run type-check
            displayName: 'Lint and Type Check'

          - script: |
              npm test -- --coverage --ci
            displayName: 'Run Tests'
            env:
              DATABASE_URL: $(DATABASE_URL)

          - task: PublishCodeCoverageResults@1
            inputs:
              codeCoverageTool: 'Cobertura'
              summaryFileLocation: '$(System.DefaultWorkingDirectory)/coverage/cobertura-coverage.xml'

          - task: Docker@2
            displayName: 'Build and push'
            inputs:
              command: buildAndPush
              repository: $(imageRepository)
              dockerfile: $(dockerfilePath)
              containerRegistry: $(dockerRegistryServiceConnection)
              tags: |
                $(tag)
                latest

  - stage: DeployStaging
    displayName: Deploy to Staging
    jobs:
      - deployment: DeployStaging
        environment: 'staging'
        pool:
          vmImage: 'ubuntu-latest'
        strategy:
          runOnce:
            deploy:
              steps:
                - task: KubernetesManifest@0
                  inputs:
                    action: deploy
                    namespace: staging
                    manifests: |
                      $(Pipeline.Workspace)/manifests/staging/*.yaml

  - stage: DeployProduction
    displayName: Deploy to Production
    dependsOn: DeployStaging
    condition: succeeded()
    jobs:
      - deployment: DeployProduction
        environment: 'production'
        pool:
          vmImage: 'ubuntu-latest'
        strategy:
          canary:
            increment: 10
            gates:
              - successRate:
                  percentage: 95
```

### Ví dụ 3: Jenkins Pipeline

```groovy
// Jenkinsfile
pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 1, unit: 'HOURS')
        disableConcurrentBuilds()
    }

    environment {
        NODE_VERSION = '18'
        REGISTRY = 'ghcr.io'
        IMAGE_NAME = 'example/api'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Lint & Type Check') {
            steps {
                sh 'npm ci'
                sh 'npm run lint'
                sh 'npm run type-check'
            }
        }

        stage('Test') {
            steps {
                parallel(
                    "Unit Tests": {
                        sh 'npm run test:unit -- --coverage'
                    },
                    "Integration Tests": {
                        sh 'npm run test:integration'
                    }
                )
            }
            post {
                always {
                    junit 'junit.xml'
                    cobertura coberturaReportFile: 'coverage/cobertura-coverage.xml'
                }
            }
        }

        stage('Build Docker') {
            when {
                branch 'main'
            }
            steps {
                script {
                    def imageTag = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = imageTag

                    sh """
                        docker build -t ${REGISTRY}/${IMAGE_NAME}:${imageTag} .
                        docker push ${REGISTRY}/${IMAGE_NAME}:${imageTag}
                    """
                }
            }
        }

        stage('Deploy to Staging') {
            when {
                branch 'main'
            }
            steps {
                sh """
                    kubectl config use-context staging
                    kubectl set image deployment/api api=${REGISTRY}/${IMAGE_NAME}:${env.IMAGE_TAG}
                    kubectl rollout status deployment/api -n staging
                """
            }
        }

        stage('Deploy to Production') {
            when {
                branch 'main'
            }
            steps {
                input message: 'Deploy to production?', ok: 'Deploy'
                sh """
                    kubectl config use-context production
                    kubectl set image deployment/api api=${REGISTRY}/${IMAGE_NAME}:${env.IMAGE_TAG}
                    kubectl rollout status deployment/api -n production
                """
            }
        }
    }

    post {
        failure {
            slackSend channel: '#deployments',
                     message: "Pipeline failed: ${env.JOB_NAME} [${env.BUILD_NUMBER}]"
        }
        success {
            slackSend channel: '#deployments',
                     message: "Pipeline succeeded: ${env.JOB_NAME} [${env.BUILD_NUMBER}]"
        }
    }
}
```

