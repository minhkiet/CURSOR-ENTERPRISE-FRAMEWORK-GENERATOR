### 2. Event Structure

Design event structure consistently.

```typescript
// Base event interface
interface DomainEvent {
    id: string;                    // Unique event ID (UUID)
    eventType: string;            // Event type name
    aggregateId: string;           // ID của aggregate gốc
    aggregateType: string;         // Type của aggregate
    version: number;               // Aggregate version tại thời điểm event
    timestamp: Date;               // Khi event được tạo
    metadata: EventMetadata;       // Context information
    payload: any;                 // Event-specific data
}

interface EventMetadata {
    correlationId?: string;       // For tracing
    causationId?: string;         // What caused this event
    userId?: string;              // Who triggered this
    ipAddress?: string;
    userAgent?: string;
    schemaVersion: string;         // For schema evolution
}

// Event type definitions
type OrderEvent =
    | OrderCreatedEvent
    | OrderItemAddedEvent
    | OrderItemRemovedEvent
    | OrderConfirmedEvent
    | OrderShippedEvent
    | OrderDeliveredEvent
    | OrderCancelledEvent;

interface OrderCreatedEvent extends DomainEvent {
    eventType: 'ORDER_CREATED';
    payload: {
        orderId: string;
        customerId: string;
        shippingAddress: Address;
        items: OrderItem[];
        totalAmount: Money;
    };
}

interface OrderItemAddedEvent extends DomainEvent {
    eventType: 'ORDER_ITEM_ADDED';
    payload: {
        orderId: string;
        productId: string;
        productName: string;
        quantity: number;
        unitPrice: Money;
        totalPrice: Money;
    };
}

interface OrderConfirmedEvent extends DomainEvent {
    eventType: 'ORDER_CONFIRMED';
    payload: {
        orderId: string;
        paymentId: string;
        confirmedAt: Date;
    };
}
```

### 3. Aggregate Implementation

Implement aggregate với event sourcing.

```typescript
// Aggregate base class
abstract class AggregateRoot<TEvent extends DomainEvent> {
    protected id: string;
    protected version: number = 0;
    private uncommittedEvents: TEvent[] = [];

    abstract aggregateType: string;

    getId(): string {
        return this.id;
    }

    getVersion(): number {
        return this.version;
    }

    getUncommittedEvents(): TEvent[] {
        return [...this.uncommittedEvents];
    }

    markEventsAsCommitted(): void {
        this.uncommittedEvents = [];
    }

    protected addEvent(event: TEvent): void {
        this.validateEvent(event);
        this.applyEvent(event);
        this.uncommittedEvents.push(event);
    }

    protected abstract applyEvent(event: TEvent): void;

    protected abstract validateEvent(event: TEvent): void;

    protected incrementVersion(): void {
        this.version++;
    }

    // Reconstruct from events
    static fromEvents<T extends AggregateRoot<any>>(
        this: new (id: string) => T,
        id: string,
        events: DomainEvent[]
    ): T {
        const aggregate = new this(id);
        for (const event of events) {
            aggregate.applyEvent(event);
        }
        aggregate.version = events.length;
        return aggregate;
    }
}

// Order aggregate implementation
class OrderAggregate extends AggregateRoot<OrderEvent> {
    aggregateType = 'Order';

    private status: OrderStatus = 'DRAFT';
    private items: OrderItem[] = [];
    private customerId: string | null = null;
    private shippingAddress: Address | null = null;
    private totalAmount: Money = { amount: 0, currency: 'USD' };

    constructor(id: string) {
        super();
        this.id = id;
    }

    createOrder(customerId: string, shippingAddress: Address): void {
        if (this.status !== 'DRAFT') {
            throw new InvalidOperationError('Order already created');
        }

        const event: OrderCreatedEvent = {
            id: generateUUID(),
            eventType: 'ORDER_CREATED',
            aggregateId: this.id,
            aggregateType: this.aggregateType,
            version: this.version + 1,
            timestamp: new Date(),
            metadata: {},
            payload: {
                orderId: this.id,
                customerId,
                shippingAddress,
                items: [],
                totalAmount: { amount: 0, currency: 'USD' }
            }
        };

        this.addEvent(event);
    }

    addItem(product: Product, quantity: number): void {
        if (this.status !== 'DRAFT') {
            throw new InvalidOperationError('Cannot modify confirmed order');
        }

        const existingItem = this.items.find(i => i.productId === product.id);
        const quantityToAdd = existingItem ? existingItem.quantity + quantity : quantity;
        const totalPrice = product.unitPrice.multiply(quantityToAdd);

        const event: OrderItemAddedEvent = {
            id: generateUUID(),
            eventType: 'ORDER_ITEM_ADDED',
            aggregateId: this.id,
            aggregateType: this.aggregateType,
            version: this.version + 1,
            timestamp: new Date(),
            metadata: {},
            payload: {
                orderId: this.id,
                productId: product.id,
                productName: product.name,
                quantity: quantityToAdd,
                unitPrice: product.unitPrice,
                totalPrice
            }
        };

        this.addEvent(event);
    }

    confirm(paymentId: string): void {
        if (this.status !== 'DRAFT') {
            throw new InvalidOperationError('Order is not in draft status');
        }

        if (this.items.length === 0) {
            throw new InvalidOperationError('Cannot confirm empty order');
        }

        const event: OrderConfirmedEvent = {
            id: generateUUID(),
            eventType: 'ORDER_CONFIRMED',
            aggregateId: this.id,
            aggregateType: this.aggregateType,
            version: this.version + 1,
            timestamp: new Date(),
            metadata: {},
            payload: {
                orderId: this.id,
                paymentId,
                confirmedAt: new Date()
            }
        };

        this.addEvent(event);
    }

    protected applyEvent(event: OrderEvent): void {
        this.incrementVersion();

        switch (event.eventType) {
            case 'ORDER_CREATED':
                this.status = 'DRAFT';
                this.customerId = event.payload.customerId;
                this.shippingAddress = event.payload.shippingAddress;
                break;

            case 'ORDER_ITEM_ADDED':
                const existingIndex = this.items.findIndex(
                    i => i.productId === event.payload.productId
                );
                if (existingIndex >= 0) {
                    this.items[existingIndex] = {
                        ...this.items[existingIndex],
                        quantity: event.payload.quantity,
                        totalPrice: event.payload.totalPrice
                    };
                } else {
                    this.items.push({
                        productId: event.payload.productId,
                        productName: event.payload.productName,
                        quantity: event.payload.quantity,
                        unitPrice: event.payload.unitPrice,
                        totalPrice: event.payload.totalPrice
                    });
                }
                this.totalAmount = this.totalAmount.add(event.payload.totalPrice);
                break;

            case 'ORDER_CONFIRMED':
                this.status = 'CONFIRMED';
                break;
        }
    }

    protected validateEvent(event: OrderEvent): void {
        switch (event.eventType) {
            case 'ORDER_ITEM_ADDED':
                if (event.payload.quantity <= 0) {
                    throw new ValidationError('Quantity must be positive');
                }
                break;
        }
    }
}
```

### 4. Event Store Implementation

Implement event store persistence.

```typescript
// Event store interface
interface EventStore {
    save<TEvent extends DomainEvent>(events: TEvent[]): Promise<void>;
    getById(aggregateId: string, fromVersion?: number): Promise<DomainEvent[]>;
    getAll(eventTypes?: string[], fromTimestamp?: Date): Promise<DomainEvent[]>;
    getByCorrelationId(correlationId: string): Promise<DomainEvent[]>;
}

// PostgreSQL implementation
class PostgresEventStore implements EventStore {
    constructor(private pool: Pool) {}

    async save<TEvent extends DomainEvent>(events: TEvent[]): Promise<void> {
        const client = await this.pool.connect();

        try {
            await client.query('BEGIN');

            for (const event of events) {
                await client.query(
                    `INSERT INTO events (
                        id, event_type, aggregate_id, aggregate_type,
                        version, timestamp, metadata, payload
                    ) VALUES ($1, $2, $3, $4, $5, $6, $7, $8)`,
                    [
                        event.id,
                        event.eventType,
                        event.aggregateId,
                        event.aggregateType,
                        event.version,
                        event.timestamp,
                        JSON.stringify(event.metadata),
                        JSON.stringify(event.payload)
                    ]
                );
            }

            await client.query('COMMIT');
        } catch (error) {
            await client.query('ROLLBACK');
            throw error;
        } finally {
            client.release();
        }
    }

    async getById(aggregateId: string, fromVersion: number = 0): Promise<DomainEvent[]> {
        const result = await this.pool.query(
            `SELECT * FROM events
             WHERE aggregate_id = $1 AND version > $2
             ORDER BY version ASC`,
            [aggregateId, fromVersion]
        );

        return result.rows.map(this.mapRowToEvent);
    }

    async getAll(
        eventTypes?: string[],
        fromTimestamp?: Date
    ): Promise<DomainEvent[]> {
        let query = 'SELECT * FROM events WHERE 1=1';
        const params: any[] = [];
        let paramIndex = 1;

        if (eventTypes && eventTypes.length > 0) {
            query += ` AND event_type = ANY($${paramIndex})`;
            params.push(eventTypes);
            paramIndex++;
        }

        if (fromTimestamp) {
            query += ` AND timestamp >= $${paramIndex}`;
            params.push(fromTimestamp);
        }

        query += ' ORDER BY timestamp ASC';

        const result = await this.pool.query(query, params);
        return result.rows.map(this.mapRowToEvent);
    }

    async getByCorrelationId(correlationId: string): Promise<DomainEvent[]> {
        const result = await this.pool.query(
            `SELECT * FROM events
             WHERE metadata->>'correlationId' = $1
             ORDER BY timestamp ASC`,
            [correlationId]
        );

        return result.rows.map(this.mapRowToEvent);
    }

    private mapRowToEvent(row: any): DomainEvent {
        return {
            id: row.id,
            eventType: row.event_type,
            aggregateId: row.aggregate_id,
            aggregateType: row.aggregate_type,
            version: row.version,
            timestamp: row.timestamp,
            metadata: JSON.parse(row.metadata),
            payload: JSON.parse(row.payload)
        };
    }
}

// MongoDB implementation
class MongoEventStore implements EventStore {
    constructor(private collection: Collection) {}

    async save<TEvent extends DomainEvent>(events: TEvent[]): Promise<void> {
        const documents = events.map(event => ({
            ...event,
            _id: event.id,
            timestamp: new Date(event.timestamp)
        }));

        await this.collection.insertMany(documents, { ordered: false });
    }

    async getById(aggregateId: string, fromVersion: number = 0): Promise<DomainEvent[]> {
        const events = await this.collection
            .find({
                aggregateId,
                version: { $gt: fromVersion }
            })
            .sort({ version: 1 })
            .toArray();

        return events;
    }
}
```

### 5. Projections

Build read models từ events.

```typescript
// Projection interface
interface Projection<T> {
    name: string;
    handles: (event: DomainEvent) => Promise<void>;
    getState(): T;
}

// Order projection - builds order read model
class OrderProjection implements Projection<OrderReadModel> {
    name = 'OrderProjection';

    private orders: Map<string, OrderReadModel> = new Map();

    async handles(event: DomainEvent): Promise<void> {
        switch (event.eventType) {
            case 'ORDER_CREATED':
                await this.onOrderCreated(event as OrderCreatedEvent);
                break;
            case 'ORDER_ITEM_ADDED':
                await this.onItemAdded(event as OrderItemAddedEvent);
                break;
            case 'ORDER_CONFIRMED':
                await this.onOrderConfirmed(event as OrderConfirmedEvent);
                break;
            case 'ORDER_SHIPPED':
                await this.onOrderShipped(event as OrderShippedEvent);
                break;
            case 'ORDER_DELIVERED':
                await this.onOrderDelivered(event as OrderDeliveredEvent);
                break;
            case 'ORDER_CANCELLED':
                await this.onOrderCancelled(event as OrderCancelledEvent);
                break;
        }
    }

    private async onOrderCreated(event: OrderCreatedEvent): Promise<void> {
        const order: OrderReadModel = {
            id: event.payload.orderId,
            customerId: event.payload.customerId,
            shippingAddress: event.payload.shippingAddress,
            items: [],
            status: 'DRAFT',
            totalAmount: { amount: 0, currency: 'USD' },
            createdAt: event.timestamp,
            updatedAt: event.timestamp,
            version: event.version
        };

        this.orders.set(order.id, order);
    }

    private async onItemAdded(event: OrderItemAddedEvent): Promise<void> {
        const order = this.orders.get(event.aggregateId);
        if (!order) return;

        const existingIndex = order.items.findIndex(
            i => i.productId === event.payload.productId
        );

        if (existingIndex >= 0) {
            order.items[existingIndex] = {
                productId: event.payload.productId,
                productName: event.payload.productName,
                quantity: event.payload.quantity,
                unitPrice: event.payload.unitPrice,
                totalPrice: event.payload.totalPrice
            };
        } else {
            order.items.push({
                productId: event.payload.productId,
                productName: event.payload.productName,
                quantity: event.payload.quantity,
                unitPrice: event.payload.unitPrice,
                totalPrice: event.payload.totalPrice
            });
        }

        order.totalAmount = order.totalAmount.add(event.payload.totalPrice);
        order.updatedAt = event.timestamp;
        order.version = event.version;
    }

    private async onOrderConfirmed(event: OrderConfirmedEvent): Promise<void> {
        const order = this.orders.get(event.aggregateId);
        if (!order) return;

        order.status = 'CONFIRMED';
        order.confirmedAt = event.payload.confirmedAt;
        order.updatedAt = event.timestamp;
        order.version = event.version;
    }

    getState(): Map<string, OrderReadModel> {
        return this.orders;
    }

    getOrder(id: string): OrderReadModel | undefined {
        return this.orders.get(id);
    }
}

// Projection runner
class ProjectionRunner {
    private projections: Map<string, Projection<any>> = new Map();
    private eventStore: EventStore;

    constructor(eventStore: EventStore) {
        this.eventStore = eventStore;
    }

    register<T>(projection: Projection<T>): void {
        this.projections.set(projection.name, projection);
    }

    async run(projectionName?: string): Promise<void> {
        const projectionsToRun = projectionName
            ? [this.projections.get(projectionName)]
            : Array.from(this.projections.values());

        for (const projection of projectionsToRun) {
            if (!projection) continue;

            // Get last processed event
            const lastEvent = await this.getLastProcessedEvent(projection.name);

            // Get new events
            const newEvents = await this.eventStore.getAll(
                undefined,
                lastEvent?.timestamp
            );

            // Process events
            for (const event of newEvents) {
                await projection.handles(event);
                await this.markEventProcessed(projection.name, event);
            }
        }
    }

    private async getLastProcessedEvent(projectionName: string): Promise<DomainEvent | null> {
        // Implementation
        return null;
    }

    private async markEventProcessed(projectionName: string, event: DomainEvent): Promise<void> {
        // Implementation
    }
}
