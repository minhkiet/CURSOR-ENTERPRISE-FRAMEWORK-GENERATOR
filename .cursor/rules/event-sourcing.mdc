## Ví dụ

### Ví dụ 1: Complete Order Aggregate

```typescript
// Full implementation
class OrderAggregate extends AggregateRoot<OrderEvent> {
    aggregateType = 'Order';

    private status: OrderStatus = 'DRAFT';
    private items: OrderItem[] = [];
    private customerId: string | null = null;
    private shippingAddress: Address | null = null;
    private billingAddress: Address | null = null;
    private paymentId: string | null = null;
    private totalAmount: Money = { amount: 0, currency: 'USD' };

    // Factory method
    static create(
        customerId: string,
        shippingAddress: Address,
        billingAddress: Address
    ): OrderAggregate {
        const order = new OrderAggregate(generateUUID());
        order.createOrder(customerId, shippingAddress, billingAddress);
        return order;
    }

    createOrder(
        customerId: string,
        shippingAddress: Address,
        billingAddress: Address
    ): void {
        this.addEvent({
            id: generateUUID(),
            eventType: 'ORDER_CREATED',
            aggregateId: this.id,
            aggregateType: this.aggregateType,
            version: this.version + 1,
            timestamp: new Date(),
            metadata: {},
            payload: {
                orderId: this.id,
                customerId,
                shippingAddress,
                billingAddress
            }
        } as OrderCreatedEvent);
    }

    addItem(product: Product, quantity: number): void {
        this.ensureCanModify();

        const event: OrderItemAddedEvent = {
            id: generateUUID(),
            eventType: 'ORDER_ITEM_ADDED',
            aggregateId: this.id,
            aggregateType: this.aggregateType,
            version: this.version + 1,
            timestamp: new Date(),
            metadata: {},
            payload: {
                orderId: this.id,
                productId: product.id,
                productName: product.name,
                quantity,
                unitPrice: product.price,
                totalPrice: product.price.multiply(quantity)
            }
        };

        this.addEvent(event);
    }

    confirm(paymentId: string): void {
        if (this.status !== 'DRAFT') {
            throw new InvalidOperationError('Order must be in DRAFT status');
        }
        if (this.items.length === 0) {
            throw new InvalidOperationError('Cannot confirm empty order');
        }

        this.addEvent({
            id: generateUUID(),
            eventType: 'ORDER_CONFIRMED',
            aggregateId: this.id,
            aggregateType: this.aggregateType,
            version: this.version + 1,
            timestamp: new Date(),
            metadata: {},
            payload: { orderId: this.id, paymentId, confirmedAt: new Date() }
        } as OrderConfirmedEvent);
    }

    protected applyEvent(event: OrderEvent): void {
        this.incrementVersion();

        switch (event.eventType) {
            case 'ORDER_CREATED':
                this.status = 'DRAFT';
                this.customerId = event.payload.customerId;
                this.shippingAddress = event.payload.shippingAddress;
                this.billingAddress = event.payload.billingAddress;
                break;

            case 'ORDER_ITEM_ADDED':
                const existing = this.items.find(
                    i => i.productId === event.payload.productId
                );
                if (existing) {
                    existing.quantity = event.payload.quantity;
                    existing.totalPrice = event.payload.totalPrice;
                } else {
                    this.items.push({
                        productId: event.payload.productId,
                        productName: event.payload.productName,
                        quantity: event.payload.quantity,
                        unitPrice: event.payload.unitPrice,
                        totalPrice: event.payload.totalPrice
                    });
                }
                this.totalAmount = this.totalAmount.add(event.payload.totalPrice);
                break;

            case 'ORDER_CONFIRMED':
                this.status = 'CONFIRMED';
                this.paymentId = event.payload.paymentId;
                break;
        }
    }

    protected validateEvent(event: OrderEvent): void {
        switch (event.eventType) {
            case 'ORDER_ITEM_ADDED':
                if (event.payload.quantity <= 0) {
                    throw new ValidationError('Quantity must be positive');
                }
                break;
        }
    }

    private ensureCanModify(): void {
        if (this.status !== 'DRAFT') {
            throw new InvalidOperationError(
                `Cannot modify order in ${this.status} status`
            );
        }
    }

    // Getters for read model
    getStatus() { return this.status; }
    getItems() { return [...this.items]; }
    getTotalAmount() { return this.totalAmount; }
    getCustomerId() { return this.customerId; }
}
```

### Ví dụ 2: Projection Implementation

```typescript
// Read model
interface OrderReadModel {
    id: string;
    customerId: string;
    status: OrderStatus;
    items: OrderItem[];
    totalAmount: Money;
    shippingAddress: Address;
    createdAt: Date;
    confirmedAt?: Date;
    shippedAt?: Date;
    deliveredAt?: Date;
}

// Projection with database persistence
class OrderProjection implements Projection<OrderReadModel> {
    name = 'OrderProjection';
    private db: Database;

    constructor(db: Database) {
        this.db = db;
    }

    async handles(event: DomainEvent): Promise<void> {
        switch (event.eventType) {
            case 'ORDER_CREATED':
                await this.onOrderCreated(event as OrderCreatedEvent);
                break;
            case 'ORDER_ITEM_ADDED':
                await this.onItemAdded(event as OrderItemAddedEvent);
                break;
            case 'ORDER_CONFIRMED':
                await this.onOrderConfirmed(event as OrderConfirmedEvent);
                break;
            // ... other events
        }
    }

    private async onOrderCreated(event: OrderCreatedEvent): Promise<void> {
        await this.db.orderReadModels.upsert({
            id: event.payload.orderId,
            customerId: event.payload.customerId,
            status: 'DRAFT',
            items: [],
            totalAmount: { amount: 0, currency: 'USD' },
            shippingAddress: event.payload.shippingAddress,
            createdAt: event.timestamp
        });
    }

    private async onItemAdded(event: OrderItemAddedEvent): Promise<void> {
        await this.db.orderReadModels.update(event.aggregateId, {
            items: this.db.raw('array_append(items, ?)', [event.payload]),
            totalAmount: event.payload.totalPrice // Accumulate in application
        });
    }

    async getState(): Promise<OrderReadModel[]> {
        return this.db.orderReadModels.findAll();
    }
}
```

