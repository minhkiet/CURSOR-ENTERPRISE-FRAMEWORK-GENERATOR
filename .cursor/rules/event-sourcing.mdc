        const events = order.getUncommittedEvents();

        expect(events).toHaveLength(1);
        expect(events[0].eventType).toBe('ORDER_ITEM_ADDED');
        expect(events[0].payload.quantity).toBe(2);
        expect(events[0].payload.totalPrice.amount).toBe(50);
    });

    it('should reject adding items to confirmed order', () => {
        const order = createConfirmedOrder();

        expect(() => {
            order.addItem(testProduct('SKU-003', 30), 1);
        }).toThrow(InvalidOperationError);
    });

    it('should correctly reconstruct from events', () => {
        const orderId = generateUUID();
        const events: OrderEvent[] = [
            createOrderCreatedEvent(orderId),
            createOrderItemAddedEvent(orderId, 'SKU-001', 2, 100),
            createOrderItemAddedEvent(orderId, 'SKU-002', 1, 50),
            createOrderConfirmedEvent(orderId)
        ];

        const order = OrderAggregate.fromEvents(orderId, events);

        expect(order.status).toBe('CONFIRMED');
        expect(order.items).toHaveLength(2);
        expect(order.totalAmount.amount).toBe(250);
        expect(order.getVersion()).toBe(4);
    });
});

