### 2. Optimistic Concurrency

```typescript
// Conflict detection
interface ConcurrencyConflict {
    expectedVersion: number;
    actualVersion: number;
    aggregateId: string;
}

// Repository with concurrency check
class ConcurrencyAwareRepository {
    async save(aggregate: AggregateRoot<any>): Promise<void> {
        const events = aggregate.getUncommittedEvents();

        try {
            await this.eventStore.saveWithConcurrencyCheck(
                aggregate.getId(),
                aggregate.getVersion() - events.length,
                events
            );
        } catch (error) {
            if (error.code === 'OPTIMISTIC_CONCURRENCY') {
                throw new ConcurrencyConflictError(
                    aggregate.getId(),
                    aggregate.getVersion() - events.length,
                    aggregate.getVersion()
                );
            }
            throw error;
        }
    }
}
```

### 3. Idempotency

```typescript
// Idempotent event processing
class IdempotentProjection {
    private processedEvents: Set<string> = new Set();

    async handle(event: DomainEvent): Promise<void> {
        // Check if already processed
        if (this.processedEvents.has(event.id)) {
            return; // Skip
        }

        // Process event
        await this.doHandle(event);

        // Mark as processed
        this.processedEvents.add(event.id);
    }
}
```

