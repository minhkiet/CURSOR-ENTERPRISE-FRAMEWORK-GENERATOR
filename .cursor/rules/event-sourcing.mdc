### 6. Snapshots

Optimize aggregate loading với snapshots.

```typescript
// Snapshot strategy
interface SnapshotStrategy {
    shouldSnapshot(aggregate: AggregateRoot<any>): boolean;
    getSnapshotInterval(): number;
}

// Time-based snapshot
class TimeBasedSnapshotStrategy implements SnapshotStrategy {
    constructor(private intervalMinutes: number = 5) {}

    shouldSnapshot(aggregate: AggregateRoot<any>): boolean {
        const lastSnapshot = aggregate.lastSnapshotAt;
        if (!lastSnapshot) return true;

        const elapsed = Date.now() - lastSnapshot.getTime();
        return elapsed > this.intervalMinutes * 60 * 1000;
    }

    getSnapshotInterval(): number {
        return this.intervalMinutes * 60;
    }
}

// Version-based snapshot
class VersionBasedSnapshotStrategy implements SnapshotStrategy {
    constructor(private interval: number = 100) {}

    shouldSnapshot(aggregate: AggregateRoot<any>): boolean {
        const eventsSinceSnapshot = aggregate.version - (aggregate.lastSnapshotVersion || 0);
        return eventsSinceSnapshot >= this.interval;
    }

    getSnapshotInterval(): number {
        return this.interval;
    }
}

// Snapshot storage
interface SnapshotStore {
    save(snapshot: AggregateSnapshot): Promise<void>;
    get(aggregateId: string): Promise<AggregateSnapshot | null>;
}

class PostgresSnapshotStore implements SnapshotStore {
    constructor(private pool: Pool) {}

    async save(snapshot: AggregateSnapshot): Promise<void> {
        await this.pool.query(
            `INSERT INTO snapshots (aggregate_id, aggregate_type, version, state, created_at)
             VALUES ($1, $2, $3, $4, $5)
             ON CONFLICT (aggregate_id)
             DO UPDATE SET version = $3, state = $4, created_at = $5`,
            [
                snapshot.aggregateId,
                snapshot.aggregateType,
                snapshot.version,
                JSON.stringify(snapshot.state),
                snapshot.createdAt
            ]
        );
    }

    async get(aggregateId: string): Promise<AggregateSnapshot | null> {
        const result = await this.pool.query(
            `SELECT * FROM snapshots WHERE aggregate_id = $1`,
            [aggregateId]
        );

        if (result.rows.length === 0) return null;

        const row = result.rows[0];
        return {
            aggregateId: row.aggregate_id,
            aggregateType: row.aggregate_type,
            version: row.version,
            state: JSON.parse(row.state),
            createdAt: row.created_at
        };
    }
}

// Aggregate with snapshot support
class SnapshotableAggregate extends AggregateRoot<any> {
    protected lastSnapshotVersion: number = 0;
    protected lastSnapshotAt: Date | null = null;
    private snapshotStrategy: SnapshotStrategy;

    constructor(id: string, strategy: SnapshotStrategy) {
        super();
        this.id = id;
        this.snapshotStrategy = strategy;
    }

    protected incrementVersion(): void {
        super.incrementVersion();
    }

    shouldSnapshot(): boolean {
        return this.snapshotStrategy.shouldSnapshot(this);
    }

    getSnapshot(): AggregateSnapshot {
        return {
            aggregateId: this.id,
            aggregateType: this.aggregateType,
            version: this.version,
            state: this.getState(),
            createdAt: new Date()
        };
    }

    protected abstract getState(): any;

    loadFromSnapshot(snapshot: AggregateSnapshot): void {
        this.applyState(snapshot.state);
        this.version = snapshot.version;
        this.lastSnapshotVersion = snapshot.version;
        this.lastSnapshotAt = snapshot.createdAt;
    }

    protected abstract applyState(state: any): void;
}
```

### 7. Event Versioning

Handle schema evolution của events.

```typescript
// Event versioning
interface EventUpcaster {
    canUpgrade(event: DomainEvent): boolean;
    upgrade(event: DomainEvent): DomainEvent;
}

// Upcaster example - v1 to v2
class OrderCreatedEventUpcaster implements EventUpcaster {
    canUpgrade(event: DomainEvent): boolean {
        return event.eventType === 'ORDER_CREATED' &&
               event.metadata.schemaVersion === '1.0';
    }

    upgrade(event: OrderCreatedEvent): OrderCreatedEvent {
        // Add new field with default value
        return {
            ...event,
            payload: {
                ...event.payload,
                channel: 'WEB', // New field with default
                source: 'UNKNOWN' // Another new field
            },
            metadata: {
                ...event.metadata,
                schemaVersion: '2.0'
            }
        };
    }
}

// Event registry with upcasters
class EventRegistry {
    private upcasters: EventUpcaster[] = [];

    register(upcaster: EventUpcaster): void {
        this.upcasters.push(upcaster);
    }

    upcast(event: DomainEvent): DomainEvent {
        let currentEvent = event;

        for (const upcaster of this.upcasters) {
            if (upcaster.canUpgrade(currentEvent)) {
                currentEvent = upcaster.upgrade(currentEvent);
            }
        }

        return currentEvent;
    }

    upcastStream(events: DomainEvent[]): DomainEvent[] {
        return events.map(event => this.upcast(event));
    }
}

// Schema evolution patterns
const evolutionPatterns = {
    // Adding fields - use defaults
    addField: (event: any, field: string, defaultValue: any) => ({
        ...event,
        payload: { ...event.payload, [field]: defaultValue }
    }),

    // Renaming fields
    renameField: (event: any, oldName: string, newName: string) => ({
        ...event,
        payload: {
            ...Object.fromEntries(
                Object.entries(event.payload).map(([key, value]) =>
                    key === oldName ? [newName, value] : [key, value]
                )
            )
        }
    }),

    // Removing fields
    removeField: (event: any, fieldToRemove: string) => {
        const { [fieldToRemove]: _, ...rest } = event.payload;
        return { ...event, payload: rest };
    },

    // Splitting fields
    splitField: (event: any, field: string, newFields: Record<string, (value: any) => any>) => {
        const oldValue = event.payload[field];
        const newValues = Object.fromEntries(
            Object.entries(newFields).map(([key, transform]) => [key, transform(oldValue)])
        );
        return {
            ...event,
            payload: {
                ...Object.fromEntries(
                    Object.entries(event.payload).filter(([key]) => key !== field)
                ),
                ...newValues
            }
        };
    }
};
```

### 8. Event Bus Integration

Integrate với message buses.

```typescript
// Event bus interface
interface EventBus {
    publish(event: DomainEvent): Promise<void>;
    publishBatch(events: DomainEvent[]): Promise<void>;
    subscribe(handler: EventHandler): Promise<void>;
}

interface EventHandler {
    canHandle(event: DomainEvent): boolean;
    handle(event: DomainEvent): Promise<void>;
}

// Kafka implementation
class KafkaEventBus implements EventBus {
    constructor(
        private producer: KafkaProducer,
        private topic: string
    ) {}

    async publish(event: DomainEvent): Promise<void> {
        await this.producer.send({
            topic: this.topic,
            messages: [{
                key: event.aggregateId,
                value: JSON.stringify(event),
                headers: {
                    eventType: event.eventType,
                    aggregateType: event.aggregateType,
                    timestamp: event.timestamp.toISOString()
                }
            }]
        });
    }

    async publishBatch(events: DomainEvent[]): Promise<void> {
        await this.producer.send({
            topic: this.topic,
            messages: events.map(event => ({
                key: event.aggregateId,
                value: JSON.stringify(event),
                headers: {
                    eventType: event.eventType,
                    aggregateType: event.aggregateType
                }
            }))
        });
    }
}

// RabbitMQ implementation
class RabbitMQEventBus implements EventBus {
    constructor(
        private channel: Channel,
        private exchange: string
    ) {}

    async publish(event: DomainEvent): Promise<void> {
        this.channel.publish(
            this.exchange,
            event.eventType,
            Buffer.from(JSON.stringify(event)),
            { persistent: true }
        );
    }

    async subscribe(handler: EventHandler): Promise<void> {
        const queue = await this.channel.assertQueue(handler.constructor.name);

        this.channel.bindQueue(queue.queue, this.exchange, '#');

        this.channel.consume(queue.queue, async (msg) => {
            if (!msg) return;

            const event = JSON.parse(msg.content.toString());

            if (handler.canHandle(event)) {
                await handler.handle(event);
            }

            this.channel.ack(msg);
        });
    }
}

// Integration with aggregate
class EventSourcedAggregateRepository<T extends AggregateRoot<any>> {
    constructor(
        private eventStore: EventStore,
        private eventBus: EventBus,
        private aggregateClass: new (id: string) => T
    ) {}

    async save(aggregate: T): Promise<void> {
        const events = aggregate.getUncommittedEvents();

        if (events.length === 0) return;

        // Persist events
        await this.eventStore.save(events);

        // Publish to bus
        await this.eventBus.publishBatch(events);

        // Mark as committed
        aggregate.markEventsAsCommitted();
    }

    async getById(id: string): Promise<T> {
        const events = await this.eventStore.getById(id);

        if (events.length === 0) {
            throw new AggregateNotFoundError(id);
        }

        return this.aggregateClass.fromEvents(id, events);
    }
}
```

### 9. CQRS Integration

Combine event sourcing với CQRS.

```typescript
// CQRS with Event Sourcing
class CQRSUnitOfWork {
    constructor(
        private eventStore: EventStore,
        private eventBus: EventBus,
        private aggregates: Map<string, AggregateRoot<any>>
    ) {}

    async add(aggregate: AggregateRoot<any>): Promise<void> {
        this.aggregates.set(aggregate.getId(), aggregate);
    }

    async commit(): Promise<void> {
        const allEvents: DomainEvent[] = [];

        for (const aggregate of this.aggregates.values()) {
            const events = aggregate.getUncommittedEvents();
            allEvents.push(...events);
        }

        if (allEvents.length === 0) return;

        // Atomic save
        await this.eventStore.save(allEvents);

        // Publish events
        await this.eventBus.publishBatch(allEvents);

        // Clear uncommitted events
        for (const aggregate of this.aggregates.values()) {
            aggregate.markEventsAsCommitted();
        }

        // Clear aggregates
        this.aggregates.clear();
    }

    async rollback(): Promise<void> {
        this.aggregates.clear();
    }
}

// Command handler
class OrderCommandHandler {
    constructor(
        private repository: EventSourcedAggregateRepository<OrderAggregate>,
        private unitOfWork: CQRSUnitOfWork
    ) {}

    async handle(command: CreateOrderCommand): Promise<string> {
        const orderId = generateUUID();
        const order = new OrderAggregate(orderId);

        order.createOrder(command.customerId, command.shippingAddress);

        for (const item of command.items) {
            order.addItem(item.product, item.quantity);
        }

        this.unitOfWork.add(order);
        await this.unitOfWork.commit();

        return orderId;
    }

    async handle(command: ConfirmOrderCommand): Promise<void> {
        const order = await this.repository.getById(command.orderId);

        order.confirm(command.paymentId);

        this.unitOfWork.add(order);
        await this.unitOfWork.commit();
    }
}
```

