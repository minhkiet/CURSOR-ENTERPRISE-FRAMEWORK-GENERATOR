**Ví dụ 1: AI-Powered Search**

```typescript
// services/ai-search.service.ts
class AISearchService {
  constructor(
    private embeddingService: EmbeddingService,
    private chatService: ChatService
  ) {}

  async search(
    query: string,
    documents: Array<{ id: string; content: string; title: string }>,
    options: { maxResults?: number; useRAG?: boolean } = {}
  ): Promise<SearchResult[]> {
    const { maxResults = 5, useRAG = true } = options;

    // Generate query embedding
    const queryEmbedding = await this.embeddingService.createEmbedding(query);

    // Calculate similarities
    const results = documents.map(doc => {
      const docEmbedding = doc.embedding || 
        this.embeddingService.createEmbedding(doc.content);
      
      return {
        ...doc,
        similarity: this.embeddingService.cosineSimilarity(
          queryEmbedding,
          docEmbedding
        ),
      };
    });

    // Sort and limit
    return results
      .sort((a, b) => b.similarity - a.similarity)
      .slice(0, maxResults);
  }

  async ragSearch(
    query: string,
    context: string[]
  ): Promise<string> {
    // Build context from retrieved documents
    const contextText = context.join('\n\n---\n\n');

    const response = await this.chatService.createChat([
      {
        role: 'system',
        content: `You are a helpful assistant. Use the following context to answer the user's question.

Context:
${contextText}`
      },
      { role: 'user', content: query }
    ]);

    return response.choices[0].message.content || '';
  }
}
```

