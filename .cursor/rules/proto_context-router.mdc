## PHẦN XII: SMART ROUTING DECISION

### XII.1 Decision Template

```yaml
routing_decision:

  input:
    request: "string"
    language: "VI/EN/ZH/etc"
    
  analysis:
    intent:
      primary: "BUILD/FIX/REDESIGN/REVIEW"
      confidence: 0.0-1.0
      implicit_needs: ["list"]
      
    domain:
      signals: ["keyword matches"]
      confidence: 0.0-1.0
      
    skills:
      - skill_id: "string"
        score: 0.0-1.0
        matched_on: ["keywords"]
        
  decision:
    skills_to_load:
      - skill_id: "string"
        token_budget: "~N tokens"
        
    rules_to_load:
      - rule_id: "string"
        sections: ["§1", "§2"]
        
    context_files:
      - path: "string"
        reason: "string"
        lines: "1-50"
        
    gates:
      pre: ["gate-1"]
      post: ["gate-2"]
      
  tasks:
    - task_id: "task-1"
      description: "string"
      tokens: "~N"
      
  optimization:
    techniques_used: ["list"]
    tokens_saved: "~N"
    total_estimate: "~N tokens"
```

