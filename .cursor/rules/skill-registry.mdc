### 14.3 Smart Routing Decision

```yaml
routing_decision_template:

  request: "string"
  
  analysis:
    language: "VI/EN/ZH/etc"
    primary_intent: "BUILD/FIX/REDESIGN/REVIEW/EXPLAIN"
    confidence: 0.0-1.0
    
    domain_signals:
      - signal: "keyword"
        weight: 0.0-1.0
        
    skills_candidates:
      - skill_id: "string"
        score: 0.0-1.0
        reason: "matched on [keywords]"
        
    mandatory_overlays:
      - karpathy-coding  # Always
      - ponytail  # If "simple/minimal/vibe" detected
      - frontend-review  # If frontend domain
      
  decision:
    skills_to_load:
      - skill_id: "string"
        priority: 1-N
        token_budget: "~N tokens"
        
    rules_to_load:
      - rule_id: "string"
        sections: ["§1", "§2"]
        
    context_files:
      - path: "string"
        reason: "string"
        lines: "optional range"
        
    gates_to_run:
      pre: ["gate-1", "gate-2"]
      post: ["gate-3", "gate-4"]
      
  tasks:
    - task_id: "string"
      description: "string"
      estimated_tokens: "~N"
      blocked_by: ["task-id"]  # Optional
      
  token_summary:
    input: "~N tokens"
    output: "~N tokens"
    total: "~N tokens"
    
  warnings:
    - type: "AMBIGUOUS/COMPLEX/SECURITY"
      message: "string"
      action: "recommendation"
```

