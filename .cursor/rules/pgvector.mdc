## Anti Pattern

**1. Wrong Distance Metric**

Using wrong metric for your vectors. Incompatible with embedding model. Poor search quality. Match metric to model.

**2. Missing Indexes**

Not creating indexes on vector columns. Slow queries. Poor performance. Always index production data.

**3. Unfiltered Vector Search**

Searching entire database. Slow queries. Poor relevance. Pre-filter or use approximate search.

**4. Stale Embeddings**

Not updating embeddings. Outdated search results. Inconsistent data. Sync embeddings with source.

**5. Single Batch Size**

Fixed batch size for all operations. Memory issues. Slow processing. Adaptive batch sizing.

## Best Practice

**1. Schema Design**

```sql
-- Enable extension
CREATE EXTENSION IF NOT EXISTS vector;

-- Documents table with vectors
CREATE TABLE documents (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  tenant_id UUID NOT NULL,
  title TEXT NOT NULL,
  content TEXT NOT NULL,
  metadata JSONB DEFAULT '{}',
  embedding vector(1536), -- For OpenAI ada-002
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Create index for vector search (HNSW)
CREATE INDEX idx_documents_embedding_hnsw ON documents 
  USING hnsw (embedding vector_cosine_ops)
  WITH (m = 16, ef_construction = 64);

-- Create index for metadata filtering
CREATE INDEX idx_documents_tenant ON documents(tenant_id);
CREATE INDEX idx_documents_updated ON documents(updated_at DESC);

-- Knowledge base with categories
CREATE TABLE knowledge_base (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  category TEXT NOT NULL,
  question TEXT NOT NULL,
  answer TEXT NOT NULL,
  embedding vector(1536),
  usage_count INTEGER DEFAULT 0,
  is_active BOOLEAN DEFAULT TRUE,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX idx_kb_embedding_hnsw ON knowledge_base 
  USING hnsw (embedding vector_cosine_ops)
  WITH (m = 16, ef_construction = 64);

CREATE INDEX idx_kb_category ON knowledge_base(category);
CREATE INDEX idx_kb_usage ON knowledge_base(usage_count DESC);

-- User profiles for recommendations
CREATE TABLE user_profiles (
  id UUID PRIMARY KEY REFERENCES users(id) ON DELETE CASCADE,
  interests_vector vector(1536),
  preferences_vector vector(1536),
  interaction_history JSONB DEFAULT '[]',
  updated_at TIMESTAMPTZ DEFAULT NOW()
);
```

**2. Vector Search Functions**

```sql
-- Similarity search function
CREATE OR REPLACE FUNCTION search_documents(
  p_query_embedding vector(1536),
  p_tenant_id UUID,
  p_limit INTEGER DEFAULT 10,
  p_min_similarity FLOAT DEFAULT 0.7
)
RETURNS TABLE (
  id UUID,
  title TEXT,
  content TEXT,
  metadata JSONB,
  similarity FLOAT
) AS $$
BEGIN
  RETURN QUERY
  SELECT
    d.id,
    d.title,
    d.content,
    d.metadata,
    1 - (d.embedding <=> p_query_embedding) AS similarity
  FROM documents d
  WHERE d.tenant_id = p_tenant_id
    AND d.embedding IS NOT NULL
    AND 1 - (d.embedding <=> p_query_embedding) >= p_min_similarity
  ORDER BY d.embedding <=> p_query_embedding
  LIMIT p_limit;
END;
$$ LANGUAGE plpgsql STABLE;

-- Hybrid search (vector + keyword)
CREATE OR REPLACE FUNCTION hybrid_search_documents(
  p_query_embedding vector(1536),
  p_tenant_id UUID,
  p_search_query TEXT,
  p_limit INTEGER DEFAULT 10,
  p_similarity_threshold FLOAT DEFAULT 0.5
)
RETURNS TABLE (
  id UUID,
  title TEXT,
  content TEXT,
  metadata JSONB,
  rank_score FLOAT
) AS $$
BEGIN
  RETURN QUERY
  WITH vector_results AS (
    SELECT
      d.id,
      d.title,
      d.content,
      d.metadata,
      (1 - (d.embedding <=> p_query_embedding)) AS similarity
    FROM documents d
    WHERE d.tenant_id = p_tenant_id
      AND d.embedding IS NOT NULL
  ),
  text_results AS (
    SELECT
      id,
      ts_rank(to_tsvector('english', title || ' ' || content), 
               plainto_tsquery('english', p_search_query)) AS text_score
    FROM documents
    WHERE tenant_id = p_tenant_id
      AND to_tsvector('english', title || ' ' || content) @@ 
          plainto_tsquery('english', p_search_query)
  ),
  combined AS (
    SELECT
      v.id,
      v.title,
      v.content,
      v.metadata,
      v.similarity,
      COALESCE(t.text_score, 0) AS text_score,
      (v.similarity * 0.7 + COALESCE(t.text_score, 0) * 0.3) AS rank_score
    FROM vector_results v
    LEFT JOIN text_results t ON v.id = t.id
    WHERE v.similarity >= p_similarity_threshold
  )
  SELECT
    id,
    title,
    content,
    metadata,
    rank_score
  FROM combined
  ORDER BY rank_score DESC
  LIMIT p_limit;
END;
$$ LANGUAGE plpgsql STABLE;

-- RAG retrieval function
CREATE OR REPLACE FUNCTION retrieve_for_rag(
  p_query_embedding vector(1536),
  p_tenant_id UUID,
  p_max_results INTEGER DEFAULT 5,
  p_max_total_chars INTEGER DEFAULT 4000
)
RETURNS TABLE (
  id UUID,
  content TEXT,
  source TEXT,
  similarity FLOAT
) AS $$
DECLARE
  v_result RECORD;
  v_total_chars INTEGER := 0;
BEGIN
  FOR v_result IN (
    SELECT
      id,
      content,
      title AS source,
      1 - (embedding <=> p_query_embedding) AS similarity
    FROM knowledge_base
    WHERE tenant_id = p_tenant_id
      AND is_active = TRUE
      AND embedding IS NOT NULL
    ORDER BY embedding <=> p_query_embedding
    LIMIT p_max_results
  ) LOOP
    -- Check if adding this would exceed limit
    IF v_total_chars + LENGTH(v_result.content) <= p_max_total_chars THEN
      id := v_result.id;
      content := v_result.content;
      source := v_result.source;
      similarity := v_result.similarity;
      v_total_chars := v_total_chars + LENGTH(v_result.content);
      RETURN NEXT;
    ELSE
      RETURN;
    END IF;
  END LOOP;
END;
$$ LANGUAGE plpgsql STABLE;
```

**3. Embedding Generation**

```typescript
// services/embedding.service.ts
import { createClient } from '@supabase/supabase-js';
import OpenAI from 'openai';

const supabase = createClient(process.env.SUPABASE_URL, process.env.SUPABASE_KEY);
const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });

interface EmbeddingOptions {
  model?: 'text-embedding-3-small' | 'text-embedding-3-large' | 'text-embedding-ada-002';
  dimensions?: number;
}

class EmbeddingService {
  async generateEmbedding(
    text: string,
    options: EmbeddingOptions = {}
  ): Promise<number[]> {
    const model = options.model || 'text-embedding-3-small';
    const dimensions = options.dimensions || 1536;

    const response = await openai.embeddings.create({
      model,
      input: text,
      dimensions
    });

    return response.data[0].embedding;
  }

  async generateBatchEmbeddings(
    texts: string[],
    options: EmbeddingOptions = {}
  ): Promise<number[][]> {
    const model = options.model || 'text-embedding-3-small';
    const dimensions = options.dimensions || 1536;

    const response = await openai.embeddings.create({
      model,
      input: texts,
      dimensions,
      batch_size: 100
    });

    return response.data.map(item => item.embedding);
  }

  async embedAndStoreDocument(
    document: { id: string; title: string; content: string; tenantId: string }
  ): Promise<void> {
    // Combine title and content for embedding
    const textToEmbed = `${document.title}\n\n${document.content}`;
    
    const embedding = await this.generateEmbedding(textToEmbed);

    await supabase
      .from('documents')
      .update({ 
        embedding,
        updated_at: new Date().toISOString()
      })
      .eq('id', document.id);
  }

  async embedAndStoreDocumentsBatch(
    documents: Array<{ id: string; title: string; content: string }>,
    batchSize: number = 50
  ): Promise<void> {
    for (let i = 0; i < documents.length; i += batchSize) {
      const batch = documents.slice(i, i + batchSize);
      
      const texts = batch.map(doc => `${doc.title}\n\n${doc.content}`);
      const embeddings = await this.generateBatchEmbeddings(texts);

      const updates = batch.map((doc, index) => ({
        id: doc.id,
        embedding: embeddings[index],
        updated_at: new Date().toISOString()
      }));

      for (const update of updates) {
        await supabase
          .from('documents')
          .update({
            embedding: update.embedding,
            updated_at: update.updated_at
          })
          .eq('id', update.id);
      }

      console.log(`Embedded batch ${Math.floor(i / batchSize) + 1}/${Math.ceil(documents.length / batchSize)}`);
    }
  }

  async reembedAll(options: EmbeddingOptions = {}): Promise<void> {
    let offset = 0;
    const limit = 100;
    const dimensions = options.dimensions || 1536;

    while (true) {
      const { data: documents, error } = await supabase
        .from('documents')
        .select('id, title, content')
        .is('embedding', null)
        .range(offset, offset + limit - 1);

      if (error) throw error;
      if (!documents || documents.length === 0) break;

      await this.embedAndStoreDocumentsBatch(documents, options);

      offset += limit;
      console.log(`Processed ${offset} documents...`);
    }
  }
}

export const embeddingService = new EmbeddingService();
```

**4. Semantic Search API**

```typescript
// api/semantic-search.ts
import { serve } from 'std/http/server.ts';
import { createClient } from 'supabase';
import { createClient as createSupabaseClient } from '@supabase/supabase-js';

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type'
};

serve(async (req) => {
  if (req.method === 'OPTIONS') {
    return new Response('ok', { headers: corsHeaders });
  }

  try {
    const { query, tenantId, limit = 10, minSimilarity = 0.7 } = await req.json();

    // Create Supabase client
    const supabaseClient = createSupabaseClient(
      Deno.env.get('SUPABASE_URL')!,
      Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!
    );

    // Generate query embedding
    const embeddingResponse = await fetch(
      'https://api.openai.com/v1/embeddings',
      {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${Deno.env.get('OPENAI_API_KEY')}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          model: 'text-embedding-3-small',
          input: query
        })
      }
    );

    const embeddingData = await embeddingResponse.json();
    const queryEmbedding = embeddingData.data[0].embedding;

    // Search using the function
    const { data: results, error } = await supabaseClient
      .rpc('search_documents', {
        p_query_embedding: queryEmbedding,
        p_tenant_id: tenantId,
        p_limit: limit,
        p_min_similarity: minSimilarity
      });

    if (error) throw error;

    return new Response(
      JSON.stringify({ results, query }),
      { headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
    );
  } catch (error) {
    return new Response(
      JSON.stringify({ error: error.message }),
      { status: 500, headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
    );
  }
});
```

