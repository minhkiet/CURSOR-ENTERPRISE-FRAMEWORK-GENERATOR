**6. RAG Implementation**

```typescript
// services/rag.service.ts
import OpenAI from 'openai';
import { embeddingService } from './embedding.service';

interface RAGContext {
  query: string;
  tenantId: string;
  maxTokens: number;
}

interface RAGResult {
  answer: string;
  sources: Array<{ id: string; content: string; similarity: number }>;
}

class RAGService {
  constructor(
    private supabase: SupabaseClient,
    private openai: OpenAI
  ) {}

  async retrieveContext(options: RAGContext): Promise<string[]> {
    // Generate query embedding
    const queryEmbedding = await embeddingService.generateEmbedding(options.query);

    // Retrieve relevant documents
    const { data: docs } = await this.supabase.rpc('retrieve_for_rag', {
      p_query_embedding: queryEmbedding,
      p_tenant_id: options.tenantId,
      p_max_results: 5,
      p_max_total_chars: Math.floor(options.maxTokens * 4) // ~4 chars per token
    });

    return docs.map((doc: any) => `[Source: ${doc.source}]\n${doc.content}`);
  }

  async generateAnswer(options: RAGContext): Promise<RAGResult> {
    // Retrieve context
    const contexts = await this.retrieveContext({
      query: options.query,
      tenantId: options.tenantId,
      maxTokens: options.maxTokens * 0.7 // 70% for context
    });

    // Build prompt
    const systemPrompt = `You are a helpful assistant. Use the following context to answer the user's question. If you don't know the answer based on the context, say so.

Context:
${contexts.join('\n\n---\n\n')}`;

    // Generate answer
    const completion = await this.openai.chat.completions.create({
      model: 'gpt-4',
      messages: [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: options.query }
      ],
      max_tokens: options.maxTokens * 0.3, // 30% for answer
      temperature: 0.7
    });

    return {
      answer: completion.choices[0].message.content || '',
      sources: contexts.map((ctx, index) => ({
        id: `source-${index}`,
        content: ctx,
        similarity: 1 - (index * 0.05) // Placeholder similarity
      }))
    };
  }
}
```

## Workflow

**Phase 1: Planning**

Define use case and requirements. Choose embedding model. Plan dimensions. Estimate storage. Design schema.

**Phase 2: Schema Setup**

Install pgvector extension. Create tables with vector columns. Add metadata columns. Set up indexes.

**Phase 3: Embedding Pipeline**

Implement embedding generation. Set up batch processing. Handle failures. Monitor quality.

**Phase 4: Search Implementation**

Implement search functions. Add hybrid search. Test relevance. Optimize performance.

**Phase 5: Integration**

Integrate with application. Add caching. Implement monitoring. Set up alerting.

**Phase 6: Maintenance**

Monitor performance. Update embeddings. Optimize queries. Scale as needed.

## Ví dụ

**Ví dụ 1: Product Recommendation**

```sql
-- User-product similarity
CREATE OR REPLACE FUNCTION recommend_products(
  p_user_id UUID,
  p_tenant_id UUID,
  p_limit INTEGER DEFAULT 10
)
RETURNS TABLE (
  product_id UUID,
  product_name TEXT,
  score FLOAT
) AS $$
BEGIN
  RETURN QUERY
  WITH user_vector AS (
    SELECT interests_vector
    FROM user_profiles
    WHERE id = p_user_id
  )
  SELECT
    p.id AS product_id,
    p.name AS product_name,
    1 - (COALESCE(u.interests_vector, '0'::vector) <=> p.embedding_vector) AS score
  FROM products p
  CROSS JOIN user_vector u
  WHERE p.tenant_id = p_tenant_id
    AND p.is_active = TRUE
  ORDER BY score DESC
  LIMIT p_limit;
END;
$$ LANGUAGE plpgsql STABLE;
```

