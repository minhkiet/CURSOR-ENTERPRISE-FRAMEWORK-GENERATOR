id = "your-kv-namespace-id"

[[r2_buckets]]
binding = "IMAGES"
bucket_name = "your-images-bucket"
```

```typescript
// src/workers/api-gateway.ts
export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    const url = new URL(request.url);
    
    // Rate limiting
    const ip = request.headers.get('CF-Connecting-IP');
    const key = `rate:${ip}:${url.pathname}`;
    const current = await env.RATE_LIMITER.get(key);
    
    if (current && parseInt(current) > 100) {
      return new Response('Rate limit exceeded', { status: 429 });
    }
    
    await env.RATE_LIMITER.put(key, String((parseInt(current) || 0) + 1), {
      expirationTtl: 60
    });
    
    // Auth validation
    const token = request.headers.get('Authorization');
    if (token) {
      const valid = await validateToken(token, env);
      if (!valid) {
        return new Response('Unauthorized', { status: 401 });
      }
    }
    
    // Forward to origin
    const originUrl = `https://api.example.com${url.pathname}`;
    const response = await fetch(originUrl, {
      headers: {
        ...Object.fromEntries(request.headers),
        'X-Forwarded-For': ip
      }
    });
    
    return new Response(response.body, {
      status: response.status,
      headers: {
        ...Object.fromEntries(response.headers),
        'Cache-Control': 'public, max-age=300'
      }
    });
  }
};
```

**4. R2 Storage Configuration**

```typescript
// Cloudflare R2 Client
import { R2Bucket } from '@cloudflare/workers-types';

export interface Env {
  ASSETS: R2Bucket;
}

export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    const url = new URL(request.url);
    const path = url.pathname.slice(1);
    
    if (request.method === 'GET') {
      // List objects
      if (path === '') {
        const objects = await env.ASSETS.list();
        return Response.json(objects.objects);
      }
      
      // Get object
      const object = await env.ASSETS.get(path);
      if (!object) {
        return new Response('Not Found', { status: 404 });
      }
      
      return new Response(object.body, {
        headers: {
          'Content-Type': object.httpMetadata.contentType,
          'ETag': object.httpEtag,
          'Cache-Control': 'public, max-age=31536000'
        }
      });
    }
    
    if (request.method === 'PUT') {
      // Upload object
      await env.ASSETS.put(path, request.body, {
        httpMetadata: {
          contentType: request.headers.get('Content-Type')
        },
        customMetadata: {
          uploadedBy: 'api',
          uploadedAt: new Date().toISOString()
        }
      });
      
      return new Response('Upload successful', { status: 201 });
    }
    
    if (request.method === 'DELETE') {
      await env.ASSETS.delete(path);
      return new Response('Deleted', { status: 204 });
    }
    
    return new Response('Method Not Allowed', { status: 405 });
  }
};
```

**5. D1 Database (SQLite at Edge)**

```typescript
// Cloudflare D1
export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    const url = new URL(request.url);
    
    if (url.pathname === '/api/users' && request.method === 'GET') {
      const users = await env.DB.prepare(
        'SELECT id, email, name FROM users LIMIT 50'
      ).all();
      
      return Response.json(users.results);
    }
    
    if (url.pathname.startsWith('/api/users/') && request.method === 'GET') {
      const userId = url.pathname.split('/')[3];
      
      const user = await env.DB.prepare(
        'SELECT id, email, name FROM users WHERE id = ?'
      ).bind(userId).first();
      
      if (!user) {
        return new Response('Not Found', { status: 404 });
      }
      
      return Response.json(user);
    }
    
    if (url.pathname === '/api/users' && request.method === 'POST') {
      const body = await request.json();
      
      const result = await env.DB.prepare(
        'INSERT INTO users (id, email, name) VALUES (?, ?, ?)'
      ).bind(
        crypto.randomUUID(),
        body.email,
        body.name
      ).run();
      
      return new Response(JSON.stringify({ id: result.meta.last_row_id }), {
        status: 201,
        headers: { 'Content-Type': 'application/json' }
      });
    }
    
    return new Response('Not Found', { status: 404 });
  }
};
```

**6. Zero Trust Access Configuration**

```yaml
# Cloudflare Access Application Configuration
access:
  applications:
    - name: "Admin Dashboard"
      domain: "admin.example.com"
      session_duration: "24h"
      identity_providers:
        - name: "Okta"
          type: "okta"
          config:
            client_id: "${OKTA_CLIENT_ID}"
            client_secret: "${OKTA_CLIENT_SECRET}"
      policy:
        - name: "Allow Engineering"
          include:
            - email:
                ends_with:
                  - "@example.com"
          exclude:
            - email:
                equals:
                  - "intern@example.com"
          require:
            - mfa
            - device_posture:
                passed_challenge: "valid_device"
```

**7. Analytics and Monitoring**

```typescript
// Cloudflare Analytics API
import { Cloudflare } from 'cloudflare';

const cf = new Cloudflare({ token: process.env.CLOUDFLARE_API_TOKEN });

// Get analytics
const analytics = await cf.analytics.fetch({
  zone_id: 'your-zone-id',
  metrics: ['requests', 'bandwidth', 'cachedRequests'],
  dimensions: ['country', ' colo'],
  since: '-1h',
  until: 'now',
 granularity: '1m'
});

// Get cache analytics
const cacheAnalytics = await cf.cache.analytics.fetch({
  zone_id: 'your-zone-id',
  metrics: ['cacheHitRate', 'egress'],
  since: '-24h'
});

// Get Worker metrics
const workerMetrics = await cf.workersanalytics.fetch({
  account_id: 'your-account-id',
  metrics: ['requests', 'errors', 'duration'],
  worker: 'your-worker-script',
  since: '-1h'
});

// Configure Logpush
await cf.logpush.jobs.create('your-zone-id', {
  name: 'access-logs',
  destination_conf: 's3://your-bucket/logs/',
  dataset: 'accesslogs',
  enabled: true,
  logpull_options: 'fields=ClientIP,ClientRequestURI,ClientRequestMethod,ClientResponseStatus'
});
```

## Workflow

**Phase 1: Setup**

Create Cloudflare account. Verify domain. Configure DNS. Set up SSL/TLS.

**Phase 2: Security Configuration**

Enable DDoS protection. Configure firewall rules. Set up rate limiting. Configure Access policies.

**Phase 3: Performance Configuration**

Enable CDN. Configure caching rules. Set up optimization. Configure Workers.

**Phase 4: Monitoring**

Set up analytics. Configure Logpush. Set up alerts. Create dashboards.

**Phase 5: Operations**

Monitor traffic. Review analytics. Adjust configurations. Optimize performance.

