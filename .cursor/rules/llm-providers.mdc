### Best Practice

**1. Claude SDK Setup**

```typescript
// lib/claude.ts
import Anthropic from '@anthropic-ai/sdk';

const anthropic = new Anthropic({
  apiKey: process.env.ANTHROPIC_API_KEY,
  timeout: 120000,
  maxRetries: 3,
});

async function withClaudeRetry<T>(fn: () => Promise<T>, maxRetries: number = 3): Promise<T> {
  let lastError: Error | null = null;

  for (let attempt = 0; attempt < maxRetries; attempt++) {
    try {
      return await fn();
    } catch (error: any) {
      lastError = error;
      if (error.status === 429 || error.status >= 500) {
        await sleep(Math.pow(2, attempt) * 1000);
        continue;
      }
      throw error;
    }
  }

  throw lastError;
}
```

**2. Message Creation**

```typescript
// services/claude-text.service.ts
class ClaudeTextService {
  async createMessage(
    messages: { role: 'user' | 'assistant'; content: string }[],
    systemPrompt?: string,
    options: {
      model?: 'claude-opus-4' | 'claude-sonnet-4' | 'claude-haiku-3';
      maxTokens?: number;
      temperature?: number;
    } = {}
  ): Promise<any> {
    const { model = 'claude-sonnet-4', maxTokens = 4096, temperature = 0.7 } = options;

    const request: any = {
      model,
      messages,
      max_tokens: maxTokens,
      temperature,
    };

    if (systemPrompt) request.system = systemPrompt;

    return withClaudeRetry(() => anthropic.messages.create(request));
  }

  async generateText(prompt: string, systemPrompt?: string, options: any = {}): Promise<string> {
    const response = await this.createMessage([{ role: 'user', content: prompt }], systemPrompt, options);
    return response.content[0].text || '';
  }

  async chat(messages: { role: string; content: string }[], systemPrompt?: string, options: any = {}): Promise<string> {
    const claudeMessages = messages.map(msg => ({
      role: msg.role === 'assistant' ? 'assistant' : 'user',
      content: msg.content,
    }));
    const response = await this.createMessage(claudeMessages, systemPrompt, options);
    return response.content[0].text || '';
  }
}
```

**3. Tool Use**

```typescript
// services/claude-tool.service.ts
const tools = [
  {
    name: 'get_weather',
    description: 'Get the current weather for a location',
    input_schema: {
      type: 'object',
      properties: {
        location: { type: 'string', description: 'City name' },
        unit: { type: 'string', enum: ['celsius', 'fahrenheit'] },
      },
      required: ['location'],
    },
  },
];

class ClaudeToolService {
  async chatWithTools(userMessage: string, systemPrompt?: string, maxIterations: number = 5): Promise<string> {
    const messages: any[] = [{ role: 'user', content: userMessage }];

    for (let iterations = 0; iterations < maxIterations; iterations++) {
      const response = await anthropic.messages.create({
        model: 'claude-opus-4',
        max_tokens: 4096,
        messages,
        system: systemPrompt,
        tools,
      });

      messages.push({ role: 'assistant', content: response.content });

      if (response.stop_reason === 'end_turn') return response.content[0].text || '';

      if (response.stop_reason === 'tool_use') {
        for (const block of response.content) {
          if (block.type === 'tool_use') {
            const result = await this.executeTool(block.name, block.input);
            messages.push({
              role: 'user',
              content: [{ type: 'tool_result', tool_use_id: block.id, content: JSON.stringify(result) }],
            });
          }
        }
      }
    }

    return 'Maximum iterations reached';
  }

  private async executeTool(name: string, args: any): Promise<any> {
    switch (name) {
      case 'get_weather': return { location: args.location, temperature: '22°C', condition: 'Sunny' };
      default: return { error: `Unknown tool: ${name}` };
    }
  }
}
```

**4. Vision Support**

```typescript
// services/claude-vision.service.ts
class ClaudeVisionService {
  async analyzeImage(
    imageSource: { type: 'base64' | 'url'; media_type?: string; data: string },
    prompt: string,
    options: { model?: 'claude-opus-4' | 'claude-sonnet-4'; maxTokens?: number } = {}
  ): Promise<string> {
    const content: any[] = [{ type: 'text', text: prompt }];

    if (imageSource.type === 'base64') {
      content.push({
        type: 'image',
        source: { type: 'base64', media_type: imageSource.media_type || 'image/jpeg', data: imageSource.data },
      });
    } else {
      content.push({ type: 'image', source: { type: 'url', url: imageSource.data } });
    }

    const response = await anthropic.messages.create({
      model: options.model || 'claude-sonnet-4',
      max_tokens: options.maxTokens || 1024,
      messages: [{ role: 'user', content }],
    });

    return response.content[0].text || '';
  }

  async extractTextFromImage(imageData: string, mimeType: string = 'image/jpeg'): Promise<string> {
    return this.analyzeImage({ type: 'base64', media_type: mimeType, data: imageData }, 'Extract all text.');
  }
}
```

**5. Cost Tracking**

```typescript
// services/claude-cost.service.ts
const PRICING: Record<string, { input: number; output: number }> = {
  'claude-opus-4': { input: 15, output: 75 },
  'claude-sonnet-4': { input: 3, output: 15 },
  'claude-haiku-3': { input: 0.8, output: 4 },
};

class ClaudeCostService {
  private records: any[] = [];
  private dailyBudget: number;
  private monthlyBudget: number;

  constructor(dailyBudget: number = 100, monthlyBudget: number = 2000) {
    this.dailyBudget = dailyBudget;
    this.monthlyBudget = monthlyBudget;
  }

  recordUsage(usage: { input_tokens: number; output_tokens: number }, model: string) {
    const pricing = PRICING[model] || PRICING['claude-sonnet-4'];
    const cost = (usage.input_tokens / 1_000_000) * pricing.input + (usage.output_tokens / 1_000_000) * pricing.output;
    this.records.push({ timestamp: new Date(), model, ...usage, cost });
    this.checkBudgets();
    return cost;
  }

  getTodayCost(): number {
    const today = new Date(); today.setHours(0, 0, 0, 0);
    return this.records.filter(r => r.timestamp >= today).reduce((sum, r) => sum + r.cost, 0);
  }

  getMonthCost(): number {
    const monthStart = new Date(); monthStart.setDate(1); monthStart.setHours(0, 0, 0, 0);
    return this.records.filter(r => r.timestamp >= monthStart).reduce((sum, r) => sum + r.cost, 0);
  }

  canMakeRequest(): boolean {
    return this.getTodayCost() < this.dailyBudget && this.getMonthCost() < this.monthlyBudget;
  }
}
```

**6. Streaming Responses**

```typescript
// services/claude-stream.service.ts
class ClaudeStreamService {
  async *streamMessage(
    messages: any[],
    systemPrompt?: string,
    options: any = {}
  ): AsyncGenerator<string> {
    const stream = await anthropic.messages.stream({
      model: options.model || 'claude-sonnet-4',
      max_tokens: options.maxTokens || 4096,
      messages,
      system: systemPrompt,
      temperature: options.temperature || 0.7,
    });

    for await (const event of stream) {
      if (event.type === 'content_block_delta' && event.delta.type === 'text_delta') {
        yield event.delta.text;
      }
    }
  }

  async chatStream(messages: any[], onChunk: (chunk: string) => void, systemPrompt?: string): Promise<string> {
    let fullResponse = '';
    for await (const chunk of this.streamMessage(messages, systemPrompt)) {
      fullResponse += chunk;
      onChunk(chunk);
    }
    return fullResponse;
  }
}
```

### Workflow

**Phase 1: Setup**

Get Anthropic API key. Install SDK. Configure authentication. Set up billing.

**Phase 2: Implementation**

Set up client. Implement basic generation. Add tool support. Configure safety.

**Phase 3: Prompt Engineering**

Design system prompts. Test various prompts. Iterate on results. Document best prompts.

**Phase 4: Integration**

Integrate with application. Add streaming. Implement caching. Set up monitoring.

**Phase 5: Testing**

Test with various inputs. Verify responses. Measure latency. User acceptance testing.

**Phase 6: Deployment**

Deploy to production. Set up cost alerts. Configure rate limits. Document integration.

