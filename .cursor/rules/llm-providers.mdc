// services/gemini-vision.service.ts
class GeminiVisionService {
  async analyzeImage(
    imageData: Buffer,
    mimeType: string = 'image/jpeg',
    prompt?: string
  ): Promise<string> {
    const result = await visionModel.generateContent({
      contents: [{
        role: 'user',
        parts: [
          { inlineData: { mimeType, data: imageData.toString('base64') } },
          { text: prompt || 'Describe this image in detail.' },
        ],
      }],
    });

    return result.response.candidates?.[0]?.content?.parts?.[0]?.text || '';
  }

  async extractTextFromImage(imageData: Buffer, mimeType: string = 'image/png'): Promise<string> {
    return this.analyzeImage(imageData, mimeType, 'Extract all text from this image.');
  }

  async analyzeDocument(
    imageData: Buffer,
    mimeType: string = 'image/png',
    analysisType: 'table' | 'form' | 'mixed' = 'mixed'
  ): Promise<any> {
    const prompt = analysisType === 'table'
      ? 'Return JSON representation of the table.'
      : analysisType === 'form'
      ? 'Extract data as JSON with field names and values.'
      : 'Analyze and return structured JSON.';

    const response = await this.analyzeImage(imageData, mimeType, prompt);
    try { return JSON.parse(response); } catch { return { raw: response }; }
  }
}
