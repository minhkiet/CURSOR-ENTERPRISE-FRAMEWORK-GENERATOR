**5. Repository Pattern**

```typescript
// application/interfaces/IOrderRepository.ts
export interface IOrderRepository {
  findById(id: string): Promise<Order | null>;
  findByIdWithRelations(id: string): Promise<Order | null>;
  findByCustomer(customerId: string, options?: PaginationOptions): Promise<Order[]>;
  findByStatus(status: OrderStatus, options?: PaginationOptions): Promise<Order[]>;
  findByDateRange(startDate: Date, endDate: Date): Promise<Order[]>;
  save(order: Order): Promise<void>;
  update(order: Order): Promise<void>;
  delete(id: string): Promise<void>;
  count(filters?: OrderFilters): Promise<number>;
}

// infrastructure/persistence/repositories/PostgresOrderRepository.ts
export class PostgresOrderRepository implements IOrderRepository {
  constructor(
    private db: Database,
    private eventEmitter: EventEmitter
  ) {}

  async findById(id: string): Promise<Order | null> {
    const row = await this.db.queryOne(
      `SELECT * FROM orders WHERE id = $1`,
      [id]
    );

    if (!row) return null;

    return this.mapToEntity(row);
  }

  async findByIdWithRelations(id: string): Promise<Order | null> {
    const orderRow = await this.db.queryOne(
      `SELECT * FROM orders WHERE id = $1`,
      [id]
    );

    if (!orderRow) return null;

    const itemRows = await this.db.query(
      `SELECT * FROM order_items WHERE order_id = $1`,
      [id]
    );

    const customerRow = await this.db.queryOne(
      `SELECT * FROM customers WHERE id = $1`,
      [orderRow.customer_id]
    );

    return this.mapToEntityWithRelations(orderRow, itemRows, customerRow);
  }

  async findByCustomer(
    customerId: string,
    options?: PaginationOptions
  ): Promise<Order[]> {
    const { page = 1, limit = 20 } = options || {};
    const offset = (page - 1) * limit;

    const rows = await this.db.query(
      `SELECT * FROM orders 
       WHERE customer_id = $1 
       ORDER BY created_at DESC 
       LIMIT $2 OFFSET $3`,
      [customerId, limit, offset]
    );

    return rows.map(row => this.mapToEntity(row));
  }

  async save(order: Order): Promise<void> {
    await this.db.transaction(async (tx) => {
      await tx.query(
        `INSERT INTO orders (id, customer_id, status, total_amount, shipping_address, created_by, created_at)
         VALUES ($1, $2, $3, $4, $5, $6, $7)`,
        [
          order.id,
          order.customerId,
          order.status.value,
          order.totalAmount.amount,
          JSON.stringify(order.shippingAddress),
          order.createdBy,
          order.createdAt
        ]
      );

      for (const item of order.items) {
        await tx.query(
          `INSERT INTO order_items (id, order_id, product_id, product_name, quantity, unit_price, subtotal)
           VALUES ($1, $2, $3, $4, $5, $6, $7)`,
          [
            item.id,
            order.id,
            item.productId,
            item.productName,
            item.quantity,
            item.unitPrice.amount,
            item.subtotal.amount
          ]
        );
      }

      // Update outbox for eventual consistency
      await tx.query(
        `INSERT INTO outbox (id, aggregate_type, aggregate_id, event_type, payload, created_at)
         VALUES ($1, $2, $3, $4, $5, $6)`,
        [
          uuid(),
          'Order',
          order.id,
          'OrderCreated',
          JSON.stringify(order.toEvent()),
          new Date()
        ]
      );
    });
  }

  private mapToEntity(row: any): Order {
    return Order.restore(
      OrderId.from(row.id),
      CustomerId.from(row.customer_id),
      [],
      OrderStatus.from(row.status),
      Money.from(row.total_amount, 'USD'),
      row.shipping_address ? JSON.parse(row.shipping_address) : null,
      row.created_by,
      row.created_at
    );
  }
}
```

**6. Unit of Work Pattern**

```typescript
// application/unit-of-work/UnitOfWork.ts
export interface IUnitOfWork {
  transaction<T>(fn: (ctx: TransactionContext) => Promise<T>): Promise<T>;
  commit(): Promise<void>;
  rollback(): Promise<void>;
}

export class UnitOfWork implements IUnitOfWork {
  private transactionContext: TransactionContext | null = null;
  private isCommitted = false;

  constructor(
    private db: Database,
    private repositories: Map<string, any>
  ) {}

  async transaction<T>(fn: (ctx: TransactionContext) => Promise<T>): Promise<T> {
    if (this.transactionContext) {
      // Already in a transaction, execute within it
      return fn(this.transactionContext);
    }

    return this.db.transaction(async (tx) => {
      const ctx: TransactionContext = {
        getRepository: <T>(repoClass: new (...args: any[]) => T): T => {
          // Get or create repository with transaction
          const repo = this.repositories.get(repoClass.name);
          if (repo) {
            return repo.withTransaction(tx);
          }
          return null as T;
        },
        publish: async (event: DomainEvent) => {
          // Store event for later publishing
          ctx.events.push(event);
        },
        events: []
      };

      this.transactionContext = ctx;
      try {
        const result = await fn(ctx);
        await this.commit();
        return result;
      } catch (error) {
        await this.rollback();
        throw error;
      } finally {
        this.transactionContext = null;
        this.isCommitted = false;
      }
    });
  }

  async commit(): Promise<void> {
    if (!this.transactionContext || this.isCommitted) return;
    
    // Publish domain events
    for (const event of this.transactionContext.events) {
      await eventBus.publish(event);
    }
    
    this.isCommitted = true;
  }

  async rollback(): Promise<void> {
    this.transactionContext = null;
    this.isCommitted = false;
  }
}
