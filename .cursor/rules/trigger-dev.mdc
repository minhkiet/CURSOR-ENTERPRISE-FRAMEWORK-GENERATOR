**2. Job Definitions**

```typescript
// jobs/order/order-confirmation.job.ts
import { eventTrigger, interval, Job } from '@trigger.dev/sdk';
import { z } from 'zod';
import { Resend } from '@trigger.dev/resend';
import { PrismaClient } from '@prisma/client';

const prisma = new PrismaClient();
const resend = new Resend(process.env.RESEND_API_KEY);

export const orderConfirmationJob = new Job({
  id: 'order-confirmation',
  name: 'Send Order Confirmation',
  version: '1.0.0',
  trigger: eventTrigger({
    name: 'order.created',
    schema: z.object({
      orderId: z.string(),
      customerId: z.string(),
      email: z.string().email(),
      items: z.array(z.object({
        productId: z.string(),
        name: z.string(),
        quantity: z.number(),
        price: z.number()
      })),
      total: z.number(),
      shippingAddress: z.object({
        street: z.string(),
        city: z.string(),
        country: z.string(),
        postalCode: z.string()
      })
    })
  }),
  
  async run(trigger, io) {
    const { orderId, customerId, email, items, total, shippingAddress } = trigger.payload;

    await io.logger.info('Processing order confirmation', { orderId, customerId });

    // Generate order details
    const orderDetails = await io.runTask('generate-order-details', async () => {
      return {
        orderId,
        items,
        total,
        estimatedDelivery: calculateDeliveryDate(),
        trackingUrl: `https://tracking.example.com/${orderId}`
      };
    }, { 
      name: 'Generate Order Details',
      timeout: '10s'
    });

    // Send confirmation email
    await io.runTask('send-confirmation-email', async () => {
      await resend.emails.send({
        from: 'orders@example.com',
        to: email,
        subject: `Order Confirmation - ${orderId}`,
        html: generateConfirmationEmailHtml({
          orderId,
          items,
          total,
          ...orderDetails
        })
      });
    }, {
      name: 'Send Email',
      timeout: '30s',
      retry: {
        maxAttempts: 3,
        minTimeout: '10s',
        maxTimeout: '5m',
        factor: 2
      }
    });

    // Update database
    await io.runTask('update-order-status', async () => {
      await prisma.order.update({
        where: { id: orderId },
        data: { 
          confirmationSentAt: new Date(),
          status: 'confirmed'
        }
      });
    }, {
      name: 'Update Database',
      timeout: '5s'
    });

    await io.logger.info('Order confirmation completed', { orderId });
  }
});

// Helper function
function calculateDeliveryDate(): string {
  const delivery = new Date();
  delivery.setDate(delivery.getDate() + 5);
  return delivery.toLocaleDateString('en-US', { 
    weekday: 'long',
    month: 'long',
    day: 'numeric'
  });
}

function generateConfirmationEmailHtml(data: any): string {
  return `
    <h1>Order Confirmation</h1>
    <p>Thank you for your order!</p>
    <p><strong>Order ID:</strong> ${data.orderId}</p>
    <p><strong>Total:</strong> $${data.total.toFixed(2)}</p>
    <p><strong>Estimated Delivery:</strong> ${data.estimatedDelivery}</p>
  `;
}
```

**3. Scheduled Jobs**

```typescript
// jobs/reporting/daily-report.job.ts
import { scheduleEvent, Job } from '@trigger.dev/sdk';
import { z } from 'zod';

export const dailyReportJob = new Job({
  id: 'daily-report',
  name: 'Generate Daily Report',
  version: '1.0.0',
  trigger: scheduleEvent({
    cron: '0 8 * * *',  // Daily at 8 AM UTC
    timezone: 'UTC'
  }),
  
  async run(trigger, io) {
    const reportDate = new Date().toISOString().split('T')[0];
    
    await io.logger.info('Starting daily report generation', { reportDate });

    // Fetch metrics from various sources
    const salesData = await io.runTask('fetch-sales-data', async () => {
      return await fetch(`${process.env.API_URL}/reports/sales?date=${reportDate}`)
        .then(res => res.json());
    }, { name: 'Fetch Sales', timeout: '30s' });

    const userMetrics = await io.runTask('fetch-user-metrics', async () => {
      return await fetch(`${process.env.API_URL}/reports/users?date=${reportDate}`)
        .then(res => res.json());
    }, { name: 'Fetch Users', timeout: '30s' });

    const operationalMetrics = await io.runTask('fetch-operational-metrics', async () => {
      return await fetch(`${process.env.API_URL}/reports/operations?date=${reportDate}`)
        .then(res => res.json());
    }, { name: 'Fetch Operations', timeout: '30s' });

    // Generate report
    const report = await io.runTask('generate-report', async () => {
      return {
        date: reportDate,
        summary: {
          totalSales: salesData.total,
          totalOrders: salesData.orderCount,
          newUsers: userMetrics.newUsers,
          activeUsers: userMetrics.activeUsers,
          avgResponseTime: operationalMetrics.avgResponseTime,
          errorRate: operationalMetrics.errorRate
        },
        generatedAt: new Date().toISOString()
      };
    }, { name: 'Generate Report', timeout: '10s' });

    // Send report via Slack
    await io.runTask('send-slack-notification', async () => {
      await fetch(process.env.SLACK_WEBHOOK_URL!, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          blocks: [
            { type: 'header', text: { type: 'plain_text', text: 'Daily Report' } },
            { type: 'section', fields: [
              { type: 'mrkdwn', text: `*Sales:* $${report.summary.totalSales}` },
              { type: 'mrkdwn', text: `*Orders:* ${report.summary.totalOrders}` },
              { type: 'mrkdwn', text: `*New Users:* ${report.summary.newUsers}` },
              { type: 'mrkdwn', text: `*Active Users:* ${report.summary.activeUsers}` }
            ]}
          ]
        })
      });
    }, {
      name: 'Send Slack',
      timeout: '10s',
      retry: { maxAttempts: 3 }
    });

    await io.logger.info('Daily report completed', { reportDate, report });
  }
});
```

**4. Webhook Triggers**

```typescript
// triggers/webhook/stripe.trigger.ts
import { Job } from '@trigger.dev/sdk';
import { z } from 'zod';
import Stripe from 'stripe';

const stripe = new Stripe(process.env.STRIPE_SECRET_KEY!);

export const stripeWebhookJob = new Job({
  id: 'stripe-webhook',
  name: 'Stripe Webhook Handler',
  version: '1.0.0',
  trigger: {
    // Custom webhook endpoint
    schema: z.object({
      type: z.string(),
      data: z.object({
        object: z.any()
      })
    })
  },
  
  async run(trigger, io) {
    const { type, data } = trigger.payload;

    await io.logger.info('Processing Stripe webhook', { type, eventId: data.object.id });

    switch (type) {
      case 'payment_intent.succeeded':
        await handlePaymentSuccess(data.object, io);
        break;
        
      case 'payment_intent.payment_failed':
        await handlePaymentFailure(data.object, io);
        break;
        
      case 'customer.subscription.created':
        await handleSubscriptionCreated(data.object, io);
        break;
        
      case 'customer.subscription.deleted':
        await handleSubscriptionDeleted(data.object, io);
        break;
        
      case 'invoice.payment_succeeded':
        await handleInvoicePaid(data.object, io);
        break;
        
      default:
        await io.logger.info('Unhandled Stripe event type', { type });
    }
  }
});

async function handlePaymentSuccess(paymentIntent: Stripe.PaymentIntent, io: any) {
  await io.runTask('update-order-status', async () => {
    // Update order status to paid
    await db.order.update({
      where: { stripePaymentId: paymentIntent.id },
      data: { 
        status: 'paid',
        paidAt: new Date()
      }
    });
  }, { name: 'Update Order', timeout: '10s' });

  await io.logger.info('Payment succeeded', { 
    paymentIntentId: paymentIntent.id,
    amount: paymentIntent.amount 
  });
}

async function handlePaymentFailure(paymentIntent: Stripe.PaymentIntent, io: any) {
  await io.runTask('handle-payment-failure', async () => {
    await db.order.update({
      where: { stripePaymentId: paymentIntent.id },
      data: { 
        status: 'payment_failed',
        failureMessage: paymentIntent.last_payment_error?.message
      }
    });
    
    // Send notification to customer
    await emailService.sendPaymentFailureNotification(
      paymentIntent.metadata.customerId,
      paymentIntent.last_payment_error?.message || 'Payment failed'
    );
  }, { name: 'Handle Failure', timeout: '10s' });

  await io.logger.warn('Payment failed', { 
    paymentIntentId: paymentIntent.id,
    error: paymentIntent.last_payment_error 
  });
}
```

**5. Batch Processing**

```typescript
// jobs/user/user-sync.job.ts
import { Job } from '@trigger.dev/sdk';
import { z } from 'zod';

export const userSyncJob = new Job({
  id: 'user-sync',
  name: 'Sync Users to External CRM',
  version: '1.0.0',
  trigger: {
    schema: z.object({
      batchId: z.string().optional()
    })
  },
  
  async init() {
    return { apiKey: process.env.CRM_API_KEY };
  },
  
  async run(trigger, io, init) {
    await io.logger.info('Starting user sync', { batchId: trigger.payload.batchId });

    // Get users to sync
    const users = await io.runTask('fetch-users', async () => {
      return await db.user.findMany({
        where: { 
          syncedAt: null,
          status: 'active'
        },
        take: 1000
      });
    }, { name: 'Fetch Users', timeout: '30s' });

    if (users.length === 0) {
      await io.logger.info('No users to sync');
      return { synced: 0 };
    }

    // Process in batches
    const batchSize = 50;
    let syncedCount = 0;

    for (let i = 0; i < users.length; i += batchSize) {
      const batch = users.slice(i, i + batchSize);
      
      await io.runTask(`sync-batch-${i / batchSize}`, async () => {
        // Call CRM API
        const response = await fetch(`${process.env.CRM_API_URL}/contacts/batch`, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${init.apiKey}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            contacts: batch.map(user => ({
              email: user.email,
              firstName: user.firstName,
              lastName: user.lastName,
              externalId: user.id
            }))
          })
        });

        if (!response.ok) {
          throw new Error(`CRM API failed: ${response.status}`);
        }

        const result = await response.json();
        
        // Update synced status
        await db.user.updateMany({
          where: { id: { in: batch.map(u => u.id) } },
          data: { syncedAt: new Date() }
        });

        return { synced: batch.length, result };
      }, {
        name: `Sync Batch ${i / batchSize}`,
        timeout: '60s',
        retry: { maxAttempts: 3 }
      });

      syncedCount += batch.length;
      
      await io.logger.info('Batch synced', { 
        batchIndex: i / batchSize, 
        syncedCount 
      });
    }

    return { synced: syncedCount };
  }
});
```

**6. Trigger Configuration**

```typescript
// trigger.config.ts
import { TriggerClient, verifyWebhookSignature } from '@trigger.dev/sdk';

export const client = new TriggerClient({
  id: 'app-production',
  apiKey: process.env.TRIGGER_API_KEY,
  apiUrl: process.env.TRIGGER_API_URL,
  verbose: process.env.NODE_ENV !== 'production',
  logger: {
    debug: (...args) => console.debug('[Trigger]', ...args),
    info: (...args) => console.info('[Trigger]', ...args),
    warn: (...args) => console.warn('[Trigger]', ...args),
    error: (...args) => console.error('[Trigger]', ...args),
  }
});

// Register jobs
import { orderConfirmationJob } from './jobs/order/order-confirmation.job';
import { dailyReportJob } from './jobs/reporting/daily-report.job';
import { userSyncJob } from './jobs/user/user-sync.job';

client.define(job);

// Webhook verification
export async function handleWebhook(req: Request): Promise<Response> {
  const signature = req.headers.get('x-trigger-signature');
  const body = await req.text();
  
  if (!verifyWebhookSignature(body, signature!, process.env.TRIGGER_WEBHOOK_SECRET!)) {
    return new Response('Invalid signature', { status: 401 });
  }
  
  return client.handleWebhook(req);
}

// Start the worker
if (process.env.TRIGGER_WORKER === 'true') {
  client.start();
}
```

**7. Express Integration**

```typescript
// api/webhooks.ts
import express, { Request, Response, NextFunction } from 'express';
import { verifyWebhookSignature } from '@trigger.dev/sdk';

const router = express.Router();

// GitHub webhook
router.post('/github', async (req: Request, res: Response) => {
  const signature = req.headers['x-hub-signature-256'] as string;
  
  if (!verifyGitHubSignature(req.body, signature, process.env.GITHUB_WEBHOOK_SECRET!)) {
    return res.status(401).json({ error: 'Invalid signature' });
  }
  
  // Trigger job
  await triggerClient.sendEvent({
    name: 'github.push',
    payload: req.body
  });
  
  res.status(200).json({ ok: true });
});

// Stripe webhook
router.post('/stripe', async (req: Request, res: Response) => {
  const signature = req.headers['stripe-signature'] as string;
  
  if (!verifyStripeSignature(req.body, signature, process.env.STRIPE_WEBHOOK_SECRET!)) {
    return res.status(400).json({ error: 'Invalid signature' });
  }
  
  await triggerClient.sendEvent({
    name: req.body.type,
    payload: req.body.data.object
  });
  
  res.status(200).json({ received: true });
});

// Custom webhook endpoint
router.post('/trigger', async (req: Request, res: Response) => {
  const signature = req.headers['x-trigger-signature'] as string;
  
  if (!verifyWebhookSignature(JSON.stringify(req.body), signature, process.env.TRIGGER_WEBHOOK_SECRET!)) {
    return res.status(401).json({ error: 'Invalid signature' });
  }
  
  const { eventName, payload } = req.body;
  
  await triggerClient.sendEvent({
    name: eventName,
    payload
  });
  
  res.status(202).json({ queued: true });
});
```

## Workflow

**Phase 1: Job Design**

Identify background tasks. Design job structure. Define triggers. Plan error handling.

**Phase 2: Implementation**

Create job definitions. Implement handlers. Configure retries. Add logging.

**Phase 3: Testing**

Test jobs in isolation. Mock external services. Test error scenarios.

**Phase 4: Deployment**

Deploy to production. Configure environment. Monitor executions.

**Phase 5: Operations**

Monitor job execution. Handle failures. Optimize performance. Update jobs.

