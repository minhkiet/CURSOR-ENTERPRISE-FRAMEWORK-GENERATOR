**2. Workflow Definitions**

```typescript
// workflows/order.workflow.ts
import { proxyActivities, startChild, continueAsNew, log, workflowInfo } from '@temporalio/workflow';
import type * as activities from '../activities/order.activities';

const { 
  createOrderRecord,
  reserveInventory,
  processPayment,
  sendOrderConfirmation,
  releaseInventory,
  refundPayment,
  sendOrderFailedNotification
} = proxyActivities<typeof activities>({
  startToCloseTimeout: '5 minutes',
  retry: {
    initialInterval: '1 second',
    backoffCoefficient: 2,
    maximumAttempts: 3
  }
});

export interface OrderWorkflowInput {
  orderId: string;
  customerId: string;
  items: Array<{
    productId: string;
    quantity: number;
    price: number;
  }>;
  paymentMethod: string;
  shippingAddress: {
    street: string;
    city: string;
    country: string;
    postalCode: string;
  };
}

export interface OrderWorkflowResult {
  success: boolean;
  orderId: string;
  transactionId?: string;
  error?: string;
}

// Saga workflow for order processing
export async function processOrder(input: OrderWorkflowInput): Promise<OrderWorkflowResult> {
  const { orderId, customerId, items, paymentMethod, shippingAddress } = input;
  
  log.info('Starting order processing', { orderId, customerId });
  
  // Step 1: Create order record
  let orderRecordId: string;
  try {
    orderRecordId = await createOrderRecord({
      orderId,
      customerId,
      items,
      shippingAddress
    });
    log.info('Order record created', { orderId, orderRecordId });
  } catch (error) {
    log.error('Failed to create order record', { orderId, error });
    return { success: false, orderId, error: 'Failed to create order' };
  }

  // Step 2: Reserve inventory (saga step)
  let inventoryReservationId: string;
  try {
    inventoryReservationId = await reserveInventory({
      orderId,
      items
    });
    log.info('Inventory reserved', { orderId, inventoryReservationId });
  } catch (error) {
    log.error('Failed to reserve inventory', { orderId, error });
    // Compensating action: none needed for inventory
    return { success: false, orderId, error: 'Inventory unavailable' };
  }

  // Step 3: Process payment (saga step)
  let paymentTransactionId: string;
  try {
    const total = items.reduce((sum, item) => sum + item.price * item.quantity, 0);
    paymentTransactionId = await processPayment({
      orderId,
      customerId,
      amount: total,
      paymentMethod
    });
    log.info('Payment processed', { orderId, paymentTransactionId });
  } catch (error) {
    log.error('Payment failed', { orderId, error });
    // Compensating action: release inventory
    await releaseInventory({ reservationId: inventoryReservationId });
    log.info('Inventory released after payment failure', { orderId });
    
    return { success: false, orderId, error: 'Payment failed' };
  }

  // Step 4: Send confirmation
  try {
    await sendOrderConfirmation({
      orderId,
      customerId,
      items,
      transactionId: paymentTransactionId
    });
    log.info('Confirmation sent', { orderId });
  } catch (error) {
    // Non-critical: log but don't fail
    log.warn('Failed to send confirmation', { orderId, error });
  }

  return {
    success: true,
    orderId,
    transactionId: paymentTransactionId
  };
}
```

**3. Activity Definitions**

```typescript
// activities/order.activities.ts
import { Context } from '@temporalio/activity';

export interface CreateOrderRecordInput {
  orderId: string;
  customerId: string;
  items: Array<{
    productId: string;
    quantity: number;
    price: number;
  }>;
  shippingAddress: {
    street: string;
    city: string;
    country: string;
    postalCode: string;
  };
}

export interface ReserveInventoryInput {
  orderId: string;
  items: Array<{
    productId: string;
    quantity: number;
  }>;
}

export interface ProcessPaymentInput {
  orderId: string;
  customerId: string;
  amount: number;
  paymentMethod: string;
}

export async function createOrderRecord(input: CreateOrderRecordInput): Promise<string> {
  const ctx = Context.current();
  ctx.info('Creating order record', { orderId: input.orderId });
  
  const order = await db.orders.create({
    id: input.orderId,
    customerId: input.customerId,
    status: 'pending',
    items: input.items,
    shippingAddress: input.shippingAddress,
    createdAt: new Date()
  });
  
  return order.id;
}

export async function reserveInventory(input: ReserveInventoryInput): Promise<string> {
  const ctx = Context.current();
  ctx.info('Reserving inventory', { orderId: input.orderId });
  
  // Check availability first (idempotency)
  const existing = await ctx.session.get(`inventory:${input.orderId}`);
  if (existing) {
    return existing;
  }
  
  // Reserve in inventory service
  const result = await inventoryService.reserveItems(input.items, {
    orderId: input.orderId,
    idempotencyKey: `reserve:${input.orderId}`
  });
  
  // Cache reservation ID for idempotency
  await ctx.session.set(`inventory:${input.orderId}`, result.reservationId);
  
  return result.reservationId;
}

export async function releaseInventory(input: { reservationId: string }): Promise<void> {
  const ctx = Context.current();
  ctx.info('Releasing inventory', { reservationId: input.reservationId });
  
  await inventoryService.releaseReservation(input.reservationId);
}

export async function processPayment(input: ProcessPaymentInput): Promise<string> {
  const ctx = Context.current();
  ctx.info('Processing payment', { orderId: input.orderId, amount: input.amount });
  
  // Idempotency check
  const existing = await ctx.session.get(`payment:${input.orderId}`);
  if (existing) {
    return existing;
  }
  
  const transaction = await paymentGateway.charge({
    customerId: input.customerId,
    amount: input.amount,
    currency: 'USD',
    paymentMethod: input.paymentMethod,
    idempotencyKey: `payment:${input.orderId}`
  });
  
  await ctx.session.set(`payment:${input.orderId}`, transaction.id);
  
  return transaction.id;
}

export async function refundPayment(input: { transactionId: string }): Promise<void> {
  const ctx = Context.current();
  ctx.info('Refunding payment', { transactionId: input.transactionId });
  
  await paymentGateway.refund(input.transactionId);
}

export async function sendOrderConfirmation(input: {
  orderId: string;
  customerId: string;
  items: Array<{ productId: string; quantity: number; price: number }>;
  transactionId: string;
}): Promise<void> {
  const ctx = Context.current();
  ctx.info('Sending order confirmation', { orderId: input.orderId });
  
  const customer = await customerService.getById(input.customerId);
  const emailHtml = renderOrderConfirmationEmail({
    customerName: customer.name,
    orderId: input.orderId,
    items: input.items,
    transactionId: input.transactionId
  });
  
  await emailService.send({
    to: customer.email,
    subject: `Order Confirmation - ${input.orderId}`,
    html: emailHtml
  });
}
```

**4. Worker Configuration**

```typescript
// workers/order.worker.ts
import { Worker, NativeConnection } from '@temporalio/worker';
import { InjectedSinks } from '@temporalio/worker/lib//workflow';
import * as activities from '../activities/order.activities';
import { processOrder } from '../workflows/order.workflow';

async function run() {
  const connection = await NativeConnection.connect({
    address: process.env.TEMPORAL_HOST || 'localhost:7233',
    tls: process.env.TEMPORAL_TLS ? {
      serverNameOverride: 'temporal',
      rootCA: process.env.TEMPORAL_TLS_CERT
    } : undefined
  });

  const worker = await Worker.create({
    workflowsPath: require.resolve('../workflows/order.workflow'),
    workflowHttpPort: 7233,
    activities,
    taskQueue: 'order-processing',
    namespace: 'default',
    identity: `${process.pid()}-${require('os').hostname()}`,
    maxConcurrentWorkflowTaskExecutions: 100,
    maxConcurrentActivityTaskExecutions: 50,
    maxConcurrentLocalActivities: 20,
    maxCachedWorkflows: 1000,
    stickyScheduleToStartTimeout: '10s',
    workflowTerminationTimeout: '30s',
    workflowTasks: {
      type: 'local',
    },
    enableSDKInstrumentation: true,
    sinks: {
      exporter: {
        export: async (metrics) => {
          for (const metric of metrics) {
            await prometheusClient.record(metric);
          }
        }
      }
    }
  });

  await worker.run();
}

run().catch((err) => {
  console.error('Worker failed to start', err);
  process.exit(1);
});
```

**5. Client Usage**

```typescript
// clients/order.client.ts
import { Connection, Client } from '@temporalio/client';
import { v4 as uuidv4 } from 'uuid';
import { processOrder, OrderWorkflowInput, OrderWorkflowResult } from '../workflows/order.workflow';

export class OrderWorkflowClient {
  private client: Client;

  constructor() {
    this.client = new Client({
      connection: Connection.connect({
        address: process.env.TEMPORAL_HOST || 'localhost:7233'
      })
    });
  }

  async startOrderWorkflow(input: OrderWorkflowInput): Promise<{ workflowId: string }> {
    const workflowId = `order-${input.orderId}`;
    
    const handle = await this.client.workflow.start(processOrder, {
      taskQueue: 'order-processing',
      workflowId,
      args: [input],
      idempotencyKey: `start-order:${input.orderId}`,
      retry: {
        maximumAttempts: 3,
        initialInterval: '1s'
      }
    });

    return { workflowId: handle.workflowId };
  }

  async getOrderStatus(workflowId: string): Promise<OrderWorkflowResult | undefined> {
    const handle = this.client.workflow.getHandle(workflowId);
    return handle.query(() => ({ status: 'getOrderStatus' } as any));
  }

  async cancelOrder(workflowId: string, reason: string): Promise<void> {
    const handle = this.client.workflow.getHandle(workflowId);
    await handle.signal('cancel', { reason });
  }

  async sendOrderUpdate(workflowId: string, update: any): Promise<void> {
    const handle = this.client.workflow.getHandle(workflowId);
    await handle.signal('update', update);
  }

  // For waiting on long-running workflows
  async waitForCompletion(
    workflowId: string,
    timeoutMs: number = 60000
  ): Promise<OrderWorkflowResult> {
    const handle = this.client.workflow.getHandle(workflowId);
    return handle.result({ timeoutMs });
  }
}
```

**6. Saga Implementation**

```typescript
// workflows/saga/saga.workflow.ts
import { proxyActivities, log } from '@temporalio/workflow';

type ActivityFn = (...args: any[]) => Promise<any>;

interface SagaStep<TInput, TOutput, TCompensation> {
  id: string;
  execute: ActivityFn;
  compensate: ActivityFn;
}

export async function executeSaga<TContext>(
  steps: SagaStep<any, any, any>[],
  context: TContext
): Promise<{ success: boolean; context: TContext; completedSteps: string[]; error?: string }> {
  const completedSteps: Array<{ id: string; result: any }> = [];

  try {
    for (const step of steps) {
      log.info(`Executing saga step: ${step.id}`);
      
      try {
        const result = await step.execute(context);
        completedSteps.push({ id: step.id, result });
        context = { ...context, [step.id]: result };
      } catch (error) {
        log.error(`Saga step ${step.id} failed, initiating compensation`, { error });
        
        // Compensate in reverse order
        for (const completed of [...completedSteps].reverse()) {
          const stepDef = steps.find(s => s.id === completed.id);
          if (stepDef) {
            try {
              log.info(`Compensating step: ${completed.id}`);
              await stepDef.compensate(completed.result);
            } catch (compensationError) {
              log.error(`Compensation failed for step ${completed.id}`, { compensationError });
            }
          }
        }
        
        return {
          success: false,
          context,
          completedSteps: completedSteps.map(s => s.id),
          error: error instanceof Error ? error.message : 'Unknown error'
        };
      }
    }

    return { success: true, context, completedSteps: completedSteps.map(s => s.id) };
  } catch (error) {
    return {
      success: false,
      context,
      completedSteps: completedSteps.map(s => s.id),
      error: error instanceof Error ? error.message : 'Unknown error'
    };
  }
}
```

