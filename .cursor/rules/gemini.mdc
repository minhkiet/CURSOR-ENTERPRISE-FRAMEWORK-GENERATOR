## Anti Pattern

**1. Using Production API for Development**

Hitting production quotas during testing. Higher costs. Unnecessary latency. Separate dev and prod.

**2. Ignoring Safety Blocks**

Assuming safety blocks won't happen. Poor user experience. Brand risk. Handle gracefully.

**3. No Token Budget**

Unlimited prompt lengths. High costs. Poor performance. Always set limits.

**4. Wrong Model Selection**

Using Ultra for simple tasks. Wasted cost. Using Nano for complex tasks. Poor results.

**5. No Caching**

Regenerating same responses. Wasted API calls. Higher costs. Cache strategic responses.

## Best Practice

**1. Vertex AI Client Setup**

```typescript
// lib/gemini.ts
import { VertexAI } from '@google-cloud/vertexai';

const vertexai = new VertexAI({
  project: process.env.GCP_PROJECT_ID!,
  location: 'us-central1',
});

const textModel = vertexai.getGenerativeModel({
  model: 'gemini-1.5-pro',
  systemInstruction: {
    role: 'system',
    parts: [{ text: 'You are a helpful AI assistant.' }],
  },
  generationConfig: {
    maxOutputTokens: 2048,
    temperature: 0.7,
    topP: 0.95,
    topK: 40,
  },
  safetySettings: [
    { category: 'HARM_CATEGORY_HATE_SPEECH', threshold: 'BLOCK_MEDIUM_AND_ABOVE' },
    { category: 'HARM_CATEGORY_DANGEROUS_CONTENT', threshold: 'BLOCK_MEDIUM_AND_ABOVE' },
    { category: 'HARM_CATEGORY_SEXUAL_SEXPLICIT', threshold: 'BLOCK_MEDIUM_AND_ABOVE' },
    { category: 'HARM_CATEGORY_HARASSMENT', threshold: 'BLOCK_MEDIUM_AND_ABOVE' },
  ],
});

const visionModel = vertexai.getGenerativeModel({
  model: 'gemini-1.5-pro-vision',
});

const textModelFlash = vertexai.getGenerativeModel({
  model: 'gemini-1.5-flash',
});
```

**2. Text Generation**

```typescript
// services/gemini-text.service.ts
interface TextGenerationOptions {
  model?: 'gemini-1.5-pro' | 'gemini-1.5-flash';
  temperature?: number;
  maxTokens?: number;
  topP?: number;
  topK?: number;
  stopSequences?: string[];
}

class GeminiTextService {
  async generateText(
    prompt: string,
    options: TextGenerationOptions = {}
  ): Promise<string> {
    const model = options.model === 'gemini-1.5-flash' ? textModelFlash : textModel;
    
    const result = await model.generateContent({
      contents: [{ role: 'user', parts: [{ text: prompt }] }],
      generationConfig: {
        maxOutputTokens: options.maxTokens || 2048,
        temperature: options.temperature || 0.7,
        topP: options.topP || 0.95,
        topK: options.topK || 40,
        stopSequences: options.stopSequences,
      },
    });

    const response = result.response;
    return response.candidates?.[0]?.content?.parts?.[0]?.text || '';
  }

  async generateStreaming(
    prompt: string,
    options: TextGenerationOptions = {},
    onChunk: (chunk: string) => void
  ): Promise<string> {
    const model = options.model === 'gemini-1.5-flash' ? textModelFlash : textModel;
    
    const streamingResult = await model.generateContentStream({
      contents: [{ role: 'user', parts: [{ text: prompt }] }],
      generationConfig: {
        maxOutputTokens: options.maxTokens || 2048,
        temperature: options.temperature || 0.7,
      },
    });

    let fullResponse = '';
    
    for await (const chunk of streamingResult.stream) {
      const text = chunk.candidates?.[0]?.content?.parts?.[0]?.text;
      if (text) {
        fullResponse += text;
        onChunk(text);
      }
    }

    return fullResponse;
  }

  async chat(
    messages: Array<{ role: string; content: string }>,
    systemInstruction?: string
  ): Promise<string> {
    const contents = messages.map(msg => ({
      role: msg.role === 'assistant' ? 'model' : 'user',
      parts: [{ text: msg.content }],
    }));

    const result = await textModel.generateContent({
      contents,
      systemInstruction: systemInstruction ? {
        role: 'system',
        parts: [{ text: systemInstruction }],
      } : undefined,
    });

    return result.response.candidates?.[0]?.content?.parts?.[0]?.text || '';
  }
}
```

**3. Multimodal Generation**

```typescript
// services/gemini-vision.service.ts
interface ImagePart {
  inlineData: {
    mimeType: string;
    data: string; // base64 encoded
  };
}

interface TextPart {
  text: string;
}

class GeminiVisionService {
  async analyzeImage(
    imageData: Buffer,
    mimeType: string = 'image/jpeg',
    prompt?: string
  ): Promise<string> {
    const imagePart: ImagePart = {
      inlineData: {
        mimeType,
        data: imageData.toString('base64'),
      },
    };

    const textPart: TextPart = {
      text: prompt || 'Describe this image in detail.',
    };

    const result = await visionModel.generateContent({
      contents: [{ role: 'user', parts: [imagePart, textPart] }],
    });

    return result.response.candidates?.[0]?.content?.parts?.[0]?.text || '';
  }

  async extractTextFromImage(
    imageData: Buffer,
    mimeType: string = 'image/png'
  ): Promise<string> {
    return this.analyzeImage(
      imageData,
      mimeType,
      'Extract all text from this image. Return only the text, nothing else.'
    );
  }

  async analyzeDocument(
    imageData: Buffer,
    mimeType: string = 'image/png',
    analysisType: 'table' | 'form' | 'mixed' = 'mixed'
  ): Promise<DocumentAnalysis> {
    const prompt = analysisType === 'table'
      ? 'Analyze the table in this image. Return a JSON representation of the table structure and data.'
      : analysisType === 'form'
      ? 'Extract data from this form. Return a JSON object with field names and values.'
      : 'Analyze this document and extract all information. Return structured JSON.';

    const response = await this.analyzeImage(imageData, mimeType, prompt);
    
    // Parse JSON response
    try {
      return JSON.parse(response);
    } catch {
      return { raw: response };
    }
  }

  async compareImages(
    image1: Buffer,
    image2: Buffer,
    mimeType: string = 'image/jpeg'
  ): Promise<string> {
    const prompt = 'Compare these two images. What are the similarities and differences?';
    
    const result = await visionModel.generateContent({
      contents: [{
        role: 'user',
        parts: [
          { inlineData: { mimeType, data: image1.toString('base64') } },
          { inlineData: { mimeType, data: image2.toString('base64') } },
          { text: prompt },
        ],
      }],
    });

    return result.response.candidates?.[0]?.content?.parts?.[0]?.text || '';
  }
}
```

**4. Context Caching**

```typescript
// services/gemini-cache.service.ts
interface CachedContent {
  name: string;
  model: string;
  tokenCount: number;
  createTime: string;
}

class GeminiCacheService {
  async createContextCache(
    content: string,
    model: string = 'gemini-1.5-pro',
    ttlSeconds: number = 3600
  ): Promise<string> {
    const cacheRequest = {
      model: `models/${model}`,
      contents: [{
        role: 'user',
        parts: [{ text: content }],
      }],
      config: {
        cachedContentTTL: `${ttlSeconds}s`,
      },
    };

    // Using Vertex AI Content API
    const response = await fetch(
      `https://${process.env.GCP_LOCATION}-aiplatform.googleapis.com/v1beta1/projects/${process.env.GCP_PROJECT_ID}/locations/${process.env.GCP_LOCATION}/cachedContents`,
      {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${await getAccessToken()}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(cacheRequest),
      }
    );

    const result = await response.json();
    return result.name;
  }

  async useCachedContent(
    cacheName: string,
    additionalPrompt: string
  ): Promise<string> {
    const result = await textModel.generateContent({
      contents: [{ role: 'user', parts: [{ text: additionalPrompt }] }],
      model: `cachedContents/${cacheName}`,
    });

    return result.response.candidates?.[0]?.content?.parts?.[0]?.text || '';
  }

  async listCachedContents(): Promise<CachedContent[]> {
    const response = await fetch(
      `https://${process.env.GCP_LOCATION}-aiplatform.googleapis.com/v1beta1/projects/${process.env.GCP_PROJECT_ID}/locations/${process.env.GCP_LOCATION}/cachedContents`,
      {
        headers: {
          'Authorization': `Bearer ${await getAccessToken()}`,
        },
      }
    );

    const result = await response.json();
    return result.cachedContents || [];
  }

  async deleteCachedContent(cacheName: string): Promise<void> {
    await fetch(
      `https://${process.env.GCP_LOCATION}-aiplatform.googleapis.com/v1beta1/${cacheName}`,
      {
        method: 'DELETE',
        headers: {
          'Authorization': `Bearer ${await getAccessToken()}`,
        },
      }
    );
  }
}
```

**5. Function Calling**

```typescript
// services/gemini-function.service.ts
const functionDeclarations = [
  {
    name: 'get_weather',
    description: 'Get current weather for a location',
    parameters: {
      type: 'object',
      properties: {
        location: {
          type: 'string',
          description: 'City name, e.g. San Francisco, CA',
        },
        unit: {
          type: 'string',
          enum: ['celsius', 'fahrenheit'],
        },
      },
      required: ['location'],
    },
  },
  {
    name: 'search_database',
    description: 'Search the internal database for records',
    parameters: {
      type: 'object',
      properties: {
        query: {
          type: 'string',
          description: 'Search query',
        },
        table: {
          type: 'string',
          enum: ['users', 'orders', 'products'],
        },
        limit: {
          type: 'integer',
          description: 'Maximum results',
          default: 10,
        },
      },
      required: ['query', 'table'],
    },
  },
];

class GeminiFunctionService {
  async chatWithFunctions(
    userMessage: string,
    context: string[]
  ): Promise<string> {
    const model = vertexai.getGenerativeModel({
      model: 'gemini-1.5-pro',
      tools: [{ functionDeclarations }],
    });

    // Initial request
    const chat = model.startChat({
      history: context.map(c => ({
        role: 'user',
        parts: [{ text: c }],
      })),
    });

    const result = await chat.sendMessage(userMessage);
    const response = result.response;
    
    const functionCalls = response.functionCalls();
    
    if (functionCalls) {
      // Execute function calls
      const results = [];
      for (const call of functionCalls) {
        const result = await this.executeFunction(call);
        results.push({
          functionResponse: {
            name: call.name,
            response: result,
          },
        });
      }

      // Send results back
      const finalResult = await chat.sendMessage(results);
      return finalResult.response.text();
    }

    return response.text();
  }

  private async executeFunction(call: any): Promise<any> {
    const { name, args } = call;
    
    switch (name) {
      case 'get_weather':
        return this.getWeather(args.location, args.unit);
      case 'search_database':
        return this.searchDatabase(args.query, args.table, args.limit);
      default:
        throw new Error(`Unknown function: ${name}`);
    }
  }

  private async getWeather(location: string, unit?: string): Promise<any> {
    // Implementation
    return { location, temperature: '22', condition: 'Sunny' };
  }

  private async searchDatabase(
    query: string,
    table: string,
    limit: number
  ): Promise<any> {
    // Implementation
    return { results: [], query, table };
  }
}
```

**6. Batch Processing**

```typescript
// services/gemini-batch.service.ts
interface BatchItem {
  id: string;
  prompt: string;
}

interface BatchResult {
  id: string;
  response: string;
  success: boolean;
  error?: string;
  tokens?: { prompt: number; completion: number };
}

class GeminiBatchService {
  async processBatch(
    items: BatchItem[],
    options: {
      model?: string;
      maxConcurrency?: number;
      onProgress?: (completed: number, total: number) => void;
    } = {}
  ): Promise<BatchResult[]> {
    const {
      maxConcurrency = 5,
      onProgress
    } = options;

    const results: BatchResult[] = [];
    const queue = [...items];
    const executing: Promise<void>[] = [];

    const executeItem = async (item: BatchItem): Promise<BatchResult> => {
      try {
        const service = new GeminiTextService();
        const response = await service.generateText(item.prompt, {
          model: options.model || 'gemini-1.5-flash',
        });

        return {
          id: item.id,
          response,
          success: true,
        };
      } catch (error) {
        return {
          id: item.id,
          response: '',
          success: false,
          error: error instanceof Error ? error.message : 'Unknown error',
        };
      }
    };

    const processNext = async (): Promise<void> => {
      const item = queue.shift();
      if (!item) return;

      const promise = executeItem(item).then(result => {
        results.push(result);
        if (onProgress) {
          onProgress(results.length, items.length);
        }
        return processNext();
      });

      executing.push(promise);
    };

    // Start initial batch
    for (let i = 0; i < Math.min(maxConcurrency, items.length); i++) {
      processNext();
    }

    // Wait for all to complete
    await Promise.all(executing);

    return results.sort((a, b) => 
      items.findIndex(i => i.id === a.id) - items.findIndex(i => i.id === b.id)
    );
  }
}
```

## Workflow

**Phase 1: Setup**

Create Google Cloud project. Enable Vertex AI API. Set up authentication. Configure billing.

**Phase 2: Model Selection**

Evaluate model capabilities. Choose appropriate model. Plan for different use cases. Test models.

**Phase 3: Implementation**

Set up client. Implement basic generation. Add multimodal support. Configure safety settings.

**Phase 4: Optimization**

Implement caching. Add streaming. Optimize prompts. Configure retries.

**Phase 5: Testing**

Test with various inputs. Verify safety settings. Measure latency. Test multimodal scenarios.

**Phase 6: Deployment**

Deploy to production. Set up monitoring. Configure alerts. Document integration.

## Ví dụ

**Ví dụ 1: Document Understanding**

```typescript
async understandDocument(
  documentImage: Buffer,
  query: string
): Promise<DocumentUnderstandingResult> {
  const visionService = new GeminiVisionService();
  
  // Extract text and layout
  const textContent = await visionService.extractTextFromImage(documentImage);
  
  // Analyze structure
  const structure = await visionService.analyzeDocument(
    documentImage,
    'image/png',
    'table'
  );
  
  // Use Gemini to reason about the content
  const reasoning = await textModel.generateContent({
    contents: [{
      role: 'user',
      parts: [{
        text: `Based on this document, answer the following question: ${query}
        
Document text:
${textContent}
        
Document structure:
${JSON.stringify(structure)}`
      }],
    }],
  });

  return {
    text: textContent,
    structure,
    answer: reasoning.response.text(),
  };
}
```

**Ví dụ 2: Code Generation**

```typescript
async generateCode(
  description: string,
  language: string,
  context?: string
): Promise<CodeGenerationResult> {
  const prompt = `Generate ${language} code for the following requirement:

${description}

${context ? `Additional context:\n${context}` : ''}

Requirements:
- Follow best practices for ${language}
- Include error handling
- Add comments for complex logic
- Make code production-ready`;

  const result = await textModel.generateContent({
    contents: [{ role: 'user', parts: [{ text: prompt }] }],
    generationConfig: {
      maxOutputTokens: 4096,
      temperature: 0.3, // Lower temp for more deterministic code
    },
  });

  const code = result.response.candidates?.[0]?.content?.parts?.[0]?.text || '';
  
  // Extract code from markdown if present
  const codeMatch = code.match(/```(?:\w+)?\n([\s\S]*?)```/);
  
  return {
    code: codeMatch ? codeMatch[1] : code,
    explanation: code.replace(/```[\s\S]*?```/g, '').trim(),
    language,
  };
}
```

