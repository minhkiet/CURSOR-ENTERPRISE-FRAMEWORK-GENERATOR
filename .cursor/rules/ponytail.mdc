## Examples

### Before (Over-Built)

```javascript
// utils/datePicker.ts
import Flatpickr from 'flatpickr';
import 'flatpickr/dist/flatpickr.min.css';

export class DatePicker {
  private instance: flatpickr.Instance;
  
  constructor(element: HTMLElement, options?: DatePickerOptions) {
    this.instance = flatpickr(element, {
      dateFormat: 'Y-m-d',
      altInput: true,
      altFormat: 'F j, Y',
      ...options
    });
  }
  
  getValue(): Date | null {
    return this.instance.selectedDates[0] || null;
  }
  
  setValue(date: Date): void {
    this.instance.setDate(date);
  }
  
  destroy(): void {
    this.instance.destroy();
  }
}
```

### After (Ponytail)

```html
<!-- ponytail: browser has one built-in -->
<input type="date" id="datePicker">
```

