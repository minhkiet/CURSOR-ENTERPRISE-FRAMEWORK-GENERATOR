**5. Evaluation Metrics**

```typescript
// services/vector-search-evaluation.service.ts
interface EvaluationMetrics {
  recall: number;
  precision: number;
  f1: number;
  mrr: number;
  ndcg: number;
  latency: {
    p50: number;
    p95: number;
    p99: number;
  };
}

interface SearchEvaluation {
  queryId: string;
  query: string;
  retrieved: string[];
  relevant: string[];
  metrics: EvaluationMetrics;
}

class VectorSearchEvaluation {
  private latencies: number[] = [];

  async evaluate(
    queries: Array<{
      query: string;
      relevantIds: string[];
    }>,
    searchFn: (query: string) => Promise<string[]>
  ): Promise<{
    overall: EvaluationMetrics;
    perQuery: SearchEvaluation[];
  }> {
    const perQuery: SearchEvaluation[] = [];

    for (const q of queries) {
      const start = Date.now();
      const retrieved = await searchFn(q.query);
      const latency = Date.now() - start;
      this.latencies.push(latency);

      const metrics = this.calculateMetrics(retrieved, q.relevantIds);

      perQuery.push({
        queryId: q.query,
        query: q.query,
        retrieved,
        relevant: q.relevantIds,
        metrics,
      });
    }

    const overall = this.aggregateMetrics(perQuery.map(p => p.metrics));

    return { overall, perQuery };
  }

  private calculateMetrics(
    retrieved: string[],
    relevant: string[]
  ): Omit<EvaluationMetrics, 'latency'> {
    if (relevant.length === 0) {
      return { recall: 0, precision: 0, f1: 0, mrr: 0, ndcg: 0 };
    }

    const relevantSet = new Set(relevant);
    const relevantRetrieved = retrieved.filter(id => relevantSet.has(id));

    const precision = relevantRetrieved.length / retrieved.length;
    const recall = relevantRetrieved.length / relevant.length;
    const f1 = 2 * (precision * recall) / (precision + recall);

    // MRR
    let mrr = 0;
    for (let i = 0; i < retrieved.length; i++) {
      if (relevantSet.has(retrieved[i])) {
        mrr = 1 / (i + 1);
        break;
      }
    }

    // NDCG
    let dcg = 0;
    let idcg = 0;
    for (let i = 0; i < retrieved.length; i++) {
      const relevance = relevantSet.has(retrieved[i]) ? 1 : 0;
      dcg += relevance / Math.log2(i + 2);
    }
    for (let i = 0; i < relevant.length; i++) {
      idcg += 1 / Math.log2(i + 2);
    }
    const ndcg = idcg > 0 ? dcg / idcg : 0;

    return { precision, recall, f1, mrr, ndcg };
  }

  private aggregateMetrics(
    metrics: Array<Omit<EvaluationMetrics, 'latency'>>
  ): EvaluationMetrics {
    const count = metrics.length;
    
    return {
      recall: metrics.reduce((s, m) => s + m.recall, 0) / count,
      precision: metrics.reduce((s, m) => s + m.precision, 0) / count,
      f1: metrics.reduce((s, m) => s + m.f1, 0) / count,
      mrr: metrics.reduce((s, m) => s + m.mrr, 0) / count,
      ndcg: metrics.reduce((s, m) => s + m.ndcg, 0) / count,
      latency: this.calculateLatencyMetrics(),
    };
  }

  private calculateLatencyMetrics(): { p50: number; p95: number; p99: number } {
    const sorted = [...this.latencies].sort((a, b) => a - b);
    
    return {
      p50: sorted[Math.floor(sorted.length * 0.5)] || 0,
      p95: sorted[Math.floor(sorted.length * 0.95)] || 0,
      p99: sorted[Math.floor(sorted.length * 0.99)] || 0,
    };
  }
}
```

## Workflow

**Phase 1: Planning**

Choose embedding model. Select vector database. Define data schema. Plan indexing strategy.

**Phase 2: Implementation**

Set up vector database. Implement embedding pipeline. Create search service. Add filtering.

**Phase 3: Optimization**

Configure indexes. Add reranking. Implement hybrid search. Optimize queries.

**Phase 4: Evaluation**

Create test set. Measure metrics. Compare strategies. Iterate.

**Phase 5: Scaling**

Plan for growth. Implement batching. Configure sharding. Monitor costs.

**Phase 6: Maintenance**

Monitor quality. Update embeddings. Refresh indexes. Handle deletions.

