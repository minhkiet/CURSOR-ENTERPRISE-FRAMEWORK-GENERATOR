## Anti Pattern

**1. Wrong Distance Metric**

Using cosine for non-normalized vectors. Using L2 for recommendation. Inconsistent with embedding model.

**2. No Index Optimization**

Scanning entire database. Poor performance. High latency. Wasted resources.

**3. Ignoring Recall**

Optimizing only for speed. Missing relevant results. Poor user experience. Low recall.

**4. Static Embeddings**

No updates. Outdated content. Inconsistent with source. Misleading results.

**5. No Evaluation**

Assuming quality. No measurement. No improvement. User complaints. Poor results.

## Best Practice

**1. Embedding Generation**

```typescript
// services/embedding.service.ts
import OpenAI from 'openai';
import { CohereClient } from 'cohere-ai';

interface EmbeddingConfig {
  provider: 'openai' | 'cohere' | 'huggingface';
  model: string;
  dimensions?: number;
  normalize?: boolean;
}

class EmbeddingService {
  private openai: OpenAI;
  private cohere: CohereClient;
  private config: EmbeddingConfig;

  constructor(config: EmbeddingConfig) {
    this.config = config;
    this.openai = new OpenAI();
    this.cohere = new CohereClient();
  }

  async createEmbedding(
    text: string,
    options?: { normalize?: boolean }
  ): Promise<number[]> {
    switch (this.config.provider) {
      case 'openai':
        return this.createOpenAIEmbedding(text, options);
      case 'cohere':
        return this.createCohereEmbedding(text, options);
      default:
        return this.createOpenAIEmbedding(text, options);
    }
  }

  private async createOpenAIEmbedding(
    text: string,
    options?: { normalize?: boolean }
  ): Promise<number[]> {
    const response = await this.openai.embeddings.create({
      model: this.config.model || 'text-embedding-3-small',
      input: text,
      ...(this.config.dimensions && { dimensions: this.config.dimensions }),
      encoding_format: 'float',
    });

    let embedding = response.data[0].embedding;

    if (options?.normalize || this.config.normalize) {
      embedding = this.normalizeVector(embedding);
    }

    return embedding;
  }

  private async createCohereEmbedding(
    text: string,
    options?: { normalize?: boolean }
  ): Promise<number[]> {
    const response = await this.cohere.embed({
      texts: [text],
      model: this.config.model || 'embed-english-v3.0',
      inputType: 'search_document',
    });

    let embedding = response.embeddings[0];

    if (options?.normalize || this.config.normalize) {
      embedding = this.normalizeVector(embedding);
    }

    return embedding;
  }

  private normalizeVector(vector: number[]): number[] {
    const magnitude = Math.sqrt(
      vector.reduce((sum, val) => sum + val * val, 0)
    );
    return vector.map(val => val / magnitude);
  }

  async createBatchEmbeddings(
    texts: string[],
    batchSize: number = 100
  ): Promise<number[][]> {
    const results: number[][] = [];

    for (let i = 0; i < texts.length; i += batchSize) {
      const batch = texts.slice(i, i + batchSize);
      const batchResults = await this.createOpenAIEmbedding(batch.join('\n'));
      results.push(batchResults);
    }

    return results;
  }
}
```

**2. Vector Storage với pgvector**

```typescript
// services/pgvector.service.ts
import { pool } from '@/lib/database';

interface VectorRecord {
  id: string;
  embedding: number[];
  content: string;
  metadata?: Record<string, any>;
}

class PGVectorService {
  async createTable(): Promise<void> {
    await pool.query(`
      CREATE EXTENSION IF NOT EXISTS vector;
      
      CREATE TABLE IF NOT EXISTS documents (
        id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
        content TEXT NOT NULL,
        embedding vector(1536),
        metadata JSONB DEFAULT '{}',
        created_at TIMESTAMPTZ DEFAULT NOW(),
        updated_at TIMESTAMPTZ DEFAULT NOW()
      );
      
      CREATE INDEX IF NOT EXISTS idx_documents_embedding_hnsw 
        ON documents USING hnsw (embedding vector_cosine_ops)
        WITH (m = 16, ef_construction = 64);
      
      CREATE INDEX IF NOT EXISTS idx_documents_metadata 
        ON documents USING gin (metadata);
    `);
  }

  async insertDocuments(records: VectorRecord[]): Promise<void> {
    const values = records.map((r, i) => {
      const offset = i * 3;
      return `($${offset + 1}::UUID, $${offset + 2}::TEXT, $${offset + 3}::vector, $${offset + 4}::JSONB)`;
    }).join(', ');

    const params = records.flatMap(r => [
      r.id,
      r.content,
      r.embedding,
      JSON.stringify(r.metadata || {})
    ]);

    await pool.query(`
      INSERT INTO documents (id, content, embedding, metadata)
      VALUES ${values}
      ON CONFLICT (id) DO UPDATE SET
        content = EXCLUDED.content,
        embedding = EXCLUDED.embedding,
        metadata = EXCLUDED.metadata,
        updated_at = NOW()
    `, params);
  }

  async search(
    queryEmbedding: number[],
    options: {
      limit?: number;
      threshold?: number;
      filter?: Record<string, any>;
    } = {}
  ): Promise<Array<{ id: string; content: string; score: number; metadata: any }>> {
    const { limit = 10, threshold = 0.7, filter } = options;

    let query = `
      SELECT 
        id,
        content,
        1 - (embedding <=> $1::vector) AS similarity,
        metadata
      FROM documents
      WHERE 1 - (embedding <=> $1::vector) >= $2
    `;

    const params: any[] = [queryEmbedding, threshold];

    if (filter) {
      Object.entries(filter).forEach(([key, value], index) => {
        query += ` AND metadata->>'${key}' = $${index + 3}`;
        params.push(value);
      });
    }

    query += `
      ORDER BY embedding <=> $1::vector
      LIMIT $${params.length + 1}
    `;
    params.push(limit);

    const result = await pool.query(query, params);

    return result.rows.map(row => ({
      id: row.id,
      content: row.content,
      score: parseFloat(row.similarity),
      metadata: row.metadata,
    }));
  }

  async searchWithReranking(
    queryEmbedding: number[],
    options: {
      initialLimit?: number;
      finalLimit?: number;
      filter?: Record<string, any>;
    } = {}
  ): Promise<Array<{ id: string; content: string; score: number; metadata: any }>> {
    const { initialLimit = 50, finalLimit = 10, filter } = options;

    // Initial vector search - get more results for reranking
    const results = await this.search(queryEmbedding, {
      limit: initialLimit,
      threshold: 0.0, // No threshold for reranking
      filter,
    });

    if (results.length <= finalLimit) {
      return results;
    }

    // Rerank using cross-encoder (simplified - use actual cross-encoder in production)
    const reranked = await this.rerankResults(results, queryEmbedding);

    return reranked.slice(0, finalLimit);
  }

  private async rerankResults(
    results: Array<{ id: string; content: string; score: number; metadata: any }>,
    queryEmbedding: number[]
  ): Promise<Array<{ id: string; content: string; score: number; metadata: any }>> {
    // Simplified reranking - combine vector similarity with content scoring
    // In production, use a proper cross-encoder model
    
    return results
      .map(r => {
        // Simple rerank: combine vector score with content length bonus
        const contentScore = Math.min(r.content.length / 1000, 1);
        const finalScore = r.score * 0.7 + contentScore * 0.3;
        return { ...r, score: finalScore };
      })
      .sort((a, b) => b.score - a.score);
  }

  async deleteByFilter(filter: Record<string, any>): Promise<number> {
    const conditions = Object.entries(filter)
      .map(([key, value], i) => `metadata->>'${key}' = $${i + 1}`)
      .join(' AND ');

    const params = Object.values(filter);

    const result = await pool.query(`
      DELETE FROM documents
      WHERE ${conditions}
    `, params);

    return result.rowCount || 0;
  }
}
```

**3. Pinecone Integration**

```typescript
// services/pinecone.service.ts
import { Pinecone } from '@pinecone-database/pinecone';

interface PineconeRecord {
  id: string;
  values: number[];
  metadata?: Record<string, any>;
}

interface SearchResult {
  id: string;
  score: number;
  metadata: Record<string, any>;
}

class PineconeService {
  private pinecone: Pinecone;
  private index: any;
  private indexName: string;

  constructor() {
    this.pinecone = new Pinecone({
      apiKey: process.env.PINECONE_API_KEY!,
    });
    this.indexName = process.env.PINECONE_INDEX || 'default';
  }

  async initialize(): Promise<void> {
    // Create index if not exists
    const indexes = await this.pinecone.listIndexes();
    const exists = indexes.indexes?.some(i => i.name === this.indexName);

    if (!exists) {
      await this.pinecone.createIndex({
        name: this.indexName,
        dimension: 1536,
        metric: 'cosine',
        spec: {
          serverless: {
            cloud: 'aws',
            region: 'us-east-1',
          },
        },
      });

      // Wait for index to be ready
      await this.waitForIndex();
    }

    this.index = this.pinecone.Index(this.indexName);
  }

  private async waitForIndex(timeout: number = 60000): Promise<void> {
    const start = Date.now();
    while (Date.now() - start < timeout) {
      const description = await this.pinecone.describeIndex(this.indexName);
      if (description.status?.ready) {
        return;
      }
      await sleep(1000);
    }
    throw new Error('Index creation timeout');
  }

  async upsert(records: PineconeRecord[]): Promise<void> {
    // Pinecone recommends upserting in batches of 1000
    const batchSize = 1000;
    
    for (let i = 0; i < records.length; i += batchSize) {
      const batch = records.slice(i, i + batchSize);
      await this.index.upsert(batch);
    }
  }

  async search(
    queryVector: number[],
    options: {
      topK?: number;
      filter?: Record<string, any>;
      includeMetadata?: boolean;
    } = {}
  ): Promise<SearchResult[]> {
    const { topK = 10, filter, includeMetadata = true } = options;

    const queryResponse = await this.index.query({
      vector: queryVector,
      topK,
      filter,
      includeMetadata,
      includeValues: false,
    });

    return (queryResponse.matches || []).map(match => ({
      id: match.id,
      score: match.score || 0,
      metadata: match.metadata || {},
    }));
  }

  async searchBatch(
    queries: number[][],
    options: {
      topK?: number;
      filter?: Record<string, any>;
    } = {}
  ): Promise<SearchResult[][]> {
    const { topK = 10, filter } = options;

    const queryResponse = await this.index.query({
      vector: queries[0], // Pinecone batch query API
      topK,
      filter,
      includeMetadata: true,
    });

    // Return same results for all queries (simplified)
    return queries.map(() => 
      (queryResponse.matches || []).map(match => ({
        id: match.id,
        score: match.score || 0,
        metadata: match.metadata || {},
      }))
    );
  }

  async deleteById(ids: string[]): Promise<void> {
    await this.index.deleteMany(ids);
  }

  async deleteByFilter(filter: Record<string, any>): Promise<void> {
    await this.index.deleteMany({ filter });
  }

  async describeIndexStats(): Promise<{
    totalRecords: number;
    dimension: number;
    indexFullness: number;
  }> {
    const stats = await this.index.describeIndexStats();
    
    return {
      totalRecords: stats.totalRecordCount || 0,
      dimension: stats.dimension || 0,
      indexFullness: stats.indexFullness || 0,
    };
  }
}
