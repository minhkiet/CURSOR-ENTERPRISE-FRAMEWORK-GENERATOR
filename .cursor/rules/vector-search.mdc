**4. Hybrid Search**

```typescript
// services/hybrid-search.service.ts
interface HybridSearchOptions {
  query: string;
  queryEmbedding: number[];
  vectorWeight?: number;
  keywordWeight?: number;
  limit?: number;
  filters?: Record<string, any>;
}

interface HybridSearchResult {
  id: string;
  content: string;
  score: number;
  vectorScore: number;
  keywordScore: number;
  metadata: Record<string, any>;
}

class HybridSearchService {
  constructor(
    private vectorStore: PGVectorService | PineconeService,
    private keywordIndex: KeywordSearchService
  ) {}

  async search(options: HybridSearchOptions): Promise<HybridSearchResult[]> {
    const {
      query,
      queryEmbedding,
      vectorWeight = 0.7,
      keywordWeight = 0.3,
      limit = 10,
      filters
    } = options;

    // Run searches in parallel
    const [vectorResults, keywordResults] = await Promise.all([
      this.vectorStore.search(queryEmbedding, { limit: limit * 2, filter }),
      this.keywordIndex.search(query, { limit: limit * 2, filters }),
    ]);

    // Create score maps
    const vectorScores = new Map(
      vectorResults.map(r => [r.id, r.score])
    );

    const keywordScores = new Map(
      keywordResults.map(r => [r.id, r.score])
    );

    // Get all unique IDs
    const allIds = new Set([
      ...vectorResults.map(r => r.id),
      ...keywordResults.map(r => r.id),
    ]);

    // Calculate combined scores
    const combinedResults: HybridSearchResult[] = [];

    for (const id of allIds) {
      const vectorScore = vectorScores.get(id) || 0;
      const keywordScore = keywordScores.get(id) || 0;

      // Normalize scores to 0-1 range if needed
      const normalizedVector = vectorScore;
      const normalizedKeyword = keywordScore / (keywordResults[0]?.score || 1);

      // Weighted combination
      const combinedScore = 
        normalizedVector * vectorWeight + 
        normalizedKeyword * keywordWeight;

      // Get content from either result
      const vectorResult = vectorResults.find(r => r.id === id);
      const keywordResult = keywordResults.find(r => r.id === id);

      combinedResults.push({
        id,
        content: vectorResult?.content || keywordResult?.content || '',
        score: combinedScore,
        vectorScore: normalizedVector,
        keywordScore: normalizedKeyword,
        metadata: vectorResult?.metadata || keywordResult?.metadata || {},
      });
    }

    // Sort by combined score and return top results
    return combinedResults
      .sort((a, b) => b.score - a.score)
      .slice(0, limit);
  }

  // Late fusion using Reciprocal Rank Fusion
  async searchRRF(
    options: HybridSearchOptions
  ): Promise<HybridSearchResult[]> {
    const { query, queryEmbedding, limit = 10, filters } = options;

    const [vectorResults, keywordResults] = await Promise.all([
      this.vectorStore.search(queryEmbedding, { limit: limit * 2, filter: filters }),
      this.keywordIndex.search(query, { limit: limit * 2, filters }),
    ]);

    // Reciprocal Rank Fusion
    const rrfScores = new Map<string, number>();
    const k = 60; // RRF parameter

    vectorResults.forEach((r, i) => {
      const current = rrfScores.get(r.id) || 0;
      rrfScores.set(r.id, current + 1 / (k + i + 1));
    });

    keywordResults.forEach((r, i) => {
      const current = rrfScores.get(r.id) || 0;
      rrfScores.set(r.id, current + 1 / (k + i + 1));
    });

    // Combine with vector and keyword scores
    const vectorScores = new Map(vectorResults.map(r => [r.id, r.score]));
    const keywordScores = new Map(keywordResults.map(r => [r.id, r.score]));

    const results: HybridSearchResult[] = [];

    for (const [id, rrfScore] of rrfScores) {
      const vectorResult = vectorResults.find(r => r.id === id);
      const keywordResult = keywordResults.find(r => r.id === id);

      results.push({
        id,
        content: vectorResult?.content || keywordResult?.content || '',
        score: rrfScore,
        vectorScore: vectorScores.get(id) || 0,
        keywordScore: keywordScores.get(id) || 0,
        metadata: vectorResult?.metadata || keywordResult?.metadata || {},
      });
    }

    return results
      .sort((a, b) => b.score - a.score)
      .slice(0, limit);
  }
}
