**Ví dụ 3: Deployment Verification Checks**

```typescript
// Automated deployment verification
class DeploymentVerifier {
  constructor(
    private k8sClient: KubernetesClient,
    private metricsClient: MetricsClient
  ) {}
  
  async verifyDeployment(
    deploymentName: string,
    namespace: string
  ): Promise<VerificationResult> {
    const checks: Check[] = [];
    
    // Check 1: All replicas are ready
    checks.push(await this.checkReplicaCount(deploymentName, namespace));
    
    // Check 2: No pod restarts
    checks.push(await this.checkPodRestarts(deploymentName, namespace));
    
    // Check 3: Health endpoints respond
    checks.push(await this.checkHealthEndpoints(deploymentName, namespace));
    
    // Check 4: Error rate is normal
    checks.push(await this.checkErrorRate(deploymentName));
    
    // Check 5: Latency is acceptable
    checks.push(await this.checkLatency(deploymentName));
    
    // Check 6: All pods are scheduled
    checks.push(await this.checkPodScheduling(deploymentName, namespace));
    
    return {
      passed: checks.every(c => c.passed),
      checks,
      timestamp: new Date()
    };
  }
  
  private async checkReplicaCount(
    name: string,
    namespace: string
  ): Promise<Check> {
    const deployment = await this.k8sClient.appsV1.readNamespacedDeployment(
      name,
      namespace
    );
    
    const ready = deployment.status?.readyReplicas || 0;
    const desired = deployment.spec?.replicas || 0;
    
    return {
      name: 'Replica Count',
      passed: ready === desired,
      message: `${ready}/${desired} replicas ready`,
      severity: 'critical'
    };
  }
  
  private async checkErrorRate(deploymentName: string): Promise<Check> {
    const metrics = await this.metricsClient.query({
      metric: 'http_requests_total',
      filters: {
        deployment: deploymentName,
        status: '5xx'
      },
      aggregation: 'rate',
      window: '5m'
    });
    
    const errorRate = metrics.value;
    const threshold = 0.01; // 1%
    
    return {
      name: 'Error Rate',
      passed: errorRate < threshold,
      message: `Error rate: ${(errorRate * 100).toFixed(2)}%`,
      severity: 'critical'
    };
  }
}
```

