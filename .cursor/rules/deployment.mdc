**2. Deployment Pipeline**

```yaml
# GitHub Actions deployment pipeline
name: Deploy to Production

on:
  push:
    branches: [main]

env:
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      
      - name: Install dependencies
        run: npm ci
      
      - name: Run tests
        run: npm test
      
      - name: Run linting
        run: npm run lint
      
      - name: Security audit
        run: npm audit --audit-level=high
  
  build:
    needs: test
    runs-on: ubuntu-latest
    outputs:
      image-tag: ${{ steps.meta.outputs.tags }}
    
    steps:
      - uses: actions/checkout@v4
      
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3
      
      - name: Log in to Container Registry
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      
      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}
          tags: |
            type=sha,prefix=
            type=ref,event=branch
            type=semver,pattern={{version}}
      
      - name: Build and push
        uses: docker/build-push-action@v5
        with:
          context: .
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
  
  deploy-staging:
    needs: build
    runs-on: ubuntu-latest
    environment: staging
    
    steps:
      - uses: actions/checkout@v4
      
      - name: Deploy to staging
        run: |
          helm upgrade --install order-service ./deploy/helm \
            --namespace staging \
            --set image.tag=${{ needs.build.outputs.image-tag }} \
            --values ./deploy/helm/values-staging.yaml \
            --wait --timeout 5m
      
      - name: Run smoke tests
        run: |
          npm run test:smoke -- --env=staging
  
  deploy-production:
    needs: deploy-staging
    runs-on: ubuntu-latest
    environment: production
    
    steps:
      - uses: actions/checkout@v4
      
      - name: Deploy to production (Blue-Green)
        run: |
          # Deploy to green environment
          helm upgrade --install order-service-green ./deploy/helm \
            --namespace production \
            --set image.tag=${{ needs.build.outputs.image-tag }} \
            --values ./deploy/helm/values-production.yaml \
            --wait --timeout 10m
          
          # Wait for health checks
          kubectl rollout status deployment/order-service-green -n production
          
          # Switch traffic (blue-green switch)
          kubectl patch service order-service \
            -n production \
            -p '{"spec":{"selector":{"version":"green"}}}'
          
          # Scale down blue
          kubectl scale deployment/order-service-blue \
            --replicas=0 -n production
      
      - name: Verify deployment
        run: |
          curl -f https://api.example.com/health || exit 1
      
      - name: Notify success
        if: success()
        run: |
          echo "Deployment successful" | slack-notify
```

**3. Database Migration Strategy**

```typescript
// Migration runner with rollback support
class MigrationRunner {
  constructor(
    private db: Database,
    private logger: Logger
  ) {}
  
  async runPendingMigrations(): Promise<MigrationResult> {
    const applied = await this.getAppliedMigrations();
    const pending = await this.getPendingMigrations(applied);
    
    const results: MigrationResult[] = [];
    
    for (const migration of pending) {
      const result = await this.runMigration(migration);
      results.push(result);
      
      if (!result.success) {
        // Stop on first failure
        await this.handleMigrationFailure(migration, results);
        break;
      }
    }
    
    return this.summarizeResults(results);
  }
  
  private async runMigration(
    migration: Migration
  ): Promise<MigrationResult> {
    this.logger.info(`Running migration: ${migration.name}`);
    
    const startTime = Date.now();
    
    try {
      await this.db.transaction(async (tx) => {
        // Record migration start
        await tx.execute(`
          INSERT INTO schema_migrations (name, started_at)
          VALUES (?, NOW())
        `, [migration.name]);
        
        // Run up migration
        await migration.up(tx);
        
        // Mark as completed
        await tx.execute(`
          UPDATE schema_migrations
          SET completed_at = NOW()
          WHERE name = ?
        `, [migration.name]);
      });
      
      return {
        name: migration.name,
        success: true,
        duration: Date.now() - startTime
      };
    } catch (error) {
      return {
        name: migration.name,
        success: false,
        error: error.message,
        duration: Date.now() - startTime
      };
    }
  }
  
  async rollback(migrationName: string): Promise<void> {
    const migration = await this.getMigration(migrationName);
    
    if (!migration) {
      throw new Error(`Migration ${migrationName} not found`);
    }
    
    if (!migration.completedAt) {
      throw new Error(`Migration ${migrationName} not completed`);
    }
    
    await this.db.transaction(async (tx) => {
      await migration.down(tx);
      
      await tx.execute(`
        DELETE FROM schema_migrations WHERE name = ?
      `, [migrationName]);
    });
  }
}

// Example migration
export class AddOrdersTable20240115 implements Migration {
  name = '20240115_add_orders_table';
  
  async up(tx: Transaction): Promise<void> {
    await tx.execute(`
      CREATE TABLE orders (
        id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
        customer_id UUID NOT NULL REFERENCES customers(id),
        status VARCHAR(50) NOT NULL DEFAULT 'pending',
        total DECIMAL(10, 2) NOT NULL,
        shipping_address JSONB NOT NULL,
        created_at TIMESTAMP DEFAULT NOW(),
        updated_at TIMESTAMP DEFAULT NOW()
      )
    `);
    
    await tx.execute(`
      CREATE INDEX idx_orders_customer_id ON orders(customer_id)
    `);
    
    await tx.execute(`
      CREATE INDEX idx_orders_status ON orders(status)
    `);
  }
  
  async down(tx: Transaction): Promise<void> {
    await tx.execute(`DROP TABLE orders CASCADE`);
  }
}
```

**4. Blue-Green Deployment Script**

```bash
#!/bin/bash
# deploy-blue-green.sh

set -euo pipefail

DEPLOYMENT_NAME="order-service"
NAMESPACE="production"
BLUE_DEPLOYMENT="${DEPLOYMENT_NAME}-blue"
GREEN_DEPLOYMENT="${DEPLOYMENT_NAME}-green"
SERVICE_NAME="${DEPLOYMENT_NAME}"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() {
    echo -e "${GREEN}[$(date +'%Y-%m-%d %H:%M:%S')]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[$(date +'%Y-%m-%d %H:%M:%S')] WARNING:${NC} $1"
}

error() {
    echo -e "${RED}[$(date +'%Y-%m-%d %H:%M:%S')] ERROR:${NC} $1"
}

# Check prerequisites
check_prerequisites() {
    log "Checking prerequisites..."
    
    command -v kubectl >/dev/null 2>&1 || { error "kubectl is required"; exit 1; }
    command -v helm >/dev/null 2>&1 || { error "helm is required"; exit 1; }
    
    kubectl can-i create deployment -n "$NAMESPACE" || { error "Insufficient permissions"; exit 1; }
}

# Get current active deployment
get_active_deployment() {
    kubectl get service "$SERVICE_NAME" -n "$NAMESPACE" \
        -o jsonpath='{.spec.selector.version}' 2>/dev/null || echo "blue"
}

# Deploy to inactive environment
deploy_to_environment() {
    local target_env=$1
    local image_tag=$2
    
    log "Deploying to ${target_env} environment with image tag ${image_tag}..."
    
    helm upgrade --install "${DEPLOYMENT_NAME}-${target_env}" ./deploy/helm \
        --namespace "$NAMESPACE" \
        --set image.tag="$image_tag" \
        --set replicaCount=2 \
        --set nameOverride="${DEPLOYMENT_NAME}-${target_env}" \
        --values ./deploy/helm/values-production.yaml \
        --wait --timeout 10m
    
    log "Waiting for rollout..."
    kubectl rollout status "deployment/${DEPLOYMENT_NAME}-${target_env}" -n "$NAMESPACE"
}

# Run smoke tests
run_smoke_tests() {
    local target_env=$1
    
    log "Running smoke tests against ${target_env}..."
    
    local endpoint=$(kubectl get ingress "${DEPLOYMENT_NAME}-${target_env}" \
        -n "$NAMESPACE" -o jsonpath='{.spec.rules[0].host}')
    
    if ! curl -sf "https://${endpoint}/health"; then
        error "Smoke tests failed for ${target_env}"
        return 1
    fi
    
    log "Smoke tests passed"
}

# Switch traffic
switch_traffic() {
    local from_env=$1
    local to_env=$2
    
    log "Switching traffic from ${from_env} to ${to_env}..."
    
    kubectl patch service "$SERVICE_NAME" -n "$NAMESPACE" \
        -p "{\"spec\":{\"selector\":{\"version\":\"${to_env}\"}}}"
    
    sleep 5
    
    log "Traffic switched"
}

# Main deployment process
main() {
    local image_tag="${1:-latest}"
    
    check_prerequisites
    
    local active_env=$(get_active_deployment)
    local inactive_env=$([[ "$active_env" == "blue" ]] && echo "green" || echo "blue")
    
    log "Current active environment: ${active_env}"
    log "Deploying to inactive environment: ${inactive_env}"
    
    # Deploy to inactive environment
    deploy_to_environment "$inactive_env" "$image_tag"
    
    # Run smoke tests
    if ! run_smoke_tests "$inactive_env"; then
        error "Smoke tests failed. Rolling back deployment."
        kubectl delete deployment "${DEPLOYMENT_NAME}-${inactive_env}" -n "$NAMESPACE"
        exit 1
    fi
    
    # Switch traffic
    switch_traffic "$active_env" "$inactive_env"
    
    # Scale down old environment (keep 0 replicas for instant rollback)
    log "Scaling down ${active_env} environment..."
    kubectl scale deployment "${DEPLOYMENT_NAME}-${active_env}" --replicas=0 -n "$NAMESPACE"
    
    log "Deployment completed successfully!"
    log "Previous version: ${active_env}"
    log "Current version: ${inactive_env}"
    
    # Rollback instructions
    echo ""
    echo "To rollback:"
    echo "  kubectl patch service ${SERVICE_NAME} -n ${NAMESPACE} -p '{\"spec\":{\"selector\":{\"version\":\"${active_env}\"}}}'"
    echo "  kubectl scale deployment ${DEPLOYMENT_NAME}-${inactive_env} --replicas=0 -n ${NAMESPACE}"
    echo "  kubectl scale deployment ${DEPLOYMENT_NAME}-${active_env} --replicas=2 -n ${NAMESPACE}"
}

main "$@"
```

**5. Feature Flag Deployment**

```typescript
// Feature flag management for deployments
interface FeatureFlagConfig {
  flags: Record<string, FeatureFlag>;
  rolloutPercentage: Record<string, number>;
  userOverrides: Record<string, boolean>;
}

interface FeatureFlag {
  enabled: boolean;
  rolloutPercentage: number;
  conditions?: FlagCondition[];
}

class FeatureFlagService {
  constructor(
    private config: FeatureFlagConfig,
    private userRepository: UserRepository,
    private analytics: AnalyticsService
  ) {}
  
  async isEnabled(
    flagName: string,
    context: FlagContext
  ): Promise<boolean> {
    const flag = this.config.flags[flagName];
    
    if (!flag) {
      return false;
    }
    
    // Check user override
    if (context.userId && this.config.userOverrides[`${flagName}:${context.userId}`] !== undefined) {
      return this.config.userOverrides[`${flagName}:${context.userId}`];
    }
    
    // Check conditions
    if (flag.conditions) {
      const allConditionsMet = flag.conditions.every(
        condition => this.evaluateCondition(condition, context)
      );
      
      if (!allConditionsMet) {
        return false;
      }
    }
    
    // Check rollout percentage
    if (flag.enabled && flag.rolloutPercentage < 100) {
      const shouldRollout = this.shouldRollout(
        flagName,
        context.userId || context.sessionId
      );
      
      // Track feature flag exposure
      this.analytics.track('feature_flag_exposure', {
        flag: flagName,
        enabled: shouldRollout,
        percentage: flag.rolloutPercentage
      });
      
      return shouldRollout;
    }
    
    return flag.enabled;
  }
  
  private shouldRollout(flagName: string, identifier: string): boolean {
    // Consistent hashing for same user always gets same result
    const hash = this.hash(`${flagName}:${identifier}`);
    const bucket = hash % 100;
    
    return bucket < this.config.flags[flagName].rolloutPercentage;
  }
  
  async enableForUser(flagName: string, userId: string): Promise<void> {
    this.config.userOverrides[`${flagName}:${userId}`] = true;
    await this.persistOverride(flagName, userId, true);
  }
}

// Middleware for feature flag access
function featureFlagMiddleware(
  flagName: string,
  handler: RequestHandler
): RequestHandler {
  return async (req, res, next) => {
    const isEnabled = await featureFlagService.isEnabled(flagName, {
      userId: req.user?.id,
      sessionId: req.sessionId,
      ip: req.ip,
      userAgent: req.headers['user-agent']
    });
    
    if (!isEnabled) {
      return res.status(404).json({
        error: 'Not found',
        message: 'This feature is not available'
      });
    }
    
    next();
  };
}

// Usage in routes
app.post('/api/new-checkout',
  featureFlagMiddleware('new-checkout-flow'),
  checkoutController.process
);
```

## Workflow

**Phase 1: Pre-Deployment**

Code review completed. All tests passing. Security review done. Stakeholder approval. Rollback plan prepared. Monitoring alerts configured.

**Phase 2: Build**

Compile code. Run tests. Build artifacts. Security scan. Container build. Push to registry.

**Phase 3: Deploy to Staging**

Deploy to staging environment. Run integration tests. Run smoke tests. Performance tests. Security tests.

**Phase 4: Production Deployment**

Deploy to production. Blue-green or canary strategy. Monitor metrics. Watch for errors. Alert on anomalies.

**Phase 5: Post-Deployment**

Verify deployment. Update documentation. Notify stakeholders. Monitor for 24 hours. Document lessons learned.

**Phase 6: Rollback (if needed)**

Detect issue. Execute rollback. Verify rollback. Post-mortem. Fix issues. Redeploy.

