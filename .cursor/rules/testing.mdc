**5. Performance Testing**

```typescript
// Performance testing with k6
import http from 'k6/http';
import { check, sleep } from 'k6';

export const options = {
  stages: [
    { duration: '2m', target: 100 },  // Ramp up
    { duration: '5m', target: 100 },  // Steady state
    { duration: '2m', target: 200 },  // Spike
    { duration: '5m', target: 200 },  // Steady state at spike
    { duration: '2m', target: 0 }    // Ramp down
  ],
  thresholds: {
    http_req_duration: ['p(95)<500'],  // 95% under 500ms
    http_req_failed: ['rate<0.01'],    // Error rate < 1%
    'group_duration': ['p(95)<300']
  }
};

const BASE_URL = __ENV.BASE_URL || 'https://api.example.com';

export default function () {
  constScenarios = [
    { name: 'Browse Products', weight: 40 },
    { name: 'Add to Cart', weight: 20 },
    { name: 'Checkout', weight: 10 },
    { name: 'View Order', weight: 20 },
    { name: 'Search', weight: 10 }
  ];
  
  const scenario = weightedRandom(scenarios);
  
  switch (scenario) {
    case 'Browse Products':
      browseProducts();
      break;
    case 'Add to Cart':
      addToCart();
      break;
    case 'Checkout':
      checkout();
      break;
    case 'View Order':
      viewOrder();
      break;
    case 'Search':
      searchProducts();
      break;
  }
  
  sleep(1);
}

function browseProducts() {
  const res = http.get(`${BASE_URL}/api/products?page=1&limit=20`);
  check(res, {
    'browse products status 200': (r) => r.status === 200,
    'browse products has data': (r) => JSON.parse(r.body).data.length > 0
  });
}

function addToCart() {
  const productId = `product-${Math.floor(Math.random() * 100)}`;
  
  const res = http.post(
    `${BASE_URL}/api/cart/items`,
    JSON.stringify({ productId, quantity: 1 }),
    { headers: { 'Content-Type': 'application/json' } }
  );
  
  check(res, {
    'add to cart status 201': (r) => r.status === 201
  });
}

function checkout() {
  // Requires authenticated user
  const res = http.post(
    `${BASE_URL}/api/orders`,
    JSON.stringify({
      items: [{ productId: 'product-1', quantity: 1 }],
      shippingAddress: { street: '123 Main', city: 'Hanoi', country: 'VN' }
    }),
    {
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${__ENV.AUTH_TOKEN}`
      }
    }
  );
  
  check(res, {
    'checkout status 201': (r) => r.status === 201
  });
}
```

## Workflow

**Phase 1: Test Strategy**

Define testing pyramid. Set coverage targets. Choose testing tools. Plan test environments. Define quality gates.

**Phase 2: Unit Tests**

Write unit tests for business logic. Use TDD for new features. Maintain test quality. Review test coverage. Refactor tests with code.

**Phase 3: Integration Tests**

Write integration tests for data layer. Test service interactions. Use test containers. Maintain test isolation.

**Phase 4: E2E Tests**

Identify critical user journeys. Write E2E tests for these paths. Keep E2E tests stable. Use Page Objects. Run E2E in CI.

**Phase 5: Performance Tests**

Define performance requirements. Write performance tests. Run under load. Analyze results. Optimize based on findings.

**Phase 6: Continuous Testing**

Integrate tests in CI/CD. Set quality gates. Monitor test results. Fix flaky tests. Iterate on strategy.

## Ví dụ

**Ví dụ 1: Property-Based Testing**

```typescript
// Using fast-check for property-based testing
import fc from 'fast-check';

describe('Order validation', () => {
  it('should validate any valid order', () => {
    const validOrder = fc.record({
      customerId: fc.uuid(),
      items: fc.array(
        fc.record({
          productId: fc.uuid(),
          quantity: fc.integer({ min: 1, max: 100 }),
          price: fc.float({ min: 0.01, max: 10000 })
        }),
        { minLength: 1, maxLength: 100 }
      ),
      shippingAddress: fc.record({
        street: fc.string({ minLength: 1, maxLength: 200 }),
        city: fc.string({ minLength: 1, maxLength: 100 }),
        country: fc.string({ minLength: 2, maxLength: 2 })
      })
    });
    
    fc.assert(
      fc.property(validOrder, (order) => {
        const result = validateOrder(order);
        expect(result.isValid).toBe(true);
      })
    );
  });
  
  it('should reject orders with negative quantities', () => {
    const invalidOrder = fc.record({
      customerId: fc.uuid(),
      items: fc.array(
        fc.record({
          productId: fc.uuid(),
          quantity: fc.integer({ min: -100, max: 0 }), // Invalid
          price: fc.float({ min: 0.01 })
        })
      ),
      shippingAddress: validAddress
    });
    
    fc.assert(
      fc.property(invalidOrder, (order) => {
        const result = validateOrder(order);
        expect(result.isValid).toBe(false);
        expect(result.errors).toContain('Quantity must be positive');
      })
    );
  });
});
```

