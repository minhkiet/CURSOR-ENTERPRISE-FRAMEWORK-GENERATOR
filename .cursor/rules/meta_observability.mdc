## Monitoring

### Mục tiêu

Monitoring là window vào health và behavior của production systems. Không có monitoring, teams operate blind - không biết systems đang hoạt động tốt hay đang gặp vấn đề cho đến khi users report.

### Health Checks

```typescript
// Health check registry
class HealthCheckRegistry {
  private checks: Map<string, HealthCheck> = new Map();

  register(name: string, check: HealthCheck) {
    this.checks.set(name, check);
  }

  async getHealth(): Promise<HealthStatus> {
    const results = await Promise.allSettled(
      Array.from(this.checks.entries()).map(
        async ([name, check]) => {
          const result = await check();
          return { name, ...result };
        }
      )
    );

    const checks = results.map(r => {
      if (r.status === 'fulfilled') return r.value;
      return {
        name: 'unknown',
        status: 'unknown',
        error: r.reason?.message || 'Check failed'
      };
    });

    const allHealthy = checks.every(c => c.status === 'healthy');
    const anyDegraded = checks.some(c => c.status === 'degraded');

    return {
      status: allHealthy ? 'healthy' : anyDegraded ? 'degraded' : 'unhealthy',
      timestamp: new Date().toISOString(),
      version: process.env.APP_VERSION,
      checks
    };
  }
}

// Database health check
healthChecks.register('database', async () => {
  try {
    const result = await db.query('SELECT 1');
    return { status: 'healthy' };
  } catch (error) {
    return { status: 'unhealthy', error: error.message };
  }
});

// Redis health check
healthChecks.register('redis', async () => {
  try {
    const start = Date.now();
    await redis.ping();
    const latency = Date.now() - start;
    return {
      status: latency < 100 ? 'healthy' : 'degraded',
      latency,
      message: latency < 100 ? 'OK' : 'Slow response'
    };
  } catch (error) {
    return { status: 'unhealthy', error: error.message };
  }
});

// Health endpoints
app.get('/health/live', (request, response) => {
  response.json({ status: 'alive' });
});

app.get('/health/ready', async (request, response) => {
  const health = await healthChecks.getHealth();
  const dbCheck = health.checks.find(c => c.name === 'database');
  const isReady = dbCheck?.status === 'healthy';
  response.status(isReady ? 200 : 503).json({ ready: isReady, checks: health.checks });
});
```

