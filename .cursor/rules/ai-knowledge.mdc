**4. OCR với Tesseract**

```typescript
// services/pdf-ocr.service.ts
import Tesseract from 'tesseract.js';
import { createCanvas, loadImage } from 'canvas';
import path from 'path';

interface OCRResult {
  text: string;
  confidence: number;
  blocks: OCRBlock[];
  boundingBoxes: BoundingBox[][];
}

interface OCRBlock {
  text: string;
  confidence: number;
  bbox: BoundingBox;
}

interface BoundingBox {
  x0: number;
  y0: number;
  x1: number;
  y1: number;
}

class PDFOCRService {
  private worker: Tesseract.Worker | null = null;
  private language: string;

  constructor(language: string = 'eng') {
    this.language = language;
  }

  async initialize(): Promise<void> {
    this.worker = await Tesseract.createWorker(this.language, 1, {
      logger: (m) => console.log(m)
    });
  }

  async recognizeFromImage(
    imagePath: string,
    options: {
      enhance?: boolean;
      scale?: number;
    } = {}
  ): Promise<OCRResult> {
    if (!this.worker) {
      await this.initialize();
    }

    const { data } = await this.worker.recognize(imagePath);

    return {
      text: data.text,
      confidence: data.confidence,
      blocks: data.blocks?.map(block => ({
        text: block.text,
        confidence: block.confidence,
        bbox: block.bbox
      })) || [],
      boundingBoxes: data.words?.map(word => [word.bbox]) || []
    };
  }

  async recognizeFromPDF(
    pdfPath: string,
    options: {
      startPage?: number;
      endPage?: number;
      enhance?: boolean;
    } = {}
  ): Promise<OCRResult[]> {
    const images = await this.convertPDFToImages(pdfPath, options);
    
    const results: OCRResult[] = [];

    for (const image of images) {
      const result = await this.recognizeFromImage(image, options);
      results.push(result);
    }

    return results;
  }

  private async convertPDFToImages(
    pdfPath: string,
    options: { startPage?: number; endPage?: number }
  ): Promise<string[]> {
    return [];
  }

  async recognizeBatch(
    images: string[],
    options: { onProgress?: (progress: number) => void } = {}
  ): Promise<OCRResult[]> {
    if (!this.worker) {
      await this.initialize();
    }

    const results: OCRResult[] = [];

    for (let i = 0; i < images.length; i++) {
      const result = await this.recognizeFromImage(images[i]);
      results.push(result);
      
      if (options.onProgress) {
        options.onProgress((i + 1) / images.length);
      }
    }

    return results;
  }

  async terminate(): Promise<void> {
    if (this.worker) {
      await this.worker.terminate();
      this.worker = null;
    }
  }
}
