**3. PDF Merger và Splitter**

```typescript
// services/pdf-manipulation.service.ts
import PDFMerger from 'pdf-merger-js';
import { PDFDocument } from 'pdf-lib';

class PDFManipulationService {
  async mergePDFs(filePaths: string[]): Promise<Buffer> {
    const merger = new PDFMerger();

    for (const filePath of filePaths) {
      merger.add(filePath);
    }

    const mergedBuffer = await merger.save();
    return Buffer.from(mergedBuffer);
  }

  async splitPDF(
    filePath: string,
    splitPages: number[]
  ): Promise<Map<number, Buffer>> {
    const pdfBytes = await fs.readFile(filePath);
    const pdfDoc = await PDFDocument.load(pdfBytes);
    const results = new Map<number, Buffer>();

    for (const pageNum of splitPages) {
      if (pageNum < 1 || pageNum > pdfDoc.getPageCount()) {
        throw new Error(`Invalid page number: ${pageNum}`);
      }

      const newPdf = await PDFDocument.create();
      const [copiedPage] = await newPdf.copyPages(pdfDoc, [pageNum - 1]);
      newPdf.addPage(copiedPage);

      const pdfBytes = await newPdf.save();
      results.set(pageNum, Buffer.from(pdfBytes));
    }

    return results;
  }

  async splitPDFByRanges(
    filePath: string,
    ranges: Array<{ start: number; end: number }>
  ): Promise<Buffer> {
    const pdfBytes = await fs.readFile(filePath);
    const pdfDoc = await PDFDocument.load(pdfBytes);
    const newPdf = await PDFDocument.create();

    for (const range of ranges) {
      for (let i = range.start; i <= range.end; i++) {
        if (i >= 1 && i <= pdfDoc.getPageCount()) {
          const [copiedPage] = await newPdf.copyPages(pdfDoc, [i - 1]);
          newPdf.addPage(copiedPage);
        }
      }
    }

    const mergedPdf = await newPdf.save();
    return Buffer.from(mergedPdf);
  }

  async extractPages(
    filePath: string,
    startPage: number,
    endPage: number
  ): Promise<Buffer> {
    const ranges: Array<{ start: number; end: number }> = [];
    for (let i = startPage; i <= endPage; i++) {
      ranges.push({ start: i, end: i });
    }
    return this.splitPDFByRanges(filePath, ranges);
  }

  async addPageNumbers(
    filePath: string,
    options: {
      position?: 'top' | 'bottom';
      startNumber?: number;
      format?: string;
    } = {}
  ): Promise<Buffer> {
    const { position = 'bottom', startNumber = 1, format = '{n} of {total}' } = options;

    const pdfBytes = await fs.readFile(filePath);
    const pdfDoc = await PDFDocument.load(pdfBytes);
    const pages = pdfDoc.getPages();
    const totalPages = pages.length;

    for (let i = 0; i < pages.length; i++) {
      const page = pages[i];
      const pageNum = startNumber + i;
      const text = format
        .replace('{n}', pageNum.toString())
        .replace('{total}', totalPages.toString());

      const font = await pdfDoc.embedFont(PDFDocument.FONT_IDENTITY_H);
      const { height } = page.getSize();

      page.drawText(text, {
        x: 50,
        y: position === 'top' ? height - 50 : 50,
        size: 12,
        font
      });
    }

    const numberedPdf = await pdfDoc.save();
    return Buffer.from(numberedPdf);
  }
}
