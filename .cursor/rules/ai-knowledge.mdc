**5. PDF Security**

```typescript
// services/pdf-security.service.ts
import { PDFDocument, StandardEncryption, AES256Encryption } from 'pdf-lib';

interface EncryptionOptions {
  userPassword?: string;
  ownerPassword?: string;
  permissions?: PDFPermissions;
  encryptionLevel?: 'medium' | 'high';
}

interface PDFPermissions {
  print?: boolean;
  modify?: boolean;
  copy?: boolean;
  annotate?: boolean;
  fillForms?: boolean;
  extract?: boolean;
  assemble?: boolean;
  printFaithful?: boolean;
}

class PDFSecurityService {
  async encryptPDF(
    filePath: string,
    options: EncryptionOptions
  ): Promise<Buffer> {
    const pdfBytes = await fs.readFile(filePath);
    const pdfDoc = await PDFDocument.load(pdfBytes);

    const encryption = options.encryptionLevel === 'high'
      ? AES256Encryption.new()
      : StandardEncryption.new();

    encryption.setUserPassword(options.userPassword || '');
    encryption.setOwnerPassword(options.ownerPassword || '');

    const permissions = this.buildPermissions(options.permissions || {});
    encryption.setPermissions(permissions);

    pdfDoc.attach(encryption);

    const encryptedPdf = await pdfDoc.save();
    return Buffer.from(encryptedPdf);
  }

  private buildPermissions(perms: PDFPermissions): number {
    let flags = 0;
    
    if (perms.print) flags |= 0b0000000100;
    if (perms.modify) flags |= 0b0000001000;
    if (perms.copy) flags |= 0b0000010000;
    if (perms.annotate) flags |= 0b0000100000;
    if (perms.fillForms) flags |= 0b0001000000;
    if (perms.extract) flags |= 0b0010000000;
    if (perms.assemble) flags |= 0b0100000000;
    if (perms.printFaithful) flags |= 0b1000000000;
    
    return flags;
  }

  async removePassword(
    filePath: string,
    ownerPassword: string
  ): Promise<Buffer> {
    const pdfBytes = await fs.readFile(filePath);
    const pdfDoc = await PDFDocument.load(pdfBytes, {
      password: ownerPassword
    });

    const unlockedPdf = await pdfDoc.save();
    return Buffer.from(unlockedPdf);
  }

  async verifyPDFSafety(filePath: string): Promise<{
    isSafe: boolean;
    issues: string[];
  }> {
    const issues: string[] = [];

    try {
      const pdfBytes = await fs.readFile(filePath);
      
      if (pdfBytes.length > 100 * 1024 * 1024) {
        issues.push('File size exceeds safe limit');
      }

      return {
        isSafe: issues.length === 0,
        issues
      };
    } catch (error) {
      return {
        isSafe: false,
        issues: [`Error analyzing PDF: ${error.message}`]
      };
    }
  }
}
```

### Workflow

**Phase 1: Requirements Analysis**

Define PDF processing needs. Choose appropriate libraries. Plan architecture. Estimate scale.

**Phase 2: Implementation**

Set up PDF library. Implement generation. Add extraction. Configure OCR. Set up security.

**Phase 3: Template Development**

Design templates. Implement template system. Add data binding. Test templates.

**Phase 4: Optimization**

Implement caching. Optimize performance. Add streaming. Configure workers.

**Phase 5: Testing**

Test with various PDFs. Test generation. Test extraction. Test OCR. Performance testing.

**Phase 6: Deployment**

Deploy PDF services. Configure scaling. Set up monitoring. Document usage.

