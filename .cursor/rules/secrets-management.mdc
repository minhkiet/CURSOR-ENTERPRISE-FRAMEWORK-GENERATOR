import { SecretsClient } from './vault-client';

export async function getDatabaseConfig() {
  const secrets = new SecretsClient();
  
  const secret = await secrets.getSecret('database/creds/prod-default');
  const { username, password, host, port, database } = JSON.parse(secret);
  
  return {
    connectionString: `postgresql://${username}:${password}@${host}:${port}/${database}`
