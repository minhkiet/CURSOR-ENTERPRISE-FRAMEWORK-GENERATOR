**5. AWS Secrets Manager Integration**

```typescript
// lib/secrets/aws-secrets.ts
import { 
  SecretsManagerClient, 
  GetSecretValueCommand,
  ListSecretsCommand,
  RotateSecretCommand
} from '@aws-sdk/client-secrets-manager';
import { cache } from './cache';

const client = new SecretsManagerClient({ region: 'us-east-1' });

export class AWSSecretsClient {
  async getSecret(secretName: string): Promise<Record<string, string>> {
    const cacheKey = `aws-secret:${secretName}`;
    const cached = cache.get(cacheKey);
    
    if (cached) return cached;

    const command = new GetSecretValueCommand({
      SecretId: secretName
    });

    const response = await client.send(command);
    
    let secretValue: Record<string, string>;
    if (response.SecretString) {
      secretValue = JSON.parse(response.SecretString);
    } else if (response.SecretBinary) {
      secretValue = JSON.parse(Buffer.from(response.SecretBinary).toString());
    }

    // Cache for 5 minutes
    cache.set(cacheKey, secretValue, 300);
    
    return secretValue;
  }

  async listSecrets(): Promise<string[]> {
    const command = new ListSecretsCommand({});
    const response = await client.send(command);
    return response.SecretList?.map(s => s.Name || '') || [];
  }

  async rotateSecret(secretName: string): Promise<void> {
    const command = new RotateSecretCommand({
      SecretId: secretName
    });
    await client.send(command);
  }
}
```

**6. Secret Scanning**

```yaml
# .github/workflows/secret-scanning.yml
name: Secret Scanning

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main]

jobs:
  detect-secrets:
    name: Detect Secrets
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        
      - name: Scan for secrets
        uses: trufflesecurity/trufflehog@main
        with:
          path: ./
          base: ${{ github.event.repository.default_branch }}
          extra_config: |
            [detectors]
            [detectors.AWS]
            inactiveAge = 720
            allow = ["testing-key","staging-key"]
            
      - name: GitGuardian Scan
        uses: GitGuardian/gg-shield-action@master
        env:
          GITGUARDIAN_API_KEY: ${{ secrets.GITGUARDIAN_API_KEY }}
```

```bash
# pre-commit hook for secret scanning
#!/bin/bash
# .git/hooks/pre-commit

# Install gg-shield if not present
if ! command -v gg-shield &> /dev/null; then
    pip install gg-shield
fi

# Run secret scanning
gg-shield secret scan pre-commit

if [ $? -ne 0 ]; then
    echo "Secret scanning failed. Commit rejected."
    exit 1
fi
```

