**4. Application Integration**

```typescript
// lib/secrets/vault-client.ts
import Vault from 'node-vault';
import { getCachedValue, setCachedValue } from './cache';

const vault = Vault({
  endpoint: process.env.VAULT_ADDR || 'https://vault.internal:8200',
  token: process.env.VAULT_TOKEN,
  tls: {
    ca: process.env.VAULT_CACERT
  }
});

export class SecretsClient {
  private cache = new Map<string, { value: string; expires: number }>();
  private defaultTTL = 300; // 5 minutes

  async getSecret(path: string, options?: { 
    version?: number;
    ttl?: number;
  }): Promise<string> {
    const { version, ttl = this.defaultTTL } = options || {};
    
    // Check cache
    const cacheKey = `${path}:${version}`;
    const cached = this.cache.get(cacheKey);
    if (cached && cached.expires > Date.now()) {
      return cached.value;
    }

    // Fetch from Vault
    const secret = await vault.read(path, {
      version
    });

    const value = secret.data.data;
    this.cache.set(cacheKey, {
      value: JSON.stringify(value),
      expires: Date.now() + ttl * 1000
    });

    return JSON.stringify(value);
  }

  async getDynamicCredential(
    engine: string,
    role: string
  ): Promise<{ username: string; password: string; lease_id: string }> {
    const cacheKey = `dynamic:${engine}:${role}`;
    const cached = this.cache.get(cacheKey);
    
    if (cached && cached.expires > Date.now()) {
      return JSON.parse(cached.value);
    }

    // Read dynamic credentials
    const result = await vault.read(`${engine}/creds/${role}`);
    const { data } = result;

    // Calculate lease expiration
    const ttl = result.lease_duration || 3600;
    this.cache.set(cacheKey, {
      value: JSON.stringify({
        username: data.username,
        password: data.password,
        lease_id: result.lease_id
      }),
      expires: Date.now() + ttl * 1000 - 30000 // Refresh 30 seconds before expiry
    });

    return {
      username: data.username,
      password: data.password,
      lease_id: result.lease_id
    };
  }

  async renewLease(leaseId: string): Promise<void> {
    await vault.renew(leaseId);
  }

  async revokeLease(leaseId: string): Promise<void> {
    await vault.revoke(leaseId);
  }

  // For use with Kubernetes service account
  static async fromK8sServiceAccount(
    vaultAddr: string,
    k8sRole: string
  ): Promise<SecretsClient> {
    // Get service account token
    const token = await fs.readFile(
      '/var/run/secrets/kubernetes.io/serviceaccount/token',
      'utf8'
    );

    // Get CA certificate
    const ca = await fs.readFile(
      '/var/run/secrets/kubernetes.io/serviceaccount/ca.crt',
      'utf8'
    );

    // Login to Vault using Kubernetes auth
    const vaultClient = Vault({
      endpoint: vaultAddr,
      tls: { ca }
    });

    const loginResult = await vaultClient.kubernetesLogin({
      role: k8sRole,
      jwt: token
    });

    return new SecretsClient(vaultAddr, loginResult.auth.client_token);
  }
}
```

