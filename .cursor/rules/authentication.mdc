## Anti Patterns

### 1. Storing Passwords in Plain Text

```typescript
// Không nên - plain text password
const user = {
    email: 'user@example.com',
    password: 'plaintextpassword' // NEVER do this!
};

// Nên - hashed password
const user = {
    email: 'user@example.com',
    passwordHash: await bcrypt.hash('plaintextpassword', 12)
};
```

### 2. Using MD5 hoặc SHA1 cho Passwords

```typescript
// Không nên - weak hashing
const hash = crypto.createHash('md5').update(password).digest('hex');

// Nên - bcrypt hoặc Argon2
const hash = await bcrypt.hash(password, 12);
```

### 3. JWT Without Expiration

```typescript
// Không nên - no expiration
const token = jwt.sign({ userId }, secret);

// Nên - with expiration
const token = jwt.sign(
    { userId },
    secret,
    { expiresIn: '15m' }
);
```

### 4. Storing Tokens in LocalStorage

```typescript
// Không nên - vulnerable to XSS
localStorage.setItem('token', token);

// Nên - HttpOnly cookie
res.cookie('token', token, {
    httpOnly: true,
    secure: true,
    sameSite: 'strict'
});
```

### 5. Weak Password Reset Flow

```typescript
// Không nên - weak token
const token = user.id; // Just user ID - easily guessable!

// Nên - cryptographically random token
const token = randomBytes(32).toString('hex');
```

## Best Practices

### 1. Complete Authentication Flow

```typescript
// Authentication controller
class AuthController {
    constructor(
        private authService: AuthService,
        private mfaService: MFAService,
        private logger: Logger
    ) {}

    async register(req: Request, res: Response): Promise<void> {
        try {
            const { email, password, name } = req.body;

            // Validate input
            const validated = registerSchema.parse({ email, password, name });

            // Create user
            const user = await this.authService.register(validated);

            // Generate tokens
            const tokens = await this.authService.generateTokens(user);

            // Set secure cookie
            this.authService.setAuthCookie(res, tokens.accessToken);

            res.status(201).json({
                user: user.toSafeJSON(),
                ...tokens
            });
        } catch (error) {
            this.handleError(res, error);
        }
    }

    async login(req: Request, res: Response): Promise<void> {
        try {
            const { email, password, mfaToken } = req.body;

            // Check rate limit
            const rateLimitCheck = await this.authService.checkRateLimit(
                email,
                req.ip
            );
            if (rateLimitCheck.blocked) {
                res.status(429).json({
                    error: {
                        code: 'RATE_LIMITED',
                        message: rateLimitCheck.reason
                    }
                });
                return;
            }

            // Authenticate
            const result = await this.authService.authenticate(
                email,
                password,
                mfaToken
            );

            if (result.requiresMFA) {
                res.json({
                    requiresMFA: true,
                    method: result.mfaMethod
                });
                return;
            }

            // Clear rate limit
            await this.authService.clearRateLimit(email, req.ip);

            // Set secure cookie
            this.authService.setAuthCookie(res, result.tokens.accessToken);

            res.json({
                user: result.user.toSafeJSON(),
                ...result.tokens
            });
        } catch (error) {
            await this.authService.recordFailedAttempt(email, req.ip);
            this.handleError(res, error);
        }
    }

    async refresh(req: Request, res: Response): Promise<void> {
        try {
            const refreshToken = req.cookies.refresh_token ||
                req.headers.authorization?.split(' ')[1];

            if (!refreshToken) {
                throw new AuthError('Refresh token required');
            }

            const tokens = await this.authService.refreshTokens(refreshToken);

            this.authService.setAuthCookie(res, tokens.accessToken);

            res.json(tokens);
        } catch (error) {
            this.handleError(res, error);
        }
    }

    async logout(req: Request, res: Response): Promise<void> {
        try {
            const userId = req.user?.id;
            const tokenId = req.user?.jti;

            if (userId) {
                await this.authService.logout(userId, tokenId);
            }

            res.clearCookie('access_token');
            res.clearCookie('refresh_token');

            res.json({ success: true });
        } catch (error) {
            this.handleError(res, error);
        }
    }

    private handleError(res: Response, error: any): void {
        this.logger.error('Auth error', { error });

        if (error instanceof AuthError) {
            res.status(401).json({
                error: {
                    code: error.code,
                    message: error.message
                }
            });
            return;
        }

        res.status(500).json({
            error: {
                code: 'INTERNAL_ERROR',
                message: 'Authentication failed'
            }
        });
    }
}
```

### 2. Authentication Middleware

```typescript
// Authentication middleware
export function authenticate(
    req: Request,
    res: Response,
    next: NextFunction
): void {
    const token = extractToken(req);

    if (!token) {
        res.status(401).json({
            error: { code: 'UNAUTHORIZED', message: 'Authentication required' }
        });
        return;
    }

    try {
        const payload = tokenService.verifyAccessToken(token);
        (req as any).user = payload;
        next();
    } catch (error) {
        if (error instanceof TokenExpiredError) {
            res.status(401).json({
                error: { code: 'TOKEN_EXPIRED', message: 'Token expired' }
            });
            return;
        }
        res.status(401).json({
            error: { code: 'INVALID_TOKEN', message: 'Invalid token' }
        });
    }
}

// Optional authentication - continues even if not authenticated
export function optionalAuth(
    req: Request,
    res: Response,
    next: NextFunction
): void {
    const token = extractToken(req);

    if (token) {
        try {
            const payload = tokenService.verifyAccessToken(token);
            (req as any).user = payload;
        } catch (error) {
            // Continue without user
        }
    }

    next();
}

// Authorization middleware
export function authorize(...roles: string[]) {
    return (req: Request, res: Response, next: NextFunction): void => {
        const user = (req as any).user;

        if (!user) {
            res.status(401).json({
                error: { code: 'UNAUTHORIZED', message: 'Authentication required' }
            });
            return;
        }

        if (roles.length > 0 && !roles.includes(user.role)) {
            res.status(403).json({
                error: { code: 'FORBIDDEN', message: 'Permission denied' }
            });
            return;
        }

        next();
    };
}
