### Ví dụ 1: Complete Authentication Service

```typescript
export class AuthService {
    constructor(
        private db: Database,
        private cache: RedisClient,
        private emailService: EmailService,
        private tokenService: TokenService,
        private mfaService: MFAService,
        private config: AuthConfig
    ) {}

    async register(input: RegisterInput): Promise<AuthResult> {
        // Check existing user
        const existing = await this.db.users.findByEmail(input.email);
        if (existing) {
            throw new ConflictError('Email already registered');
        }

        // Hash password
        const passwordHash = await hashPassword(input.password);

        // Create user
        const user = await this.db.users.create({
            email: input.email,
            name: input.name,
            passwordHash,
            role: 'USER'
        });

        // Generate tokens
        const tokens = await this.tokenService.generateTokens(user);

        return { user, tokens };
    }

    async authenticate(
        email: string,
        password: string,
        mfaToken?: string
    ): Promise<AuthResult> {
        // Get user
        const user = await this.db.users.findByEmail(email);
        if (!user) {
            // Deliberate delay to prevent user enumeration
            await new Promise(resolve => setTimeout(resolve, 1000));
            throw new AuthError('Invalid credentials');
        }

        // Check if account is locked
        if (await this.isAccountLocked(user.id)) {
            throw new AuthError('Account temporarily locked');
        }

        // Verify password
        const isValid = await verifyPassword(password, user.passwordHash);
        if (!isValid) {
            await this.recordFailedAttempt(user.id);
            throw new AuthError('Invalid credentials');
        }

        // Check if MFA is enabled
        if (user.mfaEnabled) {
            if (!mfaToken) {
                return {
                    requiresMFA: true,
                    mfaMethod: 'totp'
                };
            }

            const mfaValid = await this.mfaService.verifyMFA(user.id, mfaToken);
            if (!mfaValid) {
                throw new AuthError('Invalid MFA token');
            }
        }

        // Clear failed attempts
        await this.clearFailedAttempts(user.id);

        // Update last login
        await this.updateLastLogin(user.id);

        // Generate tokens
        const tokens = await this.tokenService.generateTokens(user);

        return { user, tokens };
    }

    async changePassword(
        userId: string,
        currentPassword: string,
        newPassword: string
    ): Promise<void> {
        const user = await this.db.users.findById(userId);

        // Verify current password
        const isValid = await verifyPassword(currentPassword, user.passwordHash);
        if (!isValid) {
            throw new AuthError('Current password is incorrect');
        }

        // Validate new password
        const validation = validatePasswordStrength(newPassword);
        if (!validation.valid) {
            throw new ValidationError(validation.errors);
        }

        // Hash and update
        const newHash = await hashPassword(newPassword);
        await this.db.users.update(userId, { passwordHash: newHash });

        // Revoke all sessions
        await this.tokenService.revokeAllUserTokens(userId);

        // Send notification
        await this.emailService.send({
            to: user.email,
            template: 'password-changed',
            data: { timestamp: new Date() }
        });
    }
}
```

### Ví dụ 2: MFA Setup Flow

```typescript
class MFAController {
    constructor(
        private mfaService: MFAService
    ) {}

    async setup(req: Request, res: Response): Promise<void> {
        const userId = req.user.id;

        const { secret, qrCode, backupCodes } = await this.mfaService.generateMFASecret(userId);

        // Return QR code and backup codes (backup codes only shown once)
        res.json({
            secret,
            qrCode,
            backupCodes,
            message: 'Save backup codes securely. They will not be shown again.'
        });
    }

    async enable(req: Request, res: Response): Promise<void> {
        const { token } = req.body;
        const userId = req.user.id;

        await this.mfaService.enableMFA(userId, token);

        res.json({ success: true });
    }

    async disable(req: Request, res: Response): Promise<void> {
        const { password, token } = req.body;
        const userId = req.user.id;

        // Verify password first
        const user = await this.userService.findById(userId);
        const isValid = await verifyPassword(password, user.passwordHash);
        if (!isValid) {
            throw new AuthError('Invalid password');
        }

        // Verify MFA token
        const mfaValid = await this.mfaService.verifyMFA(userId, token);
        if (!mfaValid) {
            throw new AuthError('Invalid MFA token');
        }

        await this.mfaService.disableMFA(userId);

        res.json({ success: true });
    }

    async verify(req: Request, res: Response): Promise<void> {
        const { token } = req.body;
        const userId = req.user.id;

        const isValid = await this.mfaService.verifyMFA(userId, token);

        res.json({ valid: isValid });
    }
}
