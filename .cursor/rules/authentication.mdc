```typescript
class SocialAuthController {
    constructor(
        private oauthService: OAuthService
    ) {}

    // Initiate OAuth flow
    async initiateGoogleAuth(req: Request, res: Response): Promise<void> {
        const redirectUri = `${this.config.baseUrl}/auth/google/callback`;

        const { url, state } = await this.oauthService.getAuthorizationUrl(
            'google',
            redirectUri
        );

        // Store state in cookie for verification
        res.cookie('oauth_state', state, {
            httpOnly: true,
            secure: true,
            maxAge: 600000, // 10 minutes
            sameSite: 'strict'
        });

        res.json({ url });
    }

    // Handle OAuth callback
    async handleGoogleCallback(req: Request, res: Response): Promise<void> {
        const { code, state } = req.query;

        // Verify state
        const storedState = req.cookies.oauth_state;
        if (state !== storedState) {
            res.status(400).json({ error: 'Invalid state parameter' });
            return;
        }

        try {
            const tokens = await this.oauthService.handleCallback(
                'google',
                code as string,
                state as string
            );

            // Clear state cookie
            res.clearCookie('oauth_state');

            // Set auth cookies
            res.cookie('access_token', tokens.accessToken, {
                httpOnly: true,
                secure: true,
                sameSite: 'strict',
                maxAge: 15 * 60 * 1000
            });

            res.cookie('refresh_token', tokens.refreshToken, {
                httpOnly: true,
                secure: true,
                sameSite: 'strict',
                maxAge: 7 * 24 * 60 * 60 * 1000
            });

            // Redirect to app
            res.redirect('/dashboard');
        } catch (error) {
            this.logger.error('OAuth callback error', { error });
            res.redirect('/auth/error');
        }
    }
}
