### A.2 Language Detection Patterns

```yaml
# Vietnamese Detection
vietnamese_signals:
  keywords: ["tạo", "xây dựng", "cải thiện", "sửa lỗi", "thiết kế", "app", "web", "trang", "trang web", "code", "lập trình", "phát triển", "component", "ứng dụng", "hệ thống", "api", "database", "backend", "frontend"]
  patterns: ["^tạo ", "^xây ", "^cải ", "^sửa ", "^thiết kế"]
  frequency_indicators: ["không", "có", "và", "hoặc", "với", "để", "của", "là", "được", "này", "đó"]

# Chinese Detection
chinese_signals:
  keywords: ["创建", "构建", "改进", "修复", "设计", "应用", "网站", "代码", "编程", "开发", "组件", "系统", "接口", "数据库"]
  character_set: "[\u4e00-\u9fff]"  # CJK Unified Ideographs
  frequency_indicators: ["的", "是", "在", "有", "和", "与", "为", "了", "对", "中", "这", "那"]

# Japanese Detection
japanese_signals:
  keywords: ["作成", "構築", "改善", "修正", "設計", "アプリ", "ウェブサイト", "コード", "プログラミング", "開発", "コンポーネント", "システム"]
  character_set: "[\u3040-\u309f\u30a0-\u30ff]"  # Hiragana + Katakana
  kanji_common: ["作成", "構築", "開発", "設計", "修正", "改善", "実装"]

# Korean Detection
korean_signals:
  keywords: ["생성", "구축", "개선", "수정", "설계", "앱", "웹", "코드", "프로그래밍", "개발", "컴포넌트", "시스템"]
  character_set: "[\uac00-\ud7af]"  # Hangul Syllables
  frequency_indicators: ["의", "이", "가", "을", "를", "에", "와", "과", "는", "은"]

# Arabic Detection
arabic_signals:
  keywords: ["إنشاء", "بناء", "تحسين", "إصلاح", "تصميم", "تطبيق", "موقع", "كود", "برمجة", "تطوير", "نظام"]
  character_set: "[\u0600-\u06ff]"  # Arabic
  rtl: true
```

### A.3 Language Detection Algorithm

```python
def detect_language(text: str) -> dict:
    """
    Detect source language with confidence score
    Returns: { "language": str, "confidence": float, "indicators": list }
    """
    scores = {}
    
    # Check character set patterns
    if re.search(r"[\u4e00-\u9fff]", text):  # Chinese
        scores["zh"] = 0.95
    if re.search(r"[\u3040-\u309f\u30a0-\u30ff]", text):  # Japanese
        scores["ja"] = 0.90
    if re.search(r"[\uac00-\ud7af]", text):  # Korean
        scores["ko"] = 0.90
    if re.search(r"[\u0600-\u06ff]", text):  # Arabic
        scores["ar"] = 0.95
        
    # Check language-specific keywords
    for lang, signals in LANGUAGE_SIGNALS.items():
        keyword_matches = sum(1 for kw in signals["keywords"] if kw in text.lower())
        pattern_matches = sum(1 for pattern in signals["patterns"] if re.search(pattern, text.lower()))
        frequency_matches = sum(1 for fi in signals["frequency_indicators"] if fi in text)
        
        scores[lang] = (
            keyword_matches * 2.0 +
            pattern_matches * 3.0 +
            frequency_matches * 0.5
        ) / (len(signals["keywords"]) + len(signals["patterns"]) + len(signals["frequency_indicators"]))
    
    # Normalize and return
    best_lang = max(scores, key=scores.get)
    confidence = min(1.0, scores[best_lang])
    
    return {
        "language": best_lang,
        "confidence": confidence,
        "all_scores": scores,
        "detection_method": "hybrid" if len(scores) > 1 else "character_set"
    }
```

