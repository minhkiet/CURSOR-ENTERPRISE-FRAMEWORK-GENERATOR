**5. Health Check Implementation**

```typescript
// Health check registry
class HealthCheckRegistry {
  private checks: Map<string, HealthCheck> = new Map();
  
  register(name: string, check: HealthCheck) {
    this.checks.set(name, check);
  }
  
  async getHealth(): Promise<HealthStatus> {
    const results = await Promise.allSettled(
      Array.from(this.checks.entries()).map(
        async ([name, check]) => {
          const result = await check();
          return { name, ...result };
        }
      )
    );
    
    const checks = results.map(r => {
      if (r.status === 'fulfilled') return r.value;
      return {
        name: 'unknown',
        status: 'unknown',
        error: r.reason?.message || 'Check failed'
      };
    });
    
    const allHealthy = checks.every(c => c.status === 'healthy');
    const anyDegraded = checks.some(c => c.status === 'degraded');
    
    return {
      status: allHealthy ? 'healthy' : anyDegraded ? 'degraded' : 'unhealthy',
      timestamp: new Date().toISOString(),
      version: process.env.APP_VERSION,
      checks
    };
  }
}

// Health checks implementation
const healthChecks = new HealthCheckRegistry();

// Database health check
healthChecks.register('database', async () => {
  try {
    const result = await db.query('SELECT 1');
    return { status: 'healthy' };
  } catch (error) {
    return {
      status: 'unhealthy',
      error: error.message
    };
  }
});

// Redis health check
healthChecks.register('redis', async () => {
  try {
    const start = Date.now();
    await redis.ping();
    const latency = Date.now() - start;
    
    return {
      status: latency < 100 ? 'healthy' : 'degraded',
      latency,
      message: latency < 100 ? 'OK' : 'Slow response'
    };
  } catch (error) {
    return {
      status: 'unhealthy',
      error: error.message
    };
  }
});

// External service health check
healthChecks.register('payment-gateway', async () => {
  try {
    const response = await fetch('https://payment-api/health', {
      timeout: 5000
    });
    
    if (response.ok) {
      return { status: 'healthy' };
    }
    
    return {
      status: 'degraded',
      error: `Payment API returned ${response.status}`
    };
  } catch (error) {
    return {
      status: 'unhealthy',
      error: error.message
    };
  }
});

// Health endpoint
app.get('/health', async (request, response) => {
  const health = await healthChecks.getHealth();
  
  const statusCode = health.status === 'healthy' ? 200 :
                     health.status === 'degraded' ? 200 : 503;
  
  response.status(statusCode).json(health);
});

// Liveness vs Readiness
app.get('/health/live', (request, response) => {
  response.json({ status: 'alive' });
});

app.get('/health/ready', async (request, response) => {
  const health = await healthChecks.getHealth();
  
  // Only ready if database is healthy
  const dbCheck = health.checks.find(c => c.name === 'database');
  const isReady = dbCheck?.status === 'healthy';
  
  response.status(isReady ? 200 : 503).json({
    ready: isReady,
    checks: health.checks
  });
});
```

## Workflow

**Phase 1: Requirements Definition**

Identify critical user journeys. Define SLIs for each journey. Set SLO targets. Identify key metrics. Plan alerting strategy.

**Phase 2: Implementation**

Implement structured logging. Add metrics instrumentation. Configure distributed tracing. Create health checks. Set up dashboards.

**Phase 3: Alert Configuration**

Configure alerts for critical paths. Write runbooks. Set up notification routing. Test alerts. Iterate on thresholds.

**Phase 4: Operations**

Monitor dashboards daily. Review SLO compliance. Respond to alerts. Update runbooks. Iterate on monitoring.

**Phase 5: Continuous Improvement**

Regular monitoring reviews. Optimize alert noise. Update SLOs based on data. Add new monitoring as system evolves.

## Ví dụ

**Ví dụ 1: SLO Dashboard**

```typescript
// SLO tracking
class SLOService {
  constructor(
    private metrics: MetricsRepository,
    private config: SLOConfig
  ) {}
  
  async calculateSLI(service: string, window: DateWindow): Promise<SLI> {
    const goodEvents = await this.metrics.countEvents({
      service,
      type: 'request',
      success: true,
      window
    });
    
    const totalEvents = await this.metrics.countEvents({
      service,
      type: 'request',
      window
    });
    
    return {
      goodEvents,
      totalEvents,
      sliValue: totalEvents > 0 ? goodEvents / totalEvents : 1
    };
  }
  
  async getErrorBudget(
    service: string,
    window: DateWindow
  ): Promise<ErrorBudget> {
    const sli = await this.calculateSLI(service, window);
    const target = this.config.sloTargets[service];
    
    const acceptableErrors = Math.floor(
      sli.totalEvents * (1 - target)
    );
    
    const actualErrors = sli.totalEvents - sli.goodEvents;
    const remainingBudget = acceptableErrors - actualErrors;
    
    return {
      service,
      window,
      target,
      current: sli.sliValue,
      acceptableErrors,
      actualErrors,
      remainingBudget,
      budgetExhausted: remainingBudget < 0,
      projectedExhaustionDate: this.projectExhaustion(
        remainingBudget,
        actualErrors,
        window
      )
    };
  }
  
  private projectExhaustion(
    remainingBudget: number,
    currentErrors: number,
    window: DateWindow
  ): Date | null {
    if (remainingBudget <= 0) return new Date();
    if (currentErrors <= 0) return null;
    
    const errorRate = currentErrors / (window.days || 1);
    const daysUntilExhaustion = remainingBudget / errorRate;
    
    return addDays(new Date(), daysUntilExhaustion);
  }
}
```

**Ví dụ 2: Log Aggregation**

```typescript
// Lambda for log processing
export async function processLogs(event: SNSEvent) {
  for (const record of event.Records) {
    const log = JSON.parse(record.Sns.Message);
    
    // Parse and enrich
    const enrichedLog = {
      ...log,
      environment: getEnvironment(log.service),
      team: getTeam(log.service),
      severity: normalizeSeverity(log.level),
      parsed: parseMessage(log.message)
    };
    
    // Index to Elasticsearch
    await elasticsearch.index({
      index: `logs-${getLogIndexDate(log.timestamp)}`,
      document: enrichedLog
    });
    
    // Send to SIEM
    await siem.send({
      source: 'application',
      ...enrichedLog
    });
  }
}

// Log queries for debugging
async function queryLogs(
  service: string,
  timeRange: TimeRange,
  filters: LogFilters
): Promise<LogEntry[]> {
  const query = {
    bool: {
      must: [
        { term: { service } },
        { range: { timestamp: timeRange } }
      ],
      should: filters.searchTerms.map(term => ({
        match: { message: term }
      }))
    }
  };
  
  const results = await elasticsearch.search({
    index: `logs-*`,
    query,
    sort: [{ timestamp: 'desc' }],
    size: 100
  });
  
  return results.hits.hits.map(hit => hit._source);
}
