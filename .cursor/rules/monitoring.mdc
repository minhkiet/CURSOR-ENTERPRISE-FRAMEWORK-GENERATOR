// Alert routing
class AlertRouter {
  constructor(
    private pagerduty: PagerDutyClient,
    private slack: SlackClient,
    private email: EmailClient
  ) {}
  
  async routeAlert(alert: Alert): Promise<void> {
    // Critical alerts page on-call
    if (alert.severity === 'critical') {
      await this.pagerduty.createIncident({
        title: alert.summary,
        body: alert.description,
        urgency: 'high'
      });
    }
    
    // All alerts go to Slack
    await this.slack.sendToChannel('#alerts', {
      color: this.getSeverityColor(alert.severity),
      title: alert.summary,
      fields: [
        { title: 'Severity', value: alert.severity, short: true },
        { title: 'Service', value: alert.service, short: true }
      ],
      actions: [
        { type: 'button', text: 'View Dashboard', url: alert.dashboard },
        { type: 'button', text: 'View Runbook', url: alert.runbook }
      ]
    });
    
    // SLO breach alerts email stakeholders
    if (alert.isSLOBreach) {
      await this.email.send({
        to: 'slo-team@example.com',
        subject: `[SLO BREACH] ${alert.summary}`,
        body: this.renderSLOBreachEmail(alert)
      });
    }
  }
}
