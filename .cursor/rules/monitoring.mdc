```typescript
// APM integration
import { init as initAPM } from 'elastic/apm';

const apm = initAPM({
  serviceName: 'order-service',
  serverUrl: process.env.APM_SERVER_URL,
  captureBody: 'transactions',
  transactionSampleRate: 0.1,
  metricInterval: '30s'
});

// Custom metrics
apm.addLabels({
  environment: process.env.NODE_ENV,
  region: process.env.AWS_REGION
});

// Track custom transactions
async function processOrder(orderId: string) {
  const transaction = apm.startTransaction(`process-order-${orderId}`);
  
  try {
    // Load order
    const orderSpan = transaction.startSpan('load-order');
    const order = await db.orders.findById(orderId);
    orderSpan.end();
    
    // Validate
    const validateSpan = transaction.startSpan('validate-order');
    await validateOrder(order);
    validateSpan.end();
    
    // Process payment
    const paymentSpan = transaction.startSpan('process-payment');
    await paymentService.charge(order);
    paymentSpan.end();
    
    transaction.end('success');
  } catch (error) {
    transaction.end('error');
    apm.captureError(error);
    throw error;
  }
}

// Capture distributed tracing headers
app.use(apm.middleware());
