- [ ] Dependencies audited for vulnerabilities
- [ ] Security patches applied promptly

## Anti Pattern

**1. Security Through Obscurity**

Relying on keeping code/information secret for security. Kerckhoffs's principle: security should not depend on obscurity. Attackers can discover hidden paths. Open design is more trustworthy.

**2. Storing Passwords in Plain Text**

Storing passwords without hashing. Any database breach exposes all passwords. Use strong hashing algorithms. Include salt to prevent rainbow table attacks.

**3. SQL Injection Vulnerabilities**

Building SQL queries with user input. Use parameterized queries always. Never concatenate user input into SQL. ORM usage doesn't guarantee safety.

**4. Not Validating File Uploads**

Allowing arbitrary file uploads. Uploaded files can contain malicious code. Validate file types. Store uploads outside web root. Scan for malware.

**5. Ignoring Security Updates**

Not applying security patches promptly. Known vulnerabilities are actively exploited. Automated patch management. Subscribe to security advisories. Test patches before production.

## Best Practice

**1. JWT Authentication**

```typescript
interface JWTPayload {
  sub: string;           // User ID
  email: string;
  roles: string[];
  permissions: string[];
  iat: number;           // Issued at
  exp: number;           // Expiration
  jti: string;           // JWT ID for revocation
}

class JWTAuthService {
  constructor(
    private config: JWTConfig,
    private userRepository: UserRepository
  ) {}
  
  async generateToken(user: User): Promise<AccessToken> {
    const now = Math.floor(Date.now() / 1000);
    
    const payload: JWTPayload = {
      sub: user.id,
      email: user.email,
      roles: user.roles.map(r => r.name),
      permissions: user.roles.flatMap(r => r.permissions),
      iat: now,
      exp: now + this.config.accessTokenTTL,
      jti: generateUUID()
    };
    
    const token = jwt.sign(payload, this.config.privateKey, {
      algorithm: 'RS256',
      keyid: this.config.keyId
    });
    
    // Store token ID for revocation
    await this.tokenStore.store(payload.jti, {
      userId: user.id,
      expiresAt: payload.exp
    });
    
    return {
      accessToken: token,
      expiresIn: this.config.accessTokenTTL,
      tokenType: 'Bearer'
    };
  }
  
  async verifyToken(token: string): Promise<JWTPayload | null> {
    try {
      const payload = jwt.verify(token, this.config.publicKey, {
        algorithms: ['RS256']
      }) as JWTPayload;
      
      // Check if token is revoked
      const stored = await this.tokenStore.get(payload.jti);
      if (!stored) {
        return null; // Token revoked
      }
      
      return payload;
    } catch (error) {
      return null;
    }
  }
  
  async revokeToken(tokenId: string): Promise<void> {
    await this.tokenStore.delete(tokenId);
  }
}

// Token refresh with rotation
class RefreshTokenService {
  async refresh(
    refreshToken: string
  ): Promise<{ accessToken: string; refreshToken: string }> {
    const payload = await this.verifyRefreshToken(refreshToken);
    
    // Revoke old refresh token
    await this.revokeRefreshToken(refreshToken);
    
    // Generate new tokens
    const user = await this.userRepository.findById(payload.sub);
    const accessToken = await this.jwtService.generateToken(user);
    const newRefreshToken = await this.generateRefreshToken(user);
    
    return {
      accessToken: accessToken.accessToken,
      refreshToken: newRefreshToken
    };
  }
}
```

**2. Role-Based Access Control**

```typescript
// Permission definitions
const Permissions = {
  USERS_READ: 'users:read',
  USERS_WRITE: 'users:write',
  USERS_DELETE: 'users:delete',
  ORDERS_READ: 'orders:read',
  ORDERS_WRITE: 'orders:write',
  REPORTS_VIEW: 'reports:view',
  ADMIN_ACCESS: 'admin:access'
} as const;

type Permission = typeof Permissions[keyof typeof Permissions];

// Role definitions
const Roles = {
  ADMIN: 'admin',
  MANAGER: 'manager',
  USER: 'user',
  GUEST: 'guest'
} as const;

const RolePermissions: Record<string, Permission[]> = {
  [Roles.ADMIN]: [
    Permissions.USERS_READ,
    Permissions.USERS_WRITE,
    Permissions.USERS_DELETE,
    Permissions.ORDERS_READ,
    Permissions.ORDERS_WRITE,
    Permissions.REPORTS_VIEW,
    Permissions.ADMIN_ACCESS
  ],
  [Roles.MANAGER]: [
    Permissions.USERS_READ,
    Permissions.ORDERS_READ,
    Permissions.ORDERS_WRITE,
    Permissions.REPORTS_VIEW
  ],
  [Roles.USER]: [
    Permissions.ORDERS_READ,
    Permissions.ORDERS_WRITE
  ],
  [Roles.GUEST]: [
    Permissions.USERS_READ
  ]
};

// Authorization middleware
class AuthorizationMiddleware {
  constructor(
    private permissionChecker: PermissionChecker
  ) {}
  
  requirePermission(...requiredPermissions: Permission[]) {
    return async (
      request: Request,
      response: Response,
      next: NextFunction
    ) => {
      const user = request.user;
      
      if (!user) {
        return response.status(401).json({
          error: 'Unauthorized'
        });
      }
      
      // Check if user has ALL required permissions
      const hasAllPermissions = requiredPermissions.every(
        permission => user.permissions.includes(permission)
      );
      
      if (!hasAllPermissions) {
        return response.status(403).json({
          error: 'Forbidden',
          required: requiredPermissions
        });
      }
      
      next();
    };
  }
  
  requireRole(...requiredRoles: string[]) {
    return async (
      request: Request,
      response: Response,
      next: NextFunction
    ) => {
      const user = request.user;
      
      if (!user) {
        return response.status(401).json({
          error: 'Unauthorized'
        });
      }
      
      const hasRole = user.roles.some(
        role => requiredRoles.includes(role)
      );
      
      if (!hasRole) {
        return response.status(403).json({
          error: 'Forbidden',
          requiredRoles
        });
      }
      
      next();
    };
  }
}

// Usage
router.post('/users',
  authMiddleware.authenticate(),
  authzMiddleware.requirePermission(Permissions.USERS_WRITE),
  userController.create
);
```

**3. Input Validation with Zod**

```typescript
import { z } from 'zod';

// User creation schema
const CreateUserSchema = z.object({
  email: z.string().email().max(255),
  name: z.string().min(1).max(100).regex(/^[a-zA-Z\s'-]+$/),
  password: z.string()
    .min(8)
    .max(128)
    .regex(/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]+$/),
  roleIds: z.array(z.string().uuid()).min(1).max(10)
});

// Order creation schema
const CreateOrderSchema = z.object({
  customerId: z.string().uuid(),
  items: z.array(z.object({
    productId: z.string().uuid(),
    quantity: z.number().int().positive().max(1000)
  })).min(1).max(100),
  shippingAddress: z.object({
    street: z.string().max(500),
    city: z.string().max(100),
    state: z.string().max(100),
    country: z.string().length(2),
    postalCode: z.string().max(20)
  }),
  promoCode: z.string().max(50).optional()
});

// Validation middleware
class ValidationMiddleware {
  validate<T>(schema: z.ZodSchema<T>) {
    return async (
      request: Request,
      response: Response,
      next: NextFunction
    ) => {
      try {
        const validated = await schema.parseAsync(request.body);
        request.validatedBody = validated;
        next();
      } catch (error) {
        if (error instanceof z.ZodError) {
          return response.status(400).json({
            error: 'Validation failed',
            details: error.errors.map(err => ({
              path: err.path.join('.'),
              message: err.message
            }))
          });
        }
        next(error);
      }
    };
  }
  
  validateQuery<T>(schema: z.ZodSchema<T>) {
    return async (
      request: Request,
      response: Response,
      next: NextFunction
    ) => {
      try {
        const validated = await schema.parseAsync(request.query);
        request.validatedQuery = validated;
        next();
      } catch (error) {
        if (error instanceof z.ZodError) {
          return response.status(400).json({
            error: 'Invalid query parameters',
            details: error.errors
          });
        }
        next(error);
      }
    };
  }
}

// Usage
router.post('/users',
  validationMiddleware.validate(CreateUserSchema),
  userController.create
);
```

**4. Secure File Upload**

```typescript
class SecureFileUploadService {
  constructor(
    private storage: CloudStorage,
    private virusScanner: VirusScanner,
    private config: FileUploadConfig
  ) {}
  
  async uploadFile(
    file: Express.Multer.File,
    userId: string
  ): Promise<UploadResult> {
    // Validate file size
    if (file.size > this.config.maxFileSize) {
      throw new ValidationError('File too large');
    }
    
    // Validate file type
    const allowedMimeTypes = [
      'image/jpeg',
      'image/png',
      'application/pdf',
      'application/msword',
      'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
    ];
    
    if (!allowedMimeTypes.includes(file.mimetype)) {
      throw new ValidationError('File type not allowed');
    }
    
    // Validate file extension matches mime type
    const detectedMimeType = await this.detectMimeType(file.buffer);
    if (detectedMimeType !== file.mimetype) {
      throw new ValidationError('File type mismatch');
    }
    
    // Scan for viruses
    const scanResult = await this.virusScanner.scan(file.buffer);
    if (!scanResult.safe) {
      throw new SecurityError(`File contains malware: ${scanResult.threat}`);
    }
    
    // Generate secure filename
    const extension = path.extname(file.originalname);
    const secureFilename = `${generateUUID()}${extension}`;
    
    // Generate path outside web root
    const storagePath = `uploads/${userId}/${secureFilename}`;
    
    // Upload to cloud storage
    const url = await this.storage.upload(file.buffer, {
      path: storagePath,
      contentType: file.mimetype,
      metadata: {
        uploadedBy: userId,
        originalName: sanitizeFilename(file.originalname)
      }
    });
    
    return {
      url,
      filename: secureFilename,
      size: file.size,
      mimeType: file.mimetype
    };
  }
  
  private async detectMimeType(buffer: Buffer): Promise<string> {
    // Use file-type library for magic bytes detection
    const fileType = await fileTypeFromBuffer(buffer);
    return fileType?.mime || 'application/octet-stream';
  }
}
```

**5. Encryption Service**

```typescript
class EncryptionService {
  constructor(
    private keyManagement: KeyManagementService,
    private config: EncryptionConfig
  ) {}
  
  async encryptData(data: string): Promise<EncryptedData> {
    const key = await this.keyManagement.getDataEncryptionKey();
    const iv = crypto.randomBytes(16);
    
    const cipher = crypto.createCipheriv(
      'aes-256-gcm',
      key,
      iv
    );
    
    let encrypted = cipher.update(data, 'utf8', 'hex');
    encrypted += cipher.final('hex');
    
    const authTag = cipher.getAuthTag();
    
    return {
      encryptedData: encrypted,
      iv: iv.toString('hex'),
      authTag: authTag.toString('hex'),
      keyId: this.keyManagement.getCurrentKeyId()
    };
  }
  
  async decryptData(encrypted: EncryptedData): Promise<string> {
    const key = await this.keyManagement.getDataEncryptionKey(
      encrypted.keyId
    );
    const iv = Buffer.from(encrypted.iv, 'hex');
    const authTag = Buffer.from(encrypted.authTag, 'hex');
    
    const decipher = crypto.createDecipheriv(
      'aes-256-gcm',
      key,
      iv
    );
    decipher.setAuthTag(authTag);
    
    let decrypted = decipher.update(encrypted.encryptedData, 'hex', 'utf8');
    decrypted += decipher.final('utf8');
    
    return decrypted;
  }
  
  // Field-level encryption
  async encryptField<T extends object>(
    data: T,
    fieldsToEncrypt: (keyof T)[]
  ): Promise<T> {
    const result = { ...data };
    
    for (const field of fieldsToEncrypt) {
      const value = data[field];
      if (value !== undefined && value !== null) {
        const encrypted = await this.encryptData(String(value));
        (result as any)[field] = Buffer.from(JSON.stringify(encrypted)).toString('base64');
      }
    }
    
    return result;
  }
}
```

## Workflow

**Phase 1: Threat Modeling**

Identify assets cần protect. Map data flows. Identify potential threats. Assess risk levels. Prioritize security controls.

**Phase 2: Security Design**

Design security architecture. Select security controls. Plan authentication/authorization. Define encryption requirements. Document security requirements.

**Phase 3: Implementation**

Implement security controls. Follow secure coding practices. Use secure libraries. Implement input validation. Configure security settings.

**Phase 4: Testing**

Security unit tests. Integration security tests. Penetration testing. Vulnerability scanning. Security code review.

**Phase 5: Deployment**

Secure configuration. Security monitoring setup. Incident response plan. Security training. Documentation.

**Phase 6: Maintenance**

Regular security audits. Monitor for vulnerabilities. Apply security patches. Update security controls. Review access rights.

## Ví dụ

**Ví dụ 1: Multi-Factor Authentication**

```typescript
class MFAService {
  constructor(
    private totp: TOTPService,
    private backupCodes: BackupCodeService,
    private userRepository: UserRepository
  ) {}
  
  async setupMFA(userId: string): Promise<MFASetupResult> {
    const user = await this.userRepository.findById(userId);
    
    // Generate TOTP secret
    const secret = this.totp.generateSecret({
      issuer: 'CursorFramework',
      accountName: user.email
    });
    
    // Generate backup codes
    const backupCodes = this.backupCodes.generate(10);
    
    // Store encrypted secret
    await this.userRepository.update(userId, {
      mfaSecret: await this.encryptSecret(secret),
      mfaBackupCodes: await this.hashBackupCodes(backupCodes),
      mfaEnabled: false,
      mfaSetupAt: new Date()
    });
    
    return {
      secret,
      qrCode: this.totp.generateQRCode(secret),
      backupCodes
    };
  }
  
  async verifyAndEnable(
    userId: string,
    token: string
  ): Promise<boolean> {
    const user = await this.userRepository.findById(userId);
    
    if (!user.mfaSecret) {
      throw new Error('MFA not set up');
    }
    
    const secret = await this.decryptSecret(user.mfaSecret);
    const isValid = this.totp.verify(secret, token);
    
    if (isValid) {
      await this.userRepository.update(userId, {
        mfaEnabled: true,
        mfaVerifiedAt: new Date()
      });
    }
    
    return isValid;
  }
  
  async authenticate(
    userId: string,
    password: string,
    mfaToken?: string
  ): Promise<AuthResult> {
    const user = await this.userRepository.findById(userId);
    
    // Verify password
    const passwordValid = await this.verifyPassword(password, user.passwordHash);
    if (!passwordValid) {
      await this.recordFailedAttempt(userId);
      throw new AuthenticationError('Invalid credentials');
    }
    
    // Check if MFA is enabled
    if (user.mfaEnabled) {
      if (!mfaToken) {
        return {
          requiresMFA: true,
          methods: ['totp', 'backup']
        };
      }
      
      // Verify MFA token
      const secret = await this.decryptSecret(user.mfaSecret);
      
      // Check backup code first
      if (this.backupCodes.isBackupCode(mfaToken, user.mfaBackupCodes)) {
        await this.backupCodes.markAsUsed(userId, mfaToken);
      } else if (!this.totp.verify(secret, mfaToken)) {
        await this.recordFailedAttempt(userId);
        throw new AuthenticationError('Invalid MFA token');
      }
    }
    
    await this.clearFailedAttempts(userId);
    return { requiresMFA: false };
  }
}
```

**Ví dụ 2: API Key Management**

```typescript
class APIKeyService {
  constructor(
    private db: Database,
    private encryption: EncryptionService
  ) {}
  
  async createAPIKey(
    userId: string,
    name: string,
    scopes: string[],
    expiresIn?: number
  ): Promise<CreatedAPIKey> {
    const keyId = this.generateKeyId();
    const secretHash = await this.hashSecret(this.generateSecret());
    
    const apiKey: APIKey = {
      id: generateUUID(),
      keyId,
      name,
      userId,
      scopes,
      createdAt: new Date(),
      expiresAt: expiresIn ? addDays(new Date(), expiresIn) : null,
      lastUsedAt: null,
      isActive: true
    };
    
    await this.db.apiKeys.create(apiKey);
    
    return {
      ...apiKey,
      secret: `${keyId}.${this.generateSecret()}` // Full key only shown once
    };
  }
  
  async verifyAPIKey(
    keyId: string,
    secret: string
  ): Promise<VerifiedKey | null> {
    const apiKey = await this.db.apiKeys.findByKeyId(keyId);
    
    if (!apiKey || !apiKey.isActive) {
      return null;
    }
    
    // Check expiration
    if (apiKey.expiresAt && apiKey.expiresAt < new Date()) {
      return null;
    }
    
    // Verify secret
    const isValid = await this.verifySecret(secret, apiKey.secretHash);
    if (!isValid) {
      return null;
    }
    
    // Update last used
    await this.db.apiKeys.update(apiKey.id, {
      lastUsedAt: new Date()
    });
    
    return {
      keyId: apiKey.keyId,
      userId: apiKey.userId,
      scopes: apiKey.scopes
    };
  }
  
  async revokeAPIKey(keyId: string): Promise<void> {
    await this.db.apiKeys.update(
      { keyId },
      { isActive: false, revokedAt: new Date() }
    );
  }
}
```

**Ví dụ 3: Security Headers**

```typescript
// Security headers middleware
function securityHeadersMiddleware(
  request: Request,
  response: Response,
  next: NextFunction
) {
  // Prevent XSS
  response.setHeader('X-XSS-Protection', '1; mode=block');
  response.setHeader('Content-Security-Policy', 
    "default-src 'self'; " +
    "script-src 'self' 'nonce-{NONCE}'; " +
    "style-src 'self' 'unsafe-inline'; " +
    "img-src 'self' data: https:; " +
    "font-src 'self'; " +
    "connect-src 'self' https://api.example.com; " +
    "frame-ancestors 'none';"
  );
  
  // Prevent clickjacking
  response.setHeader('X-Frame-Options', 'DENY');
  
  // Prevent MIME sniffing
  response.setHeader('X-Content-Type-Options', 'nosniff');
  
  // HSTS (HTTP Strict Transport Security)
  response.setHeader(
    'Strict-Transport-Security',
    'max-age=31536000; includeSubDomains; preload'
  );
  
  // Referrer Policy
  response.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
  
  // Permissions Policy
  response.setHeader(
    'Permissions-Policy',
    'geolocation=(), microphone=(), camera=(), payment=(self)'
  );
  
  // Cache control for sensitive data
  response.setHeader('Cache-Control', 'no-store, no-cache, must-revalidate');
  response.setHeader('Pragma', 'no-cache');
  
  next();
}
```

