## Anti Patterns

### 1. Hardcoded Role Checks

```typescript
// Không nên - hardcoded role check
if (req.user.role === 'ADMIN') {
    // Admin action
}

// Nên - permission-based check
if (await permissionService.hasPermission(req.user.id, Permission.USER_MANAGE)) {
    // Action
}
```

### 2. Client-Side Authorization Only

```typescript
// Không nên - client-side only check
const canDelete = user.role === 'admin'; // Client decides!

// Nên - server-side authorization
async function deletePost(req: Request, res: Response) {
    const canDelete = await permissionService.canDelete(req.user.id, req.params.id);
    if (!canDelete) {
        throw new AuthorizationError();
    }
    // Proceed with deletion
}
```

### 3. Missing Default Deny

```typescript
// Không nên - implicit allow
async function accessResource(userId: string, resourceId: string) {
    // No check! Implicitly allows access
    return resource;
}

// Nên - explicit check with default deny
async function accessResource(userId: string, resourceId: string) {
    const hasAccess = await permissionService.canAccess(userId, resourceId);
    if (!hasAccess) {
        throw new AuthorizationError('Access denied');
    }
    return resource;
}
```

### 4. Permission Proliferation

```typescript
// Không nên - too many granular permissions
Permission.POST_UPDATE_OWN
Permission.POST_UPDATE_TEAM
Permission.POST_UPDATE_PUBLIC
Permission.POST_UPDATE_PRIVATE
// ... too many!

// Nên - logical grouping
Permission.POST_UPDATE // with resource ownership check
Permission.POST_MANAGE // for admins
```

### 5. No Audit Trail

```typescript
// Không nên - no logging
async function deleteUser(id: string) {
    await db.users.delete(id);
    // No record of who deleted, when, why
}

// Nên - comprehensive audit
async function deleteUser(id: string, deletedBy: string, reason: string) {
    await auditLog.log({ userId: deletedBy, action: 'DELETE', resource: id, reason });
    await db.users.delete(id);
}
```

## Best Practices

### 1. Centralized Permission Service

```typescript
class PermissionService {
    constructor(
        private roleRepository: RoleRepository,
        private cache: RedisClient
    ) {}

    async hasPermission(userId: string, permission: Permission): Promise<boolean> {
        const userPermissions = await this.getUserPermissions(userId);
        return userPermissions.includes(permission);
    }

    async hasAllPermissions(userId: string, permissions: Permission[]): Promise<boolean> {
        const userPermissions = await this.getUserPermissions(userId);
        return permissions.every(p => userPermissions.includes(p));
    }

    async hasAnyPermission(userId: string, permissions: Permission[]): Promise<boolean> {
        const userPermissions = await this.getUserPermissions(userId);
        return permissions.some(p => userPermissions.includes(p));
    }

    private async getUserPermissions(userId: string): Promise<Permission[]> {
        // Check cache
        const cached = await this.cache.get(`permissions:${userId}`);
        if (cached) {
            return JSON.parse(cached);
        }

        // Get from database
        const user = await this.userRepository.findByIdWithRoles(userId);
        const permissions = getEffectivePermissions(user.primaryRole);

        // Cache for 5 minutes
        await this.cache.setex(`permissions:${userId}`, 300, JSON.stringify(permissions));

        return permissions;
    }
}
```

### 2. Policy Engine

```typescript
class PolicyEngine {
    constructor(
        private policies: Policy[],
        private abacEngine: ABACEngine
    ) {}

    async evaluate(
        subject: SubjectAttributes,
        resource: any,
        action: string,
        environment?: EnvironmentAttributes
    ): Promise<AuthorizationDecision> {
        // First check RBAC
        const hasPermission = this.checkRBAC(subject, action);
        if (!hasPermission) {
            return { allowed: false, reason: 'Permission denied by RBAC' };
        }

        // Then check ABAC policies
        const env = environment || this.getDefaultEnvironment();
        const abacResult = this.abacEngine.evaluate(subject, resource, action, env);

        if (!abacResult) {
            return { allowed: false, reason: 'Permission denied by ABAC policy' };
        }

        return { allowed: true };
    }

    private checkRBAC(subject: SubjectAttributes, action: string): boolean {
        const requiredPermission = this.getPermissionForAction(action);
        return subject.permissions.includes(requiredPermission);
    }
}
```

