### 2. Ubiquitous Language

Establish shared language between team members.

```typescript
// Order Domain - Ubiquitous Language

// Entities
class Order {
    id: OrderId;
    customer: Customer;
    status: OrderStatus;
    items: OrderItem[];
    shippingAddress: Address;
    billingAddress: Address;

    addItem(product: Product, quantity: Quantity): void;
    removeItem(productId: ProductId): void;
    confirm(payment: Payment): void;
    ship(): void;
    deliver(): void;
    cancel(): void;
}

class OrderItem {
    id: OrderItemId;
    product: Product;
    quantity: Quantity;
    unitPrice: Money;
    totalPrice: Money;
}

class Customer {
    id: CustomerId;
    name: CustomerName;
    email: EmailAddress;
    addresses: Address[];

    addAddress(address: Address): void;
    removeAddress(addressId: AddressId): void;
}

// Value Objects
class Address {
    street: Street;
    city: City;
    state: State;
    postalCode: PostalCode;
    country: Country;

    equals(other: Address): boolean;
}

class Money {
    amount: number;
    currency: Currency;

    add(other: Money): Money;
    multiply(factor: number): Money;
}

class Quantity {
    value: number;
    unit: QuantityUnit;

    isGreaterThan(other: Quantity): boolean;
}

// Domain Events
type OrderDomainEvent =
    | OrderCreatedEvent
    | OrderItemAddedEvent
    | OrderConfirmedEvent
    | OrderShippedEvent
    | OrderDeliveredEvent
    | OrderCancelledEvent;

// Aggregates
class OrderAggregate extends AggregateRoot<OrderDomainEvent> {
    private status: OrderStatus = OrderStatus.DRAFT;
    private items: OrderItem[] = [];
    private shippingAddress: Address | null = null;

    // Business invariant
    private get canBeConfirmed(): boolean {
        return this.status === OrderStatus.DRAFT &&
               this.items.length > 0 &&
               this.shippingAddress !== null;
    }

    confirm(paymentId: string): void {
        if (!this.canBeConfirmed) {
            throw new BusinessRuleViolation(
                'Order cannot be confirmed. Ensure order has items and shipping address.'
            );
        }

        this.addEvent(OrderConfirmedEvent.create(this.id, paymentId));
    }
}
```

### 3. Entities và Value Objects

Distinguish between entities và value objects.

```typescript
// Entity - has identity
class Order extends Entity<OrderId> {
    private id: OrderId;
    private status: OrderStatus;

    // Identity-based equality
    equals(other: Order): boolean {
        return this.id.equals(other.id);
    }
}

// Value Object - no identity, immutable
class Money extends ValueObject {
    constructor(
        private readonly amount: number,
        private readonly currency: Currency
    ) {
        super();
        Object.freeze(this);
    }

    equals(other: Money): boolean {
        return this.amount === other.amount &&
               this.currency === other.currency;
    }

    add(other: Money): Money {
        this.assertSameCurrency(other);
        return new Money(this.amount + other.amount, this.currency);
    }

    // Factory methods
    static zero(currency: Currency): Money {
        return new Money(0, currency);
    }

    static fromDecimal(amount: number, currency: Currency): Money {
        if (amount < 0) {
            throw new DomainException('Amount cannot be negative');
        }
        return new Money(Math.round(amount * 100) / 100, currency);
    }
}

// Base classes
abstract class Entity<TId extends ValueObject> {
    abstract get id(): TId;
    abstract equals(other: Entity<TId>): boolean;
}

abstract class ValueObject {
    abstract equals(other: ValueObject): boolean;

    get hashCode(): number {
        return JSON.stringify(this).split('').reduce((a, b) => {
            return ((a << 5) - a) + b.charCodeAt(0);
        }, 0);
    }
}
```

### 4. Aggregates

Design aggregates properly.

```typescript
// Aggregate Root
class OrderAggregate extends AggregateRoot<OrderDomainEvent> {
    private id: OrderId;
    private status: OrderStatus;
    private items: OrderItem[];
    private customerId: CustomerId;
    private shippingAddress: Address;
    private totalAmount: Money;

    // Only methods on aggregate root can be called
    // External objects hold references only to aggregate root

    // Factory method
    static create(
        customerId: CustomerId,
        shippingAddress: Address
    ): OrderAggregate {
        const order = new OrderAggregate(OrderId.generate());
        order.createOrder(customerId, shippingAddress);
        return order;
    }

    // Private business methods
    private createOrder(customerId: CustomerId, shippingAddress: Address): void {
        this.addDomainEvent(
            new OrderCreatedEvent(
                this.id,
                customerId,
                shippingAddress
            )
        );
    }

    // Public commands
    addItem(product: Product, quantity: Quantity): void {
        this.ensureStatusIs(OrderStatus.DRAFT);

        const item = new OrderItem(
            OrderItemId.generate(),
            product,
            quantity,
            product.price
        );

        this.addDomainEvent(new OrderItemAddedEvent(this.id, item));
    }

    confirm(paymentId: string): void {
        this.ensureStatusIs(OrderStatus.DRAFT);
        this.ensureHasItems();
        this.ensureShippingAddressSet();

        this.addDomainEvent(new OrderConfirmedEvent(this.id, paymentId));
    }

    // Invariants
    private ensureStatusIs(status: OrderStatus): void {
        if (this.status !== status) {
            throw new OrderStatusException(
                `Order status must be ${status}, but is ${this.status}`
            );
        }
    }

    private ensureHasItems(): void {
        if (this.items.length === 0) {
            throw new OrderEmptyException();
        }
    }

    // Event handlers
    protected applyOrderCreated(event: OrderCreatedEvent): void {
        this.id = event.orderId;
        this.customerId = event.customerId;
        this.shippingAddress = event.shippingAddress;
        this.status = OrderStatus.DRAFT;
        this.items = [];
        this.totalAmount = Money.zero(Currency.USD);
    }

    protected applyOrderItemAdded(event: OrderItemAddedEvent): void {
        this.items.push(event.item);
        this.totalAmount = this.totalAmount.add(event.item.totalPrice);
    }

    protected applyOrderConfirmed(event: OrderConfirmedEvent): void {
        this.status = OrderStatus.CONFIRMED;
    }
}

// Order Repository - only manages Order aggregate
interface OrderRepository {
    save(order: OrderAggregate): Promise<void>;
    findById(id: OrderId): Promise<OrderAggregate | null>;
    findByCustomer(customerId: CustomerId): Promise<OrderAggregate[]>;
}
```

### 5. Domain Services

Implement domain services when needed.

```typescript
// Domain Service - when operation doesn't belong to entity
class OrderPricingService {
    calculateOrderTotal(items: OrderItem[]): Money {
        const subtotal = items.reduce(
            (sum, item) => sum.add(item.totalPrice),
            Money.zero(Currency.USD)
        );

        return subtotal;
    }

    calculateDiscount(order: Order, customerTier: CustomerTier): Money {
        if (customerTier === CustomerTier.PREMIUM) {
            return this.calculateOrderTotal(order.items)
                .multiply(0.1); // 10% discount
        }
        return Money.zero(Currency.USD);
    }
}

// Application Service - orchestrates domain services
class OrderApplicationService {
    constructor(
        private orderRepository: OrderRepository,
        private pricingService: OrderPricingService,
        private inventoryService: InventoryDomainService,
        private paymentService: PaymentDomainService
    ) {}

    async createOrder(command: CreateOrderCommand): Promise<OrderResult> {
        // Create aggregate
        const order = OrderAggregate.create(
            command.customerId,
            command.shippingAddress
        );

        // Add items
        for (const item of command.items) {
            const product = await this.inventoryService.getProduct(item.productId);
            order.addItem(product, item.quantity);
        }

        // Calculate pricing
        const subtotal = this.pricingService.calculateOrderTotal(order.items);
        const discount = this.pricingService.calculateDiscount(
            order,
            command.customerTier
        );

        // Save
        await this.orderRepository.save(order);

        return {
            orderId: order.id.value,
            subtotal: subtotal.value,
            discount: discount.value,
            total: subtotal.subtract(discount).value
        };
    }
}
```

### 6. Repositories

Implement repositories for aggregate persistence.

```typescript
// Repository interface - belongs to domain
interface OrderRepository {
    save(order: OrderAggregate): Promise<void>;
    findById(id: OrderId): Promise<OrderAggregate | null>;
    findByCustomer(customerId: CustomerId): Promise<OrderAggregate[]>;
    findByStatus(status: OrderStatus): Promise<OrderAggregate[]>;
}

// Repository implementation - infrastructure concern
class PostgresOrderRepository implements OrderRepository {
    constructor(
        private db: Database,
        private eventStore: EventStore
    ) {}

    async save(order: OrderAggregate): Promise<void> {
        const events = order.getUncommittedEvents();
        await this.eventStore.save(events);
        order.markEventsAsCommitted();
    }

    async findById(id: OrderId): Promise<OrderAggregate | null> {
        const events = await this.eventStore.getByAggregateId(id);

        if (events.length === 0) {
            return null;
        }

        return OrderAggregate.fromEvents(id, events);
    }

    async findByCustomer(customerId: CustomerId): Promise<OrderAggregate[]> {
        const orders = await this.db.query(`
            SELECT DISTINCT aggregate_id
            FROM events
            WHERE aggregate_type = 'Order'
            AND payload->>'customerId' = $1
            ORDER BY timestamp DESC
        `, [customerId.value]);

        return Promise.all(
            orders.map(o => this.findById(new OrderId(o.aggregate_id)))
        );
    }
}

// Collection-like interface
class OrderCollection implements OrderRepository {
    private orders: Map<string, OrderAggregate> = new Map();

    add(order: OrderAggregate): void {
        this.orders.set(order.id.value, order);
    }

    remove(id: OrderId): void {
        this.orders.delete(id.value);
    }
}
```

### 7. Domain Events

Design và emit domain events.

```typescript
// Base domain event
interface DomainEvent {
    readonly occurredOn: Date;
    readonly eventType: string;
}

// Order events
interface OrderCreatedEvent extends DomainEvent {
    readonly eventType = 'OrderCreated';
    constructor(
        public readonly orderId: OrderId,
        public readonly customerId: CustomerId,
        public readonly shippingAddress: Address
    ) {}
}

interface OrderItemAddedEvent extends DomainEvent {
    readonly eventType = 'OrderItemAdded';
    constructor(
        public readonly orderId: OrderId,
        public readonly item: OrderItem
    ) {}
}

interface OrderConfirmedEvent extends DomainEvent {
    readonly eventType = 'OrderConfirmed';
    constructor(
        public readonly orderId: OrderId,
        public readonly paymentId: string
    ) {}
}

// Event factory
class OrderDomainEventFactory {
    static created(
        orderId: OrderId,
        customerId: CustomerId,
        shippingAddress: Address
    ): OrderCreatedEvent {
        return {
            occurredOn: new Date(),
            eventType: 'OrderCreated',
            orderId,
            customerId,
            shippingAddress
        };
    }
}

// Aggregate with event publishing
class OrderAggregate extends AggregateRoot<OrderDomainEvent> {
    addDomainEvent(event: DomainEvent): void {
        this.domainEvents.push(event);

        // Dispatch immediately for domain event handling
        DomainEventDispatcher.dispatch(event);
    }
}

// Event dispatcher
class DomainEventDispatcher {
    private static handlers: Map<string, DomainEventHandler[]> = new Map();

    static register(eventType: string, handler: DomainEventHandler): void {
        const handlers = this.handlers.get(eventType) || [];
        handlers.push(handler);
        this.handlers.set(eventType, handlers);
    }

    static async dispatch(event: DomainEvent): Promise<void> {
        const handlers = this.handlers.get(event.eventType) || [];

        await Promise.all(
            handlers.map(handler => handler.handle(event))
        );
    }
}
```

