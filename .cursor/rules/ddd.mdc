    }
}

// Bounded Context - Order
namespace OrderContext {
    class Order {
        id: OrderId;
        customerId: CustomerId;
        status: OrderStatus;
        items: OrderItem[];
    }

    class OrderRepository {
        findByCustomer(customerId: CustomerId): Order[];
        findPending(): Order[];
    }
}

// Context Mapping - Anti-Corruption Layer
class OrderToCatalogAdapter {
    constructor(
        private catalogGateway: CatalogContext.ProductGateway
    ) {}

    getProductDetails(productId: CatalogContext.ProductId): ProductDetails {
        const product = this.catalogGateway.findById(productId);

        // Transform to Order context model
        return new ProductDetails(
            product.id.value,
            product.name.value,
            product.price.amount
        );
    }
}
