### 9. Application Services

Implement application services for use cases.

```typescript
// Application service
class OrderApplicationService {
    constructor(
        private orderRepository: OrderRepository,
        private productRepository: CatalogContext.ProductRepository,
        private eventBus: EventBus,
        private logger: Logger
    ) {}

    // Use case: Place order
    async placeOrder(command: PlaceOrderCommand): Promise<PlaceOrderResult> {
        this.logger.info('Placing order', { customerId: command.customerId });

        // 1. Get customer
        const customer = await this.customerService.getCustomer(command.customerId);

        // 2. Create order aggregate
        const order = Order.create(
            customer.id,
            command.shippingAddress,
            command.billingAddress
        );

        // 3. Add items
        for (const itemCommand of command.items) {
            const product = await this.productRepository.findById(itemCommand.productId);
            order.addItem(product, itemCommand.quantity);
        }

        // 4. Calculate total
        const total = order.calculateTotal();

        // 5. Save aggregate
        await this.orderRepository.save(order);

        // 6. Publish domain events
        for (const event of order.getDomainEvents()) {
            await this.eventBus.publish(event);
        }

        this.logger.info('Order placed', { orderId: order.id.value });

        return {
            orderId: order.id.value,
            orderNumber: order.orderNumber,
            total: total.value
        };
    }

    // Use case: Confirm order
    async confirmOrder(command: ConfirmOrderCommand): Promise<void> {
        const order = await this.orderRepository.findById(command.orderId);

        if (!order) {
            throw new OrderNotFoundException(command.orderId);
        }

        order.confirm(command.paymentId);

        await this.orderRepository.save(order);
    }
}

// DTO for application layer
interface PlaceOrderResult {
    orderId: string;
    orderNumber: string;
    total: number;
}
```

### 10. Testing Domain Models

Test domain logic properly.

```typescript
describe('OrderAggregate', () => {
    describe('addItem', () => {
        it('should add item to draft order', () => {
            const order = Order.create(
                customerId,
                testAddress()
            );

            const product = new Product(
                ProductId.generate(),
                new ProductName('Test Product'),
                Money.fromDecimal(100, Currency.USD)
            );

            order.addItem(product, new Quantity(2, QuantityUnit.PIECE));

            expect(order.items).toHaveLength(1);
            expect(order.totalAmount.amount).toBe(200);
        });

        it('should not add item to confirmed order', () => {
            const order = createConfirmedOrder();

            const product = new Product(/* ... */);

            expect(() => {
                order.addItem(product, new Quantity(1, QuantityUnit.PIECE));
            }).toThrow(OrderStatusException);
        });

        it('should not add zero quantity item', () => {
            const order = Order.create(customerId, testAddress());

            const product = new Product(/* ... */);

            expect(() => {
                order.addItem(product, new Quantity(0, QuantityUnit.PIECE));
            }).toThrow(DomainException);
        });
    });

    describe('confirm', () => {
        it('should confirm order with items and address', () => {
            const order = Order.create(customerId, testAddress());
            order.addItem(testProduct(), new Quantity(1, QuantityUnit.PIECE));

            order.confirm('payment-123');

            expect(order.status).toBe(OrderStatus.CONFIRMED);
            expect(order.getDomainEvents()).toContainEqual(
                expect.objectContaining({
                    eventType: 'OrderConfirmed'
                })
            );
        });

        it('should not confirm empty order', () => {
            const order = Order.create(customerId, testAddress());

            expect(() => order.confirm('payment-123')).toThrow(OrderEmptyException);
        });

        it('should not confirm already confirmed order', () => {
            const order = createConfirmedOrder();

            expect(() => order.confirm('payment-456')).toThrow(OrderStatusException);
        });
    });
});

// Testing value objects
describe('Money', () => {
    it('should add money with same currency', () => {
        const m1 = Money.fromDecimal(100, Currency.USD);
        const m2 = Money.fromDecimal(50, Currency.USD);

        const result = m1.add(m2);

        expect(result.amount).toBe(150);
        expect(result.currency).toBe(Currency.USD);
    });

    it('should not add money with different currencies', () => {
        const m1 = Money.fromDecimal(100, Currency.USD);
        const m2 = Money.fromDecimal(50, Currency.EUR);

        expect(() => m1.add(m2)).toThrow(CurrencyMismatchException);
    });

    it('should be immutable', () => {
        const m1 = Money.fromDecimal(100, Currency.USD);
        const m2 = Money.fromDecimal(50, Currency.USD);

        m1.add(m2);

        expect(m1.amount).toBe(100);
    });
});
