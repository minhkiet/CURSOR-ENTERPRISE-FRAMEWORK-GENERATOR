```typescript
// Replace primitives with value objects
class OrderItem {
    constructor(
        private readonly id: OrderItemId,        // Value object
        private readonly productId: ProductId,  // Value object
        private readonly quantity: Quantity,     // Value object
        private readonly price: Money           // Value object
    ) {}

    get totalPrice(): Money {
        return this.price.multiply(this.quantity.value);
    }
}

// vs primitive obsession
class BadOrderItem {
    constructor(
        private id: string,
        private productId: string,
        private quantity: number,  // No type safety
        private price: number      // No currency
    ) {}
