### Ví dụ 1: Complete Order Aggregate

```typescript
// Order Aggregate with full DDD implementation
class OrderAggregate extends AggregateRoot<OrderDomainEvent> {
    private _id: OrderId;
    private _status: OrderStatus = OrderStatus.DRAFT;
    private _items: OrderItem[] = [];
    private _customerId: CustomerId;
    private _shippingAddress: Address;
    private _billingAddress: Address;
    private _paymentId: PaymentId | null = null;
    private _totalAmount: Money = Money.zero(Currency.USD);
    private _discountAmount: Money = Money.zero(Currency.USD);

    // Factory
    static create(
        customerId: CustomerId,
        shippingAddress: Address,
        billingAddress: Address
    ): OrderAggregate {
        const order = new OrderAggregate();
        order._id = OrderId.generate();
        order._customerId = customerId;
        order._shippingAddress = shippingAddress;
        order._billingAddress = billingAddress;

        order.addDomainEvent(OrderCreatedEvent.create(
            order._id,
            customerId,
            shippingAddress
        ));

        return order;
    }

    // Reconstitution from events
    static fromEvents(id: OrderId, events: OrderDomainEvent[]): OrderAggregate {
        const order = new OrderAggregate();
        order._id = id;

        for (const event of events) {
            order.apply(event);
        }

        return order;
    }

    // Commands
    addItem(product: Product, quantity: Quantity): void {
        this.ensureCanModify();
        this.ensureQuantityIsValid(quantity);

        const item = OrderItem.create(product, quantity);
        this._items.push(item);
        this.recalculateTotal();

        this.addDomainEvent(OrderItemAddedEvent.create(this._id, item));
    }

    removeItem(productId: ProductId): void {
        this.ensureCanModify();

        const index = this._items.findIndex(i => i.productId.equals(productId));
        if (index === -1) {
            throw new DomainException('Item not found in order');
        }

        const removedItem = this._items.splice(index, 1)[0];
        this.recalculateTotal();

        this.addDomainEvent(OrderItemRemovedEvent.create(this._id, removedItem));
    }

    confirm(paymentId: PaymentId): void {
        this.ensureCanModify();
        this.ensureHasItems();

        this._status = OrderStatus.CONFIRMED;
        this._paymentId = paymentId;

        this.addDomainEvent(OrderConfirmedEvent.create(this._id, paymentId));
    }

    cancel(reason: CancellationReason): void {
        if (this._status === OrderStatus.DELIVERED) {
            throw new BusinessRuleViolation('Cannot cancel delivered order');
        }

        this._status = OrderStatus.CANCELLED;

        this.addDomainEvent(OrderCancelledEvent.create(this._id, reason));
    }

    // Getters
    get id(): OrderId { return this._id; }
    get status(): OrderStatus { return this._status; }
    get items(): OrderItem[] { return [...this._items]; }
    get totalAmount(): Money { return this._totalAmount; }
    get netAmount(): Money {
        return this._totalAmount.subtract(this._discountAmount);
    }

    // Private helpers
    private ensureCanModify(): void {
        if (this._status !== OrderStatus.DRAFT) {
            throw new BusinessRuleViolation(
                `Cannot modify order in ${this._status} status`
            );
        }
    }

    private ensureHasItems(): void {
        if (this._items.length === 0) {
            throw new BusinessRuleViolation('Order must have at least one item');
        }
    }

    private ensureQuantityIsValid(quantity: Quantity): void {
        if (quantity.value <= 0) {
            throw new DomainException('Quantity must be positive');
        }
    }

    private recalculateTotal(): void {
        this._totalAmount = this._items.reduce(
            (sum, item) => sum.add(item.totalPrice),
            Money.zero(Currency.USD)
        );
    }

    // Event application
    protected apply(event: OrderDomainEvent): void {
        switch (event.eventType) {
            case 'OrderCreated':
                this.applyOrderCreated(event);
                break;
            case 'OrderItemAdded':
                this.applyOrderItemAdded(event);
                break;
            case 'OrderConfirmed':
                this.applyOrderConfirmed(event);
                break;
            case 'OrderCancelled':
                this.applyOrderCancelled(event);
                break;
        }
    }

    private applyOrderCreated(event: OrderCreatedEvent): void {
        this._id = event.orderId;
        this._customerId = event.customerId;
        this._shippingAddress = event.shippingAddress;
        this._status = OrderStatus.DRAFT;
    }

    private applyOrderItemAdded(event: OrderItemAddedEvent): void {
        this._items.push(event.item);
        this.recalculateTotal();
    }

    private applyOrderConfirmed(event: OrderConfirmedEvent): void {
        this._status = OrderStatus.CONFIRMED;
        this._paymentId = event.paymentId;
    }

    private applyOrderCancelled(event: OrderCancelledEvent): void {
        this._status = OrderStatus.CANCELLED;
    }
}
```

### Ví dụ 2: Value Objects

```typescript
// Money value object
class Money extends ValueObject {
    constructor(
        private readonly _amount: number,
        private readonly _currency: Currency
    ) {
        super();
        this.validate();
        Object.freeze(this);
    }

    private validate(): void {
        if (this._amount < 0) {
            throw new DomainException('Money amount cannot be negative');
        }
    }

    get amount(): number { return this._amount; }
    get currency(): Currency { return this._currency; }

    add(other: Money): Money {
        this.assertSameCurrency(other);
        return new Money(this._amount + other._amount, this._currency);
    }

    subtract(other: Money): Money {
        this.assertSameCurrency(other);
        return new Money(this._amount - other._amount, this._currency);
    }

    multiply(factor: number): Money {
        return new Money(this._amount * factor, this._currency);
    }

    equals(other: Money): boolean {
        return this._amount === other._amount &&
               this._currency === other._currency;
    }

    private assertSameCurrency(other: Money): void {
        if (!this._currency.equals(other._currency)) {
            throw new CurrencyMismatchException(this._currency, other._currency);
        }
    }

    // Factory
    static zero(currency: Currency): Money {
        return new Money(0, currency);
    }

    static fromCents(cents: number, currency: Currency): Money {
        return new Money(cents / 100, currency);
    }
}

// Email value object
class EmailAddress extends ValueObject {
    constructor(private readonly _value: string) {
        super();
        this.validate();
        Object.freeze(this);
    }

    private validate(): void {
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(this._value)) {
            throw new DomainException('Invalid email address');
        }
    }

    get value(): string { return this._value; }

    equals(other: EmailAddress): boolean {
        return this._value.toLowerCase() === other._value.toLowerCase();
    }
}
```

