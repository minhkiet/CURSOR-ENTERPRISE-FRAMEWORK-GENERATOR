## Anti Patterns

### 1. Anemic Domain Model

```typescript
// Không nên - anemic model
class Order {
    id: string;
    items: OrderItem[];
    status: string;

    get total(): number {
        return this.items.reduce((sum, item) => sum + item.price, 0);
    }
}

// Logic in services instead of domain
function calculateOrderTotal(order: Order): number {
    return order.items.reduce((sum, item) => sum + item.price, 0);
}

// Nên - rich domain model
class Order {
    private items: OrderItem[] = [];

    addItem(product: Product, quantity: Quantity): void {
        if (this.status !== 'DRAFT') {
            throw new BusinessRuleViolation('Cannot add items to confirmed order');
        }
        // Business logic encapsulated
    }
}
```

### 2. God Aggregate

```typescript
// Không nên - too large aggregate
class ECommerceSystem extends AggregateRoot {
    // Everything in one aggregate!
    private customers: Customer[];
    private products: Product[];
    private orders: Order[];
    private payments: Payment[];
    private inventory: Inventory[];
    // ...
}

// Nên - proper aggregate boundaries
class OrderAggregate { /* Only order logic */ }
class CustomerAggregate { /* Only customer logic */ }
class ProductAggregate { /* Only product logic */ }
```

### 3. Anemic Repository

```typescript
// Không nên - repository with business logic
class OrderRepository {
    async placeOrder(orderData: any): Promise<void> {
        // Business logic in repository!
        this.validateOrder(orderData);
        this.checkInventory(orderData.items);
        this.createOrder(orderData);
        this.updateInventory(orderData.items);
    }
}

// Nên - repository only handles persistence
class OrderRepository {
    save(order: Order): Promise<void> {
        // Just persistence
    }

    findById(id: OrderId): Promise<Order> {
        // Just retrieval
    }
}
```

### 4. Domain Services doing Everything

```typescript
// Không nên - domain service is god object
class OrderService {
    async placeOrder() { /* All logic here */ }
    async cancelOrder() { /* All logic here */ }
    async refundOrder() { /* All logic here */ }
    async shipOrder() { /* All logic here */ }
}

// Nên - logic in aggregates and proper services
class OrderAggregate {
    confirm() { /* Order-specific logic */ }
    cancel() { /* Order-specific logic */ }
}

class OrderApplicationService {
    async placeOrder() {
        // Orchestration
    }
}
```

### 5. Ignoring Bounded Contexts

```typescript
// Không nên - single model everywhere
class Customer {
    // Used in Catalog, Order, Payment, etc.
    // Different contexts have different needs
}

// Nên - separate models per context
namespace CatalogContext {
    class Customer {} // Catalog-specific
}

namespace OrderContext {
    class Customer {} // Order-specific
}

namespace PaymentContext {
    class Customer {} // Payment-specific
}
```

## Best Practices

### 1. Domain Model Structure

