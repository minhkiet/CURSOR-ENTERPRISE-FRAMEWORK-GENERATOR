**4. Domain Events**

```typescript
// domain/order/events/OrderCreatedEvent.ts
export class OrderCreatedEvent extends DomainEvent {
  constructor(
    public readonly orderId: OrderId,
    public readonly customerId: CustomerId,
    public readonly total: Money,
    public readonly occurredAt: Date = new Date()
  ) {
    super(orderId, 'order', 'OrderCreated', occurredAt);
  }

  toEventRecord(): EventRecord {
    return {
      eventId: this.eventId,
      aggregateId: this.orderId.value,
      eventType: this.eventType,
      occurredAt: this.occurredAt,
      payload: {
        orderId: this.orderId.value,
        customerId: this.customerId.value,
        total: this.total.toSnapshot()
      }
    };
  }
}

// domain/BaseEventBus.ts
export abstract class EventBus {
  abstract publish<T extends DomainEvent>(event: T): Promise<void>;
  abstract subscribe<T extends DomainEvent>(
    eventType: string,
    handler: EventHandler<T>
  ): Subscription;
  abstract unsubscribe(subscription: Subscription): void;
}

// implementation/InMemoryEventBus.ts
export class InMemoryEventBus extends EventBus {
  private handlers: Map<string, EventHandler<any>[] = new Map();

  async publish<T extends DomainEvent>(event: T): Promise<void> {
    const handlers = this.handlers.get(event.eventType) || [];
    
    await Promise.all(
      handlers.map(handler => handler.handle(event))
    );
  }

  subscribe<T extends DomainEvent>(
    eventType: string,
    handler: EventHandler<T>
  ): Subscription {
    const existing = this.handlers.get(eventType) || [];
    this.handlers.set(eventType, [...existing, handler]);
    
    return { eventType, handler };
  }

  unsubscribe(subscription: Subscription): void {
    const handlers = this.handlers.get(subscription.eventType) || [];
    this.handlers.set(
      subscription.eventType,
      handlers.filter(h => h !== subscription.handler)
    );
  }
}
```

**5. Repository Pattern**

```typescript
// domain/order/repositories/IOrderRepository.ts
export interface IOrderRepository {
  findById(id: OrderId): Promise<Order | null>;
  findByCustomer(customerId: CustomerId): Promise<Order[]>;
  findByStatus(status: OrderStatus): Promise<Order[]>;
  findByDateRange(start: Date, end: Date): Promise<Order[]>;
  save(order: Order): Promise<void>;
  delete(id: OrderId): Promise<void>;
}

// infrastructure/persistence/OrderRepository.ts
export class OrderRepository implements IOrderRepository {
  constructor(
    private db: Database,
    private eventBus: EventBus
  ) {}

  async findById(id: OrderId): Promise<Order | null> {
    const row = await this.db.queryOne(
      'SELECT * FROM orders WHERE id = $1',
      [id.value]
    );
    
    if (!row) return null;
    
    const items = await this.loadItems(id);
    return this.mapToOrder(row, items);
  }

  async save(order: Order): Promise<void> {
    const snapshot = order.toSnapshot();
    
    await this.db.transaction(async (tx) => {
      // Upsert order
      await tx.execute(`
        INSERT INTO orders (id, customer_id, status, shipping_address, total, notes, created_at, updated_at)
        VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
        ON CONFLICT (id) DO UPDATE SET
          status = EXCLUDED.status,
          shipping_address = EXCLUDED.shipping_address,
          total = EXCLUDED.total,
          notes = EXCLUDED.notes,
          updated_at = EXCLUDED.updated_at
      `, [
        snapshot.id,
        snapshot.customerId,
        snapshot.status,
        JSON.stringify(snapshot.shippingAddress),
        snapshot.total.amount,
        snapshot.notes,
        snapshot.createdAt,
        snapshot.updatedAt
      ]);

      // Sync items
      await this.syncItems(order.id, order.items);
    });

    // Publish domain events
    const events = order.domainEvents;
    order.clearDomainEvents();
    
    for (const event of events) {
      await this.eventBus.publish(event);
    }
  }

  async delete(id: OrderId): Promise<void> {
    await this.db.execute('DELETE FROM orders WHERE id = $1', [id.value]);
  }
}
```

**6. Domain Services**

```typescript
// domain/order/services/OrderDomainService.ts
export class OrderDomainService {
  constructor(
    private orderRepository: IOrderRepository,
    private productRepository: IProductRepository,
    private inventoryService: InventoryService
  ) {}

  async createOrderFromCart(cart: Cart, shippingAddress: Address): Promise<Order> {
    // Validate all products are available
    const productIds = cart.items.map(item => item.productId);
    const products = await this.productRepository.findByIds(productIds);
    
    const orderItems = cart.items.map(cartItem => {
      const product = products.find(p => p.id.equals(cartItem.productId));
      if (!product) {
        throw new OrderDomainException(
          `Product not found: ${cartItem.productId.value}`
        );
      }
      if (!product.isAvailable) {
        throw new OrderDomainException(
          `Product not available: ${product.name}`
        );
      }
      return OrderItem.create(product, cartItem.quantity);
    });

    // Create order
    const order = Order.create({
      customerId: cart.customerId,
      items: orderItems,
      shippingAddress
    });

    return order;
  }

  async cancelOrderAndReleaseInventory(orderId: OrderId, reason: string): Promise<void> {
    const order = await this.orderRepository.findById(orderId);
    if (!order) {
      throw new NotFoundException('Order not found');
    }

    // Cancel order
    order.cancel(reason);
    
    // Release inventory
    for (const item of order.items) {
      await this.inventoryService.release(item.productId, item.quantity);
    }

    await this.orderRepository.save(order);
  }
}
```

**7. Application Service**

```typescript
// application/OrderApplicationService.ts
export class OrderApplicationService {
  constructor(
    private orderDomainService: OrderDomainService,
    private orderRepository: IOrderRepository,
    private eventBus: EventBus
  ) {}

  async createOrder(dto: CreateOrderDTO): Promise<OrderDTO> {
    // Use domain service for business logic
    const order = await this.orderDomainService.createOrderFromCart(
      dto.cart,
      Address.fromSnapshot(dto.shippingAddress)
    );

    await this.orderRepository.save(order);

    return this.mapToDTO(order);
  }

  async confirmOrder(orderId: string): Promise<OrderDTO> {
    const order = await this.orderRepository.findById(OrderId.from(orderId));
    if (!order) {
      throw new NotFoundException('Order not found');
    }

    order.confirm();
    await this.orderRepository.save(order);

    return this.mapToDTO(order);
  }

  async cancelOrder(dto: CancelOrderDTO): Promise<OrderDTO> {
    const orderId = OrderId.from(dto.orderId);
    
    await this.orderDomainService.cancelOrderAndReleaseInventory(
      orderId,
      dto.reason
    );

    const order = await this.orderRepository.findById(orderId);
    return this.mapToDTO(order);
  }

  async getOrder(orderId: string): Promise<OrderDTO> {
    const order = await this.orderRepository.findById(OrderId.from(orderId));
    if (!order) {
      throw new NotFoundException('Order not found');
    }
    return this.mapToDTO(order);
  }

  private mapToDTO(order: Order): OrderDTO {
    return {
      id: order.id.value,
      customerId: order.customerId.value,
      status: order.status,
      items: order.items.map(item => ({
        productId: item.productId.value,
        productName: item.productName,
        quantity: item.quantity.value,
        unitPrice: item.unitPrice.format(),
        subtotal: item.subtotal.format()
      })),
      shippingAddress: order.shippingAddress.toSnapshot(),
      total: order.total.format(),
      notes: order.notes,
      createdAt: order.createdAt
    };
  }
}
```

## Workflow

**Phase 1: Domain Discovery**

Meet with domain experts. Understand business processes. Identify core domain. Map domain events.

**Phase 2: Bounded Context Design**

Define boundaries. Identify aggregates. Map relationships. Define context integration.

**Phase 3: Model Implementation**

Implement entities. Create value objects. Build aggregates. Define domain events.

**Phase 4: Infrastructure**

Implement repositories. Configure persistence. Set up event bus. Connect to services.

**Phase 5: Application Layer**

Build application services. Define DTOs. Implement use cases. Add transactions.

