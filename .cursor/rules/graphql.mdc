### Ví dụ 2: Resolver Implementation

```typescript
import { ApolloServer } from '@apollo/server';
import { expressMiddleware } from '@apollo/server/express4';
import express from 'express';
import { makeExecutableSchema } from '@graphql-tools/schema';
import { typeDefs } from './schema';
import { resolvers } from './resolvers';
import { createContext, GraphQLContext } from './context';
import { createDataLoaders } from './loaders';
import { formatError } from './errors';
import { rateLimitRule } from 'graphql-rate-limit';

const schema = makeExecutableSchema({ typeDefs, resolvers });

async function startServer() {
    const app = express();
    
    const server = new ApolloServer<GraphQLContext>({
        schema,
        formatError,
        plugins: [
            {
                async requestDidStart() {
                    return {
                        async willSendResponse({ response }) {
                            // Add headers
                            response.http?.headers.set(
                                'X-Response-Time',
                                Date.now().toString()
                            );
                        }
                    };
                }
            }
        ]
    });
    
    await server.start();
    
    app.use('/graphql', 
        express.json(),
        expressMiddleware(server, {
            context: async ({ req }) => {
                const context = await createContext({ req });
                const loaders = createDataLoaders(context);
                return { ...context, loaders };
            }
        })
    );
    
    app.listen(4000, () => {
        console.log('Server ready at http://localhost:4000/graphql');
    });
}

startServer();
```

### Ví dụ 3: Integration với Existing REST APIs

```typescript
// REST to GraphQL adapter
export class RESTAdapter {
    constructor(private baseUrl: string, private apiKey: string) {}
    
    async get<T>(endpoint: string, params?: Record<string, string>): Promise<T> {
        const url = new URL(endpoint, this.baseUrl);
        if (params) {
            Object.entries(params).forEach(([key, value]) => {
                url.searchParams.set(key, value);
            });
        }
        
        const response = await fetch(url.toString(), {
            headers: {
                'Authorization': `Bearer ${this.apiKey}`,
                'Content-Type': 'application/json'
            }
        });
        
        if (!response.ok) {
            throw new Error(`REST API error: ${response.status}`);
        }
        
        return response.json();
    }
}

// GraphQL resolver using REST adapter
const resolvers = {
    Query: {
        externalData: async (_, { id }, { restAdapter }) => {
            const data = await restAdapter.get(`/api/external/${id}`);
            
            // Transform to GraphQL format
            return {
                id: data.externalId,
                title: data.name,
                description: data.description,
                metadata: data.meta
            };
        }
    }
};
