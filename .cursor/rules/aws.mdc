**5. S3 Configuration**

```typescript
// aws/s3/bucket-configuration.ts
import { S3 } from 'aws-sdk';

const s3 = new S3();

// Create S3 Bucket with configuration
await s3.createBucket({
  Bucket: 'app-production-static',
  ObjectOwnership: 'BucketOwnerPreferred',
  ACL: 'private'
}).promise();

// Enable versioning
await s3.putBucketVersioning({
  Bucket: 'app-production-static',
  VersioningConfiguration: {
    Status: 'Enabled',
    MFADelete: 'Disabled'
  }
}).promise();

// Enable encryption
await s3.putBucketEncryption({
  Bucket: 'app-production-static',
  ServerSideEncryptionConfiguration: {
    Rules: [
      {
        ApplyServerSideEncryptionByDefault: {
          SSEAlgorithm: 'AES256'
        }
      }
    ]
  }
}).promise();

// Lifecycle rules
await s3.putBucketLifecycleConfiguration({
  Bucket: 'app-production-static',
  LifecycleConfiguration: {
    Rules: [
      {
        ID: 'archive-old-logs',
        Status: 'Enabled',
        Filter: {
          Prefix: 'logs/'
        },
        Transitions: [
          { Days: 30, StorageClass: 'STANDARD_IA' },
          { Days: 90, StorageClass: 'GLACIER' },
          { Days: 365, StorageClass: 'DEEP_ARCHIVE' }
        ],
        Expiration: {
          Days: 1825
        }
      }
    ]
  }
}).promise();

// Public access block
await s3.putPublicAccessBlock({
  Bucket: 'app-production-static',
  PublicAccessBlockConfiguration: {
    BlockPublicAcls: true,
    IgnorePublicAcls: true,
    BlockPublicPolicy: true,
    RestrictPublicBuckets: true
  }
}).promise();
```

**6. CloudWatch Configuration**

```typescript
// aws/cloudwatch/monitoring.ts
import { CloudWatch } from 'aws-sdk';

const cloudwatch = new CloudWatch({ region: 'us-east-1' });

// Create Dashboard
await cloudwatch.putDashboard({
  DashboardName: 'production-overview',
  DashboardBody: JSON.stringify({
    widgets: [
      {
        type: 'metric',
        properties: {
          title: 'API Latency',
          metrics: [
            ['AWS/ApiGateway', 'Latency', 'ApiName', 'production-api'],
            ['.', 'Duration', '.', '.']
          ],
          period: 300,
          stat: 'Average',
          region: 'us-east-1',
          yAxis: { left: { min: 0, max: 5000 } }
        }
      },
      {
        type: 'metric',
        properties: {
          title: 'Error Rate',
          metrics: [
            ['AWS/ApiGateway', '5XXError', 'ApiName', 'production-api'],
            ['.', '4XXError', '.', '.']
          ],
          period: 300,
          stat: 'Sum',
          region: 'us-east-1'
        }
      },
      {
        type: 'text',
        properties: {
          markdown: '# Production Dashboard'
        }
      }
    ]
  })
}).promise();

// Create Alarm
await cloudwatch.putMetricAlarm({
  AlarmName: 'high-error-rate',
  AlarmDescription: 'Alert when error rate is above 1%',
  MetricName: '5XXError',
  Namespace: 'AWS/ApiGateway',
  Statistic: 'Sum',
  Period: 300,
  EvaluationPeriods: 2,
  Threshold: 10,
  ComparisonOperator: 'GreaterThanThreshold',
  AlarmActions: ['arn:aws:sns:us-east-1:123456789:alerts'],
  Dimensions: [
    { Name: 'ApiName', Value: 'production-api' }
  ]
}).promise();
```

## Workflow

**Phase 1: Account Setup**

Set up AWS Organizations. Create accounts. Enable SCPs. Set up billing.

**Phase 2: Network Architecture**

Design VPC. Configure subnets. Set up NAT. Configure routing.

**Phase 3: Identity and Access**

Configure IAM. Set up roles. Configure MFA. Plan permissions.

**Phase 4: Application Deployment**

Select services. Deploy applications. Configure scaling. Set up monitoring.

**Phase 5: Data Layer**

Deploy databases. Configure backups. Enable encryption. Set up replication.

**Phase 6: Operations**

Monitor costs. Optimize performance. Update resources. Handle incidents.

