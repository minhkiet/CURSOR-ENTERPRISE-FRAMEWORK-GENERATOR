### 8. Git Aliases

Productive shortcuts.

```bash
# ~/.gitconfig
[alias]
    # Shortcuts
    st = status
    co = checkout
    br = branch
    ci = commit
    unstage = reset HEAD --
    last = log -1 HEAD

    # Pretty log
    lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

    # Show staged changes
    ds = diff --staged

    # Interactive rebase
    ri = rebase -i

    # Squash commits
    sq = rebase -i HEAD~

    # Clean untracked files
    cleanup = clean -fdx

    # Undo last commit (keep changes)
    undo = reset --soft HEAD~1

    # Amend without changing message
    amend = commit --amend --no-edit

    # Update all submodules
    update = submodule update --init --recursive

    # Fetch and prune
    fp = fetch --prune

    # Pull with rebase
    pr = pull --rebase origin

    # Show contributors
    contributors = shortlog --sn --numbered --email
```

### 9. Tagging Strategy

Version management.

```bash
# Semantic versioning tags
# v<major>.<minor>.<patch>

# Create lightweight tag
git tag v1.0.0

# Create annotated tag (recommended)
git tag -a v1.0.0 -m "Release version 1.0.0"

# Create tag with signature
git tag -s v1.0.0 -m "Release version 1.0.0"

# Tag after commit
git tag -a v1.0.0 <commit-sha>

# Push tags
git push origin v1.0.0
git push origin --tags

# List tags
git tag -l
git tag -l "v1.*"

# Delete tags
git tag -d v1.0.0           # Local
git push origin :refs/tags/v1.0.0  # Remote
```

