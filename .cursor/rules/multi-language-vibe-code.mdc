### D.3 Auto-Discovery Algorithm

```python
def auto_discover_rules_and_skills(english_request: str, intent_analysis: dict) -> dict:
    """
    Automatically discover applicable rules and skills
    """
    request_lower = english_request.lower()
    results = {
        "skills": [],
        "rules": [],
        "gates": [],
        "confidence": {}
    }
    
    # Mandatory: karpathy-coding always runs
    results["skills"].append({
        "name": "karpathy-coding",
        "type": "overlay",
        "confidence": 1.0
    })
    
    # Check each skill in matrix
    for skill_name, skill_data in SKILL_MATRIX.items():
        scores = []
        
        # Check English keywords
        for kw in skill_data.get("en_keywords", []):
            if kw in request_lower:
                scores.append(1.0)
                
        # Check Vietnamese keywords (if original was Vietnamese)
        for kw in skill_data.get("vi_keywords", []):
            if kw in request_lower:
                scores.append(1.0)
                
        # Check Chinese keywords
        for kw in skill_data.get("zh_keywords", []):
            if kw in request_lower:
                scores.append(1.0)
        
        # Calculate confidence
        if scores:
            confidence = sum(scores) / max(len(skill_data.get("en_keywords", [1])), 1)
            
            if confidence >= skill_data["confidence_threshold"]:
                results["skills"].append({
                    "name": skill_name,
                    "type": "primary" if skill_name not in ["karpathy-coding", "frontend-review"] else "mandatory",
                    "confidence": confidence,
                    "scores": scores
                })
                results["confidence"][skill_name] = confidence
    
    # Determine gates based on skills
    for skill in results["skills"]:
        gates = get_skill_gates(skill["name"])
        results["gates"].extend(gates)
    
    # Remove duplicate gates
    results["gates"] = list(set(results["gates"]))
    
    # Add domain-specific rules
    for domain in intent_analysis["domains"]:
        if domain["domain"] == "frontend":
            results["rules"].append("frontend-architecture")
        elif domain["domain"] == "security":
            results["rules"].append("web-security")
        elif domain["domain"] == "payment":
            results["rules"].append("billing")
        elif domain["domain"] == "database":
            results["rules"].append("database")
    
    return results

def get_skill_gates(skill_name: str) -> list:
    """Get required gates for a skill"""
    gate_map = {
        "frontend-taste": ["taste-pre", "taste-post"],
        "frontend-redesign": ["redesign-pre", "redesign-post"],
        "full-output": ["fulloutput-pre", "fulloutput-post"],
        "frontend-review": ["review-pre", "review-post"],
        "security-review": ["security-pre", "security-post"],
        "vietnam-payment-review": ["payment-pre", "payment-post"],
        "karpathy-coding": ["karpathy-pre", "karpathy-post"],
    }
    return gate_map.get(skill_name, [])
```

