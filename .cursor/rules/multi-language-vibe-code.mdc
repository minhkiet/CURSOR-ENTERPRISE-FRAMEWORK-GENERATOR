    Run all pre-execution validations
    Returns: {
        "can_proceed": bool,
        "passed": list,
        "failed": list,
        "warnings": list,
        "validation_summary": str
    }
    """
    results = {
        "can_proceed": True,
        "passed": [],
        "failed": [],
        "warnings": [],
        "blocking_issues": []
    }
    
    # 1. Request Clarity
    clarity_check = validate_request_clarity(request)
    if clarity_check["passed"]:
        results["passed"].append("request_clarity")
    else:
        results["failed"].append({
            "rule": "request_clarity",
            "message": clarity_check["message"],
            "suggestion": clarity_check["suggestion"]
        })
        results["blocking_issues"].append("request_clarity")
    
    # 2. Intent Confidence
    intent_check = validate_intent_confidence(intent_analysis)
    if intent_check["passed"]:
        results["passed"].append("intent_confidence")
    else:
        results["warnings"].append({
            "rule": "intent_confidence",
            "message": intent_check["message"]
        })
        if intent_check["severity"] == "block":
            results["blocking_issues"].append("intent_confidence")
    
    # 3. Skills Matched
    skills_check = validate_skills_matched(skill_discovery)
    if skills_check["passed"]:
        results["passed"].append("skills_matched")
    else:
        results["failed"].append({
            "rule": "skills_matched",
            "message": skills_check["message"],
            "suggestion": skills_check["suggestion"]
        })
        results["blocking_issues"].append("skills_matched")
    
    # 4. Domain Consistency
    domain_check = validate_domain_consistency(domain_detection)
    if domain_check["passed"]:
        results["passed"].append("domain_consistency")
    else:
        results["warnings"].append({
            "rule": "domain_consistency",
            "message": domain_check["message"]
        })
    
    # 5. Tech Stack Valid
    tech_check = validate_tech_stack(request, context)
    if tech_check["passed"]:
        results["passed"].append("tech_stack_valid")
    else:
        results["warnings"].append({
            "rule": "tech_stack",
            "message": tech_check["message"]
        })
    
    # 6. File References
    file_check = validate_file_references(request)
    if file_check["passed"]:
        results["passed"].append("file_references_exist")
    else:
        results["warnings"].append({
            "rule": "file_references",
            "message": file_check["message"],
            "missing_files": file_check["missing"]
        })
    
    # Determine if can proceed
    results["can_proceed"] = len(results["blocking_issues"]) == 0
    
    # Generate summary
    results["validation_summary"] = generate_validation_summary(results)
    
    return results


def validate_request_clarity(request: str) -> dict:
    """Check if request has sufficient clarity"""
    word_count = len(request.split())
    request_lower = request.lower()
    
    # Check for action verb
    has_action = bool(re.search(
        r'\b(create|build|add|fix|update|delete|remove|change|'
        r'improve|design|develop|implement|configure)\w*',
        request_lower
    ))
    
    # Check for target
    has_target = bool(re.search(
        r'\b(this|that|file|folder|app|page|component|'
        r'button|form|api|system|feature|the|my|an?)\w*',
        request_lower
    ))
    
    # Check for vagueness
    vague_words = ["something", "stuff", "things", "whatever", "gì đó", "cái gì"]
    has_vague = any(vw in request_lower for vw in vague_words)
    
    passed = word_count >= 3 and has_action and has_target and not has_vague
    
    return {
        "passed": passed,
        "word_count": word_count,
        "has_action": has_action,
        "has_target": has_target,
        "has_vague": has_vague,
        "message": "Request clarity check " + ("PASSED" if passed else "FAILED"),
        "suggestion": None if passed else "Please provide more specific details about what you want to do."
    }


def validate_intent_confidence(intent_analysis: dict) -> dict:
    """Check if intent confidence is sufficient"""
    confidence = intent_analysis.get("intent_confidence", 0)
    threshold = 0.5
    
    passed = confidence >= threshold
    
    return {
        "passed": passed,
        "confidence": confidence,
        "threshold": threshold,
        "message": f"Intent confidence: {confidence:.0%} "
                  + ("(PASSED)" if passed else f"(below {threshold:.0%})"),
        "severity": "block" if confidence < threshold else "pass"
    }


def validate_skills_matched(skill_discovery: dict) -> dict:
    """Check if at least one skill was matched"""
    skills = skill_discovery.get("skills", [])
    
    # Filter out only mandatory skills
    primary_skills = [s for s in skills if s.get("type") != "mandatory"]
    
    passed = len(primary_skills) >= 1
    
    return {
        "passed": passed,
        "matched_count": len(primary_skills),
        "matched_skills": [s["name"] for s in primary_skills],
        "message": f"Matched {len(primary_skills)} skills: {', '.join([s['name'] for s in primary_skills])}"
                  if passed else "No skills matched",
        "suggestion": None if passed else "Try specifying the task type (e.g., 'create landing page', 'fix login bug')."
    }


def validate_domain_consistency(domain_detection: dict) -> dict:
    """Check if detected domains are consistent"""
    domains = domain_detection.get("detected_domains", [])
    
    # Check for conflicting domains
    domain_names = [d.get("domain") for d in domains]
    
    conflicts = []
    if "frontend" in domain_names and "mobile" in domain_names:
        conflicts.append("frontend + mobile")
    if "backend" in domain_names and "frontend" not in domain_names and len(domain_names) > 1:
        # Multiple backend technologies might indicate confusion
        pass
    
    passed = len(conflicts) == 0
    
    return {
        "passed": passed,
        "conflicts": conflicts,
        "message": "Domain consistency " + ("PASSED" if passed else f"CONFLICT: {conflicts}")
    }


def validate_tech_stack(request: str, context: dict) -> dict:
    """Check if tech stack is valid/known"""
    request_lower = request.lower()
    
    detected_stacks = []
    for stack in KNOWN_TECH_STACKS:
        if stack in request_lower:
            detected_stacks.append(stack)
    
    # If detected stacks are subset of known, it's valid
    passed = len(detected_stacks) == 0 or all(
        s in KNOWN_TECH_STACKS for s in detected_stacks
    )
    
    return {
        "passed": passed,
        "detected": detected_stacks,
        "message": f"Tech stack: {', '.join(detected_stacks) if detected_stacks else 'Not specified'}"
    }


def validate_file_references(request: str) -> dict:
    """Check if referenced files exist"""
    # Extract file paths from request
    file_patterns = [
        r'\b[\w\-/\\]+\.(tsx?|jsx?|vue|svelte|css|scss|py|js|ts|json|md)\b',
        r'\bsrc/[\w\-/\\]+\b',
        r'\bcomponents/[\w\-/\\]+\b',
        r'\bapp/[\w\-/\\]+\b'
    ]
    
    references = []
    for pattern in file_patterns:
        matches = re.findall(pattern, request)
        references.extend(matches)
    
    # For now, just return passed - actual file existence check
    # would need filesystem access
    return {
        "passed": True,
        "references": references,
        "missing": [],
        "message": f"Found {len(references)} file references"
    }


def generate_validation_summary(results: dict) -> str:
    """Generate human-readable validation summary"""
    lines = []
    lines.append("📋 PRE-EXECUTION VALIDATION SUMMARY")
    lines.append("━" * 50)
    lines.append(f"Status: {'✅ CAN PROCEED' if results['can_proceed'] else '❌ BLOCKED'}")
    lines.append("")
    
    if results["passed"]:
        lines.append("✅ Passed Checks:")
        for check in results["passed"]:
            lines.append(f"   • {check}")
    
    if results["warnings"]:
        lines.append("")
        lines.append("⚠️ Warnings:")
        for warn in results["warnings"]:
            lines.append(f"   • {warn['rule']}: {warn['message']}")
    
    if results["failed"]:
        lines.append("")
        lines.append("❌ Failed Checks:")
        for fail in results["failed"]:
            lines.append(f"   • {fail['rule']}: {fail['message']}")
            if fail.get("suggestion"):
                lines.append(f"     → {fail['suggestion']}")
    
    if results["blocking_issues"]:
        lines.append("")
        lines.append("🚫 Blocking Issues:")
        for issue in results["blocking_issues"]:
            lines.append(f"   • {issue}")
    
    return "\n".join(lines)
```

