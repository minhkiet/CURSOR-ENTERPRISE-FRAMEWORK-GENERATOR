### C.3 Intent Detection Algorithm

```python
def analyze_intent(english_request: str) -> dict:
    """
    Analyze translated request to determine intent and domain
    Returns: {
        "primary_intent": str,
        "confidence": float,
        "domains": list,
        "entities": list,
        "constraints": list
    }
    """
    request_lower = english_request.lower()
    
    # Score each intent
    intent_scores = {}
    for intent_name, intent_data in INTENTS.items():
        score = sum(1 for kw in intent_data["keywords"] if kw in request_lower)
        intent_scores[intent_name] = score / len(intent_data["keywords"])
    
    # Get primary intent
    primary_intent = max(intent_scores, key=intent_scores.get)
    intent_confidence = intent_scores[primary_intent]
    
    # Detect domains
    detected_domains = []
    for domain_name, domain_data in DOMAINS.items():
        score = sum(1 for kw in domain_data["keywords"] if kw in request_lower)
        if score > 0:
            detected_domains.append({
                "domain": domain_name,
                "score": score / len(domain_data["keywords"])
            })
    
    # Extract entities (file names, component names, etc.)
    entities = extract_entities(english_request)
    
    # Extract constraints (performance, security, etc.)
    constraints = extract_constraints(english_request)
    
    return {
        "primary_intent": primary_intent,
        "intent_confidence": intent_confidence,
        "intent_scores": intent_scores,
        "domains": sorted(detected_domains, key=lambda x: x["score"], reverse=True),
        "entities": entities,
        "constraints": constraints
    }
```

