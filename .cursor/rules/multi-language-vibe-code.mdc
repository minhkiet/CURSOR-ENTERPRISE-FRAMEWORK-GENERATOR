### B.2 Translation Algorithm

```python
def translate_to_english(text: str, source_lang: str) -> str:
    """
    Translate request to English with semantic preservation
    """
    if source_lang == "vi":
        return translate_vietnamese_to_english(text)
    elif source_lang == "zh":
        return translate_chinese_to_english(text)
    elif source_lang == "ja":
        return translate_japanese_to_english(text)
    elif source_lang == "ko":
        return translate_korean_to_english(text)
    # ... other languages
    
def translate_vietnamese_to_english(text: str) -> str:
    """Vietnamese to English with tech-term awareness"""
    
    # Step 1: Replace known tech terms
    result = text
    for vi_term, en_term in VI_TO_EN.items():
        result = re.sub(
            r'\b' + re.escape(vi_term) + r'\b',
            en_term,
            result,
            flags=re.IGNORECASE
        )
    
    # Step 2: Handle compound phrases
    result = expand_compound_phrases(result)
    
    # Step 3: Normalize word order for English
    result = normalize_word_order(result, "vi")
    
    # Step 4: Expand abbreviations
    result = expand_abbreviations(result, "vi")
    
    # Step 5: Preserve code snippets (don't translate)
    result = preserve_code_snippets(result)
    
    return result

def expand_compound_phrases(text: str) -> str:
    """Expand common Vietnamese compound phrases"""
    compounds = {
        "thiết kế web": "design website",
        "xây dựng app": "build app",
        "tạo landing page": "create landing page",
        "cải thiện giao diện": "improve UI",
        "sửa lỗi code": "fix code bug",
        "phát triển tính năng": "develop feature",
        "thêm chức năng": "add feature",
        "tối ưu hiệu suất": "optimize performance",
        "nâng cấp hệ thống": "upgrade system",
    }
    
    for compound, expansion in compounds.items():
        text = text.replace(compound, expansion)
    
    return text
```

