**2. Budget Alerts**

```typescript
// AWS Budget setup
async function setupBudgetAlerts(tenantId: string) {
  const budgetAmount = getTenantBudget(tenantId);
  
  await aws.budgets.createBudget({
    AccountId: process.env.AWS_ACCOUNT_ID,
    Budget: {
      BudgetName: `${tenantId}-monthly`,
      BudgetType: 'COST',
      TimeUnit: 'MONTHLY',
      BudgetLimit: {
        Amount: budgetAmount.toString(),
        Unit: 'USD'
      },
      CostFilters: {
        TagKeyValue: [
          `$${tenants:${tenantId}}`
        ]
      }
    },
    NotificationsWithSubscribers: [
      {
        Notification: {
          NotificationType: 'ACTUAL',
          ComparisonOperator: 'GREATER_THAN',
          Threshold: 80
        },
        Subscribers: [
          {
            SubscriptionType: 'EMAIL',
            Address: getTenantBillingEmail(tenantId)
          }
        ]
      }
    ]
  });
}
```

**3. Cost Dashboard Query**

```typescript
async function getCostBreakdown(
  startDate: Date,
  endDate: Date
): Promise<CostReport> {
  const query = `
    SELECT 
      service,
      SUM(cost) as total_cost,
      SUM(usage_quantity) as total_usage,
      AVG(unit_cost) as avg_unit_cost
    FROM costs
    WHERE date BETWEEN $1 AND $2
      AND tag_team = $3
    GROUP BY service
    ORDER BY total_cost DESC
  `;
  
  const results = await db.query(query, [startDate, endDate, currentTeam]);
  
  // Calculate trends
  const previousPeriod = calculatePreviousPeriod(startDate, endDate);
  const previousCosts = await getCosts(previousPeriod.start, previousPeriod.end);
  
  return {
    period: { start: startDate, end: endDate },
    breakdown: results.rows,
    trends: calculateTrends(results.rows, previousCosts),
    budget: await getBudgetStatus()
  };
}
```

**4. Reserved Capacity Calculator**

```typescript
async function analyzeReservedCapacity(): Promise<ReservedRecommendation[]> {
  const onDemandInstances = await getRunningInstances();
  const utilization = await analyzeUtilization(onDemandInstances);
  
  const recommendations: ReservedRecommendation[] = [];
  
  for (const instance of utilization) {
    if (instance.utilizationPercent > 70 && instance.uptimePercent > 90) {
      // Good candidate for reservation
      const onDemandCost = calculateOnDemandCost(instance);
      const reservedCost = calculateReservedCost(instance);
      const savings = onDemandCost - reservedCost;
      
      recommendations.push({
        instanceType: instance.type,
        quantity: instance.count,
        currentUtilization: instance.utilizationPercent,
        estimatedMonthlySavings: savings / 12,
        reservationTerm: '1y',
        paymentOption: 'No Upfront'
      });
    }
  }
  
  return recommendations.sort((a, b) => b.estimatedMonthlySavings - a.estimatedMonthlySavings);
}
```

## Workflow

**Phase 1: Assessment**

Tag resources. Set up cost tracking. Identify current spend. Baseline metrics.

**Phase 2: Analysis**

Analyze utilization. Identify waste. Review pricing models. Get recommendations.

**Phase 3: Implementation**

Right-size resources. Implement scheduling. Purchase reservations. Optimize storage.

**Phase 4: Monitoring**

Set up alerts. Regular reviews. Track savings. Continuous optimization.

