## Anti Pattern

**1. Over-Provisioning**

Provisioning more than needed. Wasted resources. High costs. Right-size based on actual usage.

**2. Ignoring Idle Resources**

Resources running 24/7 unnecessarily. Development environments running when not in use. Test environments not cleaned up.

**3. Not Using Reserved Capacity**

Using all on-demand. Missing savings. Commit to steady workloads. Use reserved instances.

**4. Inefficient Data Transfer**

Large data transfers. No compression. Multiple unnecessary API calls. Minimize transfer costs.

**5. No Cost Accountability**

No visibility into cost by team. No cost targets. No accountability. Implement chargeback.

## Best Practice

**1. Cost Monitoring Dashboard**

```typescript
// services/cost-monitoring.service.ts
interface CostBreakdown {
  service: string;
  cost: number;
  trend: 'up' | 'down' | 'stable';
  percentageOfTotal: number;
}

interface BudgetAlert {
  id: string;
  name: string;
  threshold: number;
  currentSpend: number;
  percentage: number;
}

class CostMonitoringService {
  constructor(
    private cloudCostProvider: CloudCostProvider,
    private alertService: AlertService
  ) {}

  async getCostBreakdown(
    startDate: Date,
    endDate: Date,
    granularity: 'daily' | 'monthly' = 'daily'
  ): Promise<CostBreakdown[]> {
    const costs = await this.cloudCostProvider.getCosts(startDate, endDate, granularity);
    
    // Group by service
    const grouped = new Map<string, number>();
    for (const cost of costs) {
      const current = grouped.get(cost.service) || 0;
      grouped.set(cost.service, current + cost.amount);
    }

    const totalCost = Array.from(grouped.values()).reduce((sum, c) => sum + c, 0);

    // Calculate percentages and trends
    const breakdown: CostBreakdown[] = [];
    for (const [service, cost] of grouped) {
      breakdown.push({
        service,
        cost,
        trend: await this.calculateTrend(service, startDate, endDate),
        percentageOfTotal: (cost / totalCost) * 100
      });
    }

    return breakdown.sort((a, b) => b.cost - a.cost);
  }

  async getBudgetStatus(): Promise<BudgetAlert[]> {
    const budgets = await this.getActiveBudgets();
    const currentSpend = await this.getCurrentMonthSpend();

    return budgets.map(budget => {
      const percentage = (currentSpend / budget.threshold) * 100;
      
      return {
        id: budget.id,
        name: budget.name,
        threshold: budget.threshold,
        currentSpend,
        percentage
      };
    });
  }

  async checkBudgetAlerts(): Promise<void> {
    const statuses = await this.getBudgetStatus();

    for (const status of statuses) {
      if (status.percentage >= 80) {
        await this.alertService.sendAlert({
          type: 'cost_warning',
          severity: status.percentage >= 100 ? 'critical' : 'warning',
          message: `${status.name} is at ${status.percentage.toFixed(1)}% of budget`,
          metadata: status
        });
      }
    }
  }

  async getCostByTenant(tenantId: string): Promise<TenantCost> {
    const tags = await this.cloudCostProvider.getResourceTags(tenantId);
    const costs = await this.cloudCostProvider.getCostsByTags(tags);

    return {
      tenantId,
      totalCost: costs.reduce((sum, c) => sum + c.amount, 0),
      byService: this.groupCostsByService(costs),
      byResource: this.groupCostsByResource(costs)
    };
  }

  async getCostAnomalies(): Promise<Anomaly[]> {
    const baseline = await this.calculateBaseline();
    const current = await this.getCurrentCosts();

    const anomalies: Anomaly[] = [];
    
    for (const [service, amount] of Object.entries(current)) {
      const baselineAmount = baseline[service] || 0;
      const change = ((amount - baselineAmount) / baselineAmount) * 100;
      
      if (Math.abs(change) > 20) { // 20% deviation threshold
        anomalies.push({
          service,
          expected: baselineAmount,
          actual: amount,
          change,
          direction: change > 0 ? 'increase' : 'decrease'
        });
      }
    }

    return anomalies;
  }
}
```

**2. Resource Right-Sizing Analysis**

```typescript
// services/right-sizing.service.ts
interface RightSizingRecommendation {
  resourceId: string;
  resourceType: string;
  currentSize: string;
  recommendedSize: string;
  estimatedSavings: number;
  confidence: 'high' | 'medium' | 'low';
  reason: string;
}

class RightSizingService {
  constructor(
    private cloudProvider: CloudProvider,
    private metricsProvider: MetricsProvider
  ) {}

  async analyzeRecommendations(): Promise<RightSizingRecommendation[]> {
    const resources = await this.cloudProvider.getComputResources();
    const recommendations: RightSizingRecommendation[] = [];

    for (const resource of resources) {
      const utilization = await this.getResourceUtilization(resource.id);
      const recommendation = this.evaluateResource(resource, utilization);
      
      if (recommendation) {
        recommendations.push(recommendation);
      }
    }

    return recommendations.sort((a, b) => b.estimatedSavings - a.estimatedSavings);
  }

  private async getResourceUtilization(resourceId: string): Promise<ResourceUtilization> {
    const metrics = await this.metricsProvider.getMetrics(resourceId, {
      period: '7d',
      interval: '1h'
    });

    return {
      cpu: this.calculatePercentile(metrics.cpu, 95),
      memory: this.calculatePercentile(metrics.memory, 95),
      networkIn: this.calculateAverage(metrics.networkIn),
      networkOut: this.calculateAverage(metrics.networkOut)
    };
  }

  private evaluateResource(
    resource: ComputeResource,
    utilization: ResourceUtilization
  ): RightSizingRecommendation | null {
    const currentSpec = this.getInstanceSpec(resource.type);
    
    // Check if under-utilized
    if (utilization.cpu < 20 && utilization.memory < 40) {
      const smallerInstance = this.findSmallerInstance(resource.type);
      
      if (smallerInstance && this.estimateSavings(resource.type, smallerInstance) > 10) {
        return {
          resourceId: resource.id,
          resourceType: resource.type,
          currentSize: currentSpec.vcpu + ' vCPU, ' + currentSpec.memory + ' GB',
          recommendedSize: smallerInstance.vcpu + ' vCPU, ' + smallerInstance.memory + ' GB',
          estimatedSavings: this.estimateSavings(resource.type, smallerInstance),
          confidence: utilization.cpu < 10 ? 'high' : 'medium',
          reason: 'CPU utilization under 20% for past 7 days'
        };
      }
    }

    // Check if over-provisioned in memory
    if (utilization.memory < 30 && currentSpec.memory > 8) {
      const optimizedInstance = this.findMemoryOptimizedInstance(resource.type);
      
      if (optimizedInstance) {
        return {
          resourceId: resource.id,
          resourceType: resource.type,
          currentSize: currentSpec.vcpu + ' vCPU, ' + currentSpec.memory + ' GB',
          recommendedSize: optimizedInstance.vcpu + ' vCPU, ' + optimizedInstance.memory + ' GB',
          estimatedSavings: this.estimateSavings(resource.type, optimizedInstance),
          confidence: 'medium',
          reason: 'Memory utilization under 30%'
        };
      }
    }

    return null;
  }

  async applyRecommendation(recommendation: RightSizingRecommendation): Promise<void> {
    // Validate recommendation
    if (recommendation.confidence !== 'high') {
      throw new ValidationError('Cannot apply medium/low confidence recommendations without review');
    }

    // Create backup/snapshot
    await this.createBackup(recommendation.resourceId);

    // Resize instance
    await this.cloudProvider.resizeInstance(
      recommendation.resourceId,
      recommendation.recommendedSize
    );

    // Monitor after resize
    await this.schedulePostResizeMonitoring(recommendation.resourceId);
  }
}
```

**3. Scheduled Resource Management**

```typescript
// services/scheduled-resource.service.ts
interface Schedule {
  id: string;
  resourcePattern: string;
  schedule: {
    timezone: string;
    stopTime: string; // e.g., "20:00"
    startTime: string; // e.g., "08:00"
    daysOfWeek: number[]; // 0-6, Sunday = 0
  };
  excludeDates?: Date[];
}

class ScheduledResourceService {
  constructor(
    private cloudProvider: CloudProvider,
    private scheduler: CronService
  ) {}

  async createSchedule(schedule: Schedule): Promise<void> {
    // Validate schedule
    this.validateSchedule(schedule);

    // Find matching resources
    const resources = await this.findResourcesByPattern(schedule.resourcePattern);
    
    // Create scheduler job
    await this.scheduler.createJob({
      name: `schedule-${schedule.id}`,
      cron: this.buildCronExpression(schedule.schedule),
      handler: async () => {
        await this.executeSchedule(schedule);
      }
    });

    // Store schedule
    await this.scheduleRepository.create(schedule);
  }

  private async executeSchedule(schedule: Schedule): Promise<void> {
    const now = new Date();
    
    // Check if should be running
    const shouldRun = this.shouldResourceBeRunning(now, schedule);
    const resources = await this.findResourcesByPattern(schedule.resourcePattern);

    for (const resource of resources) {
      const isRunning = await this.isResourceRunning(resource.id);
      
      if (shouldRun && !isRunning) {
        await this.startResource(resource);
        await this.logAction('start', resource.id);
      } else if (!shouldRun && isRunning) {
        await this.stopResource(resource);
        await this.logAction('stop', resource.id);
      }
    }
  }

  private shouldResourceBeRunning(time: Date, schedule: Schedule): boolean {
    const dayOfWeek = time.getDay();
    const timeStr = time.toTimeString().slice(0, 5); // HH:mm
    
    // Check if today is in schedule
    if (!schedule.schedule.daysOfWeek.includes(dayOfWeek)) {
      return false;
    }

    // Check if within active hours
    const currentMinutes = this.timeToMinutes(timeStr);
    const startMinutes = this.timeToMinutes(schedule.schedule.startTime);
    const stopMinutes = this.timeToMinutes(schedule.schedule.stopTime);

    return currentMinutes >= startMinutes && currentMinutes < stopMinutes;
  }

  async estimateSavings(): Promise<{
    currentMonthlyCost: number;
    scheduledMonthlyCost: number;
    estimatedSavings: number;
    percentageSaved: number;
  }> {
    const schedules = await this.scheduleRepository.findAll();
    let currentCost = 0;
    let scheduledCost = 0;

    for (const schedule of schedules) {
      const resources = await this.findResourcesByPattern(schedule.resourcePattern);
      
      for (const resource of resources) {
        const hourlyCost = await this.getHourlyCost(resource);
        const hoursPerWeek = this.calculateScheduledHours(schedule.schedule);
        
        currentCost += hourlyCost * 24 * 7; // 24/7
        scheduledCost += hourlyCost * hoursPerWeek;
      }
    }

    const monthlyMultiplier = 4.33; // Average weeks per month

    return {
      currentMonthlyCost: currentCost * monthlyMultiplier,
      scheduledMonthlyCost: scheduledCost * monthlyMultiplier,
      estimatedSavings: (currentCost - scheduledCost) * monthlyMultiplier,
      percentageSaved: ((currentCost - scheduledCost) / currentCost) * 100
    };
  }
}
```

**4. Reserved Instance Planning**

```typescript
// services/reserved-capacity.service.ts
interface ReservedCapacityRecommendation {
  resourceType: string;
  currentOnDemand: number;
  recommendedReserved: number;
  recommendedTerm: '1year' | '3year';
  paymentOption: 'all_upfront' | 'partial_upfront' | 'no_upfront';
  estimatedMonthlySavings: number;
  estimatedAnnualSavings: number;
}

class ReservedCapacityPlanningService {
  constructor(
    private cloudProvider: CloudProvider,
    private costProvider: CloudCostProvider
  ) {}

  async analyzeReservedCapacity(): Promise<ReservedCapacityRecommendation[]> {
    const usage = await this.getResourceUsage();
    const recommendations: ReservedCapacityRecommendation[] = [];

    for (const [instanceType, usageData] of Object.entries(usage)) {
      const utilizationHours = usageData.hoursPerMonth;
      const maxInstances = usageData.maxConcurrent;
      
      // Only recommend if consistently high usage
      if (utilizationHours < 600) { // Less than ~80% of month
        continue;
      }

      // Find optimal reserved quantity
      const recommendedQuantity = this.calculateOptimalReserved(
        maxInstances,
        utilizationHours,
        730 // hours per month
      );

      if (recommendedQuantity > 0) {
        const pricing = await this.getReservedPricing(instanceType);
        const onDemandPricing = await this.getOnDemandPricing(instanceType);
        
        const monthlyOnDemandCost = maxInstances * onDemandPricing.hourlyRate * 730;
        const monthlyReservedCost = recommendedQuantity * pricing.hourlyRate * 730 +
          (pricing.upfrontCost / 12); // For partial upfront

        recommendations.push({
          resourceType: instanceType,
          currentOnDemand: maxInstances,
          recommendedReserved: recommendedQuantity,
          recommendedTerm: pricing.oneYearRate < pricing.threeYearRate * 0.7 ? '1year' : '3year',
          paymentOption: 'partial_upfront',
          estimatedMonthlySavings: monthlyOnDemandCost - monthlyReservedCost,
          estimatedAnnualSavings: (monthlyOnDemandCost - monthlyReservedCost) * 12
        });
      }
    }

    return recommendations.sort(
      (a, b) => b.estimatedAnnualSavings - a.estimatedAnnualSavings
    );
  }

  private calculateOptimalReserved(
    maxConcurrent: number,
    hoursUsed: number,
    totalHours: number
  ): number {
    // Calculate utilization percentage
    const utilizationRate = hoursUsed / totalHours;
    
    // Determine reserved capacity based on utilization
    // If consistently at 70%+, reserve that amount
    if (utilizationRate >= 0.7) {
      return Math.ceil(maxConcurrent * utilizationRate);
    }
    
    // If variable, reserve a portion
    if (utilizationRate >= 0.4) {
      return Math.ceil(maxConcurrent * 0.5);
    }
    
    return 0;
  }

  async purchaseReservedCapacity(recommendation: ReservedCapacityRecommendation): Promise<void> {
    const purchase = await this.cloudProvider.purchaseReservedInstances({
      instanceType: recommendation.resourceType,
      quantity: recommendation.recommendedReserved,
      term: recommendation.recommendedTerm,
      paymentOption: recommendation.paymentOption
    });

    await this.logReservedPurchase(purchase);
  }
}
```

**5. Storage Cost Optimization**

```typescript
// services/storage-optimization.service.ts
interface StorageLifecycle {
  bucket: string;
  currentTier: string;
  recommendedTier: string;
  estimatedSavings: number;
  objectsToMove: number;
}

class StorageOptimizationService {
  constructor(
    private cloudProvider: CloudProvider,
    private storageProvider: StorageProvider
  ) {}

  async analyzeStorageLifecycle(): Promise<StorageLifecycle[]> {
    const buckets = await this.storageProvider.listBuckets();
    const recommendations: StorageLifecycle[] = [];

    for (const bucket of buckets) {
      const objects = await this.analyzeBucketObjects(bucket.name);
      
      for (const [tier, stats] of Object.entries(objects.byTier)) {
        const recommendedTier = this.calculateOptimalTier(stats);
        
        if (recommendedTier !== tier) {
          recommendations.push({
            bucket: bucket.name,
            currentTier: tier,
            recommendedTier,
            estimatedSavings: this.estimateTierSavings(tier, recommendedTier, stats.size),
            objectsToMove: stats.count
          });
        }
      }
    }

    return recommendations.sort((a, b) => b.estimatedSavings - a.estimatedSavings);
  }

  async configureLifecyclePolicies(bucket: string): Promise<void> {
    await this.storageProvider.putLifecyclePolicy(bucket, {
      rules: [
        {
          name: 'standard-to-infrequent',
          prefix: '',
          status: 'Enabled',
          transition: {
            days: 30,
            storageClass: 'STANDARD_IA' // Infrequent Access
          }
        },
        {
          name: 'infrequent-to-glacier',
          prefix: '',
          status: 'Enabled',
          transition: {
            days: 90,
            storageClass: 'GLACIER'
          }
        },
        {
          name: 'glacier-to-vault',
          prefix: '',
          status: 'Enabled',
          transition: {
            days: 365,
            storageClass: 'DEEP_ARCHIVE'
          }
        },
        {
          name: 'abort-incomplete-uploads',
          prefix: '',
          status: 'Enabled',
          abortIncompleteMultipartUpload: {
            daysAfterInitiation: 7
          }
        },
        {
          name: 'delete-old-versions',
          prefix: '',
          status: 'Enabled',
          noncurrentVersionTransition: {
            days: 30,
            storageClass: 'GLACIER'
          },
          noncurrentVersionExpiration: {
            days: 365
          }
        }
      ]
    });
  }

  async deleteOrphanedResources(): Promise<{
    snapshotsDeleted: number;
    volumesDeleted: number;
    estimatedSavings: number;
  }> {
    const orphanedSnapshots = await this.findOrphanedSnapshots();
    const orphanedVolumes = await this.findOrphanedVolumes();

    let savings = 0;

    for (const snapshot of orphanedSnapshots) {
      await this.storageProvider.deleteSnapshot(snapshot.id);
      savings += snapshot.size * this.pricing.snapshotPerGB;
    }

    for (const volume of orphanedVolumes) {
      await this.storageProvider.deleteVolume(volume.id);
      savings += volume.size * this.pricing.volumePerGB;
    }

    return {
      snapshotsDeleted: orphanedSnapshots.length,
      volumesDeleted: orphanedVolumes.length,
      estimatedSavings: savings
    };
  }
}
