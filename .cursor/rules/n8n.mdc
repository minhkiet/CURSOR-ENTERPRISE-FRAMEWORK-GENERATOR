**6. n8n Docker Setup**

```yaml
# docker-compose.yml
version: '3.8'

services:
  n8n:
    image: n8nio/n8n:latest
    container_name: n8n
    restart: unless-stopped
    ports:
      - "5678:5678"
    environment:
      - N8N_BASIC_AUTH_ACTIVE=true
      - N8N_BASIC_AUTH_USER=${N8N_USER}
      - N8N_BASIC_AUTH_PASSWORD=${N8N_PASSWORD}
      - N8N_HOST=${N8N_HOST}
      - N8N_PORT=5678
      - N8N_PROTOCOL=https
      - NODE_ENV=production
      - EXECUTIONS_DATA_SAVE_ON_ERROR=all
      - EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
      - EXECUTIONS_DATA_SAVE_ON_PROGRESS=true
      - EXECUTIONS_DATA_TIMEOUT=600
      - GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
      - N8N_DIAGNOSTICS_ENABLED=false
      - N8N_LOG_LEVEL=info
    volumes:
      - n8n_data:/home/node/.n8n
      - ./workflows:/home/node/workflow-folder
    depends_on:
      - postgres
      - redis
    networks:
      - n8n-network

  postgres:
    image: postgres:15-alpine
    container_name: n8n-postgres
    restart: unless-stopped
    environment:
      - POSTGRES_USER=${POSTGRES_USER}
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=n8n
      - POSTGRES_MAX_CONNECTIONS=200
    volumes:
      - postgres_n8n:/var/lib/postgresql/data
    networks:
      - n8n-network

  redis:
    image: redis:7-alpine
    container_name: n8n-redis
    restart: unless-stopped
    command: redis-server --maxmemory 256mb --maxmemory-policy allkeys-lru
    volumes:
      - redis_n8n:/data
    networks:
      - n8n-network

volumes:
  n8n_data:
  postgres_n8n:
  redis_n8n:

networks:
  n8n-network:
    driver: bridge
```

**7. Production Configuration**

```yaml
# n8n/configmap.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: n8n-config
data:
  N8N_LOG_LEVEL: "info"
  N8N_METRICS: "true"
  N8N_QUEUE_BULL_MESSAGES_TIMEOUT: "300"
  N8N_EXECUTIONS_TIMEOUT: "600"
  N8N_EXECUTIONS_TIMEOUT_MAX: "3600"
  N8N_DEFAULT_BINARY_DATA_MODE: "filesystem"
  N8N_ENCRYPTION_KEY: "${N8N_ENCRYPTION_KEY}"
  N8N_PAYLOAD_SIZE_MAX: "16"
  N8N_DISABLE_PRODUCTION_MAIN_PROCESS: "false"
  WEBHOOK_URL: "https://n8n.example.com"
  N8N_USER_FOLDERS: "/home/node/workflow-folder"

---
# n8n/deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: n8n
spec:
  replicas: 2
  selector:
    matchLabels:
      app: n8n
  template:
    metadata:
      labels:
        app: n8n
    spec:
      containers:
        - name: n8n
          image: n8nio/n8n:1.0.0
          ports:
            - containerPort: 5678
          envFrom:
            - configMapRef:
                name: n8n-config
            - secretRef:
                name: n8n-secrets
          resources:
            requests:
              cpu: 100m
              memory: 512Mi
            limits:
              cpu: 1000m
              memory: 2Gi
          livenessProbe:
            httpGet:
              path: /healthz
              port: 5678
          readinessProbe:
            httpGet:
              path: /healthz
              port: 5678
          volumeMounts:
            - name: n8n-data
              mountPath: /home/node/.n8n
            - name: workflows
              mountPath: /home/node/workflow-folder
      volumes:
        - name: n8n-data
          persistentVolumeClaim:
            claimName: n8n-pvc
        - name: workflows
          persistentVolumeClaim:
            claimName: workflows-pvc
```

## Workflow

**Phase 1: Requirements Gathering**

Identify automation needs. Map current process. Define success criteria. Estimate impact.

**Phase 2: Workflow Design**

Design flow. Identify triggers. Map data transformations. Plan error handling.

**Phase 3: Implementation**

Create workflow. Add nodes. Configure credentials. Test thoroughly.

**Phase 4: Testing**

Unit test nodes. Integration test. Error scenarios. Load test.

**Phase 5: Deployment**

Deploy to production. Monitor executions. Set up alerts. Train users.

**Phase 6: Maintenance**

Monitor performance. Optimize. Update. Document changes.

