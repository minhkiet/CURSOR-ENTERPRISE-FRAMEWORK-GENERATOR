## PHẦN G: CLARIFICATION FLOW (AMBIGUITY DETECTION)

### G.1 Khi nào cần Clarification

Request được coi là **ambiguous** khi:

```yaml
ambiguity_conditions:
  # 1. Request quá ngắn
  short_request:
    max_words: 3
    example: "Tạo app" → "Create app"
    
  # 2. Thiếu target rõ ràng
  missing_target:
    patterns: ["^create ", "^build ", "^add "]
    without_target: true
    example: "Create something" → missing target
    
  # 3. Thiếu action verb
  missing_action:
    required_keywords: ["create", "build", "fix", "add", "update", "delete", "remove"]
    example: "The login page" → no action verb
    
  # 4. Intent confidence thấp
  low_intent_confidence:
    threshold: 0.5
    example: intent_confidence < 0.5
    
  # 5. Multiple intents mạnh (conflict)
  multi_intent_conflict:
    score_gap: 0.15
    example: build=0.45, fix=0.40 (gap < 0.15)
    
  # 6. Không có domain được detect
  no_domain:
    min_domains: 1
    example: domain list empty
    
  # 7. Domain quan trọng nhưng thiếu context
  critical_domain_without_context:
    domains: ["security", "payment", "auth"]
    missing_tech_stack: true
```

### G.2 Ambiguity Detection Algorithm

```python
def detect_ambiguity(
    request: str,
    intent_analysis: dict,
    domain_detection: dict,
    skill_discovery: dict
) -> dict:
    """
    Detect if request is ambiguous and needs clarification
    Returns: {
        "is_ambiguous": bool,
        "reasons": list,
        "clarification_questions": list,
        "confidence": float
    }
    """
    request_lower = request.lower()
    word_count = len(request.split())
    reasons = []
    questions = []
    
    # 1. Check request length
    if word_count < 3:
        reasons.append("request_too_short")
        questions.append({
            "type": "scope",
            "question": "What specifically do you want to create/build/fix?",
            "examples": [
                "a landing page for my AI startup",
                "a login component with email and password",
                "a REST API for user management"
            ]
        })
    
    # 2. Check for missing target
    has_target = bool(re.search(
        r'\b(this|that|file|folder|app|page|component|'
        r'button|form|api|database|system|feature)\w*',
        request_lower
    ))
    if not has_target and word_count < 10:
        reasons.append("missing_target")
        questions.append({
            "type": "target",
            "question": "What is the target of this task?",
            "examples": [
                "a new React component",
                "an existing API endpoint",
                "the user dashboard"
            ]
        })
    
    # 3. Check intent confidence
    intent_confidence = intent_analysis.get("intent_confidence", 0)
    if intent_confidence < 0.5:
        reasons.append("low_intent_confidence")
        questions.append({
            "type": "intent",
            "question": "I noticed you want something done, but I'm not sure what action. "
                       "Do you want to:",
            "options": [
                "CREATE something new",
                "FIX an existing issue",
                "IMPROVE/upgrade current implementation",
                "REVIEW/audit current code"
            ]
        })
    
    # 4. Check multi-intent conflict
    intent_scores = intent_analysis.get("intent_scores", {})
    if len(intent_scores) >= 2:
        sorted_scores = sorted(intent_scores.values(), reverse=True)
        if len(sorted_scores) >= 2:
            gap = sorted_scores[0] - sorted_scores[1]
            if gap < 0.15 and sorted_scores[1] > 0.25:
                reasons.append("multi_intent_conflict")
                top_intents = sorted(intent_scores.items(), key=lambda x: x[1], reverse=True)[:2]
                questions.append({
                    "type": "priority",
                    "question": f"I detected two possible intents: "
                               f"'{top_intents[0][0]}' and '{top_intents[1][0]}'. "
                               f"Which is your priority?",
                    "options": [f"{i[0]} (priority)" for i in top_intents]
                })
    
    # 5. Check domain detection
    if not domain_detection.get("detected_domains"):
        reasons.append("no_domain_detected")
        questions.append({
            "type": "domain",
            "question": "What type of task is this?",
            "options": [
                "Frontend (UI/UX/Components)",
                "Backend (API/Database/Server)",
                "Full-stack (both frontend and backend)",
                "DevOps (deployment/CI-CD)"
            ]
        })
    
    # 6. Check critical domains without tech context
    critical_domains = ["security", "payment"]
    detected_critical = [d for d in domain_detection.get("detected_domains", [])
                        if d.get("domain") in critical_domains]
    
    if detected_critical:
        tech_context = detect_tech_context(request)
        if not tech_context:
            reasons.append("critical_domain_no_tech_context")
            questions.append({
                "type": "tech_stack",
                "question": f"For this {detected_critical[0]['domain']} task, "
                           f"what technology are you using?",
                "examples": [
                    "React + Node.js",
                    "Next.js + Prisma",
                    "Vue + Laravel"
                ]
            })
    
    # 7. Special check for "vague" keywords
    vague_keywords = ["something", "stuff", "things", "it", "this", "that"]
    if any(kw in request_lower for kw in vague_keywords) and word_count < 8:
        reasons.append("contains_vague_keywords")
        questions.append({
            "type": "specificity",
            "question": "Can you be more specific about what you mean?",
            "hint": "Instead of 'something', please name the actual component/file/feature."
        })
    
    # Calculate overall ambiguity
    is_ambiguous = len(reasons) > 0
    ambiguity_confidence = min(1.0, len(reasons) * 0.25)
    
    return {
        "is_ambiguous": is_ambiguous,
        "reasons": reasons,
        "clarification_questions": questions,
        "ambiguity_confidence": ambiguity_confidence,
        "severity": "high" if len(reasons) >= 2 else "medium" if len(reasons) == 1 else "low"
    }
```

### G.3 Clarification Question Generation

```python
def generate_clarification_prompt(ambiguity_result: dict) -> str:
    """
    Generate user-friendly clarification prompt
    """
    if not ambiguity_result["is_ambiguous"]:
        return None
    
    lines = []
    lines.append("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    lines.append("📋 CLARIFICATION NEEDED")
    lines.append("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    lines.append("")
    lines.append("I need some additional information to proceed accurately:")
    lines.append("")
    
    for i, question in enumerate(ambiguity_result["clarification_questions"], 1):
        lines.append(f"{i}. **{question['type'].upper()}**: {question['question']}")
        
        if question.get("options"):
            for opt in question["options"]:
                lines.append(f"   - {opt}")
        
        if question.get("examples"):
            lines.append("   Examples:")
            for ex in question["examples"]:
                lines.append(f"   • {ex}")
        
        if question.get("hint"):
            lines.append(f"   💡 Hint: {question['hint']}")
        
        lines.append("")
    
    lines.append("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    lines.append("")
    lines.append("Your clarification will help me:")
    lines.append("  • Select the correct skills and rules")
    lines.append("  • Choose the right approach")
    lines.append("  • Execute the task correctly on first attempt")
    
    return "\n".join(lines)


def process_clarification_response(
    original_request: str,
    user_response: str,
    question_type: str
) -> dict:
    """
    Process user's clarification response and merge with original request
    """
    # Update request with clarified information
    clarified_request = {
        "original": original_request,
        "clarification": user_response,
        "question_type": question_type,
        "merged": f"{original_request} {user_response}"
    }
    
    return clarified_request
```

