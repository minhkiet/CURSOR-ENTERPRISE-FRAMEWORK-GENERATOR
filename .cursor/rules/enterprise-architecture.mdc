**5. Architecture Review Process**

```typescript
// Architecture Review Service
export interface ArchitectureReview {
  id: string;
  requester: string;
  title: string;
  type: 'new-system' | 'significant-change' | 'standards-exception';
  status: 'draft' | 'submitted' | 'under-review' | 'approved' | 'rejected' | 'deferred';
  submissionDate: Date;
  reviewDate?: Date;
  decision?: string;
  reviewers: Reviewer[];
  impactAssessment: ImpactAssessment;
  risks: Risk[];
  alternatives: Alternative[];
  approvalCriteria: ApprovalCriterion[];
}

export interface ImpactAssessment {
  businessImpact: 'high' | 'medium' | 'low';
  technicalComplexity: 'high' | 'medium' | 'low';
  costImpact: { estimated: number; currency: string };
  timelineImpact: string;
  dependencies: string[];
}

export class ArchitectureReviewService {
  constructor(
    private reviewRepository: ReviewRepository,
    private arb: ArchitectureReviewBoard,
    private notificationService: NotificationService
  ) {}

  async submitReview(request: ArchitectureReviewRequest): Promise<string> {
    // Validate request
    this.validateRequest(request);
    
    // Create review
    const review = await this.reviewRepository.create({
      ...request,
      status: 'submitted',
      submissionDate: new Date()
    });

    // Assign reviewers based on type and impact
    const reviewers = await this.assignReviewers(request);
    review.reviewers = reviewers;

    // Notify reviewers
    await this.notifyReviewers(review);

    // Schedule review meeting
    await this.scheduleReviewMeeting(review);

    return review.id;
  }

  async approveReview(reviewId: string, decision: string): Promise<void> {
    const review = await this.reviewRepository.findById(reviewId);
    
    if (!review) {
      throw new NotFoundError('Review not found');
    }

    // Check if all required approvals received
    const requiredApprovals = this.getRequiredApprovers(review.type);
    const allApproved = requiredApprovals.every(
      role => review.reviewers.some(r => r.role === role && r.decision === 'approved')
    );

    if (!allApproved) {
      throw new ValidationError('Not all required approvers have voted');
    }

    // Update review
    await this.reviewRepository.update(reviewId, {
      status: 'approved',
      decision,
      reviewDate: new Date()
    });

    // Publish decision
    await this.eventBus.publish(new ArchitectureReviewApprovedEvent(reviewId));
  }

  private async assignReviewers(request: ArchitectureReviewRequest): Promise<Reviewer[]> {
    const baseReviewers = [
      { role: 'domain-architect', required: true },
      { role: 'security-architect', required: true },
      { role: 'infrastructure-architect', required: request.type !== 'standards-exception' }
    ];

    if (request.impactAssessment.businessImpact === 'high') {
      baseReviewers.push({ role: 'enterprise-architect', required: true });
    }

    return baseReviewers.map(async reviewer => ({
      ...reviewer,
      assignee: await this.arb.getReviewer(reviewer.role),
      decision: null,
      comments: null
    }));
  }
}
```

**6. Application Portfolio Management**

```typescript
// Application Portfolio Service
export interface Application {
  id: string;
  name: string;
  domain: string;
  classification: 'tier1' | 'tier2' | 'tier3';
  status: 'active' | 'sunsetting' | 'sunset' | 'planned';
  technology: TechnologyProfile;
  ownership: TeamOwnership;
  metrics: ApplicationMetrics;
  health: ApplicationHealth;
  modernization?: ModernizationPlan;
}

interface TechnologyProfile {
  language: string;
  framework: string;
  database: string;
  hosting: string;
  lastUpdated: Date;
  endOfLife?: Date;
}

interface ApplicationMetrics {
  usage: { users: number; apiCalls: number };
  performance: { p99: number; errorRate: number };
  reliability: { availability: number; mttr: number };
}

export class PortfolioService {
  async getPortfolioDashboard(): Promise<PortfolioDashboard> {
    const applications = await this.portfolioRepository.findAll();
    
    return {
      summary: {
        total: applications.length,
        byTier: this.groupByTier(applications),
        byStatus: this.groupByStatus(applications),
        byTechnology: this.groupByTechnology(applications)
      },
      healthSummary: this.calculateHealthSummary(applications),
      modernizationPipeline: await this.getModernizationPipeline(),
      risks: await this.identifyRisks(applications)
    };
  }

  async assessModernizationCandidates(): Promise<ModernizationCandidate[]> {
    const applications = await this.portfolioRepository.findAll({ status: 'active' });
    const candidates: ModernizationCandidate[] = [];

    for (const app of applications) {
      const score = this.calculateModernizationScore(app);
      
      if (score >= 70) {
        candidates.push({
          application: app,
          score,
          recommendation: this.getModernizationRecommendation(app, score),
          estimatedEffort: this.estimateEffort(app),
          businessValue: await this.assessBusinessValue(app)
        });
      }
    }

    return candidates.sort((a, b) => b.score - a.score);
  }

  private calculateModernizationScore(app: Application): number {
    let score = 0;

    // Age factor (older = higher score)
    const age = yearsSince(app.technology.lastUpdated);
    score += Math.min(age * 10, 30);

    // Technology risk
    if (app.technology.endOfLife && app.technology.endOfLife < addYears(new Date(), 2)) {
      score += 25;
    }

    // Support availability
    if (app.technology.framework === 'legacy-framework') {
      score += 20;
    }

    // Cost factor
    const costPerUser = app.metrics.cost / app.metrics.usage.users;
    if (costPerUser > 100) {
      score += 15;
    }

    return Math.min(score, 100);
  }

  async initiateModernization(applicationId: string, plan: ModernizationPlan): Promise<void> {
    const application = await this.portfolioRepository.findById(applicationId);
    
    await this.portfolioRepository.update(applicationId, {
      modernization: plan,
      status: 'modernization-planned'
    });

    await this.eventBus.publish(new ModernizationInitiatedEvent(applicationId, plan));
  }
}
```

## Workflow

**Phase 1: Current State Assessment**

Document existing systems. Map technology landscape. Identify pain points. Assess capabilities.

**Phase 2: Target Architecture**

Define target state. Align with business goals. Create roadmaps. Define principles.

**Phase 3: Governance Framework**

Establish review process. Define standards. Create ADRs. Set up review board.

**Phase 4: Implementation**

Execute roadmaps. Apply principles. Build reference architectures. Train teams.

**Phase 5: Continuous Improvement**

Monitor compliance. Update standards. Review principles. Evolve architecture.

