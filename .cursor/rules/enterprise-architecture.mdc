// ADR Template and Management
export interface ADR {
  id: string;
  title: string;
  status: 'proposed' | 'accepted' | 'deprecated' | 'superseded';
  date: Date;
  context: string;
  decision: string;
  consequences: {
    positive: string[];
    negative: string[];
    neutral: string[];
  };
  alternatives: Alternative[];
  relatedADRs: string[];
}

interface Alternative {
  option: string;
  pros: string[];
  cons: string[];
  whyRejected: string;
}

// Example ADR
export const adr001: ADR = {
  id: 'ADR-001',
  title: 'Use PostgreSQL as Primary Database',
  status: 'accepted',
  date: new Date('2024-01-15'),
  context: `
    We need to select a primary database for our e-commerce platform.
    Requirements include:
    - ACID compliance for transactions
    - Complex query support
    - High availability
    - Scalability
    - Strong ecosystem
  `,
  decision: `
    We will use PostgreSQL as the primary relational database for all domains.
    - Use Amazon RDS or Azure Database for managed service
    - Use read replicas for read scaling
    - Use PgBouncer for connection pooling
    - Standardize on PostgreSQL 15+
  `,
  consequences: {
    positive: [
      'Strong ACID compliance for transactions',
      'Excellent JSON support for flexible schemas',
      'Rich ecosystem with many extensions',
      'Strong community and documentation'
    ],
    negative: [
      'Horizontal scaling is more complex than NoSQL',
      'Requires careful tuning for high write loads'
    ],
    neutral: [
      'Not the fastest option but sufficient',
      'Requires operational expertise'
    ]
  },
  alternatives: [
    {
      option: 'MySQL',
      pros: ['Well-known', 'High performance for reads'],
      cons: ['Less feature-rich than PostgreSQL', 'Different JSON support'],
      whyRejected: 'PostgreSQL provides better feature set for our needs'
    },
    {
      option: 'MongoDB',
      pros: ['Easy horizontal scaling', 'Flexible schema'],
      cons: ['Not ACID compliant by default', 'Less suitable for complex joins'],
      whyRejected: 'We need strong ACID compliance for orders and payments'
    }
  ],
  relatedADRs: ['ADR-002', 'ADR-015']
};
