### 9. Test Data Builders

Create maintainable test data.

```typescript
// Test data builder pattern
class OrderBuilder {
    private id: OrderId = OrderId.generate();
    private customerId: CustomerId = new CustomerId('default-customer');
    private items: OrderItem[] = [];
    private status: OrderStatus = OrderStatus.DRAFT;
    private address: Address = testAddress();

    withId(id: OrderId): this {
        this.id = id;
        return this;
    }

    withCustomer(customerId: CustomerId): this {
        this.customerId = customerId;
        return this;
    }

    withItem(product: Product, quantity: number): this {
        this.items.push(OrderItem.create(product, new Quantity(quantity)));
        return this;
    }

    withStatus(status: OrderStatus): this {
        this.status = status;
        return this;
    }

    build(): Order {
        const order = Order.create(this.customerId, this.address);
        
        for (const item of this.items) {
            order.addItem(item.product, item.quantity);
        }

        if (this.status === OrderStatus.CONFIRMED) {
            order.confirm('pay-123');
        }

        return order;
    }
}

// Usage in tests
describe('Order Tests', () => {
    it('should calculate total correctly', () => {
        const order = new OrderBuilder()
            .withCustomer(new CustomerId('cust-123'))
            .withItem(testProduct('A', 100), 2)
            .withItem(testProduct('B', 50), 1)
            .build();

        expect(order.total.amount).toBe(250);
    });

    it('should not modify confirmed order', () => {
        const order = new OrderBuilder()
            .withStatus(OrderStatus.CONFIRMED)
            .withItem(testProduct(), 1)
            .build();

        expect(() => {
            order.addItem(testProduct(), 1);
        }).toThrow();
    });
});
```

### 10. Test Performance

Keep tests fast và efficient.

```typescript
// Fast unit tests (ms)
describe('Unit Tests', () => {
    // Should run in < 100ms each
});

// Slower integration tests
describe('Integration Tests', () => {
    // Database tests - use transactions
    beforeEach(async () => {
        await db.beginTransaction();
    });

    afterEach(async () => {
        await db.rollbackTransaction();
    });
});

// Test execution optimization
describe('Performance', () => {
    // Parallel execution
    it('should run in parallel with other tests', () => {
        // Tests in different describe blocks can run in parallel
    });

    // Skipping slow tests
    it.skip('slow test - run only when needed', () => {
        // ...
    });

    // Test selection
    const runSlowTests = process.env.SLOW_TESTS === 'true';

    (runSlowTests ? it : it.skip)('slow integration test', () => {
        // ...
    });
});
```

## Checklist

- [ ] Write tests before code (TDD)
- [ ] Use descriptive test names
- [ ] Follow AAA pattern
- [ ] Keep tests isolated
- [ ] Mock external dependencies
- [ ] Test edge cases
- [ ] Aim for meaningful coverage
- [ ] Use test data builders
- [ ] Run tests frequently
- [ ] Refactor tests like production code
- [ ] Include performance tests
- [ ] Document test rationale

## Anti Patterns

### 1. Testing Implementation Details

```typescript
// Không nên - testing internal implementation
it('should call internal method', () => {
    const spy = jest.spyOn(order, 'privateMethod' as any);
    order.publicMethod();
    expect(spy).toHaveBeenCalled();
});

// Nên - testing behavior
it('should update order status when confirmed', () => {
    order.confirm('payment-123');
    expect(order.status).toBe(OrderStatus.CONFIRMED);
});
```

### 2. Over-Mocking

```typescript
// Không nên - mocking everything
it('should return order', () => {
    const mockOrder = {
        id: '123',
        items: [],
        status: 'DRAFT',
        confirm: jest.fn()
    };
    mockRepository.findById.mockResolvedValue(mockOrder);
});

// Nên - use real objects when possible
it('should return order', () => {
    const realOrder = Order.create(testCustomerId(), testAddress());
    mockRepository.findById.mockResolvedValue(realOrder);

    const result = service.getOrder('123');

    expect(result.id.value).toBe(realOrder.id.value);
});
```

### 3. Brittle Tests

```typescript
// Không nên - testing exact formatting
it('should format date correctly', () => {
    expect(formatDate(new Date('2024-01-01'))).toBe('01/01/2024');
});

// Nên - testing behavior
it('should display date in user locale', () => {
    expect(formatDate(date, 'en-US')).toMatch(/\d{1,2}\/\d{1,2}\/\d{4}/);
});
```

### 4. Test After Code

```typescript
// Không nên - writing tests after implementation
describe('Order', () => {
    // Implementation already exists...
    it('should do something', () => {
        // Just to increase coverage
    });
});

// Nên - TDD approach
describe('Order', () => {
    // Write test first
    it('should allow adding items', () => {
        // Test first - fails
    });
});

// Then implementation
class Order {
    addItem() { /* ... */ }
}
```

### 5. Complex Setup

```typescript
// Không nên - complex, unclear setup
beforeEach(async () => {
    await setupDatabase();
    await seedUsers();
    await seedProducts();
    await seedOrders();
    await setupMocks();
    // ... 100 lines
});

// Nên - clear, focused setup
beforeEach(() => {
    repository = new InMemoryOrderRepository();
    service = new OrderService(repository);
});
```

## Best Practices

### 1. Test Organization

```typescript
// By feature
describe('Order Feature', () => {
    describe('Create Order', () => {});
    describe('Update Order', () => {});
    describe('Cancel Order', () => {});
});

// By layer
describe('Domain', () => {
    describe('Entities', () => {});
    describe('ValueObjects', () => {});
    describe('Aggregates', () => {});
});

describe('Application', () => {
    describe('UseCases', () => {});
    describe('Services', () => {});
});

describe('Infrastructure', () => {
    describe('Repositories', () => {});
    describe('Adapters', () => {});
});
```

### 2. Continuous Testing

```typescript
// package.json scripts
{
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:ci": "jest --ci --runInBand"
    }
}

// CI pipeline
test:
  script:
    - npm ci
    - npm run lint
    - npm run test:ci
  coverage:
    paths:
      - coverage/
```

### 3. Test Doubles

```typescript
// Different types of test doubles
// Dummy - passed but never used
const dummyLogger: Logger = {
    info: () => {},
    error: () => {}
};

// Fake - simplified implementation
class FakeOrderRepository implements IOrderRepository {
    private orders: Map<string, Order> = new Map();

    async save(order: Order) { this.orders.set(order.id.value, order); }
    async findById(id) { return this.orders.get(id.value) || null; }
}

// Stub - provides predefined answers
const stubPaymentGateway = {
    charge: jest.fn().mockResolvedValue({ success: true, paymentId: 'pay-123' })
};

// Spy - records information
const repository = {
    save: jest.fn()
};
service.save(order);
expect(repository.save).toHaveBeenCalledWith(order);

// Mock - pre-programmed expectations
const mockService = {
    processPayment: jest.fn()
};
```

## Workflow

### 1. TDD Cycle

1. Write failing test (Red)
2. Run test to verify failure
3. Write minimal code (Green)
4. Run test to verify pass
5. Refactor code (Refactor)
6. Run tests to verify
7. Repeat

### 2. Test Selection

1. Start with happy path
2. Add edge cases
3. Add error cases
4. Add boundary conditions
5. Test critical paths

### 3. Coverage Review

1. Run coverage report
2. Identify untested paths
3. Add missing tests
4. Remove dead code

## Ví dụ

### Ví dụ 1: Complete TDD Example

```typescript
// STEP 1: Write failing test (Red)
describe('Money', () => {
    describe('add', () => {
        it('should add two money values with same currency', () => {
            const m1 = new Money(100, Currency.USD);
            const m2 = new Money(50, Currency.USD);

            const result = m1.add(m2);

            expect(result.amount).toBe(150);
            expect(result.currency).toBe(Currency.USD);
        });
    });
});

// Test fails: Money class doesn't exist yet

// STEP 2: Write minimal code (Green)
class Money {
    constructor(
        public readonly amount: number,
        public readonly currency: Currency
    ) {}

    add(other: Money): Money {
        return new Money(this.amount + other.amount, this.currency);
    }
}

// Test passes

// STEP 3: Add more tests
it('should throw when adding different currencies', () => {
    const m1 = new Money(100, Currency.USD);
    const m2 = new Money(50, Currency.EUR);

    expect(() => m1.add(m2)).toThrow(CurrencyMismatchException);
});

// Test fails: No currency check

// STEP 4: Refactor
class Money {
    constructor(
        public readonly amount: number,
        public readonly currency: Currency
    ) {}

    add(other: Money): Money {
        if (!this.currency.equals(other.currency)) {
            throw new CurrencyMismatchException(this.currency, other.currency);
        }
        return new Money(this.amount + other.amount, this.currency);
    }
}

// All tests pass
```

### Ví dụ 2: Service Testing

```typescript
describe('OrderService', () => {
    let service: OrderService;
    let mockRepository: Mocked<IOrderRepository>;
    let mockPaymentGateway: Mocked<IPaymentGateway>;

    beforeEach(() => {
        mockRepository = createMock<IOrderRepository>();
        mockPaymentGateway = createMock<IPaymentGateway>();
        service = new OrderService(mockRepository, mockPaymentGateway);
    });

    describe('createOrder', () => {
        it('should create order with confirmed status', async () => {
            // Arrange
            const input = createOrderInput();
            mockPaymentGateway.charge.mockResolvedValue({
                success: true,
                paymentId: 'pay-123'
            });

            // Act
            const result = await service.createOrder(input);

            // Assert
            expect(result.status).toBe('CONFIRMED');
            expect(result.paymentId).toBe('pay-123');
        });

        it('should rollback on payment failure', async () => {
            mockPaymentGateway.charge.mockResolvedValue({
                success: false,
                error: 'Card declined'
            });

            await expect(service.createOrder(testInput()))
                .rejects.toThrow(PaymentFailedException);

            expect(mockRepository.save).not.toHaveBeenCalled();
        });
    });
});
```

### Ví dụ 3: BDD Scenarios

```typescript
// BDD-style tests
describe('Order Cancellation', () => {
    scenario('customer can cancel draft order', () => {
        given('an order in DRAFT status');
        when('customer cancels the order');
        then('order status should be CANCELLED');
        and('order should be marked for cleanup');
    });

    scenario('customer cannot cancel shipped order', () => {
        given('an order in SHIPPED status');
        when('customer tries to cancel');
        then('error should be returned');
        and('order status should remain SHIPPED');
    });

    scenario('refund should be processed on cancellation', () => {
        given('a confirmed order with payment');
        when('order is cancelled');
        then('refund should be processed');
        and('customer should receive confirmation email');
    });
});
```

