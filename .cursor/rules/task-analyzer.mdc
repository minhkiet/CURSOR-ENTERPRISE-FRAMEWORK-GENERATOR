### 3.3 Skill Auto-Discovery Matrix

```yaml
skill_detection:
  rules:
    - name: "Mandatory Skills"
      description: "Always applied regardless of detection"
      skills:
        - karpathy-coding  # All coding tasks
        - frontend-review  # All frontend tasks
    
    - name: "Threshold-Based"
      description: "Applied when confidence >= threshold"
      rules:
        - skill: "frontend-taste"
          threshold: 0.75
          keywords: ["landing page", "portfolio", "homepage", "marketing site", "trang đích"]
          
        - skill: "frontend-redesign"
          threshold: 0.75
          keywords: ["redesign", "upgrade", "improve existing", "modernize", "cải thiện"]
          
        - skill: "full-output"
          threshold: 0.80
          keywords: ["full implementation", "complete", "not skeleton", "no TODO", "hoàn chỉnh"]
          
        - skill: "security-review"
          threshold: 0.85
          keywords: ["security", "vulnerability", "auth", "JWT", "pentest", "bảo mật"]
          
        - skill: "vietnam-payment-review"
          threshold: 0.90
          keywords: ["MoMo", "SePay", "PayOS", "VNPay", "ZaloPay", "VietQR", "thanh toán"]
          
        - skill: "weknora-kb"
          threshold: 0.90
