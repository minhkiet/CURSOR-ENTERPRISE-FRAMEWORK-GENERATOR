```hcl
# environments/prod/main.tf
terraform {
  required_version = ">= 1.5.0"
  
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
  
  backend "s3" {
    bucket         = "terraform-state-prod"
    key            = "prod/main.tfstate"
    region         = "us-east-1"
    encrypt        = true
    dynamodb_table = "terraform-locks"
  }
}

provider "aws" {
  region = var.region
  
  default_tags {
    tags = {
      Project     = var.project
      Environment = var.environment
      ManagedBy   = "terraform"
    }
  }
}

module "vpc" {
  source = "../../modules/vpc"
  
  project           = var.project
  environment       = var.environment
  availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]
  vpc_cidr          = "10.0.0.0/16"
}

module "eks" {
  source = "../../modules/eks"
  
  project           = var.project
  environment       = var.environment
  vpc_id            = module.vpc.vpc_id
  subnet_ids        = module.vpc.private_app_subnet_ids
  eks_cluster_version = "1.29"
  
  node_groups = {
    general = {
      instance_types = ["m6i.xlarge"]
      min_size      = 3
      max_size      = 10
      desired_size  = 3
    }
    memory_optimized = {
      instance_types = ["r6i.xlarge"]
      min_size      = 1
      max_size      = 5
      desired_size  = 1
      taints = [
        {
          key    = "workload"
          value  = "memory-intensive"
          effect = "NO_SCHEDULE"
        }
      ]
    }
  }
}

module "rds" {
  source = "../../modules/rds"
  
  project         = var.project
  environment     = var.environment
  vpc_id          = module.vpc.vpc_id
  subnet_ids      = module.vpc.db_subnet_ids
  db_instance_class = "db.r6g.large"
  
  cluster_config = {
    engine_version = "15.3"
    replica_count = 2
  }
}

module "alb" {
  source = "../../modules/alb"
  
  project     = var.project
  environment = var.environment
  vpc_id      = module.vpc.vpc_id
  subnet_ids  = module.vpc.public_subnet_ids
  
  enable_deletion_protection = true
}
```

**5. Cost Optimization**

```yaml
# terraform/cost-optimization/budgets.tf
resource "aws_budgets_budget" "monthly_cost" {
  name         = "${var.project}-${var.environment}-monthly-cost"
  budget_type  = "COST"
  limit_amount = var.monthly_budget
  limit_unit   = "USD"
  time_period_start = dateformat(time_static_now(), "%Y-%m-01")
  time_unit    = "MONTHLY"
  
  notification {
    comparison_operator        = "GREATER_THAN"
    threshold                  = 80
    threshold_type             = "PERCENTAGE"
    notification_type          = "ACTUAL"
    subscriber_email_addresses = var.alert_emails
  }
}

# Cost allocation tags
resource "aws_resourcegroups_group" "cost_allocation" {
  name = "${var.project}-${var.environment}-cost-tags"
  
  resource_query {
    query = jsonencode({
      ResourceTypeFilters = ["AWS::AllSupported"]
      TagFilters = [{
        Key    = "Project"
        Values = [var.project]
      }]
    })
  }
}
```

**6. Backup và Disaster Recovery**

```yaml
# terraform/backup/backup-plan.tf
resource "aws_backup_plan" "main" {
  name = "${var.project}-${var.environment}-backup-plan"
  
  rule {
    name                = "daily-backup"
    target_vault_name   = aws_backup_vault.main.name
    schedule            = "cron(0 5 ? * * *)"  # 5 AM UTC
    start_window        = 60
    completion_window   = 300
    
    lifecycle {
      delete_after = 35
    }
  }
  
  rule {
    name                = "weekly-backup"
    target_vault_name   = aws_backup_vault.main.name
    schedule            = "cron(0 6 ? * SUN *)"  # Sunday 6 AM UTC
    start_window        = 60
    completion_window   = 300
    
    lifecycle {
      delete_after = 365
    }
  }
  
  advanced_backup_settings {
    resource_type = "EFS"
    backup_options = {
      WindowsVSSEnabled = false
    }
  }
}

resource "aws_backup_selection" "main" {
  name         = "${var.project}-${var.environment}-backup-selection"
  plan_id      = aws_backup_plan.main.id
  vault_arn    = aws_backup_vault.main.arn
  
  resources = [
    aws_rds_cluster.main.arn,
    aws_efs_file_system.main.arn,
    aws_db_instance.main.arn
  ]
  
  condition {
    string_equals {
      key   = "aws:ResourceTag/Backup"
      value = "true"
    }
  }
}
```

