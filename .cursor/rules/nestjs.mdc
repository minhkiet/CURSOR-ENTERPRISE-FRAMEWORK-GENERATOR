// modules/notifications/notifications.listener.ts
import { Injectable } from '@nestjs/common';
import { OnEvent } from '@nestjs/event-emitter';
import { NotificationsService } from './notifications.service';
import { OrderCreatedEvent } from '@/modules/orders/orders.events';

@Injectable()
export class OrdersEventListener {
  constructor(
    private readonly notificationsService: NotificationsService
  ) {}

  @OnEvent('order.created', { async: true })
  async handleOrderCreated(event: OrderCreatedEvent) {
    await this.notificationsService.sendOrderConfirmation({
      customerId: event.customerId,
      orderId: event.orderId,
      total: event.total
    });
    
    await this.notificationsService.notifyAdmins({
      type: 'new-order',
      orderId: event.orderId,
      message: `New order #${event.orderId} placed`
    });
  }
}
