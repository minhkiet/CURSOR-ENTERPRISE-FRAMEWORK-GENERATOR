## Anti Pattern

**1. Ignoring Token Count**

Not tracking token usage. Unexpected high costs. Context overflow. Poor performance.

**2. Poor Prompt Structure**

Vague instructions. Missing context. Conflicting requests. Poor results.

**3. Overusing Opus**

Using Opus for simple tasks. High costs. Slower responses. Wasted capability.

**4. Ignoring Safety**

Attempting to bypass guidelines. Misusing Claude. Poor results. Policy violations.

**5. No Retry Logic**

Single API attempts. Poor reliability. User frustration. Inconsistent experience.

## Best Practice

**1. Claude SDK Setup**

```typescript
// lib/claude.ts
import Anthropic from '@anthropic-ai/sdk';

const anthropic = new Anthropic({
  apiKey: process.env.ANTHROPIC_API_KEY,
  timeout: 120000, // 2 minutes
  maxRetries: 3,
});

// Helper for retries
async function withClaudeRetry<T>(
  fn: () => Promise<T>,
  maxRetries: number = 3
): Promise<T> {
  let lastError: Error | null = null;

  for (let attempt = 0; attempt < maxRetries; attempt++) {
    try {
      return await fn();
    } catch (error: any) {
      lastError = error;

      // Rate limit - wait and retry
      if (error.status === 429) {
        const delay = Math.pow(2, attempt) * 1000;
        await sleep(delay);
        continue;
      }

      // Server error - retry
      if (error.status >= 500) {
        const delay = Math.pow(2, attempt) * 1000;
        await sleep(delay);
        continue;
      }

      // Client error - don't retry
      throw error;
    }
  }

  throw lastError;
}
```

**2. Message Creation**

```typescript
// services/claude-text.service.ts
interface ClaudeMessage {
  role: 'user' | 'assistant';
  content: string | ClaudeContentBlock[];
}

interface ClaudeContentBlock {
  type: 'text' | 'tool_use' | 'tool_result';
  text?: string;
  id?: string;
  name?: string;
  input?: Record<string, any>;
  tool_use_id?: string;
  content?: string;
}

interface ClaudeResponse {
  id: string;
  type: string;
  role: string;
  content: ClaudeContentBlock[];
  model: string;
  stop_reason: string;
  stop_sequence: string | null;
  usage: {
    input_tokens: number;
    output_tokens: number;
  };
}

class ClaudeTextService {
  async createMessage(
    messages: ClaudeMessage[],
    systemPrompt?: string,
    options: {
      model?: 'claude-opus-4' | 'claude-sonnet-4' | 'claude-haiku-3';
      maxTokens?: number;
      temperature?: number;
      topP?: number;
      topK?: number;
    } = {}
  ): Promise<ClaudeResponse> {
    const {
      model = 'claude-sonnet-4',
      maxTokens = 4096,
      temperature = 0.7,
      topP,
      topK
    } = options;

    const request: any = {
      model,
      messages,
      max_tokens: maxTokens,
      temperature,
    };

    if (systemPrompt) {
      request.system = systemPrompt;
    }

    if (topP) {
      request.top_p = topP;
    }

    if (topK) {
      request.top_k = topK;
    }

    return withClaudeRetry(() =>
      anthropic.messages.create(request)
    );
  }

  async generateText(
    prompt: string,
    systemPrompt?: string,
    options: any = {}
  ): Promise<string> {
    const response = await this.createMessage(
      [{ role: 'user', content: prompt }],
      systemPrompt,
      options
    );

    return response.content[0].text || '';
  }

  async chat(
    messages: Array<{ role: string; content: string }>,
    systemPrompt?: string,
    options: any = {}
  ): Promise<string> {
    const claudeMessages = messages.map(msg => ({
      role: msg.role === 'assistant' ? 'assistant' : 'user',
      content: msg.content,
    }));

    const response = await this.createMessage(
      claudeMessages,
      systemPrompt,
      options
    );

    return response.content[0].text || '';
  }
}
```

**3. Tool Use**

```typescript
// services/claude-tool.service.ts
const tools = [
  {
    name: 'get_weather',
    description: 'Get the current weather for a location',
    input_schema: {
      type: 'object',
      properties: {
        location: {
          type: 'string',
          description: 'City name, e.g. San Francisco, CA',
        },
        unit: {
          type: 'string',
          enum: ['celsius', 'fahrenheit'],
          description: 'Temperature unit',
        },
      },
      required: ['location'],
    },
  },
  {
    name: 'search_database',
    description: 'Search the database for records',
    input_schema: {
      type: 'object',
      properties: {
        query: {
          type: 'string',
          description: 'Search query',
        },
        table: {
          type: 'string',
          enum: ['users', 'orders', 'products'],
          description: 'Table to search',
        },
      },
      required: ['query', 'table'],
    },
  },
  {
    name: 'calculate',
    description: 'Perform a calculation',
    input_schema: {
      type: 'object',
      properties: {
        expression: {
          type: 'string',
          description: 'Mathematical expression to evaluate',
        },
      },
      required: ['expression'],
    },
  },
];

class ClaudeToolService {
  async chatWithTools(
    userMessage: string,
    systemPrompt?: string,
    maxIterations: number = 5
  ): Promise<string> {
    const messages: ClaudeMessage[] = [
      { role: 'user', content: userMessage }
    ];

    let iterations = 0;

    while (iterations < maxIterations) {
      const response = await anthropic.messages.create({
        model: 'claude-opus-4',
        max_tokens: 4096,
        messages,
        system: systemPrompt,
        tools,
      });

      messages.push({
        role: 'assistant',
        content: response.content
      });

      // Check if we're done
      if (response.stop_reason === 'end_turn') {
        return response.content[0].text || '';
      }

      // Handle tool use
      if (response.stop_reason === 'tool_use') {
        for (const block of response.content) {
          if (block.type === 'tool_use') {
            const toolName = block.name;
            const toolArgs = block.input;
            const toolUseId = block.id;

            // Execute tool
            const result = await this.executeTool(toolName, toolArgs);

            // Add result to messages
            messages.push({
              role: 'user',
              content: [{
                type: 'tool_result',
                tool_use_id: toolUseId,
                content: JSON.stringify(result),
              }]
            });
          }
        }
      }

      iterations++;
    }

    return 'Maximum iterations reached';
  }

  private async executeTool(name: string, args: any): Promise<any> {
    switch (name) {
      case 'get_weather':
        return { location: args.location, temperature: '22°C', condition: 'Sunny' };
      case 'search_database':
        return { results: [], query: args.query, table: args.table };
      case 'calculate':
        try {
          return { result: eval(args.expression) };
        } catch {
          return { error: 'Invalid expression' };
        }
      default:
        return { error: `Unknown tool: ${name}` };
    }
  }
}
```

**4. Vision Support**

```typescript
// services/claude-vision.service.ts
interface ImageSource {
  type: 'base64' | 'url';
  media_type: string;
  data: string;
}

class ClaudeVisionService {
  async analyzeImage(
    imageSource: ImageSource,
    prompt: string,
    options: {
      model?: 'claude-opus-4' | 'claude-sonnet-4';
      maxTokens?: number;
    } = {}
  ): Promise<string> {
    const { model = 'claude-sonnet-4', maxTokens = 1024 } = options;

    const content: any[] = [
      { type: 'text', text: prompt }
    ];

    if (imageSource.type === 'base64') {
      content.push({
        type: 'image',
        source: {
          type: 'base64',
          media_type: imageSource.media_type,
          data: imageSource.data,
        },
      });
    } else {
      content.push({
        type: 'image',
        source: {
          type: 'url',
          url: imageSource.data,
        },
      });
    }

    const response = await anthropic.messages.create({
      model,
      max_tokens: maxTokens,
      messages: [{ role: 'user', content }],
    });

    return response.content[0].text || '';
  }

  async extractTextFromImage(
    imageData: string,
    mimeType: string = 'image/jpeg'
  ): Promise<string> {
    return this.analyzeImage(
      { type: 'base64', media_type: mimeType, data: imageData },
      'Extract all text from this image. Return only the text.',
      { model: 'claude-sonnet-4', maxTokens: 2048 }
    );
  }

  async analyzeDocument(
    imageData: string,
    mimeType: string = 'image/png'
  ): Promise<DocumentAnalysis> {
    const response = await this.analyzeImage(
      { type: 'base64', media_type: mimeType, data: imageData },
      `Analyze this document and extract structured information.
      Return a JSON object with the following structure:
      {
        "type": "invoice|receipt|form|other",
        "fields": { ... extracted key-value pairs ... },
        "tables": [ ... extracted table data ... ],
        "summary": "Brief summary of the document"
      }`,
      { model: 'claude-opus-4', maxTokens: 2048 }
    );

    try {
      return JSON.parse(response);
    } catch {
      return { type: 'other', raw: response };
    }
  }

  async compareImages(
    image1: ImageSource,
    image2: ImageSource,
    comparisonPrompt?: string
  ): Promise<string> {
    const prompt = comparisonPrompt || 'Compare these two images. What are the key similarities and differences?';

    const content = [
      { type: 'text', text: prompt },
      {
        type: 'image',
        source: image1.type === 'base64'
          ? { type: 'base64', media_type: image1.media_type, data: image1.data }
          : { type: 'url', url: image1.data }
      },
      {
        type: 'image',
        source: image2.type === 'base64'
          ? { type: 'base64', media_type: image2.media_type, data: image2.data }
          : { type: 'url', url: image2.data }
      },
    ];

    const response = await anthropic.messages.create({
      model: 'claude-opus-4',
      max_tokens: 1024,
      messages: [{ role: 'user', content }],
    });

    return response.content[0].text || '';
  }
}
```

**5. Cost Tracking**

```typescript
// services/claude-cost.service.ts
interface CostRecord {
  timestamp: Date;
  model: string;
  inputTokens: number;
  outputTokens: number;
  cost: number;
}

// Pricing per million tokens (example)
const PRICING = {
  'claude-opus-4': { input: 15, output: 75 },
  'claude-sonnet-4': { input: 3, output: 15 },
  'claude-haiku-3': { input: 0.8, output: 4 },
};

class ClaudeCostService {
  private records: CostRecord[] = [];
  private dailyBudget: number;
  private monthlyBudget: number;

  constructor(dailyBudget: number = 100, monthlyBudget: number = 2000) {
    this.dailyBudget = dailyBudget;
    this.monthlyBudget = monthlyBudget;
  }

  recordUsage(usage: { input_tokens: number; output_tokens: number }, model: string) {
    const pricing = PRICING[model] || PRICING['claude-sonnet-4'];
    
    const inputCost = (usage.input_tokens / 1_000_000) * pricing.input;
    const outputCost = (usage.output_tokens / 1_000_000) * pricing.output;
    const totalCost = inputCost + outputCost;

    const record: CostRecord = {
      timestamp: new Date(),
      model,
      inputTokens: usage.input_tokens,
      outputTokens: usage.output_tokens,
      cost: totalCost,
    };

    this.records.push(record);

    // Check budgets
    if (this.getTodayCost() > this.dailyBudget) {
      console.warn(`Daily budget exceeded: $${this.getTodayCost()}`);
    }

    if (this.getMonthCost() > this.monthlyBudget) {
      console.error(`Monthly budget exceeded: $${this.getMonthCost()}`);
    }

    return record;
  }

  getTodayCost(): number {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    
    return this.records
      .filter(r => r.timestamp >= today)
      .reduce((sum, r) => sum + r.cost, 0);
  }

  getMonthCost(): number {
    const monthStart = new Date();
    monthStart.setDate(1);
    monthStart.setHours(0, 0, 0, 0);
    
    return this.records
      .filter(r => r.timestamp >= monthStart)
      .reduce((sum, r) => sum + r.cost, 0);
  }

  getTodayUsage(): { tokens: number; requests: number } {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    
    const todayRecords = this.records.filter(r => r.timestamp >= today);
    
    return {
      tokens: todayRecords.reduce((sum, r) => sum + r.inputTokens + r.outputTokens, 0),
      requests: todayRecords.length,
    };
  }

  canMakeRequest(): boolean {
    return this.getTodayCost() < this.dailyBudget &&
           this.getMonthCost() < this.monthlyBudget;
  }
}
```

**6. Streaming Responses**

```typescript
// services/claude-stream.service.ts
class ClaudeStreamService {
  async *streamMessage(
    messages: ClaudeMessage[],
    systemPrompt?: string,
    options: any = {}
  ): AsyncGenerator<string> {
    const stream = await anthropic.messages.stream({
      model: options.model || 'claude-sonnet-4',
      max_tokens: options.maxTokens || 4096,
      messages,
      system: systemPrompt,
      temperature: options.temperature || 0.7,
    });

    for await (const event of stream) {
      if (event.type === 'content_block_delta') {
        if (event.delta.type === 'text_delta') {
          yield event.delta.text;
        }
      }
    }
  }

  async chatStream(
    messages: Array<{ role: string; content: string }>,
    onChunk: (chunk: string) => void,
    systemPrompt?: string
  ): Promise<string> {
    const claudeMessages = messages.map(msg => ({
      role: msg.role === 'assistant' ? 'assistant' : 'user',
      content: msg.content,
    }));

    let fullResponse = '';

    for await (const chunk of this.streamMessage(claudeMessages, systemPrompt)) {
      fullResponse += chunk;
      onChunk(chunk);
    }

    return fullResponse;
  }
}
```

## Workflow

**Phase 1: Setup**

Get Anthropic API key. Install SDK. Configure authentication. Set up billing.

**Phase 2: Implementation**

Set up client. Implement basic generation. Add tool support. Configure safety.

**Phase 3: Prompt Engineering**

Design system prompts. Test various prompts. Iterate on results. Document best prompts.

**Phase 4: Integration**

Integrate with application. Add streaming. Implement caching. Set up monitoring.

**Phase 5: Testing**

Test with various inputs. Verify responses. Measure latency. User acceptance testing.

**Phase 6: Deployment**

Deploy to production. Set up cost alerts. Configure rate limits. Document integration.

## Ví dụ

**Ví dụ 1: Code Review Assistant**

```typescript
async reviewCode(
  code: string,
  language: string,
  context?: string
): Promise<CodeReview> {
  const systemPrompt = `You are an expert code reviewer. Analyze the code and provide:
1. Code quality assessment
2. Potential bugs or issues
3. Performance concerns
4. Security vulnerabilities
5. Improvement suggestions
6. Overall rating (1-10)

Be specific and constructive in your feedback.`;

  const response = await new ClaudeTextService().createMessage(
    [{
      role: 'user',
      content: `Review this ${language} code:\n\n\`\`\`${language}\n${code}\n\`\`\`\n\n${context ? `Context: ${context}` : ''}`
    }],
    systemPrompt,
    { model: 'claude-opus-4', maxTokens: 2048 }
  );

  return this.parseCodeReview(response.content[0].text || '');
}
```

**Ví dụ 2: Document Summarization**

```typescript
async summarizeDocument(
  document: string,
  options: {
    maxLength?: number;
    style?: 'brief' | 'detailed' | 'bullet_points';
  } = {}
): Promise<string> {
  const { maxLength = 500, style = 'brief' } = options;

  const styleInstructions = {
    brief: 'Provide a brief 2-3 sentence summary.',
    detailed: 'Provide a comprehensive summary with key points.',
    bullet_points: 'Summarize using bullet points covering main topics.'
  };

  const response = await new ClaudeTextService().generateText(
    `Summarize the following document.\n\n${styleInstructions[style]}\n\nMax length: ${maxLength} characters.\n\nDocument:\n${document}`,
    undefined,
    { model: 'claude-haiku-3', maxTokens: 512 }
  );

  return response;
}
