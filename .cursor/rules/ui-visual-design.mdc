  --radius-lg: 16px;
  --radius-xl: 24px;
  
  /* System 2: Pill (full) - Playful/Consumer */
  --radius-sm: 8px;
  --radius-md: 16px;
  --radius-lg: 24px;
  --radius-pill: 9999px;
  
  /* System 3: Sharp (0-8px) - Brutalist/Technical */
  --radius-sm: 0;
  --radius-md: 4px;
  --radius-lg: 8px;
}

/* TRÁNH: Mix radius systems */
/* KHÔNG: button với radius-sm, card với radius-lg, input với radius-pill */
```

## Animation & Motion

### Motion Intensity Levels

```typescript
const MOTION_LEVELS = {
  // Level 1-3: Static
  // Chỉ CSS hover/active, không auto-animations
  STATIC: 'transition: all 0.15s ease',
  
  // Level 4-7: Fluid CSS
  // Custom cubic-bezier transitions, staggered load-ins
  FLUID: 'transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1)',
  
  // Level 8-10: Advanced
  // GSAP ScrollTrigger, Motion hooks
  ADVANCED: '/* GSAP/Motion patterns */',
};

const DIAL_SETTINGS = {
  minimalist: { variance: 5, motion: 3, density: 2 },
  standard: { variance: 8, motion: 6, density: 4 },
  premium: { variance: 8, motion: 7, density: 3 },
  experimental: { variance: 10, motion: 9, density: 4 },
};
```

### Animation Patterns

```css
/* 1. Hover Feedback */
.interactive {
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.interactive:hover {
  transform: translateY(-2px);
}

.interactive:active {
  transform: scale(0.98);
}

/* 2. Staggered Reveal */
.stagger-container > * {
  opacity: 0;
  transform: translateY(20px);
  animation: reveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.stagger-container > *:nth-child(1) { animation-delay: 0ms; }
.stagger-container > *:nth-child(2) { animation-delay: 100ms; }
.stagger-container > *:nth-child(3) { animation-delay: 200ms; }
.stagger-container > *:nth-child(4) { animation-delay: 300ms; }

@keyframes reveal {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 3. Loading States */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.skeleton {
  background: linear-gradient(
    90deg,
    var(--bg-secondary) 0%,
    var(--bg-primary) 50%,
    var(--bg-secondary) 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}
```

### Animation Anti-Patterns

```typescript
// NGHIÊM CẤM TUYỆT ĐỐI

const FORBIDDEN_ANIMATIONS = {
  // 1. Scroll event listeners
  BAD: `window.addEventListener('scroll', handler)`,
  GOOD: `GSAP ScrollTrigger / Motion useScroll()`,
  
  // 2. RAF loops touching React state
  BAD: `requestAnimationFrame(() => setState(...))`,
  GOOD: `Motion values instead`,
  
  // 3. Animate non-GPU properties
  BAD: `transition: top 0.3s, left 0.3s, width 0.3s`,
  GOOD: `transition: transform 0.3s, opacity 0.3s`,
  
  // 4. Infinite loops không có meaning
  BAD: `pulsing glow everywhere`,
  GOOD: `loading spinner có purpose`,
  
  // 5. GSAP + Motion trong cùng tree
  BAD: `GSAP ScrollTrigger + Framer Motion together`,
  GOOD: `Stick với 1 library`,
};
```

### Reduced Motion

```tsx
// BẮT BUỘC cho Motion > 3
import { useReducedMotion } from 'motion/react';

const AnimatedComponent = ({ children }) => {
  const prefersReducedMotion = useReducedMotion();
  
  return (
    <motion.div
      initial={prefersReducedMotion ? false : { opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ 
        duration: prefersReducedMotion ? 0 : 0.5,
        ease: [0.16, 1, 0.3, 1] 
      }}
    >
      {children}
    </motion.div>
  );
};

// CSS fallback
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
```

