  toPayload(): OrderCreatedPayload {
    return {
      orderId: this.orderId.value,
      customerId: this.customerId.value,
      customerName: this.customerId.name,
      items: this.items.map(i => i.toSnapshot()),
      shippingAddress: this.shippingAddress.toSnapshot(),
      occurredAt: this.occurredAt
    };
  }
}

// Event serialization
export abstract class DomainEvent {
  abstract readonly eventType: string;
  abstract toPayload(): Record<string, any>;
  
  toEventRecord(): EventRecord {
    return {
      eventId: EventId.create().value,
      aggregateType: 'Order',
      aggregateId: this.aggregateId.value,
      eventType: this.eventType,
      occurredAt: this.occurredAt,
      payload: this.toPayload(),
      version: 1
    };
  }
}
