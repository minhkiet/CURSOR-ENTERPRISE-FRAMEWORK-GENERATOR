**2. Domain Entity Example**

```typescript
// domain/entities/Order.ts
export class Order extends Entity<OrderId> {
  private _customerId: CustomerId;
  private _items: OrderItem[];
  private _status: OrderStatus;
  private _total: Money;
  
  private constructor(
    id: OrderId,
    customerId: CustomerId,
    items: OrderItem[],
    status: OrderStatus,
    total: Money
  ) {
    super(id);
    this._customerId = customerId;
    this._items = items;
    this._status = status;
    this._total = total;
  }

  // Factory method
  static create(props: CreateOrderProps): Order {
    const orderId = OrderId.create();
    const items = props.items.map(OrderItem.create);
    const total = Money.sum(items.map(i => i.subtotal));
    
    return new Order(orderId, props.customerId, items, OrderStatus.PENDING, total);
  }

  // Business methods
  confirm(): void {
    if (this._status !== OrderStatus.PENDING) {
      throw new DomainException('Cannot confirm a non-pending order');
    }
    this._status = OrderStatus.CONFIRMED;
  }

  cancel(): void {
    if (!this.canBeCancelled()) {
      throw new DomainException('Cannot cancel this order');
    }
    this._status = OrderStatus.CANCELLED;
  }

  canBeCancelled(): boolean {
    return this._status === OrderStatus.PENDING;
  }

  // Getters
  get customerId(): CustomerId { return this._customerId; }
  get items(): OrderItem[] { return [...this._items]; }
  get status(): OrderStatus { return this._status; }
  get total(): Money { return this._total; }
}
```

**3. Application Layer Use Case**

```typescript
// application/use-cases/CreateOrderUseCase.ts
export class CreateOrderUseCase implements IUseCase<CreateOrderCommand, CreateOrderResult> {
  constructor(
    private orderRepository: IOrderRepository,
    private notificationService: INotificationService
  ) {}

  async execute(command: CreateOrderCommand): Promise<CreateOrderResult> {
    // Create order entity
    const order = Order.create({
      customerId: command.customerId,
      items: command.items,
      shippingAddress: command.shippingAddress
    });

    // Persist
    await this.orderRepository.save(order);

    // Send notification
    await this.notificationService.sendOrderConfirmation(order);

    // Return result
    return {
      orderId: order.id.value,
      total: order.total.amount,
      status: order.status
    };
  }
}
```

### Anti Patterns

**1. Anemic Domain**

Domain objects chỉ có getters và setters. Business logic ở nơi khác. Violates encapsulation. Add behavior to entities.

**2. Leaky Abstractions**

Inner layers phụ thuộc outer layers. Violates dependency rule. Infrastructure leaks. Proper layering.

**3. God Objects**

Too much logic in one place. Violates SRP. Hard to test. Break into smaller pieces.

**4. Feature Envy**

Objects quan tâm nhiều đến data của objects khác. Data/behavior separation. Move behavior to data.

