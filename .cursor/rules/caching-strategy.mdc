### Ví dụ 1: Complete Caching Service

```typescript
export class CachingService {
    private cache: CacheClient;
    private invalidator: CacheInvalidator;
    private monitor: CacheMonitor;

    constructor(config: CacheConfig) {
        this.cache = new RedisCacheClient(config.redis);
        this.invalidator = new CacheInvalidator(this.cache);
        this.monitor = new CacheMonitor(this.cache);
    }

    async getUserProfile(userId: string): Promise<UserProfile> {
        const key = `user:${userId}:profile`;
        return new CacheAsideService(this.cache).get(key, () =>
            this.db.users.findById(userId)
        );
    }

    async getPosts(options: PostQueryOptions): Promise<PostList> {
        const key = CacheKeyBuilder.pagination('posts', options);
        return new CacheAsideService(this.cache).get(key, () =>
            this.db.posts.findAll(options)
        );
    }

    async invalidateUser(userId: string): Promise<void> {
        await this.invalidator.invalidateByPrefix(`user:${userId}*`);
    }

    async invalidatePost(postId: string): Promise<void> {
        const post = await this.db.posts.findById(postId);
        await Promise.all([
            this.invalidator.invalidate(`post:${postId}`),
            this.invalidator.invalidateByPrefix(`user:${post.authorId}:posts`),
            this.invalidator.invalidateByPrefix('posts:list*')
        ]);
    }

    async getMetrics(): Promise<CacheMetrics> {
        return this.monitor.collectMetrics();
    }
}
```

### Ví dụ 2: HTTP Caching

```typescript
// HTTP caching headers
class HTTPCache {
    static setCacheHeaders(
        res: Response,
        options: {
            maxAge?: number;
            isPrivate?: boolean;
            mustRevalidate?: boolean;
        }
    ): void {
        const { maxAge = 3600, isPrivate = false, mustRevalidate = true } = options;

        const directives = [];

        if (isPrivate) {
            directives.push('private');
        } else {
            directives.push('public');
        }

        directives.push(`max-age=${maxAge}`);

        if (mustRevalidate) {
            directives.push('must-revalidate');
        }

        res.set('Cache-Control', directives.join(', '));
        res.set('Expires', new Date(Date.now() + maxAge * 1000).toUTCString());
        res.set('Vary', 'Accept-Encoding');
    }

    static setETag(res: Response, data: any): void {
        const etag = crypto.createHash('md5').update(JSON.stringify(data)).digest('hex');
        res.set('ETag', `"${etag}"`);

        // Check If-None-Match
        if (res.req.headers['if-none-match'] === `"${etag}"`) {
            res.status(304).end();
            return null;
        }

        return data;
    }
}

// Usage in Express
app.get('/api/posts', async (req, res) => {
    const posts = await postService.findAll();

    if (req.fresh) {
        return res.status(304).end();
    }

    HTTPCache.setCacheHeaders(res, { maxAge: 300, isPrivate: false });
    res.json(posts);
});
```

### Ví dụ 3: Application-Level Cache

```typescript
// Decorator-based caching
function cached(ttl: number, keyPrefix?: string) {
    return function (
        target: any,
        propertyKey: string,
        descriptor: PropertyDescriptor
    ) {
        const originalMethod = descriptor.value;

        descriptor.value = async function (...args: any[]) {
            const cacheKey = keyPrefix || propertyKey;
            const cache = getCacheFor(this);
            const fullKey = `${cacheKey}:${args.join(':')}`;

            const cached = await cache.get(fullKey);
            if (cached !== null) {
                return cached;
            }

            const result = await originalMethod.apply(this, args);
            await cache.set(fullKey, result, ttl);

            return result;
        };

        return descriptor;
    };
}

// Usage
class UserService {
    @cached(3600, 'user:profile')
    async getUserProfile(userId: string): Promise<UserProfile> {
        return this.database.users.findById(userId);
    }

    @cached(300, 'posts:list')
    async getPosts(options: PostQueryOptions): Promise<Post[]> {
        return this.database.posts.findAll(options);
    }
}
```

