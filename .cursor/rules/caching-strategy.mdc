## Anti Patterns

### 1. Caching Everything

```typescript
// Không nên - cache too much
const value = await cache.get('everything');
if (!value) {
    value = await heavyComputation();
    await cache.set('everything', value, 3600);
}

// Nên - cache selectively based on access patterns
const value = await cache.get('frequently-accessed');
if (!value) {
    value = await heavyComputation();
    await cache.set('frequently-accessed', value, 300);
}
```

### 2. Very Long TTLs

```typescript
// Không nên - data becomes stale
await cache.set('user:123', data, 86400 * 30); // 30 days!

// Nên - reasonable TTL with refresh
await cache.set('user:123', data, 3600); // 1 hour
// Use stale-while-revalidate for background refresh
```

### 3. No Invalidation Strategy

```typescript
// Không nên - no invalidation
await cache.set('user:123', data, 3600);
// User updates profile... but cache still has old data!

// Nên - proper invalidation
await cache.set('user:123', data, 3600);
// When user updates:
await cache.invalidate('user:123');
```

### 4. Blocking Cache Reads

```typescript
// Không nên - blocking on cache miss
const value = cache.get('key');
if (!value) {
    value = await fetchFromDatabase(); // Blocks!
}

// Nên - async pattern
const value = await cache.get('key') || await fetchFromDatabase();
```

### 5. Not Handling Cache Failures

```typescript
// Không nên - cache failure crashes app
const value = await cache.get('key'); // If redis is down...

// Nên - graceful degradation
try {
    const value = await cache.get('key');
} catch (error) {
    // Fall back to database
    const value = await db.get('key');
    logger.warn('Cache unavailable, using database');
}
```

## Best Practices

### 1. Cache-Aside with Fallback

```typescript
class ResilientCacheService<T> {
    constructor(
        private cache: CacheClient,
        private circuitBreaker: CircuitBreaker
    ) {}

    async get(
        key: string,
        fetcher: () => Promise<T>,
        ttl: number
    ): Promise<T> {
        try {
            // Try cache
            const cached = await this.circuitBreaker.execute(
                () => this.cache.get<T>(key)
            );

            if (cached !== null) {
                return cached;
            }
        } catch (error) {
            // Circuit breaker open or cache error
            this.logger.warn('Cache unavailable', { key, error });
        }

        // Fetch from source
        const value = await fetcher();

        // Try to cache (non-blocking)
        this.cache.set(key, value, ttl).catch(err => {
            this.logger.warn('Failed to cache value', { key, err });
        });

        return value;
    }
}
```

### 2. Cache Warming

```typescript
class CacheWarmer {
    constructor(
        private cache: CacheClient,
        private dataService: DataService
    ) {}

    async warmPopularItems(): Promise<void> {
        const popularIds = await this.dataService.getPopularItemIds();

        await Promise.all(
            popularIds.map(async (id) => {
                const data = await this.dataService.getItemById(id);
                await this.cache.set(`item:${id}`, data, 3600);
            })
        );

        this.logger.info('Cache warmed', { itemCount: popularIds.length });
    }

    async warmUserCaches(userIds: string[]): Promise<void> {
        await Promise.all(
            userIds.map(async (userId) => {
                const [profile, settings, permissions] = await Promise.all([
                    this.dataService.getUserProfile(userId),
                    this.dataService.getUserSettings(userId),
                    this.dataService.getUserPermissions(userId)
                ]);

                await Promise.all([
                    this.cache.set(`user:${userId}:profile`, profile, 3600),
                    this.cache.set(`user:${userId}:settings`, settings, 3600),
                    this.cache.set(`user:${userId}:permissions`, permissions, 1800)
                ]);
            })
        );
    }
}
```

### 3. Consistent Hashing

```typescript
// For distributed cache nodes
class ConsistentHashRing {
    private ring: Map<number, string> = new Map();
    private sortedKeys: number[] = [];
    private replicas: number;

    constructor(replicas: number = 150) {
        this.replicas = replicas;
    }

    addNode(node: string): void {
        for (let i = 0; i < this.replicas; i++) {
            const hash = this.hash(`${node}:${i}`);
            this.ring.set(hash, node);
            this.sortedKeys.push(hash);
        }
        this.sortedKeys.sort((a, b) => a - b);
    }

    removeNode(node: string): void {
        for (let i = 0; i < this.replicas; i++) {
            const hash = this.hash(`${node}:${i}`);
            this.ring.delete(hash);
            this.sortedKeys = this.sortedKeys.filter(k => k !== hash);
        }
    }

    getNode(key: string): string {
        if (this.ring.size === 0) {
            throw new Error('No nodes in ring');
        }

        const hash = this.hash(key);
        const position = this.findPosition(hash);
        return this.ring.get(this.sortedKeys[position])!;
    }

    private findPosition(hash: number): number {
        let low = 0;
        let high = this.sortedKeys.length;

        while (low < high) {
            const mid = Math.floor((low + high) / 2);
            if (this.sortedKeys[mid] < hash) {
                low = mid + 1;
            } else {
                high = mid;
            }
        }

        return low === this.sortedKeys.length ? 0 : low;
    }

    private hash(key: string): number {
        return crypto.createHash('md5').update(key).digest('hex')
            .substring(0, 8) as unknown as number;
    }
}
```

