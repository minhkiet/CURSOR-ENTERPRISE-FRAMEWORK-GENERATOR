**5. Infrastructure Layer**

```typescript
// infrastructure/persistence/repositories/PostgresOrderRepository.ts
export class PostgresOrderRepository implements IOrderRepository {
  constructor(private db: Database) {}

  async findById(id: OrderId): Promise<Order | null> {
    const row = await this.db.query(
      'SELECT * FROM orders WHERE id = $1',
      [id.value]
    );
    
    if (!row) return null;
    
    return this.mapToOrder(row);
  }

  async save(order: Order): Promise<void> {
    await this.db.transaction(async (tx) => {
      await tx.query(
        `INSERT INTO orders (id, customer_id, status, total, shipping_address, created_at)
         VALUES ($1, $2, $3, $4, $5, $6)
         ON CONFLICT (id) DO UPDATE SET
           status = EXCLUDED.status,
           total = EXCLUDED.total`,
        [
          order.id.value,
          order.customerId.value,
          order.status.value,
          order.total.amount,
          JSON.stringify(order.shippingAddress),
          order.createdAt
        ]
      );

      // Save items
      await tx.query('DELETE FROM order_items WHERE order_id = $1', [order.id.value]);
      
      for (const item of order.items) {
        await tx.query(
          `INSERT INTO order_items (id, order_id, product_id, quantity, price)
           VALUES ($1, $2, $3, $4, $5)`,
          [item.id.value, order.id.value, item.productId.value, item.quantity.value, item.price.amount]
        );
      }
    });
  }

  private mapToOrder(row: any): Order {
    const items = row.items.map(OrderItem.fromSnapshot);
    return Order.restore(
      OrderId.from(row.id),
      CustomerId.from(row.customer_id),
      items,
      OrderStatus.from(row.status),
      Money.from(row.total, row.currency || 'USD')
    );
  }
}
```

```typescript
// infrastructure/external/EmailNotificationService.ts
export class EmailNotificationService implements INotificationService {
  constructor(
    private emailClient: EmailClient,
    private templateEngine: TemplateEngine
  ) {}

  async sendOrderConfirmation(order: Order): Promise<void> {
    const template = await this.templateEngine.getTemplate('order-confirmation');
    const html = template.render({
      orderId: order.id.value,
      items: order.items,
      total: order.total.format()
    });

    await this.emailClient.send({
      to: order.customer.email,
      subject: `Order Confirmation - ${order.id.value}`,
      html
    });
  }
}
```

**6. Composition Root**

```typescript
// infrastructure/framework/CompositionRoot.ts
export class CompositionRoot {
  private container: Container;

  constructor() {
    this.container = new Container();
    this.configure();
  }

  private configure(): void {
    // Infrastructure
    this.container.registerSingleton(Database, () => new PostgresDatabase());
    this.container.registerSingleton(EmailClient, () => new SendGridClient());
    
    // Repositories
    this.container.registerSingleton(IOrderRepository, PostgresOrderRepository);
    
    // Domain Services (if any)
    // this.container.registerTransient(IDomainOrderService, OrderDomainService);

    // Notification Services
    this.container.registerSingleton(INotificationService, EmailNotificationService);

    // Use Cases
    this.container.registerTransient(CreateOrderUseCase);
    this.container.registerTransient(GetOrderUseCase);

    // Controllers
    this.container.registerTransient(OrderController);
  }

  getController<T>(controller: new (...deps: any[]) => T): T {
    return this.container.resolve(controller);
  }
}
```

```typescript
// main.ts
const compositionRoot = new CompositionRoot();
const app = new ExpressServer(compositionRoot);

app.start();
```

## Workflow

**Phase 1: Layer Design**

Define layers. Establish dependency rules. Plan interfaces. Set up structure.

**Phase 2: Domain Implementation**

Implement entities. Create value objects. Define domain interfaces. Add domain services.

**Phase 3: Application Implementation**

Implement use cases. Create commands/queries. Define DTOs. Add port interfaces.

**Phase 4: Infrastructure Implementation**

Implement repositories. Add external services. Configure DI. Set up frameworks.

**Phase 5: Adapter Implementation**

Create controllers. Add presenters. Implement mappers. Connect to infrastructure.

