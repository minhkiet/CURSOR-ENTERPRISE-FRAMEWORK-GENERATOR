**4. Interface Adapters**

```typescript
// interface-adapters/controllers/OrderController.ts
export class OrderController {
  constructor(
    private createOrderUseCase: IOrderCommandHandler<CreateOrderCommand, CreateOrderResult>,
    private getOrderUseCase: IOrderQueryHandler<GetOrderQuery, OrderDTO>
  ) {}

  async createOrder(request: Request): Promise<Response> {
    try {
      const command = CreateOrderCommand.fromRequest(request.body);
      
      const validation = command.validate();
      if (!validation.isValid) {
        return Response.badRequest(validation.errors);
      }

      const result = await this.createOrderUseCase.handle(command);
      
      return Response.created(result);
    } catch (error) {
      return Response.error(error);
    }
  }

  async getOrder(request: Request): Promise<Response> {
    const query = new GetOrderQuery(request.params.orderId);
    const result = await this.getOrderUseCase.handle(query);
    
    if (!result) {
      return Response.notFound();
    }
    
    return Response.ok(result);
  }
}
```

