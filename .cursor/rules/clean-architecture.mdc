// interface-adapters/mappers/OrderMapper.ts
export class OrderMapper {
  static toDTO(order: Order): OrderDTO {
    return {
      id: order.id.value,
      customerId: order.customerId.value,
      status: order.status.value,
      items: order.items.map(OrderItemMapper.toDTO),
      total: order.total.amount,
      currency: order.total.currency,
      shippingAddress: AddressMapper.toDTO(order.shippingAddress),
      createdAt: order.createdAt
    };
  }

  static toCreateCommandDTO(request: any): CreateOrderCommandDTO {
    return {
      customerId: CustomerId.from(request.customerId),
      items: request.items.map(item => ({
        productId: ProductId.from(item.productId),
        quantity: item.quantity,
        price: Money.create(item.price, item.currency || 'USD')
      })),
      shippingAddress: Address.create(
        request.shippingAddress.street,
        request.shippingAddress.city,
        request.shippingAddress.country,
        request.shippingAddress.postalCode
      )
    };
  }
}
