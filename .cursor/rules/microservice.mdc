**2. Service Communication**

```typescript
// services/order-service/src/communication/ServiceClient.ts
export class UserServiceClient {
  constructor(
    private httpClient: HttpClient,
    private serviceDiscovery: ServiceDiscovery
  ) {}

  async getUser(userId: string): Promise<User> {
    const url = await this.serviceDiscovery.resolve('user-service');
    
    const response = await this.httpClient.get(`${url}/users/${userId}`, {
      timeout: 3000,
      retries: 3,
      circuitBreaker: {
        failureThreshold: 5,
        resetTimeout: 60000
      }
    });

    return response.data;
  }

  async getUserEmail(userId: string): Promise<string> {
    const user = await this.getUser(userId);
    return user.email;
  }
}
```

```typescript
// services/order-service/src/communication/EventBus.ts
export class EventBus {
  private subscribers: Map<string, EventHandler[]> = new Map();

  constructor(
    private messageBroker: MessageBroker,
    private logger: Logger
  ) {
    this.setupSubscriptions();
  }

  async publish<T extends DomainEvent>(event: T): Promise<void> {
    await this.messageBroker.publish({
      topic: `order.${event.eventType}`,
      payload: event.toPayload(),
      headers: {
        'correlation-id': event.correlationId,
        'timestamp': event.occurredAt.toISOString()
      }
    });
  }

  async subscribe<T extends DomainEvent>(
    eventType: string,
    handler: EventHandler<T>
  ): Promise<void> {
    const existing = this.subscribers.get(eventType) || [];
    existing.push(handler);
    this.subscribers.set(eventType, existing);
  }

  private async setupSubscriptions(): Promise<void> {
    await this.messageBroker.subscribe(
      'user.UserCreated',
      async (message) => {
        const handlers = this.subscribers.get('user.UserCreated');
        if (handlers) {
          await Promise.all(
            handlers.map(h => h.handle(message))
          );
        }
      }
    );
  }
}
```

