## 4. Data Layer Architecture

### 4.1 Database Architecture

```yaml
# Database architecture
data_layer:
  # Primary database
  primary_db:
    engine: postgresql
    version: "15"
    instance_class: db.r6g.large
    storage:
      type: gp3
      size: 100
      iops: 3000

    # High availability
    multi_az: true
    failover_priority: us-east-1a

    # Backup
    backup:
      enabled: true
      retention: 7
      window: "03:00-04:00"
      copy_tags: true

    # Encryption
    encryption:
      enabled: true
      kms_key_id: alias/aws/rds

  # Read replica
  read_replicas:
    - db_instance_class: db.r6g.large
      az: us-east-1b
      weight: 1
    - db_instance_class: db.r6g.large
      az: us-east-1c
      weight: 1

  # Cache layer
  cache:
    engine: redis
    node_type: cache.r6g.large
    num_cache_nodes: 2
    snapshot_retention: 7

  # Object storage
  object_storage:
    service: s3
    buckets:
      - name: app-assets
        versioning: true
        encryption: aes256
        lifecycle:
          rules:
            - id: archive-old-data
              status: enabled
              transition:
                - days: 30
                  storage_class: GLACIER
                - days: 365
                  storage_class: DEEP_ARCHIVE
```

