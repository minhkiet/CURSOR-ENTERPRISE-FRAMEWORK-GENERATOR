## 6. Security Architecture

### 6.1 Security Best Practices

```yaml
# Security architecture
security:
  # Identity & Access Management
  iam:
    password_policy:
      minimum_length: 14
      require_uppercase: true
      require_lowercase: true
      require_numbers: true
      require_symbols: true
      expire_after: 90

    mfa:
      required: true
      types: [virtual, hardware]

    policies:
      - name: least_privilege
        effect: Allow
        actions: specific_per_action
        resources: specific_resources

  # Network security
  network:
    vpc_flow_logs: true
    security_groups: restrictive
    nACLs: additional_perimeter
    private_subnets: all_compute_resources

  # Data encryption
  encryption:
    at_rest:
      enabled: true
      algorithm: AES-256
      key_management: aws_kms

    in_transit:
      tls: 1.2 minimum
      enforce_ssl: true

  # Logging & Monitoring
  logging:
    api_gateway_logs: true
    vpc_flow_logs: true
    cloudtrail: true
    guardduty: true
    security_hub: true
```

