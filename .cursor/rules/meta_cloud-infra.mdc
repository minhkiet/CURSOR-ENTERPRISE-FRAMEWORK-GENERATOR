## 5. Disaster Recovery

### 5.1 DR Architecture Tiers

```yaml
# Disaster Recovery Tiers
dr_tiers:
  # Tier 1: Multi-Region Active-Active
  active_active:
    rpo: 0
    rto: < 1 minute
    architecture: |
      Two active regions handling traffic
      Data replicated in real-time
      Traffic split via DNS with health checks
    cost: Very High

  # Tier 2: Warm Standby
  warm_standby:
    rpo: < 1 minute
    rto: < 15 minutes
    architecture: |
      Secondary region with scaled-down resources
      Data replicated continuously
      Manual or semi-automatic failover
    cost: High

  # Tier 3: Pilot Light
  pilot_light:
    rpo: < 1 hour
    rto: < 1 hour
    architecture: |
      Minimal infrastructure in DR region
      Database restored from backup
      Scale up on disaster
    cost: Medium

  # Tier 4: Backup & Restore
  backup_restore:
    rpo: < 24 hours
    rto: < 24 hours
    architecture: |
      Regular backups to异地 storage
      Infrastructure as code for quick deployment
      Manual restore process
    cost: Low

# Recommended: Tier 2 for most applications
recommended_architecture:
  primary_region: us-east-1
  dr_region: us-west-2
  replication:
    database: async_replication
    storage: cross_region_replication
    cache: redis_replication
  failover:
    automatic: false
    dns_switch: true
```

### 5.2 Backup Configuration

```yaml
# terraform/backup/backup-plan.tf
resource "aws_backup_plan" "main" {
  name = "${var.project}-${var.environment}-backup-plan"
  
  rule {
    name                = "daily-backup"
    target_vault_name   = aws_backup_vault.main.name
    schedule            = "cron(0 5 ? * * *)"  # 5 AM UTC
    start_window        = 60
    completion_window   = 300
    
    lifecycle {
      delete_after = 35
    }
  }
  
  rule {
    name                = "weekly-backup"
    target_vault_name   = aws_backup_vault.main.name
    schedule            = "cron(0 6 ? * SUN *)"  # Sunday 6 AM UTC
    start_window        = 60
    completion_window   = 300
    
    lifecycle {
      delete_after = 365
    }
  }
}

resource "aws_backup_selection" "main" {
  name         = "${var.project}-${var.environment}-backup-selection"
  plan_id      = aws_backup_plan.main.id
  vault_arn    = aws_backup_vault.main.arn
  
  resources = [
    aws_rds_cluster.main.arn,
    aws_efs_file_system.main.arn,
    aws_db_instance.main.arn
  ]
}
```

