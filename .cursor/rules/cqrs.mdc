## Anti Patterns

### 1. Same Model for Commands and Queries

```typescript
// Không nên - using same model
class User {
    id: string;
    name: string;
    email: string;

    // Used for both commands and queries
    // Too much data for reads, too complex for writes
}

// Nên - separate models
interface UserCommand {
    email: string;
    passwordHash: string;
    // Only write-needed fields
}

interface UserQuery {
    id: string;
    name: string;
    email: string;
    profilePicture: string;
    lastLogin: Date;
    // Optimized for read queries
}
```

### 2. Synchronous Read/Write

```typescript
// Không nên - blocking read after write
async createOrder(data) {
    await writeDb.save(order);
    await syncToReadDb(); // Blocking!
    return order; // User waits
}

// Nên - async synchronization
async createOrder(data) {
    await writeDb.save(order);
    await eventBus.publish(event); // Async
    return { orderId: order.id, status: 'CREATED' };
}
```

### 3. Overly Complex Commands

```typescript
// Không nên - too many fields
interface UpdateEverythingCommand {
    orderId: string;
    customerId?: string;
    shippingAddress?: Address;
    billingAddress?: Address;
    items?: OrderItem[];
    discountCode?: string;
    shippingMethod?: string;
    notes?: string;
    // Too many optional fields!
}

// Nên - focused commands
interface UpdateShippingAddressCommand { ... }
interface AddOrderItemCommand { ... }
interface ApplyDiscountCommand { ... }
```

### 4. Missing Idempotency

```typescript
// Không nên - no idempotency
async handle(command) {
    await processCommand(command);
    // If fails midway, can't retry safely
}

// Nên - idempotent commands
async handle(command) {
    if (await isProcessed(command.id)) {
        return getCachedResult(command.id);
    }
    await processCommand(command);
    await markProcessed(command.id);
}
```

### 5. N+1 Queries in Read Models

```typescript
// Không nên - N+1 query problem
async getOrders() {
    const orders = await db.query('SELECT * FROM orders');
    for (const order of orders) {
        order.customer = await db.query('SELECT * FROM customers WHERE id = ?', order.customerId);
        order.items = await db.query('SELECT * FROM order_items WHERE orderId = ?', order.id);
    }
}

// Nên - optimized single query or join
async getOrders() {
    return await db.query(`
        SELECT o.*, c.name as customer_name, json_agg(oi.*) as items
        FROM orders o
        JOIN customers c ON o.customer_id = c.id
        LEFT JOIN order_items oi ON o.id = oi.order_id
        GROUP BY o.id, c.name
    `);
}
```

## Best Practices

### 1. Command Naming

```typescript
// Consistent command naming
const commandNaming = {
    create: 'Create{Entity}Command',
    update: 'Update{Entity}Command',
    delete: 'Delete{Entity}Command',
    add: 'Add{ChildEntity}Command',
    remove: 'Remove{ChildEntity}Command',
    change: 'Change{Field}Command',
    apply: 'Apply{Action}Command'
};

// Examples
'CreateOrderCommand'
'UpdateOrderCommand'
'DeleteOrderCommand'
'AddOrderItemCommand'
'RemoveOrderItemCommand'
'ConfirmOrderCommand'
'CancelOrderCommand'
'ShipOrderCommand'
```

### 2. Query Optimization

```typescript
// Indexed query parameters
const optimizedQueries = {
    // Composite index for common filters
    'GET_ORDERS_BY_STATUS_AND_DATE':
        'CREATE INDEX idx_orders_status_created ON orders(status, created_at DESC)',

    // Covering index for list queries
    'GET_ORDER_LIST':
        'CREATE INDEX idx_orders_list ON orders(status, created_at) INCLUDE (customer_id, total_amount)',

    // Denormalized read model
    'GET_CUSTOMER_ORDER_SUMMARY':
        'CREATE TABLE customer_order_summary AS
         SELECT customer_id, COUNT(*) as order_count, SUM(total) as total_spent
         FROM orders GROUP BY customer_id'
};
```

### 3. Consistency Levels

```typescript
// Consistency configuration
const consistencyConfig = {
    // Strong consistency for critical operations
    paymentProcessing: 'STRONG',

    // Eventual consistency for read models
    orderListView: 'EVENTUAL',
    analytics: 'EVENTUAL',

    // Read-your-writes consistency
    ownOrderDetails: 'READ_YOUR_WRITES'
};

// Implementation
async queryWithConsistency<T>(
    query: Query,
    consistency: ConsistencyLevel
): Promise<T> {
    switch (consistency) {
        case 'STRONG':
            return this.strongConsistencyQuery(query);
        case 'EVENTUAL':
            return this.eventualConsistencyQuery(query);
        case 'READ_YOUR_WRITES':
            return this.readYourWritesQuery(query);
    }
}
```

