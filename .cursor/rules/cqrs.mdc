# CQRS (Command Query Responsibility Segregation) Guidelines

## Mục tiêu

Tài liệu này định nghĩa các nguyên tắc và best practices cho việc implement CQRS (Command Query Responsibility Segregation) pattern trong Cursor Enterprise Framework. Mục tiêu là đảm bảo clear separation giữa read và write operations, optimized performance cho cả hai sides, và maintainable codebase.

CQRS là pattern tách biệt read và write operations thành các models riêng biệt. Điều này cho phép optimize read queries mà không ảnh hưởng đến write operations và ngược lại.

## Nguyên tắc cơ bản

### 1. CQRS Overview

Understanding CQRS architecture.

```
┌─────────────────────────────────────────────────────────────────┐
│                     CQRS Architecture                             │
├─────────────────────────────────────────────────────────────────┤
│                                                                  │
│   Commands (Write)                    Queries (Read)           │
│   ┌──────────────┐                   ┌──────────────┐          │
│   │   Command    │                   │    Query     │          │
│   │   Handler    │                   │   Handler    │          │
│   └──────┬───────┘                   └──────┬───────┘          │
│          │                                    │                 │
│          ▼                                    ▼                 │
│   ┌──────────────┐                   ┌──────────────┐          │
│   │   Domain     │                   │    Read      │          │
│   │   Model      │                   │    Model     │          │
│   └──────┬───────┘                   └──────┬───────┘          │
│          │                                    │                 │
│          ▼                                    ▼                 │
│   ┌──────────────┐                   ┌──────────────┐          │
│   │   Event      │                   │   Database  │          │
│   │   Store      │                   │   (Denorm.) │          │
│   └──────────────┘                   └──────────────┘          │
│                                                                  │
└─────────────────────────────────────────────────────────────────┘
```

### 2. Command Design

Design commands for write operations.

```typescript
// Base command interface
interface Command {
    id: string;              // Unique command ID
    type: string;           // Command type name
    timestamp: Date;         // When command was created
    metadata: CommandMetadata;
}

interface CommandMetadata {
    userId?: string;
    correlationId?: string;
    causationId?: string;
}

// Command definitions
type OrderCommand =
    | CreateOrderCommand
    | AddItemCommand
    | RemoveItemCommand
    | ConfirmOrderCommand
    | CancelOrderCommand
    | ShipOrderCommand;

interface CreateOrderCommand extends Command {
    type: 'CREATE_ORDER';
    payload: {
        customerId: string;
        shippingAddress: Address;
        billingAddress: Address;
        items: OrderItemInput[];
        paymentMethod: PaymentMethod;
    };
}

interface AddItemCommand extends Command {
    type: 'ADD_ITEM';
    payload: {
        orderId: string;
        productId: string;
        quantity: number;
    };
}

interface ConfirmOrderCommand extends Command {
    type: 'CONFIRM_ORDER';
    payload: {
        orderId: string;
        paymentId: string;
    };
}

// Command validation
class CommandValidator {
    validate(command: Command): ValidationResult {
        const errors: ValidationError[] = [];

        switch (command.type) {
            case 'CREATE_ORDER':
                errors.push(...this.validateCreateOrder(command));
                break;
            case 'ADD_ITEM':
                errors.push(...this.validateAddItem(command));
                break;
            // ... other commands
        }

        return {
            valid: errors.length === 0,
            errors
        };
    }

    private validateCreateOrder(cmd: CreateOrderCommand): ValidationError[] {
        const errors: ValidationError[] = [];

        if (!cmd.payload.customerId) {
            errors.push({ field: 'customerId', message: 'Customer ID is required' });
        }

        if (!cmd.payload.shippingAddress) {
            errors.push({ field: 'shippingAddress', message: 'Shipping address is required' });
        }

        if (!cmd.payload.items || cmd.payload.items.length === 0) {
            errors.push({ field: 'items', message: 'At least one item is required' });
        }

        return errors;
    }
}
```

### 3. Query Design

Design queries for read operations.

```typescript
// Base query interface
interface Query {
    id: string;
    type: string;
    parameters: QueryParameters;
}

interface QueryParameters {
    pagination?: PaginationParams;
    sorting?: SortParams[];
    filtering?: FilterParams;
}

// Query definitions
type OrderQuery =
    | GetOrderByIdQuery
    | GetOrdersQuery
    | GetCustomerOrdersQuery
    | GetOrderSummaryQuery
    | SearchOrdersQuery;

interface GetOrderByIdQuery extends Query {
    type: 'GET_ORDER_BY_ID';
    parameters: {
        orderId: string;
        includeItems?: boolean;
        includeCustomer?: boolean;
    };
}

interface GetOrdersQuery extends Query {
    type: 'GET_ORDERS';
    parameters: {
        pagination: { page: number; limit: number };
        sorting: { field: string; direction: 'asc' | 'desc' }[];
        filtering?: {
            status?: OrderStatus[];
            customerId?: string;
            dateFrom?: Date;
            dateTo?: Date;
        };
    };
}

interface GetOrderSummaryQuery extends Query {
    type: 'GET_ORDER_SUMMARY';
    parameters: {
        orderId: string;
    };
}

// Query result DTOs
interface OrderDTO {
    id: string;
    orderNumber: string;
    customer: CustomerSummaryDTO;
    status: OrderStatus;
    items: OrderItemDTO[];
    totalAmount: MoneyDTO;
    shippingAddress: AddressDTO;
    createdAt: Date;
    confirmedAt?: Date;
    shippedAt?: Date;
}

interface OrderSummaryDTO {
    id: string;
    orderNumber: string;
    status: OrderStatus;
    totalAmount: MoneyDTO;
    itemCount: number;
    createdAt: Date;
}

interface OrderListDTO {
    orders: OrderSummaryDTO[];
    pagination: PaginationMeta;
    totalCount: number;
}
```

### 4. Command Handler

Implement command handlers.

```typescript
// Command handler interface
interface CommandHandler<TCommand extends Command, TResult = void> {
    handle(command: TCommand): Promise<TResult>;
}

// Command handler implementation
class CreateOrderCommandHandler
    implements CommandHandler<CreateOrderCommand, CreateOrderResult> {

    constructor(
        private orderRepository: OrderRepository,
        private eventStore: EventStore,
        private eventBus: EventBus,
        private validator: CommandValidator
    ) {}

    async handle(command: CreateOrderCommand): Promise<CreateOrderResult> {
        // 1. Validate command
        const validation = this.validator.validate(command);
        if (!validation.valid) {
            return {
                success: false,
                errors: validation.errors
            };
        }

        // 2. Create aggregate
        const orderId = generateUUID();
        const order = new OrderAggregate(orderId);

        // 3. Execute business logic
        order.createOrder(
            command.payload.customerId,
            command.payload.shippingAddress,
            command.payload.billingAddress
        );

        for (const item of command.payload.items) {
            const product = await this.productService.getProduct(item.productId);
            order.addItem(product, item.quantity);
        }

        // 4. Persist events
        const events = order.getUncommittedEvents();
        await this.eventStore.save(events);

        // 5. Publish events
        await this.eventBus.publishBatch(events);

        // 6. Mark as committed
        order.markEventsAsCommitted();

        return {
            success: true,
            orderId: order.id,
            events: events
        };
    }
}

interface CreateOrderResult {
    success: boolean;
    orderId?: string;
    errors?: ValidationError[];
    events?: DomainEvent[];
}
```

### 5. Query Handler

Implement query handlers.

```typescript
// Query handler interface
interface QueryHandler<TQuery extends Query, TResult> {
    handle(query: TQuery): Promise<TResult>;
}

// Query handler implementation
class GetOrderByIdQueryHandler
    implements QueryHandler<GetOrderByIdQuery, OrderDTO | null> {

    constructor(
        private readDb: ReadDatabase,
        private cache: Cache
    ) {}

    async handle(query: GetOrderByIdQuery): Promise<OrderDTO | null> {
        // Check cache first
        const cacheKey = `order:${query.parameters.orderId}`;
        const cached = await this.cache.get<OrderDTO>(cacheKey);

        if (cached) {
            return cached;
        }

        // Query read database
        const order = await this.readDb.orderRepository.findById(
            query.parameters.orderId,
            {
                includeItems: query.parameters.includeItems ?? true,
                includeCustomer: query.parameters.includeCustomer ?? true
            }
        );

        if (!order) {
            return null;
        }

        // Cache result
        await this.cache.setex(cacheKey, 300, order);

        return order;
    }
}

class GetOrdersQueryHandler
    implements QueryHandler<GetOrdersQuery, OrderListDTO> {

    constructor(
        private readDb: ReadDatabase,
        private queryOptimizer: QueryOptimizer
    ) {}

    async handle(query: GetOrdersQuery): Promise<OrderListDTO> {
        // Build optimized query
        const queryBuilder = this.readDb.orderRepository
            .createQueryBuilder('order')
            .select(this.queryOptimizer.selectOnlyNeededFields(query));

        // Apply filters
        if (query.parameters.filtering) {
            const filter = query.parameters.filtering;

            if (filter.status) {
                queryBuilder.andWhere('order.status IN (:...status)', {
                    status: filter.status
                });
            }

            if (filter.customerId) {
                queryBuilder.andWhere('order.customerId = :customerId', {
                    customerId: filter.customerId
                });
            }

            if (filter.dateFrom) {
                queryBuilder.andWhere('order.createdAt >= :dateFrom', {
                    dateFrom: filter.dateFrom
                });
            }

            if (filter.dateTo) {
                queryBuilder.andWhere('order.createdAt <= :dateTo', {
                    dateTo: filter.dateTo
                });
            }
        }

        // Apply sorting
        for (const sort of query.parameters.sorting) {
            queryBuilder.addOrderBy(`order.${sort.field}`, sort.direction);
        }

        // Apply pagination
        const { page, limit } = query.parameters.pagination;
        queryBuilder.skip((page - 1) * limit).take(limit);

        // Execute query
        const [orders, totalCount] = await queryBuilder.getManyAndCount();

        return {
            orders: orders.map(this.mapToSummaryDTO),
            pagination: {
                page,
                limit,
                totalCount,
                totalPages: Math.ceil(totalCount / limit)
            },
            totalCount
        };
    }
}
```

### 6. Mediator Pattern

Implement mediator for command/query dispatching.

```typescript
// Mediator for CQRS
class CQRSMediator {
    private commandHandlers: Map<string, CommandHandler<any, any>> = new Map();
    private queryHandlers: Map<string, QueryHandler<any, any>> = new Map();
    private pipeline: CommandQueryPipeline;

    constructor(pipeline: CommandQueryPipeline) {
        this.pipeline = pipeline;
    }

    registerCommand<TCommand extends Command>(
        commandType: string,
        handler: CommandHandler<TCommand, any>
    ): void {
        this.commandHandlers.set(commandType, handler);
    }

    registerQuery<TQuery extends Query, TResult>(
        queryType: string,
        handler: QueryHandler<TQuery, TResult>
    ): void {
        this.queryHandlers.set(queryType, handler);
    }

    async send<TCommand extends Command, TResult>(
        command: TCommand
    ): Promise<TResult> {
        const handler = this.commandHandlers.get(command.type);
        if (!handler) {
            throw new HandlerNotFoundError(command.type);
        }

        return this.pipeline.execute(command, handler as CommandHandler<any, any>);
    }

    async query<TQuery extends Query, TResult>(
        query: TQuery
    ): Promise<TResult> {
        const handler = this.queryHandlers.get(query.type);
        if (!handler) {
            throw new HandlerNotFoundError(query.type);
        }

        return this.pipeline.execute(query, handler as QueryHandler<any, any>);
    }
}

// Pipeline behaviors
class CommandQueryPipeline {
    constructor(private behaviors: PipelineBehavior[]) {}

    async execute<T extends Command | Query, TResult>(
        message: T,
        handler: CommandHandler<T, TResult> | QueryHandler<T, TResult>
    ): Promise<TResult> {
        const context = new PipelineContext();

        for (const behavior of this.behaviors) {
            await behavior.beforeExecute(message, context);
        }

        let result: TResult;
        try {
            result = await (handler as any).handle(message);
        } catch (error) {
            for (const behavior of this.behaviors) {
                await behavior.onError(error, message, context);
            }
            throw error;
        }

        for (const behavior of this.behaviors) {
            await behavior.afterExecute(message, result, context);
        }

        return result;
    }
}

// Pipeline behaviors
interface PipelineBehavior {
    beforeExecute(message: Command | Query, context: PipelineContext): Promise<void>;
    afterExecute(message: Command | Query, result: any, context: PipelineContext): Promise<void>;
    onError(error: Error, message: Command | Query, context: PipelineContext): Promise<void>;
}

// Logging behavior
class LoggingBehavior implements PipelineBehavior {
    async beforeExecute(message: Command | Query, context: PipelineContext): Promise<void> {
        context.logger.info('Executing', {
            type: message.type,
            id: message.id
        });
    }

    async afterExecute(message: Command | Query, result: any, context: PipelineContext): Promise<void> {
        context.logger.info('Executed', {
            type: message.type,
            id: message.id
        });
    }

    async onError(error: Error, message: Command | Query, context: PipelineContext): Promise<void> {
        context.logger.error('Command failed', {
            type: message.type,
            id: message.id,
            error: error.message
        });
    }
}

// Validation behavior
class ValidationBehavior implements PipelineBehavior {
    constructor(private validator: CommandValidator) {}

    async beforeExecute(message: Command | Query, context: PipelineContext): Promise<void> {
        if ('type' in message && message.type.startsWith('CREATE_')) {
            const result = this.validator.validate(message);
            if (!result.valid) {
                throw new ValidationException(result.errors);
            }
        }
    }
}
```

### 7. Read Model Synchronization

Keep read models in sync with write side.

```typescript
// Event handler for read model updates
class OrderReadModelUpdater {
    constructor(
        private readDb: ReadDatabase,
        private cache: Cache
    ) {}

    async handle(event: DomainEvent): Promise<void> {
        switch (event.eventType) {
            case 'ORDER_CREATED':
                await this.onOrderCreated(event);
                break;
            case 'ORDER_ITEM_ADDED':
                await this.onItemAdded(event);
                break;
            case 'ORDER_CONFIRMED':
                await this.onOrderConfirmed(event);
                break;
            case 'ORDER_SHIPPED':
                await this.onOrderShipped(event);
                break;
        }

        // Invalidate cache
        await this.cache.delete(`order:${event.aggregateId}`);
    }

    private async onOrderCreated(event: OrderCreatedEvent): Promise<void> {
        await this.readDb.orderRepository.insert({
            id: event.payload.orderId,
            orderNumber: await this.generateOrderNumber(),
            customerId: event.payload.customerId,
            status: 'DRAFT',
            items: [],
            totalAmount: { amount: 0, currency: 'USD' },
            shippingAddress: event.payload.shippingAddress,
            billingAddress: event.payload.billingAddress,
            createdAt: event.timestamp,
            updatedAt: event.timestamp
        });
    }

    private async onItemAdded(event: OrderItemAddedEvent): Promise<void> {
        const order = await this.readDb.orderRepository.findById(event.aggregateId);

        if (order) {
            const existingItemIndex = order.items.findIndex(
                i => i.productId === event.payload.productId
            );

            if (existingItemIndex >= 0) {
                order.items[existingItemIndex] = {
                    productId: event.payload.productId,
                    productName: event.payload.productName,
                    quantity: event.payload.quantity,
                    unitPrice: event.payload.unitPrice,
                    totalPrice: event.payload.totalPrice
                };
            } else {
                order.items.push({
                    productId: event.payload.productId,
                    productName: event.payload.productName,
                    quantity: event.payload.quantity,
                    unitPrice: event.payload.unitPrice,
                    totalPrice: event.payload.totalPrice
                });
            }

            order.totalAmount = this.calculateTotal(order.items);
            order.updatedAt = event.timestamp;

            await this.readDb.orderRepository.update(order.id, order);
        }
    }

    private async onOrderConfirmed(event: OrderConfirmedEvent): Promise<void> {
        await this.readDb.orderRepository.update(event.aggregateId, {
            status: 'CONFIRMED',
            confirmedAt: event.payload.confirmedAt,
            updatedAt: event.timestamp
        });
    }

    private calculateTotal(items: OrderItemDTO[]): MoneyDTO {
        const total = items.reduce(
            (sum, item) => sum + item.totalPrice.amount,
            0
        );
        return { amount: total, currency: 'USD' };
    }
}

// Projection-based synchronization
class OrderProjectionBasedSynchronizer {
    private projection: OrderReadModelProjection;

    constructor(projection: OrderReadModelProjection) {
        this.projection = projection;
    }

    async synchronize(event: DomainEvent): Promise<void> {
        await this.projection.handle(event);
    }

    async rebuild(projectionName: string): Promise<void> {
        // Full rebuild of projection
        const events = await this.eventStore.getAll();
        const projection = this.createProjection(projectionName);

        for (const event of events) {
            await projection.handle(event);
        }
    }
}
```

### 8. Separate Databases

Maintain separate databases for reads and writes.

```typescript
// Database configuration
interface DatabaseConfig {
    writeDb: ConnectionConfig;
    readDb: ConnectionConfig;
}

// Write database (Normalized)
const writeDbConfig: ConnectionConfig = {
    host: 'write-db.example.com',
    port: 5432,
    database: 'orders_write',
    pool: {
        min: 10,
        max: 100
    }
};

// Read database (Denormalized)
const readDbConfig: ConnectionConfig = {
    host: 'read-db-1.example.com',
    port: 5432,
    database: 'orders_read',
    pool: {
        min: 20,
        max: 200
    },
    replicaSet: 'rs0' // Read from replica
};

// Multi-database context
class MultiDatabaseContext {
    writeDb: WriteDatabase;
    readDb: ReadDatabase;

    constructor(config: DatabaseConfig) {
        this.writeDb = new WriteDatabase(config.writeDb);
        this.readDb = new ReadDatabase(config.readDb);
    }

    async transaction<T>(fn: () => Promise<T>): Promise<T> {
        // Transactions only on write DB
        return this.writeDb.transaction(fn);
    }
}

// Repository implementations
class OrderWriteRepository {
    constructor(private db: WriteDatabase) {}

    async findById(id: string): Promise<OrderAggregate> {
        // Load from event store
        return this.eventStore.getById(id);
    }
}

class OrderReadRepository {
    constructor(private db: ReadDatabase) {}

    async findById(id: string): Promise<OrderDTO> {
        return this.db.query(
            `SELECT * FROM order_read_model WHERE id = $1`,
            [id]
        );
    }

    async findAll(query: GetOrdersQuery): Promise<OrderListDTO> {
        // Optimized read query
        return this.db.queryWithPagination(
            'order_read_model',
            query.parameters
        );
    }
}
```

### 9. API Controllers

Expose CQRS through API layer.

```typescript
// Command controller
class OrderCommandController {
    constructor(
        private mediator: CQRSMediator,
        private logger: Logger
    ) {}

    async createOrder(req: Request, res: Response): Promise<void> {
        try {
            const command: CreateOrderCommand = {
                id: generateUUID(),
                type: 'CREATE_ORDER',
                timestamp: new Date(),
                metadata: {
                    userId: req.user.id,
                    correlationId: req.headers['x-correlation-id']
                },
                payload: {
                    customerId: req.user.customerId,
                    shippingAddress: req.body.shippingAddress,
                    billingAddress: req.body.billingAddress,
                    items: req.body.items,
                    paymentMethod: req.body.paymentMethod
                }
            };

            const result = await this.mediator.send(command);

            if (!result.success) {
                res.status(400).json({
                    success: false,
                    errors: result.errors
                });
                return;
            }

            res.status(201).json({
                success: true,
                orderId: result.orderId
            });
        } catch (error) {
            this.logger.error('Create order failed', { error });
            res.status(500).json({
                success: false,
                error: 'Failed to create order'
            });
        }
    }

    async addItem(req: Request, res: Response): Promise<void> {
        try {
            const command: AddItemCommand = {
                id: generateUUID(),
                type: 'ADD_ITEM',
                timestamp: new Date(),
                metadata: {
                    userId: req.user.id
                },
                payload: {
                    orderId: req.params.orderId,
                    productId: req.body.productId,
                    quantity: req.body.quantity
                }
            };

            const result = await this.mediator.send(command);

            if (!result.success) {
                res.status(400).json(result);
                return;
            }

            res.json({ success: true });
        } catch (error) {
            this.handleError(res, error);
        }
    }
}

// Query controller
class OrderQueryController {
    constructor(
        private mediator: CQRSMediator,
        private logger: Logger
    ) {}

    async getOrder(req: Request, res: Response): Promise<void> {
        try {
            const query: GetOrderByIdQuery = {
                id: generateUUID(),
                type: 'GET_ORDER_BY_ID',
                parameters: {
                    orderId: req.params.id,
                    includeItems: true,
                    includeCustomer: true
                }
            };

            const order = await this.mediator.query(query);

            if (!order) {
                res.status(404).json({ error: 'Order not found' });
                return;
            }

            res.json(order);
        } catch (error) {
            this.handleError(res, error);
        }
    }

    async searchOrders(req: Request, res: Response): Promise<void> {
        try {
            const query: GetOrdersQuery = {
                id: generateUUID(),
                type: 'GET_ORDERS',
                parameters: {
                    pagination: {
                        page: parseInt(req.query.page) || 1,
                        limit: Math.min(parseInt(req.query.limit) || 20, 100)
                    },
                    sorting: this.parseSorting(req.query.sort as string),
                    filtering: {
                        status: req.query.status as OrderStatus[],
                        customerId: req.query.customerId as string,
                        dateFrom: req.query.dateFrom ? new Date(req.query.dateFrom) : undefined,
                        dateTo: req.query.dateTo ? new Date(req.query.dateTo) : undefined
                    }
                }
            };

            const result = await this.mediator.query(query);

            res.json(result);
        } catch (error) {
            this.handleError(res, error);
        }
    }
}
```

### 10. Testing CQRS

Testing strategies for CQRS.

```typescript
// Testing command handlers
describe('CreateOrderCommandHandler', () => {
    let handler: CreateOrderCommandHandler;
    let mockEventStore: MockEventStore;
    let mockEventBus: MockEventBus;

    beforeEach(() => {
        mockEventStore = new MockEventStore();
        mockEventBus = new MockEventBus();
        handler = new CreateOrderCommandHandler(
            mockEventStore,
            mockEventBus
        );
    });

    it('should create order successfully', async () => {
        const command: CreateOrderCommand = {
            id: 'cmd-1',
            type: 'CREATE_ORDER',
            timestamp: new Date(),
            metadata: {},
            payload: {
                customerId: 'cust-1',
                shippingAddress: testAddress(),
                billingAddress: testAddress(),
                items: [{
                    productId: 'prod-1',
                    quantity: 2
                }]
            }
        };

        const result = await handler.handle(command);

        expect(result.success).toBe(true);
        expect(result.orderId).toBeDefined();
        expect(mockEventStore.savedEvents).toHaveLength(1);
        expect(mockEventBus.publishedEvents).toHaveLength(1);
    });

    it('should reject empty items', async () => {
        const command: CreateOrderCommand = {
            id: 'cmd-1',
            type: 'CREATE_ORDER',
            timestamp: new Date(),
            metadata: {},
            payload: {
                customerId: 'cust-1',
                shippingAddress: testAddress(),
                billingAddress: testAddress(),
                items: [] // Empty
            }
        };

        const result = await handler.handle(command);

        expect(result.success).toBe(false);
        expect(result.errors).toContainEqual(
            expect.objectContaining({ field: 'items' })
        );
    });
});

// Testing query handlers
describe('GetOrdersQueryHandler', () => {
    let handler: GetOrdersQueryHandler;
    let mockReadDb: MockReadDatabase;

    beforeEach(() => {
        mockReadDb = new MockReadDatabase();
        handler = new GetOrdersQueryHandler(mockReadDb);
    });

    it('should return paginated orders', async () => {
        mockReadDb.orders = [
            createTestOrder('order-1'),
            createTestOrder('order-2'),
            createTestOrder('order-3')
        ];

        const query: GetOrdersQuery = {
            id: 'q-1',
            type: 'GET_ORDERS',
            parameters: {
                pagination: { page: 1, limit: 2 },
                sorting: [{ field: 'createdAt', direction: 'desc' }]
            }
        };

        const result = await handler.handle(query);

        expect(result.orders).toHaveLength(2);
        expect(result.pagination.totalCount).toBe(3);
        expect(result.pagination.totalPages).toBe(2);
    });
});
```

