## Ví dụ

### Ví dụ 1: Complete CQRS Setup

```typescript
// Main CQRS configuration
class CQRSConfiguration {
    static setup(): CQRSMediator {
        // Create mediator
        const mediator = new CQRSMediator(
            new CommandQueryPipeline([
                new LoggingBehavior(),
                new ValidationBehavior(new CommandValidator()),
                new PerformanceLoggingBehavior(),
                new ErrorHandlingBehavior()
            ])
        );

        // Register command handlers
        mediator.registerCommand(
            'CREATE_ORDER',
            new CreateOrderCommandHandler(
                new OrderRepository(),
                new EventStore(),
                new EventBus()
            )
        );

        // Register query handlers
        mediator.registerQuery(
            'GET_ORDERS',
            new GetOrdersQueryHandler(new ReadDatabase())
        );

        return mediator;
    }
}

// Usage in Express
const mediator = CQRSConfiguration.setup();

app.post('/orders', async (req, res) => {
    const command = createCommand(req.body);
    const result = await mediator.send(command);
    res.json(result);
});

app.get('/orders', async (req, res) => {
    const query = createQuery(req.query);
    const result = await mediator.query(query);
    res.json(result);
});
```

### Ví dụ 2: Event Synchronization

```typescript
// Projector for read model
class OrderReadModelProjector {
    constructor(
        private eventStore: EventStore,
        private readDb: ReadDatabase,
        private cache: Cache
    ) {}

    async project(events: DomainEvent[]): Promise<void> {
        for (const event of events) {
            await this.handleEvent(event);
        }
    }

    private async handleEvent(event: DomainEvent): Promise<void> {
        switch (event.eventType) {
            case 'ORDER_CREATED':
                await this.projectOrderCreated(event);
                break;
            case 'ORDER_ITEM_ADDED':
                await this.projectItemAdded(event);
                break;
            case 'ORDER_CONFIRMED':
                await this.projectOrderConfirmed(event);
                break;
        }

        // Invalidate related caches
        await this.invalidateRelatedCaches(event);
    }

    private async invalidateRelatedCaches(event: DomainEvent): Promise<void> {
        const cacheKeys = [
            `order:${event.aggregateId}`,
            'orders:list',
            `customer:${event.payload.customerId}:orders`
        ];

        await Promise.all(
            cacheKeys.map(key => this.cache.delete(key))
        );
    }
}
```

