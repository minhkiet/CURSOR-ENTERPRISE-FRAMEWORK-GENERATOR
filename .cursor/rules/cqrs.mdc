**6. Handling Consistency**

```typescript
// frontend/OrderPage.tsx

export function OrderPage({ orderId }: { orderId: string }) {
  const [order, setOrder] = useState<OrderReadModel | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    // Initial load
    fetchOrder(orderId)
      .then(setOrder)
      .catch(err => setError(err.message))
      .finally(() => setLoading(false));

    // Subscribe to updates via WebSocket
    const ws = connectToOrderUpdates(orderId);
    
    ws.onmessage = (event) => {
      const update = JSON.parse(event.data);
      setOrder(prev => ({ ...prev, ...update }));
    };

    return () => ws.close();
  }, [orderId]);

  if (loading) return <OrderSkeleton />;
  if (error) return <OrderError message={error} onRetry={() => fetchOrder(orderId)} />;
  if (!order) return <OrderNotFound />;

  return <OrderDetails order={order} />;
}

// Real-time updates
class OrderWebSocketService {
  constructor(private eventBus: EventBus) {}

  connect(orderId: string): WebSocket {
    const ws = new WebSocket(`wss://api.example.com/orders/${orderId}/ws`);

    ws.onmessage = async (event) => {
      const data = JSON.parse(event.data);
      
      if (data.type === 'order_updated') {
        const eventRecord: EventRecord = {
          eventId: data.eventId,
          aggregateType: 'Order',
          aggregateId: orderId,
          eventType: data.eventType,
          occurredAt: new Date(data.occurredAt),
          payload: data.payload,
          version: data.version
        };

        await this.eventBus.publish(deserializeEvent(eventRecord));
      }
    };

    return ws;
  }
}
```

## Workflow

**Phase 1: Analysis**

Identify read/write differences. Analyze access patterns. Estimate complexity. Decide if CQRS is needed.

**Phase 2: Design**

Design command model. Design query models. Define events. Plan projections. Document consistency model.

**Phase 3: Implementation**

Implement command side. Implement query side. Build projections. Set up event store. Configure buses.

**Phase 4: Testing**

Test commands. Test queries. Test projections. Integration tests. Performance tests.

**Phase 5: Deployment**

Deploy components. Monitor consistency. Set up alerts. Document patterns.

