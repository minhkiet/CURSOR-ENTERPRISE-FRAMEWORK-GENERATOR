### 6. Versioning Strategy

API versioning best practices.

```
# URL Path Versioning (most common)
GET /api/v1/users
GET /api/v2/users

# Header Versioning
GET /users
Accept: application/vnd.api+json; version=2

# Query Parameter Versioning (least recommended)
GET /users?version=2
```

```typescript
// Versioned router structure
const v1Router = express.Router();
const v2Router = express.Router();

// V1 routes
v1Router.get('/users', userController.listV1);
v1Router.get('/users/:id', userController.getV1);
v1Router.post('/users', userController.createV1);

// V2 routes with breaking changes
v2Router.get('/users', userController.listV2);
v2Router.get('/users/:id', userController.getV2);
v2Router.post('/users', userController.createV2);
v2Router.get('/users/:id/posts', userController.getUserPostsV2); // New endpoint

// Mount versioned routers
app.use('/api/v1', v1Router);
app.use('/api/v2', v2Router);

// Deprecation headers
function addDeprecationHeaders(res: Response, sunsetDate: string) {
    res.set({
        'Deprecation': `true`,
        'Sunset': sunsetDate,
        'Link': '<https://api.example.com/docs/v2>; rel="deprecation"'
    });
}
```

### 7. Content Negotiation

Handle different content types.

```typescript
// Content negotiation middleware
function contentNegotiation(
    req: Request,
    res: Response,
    next: NextFunction
) {
    const accept = req.headers.accept;

    // Set response format
    if (accept?.includes('application/xml')) {
        req.responseFormat = 'xml';
    } else if (accept?.includes('text/csv')) {
        req.responseFormat = 'csv';
    } else {
        req.responseFormat = 'json';
    }

    next();
}

// Response transformation
function formatResponse(data: any, format: string) {
    switch (format) {
        case 'xml':
            return toXml(data);
        case 'csv':
            return toCsv(data);
        default:
            return data;
    }
}

// Multiple format response
app.get('/users', async (req, res) => {
    const users = await userService.list();

    const format = req.responseFormat || 'json';

    if (format === 'xml') {
        res.set('Content-Type', 'application/xml');
        res.send(toXml({ users }));
    } else if (format === 'csv') {
        res.set('Content-Type', 'text/csv');
        res.send(toCsv(users));
    } else {
        res.json(users);
    }
});
```

### 8. Caching Strategy

Implement HTTP caching headers.

```typescript
// Cache headers implementation
class CacheController {
    // Public cache - can be cached by any client
    static public(maxAge: number = 3600) {
        return (req: Request, res: Response, next: NextFunction) => {
            res.set({
                'Cache-Control': `public, max-age=${maxAge}`,
                'Expires': new Date(Date.now() + maxAge * 1000).toUTCString()
            });
            next();
        };
    }

    // Private cache - only browser cache
    static private(maxAge: number = 3600) {
        return (req: Request, res: Response, next: NextFunction) => {
            res.set({
                'Cache-Control': `private, max-age=${maxAge}`
            });
            next();
        };
    }

    // No cache
    static noCache() {
        return (req: Request, res: Response, next: NextFunction) => {
            res.set({
                'Cache-Control': 'no-store, no-cache, must-revalidate',
                'Pragma': 'no-cache',
                'Expires': '0'
            });
            next();
        };
    }

    // ETag support
    static withETag(getData: (req: Request) => Promise<any>) {
        return async (req: Request, res: Response) => {
            const data = await getData(req);
            const etag = generateETag(data);

            res.set('ETag', etag);

            if (req.headers['if-none-match'] === etag) {
                return res.status(304).end();
            }

            res.json(data);
        };
    }
}

// Usage
router.get('/users',
    CacheController.public(300), // Cache for 5 minutes
    userController.list
);

router.get('/users/:id',
    CacheController.private(60), // Cache for 1 minute in browser
    CacheController.withETag(async (req) => {
        return await userService.getById(req.params.id);
    }),
    userController.get
);

router.post('/users',
    CacheController.noCache(), // Never cache mutations
    userController.create
);
```

### 9. Rate Limiting

Implement comprehensive rate limiting.

```typescript
import rateLimit from 'express-rate-limit';
import RedisStore from 'rate-limit-redis';

// Global rate limiter
export const globalLimiter = rateLimit({
    windowMs: 60 * 1000, // 1 minute
    max: 100,
    standardHeaders: true,
    legacyHeaders: false,
    message: {
        error: {
            code: 'RATE_LIMIT_EXCEEDED',
            message: 'Too many requests, please try again later'
        }
    },
    keyGenerator: (req) => {
        return req.user?.id || req.ip;
    }
});

// Auth endpoints - stricter limits
export const authLimiter = rateLimit({
    windowMs: 15 * 60 * 1000, // 15 minutes
    max: 5,
    skipSuccessfulRequests: true,
    message: {
        error: {
            code: 'AUTH_RATE_LIMIT_EXCEEDED',
            message: 'Too many authentication attempts'
        }
    }
});

// API endpoints
export const apiLimiter = rateLimit({
    windowMs: 60 * 1000,
    max: 1000,
    standardHeaders: true,
    store: new RedisStore({
        sendCommand: (...args: string[]) => redisClient.sendCommand(args)
    })
});

// File upload - expensive operation
export const uploadLimiter = rateLimit({
    windowMs: 60 * 60 * 1000, // 1 hour
    max: 10,
    message: {
        error: {
            code: 'UPLOAD_LIMIT_EXCEEDED',
            message: 'Upload limit exceeded'
        }
    }
});

// Apply to routes
app.use(globalLimiter);
app.post('/auth/login', authLimiter, authController.login);
app.post('/auth/register', authLimiter, authController.register);
app.use('/api', apiLimiter);
app.post('/upload', uploadLimiter, uploadController.upload);
```

### 10. Security Headers

Implement security headers.

```typescript
import helmet from 'helmet';

// Security headers middleware
app.use(helmet());

// Custom security headers
app.use((req: Request, res: Response, next: NextFunction) => {
    // CORS
    res.set({
        'Access-Control-Allow-Origin': process.env.ALLOWED_ORIGIN,
        'Access-Control-Allow-Methods': 'GET, POST, PUT, DELETE, OPTIONS',
        'Access-Control-Allow-Headers': 'Content-Type, Authorization',
        'Access-Control-Max-Age': '86400',

        // Security
        'Strict-Transport-Security': 'max-age=31536000; includeSubDomains',
        'X-Content-Type-Options': 'nosniff',
        'X-Frame-Options': 'DENY',
        'X-XSS-Protection': '1; mode=block',
        'Referrer-Policy': 'strict-origin-when-cross-origin',
        'Permissions-Policy': 'geolocation=(), microphone=(), camera=()',
        'Content-Security-Policy': "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline';"
    });

    next();
});

// Request ID for tracing
app.use((req: Request, res: Response, next: NextFunction) => {
    const requestId = req.headers['x-request-id'] || generateUUID();
    res.set('X-Request-ID', requestId);
    (req as any).requestId = requestId;
    next();
});
```

