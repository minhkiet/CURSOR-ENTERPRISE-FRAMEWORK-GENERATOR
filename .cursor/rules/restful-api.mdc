### 3. HTTP Status Codes

Sử dụng đúng HTTP status codes.

```typescript
// HTTP Status Code Usage Guide

// Success Codes (2xx)
enum SuccessStatus {
    OK = 200,                    // GET successful, PUT/PATCH successful
    CREATED = 201,               // Resource created
    ACCEPTED = 202,              // Request accepted for processing
    NO_CONTENT = 204,            // DELETE successful, no body to return
}

// Client Error Codes (4xx)
enum ClientErrorStatus {
    BAD_REQUEST = 400,           // Invalid request syntax
    UNAUTHORIZED = 401,          // Authentication required
    FORBIDDEN = 403,             // Authenticated but not authorized
    NOT_FOUND = 404,             // Resource not found
    METHOD_NOT_ALLOWED = 405,    // HTTP method not supported
    CONFLICT = 409,              // Conflict with current state
    UNPROCESSABLE_ENTITY = 422,  // Validation failed
    TOO_MANY_REQUESTS = 429,     // Rate limit exceeded
}

// Server Error Codes (5xx)
enum ServerErrorStatus {
    INTERNAL_SERVER_ERROR = 500, // Unexpected server error
    BAD_GATEWAY = 502,           // Invalid response from upstream
    SERVICE_UNAVAILABLE = 503,   // Server temporarily unavailable
    GATEWAY_TIMEOUT = 504,       // Upstream server timeout
}

// Example usage
class ApiResponse {
    static success<T>(data: T, status: number = 200) {
        return {
            status,
            data,
            success: true
        };
    }

    static created<T>(data: T) {
        return {
            status: 201,
            data,
            success: true
        };
    }

    static noContent() {
        return {
            status: 204,
            success: true
        };
    }

    static error(message: string, code: string, status: number) {
        return {
            status,
            error: {
                code,
                message
            },
            success: false
        };
    }
}
```

### 4. Pagination, Filtering, và Sorting

Implement standardized pagination patterns.

```yaml
# OpenAPI pagination specification
components:
  schemas:
    PaginationRequest:
      type: object
      properties:
        page:
          type: integer
          minimum: 1
          default: 1
          description: Page number (1-indexed)
        limit:
          type: integer
          minimum: 1
          maximum: 100
          default: 20
          description: Items per page
        sort:
          type: string
          description: Sort field (prefix with - for descending)
          example: "createdAt,-name"
        filter:
          type: object
          description: Filter criteria
          additionalProperties:
            type: string

    PaginationResponse:
      type: object
      properties:
        data:
          type: array
          items: {}
        pagination:
          $ref: '#/components/schemas/PaginationMeta'

    PaginationMeta:
      type: object
      properties:
        page:
          type: integer
        limit:
          type: integer
        totalItems:
          type: integer
        totalPages:
          type: integer
        hasNextPage:
          type: boolean
        hasPreviousPage:
          type: boolean
```

```typescript
// Pagination implementation
interface PaginationParams {
    page: number;
    limit: number;
    sort?: SortParams[];
    filter?: Record<string, any>;
}

interface PaginatedResult<T> {
    data: T[];
    pagination: {
        page: number;
        limit: number;
        totalItems: number;
        totalPages: number;
        hasNextPage: boolean;
        hasPreviousPage: boolean;
    };
}

async function paginate<T>(
    model: Model<T>,
    params: PaginationParams
): Promise<PaginatedResult<T>> {
    const { page, limit, sort, filter } = params;
    const offset = (page - 1) * limit;

    const [data, totalItems] = await Promise.all([
        model.findAll({
            where: filter,
            limit,
            offset,
            order: sort?.map(s => [s.field, s.direction])
        }),
        model.count({ where: filter })
    ]);

    const totalPages = Math.ceil(totalItems / limit);

    return {
        data,
        pagination: {
            page,
            limit,
            totalItems,
            totalPages,
            hasNextPage: page < totalPages,
            hasPreviousPage: page > 1
        }
    };
}

// Cursor-based pagination for large datasets
interface CursorPagination {
    cursor?: string;
    limit: number;
}

async function cursorPaginate<T>(
    model: Model<T>,
    params: CursorPagination
): Promise<PaginatedResult<T>> {
    const { cursor, limit } = params;

    const query: any = { limit: limit + 1 };

    if (cursor) {
        query.where = { id: { [Op.lt]: decodeCursor(cursor) } };
    }

    const data = await model.findAll(query);

    const hasNextPage = data.length > limit;
    if (hasNextPage) {
        data.pop(); // Remove extra item
    }

    return {
        data,
        pagination: {
            nextCursor: hasNextPage ? encodeCursor(data[data.length - 1].id) : null
        }
    };
}
```

