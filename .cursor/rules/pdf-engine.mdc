  const reportData = {
    reportTitle: 'Monthly Sales Report',
    period: `${data.month} ${data.year}`,
    generatedAt: new Date().toISOString(),
    summary: data.summary,
    charts: await Promise.all(
      data.charts.map(chart => generateChartImage(chart))
    ),
    tables: data.tables,
    footer: `Generated on ${new Date().toLocaleDateString()}`
  };
  
  return pdfService.generatePDF(template, reportData, {
    format: 'A4',
    landscape: true
  });
