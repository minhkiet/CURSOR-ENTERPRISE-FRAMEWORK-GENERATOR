**2. Data Fetching Patterns**

```typescript
// pages/blog/[slug].vue
<script setup lang="ts">
import type { BlogPost } from '@/types/blog';

const route = useRoute();

// Server-side data fetching with caching
const { data: post } = await useAsyncData(
  `post-${route.params.slug}`,
  () => $fetch<BlogPost>(`/api/blog/${route.params.slug}`),
  {
    watch: [() => route.params.slug]
  }
);

// SEO metadata
useSeoMeta({
  title: () => post.value?.title,
  description: () => post.value?.excerpt,
  ogTitle: () => post.value?.title,
  ogDescription: () => post.value?.excerpt,
  ogImage: () => post.value?.coverImage,
  articleAuthor: () => post.value?.author.name,
  articlePublishedTime: () => post.value?.publishedAt
});

// 404 if not found
if (!post.value) {
  throw createError({
    statusCode: 404,
    statusMessage: 'Post Not Found'
  });
}
</script>

<template>
  <article v-if="post">
    <header>
      <img :src="post.coverImage" :alt="post.title" />
      <h1>{{ post.title }}</h1>
      <div class="meta">
        <span>By {{ post.author.name }}</span>
        <time>{{ formatDate(post.publishedAt) }}</time>
      </div>
    </header>
    
    <div v-html="post.content" />
  </article>
</template>
```

**3. Server Routes**

```typescript
// server/api/orders/index.get.ts
import { H3Event } from 'h3';
import { z } from 'zod';
import { getOrdersByUserId } from '@/server/utils/db';
import { requireAuth } from '@/server/utils/auth';

const querySchema = z.object({
  page: z.coerce.number().int().positive().default(1),
  limit: z.coerce.number().int().positive().max(100).default(20),
  status: z.enum(['pending', 'processing', 'shipped', 'delivered']).optional()
});

export default defineEventHandler(async (event: H3Event) => {
  // Auth check
  const user = await requireAuth(event);
  
  // Validate query
  const query = await getQuery(event);
  const { page, limit, status } = querySchema.parse(query);
  
  // Fetch data
  const { orders, total } = await getOrdersByUserId(user.id, {
    page,
    limit,
    status
  });
  
  return {
    data: orders,
    pagination: {
      page,
      limit,
      total,
      totalPages: Math.ceil(total / limit)
    }
  };
});

// server/api/orders/index.post.ts
import { H3Event } from 'h3';
import { z } from 'zod';
import { createOrder } from '@/server/utils/db';
import { requireAuth } from '@/server/utils/auth';

const bodySchema = z.object({
  items: z.array(z.object({
    productId: z.string().uuid(),
    quantity: z.number().int().positive()
  })).min(1),
  shippingAddress: z.object({
    street: z.string().max(500),
    city: z.string().max(100),
    country: z.string().length(2),
    postalCode: z.string().max(20)
  })
});

export default defineEventHandler(async (event: H3Event) => {
  const user = await requireAuth(event);
  const body = await readBody(event);
  const data = bodySchema.parse(body);
  
  const order = await createOrder({
    userId: user.id,
    ...data
  });
  
  setResponseStatus(event, 201);
  
  return order;
});
```

**4. Composables**

```typescript
// composables/useAuth.ts
export const useAuth = () => {
  const user = useState('auth-user', () => null);
  const isLoading = useState('auth-loading', () => false);
  
  const isAuthenticated = computed(() => !!user.value);
  
  async function login(email: string, password: string) {
    isLoading.value = true;
    
    try {
      const response = await $fetch('/api/auth/login', {
        method: 'POST',
        body: { email, password }
      });
      
      user.value = response.user;
      
      return response.user;
    } finally {
      isLoading.value = false;
    }
  }
  
  async function logout() {
    await $fetch('/api/auth/logout', { method: 'POST' });
    user.value = null;
  }
  
  async function fetchUser() {
    if (user.value) return user.value;
    
    try {
      user.value = await $fetch('/api/auth/me');
      return user.value;
    } catch {
      return null;
    }
  }
  
  return {
    user: readonly(user),
    isLoading: readonly(isLoading),
    isAuthenticated,
    login,
    logout,
    fetchUser
  };
};

// composables/useFetch.ts
export const useFetch = <T>(
  url: string | (() => string),
  options?: {
    immediate?: boolean;
    lazy?: boolean;
    transform?: (data: any) => T;
  }
) => {
  const data = ref<T | null>(null) as Ref<T | null>;
  const error = ref<Error | null>(null);
  const pending = ref(false);
  
  const computedUrl = computed(() => 
    typeof url === 'function' ? url() : url
  );
  
  async function execute() {
    pending.value = true;
    error.value = null;
    
    try {
      let result = await $fetch(computedUrl.value);
      
      if (options?.transform) {
        result = options.transform(result);
      }
      
      data.value = result as T;
    } catch (e) {
      error.value = e instanceof Error ? e : new Error('Fetch failed');
    } finally {
      pending.value = false;
    }
  }
  
  if (options?.immediate !== false) {
    execute();
  }
  
  return {
    data: readonly(data),
    error: readonly(error),
    pending: readonly(pending),
    refresh: execute
  };
};
```

**5. Middleware**

```typescript
// middleware/auth.ts
export default defineNuxtRouteMiddleware(async (to) => {
  const { user, fetchUser } = useAuth();
  
  // Try to fetch user if not logged in
  if (!user.value) {
    const fetchedUser = await fetchUser();
    
    if (!fetchedUser) {
      return navigateTo('/login', {
        query: { redirect: to.fullPath }
      });
    }
  }
});

// middleware/guest.ts
export default defineNuxtRouteMiddleware(() => {
  const { user } = useAuth();
  
  if (user.value) {
    return navigateTo('/dashboard');
  }
});

// middleware/permission.ts
export const usePermission = () => {
  const { user } = useAuth();
  
  function hasPermission(permission: string): boolean {
    return user.value?.permissions?.includes(permission) || false;
  }
  
  function hasRole(role: string): boolean {
    return user.value?.role === role;
  }
  
  return { hasPermission, hasRole };
};

// Route middleware with permissions
export default defineNuxtRouteMiddleware((to) => {
  const { hasPermission } = usePermission();
  
  const requiredPermission = to.meta.permission as string | undefined;
  
  if (requiredPermission && !hasPermission(requiredPermission)) {
    throw createError({
      statusCode: 403,
      statusMessage: 'Forbidden'
    });
  }
});
```

**6. Pinia Store**

```typescript
// stores/cart.ts
import { defineStore } from 'pinia';

interface CartItem {
  productId: string;
  name: string;
  price: number;
  quantity: number;
  imageUrl: string;
}

interface CartState {
  items: CartItem[];
  isLoading: boolean;
}

export const useCartStore = defineStore('cart', () => {
  // State
  const items = ref<CartItem[]>([]);
  const isLoading = ref(false);
  
  // Getters
  const itemCount = computed(() => 
    items.value.reduce((sum, item) => sum + item.quantity, 0)
  );
  
  const subtotal = computed(() =>
    items.value.reduce((sum, item) => sum + item.price * item.quantity, 0)
  );
  
  const tax = computed(() => subtotal.value * 0.1);
  
  const total = computed(() => subtotal.value + tax.value);
  
  const isEmpty = computed(() => items.value.length === 0);
  
  // Actions
  function addItem(item: Omit<CartItem, 'quantity'>) {
    const existing = items.value.find(i => i.productId === item.productId);
    
    if (existing) {
      existing.quantity++;
    } else {
      items.value.push({ ...item, quantity: 1 });
    }
  }
  
  function removeItem(productId: string) {
    const index = items.value.findIndex(i => i.productId === productId);
    if (index !== -1) {
      items.value.splice(index, 1);
    }
  }
  
  function updateQuantity(productId: string, quantity: number) {
    const item = items.value.find(i => i.productId === productId);
    if (item) {
      if (quantity <= 0) {
        removeItem(productId);
      } else {
        item.quantity = quantity;
      }
    }
  }
  
  function clearCart() {
    items.value = [];
  }
  
  async function checkout() {
    isLoading.value = true;
    
    try {
      const order = await $fetch('/api/orders', {
        method: 'POST',
        body: {
          items: items.value.map(i => ({
            productId: i.productId,
            quantity: i.quantity
          }))
        }
      });
      
      clearCart();
      
      return order;
    } finally {
      isLoading.value = false;
    }
  }
  
  return {
    // State
    items,
    isLoading,
    // Getters
    itemCount,
    subtotal,
    tax,
    total,
    isEmpty,
    // Actions
    addItem,
    removeItem,
    updateQuantity,
    clearCart,
    checkout
  };
});
```

## Workflow

**Phase 1: Project Initialization**

Create Nuxt project. Configure TypeScript. Set up modules. Configure rendering mode.

**Phase 2: Structure Setup**

Create layouts. Set up routing structure. Configure middleware. Set up stores.

**Phase 3: API Development**

Create server routes. Implement database connection. Add authentication. Set up validation.

**Phase 4: Frontend Development**

Create pages. Build components. Implement data fetching. Add SEO metadata.

**Phase 5: Testing**

Set up testing framework. Write unit tests. Write E2E tests. Test API routes.

**Phase 6: Deployment**

Configure adapter. Set up environment. Deploy to target platform. Monitor performance.

## Ví dụ

**Ví dụ 1: Hybrid Rendering**

```typescript
// nuxt.config.ts
export default defineNuxtConfig({
  routeRules: {
    // Homepage: Static generation at build time
    '/': { prerender: true },
    
    // Blog: ISR with 1 hour revalidation
    '/blog/**': { swr: 3600 },
    
    // Products: ISR with 5 minute revalidation
    '/products/**': { swr: 300 },
    
    // Dashboard: SSR for authenticated pages
    '/dashboard/**': { ssr: true },
    
    // Admin: SPA mode for admin panel
    '/admin/**': { ssr: false },
    
    // API: No prerendering
    '/api/**': { cors: true }
  }
});
```

**Ví dụ 2: Real-time Notifications**

```typescript
// composables/useNotifications.ts
export const useNotifications = () => {
  const notifications = useState<Notification[]>('notifications', () => []);
  const unreadCount = computed(() => 
    notifications.value.filter(n => !n.read).length
  );
  
  async function fetchNotifications() {
    const data = await $fetch('/api/notifications');
    notifications.value = data;
  }
  
  async function markAsRead(id: string) {
    await $fetch(`/api/notifications/${id}/read`, { method: 'POST' });
    
    const notification = notifications.value.find(n => n.id === id);
    if (notification) {
      notification.read = true;
    }
  }
  
  async function markAllAsRead() {
    await $fetch('/api/notifications/read-all', { method: 'POST' });
    notifications.value.forEach(n => n.read = true);
  }
  
  return {
    notifications: readonly(notifications),
    unreadCount,
    fetchNotifications,
    markAsRead,
    markAllAsRead
  };
};

// Server route for real-time
// server/api/notifications.subscribe.ts
export default defineEventHandler(async (event) => {
  const user = await requireAuth(event);
  
  // Return SSE stream
  setHeader(event, 'Content-Type', 'text/event-stream');
  setHeader(event, 'Cache-Control', 'no-cache');
  
  const { read } = useRealtime();
  
  return sendStream(event, new ReadableStream({
    start(controller) {
      const unsubscribe = read('notifications', (notification) => {
        if (notification.userId === user.id) {
          controller.enqueue(`data: ${JSON.stringify(notification)}\n\n`);
        }
      });
      
      event.node.req.on('close', () => {
        unsubscribe();
        controller.close();
      });
    }
  }));
});
```

