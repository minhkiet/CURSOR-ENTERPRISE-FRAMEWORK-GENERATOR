    { "code": "79", "name": "Hồ Chí Minh", "name_en": "Ho Chi Minh", "full_name": "Thành phố Hồ Chí Minh", "full_name_en": "Ho Chi Minh City" },
    { "code": "48", "name": "Đà Nẵng", "name_en": "Da Nang", "full_name": "Thành phố Đà Nẵng", "full_name_en": "Da Nang City" },
    { "code": "02", "name": "Hà Giang", "name_en": "Ha Giang", "full_name": "Tỉnh Hà Giang", "full_name_en": "Ha Giang Province" },
    { "code": "20", "name": "Hải Phòng", "name_en": "Hai Phong", "full_name": "Thành phố Hải Phòng", "full_name_en": "Hai Phong City" }
  ]
}
