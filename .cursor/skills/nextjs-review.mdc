## Workflow (Quy trình)

### Bước 1: Project Structure Analysis

```typescript
// Analyze Next.js project structure
interface NextJsStructure {
  router: 'pages' | 'app' | 'mixed';
  version: string;
  features: FeatureInfo[];
  issues: StructureIssue[];
}

async function analyzeStructure(
  rootPath: string
): Promise<NextJsStructure> {
  const packageJson = await readFile(`${rootPath}/package.json`);
  const nextConfig = await readFile(`${rootPath}/next.config.js`);
  
  const pkg = JSON.parse(packageJson);
  const nextVersion = pkg.dependencies?.next || 'unknown';
  
  // Detect router type
  const hasAppRouter = await checkDirectoryExists(`${rootPath}/app`);
  const hasPagesRouter = await checkDirectoryExists(`${rootPath}/pages`);
  
  // Detect features
  const features: FeatureInfo[] = [];
  
  if (pkg.dependencies?.['@tanstack/react-query']) {
    features.push({ name: 'React Query', enabled: true });
  }
  if (pkg.dependencies?.['next-auth']) {
    features.push({ name: 'NextAuth', enabled: true });
  }
  if (pkg.dependencies?.['@prisma/client']) {
    features.push({ name: 'Prisma', enabled: true });
  }
  if (pkg.dependencies?.tailwindcss) {
    features.push({ name: 'Tailwind', enabled: true });
  }
  
  // Check for TypeScript
  const hasTypeScript = await checkFileExists(`${rootPath}/tsconfig.json`);
  if (hasTypeScript) {
    features.push({ name: 'TypeScript', enabled: true });
  }
  
  const issues: StructureIssue[] = [];
  
  // Check for mixed routers
  if (hasAppRouter && hasPagesRouter) {
    issues.push({
      type: 'mixed_router',
      severity: 'medium',
      message: 'Project uses both App Router and Pages Router - consider migration'
    });
  }
  
  return {
    router: hasAppRouter ? 'app' : (hasPagesRouter ? 'pages' : 'unknown'),
    version: nextVersion,
    features,
    issues
  };
}
```

### Bước 2: App Router Analysis

```typescript
// Analyze App Router patterns
interface AppRouterAnalysis {
  layouts: LayoutInfo[];
  pages: PageInfo[];
  loading: LoadingInfo[];
  error: ErrorBoundaryInfo[];
  parallel_routes: ParallelRouteInfo[];
  intercepting_routes: InterceptingRouteInfo[];
}

async function analyzeAppRouter(
  appPath: string
): Promise<AppRouterAnalysis> {
  const structure = await analyzeDirectory(appPath);
  
  const layouts: LayoutInfo[] = [];
  const pages: PageInfo[] = [];
  const loading: LoadingInfo[] = [];
  const error: ErrorBoundaryInfo[] = [];
  
  for (const file of structure.files) {
    if (file.includes('/loading.tsx') || file.includes('/loading.jsx')) {
      loading.push({
        path: file,
        component: await readFile(file)
      });
    }
    if (file.includes('/error.tsx') || file.includes('/error.jsx')) {
      error.push({
        path: file,
        component: await readFile(file)
      });
    }
    if (file.includes('/page.tsx') || file.includes('/page.jsx')) {
      pages.push(await analyzePage(file));
    }
    if (file.includes('/layout.tsx') || file.includes('/layout.jsx')) {
      layouts.push(await analyzeLayout(file));
    }
  }
  
  return {
    layouts,
    pages,
    loading,
    error,
    parallel_routes: await findParallelRoutes(appPath),
    intercepting_routes: await findInterceptingRoutes(appPath)
  };
}

async function analyzePage(
  pagePath: string
): Promise<PageInfo> {
  const content = await readFile(pagePath);
  const parsed = parseReactComponent(content);
  
  return {
    path: pagePath,
    component: parsed.name,
    isServerComponent: parsed.isServerComponent,
    hasDataFetching: parsed.hasDataFetching,
    dataFetchingMethod: detectDataFetchingMethod(content),
    hasClientDirective: content.includes("'use client'"),
    metadata: extractMetadata(content),
    hasSuspense: content.includes('Suspense'),
    streaming: content.includes('streaming')
  };
}

function detectDataFetchingMethod(content: string): string | null {
  if (content.includes('async function') && content.includes('fetch(')) {
    return 'fetch';
  }
  if (content.includes('useEffect') && content.includes('axios') || content.includes('fetch')) {
    return 'client_fetch';
  }
  if (content.includes('useQuery') || content.includes('useSWR')) {
    return 'react_query_or_swr';
  }
  if (content.includes('prisma') || content.includes('db.')) {
    return 'direct_db';
  }
  return null;
}
```

### Bước 3: Server vs Client Component Analysis

```typescript
// Analyze Server vs Client component boundaries
interface ComponentBoundaryAnalysis {
  server_components: ComponentInfo[];
  client_components: ComponentInfo[];
  boundary_issues: BoundaryIssue[];
  recommendations: BoundaryRecommendation[];
}

async function analyzeComponentBoundaries(
  componentsPath: string
): Promise<ComponentBoundaryAnalysis> {
  const files = await glob('**/*.{tsx,jsx}', { cwd: componentsPath });
  const server: ComponentInfo[] = [];
  const client: ComponentInfo[] = [];
  const issues: BoundaryIssue[] = [];
  
  for (const file of files) {
    const content = await readFile(file);
    const info = await analyzeComponent(file, content);
    
    if (content.includes("'use client'")) {
      client.push(info);
    } else {
      server.push(info);
      
      // Check for client-only patterns in server components
      if (info.usesState) {
        issues.push({
          type: 'state_in_server',
          file,
          severity: 'error',
          message: 'useState found in Server Component'
        });
      }
      
      if (info.usesEffect) {
        issues.push({
          type: 'effect_in_server',
          file,
          severity: 'error',
          message: 'useEffect found in Server Component'
        });
      }
      
      if (info.usesEventHandlers) {
        issues.push({
          type: 'event_handler_in_server',
          file,
          severity: 'error',
          message: 'Event handlers in Server Component - should be Client Component'
        });
      }
    }
  }
  
  return {
    server_components: server,
    client_components: client,
    boundary_issues: issues,
    recommendations: generateBoundaryRecommendations(issues)
  };
}

async function analyzeComponent(
  file: string,
  content: string
): Promise<ComponentInfo> {
  const imports = extractImports(content);
  
  return {
    name: extractComponentName(content),
    file,
    imports,
    usesState: content.includes('useState'),
    usesEffect: content.includes('useEffect'),
    usesContext: content.includes('useContext'),
    usesEventHandlers: /on\w+\s*=/.test(content),
    usesRef: content.includes('useRef'),
    usesMemo: content.includes('useMemo') || content.includes('useCallback'),
    hooks: extractHooks(content),
    props: extractProps(content)
  };
}
```

### Bước 4: Data Fetching Analysis

```typescript
// Analyze data fetching patterns
interface DataFetchingAnalysis {
  patterns: DataPattern[];
  issues: DataIssue[];
  cache_analysis: CacheAnalysis;
  recommendations: DataRecommendation[];
}

async function analyzeDataFetching(
  appPath: string
): Promise<DataFetchingAnalysis> {
  const pages = await glob('**/page.tsx', { cwd: appPath });
  const patterns: DataPattern[] = [];
  const issues: DataIssue[] = [];
  
  for (const page of pages) {
    const content = await readFile(page);
    const pattern = analyzePageDataFetching(page, content);
    patterns.push(pattern);
    
    // Check for anti-patterns
    if (pattern.method === 'client_fetch' && pattern.frequency === 'per_visit') {
      issues.push({
        type: 'no_caching',
        file: page,
        severity: 'high',
        message: 'Client-side fetching without caching on every visit'
      });
    }
    
    if (pattern.method === 'direct_db' && !content.includes('cache')) {
      issues.push({
        type: 'no_cache',
        file: page,
        severity: 'medium',
        message: 'Direct database access without React cache()'
      });
    }
    
    if (pattern.nested_fetches > 2) {
      issues.push({
        type: 'waterfall_fetching',
        file: page,
        severity: 'medium',
        message: `Multiple sequential fetches (${pattern.nested_fetches}) - consider parallel`
      });
    }
  }
  
  return {
    patterns,
    issues,
    cache_analysis: analyzeCacheUsage(pages),
    recommendations: generateDataRecommendations(issues)
  };
}

function analyzePageDataFetching(
  page: string,
  content: string
): DataPattern {
  return {
    page,
    method: detectDataFetchingMethod(content),
    hasLoading: content.includes('loading'),
    hasSuspense: content.includes('Suspense'),
    hasError: content.includes('error'),
    streaming: content.includes('streaming'),
    parallel: detectParallelFetching(content),
    nested_fetches: countNestedFetches(content),
    frequency: determineFrequency(content)
  };
}
```

### Bước 5: Performance Analysis

```typescript
// Analyze performance patterns
interface PerformanceAnalysis {
  images: ImageAnalysis;
  fonts: FontAnalysis;
  bundles: BundleAnalysis;
  rendering: RenderingAnalysis;
  issues: PerformanceIssue[];
}

async function analyzePerformance(
  rootPath: string
): Promise<PerformanceAnalysis> {
  const nextConfig = await readFile(`${rootPath}/next.config.js`);
  
  return {
    images: await analyzeImages(rootPath),
    fonts: await analyzeFonts(rootPath),
    bundles: await analyzeBundles(rootPath),
    rendering: await analyzeRendering(rootPath),
    issues: await findPerformanceIssues(rootPath)
  };
}

async function analyzeImages(
  rootPath: string
): Promise<ImageAnalysis> {
  const pages = await glob('**/*.{tsx,jsx}', { cwd: rootPath });
  const issues: ImageIssue[] = [];
  
  for (const page of pages) {
    const content = await readFile(page);
    
    // Check for next/image usage
    const imgMatches = content.match(/<img\s+[^>]*src=/g) || [];
    const nextImgMatches = content.match(/<Image\s+[^>]*src=/g) || [];
    
    if (imgMatches.length > 0) {
      issues.push({
        type: 'unoptimized_image',
        file: page,
        count: imgMatches.length,
        message: 'Use next/image for optimized images'
      });
    }
    
    // Check for missing sizes prop
    const missingSizes = content.match(/<Image[^>]*>(?!.*sizes)/);
    if (missingSizes) {
      issues.push({
        type: 'missing_sizes',
        file: page,
        message: 'next/image should have sizes prop for responsive images'
      });
    }
  }
  
  return { issues };
}

async function analyzeBundles(
  rootPath: string
): Promise<BundleAnalysis> {
  // Check for bundle analyzer config
  const hasAnalyzer = await checkFileExists(`${rootPath}/next.config.js`);
  const config = await readFile(`${rootPath}/next.config.js`);
  
  const recommendations: string[] = [];
  
  if (!config.includes('bundleAnalysis')) {
    recommendations.push('Enable bundle analyzer for size tracking');
  }
  
  // Check for dynamic imports
  const pages = await glob('**/page.tsx', { cwd: rootPath });
  let dynamicImports = 0;
  
  for (const page of pages) {
    const content = await readFile(page);
    if (content.includes('dynamic(') || content.includes('dynamicImport')) {
      dynamicImports++;
    }
  }
  
  return {
    hasAnalyzer,
    dynamicImports,
    recommendations
  };
}
```

### Bước 6: SEO Analysis

```typescript
// Analyze SEO implementation
interface SEOAnalysis {
  metadata: MetadataAnalysis;
  structured_data: StructuredDataAnalysis;
  accessibility: AccessibilityAnalysis;
  issues: SEOIssue[];
}

async function analyzeSEO(
  appPath: string
): Promise<SEOAnalysis> {
  const pages = await glob('**/page.tsx', { cwd: appPath });
  const metadataIssues: MetadataIssue[] = [];
  const structuredDataIssues: StructuredDataIssue[] = [];
  
  for (const page of pages) {
    const content = await readFile(page);
    
    // Check for metadata
    if (!content.includes('generateMetadata') && !content.includes('Metadata')) {
      metadataIssues.push({
        type: 'missing_metadata',
        file: page,
        severity: 'high',
        message: 'Page should export metadata for SEO'
      });
    }
    
    // Check for openGraph
    if (!content.includes('openGraph')) {
      metadataIssues.push({
        type: 'missing_og_tags',
        file: page,
        severity: 'medium',
        message: 'Consider adding Open Graph tags for social sharing'
      });
    }
    
    // Check for structured data
    if (page.includes('/product/') || page.includes('/article/')) {
      if (!content.includes('application/ld+json')) {
        structuredDataIssues.push({
          type: 'missing_structured_data',
          file: page,
          severity: 'medium',
          message: 'Consider adding JSON-LD structured data'
        });
      }
    }
  }
  
  return {
    metadata: { issues: metadataIssues },
    structured_data: { issues: structuredDataIssues },
    accessibility: await analyzeAccessibility(appPath),
    issues: [...metadataIssues, ...structuredDataIssues]
  };
}
```

## Checklist (Danh sách kiểm tra)

- [ ] Using App Router (for new projects)
- [ ] Server Components for static content
- [ ] Client Components only where needed
- [ ] Proper 'use client' directive placement
- [ ] Metadata on all pages
- [ ] Open Graph tags configured
- [ ] next/image for all images
- [ ] next/font for fonts
- [ ] Proper caching with fetch
- [ ] Loading.tsx for route segments
- [ ] error.tsx for error boundaries
- [ ] not-found.tsx for 404 pages
- [ ] Route groups properly organized
- [ ] Parallel routes where needed
- [ ] Intercepting routes for modals

## Examples (Ví dụ)

### Ví dụ 1: Correct Server/Client Separation

```typescript
// ❌ BEFORE: Wrong boundaries
// app/dashboard/page.tsx (Server Component)
'use server'

export default async function DashboardPage() {
  const [user, stats] = await Promise.all([
    getUser(),
    getStats()
  ])
  
  return (
    <Dashboard 
      user={user}
      stats={stats}
      onRefresh={() => {}} // ❌ Event handler in Server Component!
    />
  )
}

// ✅ AFTER: Proper separation
// app/dashboard/page.tsx (Server Component)
export default async function DashboardPage() {
  const [user, stats] = await Promise.all([
    getUser(),
    getStats()
  ])
  
  return (
    <Dashboard 
      user={user}
      stats={stats}
    />
  )
}

// components/Dashboard.tsx (Client Component)
'use client'

export function Dashboard({ user, stats }: DashboardProps) {
  const [refreshKey, setRefreshKey] = useState(0)
  
  const onRefresh = () => setRefreshKey(k => k + 1)
  
  return (
    <div>
      <Header user={user} />
      <StatsPanel key={refreshKey} stats={stats} />
      <button onClick={onRefresh}>Refresh</button>
    </div>
  )
}
```

### Ví dụ 2: Proper Data Fetching

```typescript
// ❌ BEFORE: Client-side waterfall
'use client'

export default function ProductList() {
  const [category, setCategory] = useState()
  const [products, setProducts] = useState()
  
  useEffect(() => {
    fetch('/api/categories').then(r => r.json()).then(setCategory)
  }, [])
  
  useEffect(() => {
    if (category) {
      fetch(`/api/products?category=${category}`).then(r => r.json()).then(setProducts)
    }
  }, [category])
  
  return <div>{products?.map(p => <Product key={p.id} {...p} />)}</div>
}

// ✅ AFTER: Server-side with parallel fetch
import { cache } from 'react'

const getCategories = cache(async () => {
  const res = await fetch('/api/categories', { next: { revalidate: 3600 } })
  return res.json()
})

const getProducts = cache(async (category: string) => {
  const res = await fetch(`/api/products?category=${category}`, {
    next: { revalidate: 60 }
  })
  return res.json()
})

export default async function ProductList({
  searchParams
}: { searchParams: { category?: string } }) {
  const category = searchParams.category || 'all'
  
  const [categories, products] = await Promise.all([
    getCategories(),
    getProducts(category)
  ])
  
  return <div>{products.map(p => <Product key={p.id} {...p} />)}</div>
}
```

## Anti Patterns (Các pattern cần tránh)

### 1. Client Components Everywhere
```typescript
// ❌ BAD: Unnecessary client component
'use client'

export default function Header({ title }: { title: string }) {
  return <h1>{title}</h1>
}

// ✅ GOOD: Server component
export default function Header({ title }: { title: string }) {
  return <h1>{title}</h1>
}
```

### 2. fetch without caching
```typescript
// ❌ BAD: No caching
const data = await fetch('/api/data')

// ✅ GOOD: Proper caching
const data = await fetch('/api/data', {
  next: { revalidate: 3600 } // ISR
})
// or
const data = await fetch('/api/data', { cache: 'force-cache' })
```

### 3. Blocking the render
```typescript
// ❌ BAD: Sequential fetches
const user = await getUser()
const orders = await getOrders(user.id)
const products = await getProducts(orders)

// ✅ GOOD: Parallel fetches
const [user, orders, products] = await Promise.all([
  getUser(),
  getOrders(user.id),
  getProducts(orders)
])
```

### 4. Unoptimized images
```typescript
// ❌ BAD: HTML img tag
<img src="/product.jpg" alt="Product" />

// ✅ GOOD: next/image
import Image from 'next/image'

<Image 
  src="/product.jpg" 
  alt="Product" 
  width={400} 
  height={300}
  sizes="(max-width: 768px) 100vw, 400px"
/>
```

### 5. No metadata
```typescript
// ❌ BAD: Missing metadata
export default function AboutPage() {
  return <main>About us content</main>
}

// ✅ GOOD: Full metadata
import { Metadata } from 'next'

export const metadata: Metadata = {
  title: 'About Us',
  description: 'Learn more about our company',
  openGraph: {
    title: 'About Us',
    images: ['/og-image.jpg']
  }
}

export default function AboutPage() {
  return <main>About us content</main>
}
```

## Best Practices (Thực hành tốt nhất)

1. **Default to Server Components**: Only use Client Components when needed
2. **Push client code to leaves**: Keep 'use client' as low as possible
3. **Use React cache()**: For deduplicating data requests
4. **Implement proper metadata**: Title, description, OpenGraph
5. **Use next/image**: Automatic optimization
6. **Use next/font**: Self-hosted fonts, no layout shift
7. **Implement loading.tsx**: Streaming with Suspense
8. **Handle errors properly**: error.tsx and not-found.tsx
9. **Static generation by default**: Only use dynamic when needed
10. **Monitor Core Web Vitals**: LCP, FID, CLS

