### Ví dụ 1: Full Optimization Workflow

```typescript
async function optimizeDatabase(
  connection: ConnectionConfig
): Promise<OptimizationReport> {
  const db = await connect(connection);
  
  console.log('Analyzing database...');
  const analysis = await analyzeDatabase(db);
  
  console.log('Analyzing slow queries...');
  const analyzer = new QueryAnalyzer();
  const queries = await analyzer.analyzeSlowQueries(db, 100);
  
  console.log('Generating index recommendations...');
  const indexer = new IndexRecommender(db);
  const indexRecommendations = await indexer.generateRecommendations(queries);
  
  console.log('Tuning configuration...');
  const tuner = new ConfigTuner();
  const configRecommendations = await tuner.analyzeAndRecommend(
    db, 
    'mixed'
  );
  
  console.log('Rewriting queries...');
  const rewriter = new QueryRewriter();
  const rewrites = rewriter.rewriteSlowQueries(queries);
  
  return {
    analysis,
    queries,
    indexRecommendations,
    configRecommendations,
    rewrites,
    actionPlan: generateActionPlan({
      indexRecommendations,
      configRecommendations,
      rewrites
    })
  };
}
