### Phase 3: Application Layer

### Bước 5: Commands và Queries (CQRS)

```typescript
// application/commands/CreateOrder/CreateOrderCommand.ts
export class CreateOrderCommand {
  constructor(
    public readonly customerId: string,
    public readonly items: CreateOrderItemDto[],
    public readonly shippingAddress: AddressDto,
    public readonly paymentMethodId: string
  ) {}
}

// application/commands/CreateOrder/CreateOrderHandler.ts
export class CreateOrderHandler {
  constructor(
    private orderRepository: IOrderRepository,
    private productRepository: IProductRepository,
    private customerRepository: ICustomerRepository,
    private paymentService: IPaymentService,
    private eventBus: IEventBus,
    private unitOfWork: IUnitOfWork
  ) {}
  
  async handle(command: CreateOrderCommand): Promise<Result<OrderDto>> {
    return this.unitOfWork.execute(async () => {
      // 1. Validate customer exists
      const customer = await this.customerRepository.findById(command.customerId);
      if (!customer) {
        return Result.fail(new NotFoundException('Customer not found'));
      }
      
      // 2. Validate products and calculate prices
      const orderItems: OrderItemProps[] = [];
      let totalAmount = Money.zero('USD');
      
      for (const itemDto of command.items) {
        const product = await this.productRepository.findById(itemDto.productId);
        if (!product) {
          return Result.fail(new NotFoundException(`Product ${itemDto.productId} not found`));
        }
        
        if (product.stock < itemDto.quantity) {
          return Result.fail(
            new InsufficientStockException(product.id, product.stock, itemDto.quantity)
          );
        }
        
        orderItems.push({
          productId: product.id,
          productName: product.name,
          quantity: itemDto.quantity,
          unitPrice: product.price
        });
        
        totalAmount = totalAmount.add(product.price.multiply(itemDto.quantity));
      }
      
      // 3. Process payment
      const paymentResult = await this.paymentService.charge(
        customer.id,
        totalAmount,
        command.paymentMethodId
      );
      
      if (!paymentResult.isSuccess) {
        return Result.fail(paymentResult.error);
      }
      
      // 4. Create order aggregate
      const order = OrderAggregate.create({
        customerId: customer.id,
        items: orderItems,
        shippingAddress: Address.create(command.shippingAddress),
        currency: 'USD'
      });
      
      // 5. Reserve inventory
      for (const item of orderItems) {
        await this.productRepository.reserveStock(item.productId, item.quantity);
      }
      
      // 6. Save order
      await this.orderRepository.save(order);
      
      // 7. Publish events
      await this.eventBus.publish(order.getDomainEvents());
      
      return Result.ok(OrderDto.fromAggregate(order));
    });
  }
}

// application/queries/GetOrderHistory/GetOrderHistoryQuery.ts
export class GetOrderHistoryQuery {
  constructor(
    public readonly customerId: string,
    public readonly page: number = 1,
    public readonly pageSize: number = 10,
    public readonly status?: OrderStatus
  ) {}
}

// application/queries/GetOrderHistory/GetOrderHistoryHandler.ts
export class GetOrderHistoryHandler {
  constructor(
    private orderRepository: IOrderRepository
  ) {}
  
  async handle(query: GetOrderHistoryQuery): Promise<PaginatedResult<OrderDto>> {
    const { customerId, page, pageSize, status } = query;
    
    const [orders, total] = await Promise.all([
      this.orderRepository.findByCustomer(customerId, { status, page, pageSize }),
      this.orderRepository.countByCustomer(customerId, { status })
    ]);
    
    return {
      data: orders.map(OrderDto.fromAggregate),
      total,
      page,
      pageSize,
      totalPages: Math.ceil(total / pageSize)
    };
  }
}
