## Workflow (Quy trình)

### Bước 1: Layer Definition

```typescript
// Define Clean Architecture layers
interface Layer {
  name: string;
  level: number; // Distance from center
  components: Component[];
  allowed_dependencies: string[]; // Layers this can depend on
  purpose: string;
}

const LAYERS: Layer[] = [
  {
    name: 'Entities',
    level: 1,
    components: [],
    allowed_dependencies: [], // No dependencies on other layers
    purpose: 'Enterprise-wide business rules'
  },
  {
    name: 'UseCases',
    level: 2,
    components: [],
    allowed_dependencies: ['Entities'],
    purpose: 'Application-specific business rules'
  },
  {
    name: 'InterfaceAdapters',
    level: 3,
    components: [],
    allowed_dependencies: ['UseCases', 'Entities'],
    purpose: 'Adapters that convert data formats'
  },
  {
    name: 'FrameworksAndDrivers',
    level: 4,
    components: [],
    allowed_dependencies: ['InterfaceAdapters'],
    purpose: 'Frameworks, databases, external services'
  }
];

// Dependency Rule: Dependencies can only point inward
// FrameworksAndDrivers -> InterfaceAdapters -> UseCases -> Entities
```

### Bước 2: Component Design

```typescript
// Entity Layer - Enterprise Business Rules
// These are the core business rules that should be reusable across applications

namespace Domain.Entities {
  // Entity: Object with identity
  class Order {
    private readonly id: OrderId;
    private customerId: CustomerId;
    private items: OrderItem[];
    private status: OrderStatus;
    private createdAt: Date;
    
    constructor(id: OrderId, customerId: CustomerId) {
      this.id = id;
      this.customerId = customerId;
      this.items = [];
      this.status = OrderStatus.DRAFT;
      this.createdAt = new Date();
    }
    
    // Business rules encapsulated in entity
    addItem(product: Product, quantity: number): void {
      if (this.status !== OrderStatus.DRAFT) {
        throw new DomainException('Cannot modify non-draft order');
      }
      this.items.push(new OrderItem(product, quantity));
    }
    
    submit(): void {
      if (this.items.length === 0) {
        throw new DomainException('Order must have at least one item');
      }
      this.status = OrderStatus.SUBMITTED;
    }
    
    getTotal(): Money {
      return this.items.reduce(
        (sum, item) => sum.add(item.getSubtotal()),
        Money.zero()
      );
    }
  }
  
  // Value Object: No identity, immutable
  class Money {
    constructor(
      private readonly amount: number,
      private readonly currency: Currency
    ) {
      if (amount < 0) {
        throw new DomainException('Money cannot be negative');
      }
    }
    
    add(other: Money): Money {
      this.assertSameCurrency(other);
      return new Money(this.amount + other.amount, this.currency);
    }
    
    isGreaterThan(other: Money): boolean {
      this.assertSameCurrency(other);
      return this.amount > other.amount;
    }
    
    private assertSameCurrency(other: Money): void {
      if (!this.currency.equals(other.currency)) {
        throw new DomainException('Currency mismatch');
      }
    }
  }
  
  // Value Object for identity
  class OrderId {
    constructor(private readonly value: string) {
      if (!value || value.trim().length === 0) {
        throw new DomainException('OrderId cannot be empty');
      }
    }
    
    equals(other: OrderId): boolean {
      return this.value === other.value;
    }
  }
}
```

### Bước 3: Use Cases

```typescript
// Application Layer - Use Cases
// Contains application-specific business rules

namespace Application.UseCases {
  // Input/Output boundaries
  interface InputPort<TInput> {}
  interface OutputPort<TOutput> {}
  
  // Use Case Interface
  interface UseCase<TInput extends InputPort<any>, TOutput extends OutputPort<any>> {
    execute(input: TInput): Promise<TOutput>;
  }
  
  // Concrete Use Cases
  class CreateOrderUseCase implements UseCase<CreateOrderInput, CreateOrderOutput> {
    constructor(
      private readonly orderRepository: IOrderRepository,
      private readonly eventDispatcher: IEventDispatcher,
      private readonly output: CreateOrderOutputPort
    ) {}
    
    async execute(input: CreateOrderInput): Promise<CreateOrderOutput> {
      // 1. Create domain object
      const customerId = new CustomerId(input.customerId);
      const order = Order.create(customerId);
      
      // 2. Add items (business logic in domain)
      for (const item of input.items) {
        const product = await this.productRepository.findById(item.productId);
        if (!product) {
          return this.output.failure('Product not found');
        }
        order.addItem(product, item.quantity);
      }
      
      // 3. Persist
      await this.orderRepository.save(order);
      
      // 4. Dispatch domain events
      await this.eventDispatcher.dispatch(order.getEvents());
      
      // 5. Return result
      return this.output.success({
        orderId: order.id.value,
        total: order.getTotal()
      });
    }
  }
  
  class GetOrderUseCase implements UseCase<GetOrderInput, GetOrderOutput> {
    constructor(
      private readonly orderRepository: IOrderRepository
    ) {}
    
    async execute(input: GetOrderInput): Promise<GetOrderOutput> {
      const order = await this.orderRepository.findById(new OrderId(input.orderId));
      
      if (!order) {
        return this.output.notFound(input.orderId);
      }
      
      return this.output.success(order.toDTO());
    }
  }
}

// Input/Output DTOs
interface CreateOrderInput extends InputPort<CreateOrderInput> {
  customerId: string;
  items: { productId: string; quantity: number }[];
}

interface CreateOrderOutput extends OutputPort<CreateOrderOutput> {
  orderId: string;
  total: { amount: number; currency: string };
}
```

### Bước 4: Interface Adapters

```typescript
// Interface Adapters Layer
// Contains presenters, gateways, controllers

namespace Adapters.Gateways {
  // Repository interfaces (belong to use cases)
  interface IOrderRepository {
    findById(id: OrderId): Promise<Order | null>;
    findByCustomerId(customerId: CustomerId): Promise<Order[]>;
    save(order: Order): Promise<void>;
    delete(id: OrderId): Promise<void>;
  }
  
  interface IProductRepository {
    findById(id: ProductId): Promise<Product | null>;
  }
  
  interface ICustomerRepository {
    findById(id: CustomerId): Promise<Customer | null>;
  }
}

namespace Adapters.Presenters {
  // Output ports for use cases
  interface CreateOrderOutputPort {
    success(data: { orderId: string; total: Money }): Promise<CreateOrderResponse>;
    failure(error: string): Promise<CreateOrderResponse>;
  }
  
  // Presenter implementation
  class CreateOrderPresenter implements CreateOrderOutputPort {
    private response: CreateOrderResponse | null = null;
    private error: string | null = null;
    
    async success(data: { orderId: string; total: Money }): Promise<CreateOrderResponse> {
      this.response = {
        orderId: data.orderId,
        totalAmount: data.total.amount,
        currency: data.total.currency,
        success: true
      };
      return this.response;
    }
    
    async failure(error: string): Promise<CreateOrderResponse> {
      this.error = error;
      return {
        success: false,
        error
      };
    }
  }
}

namespace Adapters.Controllers {
  // Controllers handle HTTP
  class OrderController {
    constructor(
      private readonly createOrderUseCase: CreateOrderUseCase,
      private readonly getOrderUseCase: GetOrderUseCase
    ) {}
    
    async createOrder(req: HttpRequest): Promise<HttpResponse> {
      try {
        const input: CreateOrderInput = {
          customerId: req.body.customerId,
          items: req.body.items
        };
        
        const presenter = new CreateOrderPresenter();
        const useCase = new CreateOrderUseCase(
          this.orderRepository,
          this.eventDispatcher,
          presenter
        );
        
        await useCase.execute(input);
        return presenter.response;
      } catch (error) {
        return { status: 500, body: { error: error.message } };
      }
    }
  }
}
```

### Bước 5: Infrastructure Implementation

```typescript
// Frameworks & Drivers Layer
// Contains concrete implementations

namespace Infrastructure.Persistence {
  // Database implementation
  class PostgresOrderRepository implements IOrderRepository {
    constructor(
      private readonly db: IDatabaseConnection
    ) {}
    
    async findById(id: OrderId): Promise<Order | null> {
      const result = await this.db.query(
        'SELECT * FROM orders WHERE id = $1',
        [id.value]
      );
      
      if (result.rows.length === 0) return null;
      
      return this.reconstitute(result.rows[0]);
    }
    
    async save(order: Order): Promise<void> {
      await this.db.transaction(async tx => {
        await tx.execute(
          `INSERT INTO orders (id, customer_id, status, created_at)
           VALUES ($1, $2, $3, $4)
           ON CONFLICT (id) DO UPDATE SET
             status = EXCLUDED.status`,
          [order.id.value, order.customerId.value, order.status, order.createdAt]
        );
        
        // Save items
        for (const item of order.items) {
          await tx.execute(
            `INSERT INTO order_items (order_id, product_id, quantity, price)
             VALUES ($1, $2, $3, $4)`,
            [order.id.value, item.productId.value, item.quantity, item.price]
          );
        }
      });
    }
    
    private reconstitute(data: any): Order {
      const order = new Order(new OrderId(data.id), new CustomerId(data.customer_id));
      // Reconstruct full state
      return order;
    }
  }
}

namespace Infrastructure.External {
  // External service implementations
  class StripePaymentGateway implements IPaymentGateway {
    constructor(
      private readonly stripeClient: StripeClient,
      private readonly eventDispatcher: IEventDispatcher
    ) {}
    
    async charge(customerId: CustomerId, amount: Money): Promise<PaymentResult> {
      try {
        const charge = await this.stripeClient.charges.create({
          amount: amount.amount,
          currency: amount.currency.value,
          customer: customerId.value
        });
        
        return {
          success: true,
          transactionId: charge.id,
          amount
        };
      } catch (error) {
        return {
          success: false,
          error: error.message
        };
      }
    }
  }
}
```

### Bước 6: Dependency Injection

```typescript
// Composition Root - Wire everything together
namespace Infrastructure.CompositionRoot {
  class Container {
    private services = new Map();
    
    register<T>(interfaceType: new (...args: any[]) => T, implementation: T): void {
      this.services.set(interfaceType.name, implementation);
    }
    
    resolve<T>(interfaceType: new (...args: any[]) => T): T {
      return this.services.get(interfaceType.name);
    }
  }
  
  function configureApplication(container: Container): void {
    // Infrastructure
    const dbConnection = new PostgresConnection('connection-string');
    const eventDispatcher = new InMemoryEventDispatcher();
    
    // Repositories
    container.register(IOrderRepository, new PostgresOrderRepository(dbConnection));
    container.register(IProductRepository, new PostgresProductRepository(dbConnection));
    container.register(ICustomerRepository, new PostgresCustomerRepository(dbConnection));
    
    // External services
    container.register(IPaymentGateway, new StripePaymentGateway(stripeClient, eventDispatcher));
    container.register(IEmailGateway, new SendGridEmailGateway(sendGridClient));
    
    // Use Cases
    container.register(
      CreateOrderUseCase,
      new CreateOrderUseCase(
        container.resolve(IOrderRepository),
        container.resolve(IProductRepository),
        eventDispatcher
      )
    );
    
    container.register(
      GetOrderUseCase,
      new GetOrderUseCase(
        container.resolve(IOrderRepository)
      )
    );
  }
  
  // Build application
  const container = new Container();
  configureApplication(container);
  
  // Create controllers with resolved dependencies
  const orderController = new OrderController(
    container.resolve(CreateOrderUseCase),
    container.resolve(GetOrderUseCase)
  );
}
```

## Checklist (Danh sách kiểm tra)

- [ ] Entities contain no framework dependencies
- [ ] Use cases are framework-agnostic
- [ ] Dependencies point inward only
- [ ] Interfaces defined at appropriate layers
- [ ] Dependency injection properly configured
- [ ] Frameworks are plugins, not core
- [ ] Business rules testable without database
- [ ] Use cases testable with mocks
- [ ] Controllers thin, delegating to use cases
- [ ] External services abstracted behind interfaces

