### Phase 4: Infrastructure Layer

### Bước 6: Repository Implementations

```typescript
// infrastructure/persistence/repositories/OrderRepository.ts
export class OrderRepository implements IOrderRepository {
  constructor(
    private db: DatabaseContext,
    private mapper: OrderMapper
  ) {}
  
  async findById(id: OrderId): Promise<OrderAggregate | null> {
    const result = await this.db.query(
      `SELECT * FROM orders WHERE id = $1`,
      [id.value]
    );
    
    if (result.rows.length === 0) {
      return null;
    }
    
    const orderData = result.rows[0];
    const itemsData = await this.db.query(
      `SELECT * FROM order_items WHERE order_id = $1`,
      [id.value]
    );
    
    return this.mapper.toDomain(orderData, itemsData.rows);
  }
  
  async findByCustomer(
    customerId: string,
    options: FindOrdersOptions
  ): Promise<OrderAggregate[]> {
    const { page, pageSize, status } = options;
    const offset = (page - 1) * pageSize;
    
    let query = `
      SELECT o.* FROM orders o
      WHERE o.customer_id = $1
    `;
    const params: any[] = [customerId];
    
    if (status) {
      query += ` AND o.status = $${params.length + 1}`;
      params.push(status);
    }
    
    query += ` ORDER BY o.created_at DESC LIMIT $${params.length + 1} OFFSET $${params.length + 2}`;
    params.push(pageSize, offset);
    
    const result = await this.db.query(query, params);
    return Promise.all(result.rows.map(row => this.findById(new OrderId(row.id))));
  }
  
  async save(order: OrderAggregate): Promise<void> {
    await this.db.transaction(async (tx) => {
      const { header, items } = this.mapper.toPersistence(order);
      
      await tx.query(
        `INSERT INTO orders (id, customer_id, status, total_amount, currency, created_at, updated_at)
         VALUES ($1, $2, $3, $4, $5, $6, $7)
         ON CONFLICT (id) DO UPDATE SET
           status = EXCLUDED.status,
           total_amount = EXCLUDED.total_amount,
           updated_at = EXCLUDED.updated_at`,
        [header.id, header.customerId, header.status, header.totalAmount, 
         header.currency, header.createdAt, header.updatedAt]
      );
      
      // Delete existing items and insert new
      await tx.query(`DELETE FROM order_items WHERE order_id = $1`, [header.id]);
      
      for (const item of items) {
        await tx.query(
          `INSERT INTO order_items (id, order_id, product_id, product_name, quantity, unit_price)
           VALUES ($1, $2, $3, $4, $5, $6)`,
          [item.id, header.id, item.productId, item.productName, item.quantity, item.unitPrice]
        );
      }
    });
  }
}
```

## Checklist

- [ ] Domain layer không phụ thuộc infrastructure
- [ ] Entities có identity rõ ràng
- [ ] Value Objects immutable
- [ ] Aggregates define boundaries
- [ ] Repository interfaces trong domain
- [ ] Use cases là entry point
- [ ] Dependency injection configured
- [ ] Domain events được publish
- [ ] Unit of Work pattern implemented
- [ ] CQRS cho complex domains

## Examples (Ví dụ)

### Ví dụ: Dependency Injection Setup

```typescript
// infrastructure/di/container.ts
const container = new Container();

// Domain - no dependencies
container.registerSingleton('IOrderRepository', OrderRepository);
container.registerSingleton('IProductRepository', ProductRepository);

// Application
container.registerTransient(
  'CreateOrderHandler',
  CreateOrderHandler,
  ['IOrderRepository', 'IProductRepository', 'IPaymentService', 'IEventBus', 'IUnitOfWork']
);

// Infrastructure
container.registerSingleton('IPaymentService', StripePaymentGateway);
container.registerSingleton('IEmailService', SendGridEmailService);
container.registerSingleton('IEventBus', RabbitMQEventBus);
```

### Ví dụ: Testing Domain Logic

```typescript
describe('OrderAggregate', () => {
  describe('addItem', () => {
    it('should add item and recalculate total', () => {
      const order = OrderAggregate.create({
        customerId: 'customer-1',
        items: [],
        currency: 'USD'
      });
      
      order.addItem({
        productId: 'product-1',
        productName: 'Widget',
        quantity: 2,
        unitPrice: Money.of(10, 'USD')
      });
      
      expect(order.totalAmount.amount).toBe(2000); // $20 in cents
      expect(order.props.items).toHaveLength(1);
    });
    
    it('should throw when adding to confirmed order', () => {
      const order = OrderAggregate.create({...});
      order.confirm();
      
      expect(() => order.addItem({...})).toThrow(InvalidOperationException);
    });
  });
});
```

## Anti Pattern

- [ ] **Anemic Domain Model**: Objects chỉ có getters/setters
- [ ] **Anemic Domain Model**: Business logic trong services
- [ ] **Tight Coupling**: Domain phụ thuộc infrastructure
- [ ] **God Objects**: Quá nhiều responsibility
- [ ] **Anemic Domain Model**: Không có invariants
- [ ] **Anemic Domain Model**: Validation trong application

## Best Practice

- [ ] **Rich Domain Model**: Business logic trong entities
- [ ] **Clear Boundaries**: Aggregates define consistency
- [ ] **Dependency Rule**: Dependencies chỉ inward
- [ ] **Immutable Value Objects**: Không có side effects
- [ ] **Domain Events**: Loose coupling
- [ ] **CQRS**: Separate read và write models

