### Phase 2: Domain Layer Implementation

### Bước 3: Entities và Aggregates

```typescript
// domain/entities/User.ts
import { Entity } from '../base/Entity';
import { Email } from '../value-objects/Email';
import { UserId } from '../value-objects/UserId';

interface UserProps {
  email: Email;
  name: string;
  createdAt: Date;
  updatedAt: Date;
}

export class User extends Entity<UserId, UserProps> {
  get email(): Email {
    return this.props.email;
  }
  
  get name(): string {
    return this.props.name;
  }
  
  get createdAt(): Date {
    return this.props.createdAt;
  }
  
  // Business methods
  updateName(newName: string): void {
    if (!newName || newName.trim().length === 0) {
      throw new DomainException('Name cannot be empty');
    }
    this.props.name = newName.trim();
    this.props.updatedAt = new Date();
  }
  
  updateEmail(newEmail: Email): void {
    if (!newEmail.equals(this.props.email)) {
      this.props.email = newEmail;
      this.props.updatedAt = new Date();
      this.addDomainEvent(new UserEmailChangedEvent(this.id, newEmail));
    }
  }
}

// domain/aggregates/OrderAggregate.ts
import { AggregateRoot } from '../base/AggregateRoot';
import { OrderId } from '../value-objects/OrderId';
import { Money } from '../value-objects/Money';
import { OrderStatus } from '../enums/OrderStatus';

interface OrderItemProps {
  productId: string;
  productName: string;
  quantity: number;
  unitPrice: Money;
}

interface OrderProps {
  customerId: string;
  items: OrderItemProps[];
  status: OrderStatus;
  totalAmount: Money;
  shippingAddress: Address;
  createdAt: Date;
  updatedAt: Date;
}

export class OrderAggregate extends AggregateRoot<OrderId, OrderProps> {
  get customerId(): string {
    return this.props.customerId;
  }
  
  get status(): OrderStatus {
    return this.props.status;
  }
  
  get totalAmount(): Money {
    return this.props.totalAmount;
  }
  
  // Factory method
  static create(props: CreateOrderProps): OrderAggregate {
    const order = new OrderAggregate({
      ...props,
      status: OrderStatus.PENDING,
      totalAmount: Money.zero(props.currency),
      createdAt: new Date(),
      updatedAt: new Date()
    });
    
    order.calculateTotal();
    order.addDomainEvent(new OrderCreatedEvent(order));
    
    return order;
  }
  
  // Business methods
  addItem(item: OrderItemProps): void {
    if (this.props.status !== OrderStatus.PENDING) {
      throw new InvalidOperationException('Cannot add items to confirmed order');
    }
    
    this.props.items.push(item);
    this.calculateTotal();
    this.addDomainEvent(new OrderItemAddedEvent(this.id, item));
  }
  
  removeItem(productId: string): void {
    if (this.props.status !== OrderStatus.PENDING) {
      throw new InvalidOperationException('Cannot remove items from confirmed order');
    }
    
    const index = this.props.items.findIndex(i => i.productId === productId);
    if (index === -1) {
      throw new DomainException('Item not found in order');
    }
    
    this.props.items.splice(index, 1);
    this.calculateTotal();
  }
  
  confirm(): void {
    if (this.props.items.length === 0) {
      throw new InvalidOrderException('Cannot confirm empty order');
    }
    
    this.props.status = OrderStatus.CONFIRMED;
    this.props.updatedAt = new Date();
    this.addDomainEvent(new OrderConfirmedEvent(this.id));
  }
  
  cancel(reason: string): void {
    if ([OrderStatus.SHIPPED, OrderStatus.DELIVERED].includes(this.props.status)) {
      throw new InvalidOperationException('Cannot cancel shipped or delivered order');
    }
    
    this.props.status = OrderStatus.CANCELED;
    this.props.updatedAt = new Date();
    this.addDomainEvent(new OrderCanceledEvent(this.id, reason));
  }
  
  private calculateTotal(): void {
    const total = this.props.items.reduce(
      (sum, item) => sum.add(item.unitPrice.multiply(item.quantity)),
      Money.zero('USD')
    );
    this.props.totalAmount = total;
  }
}
```

### Bước 4: Value Objects

```typescript
// domain/value-objects/Money.ts
export class Money {
  private constructor(
    public readonly amount: number,
    public readonly currency: string
  ) {
    // Validate: amount should be stored in cents to avoid floating point issues
    if (!Number.isInteger(amount)) {
      throw new DomainException('Money amount must be in cents (integer)');
    }
  }
  
  static of(dollars: number, currency: string): Money {
    return new Money(Math.round(dollars * 100), currency);
  }
  
  static fromCents(cents: number, currency: string): Money {
    return new Money(cents, currency);
  }
  
  static zero(currency: string): Money {
    return new Money(0, currency);
  }
  
  add(other: Money): Money {
    this.ensureSameCurrency(other);
    return new Money(this.amount + other.amount, this.currency);
  }
  
  subtract(other: Money): Money {
    this.ensureSameCurrency(other);
    return new Money(this.amount - other.amount, this.currency);
  }
  
  multiply(factor: number): Money {
    return new Money(Math.round(this.amount * factor), this.currency);
  }
  
  equals(other: Money): boolean {
    return this.amount === other.amount && this.currency === other.currency;
  }
  
  isGreaterThan(other: Money): boolean {
    this.ensureSameCurrency(other);
    return this.amount > other.amount;
  }
  
  isLessThan(other: Money): boolean {
    this.ensureSameCurrency(other);
    return this.amount < other.amount;
  }
  
  format(): string {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: this.currency
    }).format(this.amount / 100);
  }
  
  private ensureSameCurrency(other: Money): void {
    if (this.currency !== other.currency) {
      throw new DomainException(
        `Cannot operate on different currencies: ${this.currency} and ${other.currency}`
      );
    }
  }
}

// domain/value-objects/Email.ts
export class Email {
  private readonly _value: string;
  
  private constructor(value: string) {
    this._value = value.toLowerCase().trim();
  }
  
  static create(value: string): Email {
    if (!Email.isValid(value)) {
      throw new DomainException('Invalid email format');
    }
    return new Email(value);
  }
  
  static isValid(value: string): boolean {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return emailRegex.test(value);
  }
  
  get value(): string {
    return this._value;
  }
  
  equals(other: Email): boolean {
    return this._value === other._value;
  }
  
  toString(): string {
    return this._value;
  }
}
