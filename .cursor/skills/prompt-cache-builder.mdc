## Workflow (Quy trình)

### Bước 1: Cache Initialization

```typescript
// Khởi tạo cache storage và configuration
interface PromptCacheConfig {
  backend: 'memory' | 'redis' | 'dynamodb' | 'sqlite';
  embedding_model: string;
  similarity_threshold: number;
  ttl_seconds: number;
  max_entries: number;
  token_budget: number;
}

class PromptCache {
  private vectorIndex: VectorIndex;
  private exactIndex: Map<string, CachedResponse>;
  private stats: CacheStatistics;
  
  constructor(config: PromptCacheConfig) {
    this.vectorIndex = new VectorIndex(config.embedding_model);
    this.exactIndex = new Map();
    this.stats = {
      hits: 0,
      misses: 0,
      tokens_saved: 0,
      latency_saved_ms: 0
    };
  }
  
  async initialize(historicalInteractions: Interaction[]): Promise<void> {
    // Pre-populate cache từ history
    for (const interaction of historicalInteractions) {
      await this.add(interaction.prompt, interaction.response);
    }
  }
}
```

### Bước 2: Prompt Fingerprinting

```typescript
// Tạo fingerprint cho prompt để enable exact và semantic matching
interface PromptFingerprint {
  exact_hash: string;        // SHA-256 của normalized prompt
  semantic_vector: number[]; // Embedding vector
  template_id: string;       // ID của template (nếu là template-based)
  variables: Record<string, any>; // Extracted variables
  version: string;           // Prompt version
}

function fingerprint(prompt: string, config: CacheConfig): PromptFingerprint {
  // Normalize: lowercase, trim, remove extra whitespace
  const normalized = normalizePrompt(prompt);
  
  return {
    exact_hash: crypto.createHash('sha256').update(normalized).digest('hex'),
    semantic_vector: await embed(normalized, config.embedding_model),
    template_id: detectTemplate(normalized),
    variables: extractVariables(prompt),
    version: detectVersion(prompt)
  };
}

function normalizePrompt(prompt: string): string {
  return prompt
    .toLowerCase()
    .trim()
    .replace(/\s+/g, ' ')
    .replace(/[^\w\s.,!?-]/g, '');
}
```

### Bước 3: Cache Lookup

```typescript
// Lookup cache với cả exact và semantic matching
interface CacheLookupResult {
  status: 'HIT' | 'MISS' | 'PARTIAL';
  response?: CachedResponse;
  similarity?: number;
  alternatives?: CachedResponse[];
}

async function lookup(
  prompt: string,
  context?: Record<string, any>
): Promise<CacheLookupResult> {
  const fp = fingerprint(prompt, this.config);
  
  // 1. Exact match lookup (O(1))
  const exactMatch = this.exactIndex.get(fp.exact_hash);
  if (exactMatch && !this.isExpired(exactMatch)) {
    this.stats.hits++;
    return { status: 'HIT', response: exactMatch };
  }
  
  // 2. Template-based lookup (for template prompts)
  if (fp.template_id) {
    const templateMatches = await this.lookupByTemplate(fp);
    if (templateMatches.length > 0) {
      return { 
        status: 'HIT', 
        response: templateMatches[0],
        alternatives: templateMatches.slice(1, 4)
      };
    }
  }
  
  // 3. Semantic similarity search
  const semanticMatches = await this.vectorIndex.search(
    fp.semantic_vector,
    { threshold: this.config.similarity_threshold, limit: 5 }
  );
  
  if (semanticMatches.length > 0) {
    const best = semanticMatches[0];
    if (best.similarity >= this.config.similarity_threshold) {
      return {
        status: 'PARTIAL',
        response: best.response,
        similarity: best.similarity,
        alternatives: semanticMatches.slice(1, 3)
      };
    }
  }
  
  return { status: 'MISS' };
}
```

### Bước 4: Cache Storage

```typescript
// Lưu trữ response vào cache
async function add(
  prompt: string,
  response: LLMResponse,
  metadata?: CacheMetadata
): Promise<void> {
  const fp = fingerprint(prompt, this.config);
  
  // Check token budget
  await this.enforceTokenBudget(response.usage.total_tokens);
  
  const cacheEntry: CachedResponse = {
    prompt_fingerprint: fp,
    response: response.content,
    usage: response.usage,
    timestamp: Date.now(),
    ttl: this.config.ttl_seconds,
    hit_count: 0,
    last_accessed: Date.now(),
    metadata: metadata || {}
  };
  
  // Store in exact index
  this.exactIndex.set(fp.exact_hash, cacheEntry);
  
  // Store in vector index for semantic search
  await this.vectorIndex.add(
    fp.semantic_vector,
    cacheEntry,
    fp.exact_hash
  );
  
  // Store template-based entry
  if (fp.template_id) {
    await this.storeTemplateEntry(fp, cacheEntry);
  }
}

async function enforceTokenBudget(newTokens: number): Promise<void> {
  const currentUsage = await this.getTokenUsage();
  const budget = this.config.token_budget;
  
  if (currentUsage + newTokens > budget) {
    // Evict LRU entries
    const toEvict = await this.selectEvictionCandidates(
      newTokens - (budget - currentUsage)
    );
    
    for (const candidate of toEvict) {
      await this.evict(candidate);
    }
  }
}
```

### Bước 5: Cache Warming

```typescript
// Prefetch common prompts dựa trên usage patterns
interface WarmingStrategy {
  type: 'frequency' | 'recency' | 'prediction' | 'hybrid';
  batch_size: number;
  priority: 'high' | 'medium' | 'low';
}

async function warmCache(
  interactions: Interaction[],
  strategy: WarmingStrategy
): Promise<WarmingReport> {
  const candidates = this.rankCandidates(interactions, strategy);
  const warmed: string[] = [];
  const skipped: string[] = [];
  
  for (const candidate of candidates.slice(0, strategy.batch_size)) {
    if (!await this.has(candidate.prompt)) {
      try {
        const response = await this.llm.complete(candidate.prompt);
        await this.add(candidate.prompt, response);
        warmed.push(candidate.prompt);
      } catch (error) {
        skipped.push(candidate.prompt);
      }
    }
  }
  
  return {
    warmed_count: warmed.length,
    skipped_count: skipped.length,
    warmed_prompts: warmed,
    skipped_prompts: skipped
  };
}

function rankCandidates(
  interactions: Interaction[],
  strategy: WarmingStrategy
): RankedCandidate[] {
  const frequencyMap = countByPrompt(interactions);
  
  return Object.entries(frequencyMap)
    .map(([prompt, count]) => ({
      prompt,
      frequency: count,
      recency: getLastUsed(prompt, interactions),
      score: calculateScore(count, recency, strategy)
    }))
    .sort((a, b) => b.score - a.score);
}
```

### Bước 6: Invalidation Management

```typescript
// Xử lý cache invalidation
interface InvalidationRule {
  type: 'ttl' | 'manual' | 'semantic' | 'dependency';
  condition: (entry: CachedResponse) => boolean;
  action: 'evict' | 'refresh' | 'mark_stale';
}

class InvalidationManager {
  private rules: InvalidationRule[] = [];
  
  addRule(rule: InvalidationRule): void {
    this.rules.push(rule);
  }
  
  async processInvalidations(): Promise<InvalidationReport> {
    const evicted: string[] = [];
    const refreshed: string[] = [];
    
    for (const [hash, entry] of this.cache.exactIndex) {
      for (const rule of this.rules) {
        if (rule.condition(entry)) {
          switch (rule.action) {
            case 'evict':
              await this.cache.evict(hash);
              evicted.push(hash);
              break;
            case 'refresh':
              await this.cache.refresh(hash);
              refreshed.push(hash);
              break;
            case 'mark_stale':
              entry.metadata.stale = true;
              break;
          }
        }
      }
    }
    
    return { evicted, refreshed };
  }
}

// Common invalidation rules
const commonRules: InvalidationRule[] = [
  {
    type: 'ttl',
    condition: (e) => Date.now() - e.timestamp > e.ttl * 1000,
    action: 'evict'
  },
  {
    type: 'dependency',
    condition: (e) => dependsOnStaleResource(e),
    action: 'mark_stale'
  },
  {
    type: 'semantic',
    condition: (e) => isOutdatedSemantic(e),
    action: 'refresh'
  }
];
```

