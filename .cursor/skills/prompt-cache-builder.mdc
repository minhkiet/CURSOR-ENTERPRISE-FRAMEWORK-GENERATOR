## Examples (Ví dụ)

### Ví dụ 1: Basic Cache Usage

```typescript
// Sử dụng prompt cache trong LLM client
class CachedLLMClient {
  private cache: PromptCache;
  private llm: LLMProvider;
  
  async complete(
    prompt: string,
    options?: CompletionOptions
  ): Promise<CompletionResponse> {
    // Check cache first
    const cached = await this.cache.lookup(prompt);
    
    if (cached.status === 'HIT') {
      console.log(`Cache HIT for prompt: ${cached.response}`);
      return {
        ...cached.response,
        cached: true,
        cache_hit: true
      };
    }
    
    if (cached.status === 'PARTIAL') {
      console.log(`Cache PARTIAL (${cached.similarity})`);
      // Use cached response với modifications
      return this.adaptCachedResponse(cached);
    }
    
    // Cache miss - call LLM
    console.log('Cache MISS - calling LLM');
    const response = await this.llm.complete(prompt, options);
    
    // Store in cache
    await this.cache.add(prompt, response);
    
    return {
      ...response,
      cached: false
    };
  }
}

// Usage
const client = new CachedLLMClient({
  backend: 'redis',
  embedding_model: 'text-embedding-3-small',
  similarity_threshold: 0.95
});

const response = await client.complete(
  'Explain async/await in JavaScript'
);
```

