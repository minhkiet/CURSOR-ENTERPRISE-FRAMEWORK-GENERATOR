### Bước 7: ADR Management

```typescript
// ADR Registry
interface ADRRegistry {
  id: string;
  title: string;
  status: 'proposed' | 'accepted' | 'deprecated' | 'superseded';
  createdAt: Date;
  updatedAt: Date;
  supersededBy?: string;
  relatedADRs: string[];
}

// ADR Service
class ADRService {
  async createDraft(data: CreateADRInput): Promise<ADR> {
    const adr = await this.adrRepo.create({
      ...data,
      status: 'proposed',
      createdAt: new Date()
    });
    
    await this.notifyReviewers(adr);
    return adr;
  }
  
  async accept(adrId: string, decision: string): Promise<ADR> {
    const adr = await this.adrRepo.findById(adrId);
    
    if (adr.status !== 'proposed') {
      throw new Error('Can only accept proposed ADRs');
    }
    
    return this.adrRepo.update(adrId, {
      status: 'accepted',
      decision,
      acceptedAt: new Date()
    });
  }
  
  async deprecate(adrId: string, reason: string): Promise<ADR> {
    return this.adrRepo.update(adrId, {
      status: 'deprecated',
      deprecatedReason: reason,
      deprecatedAt: new Date()
    });
  }
  
  async supersede(adrId: string, newAdrId: string): Promise<ADR> {
    const adr = await this.adrRepo.findById(adrId);
    const newAdr = await this.adrRepo.findById(newAdrId);
    
    return this.adrRepo.update(adrId, {
      status: 'superseded',
      supersededBy: newAdrId,
      supersededAt: new Date()
    });
  }
  
  async getRelatedADRs(adrId: string): Promise<ADR[]> {
    const adr = await this.adrRepo.findById(adrId);
    return this.adrRepo.findByIds(adr.relatedADRs);
  }
}
```

