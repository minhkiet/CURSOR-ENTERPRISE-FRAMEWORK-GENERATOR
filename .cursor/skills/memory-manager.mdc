### Bước 5: Context Summarization

```typescript
// Context Summarization for Long Conversations
class ContextSummarizer {
  async summarize(conversation: Message[]): Promise<Summary> {
    // Extract key points
    const keyPoints = this.extractKeyPoints(conversation);
    
    // Identify decisions made
    const decisions = this.extractDecisions(conversation);
    
    // Extract code changes
    const codeChanges = this.extractCodeChanges(conversation);
    
    // Identify open questions
    const openQuestions = this.extractQuestions(conversation);
    
    // Generate summary
    return {
      overview: this.generateOverview(keyPoints),
      decisions,
      codeChanges,
      openQuestions,
      nextSteps: this.suggestNextSteps(conversation),
      createdAt: new Date()
    };
  }
  
  private extractKeyPoints(messages: Message[]): string[] {
    // Use LLM or heuristics to extract key points
    const points: string[] = [];
    
    for (const msg of messages) {
      if (msg.type === 'decision') {
        points.push(`Decision: ${msg.content}`);
      } else if (msg.type === 'architecture') {
        points.push(`Architecture: ${msg.content}`);
      } else if (msg.type === 'important') {
        points.push(msg.content);
      }
    }
    
    return [...new Set(points)];
  }
  
  private extractDecisions(messages: Message[]): Decision[] {
    return messages
      .filter(m => m.type === 'decision')
      .map(m => ({
        id: m.metadata?.decisionId,
        description: m.content,
        rationale: m.metadata?.rationale,
        decidedAt: m.timestamp
      }));
  }
}

// Example summary output
interface Summary {
  overview: string;
  decisions: Decision[];
  codeChanges: CodeChange[];
  openQuestions: string[];
  nextSteps: string[];
  createdAt: Date;
}
