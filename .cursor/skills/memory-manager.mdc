### Bước 6: Memory Retrieval

```typescript
// Intelligent Memory Retrieval
class MemoryRetriever {
  constructor(
    private memoryStore: MemoryStore,
    private embeddingService: EmbeddingService
  ) {}
  
  async retrieve(query: string, context: RetrievalContext): Promise<RetrievalResult> {
    // 1. Exact keyword match
    const exactMatches = await this.memoryStore.search(query);
    
    // 2. Semantic search (embeddings)
    const semanticMatches = await this.embeddingService.search(query, {
      limit: 5,
      threshold: 0.7
    });
    
    // 3. Filter by context
    const filtered = this.filterByContext(
      [...exactMatches, ...semanticMatches],
      context
    );
    
    // 4. Rank by relevance
    const ranked = this.rankByRelevance(filtered, query, context);
    
    // 5. Deduplicate
    const deduplicated = this.deduplicate(ranked);
    
    return {
      memories: deduplicated.slice(0, 10),
      query,
      context,
      retrievedAt: new Date()
    };
  }
  
  private filterByContext(memories: Memory[], context: RetrievalContext): Memory[] {
    return memories.filter(m => {
      // Filter by project
      if (context.projectId && !m.tags.includes(context.projectId)) {
        return false;
      }
      
      // Filter by type
      if (context.types && !context.types.includes(m.type)) {
        return false;
      }
      
      // Filter by recency
      if (context.maxAge) {
        const maxDate = new Date(Date.now() - context.maxAge);
        if (m.updatedAt < maxDate) {
          return false;
        }
      }
      
      return true;
    });
  }
  
  private rankByRelevance(memories: Memory[], query: string, context: RetrievalContext): Memory[] {
    return memories.sort((a, b) => {
      let scoreA = a.importance;
      let scoreB = b.importance;
      
      // Boost by keyword match
      if (a.content.includes(query)) scoreA += 10;
      if (b.content.includes(query)) scoreB += 10;
      
      // Boost by recency
      const recencyA = this.calculateRecencyScore(a.updatedAt);
      const recencyB = this.calculateRecencyScore(b.updatedAt);
      scoreA += recencyA;
      scoreB += recencyB;
      
      return scoreB - scoreA;
    });
  }
}
```

### Bước 7: Memory Persistence

```typescript
// Memory Persistence Across Sessions
class MemoryPersistence {
  async saveSession(session: Session): Promise<void> {
    const summary = await this.summarizer.summarize(session.messages);
    
    // Save working memory
    await this.memoryStore.save({
      id: `session:${session.id}`,
      type: MemoryType.WORKING,
      content: JSON.stringify({
        summary,
        context: session.workingMemory.getAll(),
        files: session.modifiedFiles,
        decisions: session.decisions
      }),
      importance: MemoryImportance.MEDIUM,
      tags: ['session', session.projectId],
      expiresAt: new Date(Date.now() + 30 * 24 * 60 * 60 * 1000) // 30 days
    });
  }
  
  async restoreSession(projectId: string): Promise<Session | null> {
    const memories = await this.memoryStore.search('', {
      type: MemoryType.WORKING,
      tags: ['session', projectId]
    });
    
    if (memories.length === 0) return null;
    
    // Get most recent session
    const mostRecent = memories.sort((a, b) => 
      b.updatedAt.getTime() - a.updatedAt.getTime()
    )[0];
    
    return JSON.parse(mostRecent.content);
  }
}

// Memory GC - Cleanup old memories
class MemoryGC {
  async cleanup(): Promise<number> {
    const now = new Date();
    
    const result = await this.memoryStore.db.run(`
      DELETE FROM memories 
      WHERE expires_at IS NOT NULL 
        AND expires_at < ?
    `, [now]);
    
    return result.changes;
  }
}
```

