### Phase 1: Memory Types

### Bước 1: Memory Categories

```typescript
// Memory Types
enum MemoryType {
  WORKING = 'working',         // Current task context
  PROJECT = 'project',         // Project-level knowledge
  ARCHITECTURE = 'architecture', // Technical decisions
  USER = 'user',              // User preferences
  TEAM = 'team',              // Team conventions
  DOMAIN = 'domain',           // Domain knowledge
  TECHNICAL = 'technical',     // Technical specifications
  ONGOING = 'ongoing'          // Work in progress
}

interface Memory {
  id: string;
  type: MemoryType;
  content: string;
  importance: number;  // 1-10
  createdAt: Date;
  updatedAt: Date;
  expiresAt?: Date;
  tags: string[];
  source: 'user' | 'ai' | 'system';
}

// Memory Importance Levels
const MemoryImportance = {
  CRITICAL: 10,    // Must remember (auth, security)
  HIGH: 8,        // Very important
  MEDIUM: 5,      // Normal importance
  LOW: 2          // Nice to remember
};
```

### Bước 2: Memory Storage

```typescript
// Memory Storage Interface
interface MemoryStore {
  save(memory: Memory): Promise<void>;
  update(id: string, content: string): Promise<void>;
  delete(id: string): Promise<void>;
  get(id: string): Promise<Memory | null>;
  search(query: string, filters?: MemoryFilters): Promise<Memory[]>;
  getByType(type: MemoryType): Promise<Memory[]>;
  getRecent(limit: number): Promise<Memory[]>;
}

interface MemoryFilters {
  type?: MemoryType;
  tags?: string[];
  minImportance?: number;
  since?: Date;
  until?: Date;
}

// SQLite-based Memory Store
class SQLiteMemoryStore implements MemoryStore {
  private db: Database;
  
  async save(memory: Memory): Promise<void> {
    await this.db.run(`
      INSERT INTO memories (id, type, content, importance, tags, source, created_at, updated_at)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?)
    `, [
      memory.id,
      memory.type,
      memory.content,
      memory.importance,
      JSON.stringify(memory.tags),
      memory.source,
      memory.createdAt,
      memory.updatedAt
    ]);
  }
  
  async search(query: string, filters?: MemoryFilters): Promise<Memory[]> {
    let sql = 'SELECT * FROM memories WHERE 1=1';
    const params: any[] = [];
    
    if (query) {
      sql += ' AND content LIKE ?';
      params.push(`%${query}%`);
    }
    
    if (filters?.type) {
      sql += ' AND type = ?';
      params.push(filters.type);
    }
    
    if (filters?.minImportance) {
      sql += ' AND importance >= ?';
      params.push(filters.minImportance);
    }
    
    sql += ' ORDER BY importance DESC, updated_at DESC';
    
    return this.db.query(sql, params);
  }
}
```

### Phase 2: Context Management

### Bước 3: Working Memory

```typescript
// Working Memory (Current Session Context)
class WorkingMemory {
  private context: Map<string, any> = new Map();
  private history: Array<{ action: string; context: any; timestamp: Date }> = [];
  
  set(key: string, value: any): void {
    this.context.set(key, value);
    this.addHistory('set', { key, value });
  }
  
  get(key: string): any {
    return this.context.get(key);
  }
  
  delete(key: string): void {
    this.context.delete(key);
    this.addHistory('delete', { key });
  }
  
  clear(): void {
    this.context.clear();
    this.addHistory('clear', {});
  }
  
  getAll(): Record<string, any> {
    return Object.fromEntries(this.context);
  }
  
  getHistory(): Array<{ action: string; context: any; timestamp: Date }> {
    return this.history;
  }
  
  summarize(): string {
    const entries = Array.from(this.context.entries());
    if (entries.length === 0) return 'No active context';
    
    return entries
      .map(([key, value]) => `${key}: ${JSON.stringify(value)}`)
      .join('\n');
  }
  
  private addHistory(action: string, context: any): void {
    this.history.push({
      action,
      context,
      timestamp: new Date()
    });
  }
}
```

### Bước 4: Project Context

```typescript
// Project Context Management
interface ProjectContext {
  name: string;
  description: string;
  techStack: Technology[];
  architecture: ArchitectureSummary;
  conventions: Convention[];
  recentChanges: Change[];
  activeTasks: Task[];
  decisions: Decision[];
}

class ProjectContextManager {
  async load(projectPath: string): Promise<ProjectContext> {
    const config = await this.loadConfig(projectPath);
    const structure = await this.analyzeStructure(projectPath);
    const decisions = await this.loadDecisions(projectPath);
    
    return {
      name: config.name,
      description: config.description,
      techStack: this.extractTechStack(config),
      architecture: this.summarizeArchitecture(structure),
      conventions: this.loadConventions(projectPath),
      recentChanges: await this.getRecentChanges(projectPath),
      activeTasks: await this.getActiveTasks(projectPath),
      decisions
    };
  }
  
  async save(context: ProjectContext): Promise<void> {
    await this.memoryStore.save({
      id: `project:${context.name}`,
      type: MemoryType.PROJECT,
      content: JSON.stringify(context),
      importance: MemoryImportance.HIGH,
      tags: ['project', context.name],
      source: 'system'
    });
  }
  
  async getRelevant(projectPath: string, query: string): Promise<string> {
    const memories = await this.memoryStore.search(query, {
      tags: ['project', projectPath]
    });
    
    if (memories.length === 0) return '';
    
    return memories
      .map(m => `[${m.type}] ${m.content}`)
      .join('\n\n');
  }
}
```

