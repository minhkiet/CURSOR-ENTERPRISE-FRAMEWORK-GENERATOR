### Phase 3: Execution - Thực hiện

### Bước 6: Incremental Refactoring

```typescript
// Example: Refactoring OrderService to use Repository Pattern

// BEFORE (Tightly coupled)
class OrderService {
  async createOrder(data: OrderData) {
    // Direct database access
    const result = await this.db.query(
      'INSERT INTO orders VALUES ...'
    );
    await this.redis.set(`order:${result.id}`, JSON.stringify(result));
    return result;
  }
}

// AFTER (Repository Pattern + Dependency Injection)

// Step 1: Define Repository Interface
interface IOrderRepository {
  create(data: OrderData): Promise<Order>;
  findById(id: string): Promise<Order | null>;
  update(id: string, data: Partial<OrderData>): Promise<Order>;
}

// Step 2: Implement Repository
class PostgresOrderRepository implements IOrderRepository {
  constructor(private db: Database) {}
  
  async create(data: OrderData): Promise<Order> {
    const result = await this.db.query(
      'INSERT INTO orders VALUES ... RETURNING *',
      [data]
    );
    return result.rows[0];
  }
  
  async findById(id: string): Promise<Order | null> {
    const result = await this.db.query(
      'SELECT * FROM orders WHERE id = $1',
      [id]
    );
    return result.rows[0] || null;
  }
}

// Step 3: Update Service to Use Interface
class OrderService {
  constructor(private orderRepo: IOrderRepository) {}
  
  async createOrder(data: OrderData) {
    const order = await this.orderRepo.create(data);
    await this.cache.invalidate(`order:${order.id}`);
    return order;
  }
}

// Step 4: Wire up in DI container
container.bind<IOrderRepository>('IOrderRepository')
  .to(PostgresOrderRepository);
```

### Bước 7: Testing During Refactoring

```typescript
// Contract Testing for Refactoring Safety

// Define contract between consumer và provider
describe('OrderService Contract', () => {
  it('should maintain backward compatibility', async () => {
    // Old implementation
    const oldResult = await legacyOrderService.createOrder(testData);
    
    // New implementation
    const newResult = await newOrderService.createOrder(testData);
    
    // Results should be equivalent
    expect(newResult.id).toBeDefined();
    expect(newResult.status).toBe(oldResult.status);
    expect(newResult.total).toBe(oldResult.total);
  });
});

// Property-based testing
import { fc } from 'fast-check';

property(
  fc.record({
    userId: fc.uuid(),
    items: fc.array(orderItemArbitrary),
    shippingAddress: addressArbitrary
  }),
  'createOrder should produce valid order',
  (orderData) => {
    const result = orderService.createOrder(orderData);
    expect(result.id).toBeValidUUID();
    expect(result.status).toBe('pending');
    expect(result.total).toBeGreaterThan(0);
  }
);
```

