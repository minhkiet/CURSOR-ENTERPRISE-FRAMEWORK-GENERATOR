## Workflow (Quy trình)

### Bước 1: Cost Analysis

```typescript
// Analyze cloud costs
interface CostAnalysis {
  total_monthly_cost: number;
  cost_by_service: ServiceCost[];
  cost_by_region: RegionCost[];
  cost_trend: TrendAnalysis;
  anomalies: Anomaly[];
}

async function analyzeCosts(
  billingData: BillingData
): Promise<CostAnalysis> {
  const totalMonthlyCost = calculateTotalCost(billingData);
  const costByService = groupByService(billingData);
  const costByRegion = groupByRegion(billingData);
  const trend = analyzeTrend(billingData);
  const anomalies = detectAnomalies(billingData);
  
  return {
    total_monthly_cost: totalMonthlyCost,
    cost_by_service: costByService,
    cost_by_region: costByRegion,
    cost_trend: trend,
    anomalies
  };
}

function groupByService(data: BillingData): ServiceCost[] {
  const byService = new Map<string, number>();
  
  for (const item of data.items) {
    const current = byService.get(item.service) || 0;
    byService.set(item.service, current + item.cost);
  }
  
  return Array.from(byService.entries())
    .map(([service, cost]) => ({
      service,
      cost,
      percentage: cost / calculateTotalCost(data) * 100
    }))
    .sort((a, b) => b.cost - a.cost);
}

function detectAnomalies(data: BillingData): Anomaly[] {
  const anomalies: Anomaly[] = [];
  
  // Calculate baseline
  const baseline = calculateBaseline(data);
  
  // Check for spikes
  for (const item of data.items) {
    const expected = baseline.get(item.service) || 0;
    if (item.cost > expected * 1.5) {
      anomalies.push({
        type: 'cost_spike',
        service: item.service,
        expected_cost: expected,
        actual_cost: item.cost,
        increase_percentage: ((item.cost - expected) / expected) * 100,
        date: item.date
      });
    }
  }
  
  return anomalies;
}
```

### Bước 2: Waste Identification

```typescript
// Identify cost waste
interface WasteAnalysis {
  idle_resources: IdleResource[];
  overprovisioned: OverProvisioned[];
  unused_resources: UnusedResource[];
  expensive_patterns: ExpensivePattern[];
  total_waste_monthly: number;
}

async function identifyWaste(
  inventory: ResourceInventory,
  utilization: UtilizationData
): Promise<WasteAnalysis> {
  const idleResources = await findIdleResources(inventory, utilization);
  const overProvisioned = findOverProvisioned(inventory, utilization);
  const unusedResources = findUnusedResources(inventory, utilization);
  const expensivePatterns = findExpensivePatterns(inventory);
  
  const totalWaste = 
    calculateIdleCost(idleResources) +
    calculateOverProvisionedCost(overProvisioned) +
    calculateUnusedCost(unusedResources) +
    calculateExpensivePatternCost(expensivePatterns);
  
  return {
    idle_resources: idleResources,
    overprovisioned: overProvisioned,
    unused_resources: unusedResources,
    expensive_patterns: expensivePatterns,
    total_waste_monthly: totalWaste
  };
}

async function findIdleResources(
  inventory: ResourceInventory,
  utilization: UtilizationData
): Promise<IdleResource[]> {
  const idle: IdleResource[] = [];
  
  for (const instance of inventory.compute.instances) {
    const metrics = utilization.getMetrics(instance.id);
    
    if (!metrics) {
      idle.push({
        resource_id: instance.id,
        resource_type: 'instance',
        service: instance.service,
        monthly_cost: instance.cost,
        idle_days: 30,
        recommendation: 'Terminate or hibernate'
      });
      continue;
    }
    
    const avgCpu = metrics.average_cpu_utilization;
    const avgMemory = metrics.average_memory_utilization;
    
    if (avgCpu < 5 && avgMemory < 20) {
      idle.push({
        resource_id: instance.id,
        resource_type: 'instance',
        service: instance.service,
        monthly_cost: instance.cost,
        cpu_utilization: avgCpu,
        memory_utilization: avgMemory,
        idle_days: calculateIdleDays(metrics),
        recommendation: 'Terminate if not needed or right-size'
      });
    }
  }
  
  return idle;
}

function findOverProvisioned(
  inventory: ResourceInventory,
  utilization: UtilizationData
): OverProvisioned[] {
  const overProvisioned: OverProvisioned[] = [];
  
  for (const instance of inventory.compute.instances) {
    const metrics = utilization.getMetrics(instance.id);
    
    if (!metrics) continue;
    
    const avgCpu = metrics.average_cpu_utilization;
    const avgMemory = metrics.average_memory_utilization;
    
    // Check for overprovisioning
    const cpuHeadroom = 100 - avgCpu;
    const memoryHeadroom = 100 - avgMemory;
    
    if (cpuHeadroom > 70 || memoryHeadroom > 60) {
      // Find smaller instance type
      const currentSpec = getInstanceSpec(instance.type);
      const recommendedType = findRightSizeInstance(
        avgCpu,
        avgMemory,
        currentSpec
      );
      
      if (recommendedType && recommendedType.cost < currentSpec.cost) {
        overProvisioned.push({
          resource_id: instance.id,
          current_type: instance.type,
          recommended_type: recommendedType.type,
          current_cost: instance.cost,
          recommended_cost: recommendedType.cost,
          monthly_savings: currentSpec.cost - recommendedType.cost,
          cpu_utilization: avgCpu,
          memory_utilization: avgMemory,
          recommendation: `Downgrade to ${recommendedType.type}`
        });
      }
    }
  }
  
  return overProvisioned;
}
```

### Bước 3: Optimization Recommendations

```typescript
// Generate optimization recommendations
interface OptimizationPlan {
  recommendations: Optimization[];
  total_potential_savings: number;
  implementation_effort: EffortLevel;
  risk_level: RiskLevel;
}

function generateOptimizationPlan(
  waste: WasteAnalysis,
  current_commitments: CommitmentData
): OptimizationPlan {
  const recommendations: Optimization[] = [];
  
  // Terminate idle resources
  for (const idle of waste.idle_resources) {
    recommendations.push({
      category: 'terminate_idle',
      resource: idle.resource_id,
      action: 'terminate',
      savings_monthly: idle.monthly_cost,
      effort: 'low',
      risk: 'low',
      immediate_savings: true
    });
  }
  
  // Right-size overprovisioned
  for (const over of waste.overprovisioned) {
    recommendations.push({
      category: 'right_size',
      resource: over.resource_id,
      action: `change_instance_type`,
      from: over.current_type,
      to: over.recommended_type,
      savings_monthly: over.monthly_savings,
      effort: 'medium',
      risk: 'low'
    });
  }
  
  // Reserved Instance planning
  const riRecommendation = analyzeRIOpportunity(
    waste,
    current_commitments
  );
  recommendations.push(riRecommendation);
  
  // Compute Savings Plans
  const cspRecommendation = analyzeSavingsPlans(
    inventory,
    current_commitments
  );
  recommendations.push(cspRecommendation);
  
  // Storage optimization
  const storageRecommendations = analyzeStorageOptimization(inventory);
  recommendations.push(...storageRecommendations);
  
  return {
    recommendations: prioritizeRecommendations(recommendations),
    total_potential_savings: calculateTotalSavings(recommendations),
    implementation_effort: calculateEffort(recommendations),
    risk_level: calculateRisk(recommendations)
  };
}

function analyzeRIOpportunity(
  waste: WasteAnalysis,
  commitments: CommitmentData
): Optimization {
  // Find always-on workloads
  const alwaysOnInstances = waste.idle_resources.filter(
    i => i.idle_days >= 25 // On 25+ days
  );
  
  const alwaysOnCost = alwaysOnInstances.reduce(
    (sum, i) => sum + i.monthly_cost, 0
  );
  
  // Calculate RI coverage
  const currentCoverage = commitments.ri_coverage_percentage;
  const recommendedCoverage = calculateOptimalRICoverage(
    alwaysOnCost,
    commitments
  );
  
  const additionalCoverage = recommendedCoverage - currentCoverage;
  const additionalSavings = alwaysOnCost * 0.3 * (additionalCoverage / 100);
  
  return {
    category: 'reserved_instances',
    action: 'purchase_ri',
    savings_monthly: additionalSavings,
    effort: 'low',
    risk: 'medium',
    details: {
      current_coverage: currentCoverage,
      recommended_coverage: recommendedCoverage,
      recommended_type: 'Standard 1-year',
      estimated_monthly_cost: alwaysOnCost * 0.7,
      ri_cost_monthly: alwaysOnCost * 0.4
    }
  };
}
```

### Bước 4: Implementation Roadmap

```typescript
// Create implementation roadmap
interface ImplementationRoadmap {
  phases: Phase[];
  total_savings: number;
  timeline_weeks: number;
  milestones: Milestone[];
}

function createRoadmap(
  plan: OptimizationPlan,
  constraints: ImplementationConstraints
): ImplementationRoadmap {
  const phases: Phase[] = [];
  
  // Phase 1: Quick wins (0-2 weeks)
  const quickWins = plan.recommendations.filter(
    r => r.effort === 'low' && r.risk === 'low'
  );
  phases.push({
    name: 'Quick Wins',
    duration_weeks: 2,
    actions: quickWins,
    expected_savings: calculateTotalSavings(quickWins)
  });
  
  // Phase 2: Right-sizing (2-4 weeks)
  const rightSize = plan.recommendations.filter(
    r => r.category === 'right_size'
  );
  phases.push({
    name: 'Right-sizing',
    duration_weeks: 2,
    actions: rightSize,
    expected_savings: calculateTotalSavings(rightSize)
  });
  
  // Phase 3: Commitment optimization (4-8 weeks)
  const commitments = plan.recommendations.filter(
    r => r.category.includes('ri') || r.category.includes('savings_plan')
  );
  phases.push({
    name: 'Commitment Optimization',
    duration_weeks: 4,
    actions: commitments,
    expected_savings: calculateTotalSavings(commitments)
  });
  
  // Phase 4: Architecture changes (8-12 weeks)
  const architecture = plan.recommendations.filter(
    r => r.category === 'architecture'
  );
  phases.push({
    name: 'Architecture Optimization',
    duration_weeks: 4,
    actions: architecture,
    expected_savings: calculateTotalSavings(architecture)
  });
  
  return {
    phases,
    total_savings: plan.total_potential_savings,
    timeline_weeks: phases.reduce((sum, p) => sum + p.duration_weeks, 0),
    milestones: generateMilestones(phases)
  };
}
```

