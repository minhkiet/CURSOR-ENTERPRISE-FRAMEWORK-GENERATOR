### Ví dụ: Complete API Design

```typescript
// API Definition with Express
import express from 'express';
import { z } from 'zod';
import helmet from 'helmet';
import { RateLimit } from 'express-rate-limit';

const app = express();

// Security middleware
app.use(helmet());
app.use(express.json({ limit: '1mb' }));

// Rate limiting
app.use('/api', RateLimit({
  windowMs: 15 * 60 * 1000,
  max: 100,
  standardHeaders: true,
  legacyHeaders: false
}));

// Versioning
const v1Router = express.Router();
app.use('/api/v1', v1Router);

// Routes
v1Router.route('/users')
  .get(
    authenticate,
    authorize('user:read'),
    validate(getUsersSchema),
    getUsersHandler
  )
  .post(
    authenticate,
    authorize('user:write'),
    validate(createUserSchema),
    createUserHandler
  );

v1Router.route('/users/:id')
  .get(
    authenticate,
    authorize('user:read'),
    getUserHandler
  )
  .patch(
    authenticate,
    authorize('user:write'),
    validate(updateUserSchema),
    updateUserHandler
  )
  .delete(
