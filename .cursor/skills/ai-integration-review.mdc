### Bước 8: Cost Optimization

```typescript
// Good: Cost tracking và optimization
interface CostTracker {
  trackRequest(model: string, tokens: number): void;
  getCost(model: string): number;
  getTotalCost(): number;
}

export class AICostOptimizer {
  constructor(
    private cache: CacheService,
    private costTracker: CostTracker
  ) {}
  
  async completion<T>(
    options: CompletionOptions
  ): Promise<CachedResult<T> | T> {
    // Check cache for identical requests
    const cacheKey = this.generateCacheKey(options);
    const cached = await this.cache.get<T>(cacheKey);
    
    if (cached) {
      return { data: cached, cached: true };
    }
    
    // Make request
    const result = await this.llm.completion<T>(options);
    
    // Cache result
    await this.cache.set(cacheKey, result, { ttl: 3600 });
    
    // Track cost
    this.costTracker.trackRequest(options.model, result.usage.total_tokens);
    
    return { data: result, cached: false };
  }
  
  private generateCacheKey(options: CompletionOptions): string {
    const hash = crypto.createHash('sha256');
    hash.update(JSON.stringify({
      model: options.model,
      messages: options.messages,
      temperature: options.temperature
    }));
    return `ai:${hash.digest('hex')}`;
  }
}

// Cost estimation
export function estimateCost(
  model: string,
  inputTokens: number,
  outputTokens: number
): number {
  const pricing: Record<string, { input: number; output: number }> = {
    'gpt-4-turbo': { input: 10, output: 30 },    // $0.01/1K input, $0.03/1K output
    'gpt-3.5-turbo': { input: 0.5, output: 1.5 }, // $0.0005/1K input, $0.0015/1K output
    'claude-3-opus': { input: 15, output: 75 },   // $0.015/1K input, $0.075/1K output
  };
  
  const modelPricing = pricing[model] || pricing['gpt-3.5-turbo'];
  
  const inputCost = (inputTokens / 1000) * modelPricing.input;
  const outputCost = (outputTokens / 1000) * modelPricing.output;
  
  return inputCost + outputCost;
}
```

