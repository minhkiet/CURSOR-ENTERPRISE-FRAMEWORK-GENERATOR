### Bước 2: API Client Implementation

```typescript
// Good: Robust AI client with error handling
import OpenAI from 'openai';
import { z } from 'zod';

export class AIClient {
  constructor(
    private client: OpenAI,
    private logger: Logger,
    private metrics: MetricsService
  ) {}
  
  async completion<T>(options: {
    model: string;
    messages: OpenAI.Chat.ChatCompletionMessageParam[];
    schema?: z.ZodSchema<T>;
    temperature?: number;
    maxTokens?: number;
    timeout?: number;
  }): Promise<T> {
    const startTime = Date.now();
    
    try {
      // Log request
      this.logger.debug('AI API request', {
        model: options.model,
        messageCount: options.messages.length,
        lastMessage: options.messages[options.messages.length - 1]
      });
      
      // Make request with timeout
      const response = await this.withTimeout(
        this.client.chat.completions.create({
          model: options.model,
          messages: options.messages,
          temperature: options.temperature ?? 0.7,
          max_tokens: options.maxTokens ?? 2048,
          response_format: options.schema ? { type: 'json_object' } : undefined
        }),
        options.timeout ?? 60000
      );
      
      const duration = Date.now() - startTime;
      
      // Record metrics
      this.metrics.record('ai.api.call', {
        model: options.model,
        success: true,
        duration_ms: duration
      });
      
      const content = response.choices[0]?.message?.content;
      
      if (!content) {
        throw new AIError('Empty response from AI API');
      }
      
      // Parse if schema provided
      if (options.schema) {
        const parsed = options.schema.safeParse(JSON.parse(content));
        if (!parsed.success) {
          this.logger.error('Schema validation failed', {
            errors: parsed.error.issues,
            content
          });
          throw new AIError('Invalid response format');
        }
        return parsed.data;
      }
      
      return content as T;
      
    } catch (error) {
      const duration = Date.now() - startTime;
      
      this.metrics.record('ai.api.call', {
        model: options.model,
        success: false,
        error_type: error instanceof Error ? error.name : 'Unknown'
      });
      
      if (error instanceof AIError) {
        throw error;
      }
      
      // Transform common errors
      if (error instanceof OpenAI.APIError) {
        if (error.status === 429) {
          throw new RateLimitError('AI API rate limit exceeded');
        }
        if (error.status === 401) {
          throw new AuthenticationError('AI API authentication failed');
        }
      }
      
      throw new AIError(`AI API call failed: ${error}`);
    }
  }
  
  private withTimeout<T>(promise: Promise<T>, timeoutMs: number): Promise<T> {
    return Promise.race([
      promise,
      new Promise<T>((_, reject) =>
        setTimeout(() => reject(new TimeoutError(`Request timed out after ${timeoutMs}ms`)), timeoutMs)
      )
    ]);
  }
}

// Streaming completion
async *streamCompletion(
  client: AIClient,
  options: StreamingOptions
): AsyncGenerator<string> {
  const stream = await client.client.chat.completions.create({
    model: options.model,
    messages: options.messages,
    stream: true,
    temperature: options.temperature
  });
  
  for await (const chunk of stream) {
    const content = chunk.choices[0]?.delta?.content;
    if (content) {
      yield content;
    }
  }
}
```

