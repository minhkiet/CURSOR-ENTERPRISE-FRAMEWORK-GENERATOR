// Code review prompt
const codeReviewPrompt: PromptTemplate = {
  description: 'Review code for bugs and improvements',
  variables: ['language', 'code', 'focus'],
  system: `You are a senior software engineer conducting code review.

Provide a thorough review covering:
1. Bug identification (critical, major, minor)
2. Security vulnerabilities
3. Performance issues
4. Code quality and readability
5. Best practice violations
6. Suggested improvements

Response Format (JSON):
{
  "issues": [
    {
      "severity": "critical|major|minor",
      "type": "bug|security|performance|style",
      "line": "line number or null",
      "description": "Issue description",
      "suggestion": "How to fix"
    }
  ],
  "summary": "Overall assessment",
  "score": 1-10
}`,
  user: `Review this {{language}} code:

\`\`\`{{language}}
{{code}}
\`\`\`

Focus areas: {{focus}}`
};

// Prompt renderer
export function renderPrompt<T extends Record<string, any>>(
  template: PromptTemplate,
  variables: T
): { system: string; user: string } {
  // Validate required variables
  const missing = template.variables.filter(v => !(v in variables));
  if (missing.length > 0) {
    throw new Error(`Missing required variables: ${missing.join(', ')}`);
  }
  
  const system = template.system;
  const user = template.user;
  
  // Replace variables
  const renderedSystem = system.replace(
    /\{\{(\w+)\}\}/g,
    (_, key) => String(variables[key] ?? `{{${key}}}`)
  );
  
  const renderedUser = user.replace(
    /\{\{(\w+)\}\}/g,
    (_, key) => String(variables[key] ?? `{{${key}}}`)
  );
  
  return {
    system: renderedSystem,
    user: renderedUser
  };
}
```

