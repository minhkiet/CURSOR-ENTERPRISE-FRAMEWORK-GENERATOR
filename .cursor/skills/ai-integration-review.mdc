### Phase 3: RAG Implementation

### Bước 5: Retrieval Augmented Generation

```typescript
// Good: RAG implementation
interface RAGConfig {
  embeddingModel: string;
  vectorStore: 'pinecone' | 'weaviate' | 'chroma';
  topK: number;
  minSimilarityScore: number;
}

export class RAGService {
  constructor(
    private embeddings: EmbeddingsClient,
    private vectorStore: VectorStore,
    private llm: AIClient,
    private config: RAGConfig
  ) {}
  
  async query(request: {
    question: string;
    filters?: Record<string, any>;
    maxContextTokens?: number;
  }): Promise<RAGResponse> {
    // 1. Generate query embedding
    const queryEmbedding = await this.embeddings.create(
      request.question,
      { model: this.config.embeddingModel }
    );
    
    // 2. Retrieve relevant documents
    const results = await this.vectorStore.search({
      embedding: queryEmbedding,
      topK: this.config.topK,
      filters: request.filters,
      minScore: this.config.minSimilarityScore
    });
    
    // 3. Build context with token budget
    const context = await this.buildContext(
      results.documents,
      request.maxContextTokens ?? 4000
    );
    
    // 4. Generate answer
    const prompt = this.buildRAGPrompt(request.question, context);
    
    const answer = await this.llm.completion({
      model: 'gpt-4-turbo',
      messages: [
        { role: 'system', content: 'You are a helpful assistant. Answer based on the provided context.' },
        { role: 'user', content: prompt }
      ]
    });
    
    return {
      answer,
      sources: results.documents.map(d => ({
        id: d.id,
        content: d.content,
        score: d.score
      })),
      metadata: {
        documentsRetrieved: results.documents.length,
        contextTokens: this.countTokens(context)
      }
    };
  }
  
  private buildContext(
    documents: RetrievedDocument[],
    maxTokens: number
  ): Promise<string> {
    let context = '';
    let totalTokens = 0;
    
    for (const doc of documents) {
      const docTokens = this.countTokens(doc.content);
      
      if (totalTokens + docTokens > maxTokens) {
        break;
      }
      
      context += `Document: ${doc.id}\n${doc.content}\n\n`;
      totalTokens += docTokens;
    }
    
    return context;
  }
  
  private buildRAGPrompt(question: string, context: string): string {
    return `Context:
${context}

Question: ${question}

Instructions:
1. Answer based ONLY on the provided context
2. If the answer cannot be found in the context, say "I don't have enough information to answer this question"
3. Cite specific documents when making claims
4. Be precise and avoid hallucinations`;
  }
  
  private countTokens(text: string): number {
    // Approximate: 1 token ≈ 4 characters
    return Math.ceil(text.length / 4);
  }
}

// Embedding creation
export async function createEmbeddings(
  texts: string[],
  model: string = 'text-embedding-ada-002'
): Promise<number[][]> {
  const response = await openai.embeddings.create({
    model,
    input: texts
  });
  
  return response.data.map(d => d.embedding);
}
```

### Bước 6: Document Processing Pipeline

```typescript
// Document processing for embeddings
interface DocumentChunk {
  id: string;
  content: string;
  metadata: {
    source: string;
    page?: number;
    position: number;
  };
}

export class DocumentProcessor {
  constructor(
    private embeddings: EmbeddingsClient,
    private vectorStore: VectorStore,
    private tokenizer: Tiktoken
  ) {}
  
  async processDocument(
    document: {
      id: string;
      content: string;
      metadata?: Record<string, any>;
    },
    options: {
      chunkSize?: number;
      chunkOverlap?: number;
    } = {}
  ): Promise<void> {
    const { chunkSize = 1000, chunkOverlap = 200 } = options;
    
    // 1. Split into chunks
    const chunks = this.splitIntoChunks(document.content, chunkSize, chunkOverlap);
    
    // 2. Create embeddings
    const documents: DocumentChunk[] = chunks.map((chunk, index) => ({
      id: `${document.id}-chunk-${index}`,
      content: chunk,
      metadata: {
        source: document.id,
        position: index,
        ...document.metadata
      }
    }));
    
    // 3. Batch embed
    const batchSize = 100;
    for (let i = 0; i < documents.length; i += batchSize) {
      const batch = documents.slice(i, i + batchSize);
      
      const embeddings = await this.embeddings.create(
        batch.map(d => d.content)
      );
      
      // 4. Store in vector DB
      await this.vectorStore.upsert({
        id: document.id,
        vectors: embeddings,
        documents: batch
      });
    }
  }
  
  private splitIntoChunks(
    text: string,
    chunkSize: number,
    overlap: number
  ): string[] {
    const chunks: string[] = [];
    const tokens = this.tokenizer.encode(text);
    
    let start = 0;
    while (start < tokens.length) {
      const end = Math.min(start + chunkSize, tokens.length);
      const chunkTokens = tokens.slice(start, end);
      
      chunks.push(this.tokenizer.decode(chunkTokens));
      start = end - overlap;
    }
    
    return chunks;
  }
}
```

### Phase 4: Safety và Reliability

### Bước 7: Guardrails và Validation

```typescript
// Good: Output validation và safety
export class AIOutputValidator {
  constructor(
    private schemas: Map<string, z.ZodSchema>
  ) {}
  
  validate<T>(output: unknown, schemaName: string): T {
    const schema = this.schemas.get(schemaName);
    
    if (!schema) {
      throw new Error(`Unknown schema: ${schemaName}`);
    }
    
    const result = schema.safeParse(output);
    
    if (!result.success) {
      this.logger.warn('Output validation failed', {
        errors: result.error.issues,
        schemaName
      });
      throw new AIValidationError('Invalid output format', result.error.issues);
    }
    
    return result.data;
  }
  
  // Content safety check
  async checkSafety(text: string): Promise<SafetyResult> {
    const sensitivePatterns = [
      { pattern: /\b\d{3}-\d{2}-\d{4}\b/g, type: 'ssn' },
      { pattern: /\b\d{16}\b/g, type: 'credit_card' },
      { pattern: /password[:\s]*\S+/gi, type: 'password' }
    ];
    
    const findings: SafetyFinding[] = [];
    
    for (const { pattern, type } of sensitivePatterns) {
      if (pattern.test(text)) {
        findings.push({ type, found: true });
      }
    }
    
    return {
      safe: findings.length === 0,
      findings
    };
  }
}

// Hallucination detection
export class HallucinationDetector {
  async check(
    answer: string,
    context: string
  ): Promise<HallucinationResult> {
    const prompt = `Check if the answer is supported by the context.
    
Context:
${context}

Answer:
${answer}

Respond in JSON:
{
  "supported": true/false,
  "confidence": 0-100,
  "unsupportedClaims": ["list of claims not in context"]
}`;
    
    const response = await this.llm.completion({
      model: 'gpt-3.5-turbo',
      messages: [{ role: 'user', content: prompt }],
      schema: z.object({
        supported: z.boolean(),
        confidence: z.number(),
        unsupportedClaims: z.array(z.string())
      })
    });
    
    return response;
  }
}
