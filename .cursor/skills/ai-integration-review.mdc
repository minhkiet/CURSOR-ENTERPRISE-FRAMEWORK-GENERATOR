// Good: Model selection based on use case
interface ModelConfig {
  model: string;
  provider: 'openai' | 'anthropic' | 'google' | 'local';
  maxTokens: number;
  temperature: number;
  useCase: string;
}

// Model selection matrix
const modelConfigs: Record<string, ModelConfig> = {
  // High accuracy, complex reasoning
  gpt4Turbo: {
    model: 'gpt-4-turbo',
    provider: 'openai',
    maxTokens: 4096,
    temperature: 0.7,
    useCase: 'Complex reasoning, code generation, analysis'
  },
  
  // Balanced performance/cost
  gpt35Turbo: {
    model: 'gpt-3.5-turbo',
    provider: 'openai',
    maxTokens: 4096,
    temperature: 0.7,
    useCase: 'Simple tasks, chat, classification'
  },
  
  // Claude for long context
  claude3Opus: {
    model: 'claude-3-opus-20240229',
    provider: 'anthropic',
    maxTokens: 4096,
    temperature: 0.7,
    useCase: 'Long documents, research, complex analysis'
  },
  
  // Fast responses
  claude3Haiku: {
    model: 'claude-3-haiku-20240307',
    provider: 'anthropic',
    maxTokens: 4096,
    temperature: 0.7,
    useCase: 'Quick classifications, simple tasks'
  },
  
  // Code specialized
  gpt4Code: {
    model: 'gpt-4-0125-preview',
    provider: 'openai',
    maxTokens: 8192,
    temperature: 0.2,
    useCase: 'Code generation, debugging, explanations'
  }
};

// Model selector
export function selectModel(useCase: string, requirements: {
  accuracy?: 'high' | 'medium' | 'low';
  latency?: 'fast' | 'medium' | 'slow';
  cost?: 'high' | 'medium' | 'low';
}): ModelConfig {
  switch (useCase) {
    case 'code-generation':
      return modelConfigs.gpt4Code;
      
    case 'document-analysis':
      return requirements.cost === 'low' 
        ? modelConfigs.claude3Opus 
        : modelConfigs.gpt4Turbo;
        
    case 'simple-classification':
      return modelConfigs.claude3Haiku;
      
    case 'customer-service':
      return modelConfigs.gpt35Turbo;
      
    default:
      return modelConfigs.gpt4Turbo;
  }
}
