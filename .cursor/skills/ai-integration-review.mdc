```typescript
// services/ai/assistant.service.ts
@Injectable()
export class AssistantService {
  constructor(
    private aiClient: AIClient,
    private ragService: RAGService,
    private validator: AIOutputValidator,
    private costTracker: CostTracker,
    private logger: Logger
  ) {}
  
  async chat(request: ChatRequest): Promise<ChatResponse> {
    const startTime = Date.now();
    
    try {
      // Build messages with context
      const messages = await this.buildMessages(request);
      
      // Get completion
      const completion = await this.aiClient.completion({
        model: this.selectModel(request),
        messages,
        temperature: request.temperature ?? 0.7
      });
      
      return {
        message: completion,
        metadata: {
          model: this.selectModel(request),
          duration: Date.now() - startTime,
          tokens: completion.usage
        }
      };
      
    } catch (error) {
      this.logger.error('Chat failed', { error, request });
      throw this.transformError(error);
    }
  }
  
  async ragQuery(request: RAGRequest): Promise<RAGResponse> {
    return this.ragService.query(request);
  }
}
