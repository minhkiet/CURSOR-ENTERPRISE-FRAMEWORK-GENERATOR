## Examples (Ví dụ)

### Ví dụ: CQRS Flow

```typescript
// Write flow
async function createOrder(dto: CreateOrderDTO) {
  const command = new CreateOrderCommand(
    dto.customerId,
    dto.items,
    dto.shippingAddress
  );
  
  await commandBus.dispatch(command);
}

// Read flow
async function getOrders(customerId?: string) {
  const query = new GetOrderListQuery(customerId);
  return queryBus.execute(query);
}
