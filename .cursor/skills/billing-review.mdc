## Workflow (Quy trình)

### Bước 1: Billing Logic Review

```typescript
// Review billing calculations
interface BillingLogicReview {
  calculations: CalculationAnalysis[];
  issues: BillingIssue[];
  accuracy_score: number;
}

interface CalculationAnalysis {
  operation: string;
  formula: string;
  edge_cases: string[];
  tested: boolean;
}

async function reviewBillingLogic(
  code: BillingCode
): Promise<BillingLogicReview> {
  const calculations = extractCalculations(code);
  const issues: BillingIssue[] = [];
  
  for (const calc of calculations) {
    // Check for floating point issues
    if (hasFloatingPointIssue(calc)) {
      issues.push({
        type: 'floating_point_error',
        severity: 'critical',
        location: calc.operation,
        message: 'Use integer cents instead of floating point',
        suggestion: 'Store all amounts in cents, divide for display'
      });
    }
    
    // Check for rounding issues
    if (hasRoundingIssue(calc)) {
      issues.push({
        type: 'rounding_issue',
        severity: 'high',
        location: calc.operation,
        message: 'Inconsistent rounding may cause penny differences',
        suggestion: 'Use HALF_UP rounding consistently'
      });
    }
    
    // Check for timezone issues
    if (hasTimezoneIssue(calc)) {
      issues.push({
        type: 'timezone_issue',
        severity: 'high',
        location: calc.operation,
        message: 'Date/time without timezone may cause billing errors',
        suggestion: 'Always use UTC with timezone for billing dates'
      });
    }
  }
  
  return {
    calculations,
    issues,
    accuracy_score: calculateAccuracyScore(calculations, issues)
  };
}

function hasFloatingPointIssue(calc: Calculation): boolean {
  // Check for operations like price * quantity where price might be float
  return calc.formula.match(/\*\s*[\d.]+/) !== null;
}
```

### Bước 2: Subscription Review

```typescript
// Review subscription management
interface SubscriptionReview {
  plans: PlanInfo[];
  lifecycle: LifecycleAnalysis;
  prorations: ProrationAnalysis;
  issues: SubscriptionIssue[];
}

async function reviewSubscriptions(
  config: SubscriptionConfig
): Promise<SubscriptionReview> {
  const plans = parsePlans(config);
  const issues: SubscriptionIssue[] = [];
  
  // Check for proration logic
  const prorationAnalysis = analyzeProration(config);
  
  for (const plan of plans) {
    // Check for negative trial periods
    if (plan.trialDays < 0) {
      issues.push({
        type: 'invalid_trial',
        plan: plan.name,
        severity: 'critical',
        message: 'Trial period cannot be negative'
      });
    }
    
    // Check for proration during upgrade
    if (plan.upgradeProration === 'immediate') {
      issues.push({
        type: 'immediate_upgrade',
        plan: plan.name,
        severity: 'medium',
        message: 'Immediate upgrade may cause customer confusion',
        suggestion: 'Consider end-of-cycle upgrade'
      });
    }
  }
  
  return {
    plans,
    lifecycle: analyzeLifecycle(config),
    prorations: prorationAnalysis,
    issues
  };
}

function analyzeProration(config: SubscriptionConfig): ProrationAnalysis {
  return {
    upgrade_method: config.proration?.upgradeMethod || 'immediate',
    downgrade_method: config.proration?.downgradeMethod || 'end_of_cycle',
    grace_period_days: config.proration?.gracePeriodDays || 0,
    issues: checkProrationEdgeCases(config)
  };
}
```

### Bước 3: Payment Security Review

```typescript
// Review payment processing security
interface PaymentSecurityReview {
  pci_compliance: PCIStatus;
  encryption: EncryptionStatus;
  tokenization: TokenizationStatus;
  issues: SecurityIssue[];
}

async function reviewPaymentSecurity(
  code: PaymentCode
): Promise<PaymentSecurityReview> {
  const issues: SecurityIssue[] = [];
  
  // Check for PCI compliance
  const pciStatus = await checkPCICompliance(code);
  if (!pciStatus.compliant) {
    issues.push(...pciStatus.violations);
  }
  
  // Check for card data storage
  const cardStorage = findCardDataStorage(code);
  if (cardStorage.found) {
    issues.push({
      type: 'card_data_storage',
      severity: 'critical',
      message: 'Card data found in storage - PCI violation',
      locations: cardStorage.locations
    });
  }
  
  // Check for encryption
  const encryption = analyzeEncryption(code);
  if (!encryption.strong) {
    issues.push({
      type: 'weak_encryption',
      severity: 'critical',
      message: 'Payment data should use AES-256 encryption'
    });
  }
  
  return {
    pci_compliance: pciStatus,
    encryption,
    tokenization: analyzeTokenization(code),
    issues
  };
}
```

### Bước 4: Invoice Generation Review

```typescript
// Review invoice generation
interface InvoiceReview {
  templates: TemplateAnalysis[];
  calculations: InvoiceCalculation[];
  issues: InvoiceIssue[];
}

async function reviewInvoices(
  config: InvoiceConfig
): Promise<InvoiceReview> {
  const templates = await analyzeTemplates(config.templates);
  const calculations = analyzeInvoiceCalculations(config);
  
  const issues: InvoiceIssue[] = [];
  
  for (const calc of calculations) {
    // Check tax calculation
    if (!calc.taxCalculation) {
      issues.push({
        type: 'missing_tax',
        severity: 'high',
        message: 'Invoice missing tax calculation'
      });
    }
    
    // Check discount application
    if (calc.discounts && !calc.discountsConsistent) {
      issues.push({
        type: 'inconsistent_discount',
        severity: 'medium',
        message: 'Discounts applied inconsistently'
      });
    }
  }
  
  return { templates, calculations, issues };
}
```

## Checklist (Danh sách kiểm tra)

- [ ] All amounts stored in cents (integers)
- [ ] Rounding consistent (HALF_UP)
- [ ] Timezone handling for billing dates
- [ ] Proration calculations verified
- [ ] Trial periods correctly applied
- [ ] Upgrade/downgrade logic tested
- [ ] PCI-DSS compliance verified
- [ ] No card data stored locally
- [ ] Encryption at rest and in transit
- [ ] Invoice totals match source calculations
- [ ] Tax calculations per jurisdiction
- [ ] Failed payment handling
- [ ] Dunning process for retries
- [ ] Refund calculations verified
- [ ] Financial audit trail complete

## Examples (Ví dụ)

### Ví dụ 1: Safe Billing Calculation

```typescript
// ✅ GOOD: Safe billing calculation
class BillingCalculator {
  calculateInvoice(items: InvoiceItem[], taxRate: number): Invoice {
    // All amounts in cents
    let subtotalCents = 0;
    
    for (const item of items) {
      // price is in cents
      subtotalCents += item.priceCents * item.quantity;
    }
    
    // Calculate tax (round to nearest cent)
    const taxCents = Math.round(subtotalCents * taxRate / 100);
    
    // Total
    const totalCents = subtotalCents + taxCents;
    
    return {
      subtotalCents,
      taxCents,
      totalCents,
      // For display
      subtotal: this.formatCurrency(subtotalCents),
      tax: this.formatCurrency(taxCents),
      total: this.formatCurrency(totalCents)
    };
  }
  
  private formatCurrency(cents: number): string {
    return `$${(cents / 100).toFixed(2)}`;
  }
}
```

## Anti Patterns (Các pattern cần tránh)

### 1. Floating Point for Money
```typescript
// ❌ BAD: Floating point for money
const total = price * quantity; // Floating point!

// ✅ GOOD: Integer cents
const totalCents = priceCents * quantity;
```

### 2. Storing Card Data
```typescript
// ❌ BAD: Storing card details
class BadPaymentService {
  async process(card: CreditCard): Promise<void> {
    await db.save({
      cardNumber: card.number,
      cvv: card.cvv, // NEVER store CVV!
      expiry: card.expiry
    });
  }
}

// ✅ GOOD: Tokenize via payment provider
class GoodPaymentService {
  async process(token: PaymentToken): Promise<void> {
    // Only store token, not card data
    await paymentProvider.charge(token);
  }
}
```

## Best Practices (Thực hành tốt nhất)

1. **Integer cents**: Store all amounts as integers (cents)
2. **HALF_UP rounding**: Consistent rounding strategy
3. **UTC timestamps**: All billing dates in UTC
4. **PCI compliance**: Never store card data
5. **Audit logging**: Track all billing events
6. **Idempotency**: Prevent duplicate charges
7. **Proration**: Clear calculation documentation
8. **Grace periods**: For failed payments
9. **Automated reconciliation**: Daily checks
10. **Financial audits**: Regular review

