### Bước 2: Payment Processing

```typescript
// Payment Service Interface
interface PaymentService {
  createCustomer(email: string, paymentMethodId: string): Promise<Customer>;
  createSubscription(customerId: string, planId: string): Promise<Subscription>;
  updateSubscription(subscriptionId: string, planId: string): Promise<Subscription>;
  cancelSubscription(subscriptionId: string): Promise<void>;
  chargeForOverage(customerId: string, usage: UsageRecord): Promise<Payment>;
}

// Stripe Implementation
class StripePaymentService implements PaymentService {
  constructor(
    private stripeClient: Stripe,
    private eventBus: EventBus
  ) {}
  
  async createSubscription(
    customerId: string,
    planId: string
  ): Promise<Subscription> {
    const plan = PLANS.find(p => p.id === planId);
    if (!plan) throw new PlanNotFoundError(planId);
    
    const subscription = await this.stripeClient.subscriptions.create({
      customer: customerId,
      items: [{ price: plan.stripePriceId }],
      payment_behavior: 'default_incomplete',
      expand: ['latest_invoice.payment_intent']
    });
    
    await this.eventBus.publish(new SubscriptionCreated(subscription));
    
    return this.mapToSubscription(subscription);
  }
  
  async handleWebhook(event: Stripe.Event): Promise<void> {
    switch (event.type) {
      case 'invoice.paid':
        await this.handleInvoicePaid(event.data.object as Stripe.Invoice);
        break;
      case 'customer.subscription.deleted':
        await this.handleSubscriptionDeleted(event.data.object as Stripe.Subscription);
        break;
      case 'payment_intent.payment_failed':
        await this.handlePaymentFailed(event.data.object as Stripe.PaymentIntent);
        break;
    }
  }
}
```

### Phase 2: Invoice Generation

### Bước 3: Invoice Service

```typescript
// Invoice Generation
class InvoiceService {
  constructor(
    private subscriptionRepo: SubscriptionRepository,
    private usageRepo: UsageRepository,
    private pdfGenerator: PDFGenerator
  ) {}
  
  async generateInvoice(
    customerId: string,
    period: BillingPeriod
  ): Promise<Invoice> {
    const subscription = await this.subscriptionRepo.findActiveByCustomer(customerId);
    if (!subscription) throw new NoActiveSubscriptionError(customerId);
    
    const baseAmount = subscription.plan.price;
    
    // Calculate overages
    const usage = await this.usageRepo.getUsage(customerId, period);
    const overages = this.calculateOverages(subscription.plan.limits, usage);
    
    // Calculate taxes
    const subtotal = baseAmount.add(overages.total);
    const taxes = this.calculateTaxes(subtotal, customerId);
    const total = subtotal.add(taxes);
    
    // Create invoice record
    const invoice = Invoice.create({
      customerId,
      period,
      baseAmount,
      overages,
      taxes,
      total,
      lineItems: this.buildLineItems(baseAmount, overages, taxes)
    });
    
    await this.invoiceRepo.save(invoice);
    
    // Generate PDF
    const pdf = await this.pdfGenerator.generate(invoice);
    await this.fileStorage.upload(`invoices/${invoice.id}.pdf`, pdf);
    
    return invoice;
  }
  
  private calculateOverages(
    limits: ResourceLimits,
    usage: UsageRecord
  ): OverageDetails {
    const overages: OverageDetails = { items: [], total: Money.zero() };
    
    if (limits.users !== -1 && usage.users > limits.users) {
      const overageUnits = usage.users - limits.users;
      const overageAmount = Money.create(overageUnits * 2, Currency.USD); // $2 per user
      overages.items.push({ type: 'extra_users', units: overageUnits, amount: overageAmount });
      overages.total = overages.total.add(overageAmount);
    }
    
    if (limits.apiCalls !== -1 && usage.apiCalls > limits.apiCalls) {
      const overageUnits = usage.apiCalls - limits.apiCalls;
      const overageAmount = Money.create(overageUnits * 0.001, Currency.USD); // $0.001 per call
      overages.items.push({ type: 'extra_api_calls', units: overageUnits, amount: overageAmount });
      overages.total = overages.total.add(overageAmount);
    }
    
    return overages;
  }
}
```

