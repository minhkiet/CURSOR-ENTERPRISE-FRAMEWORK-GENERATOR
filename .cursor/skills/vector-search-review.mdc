    phases: [
      {
        name: 'preparation',
        actions: [
          'Backup current index',
          'Prepare target infrastructure',
          'Setup monitoring'
        ]
      },
      {
        name: 'build',
        actions: [
          'Build new HNSW index in parallel',
          'Monitor build progress',
          'Validate index integrity'
        ]
      },
      {
        name: 'cutover',
        actions: [
          'Switch read traffic to new index',
          'Monitor error rates',
