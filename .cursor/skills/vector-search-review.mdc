## Workflow (Quy trình)

### Bước 1: Implementation Discovery

```typescript
// Khám phá và document current implementation
interface VectorSearchImplementation {
  index_type: IndexType;
  metric: DistanceMetric;
  vector_dimensions: number;
  total_vectors: number;
  storage_backend: StorageBackend;
  indexing_parameters: Record<string, any>;
  query_api: QueryAPI;
}

async function discoverImplementation(
  config: DiscoveryConfig
): Promise<VectorSearchImplementation> {
  const impl: VectorSearchImplementation = {
    index_type: await detectIndexType(config.connection),
    metric: await detectMetricType(config.connection),
    vector_dimensions: await getVectorDimensions(config.connection),
    total_vectors: await getTotalVectors(config.connection),
    storage_backend: detectStorageBackend(config),
    indexing_parameters: await getIndexParameters(config.connection),
    query_api: await analyzeQueryAPI(config.connection)
  };
  
  // Validate configuration
  await validateConfiguration(impl);
  
  return impl;
}

async function detectIndexType(connection: Connection): Promise<IndexType> {
  const indexInfo = await connection.getIndexInfo();
  
  if (indexInfo.type === 'hnsw') return 'hnsw';
  if (indexInfo.type === 'ivf') return 'ivf';
  if (indexInfo.type === 'flat') return 'flat';
  
  return inferIndexType(indexInfo);
}
```

### Bước 2: Performance Profiling

```typescript
// Profile query performance
interface PerformanceProfile {
  p50_latency_ms: number;
  p95_latency_ms: number;
  p99_latency_ms: number;
  throughput_qps: number;
  index_size_mb: number;
  memory_usage_mb: number;
  cache_hit_rate: number;
}

async function profilePerformance(
  impl: VectorSearchImplementation,
  workload: QueryWorkload
): Promise<PerformanceProfile> {
  const latencies: number[] = [];
  
  // Warm-up
  for (let i = 0; i < 100; i++) {
    await executeQuery(impl, workload.sample_queries[i % workload.sample_queries.length]);
  }
  
  // Benchmark
  const start = Date.now();
  
  for (const query of workload.sample_queries) {
    const queryStart = Date.now();
    await executeQuery(impl, query);
    latencies.push(Date.now() - queryStart);
  }
  
  const totalDuration = Date.now() - start;
  
  return {
    p50_latency_ms: percentile(latencies, 50),
    p95_latency_ms: percentile(latencies, 95),
    p99_latency_ms: percentile(latencies, 99),
    throughput_qps: workload.sample_queries.length / (totalDuration / 1000),
    index_size_mb: await getIndexSize(impl),
    memory_usage_mb: await getMemoryUsage(impl),
    cache_hit_rate: await getCacheStats(impl)
  };
}

async function executeQuery(
  impl: VectorSearchImplementation,
  query: SearchQuery
): Promise<SearchResult> {
  const start = Date.now();
  
  const result = await impl.query_api.search({
    vector: query.vector,
    top_k: query.top_k,
    filter: query.filter
  });
  
  return {
    ...result,
    latency_ms: Date.now() - start
  };
}
```

### Bước 3: Quality Assessment

```typescript
// Assess retrieval quality
interface QualityMetrics {
  recall_at_k: number[];
  mrr: number;
  ndcg: number;
  precision_at_k: number[];
  relevance_distribution: number[];
}

async function assessQuality(
  impl: VectorSearchImplementation,
  benchmarks: QualityBenchmarks
): Promise<QualityMetrics> {
  const allRecalls: number[][] = [];
  const allMrrs: number[] = [];
  const allNdcgs: number[] = [];
  
  for (const testCase of benchmarks.test_cases) {
    // Execute search
    const results = await impl.query_api.search({
      vector: testCase.query_vector,
      top_k: benchmarks.k_values[benchmarks.k_values.length - 1]
    });
    
    // Calculate metrics
    const recalls = calculateRecallAtK(
      results.ids,
      testCase.relevant_ids,
      benchmarks.k_values
    );
    
    const mrr = calculateMRR(results.ids, testCase.relevant_ids);
    const ndcg = calculateNDCG(results.ids, testCase.relevant_ids, testCase.relevance_scores);
    
    allRecalls.push(recalls);
    allMrrs.push(mrr);
    allNdcgs.push(ndcg);
  }
  
  return {
    recall_at_k: averageAcross(allRecalls),
    mrr: average(allMrrs),
    ndcg: average(allNdcgs),
    precision_at_k: calculatePrecisionAtK(allRecalls, benchmarks.k_values),
    relevance_distribution: calculateRelevanceDistribution(allRecalls)
  };
}

function calculateRecallAtK(
  retrieved: string[],
  relevant: Set<string>,
  kValues: number[]
): number[] {
  const recalls: number[] = [];
  
  for (const k of kValues) {
    const retrievedAtK = retrieved.slice(0, k);
    const relevantAtK = retrievedAtK.filter(id => relevant.has(id));
    recalls.push(relevantAtK.length / relevant.size);
  }
  
  return recalls;
}

function calculateMRR(retrieved: string[], relevant: Set<string>): number {
  for (let i = 0; i < retrieved.length; i++) {
    if (relevant.has(retrieved[i])) {
      return 1 / (i + 1);
    }
  }
  return 0;
}
```

### Bước 4: Index Analysis

```typescript
// Analyze current index configuration
interface IndexAnalysis {
  type: IndexType;
  parameters: IndexParameters;
  efficiency_score: number;
  recommendations: IndexRecommendation[];
}

async function analyzeIndex(
  impl: VectorSearchImplementation
): Promise<IndexAnalysis> {
  const currentParams = await getIndexParameters(impl);
  
  const analysis: IndexAnalysis = {
    type: impl.index_type,
    parameters: currentParams,
    efficiency_score: 0,
    recommendations: []
  };
  
  // Evaluate parameter appropriateness
  const paramAnalysis = await analyzeParameters(
    impl.index_type,
    currentParams,
    impl.total_vectors
  );
  
  analysis.efficiency_score = paramAnalysis.efficiency;
  analysis.recommendations = paramAnalysis.recommendations;
  
  // Check for known inefficiencies
  if (impl.index_type === 'hnsw') {
    const hnswIssues = analyzeHNSW(currentParams);
    analysis.recommendations.push(...hnswIssues);
  }
  
  return analysis;
}

async function analyzeHNSW(
  params: HNSWParameters
): Promise<IndexRecommendation[]> {
  const recommendations: IndexRecommendation[] = [];
  
  // Check m (connections per node)
  if (params.m < 8) {
    recommendations.push({
      parameter: 'm',
      current_value: params.m,
      recommended_value: 16,
      reason: 'Low m reduces recall but may be acceptable for high-throughput',
      expected_improvement: 'recall +15%'
    });
  }
  
  if (params.m > 32) {
    recommendations.push({
      parameter: 'm',
      current_value: params.m,
      recommended_value: 16,
      reason: 'High m increases memory without proportional recall gain',
      expected_improvement: 'memory -30%'
    });
  }
  
  // Check ef_construction
  if (params.ef_construction < 100) {
    recommendations.push({
      parameter: 'ef_construction',
      current_value: params.ef_construction,
      recommended_value: 200,
      reason: 'Low ef_construction reduces build quality',
      expected_improvement: 'recall +10%'
    });
  }
  
  return recommendations;
}
```

### Bước 5: Optimization Planning

```typescript
// Generate optimization plan
interface OptimizationPlan {
  short_term: Optimization[];
  medium_term: Optimization[];
  long_term: Optimization[];
  expected_improvements: ImprovementEstimate[];
  migration_risks: Risk[];
}

async function generateOptimizationPlan(
  impl: VectorSearchImplementation,
  performance: PerformanceProfile,
  quality: QualityMetrics,
  requirements: Requirements
): Promise<OptimizationPlan> {
  const plan: OptimizationPlan = {
    short_term: [],
    medium_term: [],
    long_term: [],
    expected_improvements: [],
    migration_risks: []
  };
  
  // Address SLA violations first
  if (performance.p95_latency_ms > requirements.max_p95_latency) {
    const latencyOptimizations = await identifyLatencyOptimizations(
      impl, performance, requirements
    );
    plan.short_term.push(...latencyOptimizations);
  }
  
  // Address quality issues
  if (quality.recall_at_k[quality.recall_at_k.length - 1] < requirements.min_recall) {
    const qualityOptimizations = await identifyQualityOptimizations(
      impl, quality, requirements
    );
    plan.medium_term.push(...qualityOptimizations);
  }
  
  // Address scalability
  if (impl.total_vectors > estimateCapacity(impl)) {
    const scalingOptions = await identifyScalingOptions(impl);
    plan.long_term.push(...scalingOptions);
  }
  
  // Generate expected improvements
  plan.expected_improvements = estimateImprovements(plan);
  
  // Identify risks
  plan.migration_risks = identifyRisks(plan);
  
  return plan;
}

async function identifyLatencyOptimizations(
  impl: VectorSearchImplementation,
  performance: PerformanceProfile,
  requirements: Requirements
): Promise<Optimization[]> {
  const optimizations: Optimization[] = [];
  
  // Check ef_search vs ef_construction ratio
  if (impl.index_type === 'hnsw') {
    const currentParams = await getIndexParameters(impl);
    
    if (currentParams.ef_search < 50) {
      optimizations.push({
        type: 'parameter_tuning',
        parameter: 'ef_search',
        from: currentParams.ef_search,
        to: Math.min(200, currentParams.ef_construction),
        expected_latency_reduction: '30-50%'
      });
    }
  }
  
  // Check for missing query optimization
  if (!performance.cache_hit_rate) {
    optimizations.push({
      type: 'caching',
      description: 'Add result caching for repeated queries',
      expected_latency_reduction: '40-60% for cache hits'
    });
  }
  
  // Check batch vs single query
  optimizations.push({
    type: 'batch_optimization',
    description: 'Enable batch query processing',
    expected_latency_reduction: '20-30% throughput improvement'
  });
  
  return optimizations;
}
```

### Bước 6: Benchmark Comparison

```typescript
// Compare different configurations
interface BenchmarkResult {
  configuration: string;
  p50_latency_ms: number;
  p95_latency_ms: number;
  recall: number;
  memory_mb: number;
  index_size_mb: number;
  cost_per_1m_ops: number;
}

async function benchmarkConfigurations(
  impl: VectorSearchImplementation,
  workload: QueryWorkload,
  qualityBenchmarks: QualityBenchmarks
): Promise<BenchmarkResult[]> {
  const results: BenchmarkResult[] = [];
  
  // Get baseline
  const baseline = await profilePerformance(impl, workload);
  const baselineQuality = await assessQuality(impl, qualityBenchmarks);
  
  results.push({
    configuration: 'current',
    ...baseline,
    recall: baselineQuality.recall_at_k[9],
    memory_mb: baseline.memory_usage_mb,
    index_size_mb: baseline.index_size_mb,
    cost_per_1m_ops: calculateCost(impl, baseline)
  });
  
  // Benchmark common alternatives
  const alternatives = [
    { index_type: 'hnsw', m: 16, ef_construction: 200, ef_search: 100 },
    { index_type: 'hnsw', m: 32, ef_construction: 200, ef_search: 100 },
    { index_type: 'ivf', nlist: 1024, nprobe: 20 },
    { index_type: 'hnsw', m: 16, ef_construction: 400, ef_search: 200 }
  ];
  
  for (const alt of alternatives) {
    // Create test index
    const testImpl = await createTestIndex(impl, alt);
    
    // Benchmark
    const perf = await profilePerformance(testImpl, workload);
    const qual = await assessQuality(testImpl, qualityBenchmarks);
    
    results.push({
      configuration: JSON.stringify(alt),
      ...perf,
      recall: qual.recall_at_k[9],
      memory_mb: perf.memory_usage_mb,
      index_size_mb: perf.index_size_mb,
      cost_per_1m_ops: calculateCost(testImpl, perf)
    });
    
    // Cleanup
    await cleanupTestIndex(testImpl);
  }
  
  return results.sort((a, b) => {
    // Pareto-optimal: best recall per latency
    return (b.recall / b.p95_latency_ms) - (a.recall / a.p95_latency_ms);
  });
}
```

