### Ví dụ 1: Full Implementation Review

```typescript
// Complete review workflow
async function reviewVectorSearchImplementation(
  connectionConfig: ConnectionConfig,
  requirements: SLARequirements
): Promise<ReviewReport> {
  // Phase 1: Discovery
  const impl = await discoverImplementation(connectionConfig);
  
  // Phase 2: Profiling
  const workload = await generateQueryWorkload(impl, 10000);
  const performance = await profilePerformance(impl, workload);
  
  // Phase 3: Quality
  const benchmarks = await loadQualityBenchmarks('squad_relevant');
  const quality = await assessQuality(impl, benchmarks);
  
  // Phase 4: Analysis
  const indexAnalysis = await analyzeIndex(impl);
  
  // Phase 5: Optimization
  const plan = await generateOptimizationPlan(impl, performance, quality, requirements);
  
  // Phase 6: Benchmark
  const alternatives = await benchmarkConfigurations(impl, workload, benchmarks);
  
  return {
    implementation: impl,
    performance,
    quality,
    index_analysis: indexAnalysis,
    optimization_plan: plan,
    benchmarks: alternatives,
    recommendations: prioritizeRecommendations(plan)
  };
}

// Usage
const report = await reviewVectorSearchImplementation(
  { host: 'localhost', port: 6333 },
  { max_p95_latency: 50, min_recall: 0.95 }
);
