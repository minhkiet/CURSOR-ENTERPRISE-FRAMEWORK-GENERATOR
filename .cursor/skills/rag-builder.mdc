## Workflow (Quy trình)

### Bước 1: Query Understanding

```typescript
// Phân tích và enhance query
interface QueryAnalysis {
  original_query: string;
  rewritten_query: string;
  intent: 'factual' | 'procedural' | 'explanatory' | 'comparative';
  entities: Entity[];
  temporal_context?: DateRange;
  domain?: string;
}

class QueryProcessor {
  private intentClassifier: IntentClassifier;
  private entityExtractor: EntityExtractor;
  private queryRewriter: QueryRewriter;
  
  async analyze(query: string, context?: QueryContext): Promise<QueryAnalysis> {
    const [intent, entities] = await Promise.all([
      this.intentClassifier.classify(query),
      this.entityExtractor.extract(query)
    ]);
    
    const rewritten = await this.queryRewriter.rewrite(query, {
      expand_abbreviations: true,
      add_synonyms: true,
      incorporate_context: context
    });
    
    return {
      original_query: query,
      rewritten_query: rewritten,
      intent: intent.type,
      entities: entities,
      temporal_context: intent.temporal,
      domain: intent.domain
    };
  }
  
  async rewrite(query: string, strategy: RewriteStrategy): Promise<string> {
    // HyDE: Hypothetical Document Embeddings
    const hypotheticalDoc = await this.generateHypotheticalAnswer(query);
    return `Original: ${query}\nHypothetical: ${hypotheticalDoc}`;
  }
}
```

### Bước 2: Multi-Query Retrieval

```typescript
// Retrieve với multiple query strategies
interface RetrievalResult {
  chunks: RetrievedChunk[];
  query_type: 'exact' | 'semantic' | 'hybrid';
  retrieval_latency_ms: number;
}

class RetrievalPipeline {
  private vectorStore: VectorStorage;
  private keywordStore: KeywordIndex;
  private knowledgeGraph: KnowledgeGraph;
  
  async retrieve(
    query: QueryAnalysis,
    config: RetrievalConfig
  ): Promise<RetrievalResult> {
    const queries = this.generateQueryVariations(query);
    const retrievalPromises: Promise<RetrievedChunk[]>[] = [];
    
    // Dense retrieval
    if (config.use_dense) {
      retrievalPromises.push(
        this.denseRetrieval(queries, config.dense_top_k)
      );
    }
    
    // Sparse retrieval
    if (config.use_sparse) {
      retrievalPromises.push(
        this.sparseRetrieval(query.original_query, config.sparse_top_k)
      );
    }
    
    // Knowledge graph traversal
    if (config.use_graph) {
      retrievalPromises.push(
        this.graphRetrieval(query.entities, config.graph_depth)
      );
    }
    
    // Execute all retrievals
    const results = await Promise.all(retrievalPromises);
    const allChunks = results.flat();
    
    return {
      chunks: this.deduplicateAndRank(allChunks),
      query_type: this.inferQueryType(query),
      retrieval_latency_ms: Date.now()
    };
  }
  
  private generateQueryVariations(query: QueryAnalysis): string[] {
    return [
      query.original_query,
      query.rewritten_query,
      // Entity-focused variations
      ...query.entities.map(e => `What is ${e.name}?`),
      // Intent-focused variations  
      this.intentRewriter.rewrite(query),
      // Expansion
      ...this.synonymExpander.expand(query.original_query)
    ];
  }
  
  private async denseRetrieval(
    queries: string[],
    topK: number
  ): Promise<RetrievedChunk[]> {
    const embeddings = await Promise.all(
      queries.map(q => this.embeddingModel.encode(q))
    );
    
    const results = await Promise.all(
      embeddings.map(vec => this.vectorStore.search(vec, { top_k: topK }))
    );
    
    return results.flat();
  }
}
```

### Bước 3: Retrieval Ranking và Reranking

```typescript
// Rerank retrieved results để improve quality
interface RerankedResult {
  chunk: RetrievedChunk;
  rerank_score: number;
  original_rank: number;
  relevance_factors: RelevanceFactor[];
}

class RerankerPipeline {
  private crossEncoder: CrossEncoderReranker;
  private bm25Reranker: BM25Reranker;
  
  async rerank(
    chunks: RetrievedChunk[],
    query: QueryAnalysis,
    options: RerankOptions
  ): Promise<RerankedResult[]> {
    // Stage 1: Initial scoring with cross-encoder
    const crossEncoderScores = await this.crossEncoder.score(
      chunks.map(c => ({ query: query.original_query, document: c.content }))
    );
    
    // Stage 2: Combine with BM25
    const bm25Scores = chunks.map(c => ({
      chunk: c,
      score: this.bm25Reranker.score(query.original_query, c.content)
    }));
    
    // Stage 3: Diversity-aware reranking
    const reranked = this.diversityRerank(
      chunks.map((c, i) => ({
        chunk: c,
        cross_score: crossEncoderScores[i],
        bm25_score: bm25Scores[i].score,
        original_rank: i
      })),
      {
        diversity_weight: options.diversity_weight || 0.3,
        max_same_source: options.max_same_source || 3
      }
    );
    
    return reranked.slice(0, options.final_top_k);
  }
  
  private diversityRerank(
    candidates: ScoredCandidate[],
    options: DiversityOptions
  ): RerankedResult[] {
    const selected: RerankedResult[] = [];
    const sourceCounts = new Map<string, number>();
    
    // Sort by cross-encoder score
    candidates.sort((a, b) => b.cross_score - a.cross_score);
    
    for (const candidate of candidates) {
      const source = candidate.chunk.metadata.source;
      const count = sourceCounts.get(source) || 0;
      
      // Check diversity constraint
      if (count < options.max_same_source) {
        selected.push({
          chunk: candidate.chunk,
          rerank_score: this.combineScores(candidate),
          original_rank: candidate.original_rank,
          relevance_factors: this.extractFactors(candidate)
        });
        
        sourceCounts.set(source, count + 1);
      }
      
      if (selected.length >= options.final_top_k) break;
    }
    
    return selected;
  }
}
```

### Bước 4: Context Assembly

```typescript
// Assemble retrieved context thành prompt
interface ContextAssembly {
  prompt: string;
  context_chunks: ContextChunk[];
  token_count: number;
  truncation_info: TruncationInfo;
}

class ContextAssembler {
  private tokenizer: Tokenizer;
  private maxContextTokens: number;
  
  constructor(maxTokens: number) {
    this.maxContextTokens = maxTokens;
    this.tokenizer = new Tokenizer();
  }
  
  assemble(
    query: QueryAnalysis,
    chunks: RerankedResult[],
    template: PromptTemplate
  ): ContextAssembly {
    // Sort chunks by position in document for coherent context
    const sortedChunks = this.sortByDocumentOrder(chunks);
    
    const contextParts: ContextChunk[] = [];
    let currentTokens = 0;
    let truncated = false;
    
    for (const result of sortedChunks) {
      const chunkTokens = this.tokenizer.count(result.chunk.content);
      
      if (currentTokens + chunkTokens > this.maxContextTokens - this.getTemplateTokens(template)) {
        truncated = true;
        break;
      }
      
      contextParts.push({
        content: result.chunk.content,
        source: result.chunk.metadata.source,
        score: result.rerank_score,
        position: contextParts.length + 1
      });
      
      currentTokens += chunkTokens;
    }
    
    const prompt = this.buildPrompt(template, query, contextParts);
    
    return {
      prompt,
      context_chunks: contextParts,
      token_count: this.tokenizer.count(prompt),
      truncation_info: {
        was_truncated: truncated,
        chunks_included: contextParts.length,
        chunks_excluded: chunks.length - contextParts.length
      }
    };
  }
  
  private buildPrompt(
    template: PromptTemplate,
    query: QueryAnalysis,
    context: ContextChunk[]
  ): string {
    const contextSection = context.map((c, i) => 
      `[${i + 1}] Source: ${c.source}\n${c.content}`
    ).join('\n\n');
    
    return template.render({
      query: query.original_query,
      context: contextSection,
      citation_instruction: 'Cite sources using [1], [2], etc.'
    });
  }
}
```

### Bước 5: Generation và Citation

```typescript
// Generate response với citations
interface GenerationResult {
  response: string;
  citations: Citation[];
  confidence: number;
  reasoning_chain?: ReasoningStep[];
}

class GenerationPipeline {
  private llm: LLMClient;
  private citationExtractor: CitationExtractor;
  
  async generate(
    query: QueryAnalysis,
    context: ContextAssembly
  ): Promise<GenerationResult> {
    // Generate with citation instruction
    const generationPrompt = this.addCitationInstructions(context.prompt);
    
    const response = await this.llm.complete(generationPrompt, {
      temperature: 0.3,  // Lower for factual responses
      max_tokens: this.calculateMaxTokens(context.token_count)
    });
    
    // Extract citations from response
    const citations = this.citationExtractor.extract(
      response.content,
      context.context_chunks
    );
    
    // Calculate confidence based on retrieval scores
    const confidence = this.calculateConfidence(context, citations);
    
    return {
      response: response.content,
      citations,
      confidence,
      reasoning_chain: this.buildReasoningChain(query, context)
    };
  }
  
  private addCitationInstructions(prompt: string): string {
    return `${prompt}

IMPORTANT: 
- You must cite your sources using [1], [2], etc. corresponding to the context numbers
- Only make claims that are supported by the provided context
- If the context doesn't contain enough information, say "Based on the provided documents..."
- Do not make up information not in the context`;
  }
  
  private calculateConfidence(
    context: ContextAssembly,
    citations: Citation[]
  ): number {
    if (citations.length === 0) return 0.1;
    
    const avgScore = citations.reduce((sum, c) => sum + c.relevance_score, 0) 
                     / citations.length;
    
    const coverage = citations.length / context.context_chunks.length;
    
    return Math.min(1, avgScore * 0.7 + coverage * 0.3);
  }
}
```

### Bước 6: Quality Assurance

```typescript
// Validate response quality
interface QualityReport {
  factual_accuracy: number;
  citation_coverage: number;
  response_relevance: number;
  overall_score: number;
  issues: QualityIssue[];
}

class RAGQualityChecker {
  async validate(
    query: QueryAnalysis,
    generation: GenerationResult,
    context: ContextAssembly
  ): Promise<QualityReport> {
    const checks = await Promise.all([
      this.checkFactualAccuracy(generation, context),
      this.checkCitationCoverage(generation),
      this.checkResponseRelevance(query, generation)
    ]);
    
    const issues = this.identifyIssues(checks);
    
    return {
      factual_accuracy: checks[0].score,
      citation_coverage: checks[1].score,
      response_relevance: checks[2].score,
      overall_score: this.calculateOverallScore(checks),
      issues
    };
  }
  
  private async checkFactualAccuracy(
    generation: GenerationResult,
    context: ContextAssembly
  ): Promise<CheckResult> {
    // Extract claims từ response
    const claims = this.extractClaims(generation.response);
    
    // Verify each claim against context
    const verified = await Promise.all(
      claims.map(claim => this.verifyClaim(claim, context.context_chunks))
    );
    
    const supportedCount = verified.filter(v => v.supported).length;
    
    return {
      score: supportedCount / claims.length,
      details: verified
    };
  }
}
```

