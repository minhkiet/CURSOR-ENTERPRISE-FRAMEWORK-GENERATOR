### Bước 8: Tenant Context

```typescript
// Tenant context middleware
export class TenantMiddleware {
  constructor(
    private tenantResolver: TenantResolver,
    private rlsManager: RLSManager
  ) {}
  
  async handle(req: Request, res: Response, next: NextFunction): Promise<void> {
    try {
      // Extract tenant identifier
      const tenantId = this.extractTenantId(req);
      
      if (!tenantId) {
        res.status(401).json({ error: 'Tenant identification required' });
        return;
      }
      
      // Resolve tenant
      const tenant = await this.tenantResolver.resolve(tenantId);
      
      if (!tenant) {
        res.status(404).json({ error: 'Tenant not found' });
        return;
      }
      
      if (tenant.status !== 'active') {
        res.status(403).json({ 
          error: 'Tenant not active',
          status: tenant.status 
        });
        return;
      }
      
      // Set tenant context
      req.tenant = tenant;
      
      // Set RLS context
      await this.rlsManager.setContext(tenantId);
      
      // Add tenant to response headers
      res.setHeader('X-Tenant-ID', tenantId);
      
      next();
    } catch (error) {
      this.logger.error('Tenant middleware error', { error });
      next(error);
    }
  }
  
  private extractTenantId(req: Request): string | null {
    // Try different sources in order of preference
    // 1. Path parameter
    if (req.params.tenantId) {
      return req.params.tenantId;
    }
    
    // 2. Header
    const headerTenant = req.headers['x-tenant-id'] as string;
    if (headerTenant) {
      return headerTenant;
    }
    
    // 3. Subdomain
    const host = req.headers.host || '';
    const subdomain = host.split('.')[0];
    if (subdomain && subdomain !== 'www' && subdomain !== 'app') {
      return subdomain;
    }
    
    // 4. JWT token
    const token = extractToken(req);
    if (token) {
      const payload = decodeToken(token);
      return payload.tenantId;
    }
    
    return null;
  }
}

// RLS context manager
export class RLSManager {
  async setContext(tenantId: string): Promise<void> {
    await this.db.query(
      `SET app.current_tenant_id = $1`,
      [tenantId]
    );
  }
  
  async clearContext(): Promise<void> {
    await this.db.query(`RESET app.current_tenant_id`);
  }
}
