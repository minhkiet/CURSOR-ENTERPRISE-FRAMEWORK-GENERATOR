### Bước 2: Decision Matrix

```typescript
// Isolation strategy decision matrix
interface TenantRequirements {
  isolationLevel: 'low' | 'medium' | 'high';
  dataSize: 'small' | 'medium' | 'large';
  compliance: ('none' | 'soc2' | 'hipaa' | 'gdpr' | 'pci')[];
  budget: 'low' | 'medium' | 'high';
  scalingNeeds: 'low' | 'medium' | 'high';
  customizations: 'none' | 'schema' | 'full';
}

type IsolationStrategy = 
  | 'shared-db-siloed'
  | 'shared-db-schemas'
  | 'separate-databases'
  | 'separate-infrastructure';

export function selectIsolationStrategy(
  requirements: TenantRequirements
): IsolationStrategy {
  // Highest isolation required
  if (requirements.compliance.includes('pci') || 
      requirements.isolationLevel === 'high' ||
      requirements.customizations === 'full') {
    return 'separate-infrastructure';
  }
  
  // High compliance or separate schemas needed
  if (requirements.compliance.includes('hipaa') ||
      requirements.compliance.includes('gdpr') ||
      requirements.isolationLevel === 'medium' ||
      requirements.customizations === 'schema' ||
      requirements.scalingNeeds === 'high') {
    return 'separate-databases';
  }
  
  // Medium isolation, shared schemas acceptable
  if (requirements.isolationLevel === 'medium' ||
      requirements.scalingNeeds === 'medium' ||
      requirements.dataSize === 'large') {
    return 'shared-db-schemas';
  }
  
  // Default to most cost-effective
  return 'shared-db-siloed';
}

// Strategy implementation
const strategyConfig: Record<IsolationStrategy, StrategyConfig> = {
  'shared-db-siloed': {
    database: 'single',
    schema: 'shared',
    rls: true,
    estimatedCost: 1,
    maxTenants: 1000
  },
  'shared-db-schemas': {
    database: 'single',
    schema: 'per-tenant',
    rls: false,
    estimatedCost: 10,
    maxTenants: 100
  },
  'separate-databases': {
    database: 'per-tenant',
    schema: 'shared',
    rls: false,
    estimatedCost: 100,
    maxTenants: 50
  },
  'separate-infrastructure': {
    database: 'per-tenant',
    schema: 'shared',
    rls: false,
    estimatedCost: 1000,
    maxTenants: 10
  }
};
```

