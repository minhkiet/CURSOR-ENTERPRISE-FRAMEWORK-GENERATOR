### Phase 4: Resource Management

### Bước 7: Quota Management

```typescript
// Quota management service
export class QuotaService {
  constructor(
    private db: DatabaseContext,
    private metricsService: MetricsService,
    private logger: Logger
  ) {}
  
  async checkQuota(tenantId: string, resource: ResourceType): Promise<QuotaCheckResult> {
    const tenant = await this.db.findById('tenants', tenantId);
    const quota = this.getQuotaLimits(tenant.planId);
    
    switch (resource) {
      case 'users':
        return this.checkUsersQuota(tenantId, quota);
      case 'storage':
        return this.checkStorageQuota(tenantId, quota);
      case 'api_calls':
        return this.checkApiCallsQuota(tenantId, quota);
      case 'database':
        return this.checkDatabaseQuota(tenantId, quota);
    }
  }
  
  private async checkUsersQuota(tenantId: string, quota: TenantQuota): Promise<QuotaCheckResult> {
    const current = await this.db.count('users', {
      where: { tenantId, deletedAt: null }
    });
    
    return {
      resource: 'users',
      current,
      limit: quota.maxUsers,
      available: quota.maxUsers - current,
      percentage: (current / quota.maxUsers) * 100,
      exceeded: current >= quota.maxUsers
    };
  }
  
  private async checkStorageQuota(tenantId: string, quota: TenantQuota): Promise<QuotaCheckResult> {
    const usage = await this.metricsService.getStorageUsage(tenantId);
    
    return {
      resource: 'storage',
      current: usage.bytes,
      limit: quota.maxStorageGb * 1e9,
      available: (quota.maxStorageGb * 1e9) - usage.bytes,
      percentage: (usage.bytes / (quota.maxStorageGb * 1e9)) * 100,
      exceeded: usage.bytes >= quota.maxStorageGb * 1e9
    };
  }
  
  async recordApiUsage(tenantId: string, endpoint: string, duration: number): Promise<void> {
    // Record metrics
    await this.metricsService.record({
      tenantId,
      metric: 'api_call',
      value: 1,
      tags: { endpoint, success: true }
    });
    
    // Update rate limit counters
    await this.redis.incr(`quota:${tenantId}:api_calls:${this.getCurrentPeriod()}`);
    
    // Check if approaching limit
    const check = await this.checkQuota(tenantId, 'api_calls');
    if (check.percentage >= 80) {
      await this.notifyTenantApproachingLimit(tenantId, check);
    }
  }
  
  async enforceQuotaLimit(tenantId: string, resource: ResourceType): Promise<void> {
    const check = await this.checkQuota(tenantId, resource);
    
    if (check.exceeded) {
      // Record violation
      await this.db.query(
        `INSERT INTO quota_violations (tenant_id, resource, current, "limit", recorded_at)
         VALUES ($1, $2, $3, $4, NOW())`,
        [tenantId, resource, check.current, check.limit]
      );
      
      // Emit event for handling
      await this.eventBus.emit('quota.exceeded', {
        tenantId,
        resource,
        check
      });
      
      throw new QuotaExceededError(resource, check.current, check.limit);
    }
  }
}

// Quota middleware
export function quotaMiddleware(
  quotaService: QuotaService
): Middleware {
  return async (req, res, next) => {
    const tenantId = req.headers['x-tenant-id'] as string;
    
    if (!tenantId) {
      return next();
    }
    
    try {
      // Check API calls quota
      await quotaService.enforceQuotaLimit(tenantId, 'api_calls');
      
      // Record usage
      await quotaService.recordApiUsage(
        tenantId,
        req.path,
        Date.now() - req.startTime
      );
      
      next();
    } catch (error) {
      if (error instanceof QuotaExceededError) {
        return res.status(429).json({
          error: 'QUOTA_EXCEEDED',
          message: `API quota exceeded for ${error.resource}`,
          resource: error.resource,
          limit: error.limit,
          retryAfter: 3600 // 1 hour
        });
      }
      next(error);
    }
  };
}
