### Bước 4: Separate Schemas Strategy

```sql
-- For separate schemas strategy
-- Create tenant schema dynamically

CREATE OR REPLACE FUNCTION create_tenant_schema(tenant_slug VARCHAR)
RETURNS VOID AS $$
DECLARE
    schema_name TEXT := 'tenant_' || tenant_slug;
BEGIN
    -- Create schema
    EXECUTE format('CREATE SCHEMA IF NOT EXISTS %I', schema_name);
    
    -- Create tables in schema
    EXECUTE format('
        CREATE TABLE %I.users (
            id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
            email VARCHAR(255) NOT NULL UNIQUE,
            name VARCHAR(255),
            password_hash VARCHAR(255),
            role VARCHAR(50) DEFAULT ''member'',
            created_at TIMESTAMPTZ DEFAULT NOW(),
            updated_at TIMESTAMPTZ DEFAULT NOW()
        )', schema_name);
    
    EXECUTE format('
        CREATE TABLE %I.products (
            id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
            sku VARCHAR(100) NOT NULL UNIQUE,
            name VARCHAR(255) NOT NULL,
            price DECIMAL(12, 2) NOT NULL,
            created_at TIMESTAMPTZ DEFAULT NOW()
        )', schema_name);
    
    -- Create indexes
    EXECUTE format('CREATE INDEX ON %I.users(email)', schema_name);
    EXECUTE format('CREATE INDEX ON %I.products(sku)', schema_name);
    
    -- Grant permissions
    EXECUTE format('GRANT USAGE ON SCHEMA %I TO app_user', schema_name);
    EXECUTE format('GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA %I TO app_user', schema_name);
    
END;
$$ LANGUAGE plpgsql;

-- Migration between strategies
CREATE OR REPLACE FUNCTION migrate_tenant_to_separate_schema(
    tenant_id UUID,
    new_schema_name VARCHAR
) RETURNS VOID AS $$
DECLARE
BEGIN
    -- 1. Create new schema
    PERFORM create_tenant_schema(new_schema_name);
    
    -- 2. Copy data (using transaction)
    BEGIN
        -- Copy users
        EXECUTE format(
            'INSERT INTO %I.users (id, email, name, password_hash, role)
             SELECT id, email, name, password_hash, role FROM users WHERE tenant_id = $1',
            'tenant_' || new_schema_name
        ) USING tenant_id;
        
        -- Copy products
        EXECUTE format(
            'INSERT INTO %I.products (id, sku, name, price)
             SELECT id, sku, name, price FROM products WHERE tenant_id = $1',
            'tenant_' || new_schema_name
        ) USING tenant_id;
        
        -- 3. Mark migration complete
        UPDATE tenants 
        SET settings = settings || '{"schema": "' || new_schema_name || '"}'::jsonb
        WHERE id = tenant_id;
        
    EXCEPTION
        WHEN OTHERS THEN
            -- Rollback and cleanup on failure
            EXECUTE format('DROP SCHEMA IF EXISTS %I CASCADE', 'tenant_' || new_schema_name);
            RAISE;
    END;
END;
$$ LANGUAGE plpgsql;
```

### Phase 3: Tenant Management

### Bước 5: Tenant Lifecycle Management

```typescript
// Tenant lifecycle service
export class TenantLifecycleService {
  constructor(
    private db: DatabaseContext,
    private eventBus: EventBus,
    private provisioningService: ProvisioningService,
    private billingService: BillingService,
    private logger: Logger
  ) {}
  
  async createTenant(input: CreateTenantInput): Promise<Tenant> {
    const { name, slug, planId, adminEmail, settings } = input;
    
    // Validate slug uniqueness
    const existing = await this.db.query(
      'SELECT id FROM tenants WHERE slug = $1',
      [slug]
    );
    
    if (existing.rows.length > 0) {
      throw new ValidationError('Tenant slug already exists');
    }
    
    // Create tenant record
    const tenant = await this.db.transaction(async (tx) => {
      const result = await tx.query(
        `INSERT INTO tenants (name, slug, plan_id, billing_email, settings, status)
         VALUES ($1, $2, $3, $4, $5, 'provisioning')
         RETURNING *`,
        [name, slug, planId, adminEmail, JSON.stringify(settings || {})]
      );
      
      const newTenant = result.rows[0];
      
      // Create admin user
      await tx.query(
        `INSERT INTO users (tenant_id, email, role, status)
         VALUES ($1, $2, 'owner', 'invited')`,
        [newTenant.id, adminEmail]
      );
      
      return newTenant;
    });
    
    // Provision tenant resources asynchronously
    this.provisionTenantResources(tenant.id);
    
    // Emit event
    await this.eventBus.publish('tenant.created', {
      tenantId: tenant.id,
      slug: tenant.slug,
      planId: tenant.plan_id
    });
    
    return tenant;
  }
  
  private async provisionTenantResources(tenantId: string): Promise<void> {
    try {
      // Get tenant
      const tenant = await this.db.findById('tenants', tenantId);
      
      // Provision based on strategy
      switch (tenant.provisioningStrategy) {
        case 'shared-db-siloed':
          // No additional provisioning needed
          break;
          
        case 'shared-db-schemas':
          // Create tenant schema
          await this.provisioningService.createSchema(tenant.slug);
          break;
          
        case 'separate-databases':
          // Create tenant database
          await this.provisioningService.createDatabase(tenant.slug);
          break;
          
        case 'separate-infrastructure':
          // Provision dedicated infrastructure
          await this.provisioningService.provisionDedicatedResources(tenant.slug);
          break;
      }
      
      // Create storage bucket
      await this.provisioningService.createStorageBucket(tenant.slug);
      
      // Initialize integrations
      await this.initializeIntegrations(tenant);
      
      // Update status
      await this.db.update('tenants', tenantId, { status: 'active' });
      
      // Send welcome email
      await this.sendWelcomeEmail(tenant);
      
      this.logger.info('Tenant provisioned successfully', { tenantId });
      
    } catch (error) {
      this.logger.error('Tenant provisioning failed', { tenantId, error });
      
      // Mark as failed and notify
      await this.db.update('tenants', tenantId, { status: 'failed' });
      
      await this.eventBus.publish('tenant.provisioning.failed', {
        tenantId,
        error: error.message
      });
    }
  }
  
  async suspendTenant(tenantId: string, reason: string): Promise<void> {
    const tenant = await this.db.findById('tenants', tenantId);
    
    if (tenant.status === 'suspended') {
      throw new ValidationError('Tenant is already suspended');
    }
    
    await this.db.transaction(async (tx) => {
      // Update status
      await tx.query(
        'UPDATE tenants SET status = $1, updated_at = NOW() WHERE id = $2',
        ['suspended', tenantId]
      );
      
      // Revoke all user sessions
      await tx.query(
        'UPDATE users SET last_logout_at = NOW() WHERE tenant_id = $1',
        [tenantId]
      );
      
      // Log suspension
      await tx.query(
        `INSERT INTO tenant_events (tenant_id, event_type, metadata)
         VALUES ($1, 'suspended', $2)`,
        [tenantId, JSON.stringify({ reason, suspendedBy: 'system' })]
      );
    });
    
    await this.eventBus.publish('tenant.suspended', { tenantId, reason });
  }
  
  async deleteTenant(tenantId: string, options?: { 
    immediate?: boolean;
    retentionDays?: number;
  }): Promise<void> {
    const tenant = await this.db.findById('tenants', tenantId);
    const retentionDays = options?.retentionDays ?? 30;
    
    if (options?.immediate) {
      // Immediate deletion
      await this.performTenantDeletion(tenant);
    } else {
      // Soft delete with grace period
      await this.db.query(
        `UPDATE tenants 
         SET status = 'scheduled_for_deletion',
             deleted_at = NOW(),
             settings = settings || $1::jsonb
         WHERE id = $2`,
        [JSON.stringify({ deletionScheduledAt: new Date(), retentionEndsAt: new Date(Date.now() + retentionDays * 24 * 60 * 60 * 1000) }), tenantId]
      );
      
      // Schedule actual deletion
      await this.scheduleTenantDeletion(tenantId, retentionDays);
    }
    
    await this.eventBus.publish('tenant.deleted', { tenantId });
  }
  
  private async performTenantDeletion(tenant: Tenant): Promise<void> {
    // Clean up based on strategy
    switch (tenant.provisioningStrategy) {
      case 'shared-db-schemas':
        await this.provisioningService.dropSchema(tenant.slug);
        break;
      case 'separate-databases':
        await this.provisioningService.dropDatabase(tenant.slug);
        break;
      case 'separate-infrastructure':
        await this.provisioningService.cleanupDedicatedResources(tenant.slug);
        break;
    }
    
    // Clean up storage
    await this.provisioningService.deleteStorageBucket(tenant.slug);
    
    // Delete tenant record
    await this.db.query('DELETE FROM tenants WHERE id = $1', [tenant.id]);
  }
}
```

### Bước 6: Tenant Provisioning Service

```typescript
// Provisioning service for different isolation strategies
export class ProvisioningService {
  constructor(
    private db: DatabaseContext,
    private storage: StorageService,
    private config: ProvisioningConfig,
    private logger: Logger
  ) {}
  
  async createSchema(tenantSlug: string): Promise<void> {
    const schemaName = `tenant_${tenantSlug.replace(/-/g, '_')}`;
    
    await this.db.query(`CREATE SCHEMA IF NOT EXISTS "${schemaName}"`);
    
    // Create tables
    await this.db.query(`
      CREATE TABLE "${schemaName}".users (
        id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
        email VARCHAR(255) NOT NULL UNIQUE,
        name VARCHAR(255),
        role VARCHAR(50) DEFAULT 'member',
        created_at TIMESTAMPTZ DEFAULT NOW()
      )
    `);
    
    // Grant permissions
    await this.db.query(`GRANT USAGE ON SCHEMA "${schemaName}" TO app_user`);
    await this.db.query(`GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA "${schemaName}" TO app_user`);
    
    this.logger.info('Tenant schema created', { schemaName });
  }
  
  async createDatabase(tenantSlug: string): Promise<void> {
    const dbName = `tenant_${tenantSlug.replace(/-/g, '_')}`;
    
    // Create database (requires superuser or createdb privilege)
    await this.db.query(`CREATE DATABASE "${dbName}"`);
    
    // Connect to new database and create tables
    const newDbConnection = await this.createConnectionForDatabase(dbName);
    
    try {
      await newDbConnection.query(`
        CREATE TABLE users (
          id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
          email VARCHAR(255) NOT NULL UNIQUE,
          name VARCHAR(255),
          role VARCHAR(50) DEFAULT 'member',
          created_at TIMESTAMPTZ DEFAULT NOW()
        )
      `);
    } finally {
      await newDbConnection.end();
    }
    
    this.logger.info('Tenant database created', { dbName });
  }
  
  async provisionDedicatedResources(tenantSlug: string): Promise<void> {
    const namespace = `tenant-${tenantSlug}`;
    
    // Create dedicated resources (for Kubernetes-based deployment)
    await this.k8s.createNamespace(namespace);
    
    // Deploy application instance
    await this.k8s.deployApplication(namespace, {
      image: this.config.appImage,
      replicas: 1,
      resources: {
        cpu: '500m',
        memory: '512Mi'
      }
    });
    
    // Create database
    await this.createDatabase(namespace);
    
    // Create cache
    await this.redis.createTenantNamespace(namespace);
    
    // Create storage
    await this.storage.createBucket(namespace);
    
    this.logger.info('Tenant dedicated resources provisioned', { tenantSlug });
  }
}
