## Workflow (Quy trình)

### Bước 1: Multi-Tenant Architecture Review

```typescript
// Review multi-tenant architecture
interface TenantArchitectureReview {
  isolation_model: IsolationModel;
  data_strategy: DataStrategy;
  shared_services: SharedService[];
  tenant_provisioning: ProvisioningProcess;
  issues: ArchitectureIssue[];
}

type IsolationModel = 'shared_db' | 'shared_schema' | 'separate_db' | 'hybrid';
type DataStrategy = 'row_level' | 'schema_per_tenant' | 'database_per_tenant';

async function reviewTenantArchitecture(
  architecture: Architecture
): Promise<TenantArchitectureReview> {
  const review: TenantArchitectureReview = {
    isolation_model: detectIsolationModel(architecture),
    data_strategy: detectDataStrategy(architecture),
    shared_services: identifySharedServices(architecture),
    tenant_provisioning: analyzeProvisioning(architecture),
    issues: []
  };
  
  // Check for proper isolation
  if (review.isolation_model === 'shared_db' && review.data_strategy === 'row_level') {
    const rlsStatus = await checkRLSStatus(architecture);
    if (!rlsStatus.enabled) {
      review.issues.push({
        type: 'missing_rls',
        severity: 'critical',
        message: 'Row-level security not enabled for shared database'
      });
    }
  }
  
  // Check for cross-tenant data leakage
  const leakageRisks = await checkDataLeakageRisks(architecture);
  review.issues.push(...leakageRisks);
  
  return review;
}

function detectIsolationModel(architecture: Architecture): IsolationModel {
  if (architecture.databases?.per_tenant) return 'separate_db';
  if (architecture.schemas?.per_tenant) return 'shared_schema';
  return 'shared_db';
}

async function checkDataLeakageRisks(
  architecture: Architecture
): Promise<ArchitectureIssue[]> {
  const issues: ArchitectureIssue[] = [];
  
  // Check for hardcoded tenant IDs
  const hardcodedIds = await findHardcodedTenantIds(architecture);
  if (hardcodedIds.length > 0) {
    issues.push({
      type: 'hardcoded_tenant_id',
      severity: 'critical',
      locations: hardcodedIds,
      message: 'Found hardcoded tenant IDs - data leakage risk'
    });
  }
  
  // Check for missing indexes on tenant_id
  const missingIndexes = await findMissingTenantIndexes(architecture);
  issues.push(...missingIndexes.map(idx => ({
    type: 'missing_tenant_index',
    table: idx.table,
    severity: 'high',
    message: `Missing index on tenant_id column`
  })));
  
  return issues;
}
```

### Bước 2: Subscription Management Review

```typescript
// Review subscription management
interface SubscriptionReview {
  plans: PlanInfo[];
  billing_model: BillingModel;
  lifecycle_states: StateTransition[];
  issues: BillingIssue[];
}

type BillingModel = 'per_user' | 'per_seat' | 'usage_based' | 'tiered' | 'hybrid';

async function reviewSubscriptions(
  config: BillingConfig
): Promise<SubscriptionReview> {
  const plans = parsePlans(config);
  const lifecycleStates = analyzeLifecycleStates(config);
  
  const issues: BillingIssue[] = [];
  
  // Check for missing states
  const requiredStates = ['trial', 'active', 'past_due', 'canceled', 'paused'];
  for (const state of requiredStates) {
    if (!lifecycleStates.find(s => s.name === state)) {
      issues.push({
        type: 'missing_lifecycle_state',
        state,
        severity: 'high',
        message: `Missing lifecycle state: ${state}`
      });
    }
  }
  
  // Check for missing grace periods
  for (const plan of plans) {
    if (!plan.gracePeriodDays || plan.gracePeriodDays < 7) {
      issues.push({
        type: 'insufficient_grace_period',
        plan: plan.name,
        severity: 'medium',
        message: 'Grace period should be at least 7 days'
      });
    }
  }
  
  // Check for dunning strategy
  if (!config.dunningStrategy) {
    issues.push({
      type: 'missing_dunning',
      severity: 'medium',
      message: 'No dunning strategy configured'
    });
  }
  
  return {
    plans,
    billing_model: detectBillingModel(config),
    lifecycle_states: lifecycleStates,
    issues
  };
}

function analyzeLifecycleStates(config: BillingConfig): StateTransition[] {
  const states = config.lifecycle?.states || [];
  
  return states.map(state => ({
    name: state.name,
    from: state.from || [],
    to: state.to || [],
    actions: state.actions || [],
    automatic: state.automatic || false
  }));
}
```

### Bước 3: Data Privacy Compliance

```typescript
// Review data privacy compliance
interface ComplianceReview {
  gdpr_compliant: boolean;
  ccpa_compliant: boolean;
  data_retention: RetentionPolicy[];
  consent_management: ConsentConfig;
  issues: ComplianceIssue[];
}

async function reviewCompliance(
  config: PrivacyConfig
): Promise<ComplianceReview> {
  const gdprIssues = await checkGDPRCompliance(config);
  const ccpaIssues = await checkCCPCompliance(config);
  const retention = analyzeRetentionPolicies(config);
  
  return {
    gdpr_compliant: gdprIssues.length === 0,
    ccpa_compliant: ccpaIssues.length === 0,
    data_retention: retention,
    consent_management: config.consent,
    issues: [...gdprIssues, ...ccpaIssues]
  };
}

async function checkGDPRCompliance(
  config: PrivacyConfig
): Promise<ComplianceIssue[]> {
  const issues: ComplianceIssue[] = [];
  
  // Check for right to erasure
  if (!config.rightToErasure) {
    issues.push({
      regulation: 'GDPR',
      requirement: 'Right to Erasure (Article 17)',
      severity: 'critical',
      message: 'System must support complete data deletion per tenant request'
    });
  }
  
  // Check for data portability
  if (!config.dataPortability) {
    issues.push({
      regulation: 'GDPR',
      requirement: 'Data Portability (Article 20)',
      severity: 'high',
      message: 'System must support exporting tenant data in machine-readable format'
    });
  }
  
  // Check for consent tracking
  if (!config.consent?.tracking) {
    issues.push({
      regulation: 'GDPR',
      requirement: 'Consent Management',
      severity: 'high',
      message: 'System must track user consent for data processing'
    });
  }
  
  // Check for data processing agreements
  if (!config.hasDPA) {
    issues.push({
      regulation: 'GDPR',
      requirement: 'Data Processing Agreement',
      severity: 'critical',
      message: 'DPA must be in place for data processing'
    });
  }
  
  return issues;
}

function analyzeRetentionPolicies(
  config: PrivacyConfig
): RetentionPolicy[] {
  return config.retention?.policies || [];
}
```

### Bước 4: Pipeline Performance Review

```typescript
// Review sales pipeline configuration
interface PipelineReview {
  pipelines: PipelineInfo[];
  stages: StageInfo[];
  automation_rules: AutomationRule[];
  issues: PipelineIssue[];
}

async function reviewPipelines(
  config: PipelineConfig
): Promise<PipelineReview> {
  const pipelines = parsePipelines(config);
  const stages = analyzeStages(config);
  const automationRules = findAutomationRules(config);
  
  const issues: PipelineIssue[] = [];
  
  // Check for proper stage ordering
  for (const stage of stages) {
    if (!stage.slackDays || stage.slackDays < 0) {
      issues.push({
        type: 'invalid_slack_days',
        stage: stage.name,
        severity: 'medium',
        message: 'Stage should have non-negative slack days'
      });
    }
    
    // Check for missing probability
    if (!stage.probability && stage.type !== 'won' && stage.type !== 'lost') {
      issues.push({
        type: 'missing_probability',
        stage: stage.name,
        severity: 'medium',
        message: 'Stage should have probability for accurate forecasting'
      });
    }
  }
  
  // Check for automation loops
  const loopRisks = findAutomationLoops(automationRules);
  issues.push(...loopRisks);
  
  return {
    pipelines,
    stages,
    automation_rules: automationRules,
    issues
  };
}

function findAutomationLoops(
  rules: AutomationRule[]
): PipelineIssue[] {
  const issues: PipelineIssue[] = [];
  
  // Build dependency graph
  const graph = buildRuleDependencyGraph(rules);
  
  // Find cycles
  const cycles = detectCycles(graph);
  
  for (const cycle of cycles) {
    issues.push({
      type: 'automation_loop',
      rules: cycle,
      severity: 'high',
      message: `Automation loop detected: ${cycle.join(' -> ')}`
    });
  }
  
  return issues;
}
```

### Bước 5: Integration Review

```typescript
// Review CRM integrations
interface IntegrationReview {
  integrations: IntegrationInfo[];
  webhook_security: WebhookSecurity;
  sync_strategies: SyncStrategy[];
  issues: IntegrationIssue[];
}

async function reviewIntegrations(
  config: IntegrationConfig
): Promise<IntegrationReview> {
  const integrations = config.integrations || [];
  const webhookSecurity = analyzeWebhookSecurity(config);
  const syncStrategies = analyzeSyncStrategies(integrations);
  
  const issues: IntegrationIssue[] = [];
  
  // Check for webhook security
  if (!webhookSecurity.signatureValidation) {
    issues.push({
      type: 'missing_webhook_signature',
      severity: 'critical',
      message: 'Webhook endpoints must validate signatures'
    });
  }
  
  // Check for sync conflict resolution
  for (const integration of integrations) {
    if (integration.sync && !integration.conflictResolution) {
      issues.push({
        type: 'missing_conflict_resolution',
        integration: integration.name,
        severity: 'high',
        message: 'Integration should have conflict resolution strategy'
      });
    }
  }
  
  return {
    integrations,
    webhook_security: webhookSecurity,
    sync_strategies: syncStrategies,
    issues
  };
}
```

