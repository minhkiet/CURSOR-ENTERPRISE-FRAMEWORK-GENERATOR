## Workflow (Quy trình)

### Bước 1: Project Structure Analysis

```typescript
// Analyze Vue project structure
interface VueProjectStructure {
  vueVersion: string;
  buildTool: 'vite' | 'webpack' | 'nuxt';
  stateManagement: 'pinia' | 'vuex' | 'none';
  styleSystem: 'scoped' | 'module' | 'css-vars';
  typescriptUsage: 'full' | 'partial' | 'none';
  issues: StructureIssue[];
}

async function analyzeVueStructure(
  rootPath: string
): Promise<VueProjectStructure> {
  const pkg = JSON.parse(await readFile(`${rootPath}/package.json`));
  const vueDeps = pkg.dependencies || {};
  const devDeps = pkg.devDependencies || {};
  
  // Detect Vue version
  let vueVersion = 'unknown';
  if (vueDeps.vue) {
    vueVersion = vueDeps.vue.startsWith('3') ? '3.x' : '2.x';
  }
  
  // Detect build tool
  let buildTool: 'vite' | 'webpack' | 'nuxt' = 'webpack';
  if (devDeps.vite || vueDeps.vite) buildTool = 'vite';
  if (vueDeps.nuxt) buildTool = 'nuxt';
  
  // Detect state management
  let stateManagement: 'pinia' | 'vuex' | 'none' = 'none';
  if (vueDeps.pinia) stateManagement = 'pinia';
  else if (vueDeps.vuex) stateManagement = 'vuex';
  
  // Detect TypeScript usage
  let typescriptUsage: 'full' | 'partial' | 'none' = 'none';
  const hasTSConfig = await checkFileExists(`${rootPath}/tsconfig.json`);
  if (hasTSConfig) {
    const hasVuePlugin = devDeps['@vitejs/plugin-vue'];
    typescriptUsage = hasVuePlugin ? 'full' : 'partial';
  }
  
  return {
    vueVersion,
    buildTool,
    stateManagement,
    styleSystem: 'scoped',
    typescriptUsage,
    issues: checkStructureIssues(vueVersion, stateManagement, buildTool)
  };
}

function checkStructureIssues(
  vueVersion: string,
  stateManagement: string,
  buildTool: string
): StructureIssue[] {
  const issues: StructureIssue[] = [];
  
  if (vueVersion === '2.x') {
    issues.push({
      type: 'vue2_project',
      severity: 'high',
      message: 'Consider migrating to Vue 3 for Composition API and better TypeScript support'
    });
  }
  
  if (buildTool === 'webpack' && vueVersion === '3.x') {
    issues.push({
      type: 'legacy_build_tool',
      severity: 'medium',
      message: 'Consider migrating to Vite for better DX and build performance'
    });
  }
  
  if (stateManagement === 'vuex') {
    issues.push({
      type: 'vuex_usage',
      severity: 'medium',
      message: 'Vuex is in maintenance mode - consider migrating to Pinia'
    });
  }
  
  return issues;
}
```

### Bước 2: Component Analysis

```typescript
// Analyze Vue components
interface ComponentAnalysis {
  components: ComponentInfo[];
  options_api_count: number;
  composition_api_count: number;
  script_setup_count: number;
  issues: ComponentIssue[];
}

async function analyzeComponents(
  componentsPath: string
): Promise<ComponentAnalysis> {
  const files = await glob('**/*.{vue,tsx}', { cwd: componentsPath });
  const components: ComponentInfo[] = [];
  const issues: ComponentIssue[] = [];
  
  let optionsApiCount = 0;
  let compositionApiCount = 0;
  let scriptSetupCount = 0;
  
  for (const file of files) {
    const content = await readFile(file);
    const parsed = parseVueComponent(content);
    
    const info: ComponentInfo = {
      name: parsed.name,
      file,
      type: parsed.type,
      props: parsed.props,
      emits: parsed.emits,
      slots: parsed.slots,
      refs: parsed.refs,
      computed: parsed.computed,
      methods: parsed.methods,
      lifecycleHooks: parsed.lifecycleHooks,
      composables: parsed.composables,
      storeUsage: parsed.storeUsage,
      lineCount: parsed.lineCount
    };
    
    components.push(info);
    
    // Count by API style
    if (parsed.type === 'options') optionsApiCount++;
    if (parsed.type === 'composition') compositionApiCount++;
    if (parsed.type === 'script-setup') scriptSetupCount++;
    
    // Check for issues
    if (parsed.type === 'options' && parsed.lineCount > 300) {
      issues.push({
        type: 'fat_component',
        file,
        severity: 'medium',
        message: `Large Options API component (${parsed.lineCount} lines) - consider Composition API`
      });
    }
    
    if (parsed.type === 'script-setup' && parsed.refs > 10) {
      issues.push({
        type: 'too_many_refs',
        file,
        severity: 'low',
        message: 'Consider grouping related refs into objects'
      });
    }
    
    if (!parsed.emits && parsed.type !== 'script-setup') {
      issues.push({
        type: 'missing_emits',
        file,
        severity: 'low',
        message: 'Component should define emits for better type safety'
      });
    }
  }
  
  return {
    components,
    options_api_count: optionsApiCount,
    composition_api_count: compositionApiCount,
    script_setup_count: scriptSetupCount,
    issues
  };
}

function parseVueComponent(content: string): ParsedVueComponent {
  const hasScriptSetup = content.includes('<script setup>');
  const hasComposition = content.includes('setup()') || content.includes('setup (');
  const hasOptions = content.includes('export default {');
  
  let type: 'script-setup' | 'composition' | 'options' = 'options';
  if (hasScriptSetup) type = 'script-setup';
  else if (hasComposition) type = 'composition';
  
  return {
    name: extractComponentName(content),
    type,
    props: extractProps(content),
    emits: extractEmits(content),
    slots: extractSlots(content),
    refs: countRefs(content),
    computed: countComputed(content),
    methods: countMethods(content),
    lifecycleHooks: extractLifecycleHooks(content),
    composables: extractComposables(content),
    storeUsage: extractStoreUsage(content),
    lineCount: content.split('\n').length
  };
}
```

### Bước 3: State Management Review

```typescript
// Review Pinia/Vuex stores
interface StoreAnalysis {
  stores: StoreInfo[];
  stateIssues: StateIssue[];
  actionIssues: ActionIssue[];
  getterIssues: GetterIssue[];
  recommendations: StoreRecommendation[];
}

async function analyzeStores(
  storePath: string
): Promise<StoreAnalysis> {
  const files = await glob('**/*.{ts,js}', { cwd: storePath });
  const stores: StoreInfo[] = [];
  const stateIssues: StateIssue[] = [];
  const actionIssues: ActionIssue[] = [];
  const getterIssues: GetterIssue[] = [];
  
  for (const file of files) {
    const content = await readFile(file);
    const parsed = parseStore(content, file);
    
    stores.push({
      name: parsed.name,
      file,
      state: parsed.state,
      getters: parsed.getters,
      actions: parsed.actions,
      isPinia: parsed.isPinia,
      isSetup: parsed.isSetup,
      plugins: parsed.plugins
    });
    
    // Check for issues
    for (const [key, value] of Object.entries(parsed.state)) {
      if (typeof value === 'object' && value !== null && !Array.isArray(value)) {
        stateIssues.push({
          type: 'nested_object_state',
          store: parsed.name,
          key,
          severity: 'low',
          message: 'Consider flattening nested state for better reactivity'
        });
      }
    }
    
    for (const action of parsed.actions) {
      if (action.async && !action.hasErrorHandling) {
        actionIssues.push({
          type: 'missing_error_handling',
          store: parsed.name,
          action: action.name,
          severity: 'medium',
          message: 'Async action should handle errors with try/catch'
        });
      }
      
      if (action.mutations > 5) {
        actionIssues.push({
          type: 'complex_action',
          store: parsed.name,
          action: action.name,
          severity: 'low',
          message: 'Complex action - consider breaking into smaller actions'
        });
      }
    }
  }
  
  return {
    stores,
    stateIssues,
    actionIssues,
    getterIssues,
    recommendations: generateStoreRecommendations(stores)
  };
}

function parseStore(content: string, file: string): ParsedStore {
  const isPinia = content.includes('defineStore');
  const isSetup = content.includes('setup()') || content.includes('setup (');
  
  return {
    name: extractStoreName(content, file),
    isPinia,
    isSetup,
    state: extractState(content),
    getters: extractGetters(content),
    actions: extractActions(content),
    plugins: extractPlugins(content)
  };
}
```

### Bước 4: Composables Analysis

```typescript
// Analyze reusable composables
interface ComposableAnalysis {
  composables: ComposableInfo[];
  unusedComposables: string[];
  duplicateLogic: DuplicateLogic[];
  recommendations: ComposableRecommendation[];
}

async function analyzeComposables(
  composablesPath: string,
  componentsPath: string
): Promise<ComposableAnalysis> {
  const files = await glob('**/*.ts', { cwd: composablesPath });
  const composables: ComposableInfo[] = [];
  
  // Find all composables
  for (const file of files) {
    const content = await readFile(file);
    const info = parseComposable(content, file);
    composables.push(info);
  }
  
  // Find usage in components
  const componentFiles = await glob('**/*.vue', { cwd: componentsPath });
  const usageMap = await findComposableUsage(composables, componentFiles);
  
  // Check for unused composables
  const unusedComposables = composables
    .filter(c => !usageMap.has(c.name))
    .map(c => c.name);
  
  // Check for duplicate logic
  const duplicateLogic = findDuplicateLogic(composables);
  
  return {
    composables,
    unusedComposables,
    duplicateLogic,
    recommendations: generateComposableRecommendations(composables, usageMap)
  };
}

function parseComposable(content: string, file: string): ComposableInfo {
  const lines = content.split('\n');
  const usesRefs = content.includes('ref(') || content.includes('reactive(');
  const usesWatch = content.includes('watch(') || content.includes('watchEffect(');
  const hasReturn = content.includes('return {');
  
  return {
    name: extractComposableName(file),
    file,
    usesRefs,
    usesWatch,
    returns: extractReturnStatements(content),
    hasReturn,
    parameters: extractParameters(content),
    lineCount: lines.length
  };
}
```

### Bước 5: Performance Analysis

```typescript
// Analyze Vue performance patterns
interface VuePerformanceAnalysis {
  reactive_issues: ReactiveIssue[];
  render_issues: RenderIssue[];
  bundle_issues: BundleIssue[];
  recommendations: PerformanceRecommendation[];
}

async function analyzeVuePerformance(
  rootPath: string
): Promise<VuePerformanceAnalysis> {
  const components = await glob('**/*.vue', { cwd: rootPath });
  const reactiveIssues: ReactiveIssue[] = [];
  const renderIssues: RenderIssue[] = [];
  const bundleIssues: BundleIssue[] = [];
  
  for (const component of components) {
    const content = await readFile(component);
    
    // Check for deep reactive on large objects
    if (content.includes('reactive(') || content.includes('toRaw(')) {
      const match = content.match(/reactive\(([^)]+)\)/);
      if (match) {
        reactiveIssues.push({
          type: 'deep_reactive',
          file: component,
          variable: match[1],
          severity: 'medium',
          message: 'Consider using shallowRef for large objects'
        });
      }
    }
    
    // Check for inline arrow functions in template
    if (content.includes('@click="') && content.includes('=>')) {
      renderIssues.push({
        type: 'inline_arrow_function',
        file: component,
        severity: 'low',
        message: 'Consider using methods instead of inline arrow functions'
      });
    }
    
    // Check for v-for without key
    if (content.includes('v-for=') && !content.includes(':key=')) {
      renderIssues.push({
        type: 'missing_key',
        file: component,
        severity: 'high',
        message: 'v-for should always have a :key attribute'
      });
    }
    
    // Check for array index as key
    const indexKeyMatches = content.match(/v-for="\([^)]+,\s*(\w+)\s*\)/g);
    if (indexKeyMatches && content.includes(`:key="${indexKeyMatches[0].match(/\((\w+)/)?.[1]}"`)) {
      renderIssues.push({
        type: 'index_as_key',
        file: component,
        severity: 'medium',
        message: 'Using array index as :key can cause issues with reordering'
      });
    }
  }
  
  return {
    reactive_issues: reactiveIssues,
    render_issues: renderIssues,
    bundle_issues: bundleIssues,
    recommendations: generateVuePerformanceRecommendations(reactiveIssues, renderIssues)
  };
}
```

### Bước 6: Vue Router Review

```typescript
// Review Vue Router configuration
interface RouterAnalysis {
  routes: RouteInfo[];
  issues: RouteIssue[];
  lazy_loading: LazyLoadingAnalysis;
}

async function analyzeRouter(
  routerPath: string
): Promise<RouterAnalysis> {
  const files = await glob('**/*.{ts,js}', { cwd: routerPath });
  const routes: RouteInfo[] = [];
  const issues: RouteIssue[] = [];
  
  for (const file of files) {
    const content = await readFile(file);
    const parsed = parseRoutes(content);
    
    routes.push(...parsed);
    
    for (const route of parsed) {
      // Check for missing lazy loading
      if (!route.lazy && route.component && !route.component.includes('()')) {
        issues.push({
          type: 'missing_lazy_loading',
          path: route.path,
          severity: 'low',
          message: 'Consider lazy loading this route for better initial load'
        });
      }
      
      // Check for catch-all routes
      if (route.path === '*') {
        issues.push({
          type: 'catch_all_route',
          path: '*',
          severity: 'low',
          message: 'Use path: "/:pathMatch(.*)*" for better 404 handling'
        });
      }
      
      // Check for meta requirements
      if (!route.meta && route.requiresAuth) {
        issues.push({
          type: 'missing_meta',
          path: route.path,
          severity: 'medium',
          message: 'Add meta fields for auth requirements'
        });
      }
    }
  }
  
  return {
    routes,
    issues,
    lazy_loading: analyzeLazyLoading(routes)
  };
}
```

## Checklist (Danh sách kiểm tra)

- [ ] Using Vue 3 Composition API (preferred)
- [ ] Script Setup syntax for new components
- [ ] Proper TypeScript typing
- [ ] Pinia for state management (not Vuex)
- [ ] Composables for reusable logic
- [ ] Proper props and emits definition
- [ ] v-for with :key
- [ ] Async components lazy loaded
- [ ] Error boundaries implemented
- [ ] Route guards for auth
- [ ] Proper async/await error handling
- [ ] Watch vs watchEffect correctly used
- [ ] Computed properties for derived state
- [ ] No direct store mutation (use actions)
- [ ] Proper provide/inject usage

## Examples (Ví dụ)

### Ví dụ 1: Migration to Composition API

```vue
<!-- ❌ BEFORE: Options API -->
<template>
  <div>
    <p>{{ message }}</p>
    <button @click="increment">Count: {{ count }}</button>
  </div>
</template>

<script>
export default {
  data() {
    return {
      message: 'Hello',
      count: 0
    }
  },
  computed: {
    doubleCount() {
      return this.count * 2
    }
  },
  methods: {
    increment() {
      this.count++
    }
  },
  mounted() {
    console.log('Component mounted')
  }
}
</script>

<!-- ✅ AFTER: Composition API with Script Setup -->
<template>
  <div>
    <p>{{ message }}</p>
    <button @click="increment">Count: {{ count }}</button>
    <p>Double: {{ doubleCount }}</p>
  </div>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'

const message = 'Hello'
const count = ref(0)

const doubleCount = computed(() => count.value * 2)

const increment = () => {
  count.value++
}

onMounted(() => {
  console.log('Component mounted')
})
</script>
```

### Ví dụ 2: Proper Store Usage

```typescript
// ❌ BEFORE: Direct store mutation
const userStore = useUserStore()

// In component
userStore.user.name = 'New Name' // Direct mutation!
userStore.loading = true // Direct mutation!

// ✅ AFTER: Using actions
// In store
export const useUserStore = defineStore('user', () => {
  const user = ref<User | null>(null)
  const loading = ref(false)
  
  async function fetchUser(id: string) {
    loading.value = true
    try {
      user.value = await api.getUser(id)
    } finally {
      loading.value = false
    }
  }
  
  async function updateUser(name: string) {
    await api.updateUser(user.value!.id, { name })
    user.value = { ...user.value!, name }
  }
  
  return { user, loading, fetchUser, updateUser }
})

// In component
const userStore = useUserStore()
await userStore.fetchUser(id)
await userStore.updateUser('New Name')
```

## Anti Patterns (Các pattern cần tránh)

### 1. Options vs Composition Mixing
```vue
<!-- ❌ BAD: Inconsistent patterns -->
<template>
  <div>{{ message }}</div>
</template>

<script>
import { ref } from 'vue'

export default {
  setup() {
    const message = ref('Hello')
    return { message }
  },
  data() {
    return {
      other: 'data'
    }
  }
}
</script>

<!-- ✅ GOOD: Consistent Composition API -->
<template>
  <div>{{ message }}</div>
</template>

<script setup lang="ts">
const message = ref('Hello')
</script>
```

### 2. Props Drilling
```vue
<!-- ❌ BAD: Deep prop drilling -->
<Parent>
  <GrandParent>
    <Parent>
      <Child :prop="prop" /> <!-- 3 levels deep! -->
    </Parent>
  </GrandParent>
</Parent>

<!-- ✅ GOOD: Provide/Inject or Pinia -->
// Provide in Parent
const prop = inject('prop')

// Or use Pinia store
const store = useStore()
```

### 3. v-for without Key
```vue
<!-- ❌ BAD: Missing key -->
<div v-for="item in items">
  {{ item.name }}
</div>

<!-- ✅ GOOD: Proper key -->
<div v-for="item in items" :key="item.id">
  {{ item.name }}
</div>
```

### 4. Reactive Overhead
```typescript
// ❌ BAD: Deep reactive on large object
const bigObject = reactive(largeData)

// ✅ GOOD: shallowRef for large objects
const bigObject = shallowRef(largeData)
// When you need to update:
bigObject.value = newData
```

### 5. Not Using Teleport
```vue
<!-- ❌ BAD: Nested modal -->
<template>
  <Parent>
    <Modal /> <!-- Fixed positioning breaks! -->
  </Parent>
</template>

<!-- ✅ GOOD: Teleport to body -->
<template>
  <Parent />
  <Teleport to="body">
    <Modal />
  </Teleport>
</template>
```

## Best Practices (Thực hành tốt nhất)

1. **Use Script Setup**: Cleaner syntax, better performance
2. **Type everything**: Full TypeScript for better DX
3. **Composables over Mixins**: Better composition
4. **Pinia over Vuex**: Official recommendation
5. **Lazy load routes**: For better initial load
6. **Use shallowRef**: For large data structures
7. **Proper key in v-for**: Always use unique keys
8. **Async components**: For heavy components
9. **Error boundaries**: Handle errors gracefully
10. **Keep components small**: Extract logic to composables

