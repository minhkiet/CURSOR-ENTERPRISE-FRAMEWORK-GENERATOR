## Workflow (Quy trình)

### Bước 1: Strategic Analysis

```typescript
// Strategic DDD - Bounded Contexts
interface BoundedContext {
  name: string;
  description: string;
  core_domain_concepts: Concept[];
  responsibilities: string[];
  external_dependencies: ContextDependency[];
  upstream: string[];
  downstream: string[];
  team: string;
}

interface ContextMap {
  contexts: BoundedContext[];
  relationships: ContextRelationship[];
  integration_patterns: IntegrationPattern[];
}

async function identifyBoundedContexts(
  requirements: Requirement[],
  domainExperts: DomainExpert[]
): Promise<BoundedContext[]> {
  // 1. Identify core domains through domain storming
  const coreDomains = await performDomainStorming(requirements, domainExperts);
  
  // 2. Separate core from supporting subdomains
  const { core, supporting, generic } = classifySubdomains(coreDomains);
  
  // 3. Define bounded contexts
  const contexts: BoundedContext[] = [];
  
  for (const domain of core) {
    const context: BoundedContext = {
      name: domain.name,
      description: domain.description,
      core_domain_concepts: domain.concepts,
      responsibilities: domain.responsibilities,
      external_dependencies: domain.externalDependencies,
      upstream: domain.upstream || [],
      downstream: domain.downstream || [],
      team: domain.team || 'team-default'
    };
    contexts.push(context);
  }
  
  return contexts;
}

function classifySubdomains(domains: Domain[]): SubdomainClassification {
  return {
    core: domains.filter(d => d.type === 'core'),
    supporting: domains.filter(d => d.type === 'supporting'),
    generic: domains.filter(d => d.type === 'generic')
  };
}
```

### Bước 2: Tactical Design - Entities và Value Objects

```typescript
// Tactical DDD - Entities và Value Objects
interface Entity {
  id: string;
  attributes: Attribute[];
  invariants: Invariant[];
  methods: Method[];
  lifecycle_events: DomainEvent[];
}

interface ValueObject {
  attributes: Attribute[];
  validation_rules: ValidationRule[];
  immutability: boolean;
  equality: EqualityDefinition;
}

class OrderEntity implements Entity {
  readonly id: OrderId;
  private status: OrderStatus;
  private items: OrderItem[];
  private customerId: CustomerId;
  private shippingAddress: Address;
  private createdAt: DateTime;
  private updatedAt: DateTime;
  
  // Invariants
  private invariants: Invariant[] = [
    {
      name: 'order_must_have_at_least_one_item',
      check: () => this.items.length > 0
    },
    {
      name: 'order_total_must_be_positive',
      check: () => this.calculateTotal().isGreaterThan(Money.zero())
    },
    {
      name: 'cannot_modify_completed_order',
      check: () => this.status !== OrderStatus.COMPLETED
    }
  ];
  
  // Aggregate root methods
  addItem(product: Product, quantity: Quantity): void {
    this.assertInvariants();
    
    const existingItem = this.items.find(i => i.productId.equals(product.id));
    if (existingItem) {
      existingItem.increaseQuantity(quantity);
    } else {
      this.items.push(OrderItem.create(product, quantity));
    }
    
    this.updatedAt = DateTime.now();
    this.addDomainEvent(new OrderItemAdded(this.id, product.id, quantity));
  }
  
  removeItem(productId: ProductId): void {
    this.assertInvariants();
    
    const index = this.items.findIndex(i => i.productId.equals(productId));
    if (index === -1) {
      throw new DomainException('Item not found in order');
    }
    
    this.items.splice(index, 1);
    this.updatedAt = DateTime.now();
    this.addDomainEvent(new OrderItemRemoved(this.id, productId));
  }
  
  complete(): void {
    this.assertInvariants();
    this.status = OrderStatus.COMPLETED;
    this.addDomainEvent(new OrderCompleted(this.id, this.calculateTotal()));
  }
  
  private assertInvariants(): void {
    for (const invariant of this.invariants) {
      if (!invariant.check()) {
        throw new InvariantViolation(invariant.name);
      }
    }
  }
}

// Value Object Example
class Money extends ValueObject {
  constructor(
    private readonly amount: number,
    private readonly currency: Currency
  ) {
    super();
    this.validate();
  }
  
  protected get validationRules(): ValidationRule[] {
    return [
      { field: 'amount', rule: 'amount >= 0', message: 'Amount must be non-negative' }
    ];
  }
  
  isGreaterThan(other: Money): boolean {
    this.assertSameCurrency(other);
    return this.amount > other.amount;
  }
  
  add(other: Money): Money {
    this.assertSameCurrency(other);
    return new Money(this.amount + other.amount, this.currency);
  }
  
  private assertSameCurrency(other: Money): void {
    if (!this.currency.equals(other.currency)) {
      throw new DomainException('Cannot operate on different currencies');
    }
}
```

### Bước 3: Aggregate Design

```typescript
// Aggregate Design
interface Aggregate {
  root: Entity;
  entities: Entity[];
  value_objects: ValueObject[];
  repositories: Repository[];
  domain_services: DomainService[];
  factories: Factory[];
}

interface AggregateBoundary {
  consistency_rule: string;
  transaction_boundary: boolean;
  cluster_rule: string;
}

function designAggregate(
  context: BoundedContext,
  entities: Entity[],
  businessRules: BusinessRule[]
): Aggregate[] {
  // 1. Identify aggregate roots
  const aggregateRoots = identifyAggregateRoots(entities, businessRules);
  
  // 2. Cluster related entities
  const clusters = clusterEntities(entities, businessRules);
  
  // 3. Define aggregate boundaries
  const aggregates: Aggregate[] = [];
  
  for (const cluster of clusters) {
    const root = findAggregateRoot(cluster);
    
    aggregates.push({
      root,
      entities: cluster.entities,
      value_objects: cluster.valueObjects,
      repositories: [createRepository(root)],
      domain_services: [],
      factories: [createFactory(root)]
    });
  }
  
  return aggregates;
}

function identifyAggregateRoots(
  entities: Entity[],
  businessRules: BusinessRule[]
): Entity[] {
  const roots: Entity[] = [];
  
  for (const entity of entities) {
    // Entity is aggregate root if:
    // 1. Other entities reference it directly
    const referencedBy = businessRules.filter(r => 
      r.references.includes(entity.id) && r.isExternalReference
    );
    
    // 2. It's the entry point for business operations
    const isOperationEntry = businessRules.some(r =>
      r.entryPoint === entity.id
    );
    
    // 3. It's responsible for enforcing invariants
    const enforcesInvariants = businessRules.some(r =>
      r.invariantEnforcer === entity.id
    );
    
    if (referencedBy.length > 0 || isOperationEntry || enforcesInvariants) {
      roots.push(entity);
    }
  }
  
  return roots;
}

function clusterEntities(
  entities: Entity[],
  rules: BusinessRule[]
): EntityCluster[] {
  const clusters: EntityCluster[] = [];
  const clustered = new Set<string>();
  
  for (const root of identifyAggregateRoots(entities, rules)) {
    const clusterEntities = new Set<Entity>([root]);
    
    // Find entities that belong to this cluster
    for (const entity of entities) {
      if (clustered.has(entity.id)) continue;
      
      if (belongsToAggregate(entity, root, rules)) {
        clusterEntities.add(entity);
        clustered.add(entity.id);
      }
    }
    
    clusters.push({
      root,
      entities: [...clusterEntities],
      valueObjects: findValueObjectsForEntities([...clusterEntities])
    });
  }
  
  return clusters;
}
```

### Bước 4: Domain Events Design

```typescript
// Domain Events
interface DomainEvent {
  eventId: string;
  occurredAt: DateTime;
  eventType: string;
  aggregateId: string;
  payload: Record<string, any>;
  metadata: EventMetadata;
}

class OrderCreated implements DomainEvent {
  readonly eventType = 'OrderCreated';
  readonly occurredAt: DateTime;
  
  constructor(
    public readonly orderId: OrderId,
    public readonly customerId: CustomerId,
    public readonly shippingAddress: Address
  ) {
    this.occurredAt = DateTime.now();
  }
  
  toEventRecord(): EventRecord {
    return {
      eventId: EventId.generate(),
      eventType: this.eventType,
      occurredAt: this.occurredAt,
      aggregateId: this.orderId.value,
      payload: {
        customerId: this.customerId.value,
        shippingAddress: this.shippingAddress.toJSON()
      }
    };
  }
}

// Event Sourcing Aggregate
class OrderAggregate {
  private events: DomainEvent[] = [];
  private _id: OrderId;
  private _status: OrderStatus;
  private _items: OrderItem[] = [];
  
  constructor(orderId?: OrderId) {
    this._id = orderId || OrderId.generate();
    this._status = OrderStatus.CREATED;
  }
  
  // Reconstitute from events
  static fromEvents(events: DomainEvent[]): OrderAggregate {
    const order = new OrderAggregate();
    for (const event of events) {
      order.apply(event);
    }
    return order;
  }
  
  // Event sourcing handlers
  private apply(event: DomainEvent): void {
    switch (event.constructor.name) {
      case 'OrderCreated':
        this.applyOrderCreated(event as OrderCreated);
        break;
      case 'OrderItemAdded':
        this.applyOrderItemAdded(event as OrderItemAdded);
        break;
      case 'OrderCompleted':
        this.applyOrderCompleted(event as OrderCompleted);
        break;
    }
    this.events.push(event);
  }
  
  private applyOrderCreated(event: OrderCreated): void {
    this._id = event.orderId;
    this._status = OrderStatus.CREATED;
  }
  
  private applyOrderItemAdded(event: OrderItemAdded): void {
    const item = OrderItem.reconstitute(event.productId, event.quantity);
    this._items.push(item);
  }
  
  private applyOrderCompleted(event: OrderCompleted): void {
    this._status = OrderStatus.COMPLETED;
  }
  
  // Command methods
  addItem(product: Product, quantity: Quantity): void {
    this.assertCanModify();
    const event = new OrderItemAdded(this._id, product.id, quantity);
    this.apply(event);
  }
  
  complete(): void {
    this.assertCanModify();
    const event = new OrderCompleted(this._id, this.calculateTotal());
    this.apply(event);
  }
  
  getUncommittedEvents(): DomainEvent[] {
    return [...this.events];
  }
}
```

### Bước 5: Context Map Design

```typescript
// Context Map - Integration patterns
interface ContextRelationship {
  source: string;
  target: string;
  pattern: IntegrationPattern;
  description: string;
  contract: Contract;
}

type IntegrationPattern = 
  | 'shared_kernel'
  | 'customer_supplier'
  | 'conformist'
  | 'anticorruption_layer'
  | 'open_host_service'
  | 'published_language'
  | 'separate_ways';

function designContextMap(
  contexts: BoundedContext[]
): ContextMap {
  const relationships: ContextRelationship[] = [];
  
  for (const context of contexts) {
    // Determine relationship patterns
    for (const dep of context.external_dependencies) {
      const targetContext = contexts.find(c => c.name === dep.context);
      if (!targetContext) continue;
      
      const relationship = determineRelationship(context, targetContext, dep);
      relationships.push(relationship);
    }
  }
  
  return {
    contexts,
    relationships,
    integration_patterns: identifyPatterns(relationships)
  };
}

function determineRelationship(
  source: BoundedContext,
  target: BoundedContext,
  dependency: ContextDependency
): ContextRelationship {
  // If both teams work together, use Customer-Supplier
  if (dependency.teamCollaboration === 'high') {
    return {
      source: source.name,
      target: target.name,
      pattern: 'customer_supplier',
      description: `${source.name} is customer, ${target.name} is supplier`,
      contract: defineContract(source, target)
    };
  }
  
  // If source depends on legacy, use Anticorruption Layer
  if (dependency.isLegacy) {
    return {
      source: source.name,
      target: target.name,
      pattern: 'anticorruption_layer',
      description: 'ACL to protect domain from legacy system',
      contract: defineACLContract(source, target)
    };
  }
  
  // Default to Published Language
  return {
    source: source.name,
    target: target.name,
    pattern: 'published_language',
    description: 'Well-defined API contract',
    contract: definePublishedLanguageContract(source, target)
  };
}
```

## Checklist (Danh sách kiểm tra)

- [ ] Bounded contexts clearly defined
- [ ] Ubiquitous language documented
- [ ] Aggregates have clear boundaries
- [ ] Aggregate roots identified correctly
- [ ] Invariants enforced within aggregates
- [ ] Value objects used for non-identity concepts
- [ ] Domain events defined for state changes
- [ ] Context map shows integration patterns
- [ ] Anti-corruption layers for external systems
- [ ] Domain services appropriately scoped
- [ ] Repositories abstracted from persistence
- [ ]Factories for complex creation
- [ ] Teams aligned with bounded contexts
- [ ] Continuous integration between contexts defined

