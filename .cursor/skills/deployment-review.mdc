## Workflow (Quy trình)

### Bước 1: Pipeline Architecture Review

```typescript
// Review CI/CD pipeline architecture
interface PipelineAssessment {
  stages: StageInfo[];
  gates: GateInfo[];
  parallelization: ParallelizationAnalysis;
  issues: PipelineIssue[];
}

interface StageInfo {
  name: string;
  steps: StepInfo[];
  duration: Duration;
  can_skip: boolean;
  failures_30d: number;
}

async function assessPipeline(
  config: CICDConfig
): Promise<PipelineAssessment> {
  const stages = parseStages(config);
  const gates = identifyGates(config);
  
  // Check for proper parallelization
  const parallelization = analyzeParallelization(stages);
  
  const issues: PipelineIssue[] = [];
  
  // Check for sequential stages that could be parallel
  for (const stage of stages) {
    if (stage.depends_on?.length > 0 && !stage.parallel_with?.length) {
      // Check if this stage could run in parallel with others
    }
  }
  
  // Check for missing gates
  if (!gates.find(g => g.type === 'security_scan')) {
    issues.push({
      type: 'missing_security_gate',
      severity: 'high',
      message: 'Pipeline should include security scanning stage'
    });
  }
  
  if (!gates.find(g => g.type === 'approval')) {
    issues.push({
      type: 'missing_approval_gate',
      severity: 'medium',
      message: 'Consider adding approval gate for production deployments'
    });
  }
  
  return { stages, gates, parallelization, issues };
}

function analyzeParallelization(
  stages: StageInfo[]
): ParallelizationAnalysis {
  const totalDuration = stages.reduce(
    (sum, s) => sum + s.duration.seconds, 
    0
  );
  
  const parallelDuration = calculateParallelDuration(stages);
  
  return {
    total_duration_seconds: totalDuration,
    parallel_duration_seconds: parallelDuration,
    efficiency_ratio: parallelDuration / totalDuration,
    potential_improvement_seconds: totalDuration - parallelDuration
  };
}
```

### Bước 2: Security Review

```typescript
// Review deployment security
interface DeploymentSecurityReview {
  secrets_management: SecretsReview;
  access_control: AccessControlReview;
  scanning: SecurityScanning;
  compliance: ComplianceReview;
  issues: SecurityIssue[];
}

async function reviewDeploymentSecurity(
  config: CICDConfig
): Promise<DeploymentSecurityReview> {
  const secretsReview = await reviewSecretsManagement(config);
  const accessReview = await reviewAccessControl(config);
  const scanning = await reviewSecurityScanning(config);
  
  const issues: SecurityIssue[] = [];
  
  // Check for secrets in code
  if (config.has_secrets_in_code) {
    issues.push({
      type: 'secrets_in_code',
      severity: 'critical',
      message: 'Secrets found in code - use secrets manager'
    });
  }
  
  // Check for hardcoded credentials
  if (config.has_hardcoded_credentials) {
    issues.push({
      type: 'hardcoded_credentials',
      severity: 'critical',
      message: 'Hardcoded credentials detected'
    });
  }
  
  // Check for plaintext secrets
  if (config.has_plaintext_secrets) {
    issues.push({
      type: 'plaintext_secrets',
      severity: 'high',
      message: 'Secrets stored in plaintext - encrypt them'
    });
  }
  
  return {
    secrets_management: secretsReview,
    access_control: accessReview,
    scanning,
    compliance: await reviewCompliance(config),
    issues
  };
}

async function reviewSecretsManagement(
  config: CICDConfig
): Promise<SecretsReview> {
  return {
    provider: config.secrets?.provider || 'unknown',
    rotation_enabled: config.secrets?.rotation || false,
    encryption_at_rest: config.secrets?.encrypted || false,
    audit_logging: config.secrets?.audit || false,
    issues: []
  };
}
```

### Bước 3: Environment Configuration Review

```typescript
// Review environment configurations
interface EnvironmentReview {
  environments: EnvironmentInfo[];
  consistency: ConsistencyAnalysis;
  drift: DriftAnalysis;
  issues: EnvironmentIssue[];
}

interface EnvironmentInfo {
  name: string;
  type: 'development' | 'staging' | 'production';
  configuration: ConfigSnapshot;
  differences_from_production: string[];
  auto_scaling: AutoScalingConfig;
  issues: string[];
}

async function reviewEnvironments(
  config: EnvironmentConfig
): Promise<EnvironmentReview> {
  const environments = parseEnvironments(config);
  const consistency = analyzeConsistency(environments);
  const drift = await analyzeDrift(environments);
  
  const issues: EnvironmentIssue[] = [];
  
  // Check for production drift
  const production = environments.find(e => e.type === 'production');
  for (const env of environments) {
    if (env.type !== 'production') {
      const differences = compareEnvironments(env, production);
      if (differences.critical.length > 0) {
        issues.push({
          type: 'critical_drift',
          environment: env.name,
          differences: differences.critical,
          severity: 'high'
        });
      }
    }
  }
  
  return { environments, consistency, drift, issues };
}

function analyzeConsistency(
  environments: EnvironmentInfo[]
): ConsistencyAnalysis {
  const configs = environments.map(e => JSON.stringify(e.configuration));
  const unique = new Set(configs);
  
  return {
    consistent: unique.size === 1,
    environment_count: environments.length,
    unique_configurations: unique.size,
    differences: identifyCommonDifferences(environments)
  };
}
```

### Bước 4: Deployment Strategy Review

```typescript
// Review deployment strategies
interface DeploymentStrategyReview {
  current_strategy: DeploymentStrategy;
  strategies: StrategyInfo[];
  canary_analysis: CanaryAnalysis;
  blue_green: BlueGreenAnalysis;
  rolling: RollingAnalysis;
  issues: StrategyIssue[];
}

type DeploymentStrategy = 'rolling' | 'blue_green' | 'canary' | 'recreate';

async function reviewDeploymentStrategies(
  config: DeploymentConfig
): Promise<DeploymentStrategyReview> {
  const strategy = detectStrategy(config);
  const canaryAnalysis = await analyzeCanary(config);
  const blueGreen = analyzeBlueGreen(config);
  const rolling = analyzeRolling(config);
  
  const issues: StrategyIssue[] = [];
  
  // Production should use safer strategies
  if (strategy === 'recreate' && config.production) {
    issues.push({
      type: 'risky_production_strategy',
      severity: 'high',
      message: 'Recreate strategy causes downtime - not recommended for production'
    });
  }
  
  // Check for canary in production
  if (strategy !== 'canary' && strategy !== 'blue_green') {
    issues.push({
      type: 'no_gradual_rollout',
      severity: 'medium',
      message: 'Consider gradual rollout strategies for production'
    });
  }
  
  return {
    current_strategy: strategy,
    strategies: [],
    canary_analysis: canaryAnalysis,
    blue_green: blueGreen,
    rolling: rolling,
    issues
  };
}

function analyzeCanary(
  config: DeploymentConfig
): CanaryAnalysis {
  return {
    enabled: config.canary?.enabled || false,
    percentage: config.canary?.percentage || 0,
    auto_rollback: config.canary?.autoRollback || false,
    metrics_for_rollback: config.canary?.metrics || [],
    issues: []
  };
}
```

### Bước 5: Rollback Review

```typescript
// Review rollback procedures
interface RollbackReview {
  capabilities: RollbackCapabilities;
  automated_rollback: boolean;
  average_rollback_time: Duration;
  tested_rollbacks: number;
  issues: RollbackIssue[];
}

async function reviewRollbackProcedures(
  config: DeploymentConfig
): Promise<RollbackReview> {
  const capabilities = assessRollbackCapabilities(config);
  const history = await getDeploymentHistory(config);
  
  const issues: RollbackIssue[] = [];
  
  // Check for automated rollback
  if (!capabilities.automated) {
    issues.push({
      type: 'no_automated_rollback',
      severity: 'high',
      message: 'Automated rollback not configured'
    });
  }
  
  // Check rollback time
  const avgRollbackTime = calculateAvgRollbackTime(history.rollbacks);
  if (avgRollbackTime.seconds > 300) { // > 5 minutes
    issues.push({
      type: 'slow_rollback',
      severity: 'medium',
      message: `Average rollback time is ${formatDuration(avgRollbackTime)}`
    });
  }
  
  // Check for tested rollbacks
  if (config.rollback_tests < 1) {
    issues.push({
      type: 'untested_rollback',
      severity: 'medium',
      message: 'Rollback procedures not tested'
    });
  }
  
  return {
    capabilities,
    automated_rollback: capabilities.automated,
    average_rollback_time: avgRollbackTime,
    tested_rollbacks: config.rollback_tests || 0,
    issues
  };
}

function assessRollbackCapabilities(
  config: DeploymentConfig
): RollbackCapabilities {
  return {
    automated: config.rollback?.automated || false,
    version_based: config.rollback?.versionBased || false,
    state_based: config.rollback?.stateBased || false,
    database_migrations: config.rollback?.databaseMigrations || false,
    can_rollback_in_progress: config.rollback?.inProgress || false
  };
}
```

## Checklist (Danh sách kiểm tra)

- [ ] Pipeline has proper stages (build, test, deploy)
- [ ] Security scanning in pipeline (SAST, DAST, SCA)
- [ ] Secrets managed securely (Vault, AWS Secrets, etc.)
- [ ] No hardcoded credentials
- [ ] Environment parity (dev, staging, prod similar)
- [ ] Gradual rollout strategies for production
- [ ] Automated rollback configured
- [ ] Rollback procedures tested
- [ ] Approval gates for production
- [ ] Deployment notifications configured
- [ ] Infrastructure as Code used
- [ ] Infrastructure changes version controlled
- [ ] Database migrations reversible
- [ ] Health checks configured
- [ ] Deployment metrics tracked

## Examples (Ví dụ)

### Ví dụ 1: Secure Pipeline Configuration

```yaml
# ✅ GOOD: Secure CI/CD pipeline
name: Secure Deployment Pipeline

stages:
  - build
  - test
  - security
  - deploy

build:
  image: docker.io/official-build-image
  secrets:
    - dockerhub_token  # From secrets manager

test:
  parallel: true
  coverage_threshold: 80%
  
security:
  stages:
    - sast:  # Static Application Security Testing
    - dependency_scan:  # Software Composition Analysis
    - container_scan:  # Container vulnerability scan
    - secret_scan:  # Detect secrets in code
  
deploy:
  approval_required: true  # For production
  strategy: canary
  canary:
    percentage: 10
    auto_rollback_on_error: true
    metrics:
      - error_rate
      - latency_p99
```

### Ví dụ 2: Blue-Green Deployment

```typescript
// Blue-Green deployment configuration
const blueGreenConfig = {
  name: 'blue-green-production',
  active: 'blue', // Current live environment
  environments: {
    blue: { color: 'blue', instances: 10, healthy: true },
    green: { color: 'green', instances: 10, healthy: true }
  },
