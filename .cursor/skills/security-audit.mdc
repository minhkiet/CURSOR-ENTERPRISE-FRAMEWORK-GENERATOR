### Phase 2: OWASP Top 10 Assessment

### Bước 3: A01 - Broken Access Control

```typescript
// Vulnerability: Missing authorization checks
// BEFORE (VULNERABLE)
async function getUserProfile(req, res) {
  const userId = req.params.userId;
  const user = await db.users.findById(userId);
  res.json(user); // No check if req.user can access this
}

// SECURE (FIXED)
async function getUserProfile(req, res) {
  const userId = req.params.userId;
  
  // Authorization check
  if (req.user.id !== userId && !req.user.roles.includes('admin')) {
    return res.status(403).json({ 
      error: 'Forbidden', 
      message: 'You can only access your own profile' 
    });
  }
  
  const user = await db.users.findById(userId);
  if (!user) {
    return res.status(404).json({ error: 'User not found' });
  }
  
  res.json(user);
}

// Policy-based Access Control
class AccessControlService {
  canAccess(user: User, resource: Resource, action: Action): boolean {
    const policies = this.getPolicies(user, resource);
    return policies.some(p => p.action === action && p.granted);
  }
}
```

### Bước 4: A02 - Cryptographic Failures

```typescript
// Vulnerability: Weak password hashing
// BEFORE (VULNERABLE)
function hashPassword(password: string): string {
  return crypto.createHash('md5').update(password).digest('hex');
}

// SECURE (FIXED)
async function hashPassword(password: string): Promise<string> {
  return bcrypt.hash(password, 12); // Cost factor 12
}

// Vulnerability: Hardcoded secrets
// BEFORE (VULNERABLE)
const config = {
  apiKey: 'sk-1234567890abcdef',
  dbPassword: 'secret123'
};

// SECURE (FIXED)
const config = {
  apiKey: process.env.API_KEY,
  dbPassword: process.env.DB_PASSWORD
};

// Environment validation
function validateSecrets() {
  const required = ['API_KEY', 'DB_PASSWORD', 'JWT_SECRET'];
  for (const secret of required) {
    if (!process.env[secret]) {
      throw new Error(`Missing required secret: ${secret}`);
    }
  }
}
```

### Bước 5: A03 - Injection

```typescript
// SQL Injection Prevention
// BEFORE (VULNERABLE)
async function searchUsers(query: string) {
  const result = await db.query(
    `SELECT * FROM users WHERE name = '${query}'`
  );
  return result;
}

// SECURE (FIXED)
async function searchUsers(query: string) {
  // Whitelist validation
  const sanitizedQuery = query.replace(/[^a-zA-Z0-9\s]/g, '');
  
  const result = await db.query(
    'SELECT * FROM users WHERE name ILIKE $1',
    [`%${sanitizedQuery}%`]
  );
  return result;
}

// NoSQL Injection Prevention
async function findByEmail(email: string) {
  // Strict email validation
  if (!isValidEmail(email)) {
    throw new ValidationError('Invalid email format');
  }
  
  // Query with strict type
  const result = await db.collection('users').findOne({ 
    email: { $eq: email } 
  });
  return result;
}

// Command Injection Prevention
async function processFile(filename: string) {
  // Whitelist approach
  const allowedExtensions = ['.pdf', '.docx', '.txt'];
  const ext = path.extname(filename).toLowerCase();
  
  if (!allowedExtensions.includes(ext)) {
    throw new ValidationError('File type not allowed');
  }
  
  // Use path.join to prevent directory traversal
  const safePath = path.join(ALLOWED_DIR, filename);
  
  // Validate resolved path
  if (!safePath.startsWith(ALLOWED_DIR)) {
    throw new ValidationError('Invalid file path');
  }
  
  return fs.readFile(safePath);
}
```

### Bước 6: A04 - Insecure Design

```typescript
// Rate Limiting Implementation
import rateLimit from 'express-rate-limit';

const apiLimiter = rateLimit({
  windowMs: 15 * 60 * 1000, // 15 minutes
  max: 100, // 100 requests per window
  message: 'Too many requests from this IP',
  standardHeaders: true,
  legacyHeaders: false,
  keyGenerator: (req) => req.user?.id || req.ip,
});

// Stricter limit for sensitive endpoints
const authLimiter = rateLimit({
  windowMs: 15 * 60 * 1000,
  max: 5, // Only 5 attempts
  skipSuccessfulRequests: true,
});

// Input Validation with Zod
import { z } from 'zod';

const userSchema = z.object({
  email: z.string().email().max(255),
  password: z.string().min(8).max(128)
    .regex(/[A-Z]/)
    .regex(/[a-z]/)
    .regex(/[0-9]/)
    .regex(/[^A-Za-z0-9]/),
  age: z.number().int().min(13).max(120)
});

function validateInput<T>(schema: z.ZodSchema<T>, data: unknown): T {
  const result = schema.safeParse(data);
  if (!result.success) {
    throw new ValidationError(result.error.message);
  }
  return result.data;
}
```

### Bước 7: A05 - Security Misconfiguration

```typescript
// Security Headers Middleware
import helmet from 'helmet';

app.use(helmet());

// CORS Configuration
app.use(cors({
  origin: process.env.ALLOWED_ORIGINS?.split(',') || [],
  credentials: true,
  maxAge: 86400,
  methods: ['GET', 'POST', 'PUT', 'DELETE'],
  allowedHeaders: ['Content-Type', 'Authorization']
}));

// Error Handling - Don't leak information
app.use((err, req, res, next) => {
  // Log full error internally
  logger.error({
    error: err.message,
    stack: err.stack,
    path: req.path,
    method: req.method
  });
  
  // Return generic message to client
  res.status(500).json({
    error: 'Internal Server Error',
    requestId: req.id // For support reference
  });
});

// Disable unnecessary features
app.disable('x-powered-by');
app.disable('etag');
```

### Bước 8: A06 - Vulnerable Components

```typescript
// Dependency Auditing Script
import { execSync } from 'child_process';
import { readFileSync } from 'fs';

interface Vulnerability {
  package: string;
  severity: 'low' | 'medium' | 'high' | 'critical';
  description: string;
  fixVersion?: string;
}

function auditDependencies(): Vulnerability[] {
  // Run npm audit
  const auditOutput = execSync('npm audit --json').toString();
  const auditResult = JSON.parse(auditOutput);
  
  const vulnerabilities: Vulnerability[] = [];
  
  for (const [id, vuln] of Object.entries(auditResult.vulnerabilities)) {
    vulnerabilities.push({
      package: id,
      severity: vuln.severity,
      description: vuln.title,
      fixVersion: vuln.fixAvailable
    });
  }
  
  return vulnerabilities;
}

// Automated Update Check
async function checkForUpdates() {
  const packageJson = JSON.parse(readFileSync('package.json', 'utf8'));
  
  for (const [name, version] of Object.entries(packageJson.dependencies)) {
    const latest = await getLatestVersion(name);
    if (version !== latest) {
      console.log(`${name}: ${version} -> ${latest}`);
    }
  }
}
```

### Bước 9: A07 - Authentication Failures

```typescript
// Secure Authentication Implementation
class AuthService {
  async login(email: string, password: string) {
    // Rate limiting
    await this.rateLimiter.check(email);
    
    // Account lockout
    const account = await this.getAccount(email);
    if (account.lockedUntil > Date.now()) {
      throw new AccountLockedError();
    }
    
    // Verify password
    const valid = await bcrypt.compare(password, account.passwordHash);
    if (!valid) {
      await this.handleFailedLogin(account);
      throw new InvalidCredentialsError();
    }
    
    // Reset on successful login
    await this.resetFailedLogins(account.id);
    
    // Generate tokens
    return this.generateTokens(account);
  }
  
  generateTokens(account: Account) {
    const accessToken = jwt.sign(
      { sub: account.id, email: account.email },
      process.env.JWT_SECRET,
      { expiresIn: '15m' }
    );
    
    const refreshToken = crypto.randomBytes(64).toString('hex');
    
    // Store refresh token hash
    const refreshTokenHash = crypto
      .createHash('sha256')
      .update(refreshToken)
      .digest('hex');
    
    return { accessToken, refreshToken, refreshTokenHash };
  }
}

// Multi-factor Authentication
async function verifyMFA(userId: string, code: string) {
  const mfaSecret = await getMFASecret(userId);
  
  const totp = new TOTP({
    secret: mfaSecret,
    window: 1 // Allow 1 step tolerance
  });
  
  return totp.verify(code);
}
```

### Bước 10: A08 - Software Integrity Failures

```typescript
// Verify integrity of external resources
import crypto from 'crypto';

interface SignedResource {
  url: string;
  expectedHash: string;
}

async function fetchSecurely(resource: SignedResource) {
  const response = await fetch(resource.url);
  const content = await response.arrayBuffer();
  
  const hash = crypto
    .createHash('sha256')
    .update(Buffer.from(content))
    .digest('hex');
  
  if (hash !== resource.expectedHash) {
    throw new SecurityError('Resource integrity check failed');
  }
  
  return Buffer.from(content);
}

// Subresource Integrity (SRI)
const scriptTag = `
<script 
  src="https://example.com/lib.js"
  integrity="sha384-abc123..."
  crossorigin="anonymous"
></script>
`;
