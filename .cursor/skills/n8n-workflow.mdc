## Workflow (Quy trình)

### Bước 1: Process Analysis

```typescript
// Analyze business process for automation
interface ProcessAnalysis {
  process_name: string;
  steps: ProcessStep[];
  integrations: SystemIntegration[];
  automation_opportunities: Opportunity[];
  complexity: 'simple' | 'moderate' | 'complex';
}

interface ProcessStep {
  name: string;
  type: 'manual' | 'automated' | 'decision' | 'approval';
  duration_minutes: number;
  frequency: 'hourly' | 'daily' | 'weekly' | 'monthly' | 'on_demand';
  responsible: string;
  automation_feasibility: 'easy' | 'moderate' | 'difficult' | 'not_possible';
}

async function analyzeProcess(
  processSpec: ProcessSpec
): Promise<ProcessAnalysis> {
  const steps = decomposeProcess(processSpec);
  const integrations = identifyIntegrations(steps);
  
  return {
    process_name: processSpec.name,
    steps,
    integrations,
    automation_opportunities: identifyOpportunities(steps),
    complexity: calculateComplexity(steps)
  };
}

function identifyOpportunities(steps: ProcessStep[]): Opportunity[] {
  return steps
    .filter(step => 
      step.type === 'manual' && 
      step.automation_feasibility !== 'not_possible'
    )
    .map(step => ({
      step: step.name,
      feasibility: step.automation_feasibility,
      estimated_savings: estimateTimeSavings(step),
      approach: determineApproach(step)
    }))
    .sort((a, b) => {
      const savingsOrder = ['high', 'medium', 'low'];
      return savingsOrder.indexOf(b.estimated_savings) - 
             savingsOrder.indexOf(a.estimated_savings);
    });
}
```

### Bước 2: Workflow Design

```typescript
// Design n8n workflow
interface WorkflowDesign {
  name: string;
  description: string;
  nodes: Node[];
  connections: Connection[];
  settings: WorkflowSettings;
  errorWorkflow?: string;
}

interface Node {
  id: string;
  name: string;
  type: string;
  parameters: Record<string, any>;
  position: { x: number; y: number };
}

interface Connection {
  source: string;
  target: string;
  data?: Record<string, any>;
}

function designWorkflow(
  analysis: ProcessAnalysis
): WorkflowDesign {
  const nodes: Node[] = [];
  const connections: Connection[] = [];
  
  // Add trigger node
  const trigger = createTriggerNode(analysis.triggers);
  nodes.push(trigger);
  
  // Build workflow steps
  let previousNode = trigger.id;
  
  for (const step of analysis.steps) {
    if (step.type === 'manual') continue;
    
    const stepNodes = createStepNodes(step);
    nodes.push(...stepNodes);
    
    // Connect to previous node
    connections.push({
      source: previousNode,
      target: stepNodes[0].id
    });
    
    previousNode = stepNodes[stepNodes.length - 1].id;
  }
  
  // Add error handling
  const errorHandler = createErrorHandler(analysis);
  nodes.push(errorHandler);
  
  return {
    name: analysis.process_name.replace(/\s+/g, '_').toLowerCase(),
    description: analysis.process_name,
    nodes,
    connections,
    settings: createWorkflowSettings(analysis),
    errorWorkflow: createErrorWorkflow(analysis)
  };
}

function createTriggerNode(triggers: Trigger[]): Node {
  const triggerType = determineTriggerType(triggers);
  
  switch (triggerType) {
    case 'schedule':
      return {
        id: 'trigger-1',
        name: 'Schedule Trigger',
        type: 'n8n-nodes-base.scheduleTrigger',
        parameters: {
          rule: {
            interval: [
              {
                field: triggers[0].schedule || 'daily',
                triggerAtHour: 9,
                triggerAtMinute: 0
              }
            ]
          }
        },
        position: { x: 0, y: 0 }
      };
      
    case 'webhook':
      return {
        id: 'trigger-1',
        name: 'Webhook',
        type: 'n8n-nodes-base.webhook',
        parameters: {
          httpMethod: triggers[0].method || 'POST',
          path: triggers[0].path,
          responseMode: 'onReceived'
        },
        position: { x: 0, y: 0 }
      };
      
    case 'event':
      return {
        id: 'trigger-1',
        name: 'Event Trigger',
        type: 'n8n-nodes-base.manualTrigger',
        parameters: {},
        position: { x: 0, y: 0 }
      };
  }
}
```

### Bước 3: Node Implementation

```typescript
// Create workflow nodes
function createStepNodes(step: ProcessStep): Node[] {
  const nodes: Node[] = [];
  
  switch (step.type) {
    case 'automated':
      nodes.push(...createAutomatedNodes(step));
      break;
    case 'decision':
      nodes.push(createDecisionNode(step));
      break;
    case 'approval':
      nodes.push(createApprovalNode(step));
      break;
  }
  
  return nodes;
}

function createAutomatedNodes(step: ProcessStep): Node[] {
  const nodes: Node[] = [];
  
  // Create HTTP Request node for API calls
  if (step.integration?.type === 'api') {
    nodes.push({
      id: `http-${step.name}`,
      name: `Call ${step.integration.system}`,
      type: 'n8n-nodes-base.httpRequest',
      parameters: {
        url: step.integration.endpoint,
        method: step.integration.method,
        authentication: step.integration.auth,
        sendHeaders: true,
        headerParameters: {
          parameters: [
            { name: 'Authorization', value: '={{$env.API_TOKEN}}' }
          ]
        },
        sendBody: {
          martial: 'raw',
          jsonObject: true,
          body: '={{$json}}'
        }
      },
      position: { x: 200, y: nodes.length * 100 }
    });
  }
  
  // Create database node
  if (step.integration?.type === 'database') {
    nodes.push({
      id: `db-${step.name}`,
      name: `Query ${step.integration.database}`,
      type: 'n8n-nodes-base.postgres',
      parameters: {
        operation: 'executeQuery',
        query: step.integration.query,
        options: {
          timeout: 30000
        }
      },
      position: { x: 200, y: nodes.length * 100 }
    });
  }
  
  // Create transform node
  if (step.dataTransform) {
    nodes.push({
      id: `transform-${step.name}`,
      name: 'Transform Data',
      type: 'n8n-nodes-base.set',
      parameters: {
        mode: 'manual',
        assignments: {
          assignments: step.dataTransform.fields.map(field => ({
            name: field.target,
            value: field.expression
          }))
        },
        options: {}
      },
      position: { x: 400, y: nodes.length * 100 }
    });
  }
  
  return nodes;
}

function createDecisionNode(step: ProcessStep): Node {
  return {
    id: `decision-${step.name}`,
    name: step.name,
    type: 'n8n-nodes-base.switch',
    parameters: {
      dataType: 'string',
      value1: '={{$json.status}}',
      rules: {
        rules: [
          { operation: 'equals', value2: step.decision?.condition }
        ]
      },
      fallbackOutput: 'default'
    },
    position: { x: 300, y: 200 }
  };
}

function createApprovalNode(step: ProcessStep): Node {
  return {
    id: `approval-${step.name}`,
    name: `Request Approval for ${step.name}`,
    type: 'n8n-nodes-base.slack',
    parameters: {
      resource: 'message',
      channel: step.approval?.slackChannel || '#approvals',
      text: `Approval needed for ${step.name}`,
      additionalFields: {
        attachments: {
          attachments: [
            {
              color: '#FFA500',
              title: 'Approval Required',
              fields: [
                {
                  title: 'Requested By',
                  value: '={{$json.requestedBy}}',
                  short: true
                },
                {
                  title: 'Details',
                  value: '={{$json.details}}',
                  short: true
                }
              ]
            }
          ]
        }
      }
    },
    position: { x: 300, y: 300 }
  };
}
```

### Bước 4: Error Handling

```typescript
// Design error handling
interface ErrorHandling {
  retry_policy: RetryPolicy;
  fallback_actions: FallbackAction[];
  alerting: AlertConfig;
}

function designErrorHandling(
  workflow: WorkflowDesign
): ErrorHandling {
  return {
    retry_policy: {
      max_retries: 3,
      retry_wait_time: 1000 * 60 * 5, // 5 minutes
      exponential_backoff: true
    },
    fallback_actions: [
      {
        node: 'critical-api-call',
        onFailure: 'use_cache',
        cache_source: 'previous_successful_call'
      },
      {
        node: 'notification',
        onFailure: 'log_and_continue'
      }
    ],
    alerting: {
      on_retry_exhausted: {
        channels: ['email', 'slack'],
        message: 'Workflow {{workflow.name}} failed after retries'
      },
      on_critical_error: {
        channels: ['pagerduty'],
        escalation: true
      }
    }
  };
}

function createErrorWorkflow(analysis: ProcessAnalysis): string {
  return JSON.stringify({
    name: `${analysis.process_name}_error_handler`,
    nodes: [
      {
        id: 'error-trigger',
        name: 'Error Trigger',
        type: 'n8n-nodes-base.errorTrigger',
        parameters: {},
        position: { x: 0, y: 0 }
      },
      {
        id: 'log-error',
        name: 'Log Error',
        type: 'n8n-nodes-base.writeBinaryFile',
        parameters: {
          fileName: '/logs/error-{{$json.timestamp}}.json',
          data: '={{ JSON.stringify($json) }}'
        },
        position: { x: 200, y: 0 }
      },
      {
        id: 'notify-team',
        name: 'Notify Team',
        type: 'n8n-nodes-base.slack',
        parameters: {
          channel: '#workflow-errors',
          text: `Workflow Error: {{ $json.workflow.name }}\nError: {{ $json.execution.error.message }}`
        },
        position: { x: 400, y: 0 }
      }
    ],
    connections: {
      'Error Trigger': {
        main: [[{ node: 'Log Error', type: 'main', index: 0 }]]
      },
      'Log Error': {
        main: [[{ node: 'Notify Team', type: 'main', index: 0 }]]
      }
    }
  });
}
```

### Bước 5: Monitoring Setup

```typescript
// Design monitoring và analytics
interface MonitoringSetup {
  execution_tracking: boolean;
  metrics: Metric[];
  dashboards: Dashboard[];
  alerts: Alert[];
}

interface Metric {
  name: string;
  type: 'count' | 'duration' | 'success_rate';
  node_id?: string;
}

function designMonitoring(workflow: WorkflowDesign): MonitoringSetup {
  return {
    execution_tracking: true,
    metrics: [
      { name: 'total_executions', type: 'count' },
      { name: 'successful_executions', type: 'count' },
      { name: 'failed_executions', type: 'count' },
      { name: 'avg_duration_seconds', type: 'duration' },
      { name: 'api_call_success_rate', type: 'success_rate', node_id: 'http-node' }
    ],
    dashboards: [
      {
        name: `${workflow.name} Overview`,
        panels: [
          { metric: 'total_executions', visualization: 'stat' },
          { metric: 'success_rate', visualization: 'gauge' },
          { metric: 'avg_duration_seconds', visualization: 'time_series' }
        ]
      }
    ],
    alerts: [
      {
        name: 'High Failure Rate',
        condition: 'failed_executions / total_executions > 0.1',
        severity: 'warning',
        channels: ['slack']
      },
      {
        name: 'Execution Timeout',
        condition: 'duration > 300000', // 5 minutes
        severity: 'critical',
        channels: ['pagerduty']
      }
    ]
  };
}
```

