### Phase 1: Workflow Design Principles

### Bước 1: Workflow Structure Best Practices

```json
{
  "name": "Order Processing Workflow",
  "nodes": [
    {
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "parameters": {
        "httpMethod": "POST",
        "path": "order-created",
        "responseMode": "responseNode",
        "options": {
          "rawBody": false
        }
      },
      "webhookId": "order-created-webhook"
    },
    {
      "name": "Validate Order Data",
      "type": "n8n-nodes-base.code",
      "position": [500, 300],
      "parameters": {
        "jsCode": "// Validate order data\nconst order = $input.first().json;\n\nconst errors = [];\n\nif (!order.customerId) {\n  errors.push('Missing customerId');\n}\n\nif (!order.items || order.items.length === 0) {\n  errors.push('Order must have at least one item');\n}\n\nif (errors.length > 0) {\n  throw new Error(`Validation failed: ${errors.join(', ')}`);\n}\n\nreturn [{ json: { ...order, validated: true } }];"
      }
    },
    {
      "name": "Check Inventory",
      "type": "n8n-nodes-base.httpRequest",
      "position": [750, 300],
      "parameters": {
        "method": "POST",
        "url": "={{$env.INVENTORY_SERVICE_URL}}/check",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{$env.INVENTORY_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "items",
              "value": "={{ $json.items }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Inventory Available?",
      "type": "n8n-nodes-base.switch",
      "position": [1000, 300],
      "parameters": {
        "dataType": "boolean",
        "value1": "={{ $json.available }}",
        "rules": {
          "rules": [
            {
              "operation": "equals",
              "value2": true
            }
          ]
        },
        "fallbackOutput": "default"
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [{ "node": "Validate Order Data", "type": "main", "index": 0 }]
      ]
    },
    "Validate Order Data": {
      "main": [
        [{ "node": "Check Inventory", "type": "main", "index": 0 }]
      ]
    },
    "Check Inventory": {
      "main": [
        [{ "node": "Inventory Available?", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
```

### Bước 2: Error Handling Workflows

```json
{
  "name": "Error Handler Workflow",
  "nodes": [
    {
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "position": [250, 300]
    },
    {
      "name": "Parse Error",
      "type": "n8n-nodes-base.code",
      "position": [500, 300],
      "parameters": {
        "jsCode": "// Extract error information\nconst error = $input.first().json;\n\nconst errorInfo = {\n  workflowId: error.workflow?.id,\n  workflowName: error.workflow?.name,\n  nodeName: error.node?.name,\n  errorMessage: error.execution?.error?.message,\n  errorStack: error.execution?.error?.stack,\n  timestamp: new Date().toISOString(),\n  executionId: error.execution?.id\n};\n\n// Categorize error\nlet severity = 'low';\nlet category = 'unknown';\n\nconst errorMessage = errorInfo.errorMessage?.toLowerCase() || '';\n\nif (errorMessage.includes('timeout') || errorMessage.includes('unavailable')) {\n  severity = 'high';\n  category = 'infrastructure';\n} else if (errorMessage.includes('validation')) {\n  severity = 'medium';\n  category = 'data_quality';\n} else if (errorMessage.includes('authentication') || errorMessage.includes('unauthorized')) {\n  severity = 'high';\n  category = 'security';\n}\n\nreturn [{\n  json: { ...errorInfo, severity, category }\n}];"
      }
    },
    {
      "name": "Classify Error",
      "type": "n8n-nodes-base.switch",
      "position": [750, 300],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.severity }}",
        "rules": {
          "rules": [
            {
              "operation": "equals",
              "value2": "high"
            },
            {
              "operation": "equals",
              "value2": "medium"
            }
          ]
        },
        "fallbackOutput": "default"
      }
    },
    {
      "name": "Alert On-Call (High Severity)",
      "type": "n8n-nodes-base.pagerDuty",
      "position": [1000, 150],
      "parameters": {
        "operation": "create",
        "title": "={{ 'Error in workflow: ' + $json.workflowName }}",
        "severity": 2,
        "source": "={{ $json.workflowName }}",
        "customDetails": "={{ JSON.stringify($json) }}"
      }
    },
    {
      "name": "Send Slack Alert (Medium Severity)",
      "type": "n8n-nodes-base.slack",
      "position": [1000, 300],
      "parameters": {
        "resource": "message",
        "channel": "={{ $env.SLACK_ERROR_CHANNEL }}",
        "text": "=:warning: *Workflow Error*\n*Workflow:* {{ $json.workflowName }}\n*Error:* {{ $json.errorMessage }}\n*Node:* {{ $json.nodeName }}"
      }
    },
    {
      "name": "Log to Database (All)",
      "type": "n8n-nodes-base.postgres",
      "position": [1000, 450],
      "parameters": {
        "operation": "insert",
        "table": "workflow_errors",
        "columns": "workflow_id, workflow_name, node_name, error_message, severity, category, timestamp",
        "values": "={{ $json.workflowId }}, {{ $json.workflowName }}, {{ $json.nodeName }}, {{ $json.errorMessage }}, {{ $json.severity }}, {{ $json.category }}, {{ $json.timestamp }}"
      }
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [[{ "node": "Parse Error", "type": "main", "index": 0 }]]
    },
    "Parse Error": {
      "main": [[{ "node": "Classify Error", "type": "main", "index": 0 }]]
    },
    "Classify Error": {
      "main": [
        [{ "node": "Alert On-Call (High Severity)", "type": "main", "index": 0 }],
        [{ "node": "Send Slack Alert (Medium Severity)", "type": "main", "index": 0 }],
        [{ "node": "Log to Database (All)", "type": "main", "index": 0 }]
      ]
    }
  }
}
```

### Phase 2: Common Patterns

### Bước 3: Data Transformation Patterns

```json
{
  "name": "Data Transformation Workflow",
  "nodes": [
    {
      "name": "CRM Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "parameters": {
        "path": "crm-contact"
      }
    },
    {
      "name": "Transform to Standard Format",
      "type": "n8n-nodes-base.code",
      "position": [500, 300],
      "parameters": {
        "jsCode": "// Transform CRM data to standard format\nconst crmData = $input.first().json;\n\n// Map CRM fields to standard schema\nconst standardContact = {\n  id: crmData.ContactID,\n  firstName: crmData.FirstName,\n  lastName: crmData.LastName,\n  email: crmData.EmailAddress,\n  phone: crmData.Phone,\n  company: crmData.AccountName,\n  title: crmData.JobTitle,\n  source: 'crm',\n  sourceId: crmData.ContactID,\n  createdAt: crmData.CreatedDate,\n  updatedAt: crmData.ModifiedDate,\n  metadata: {\n    crmType: 'salesforce',\n    ownerId: crmData.OwnerId,\n    leadSource: crmData.LeadSource\n  }\n};\n\nreturn [{ json: standardContact }];"
      }
    },
    {
      "name": "Validate Required Fields",
      "type": "n8n-nodes-base.code",
      "position": [750, 300],
      "parameters": {
        "jsCode": "// Validate required fields\nconst contact = $input.first().json;\n\nconst requiredFields = ['firstName', 'lastName', 'email'];\nconst missingFields = requiredFields.filter(field => !contact[field]);\n\nif (missingFields.length > 0) {\n  throw new Error(`Missing required fields: ${missingFields.join(', ')}`);\n}\n\n// Validate email format\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nif (!emailRegex.test(contact.email)) {\n  throw new Error('Invalid email format');\n}\n\nreturn [{ json: contact }];"
      }
    },
    {
      "name": "Enrich with External Data",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1000, 300],
      "parameters": {
        "method": "GET",
        "url": "=https://company-enrichment.api/{{ $json.company }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [{ "name": "Authorization", "value": "Bearer {{$env.ENRICHMENT_API_KEY}}" }]
        },
        "options": {
          "timeout": 5000
        }
      }
    },
    {
      "name": "Merge Enrichment Data",
      "type": "n8n-nodes-base.code",
      "position": [1250, 300],
      "parameters": {
        "jsCode": "// Merge original contact with enrichment data\nconst original = $input.first().json;\nconst enrichment = $input.last().json;\n\nconst enrichedContact = {\n  ...original,\n  companyData: {\n    industry: enrichment.industry,\n    size: enrichment.employeeCount,\n    revenue: enrichment.annualRevenue,\n    website: enrichment.domain\n  }\n};\n\nreturn [{ json: enrichedContact }];"
      }
    },
    {
      "name": "Save to Database",
      "type": "n8n-nodes-base.postgres",
      "position": [1500, 300],
      "parameters": {
        "operation": "upsert",
        "table": "contacts",
        "primaryKeyColumn": "id",
        "columns": "id, first_name, last_name, email, phone, company, title, source, source_id, created_at, updated_at, metadata",
        "values": "={{ $json.id }}, '{{ $json.firstName }}', '{{ $json.lastName }}', '{{ $json.email }}', '{{ $json.phone }}', '{{ $json.company }}', '{{ $json.title }}', '{{ $json.source }}', '{{ $json.sourceId }}', '{{ $json.createdAt }}', '{{ $json.updatedAt }}', '{{ JSON.stringify($json.metadata) }}'"
      }
    }
  ]
}
```

### Bước 4: Scheduled Processing Patterns

```json
{
  "name": "Daily Report Generation",
  "nodes": [
    {
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.schedule",
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "dayOfMonth",
              "value": "1"
            }
          ]
        }
      },
      "triggerTimes": {
        "item": [{ "mode": "everyMinute", "value": 1, "unit": "day" }]
      }
    },
    {
      "name": "Fetch Data from Database",
      "type": "n8n-nodes-base.postgres",
      "position": [500, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  DATE(created_at) as date,\n  COUNT(*) as total_orders,\n  SUM(total_amount) as revenue,\n  COUNT(DISTINCT customer_id) as unique_customers\nFROM orders\nWHERE created_at >= CURRENT_DATE - INTERVAL '30 days'\nGROUP BY DATE(created_at)\nORDER BY date DESC;"
      }
    },
    {
      "name": "Calculate Metrics",
      "type": "n8n-nodes-base.code",
      "position": [750, 300],
      "parameters": {
        "jsCode": "// Calculate summary metrics\nconst dailyData = $input.all().map(item => item.json);\n\nconst summary = dailyData.reduce((acc, day) => ({\n  totalRevenue: acc.totalRevenue + day.revenue,\n  totalOrders: acc.totalOrders + day.total_orders,\n  avgOrderValue: (acc.totalRevenue + day.revenue) / (acc.totalOrders + day.total_orders),\n  uniqueCustomers: new Set([...acc.customers, day.unique_customers]).size,\n  customers: [...acc.customers, day.unique_customers]\n}), { totalRevenue: 0, totalOrders: 0, customers: [] });\n\nreturn [{\n  json: {\n    reportDate: new Date().toISOString(),\n    period: 'Last 30 days',\n    metrics: {\n      totalRevenue: summary.totalRevenue,\n      totalOrders: summary.totalOrders,\n      averageOrderValue: summary.avgOrderValue,\n      uniqueCustomers: summary.uniqueCustomers\n    },\n    dailyData\n  }\n}];"
      }
    },
    {
      "name": "Generate PDF Report",
      "type": "n8n-nodes-base.html",
      "position": [1000, 300],
      "parameters": {
        "html": "<!DOCTYPE html>\n<html>\n<head>\n  <title>Monthly Report</title>\n  <style>\n    body { font-family: Arial, sans-serif; }\n    .metric { margin: 20px 0; }\n    .metric-value { font-size: 24px; font-weight: bold; }\n  </style>\n</head>\n<body>\n  <h1>Monthly Business Report</h1>\n  <p>Report Date: {{ $json.reportDate }}</p>\n  \n  <div class=\"metric\">\n    <div>Total Revenue</div>\n    <div class=\"metric-value\">${{ $json.metrics.totalRevenue }}</div>\n  </div>\n  \n  <div class=\"metric\">\n    <div>Total Orders</div>\n    <div class=\"metric-value\">{{ $json.metrics.totalOrders }}</div>\n  </div>\n</body>\n</html>"
      }
    },
    {
      "name": "Send Email Report",
      "type": "n8n-nodes-base.gmail",
      "position": [1250, 300],
      "parameters": {
        "action": "send",
        "to": "={{ $env.REPORT_RECIPIENTS }}",
        "subject": "=Monthly Business Report - {{ $json.reportDate }}",
        "emailHtml": "={{ $json.data }}",
        "attachments": [
          {
            "name": "={{ 'report-' + $json.reportDate.split('T')[0] + '.html' }}",
            "data": "={{ $json.data }}"
          }
        ]
      }
    },
    {
      "name": "Archive Report",
      "type": "n8n-nodes-base.googleCloudStorage",
      "position": [1500, 300],
      "parameters": {
        "operation": "upload",
        "bucket": "={{ $env.REPORTS_BUCKET }}",
        "fileName": "=reports/{{ new Date().toISOString().split('T')[0] }}.html",
        "data": "={{ $json.data }}"
      }
    }
  ]
}
```

### Phase 3: Advanced Patterns

### Bước 5: Sub-nodes và Reusable Workflows

```json
{
  "name": "Send Notification Template",
  "type": "workflow",
  "nodes": [
    {
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "parameters": {
        "path": "send-notification"
      }
    },
    {
      "name": "Render Template",
      "type": "n8n-nodes-base.code",
      "position": [500, 300],
      "parameters": {
        "jsCode": "// Template rendering function\nconst { template, data, channel } = $input.first().json;\n\nfunction renderTemplate(template, data) {\n  return template.replace(/\\{\\{(\\w+(?:\\.\\w+)*)\\}\\}/g, (match, path) => {\n    return path.split('.').reduce((obj, key) => obj?.[key], data) ?? match;\n  });\n}\n\nconst rendered = {\n  channel,\n  subject: renderTemplate(template.subject || '', data),\n  body: renderTemplate(template.body, data),\n  metadata: { templateId: template.id, ...data.metadata }\n};\n\nreturn [{ json: rendered }];"
      }
    },
    {
      "name": "Route by Channel",
      "type": "n8n-nodes-base.switch",
      "position": [750, 300],
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.channel }}",
        "rules": {
          "rules": [
            { "operation": "equals", "value2": "email" },
            { "operation": "equals", "value2": "slack" },
            { "operation": "equals", "value2": "sms" }
          ]
        }
      }
    },
    {
      "name": "Send Email",
      "type": "n8n-nodes-base.gmail",
      "position": [1000, 150],
      "parameters": {
        "action": "send",
        "to": "={{ $json.metadata.recipientEmail }}",
        "subject": "={{ $json.subject }}",
        "emailHtml": "={{ $json.body }}"
      }
    },
    {
      "name": "Send Slack Message",
      "type": "n8n-nodes-base.slack",
      "position": [1000, 300],
      "parameters": {
        "resource": "message",
        "channel": "={{ $json.metadata.slackChannel || '#general' }}",
        "text": "={{ $json.body }}"
      }
    },
    {
      "name": "Send SMS",
      "type": "n8n-nodes-base.twilio",
      "position": [1000, 450],
      "parameters": {
        "action": "send",
        "from": "={{ $env.TWILIO_PHONE_NUMBER }}",
        "to": "={{ $json.metadata.phoneNumber }}",
        "message": "={{ $json.body }}"
      }
    }
  ],
  "connections": {
    "Webhook Trigger": { "main": [[{ "node": "Render Template", "type": "main", "index": 0 }]] },
    "Render Template": { "main": [[{ "node": "Route by Channel", "type": "main", "index": 0 }]] },
    "Route by Channel": {
      "main": [
        [{ "node": "Send Email", "type": "main", "index": 0 }],
        [{ "node": "Send Slack Message", "type": "main", "index": 0 }],
        [{ "node": "Send SMS", "type": "main", "index": 0 }]
      ]
    }
  }
}
```

### Bước 6: Loop và Batch Processing

```json
{
  "name": "Batch Processing Workflow",
  "nodes": [
    {
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.schedule",
      "position": [250, 300],
      "parameters": {
        "rule": {
          "interval": [{ "field": "hour", "value": 1 }]
        }
      }
    },
    {
      "name": "Fetch Pending Items",
      "type": "n8n-nodes-base.postgres",
      "position": [500, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM pending_notifications WHERE status = 'pending' LIMIT 100;"
      }
    },
    {
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [750, 300],
      "parameters": {
        "batchSize": 10,
        "options": {
          "reset": true
        }
      }
    },
    {
      "name": "Process Item",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1000, 300],
      "parameters": {
        "method": "POST",
        "url": "={{ $json.webhookUrl }}",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "id", "value": "={{ $json.id }}" },
            { "name": "message", "value": "={{ $json.message }}" }
          ]
        }
      }
    },
    {
      "name": "Update Status",
      "type": "n8n-nodes-base.postgres",
      "position": [1250, 300],
      "parameters": {
        "operation": "update",
        "table": "pending_notifications",
        "columns": "status, processed_at",
        "values": "='processed', NOW()",
        "where": "id = {{ $('Process Item').item.json.id }}"
      }
    },
    {
      "name": "Wait for Completion",
      "type": "n8n-nodes-base.wait",
      "position": [1500, 300],
      "parameters": {
        "amount": 1,
        "unit": "seconds"
      }
    }
  ]
}
```

