## Workflow (Quy trình)

### Bước 1: Content Preprocessing

```typescript
// Preprocess content trước khi embedding
interface PreprocessingConfig {
  language: 'en' | 'vi' | 'multi';
  remove_html: boolean;
  normalize_whitespace: boolean;
  lowercase: boolean;
  remove_special_chars: boolean;
  preserve_code_syntax: boolean;
}

function preprocess(
  content: string,
  config: PreprocessingConfig
): string {
  let processed = content;
  
  if (config.remove_html) {
    processed = removeHtmlTags(processed);
  }
  
  if (config.normalize_whitespace) {
    processed = processed
      .split(/\s+/)
      .filter(s => s.length > 0)
      .join(' ');
  }
  
  if (!config.lowercase) {
    // Preserve case for semantic meaning in some contexts
  }
  
  if (config.preserve_code_syntax) {
    processed = preserveCodeStructure(processed);
  }
  
  return processed.trim();
}

function preserveCodeStructure(code: string): string {
  // Keep code structure markers
  return code
    .replace(/\n{3,}/g, '\n\n')  // Normalize newlines
    .replace(/\s{2,}/g, ' ');      // Normalize spaces in inline code
}
```

### Bước 2: Intelligent Chunking

```typescript
// Chunk content thành pieces phù hợp cho embedding
interface ChunkingConfig {
  strategy: 'fixed' | 'semantic' | 'recursive' | 'document';
  chunk_size: number;
  chunk_overlap: number;
  min_chunk_size: number;
  max_chunk_size: number;
  separators: string[];
  preserve_structure: boolean;
}

class ContentChunker {
  constructor(private config: ChunkingConfig) {}
  
  chunk(document: Document): Chunk[] {
    switch (this.config.strategy) {
      case 'fixed':
        return this.fixedChunk(document);
      case 'semantic':
        return this.semanticChunk(document);
      case 'recursive':
        return this.recursiveChunk(document);
      case 'document':
        return this.documentChunk(document);
      default:
        return this.fixedChunk(document);
    }
  }
  
  private semanticChunk(document: Document): Chunk[] {
    const chunks: Chunk[] = [];
    const sentences = this.splitIntoSentences(document.content);
    
    let currentChunk = '';
    let currentTokens = 0;
    
    for (const sentence of sentences) {
      const sentenceTokens = this.countTokens(sentence);
      
      if (currentTokens + sentenceTokens > this.config.chunk_size) {
        if (currentChunk.length > 0) {
          chunks.push(this.createChunk(currentChunk, chunks.length));
        }
        
        // Start new chunk with overlap
        const overlap = this.getOverlap(currentChunk);
        currentChunk = overlap + sentence;
        currentTokens = this.countTokens(currentChunk);
      } else {
        currentChunk += ' ' + sentence;
        currentTokens += sentenceTokens;
      }
    }
    
    if (currentChunk.length > 0) {
      chunks.push(this.createChunk(currentChunk, chunks.length));
    }
    
    return chunks;
  }
  
  private recursiveChunk(document: Document): Chunk[] {
    const chunks: Chunk[] = [];
    
    // Try splitting by paragraphs first
    const paragraphs = document.content.split(/\n\n+/);
    
    for (const para of paragraphs) {
      if (this.countTokens(para) <= this.config.chunk_size) {
        chunks.push(this.createChunk(para, chunks.length));
      } else {
        // Recursively split by sentences
        const subChunks = this.splitLargeText(para);
        chunks.push(...subChunks);
      }
    }
    
    return this.mergeSmallChunks(chunks);
  }
  
  private splitIntoSentences(text: string): string[] {
    // Language-aware sentence splitting
    const sentenceEnders = /[.!?]+[\s\n]+/;
    return text.split(sentenceEnders).filter(s => s.trim().length > 0);
  }
}
```

### Bước 3: Embedding Generation

```typescript
// Generate embeddings sử dụng configured model
interface EmbeddingModel {
  name: string;
  provider: 'openai' | 'cohere' | 'huggingface' | 'local';
  dimensions: number;
  max_tokens: number;
  batch_size: number;
}

class EmbeddingGenerator {
  private client: EmbeddingClient;
  private model: EmbeddingModel;
  
  constructor(model: EmbeddingModel, apiKey: string) {
    this.model = model;
    this.client = this.createClient(model, apiKey);
  }
  
  async generateBatch(
    chunks: Chunk[],
    options?: GenerationOptions
  ): Promise<EmbeddingResult[]> {
    const results: EmbeddingResult[] = [];
    const batches = this.createBatches(chunks, this.model.batch_size);
    
    for (const batch of batches) {
      try {
        const embeddings = await this.callAPI(batch);
        results.push(...this.mapResults(batch, embeddings));
        
        // Rate limiting
        await this.delay(options?.rateLimitDelay || 100);
      } catch (error) {
        // Handle failures
        results.push(...this.handleBatchError(batch, error));
      }
    }
    
    return results;
  }
  
  private async callAPI(chunks: Chunk[]): Promise<number[][]> {
    const texts = chunks.map(c => c.content);
    
    switch (this.model.provider) {
      case 'openai':
        return await this.openaiEmbed(texts);
      case 'cohere':
        return await this.cohereEmbed(texts);
      case 'huggingface':
        return await this.huggingfaceEmbed(texts);
      case 'local':
        return await this.localEmbed(texts);
    }
  }
  
  private async openaiEmbed(texts: string[]): Promise<number[][]> {
    const response = await this.client.post('/embeddings', {
      model: this.model.name,
      input: texts
    });
    
    return response.data.map((item: any) => item.embedding);
  }
}
```

### Bước 4: Vector Storage và Indexing

```typescript
// Store vectors và build indexes
interface VectorStorageConfig {
  backend: 'pinecone' | 'weaviate' | 'chroma' | 'qdrant' | 'milvus';
  index_type: 'flat' | 'hnsw' | 'ivf' | 'pq';
  metric: 'cosine' | 'dotproduct' | 'euclidean';
  parameters: Record<string, any>;
}

class VectorStorage {
  private index: VectorIndex;
  private metadataStore: MetadataStore;
  
  async initialize(config: VectorStorageConfig): Promise<void> {
    this.index = await this.createIndex(config);
    this.metadataStore = new MetadataStore(config.backend);
  }
  
  async upsert(
    embeddings: EmbeddingResult[],
    metadata: ChunkMetadata[]
  ): Promise<UpsertResult> {
    const vectors = embeddings.map(e => ({
      id: e.chunk_id,
      values: e.vector,
      metadata: this.sanitizeMetadata(metadata.find(m => m.id === e.chunk_id))
    }));
    
    const result = await this.index.upsert(vectors);
    
    // Update metadata store
    await this.metadataStore.batchUpsert(metadata);
    
    return {
      success: result.success_count,
      failed: result.failed_count,
      errors: result.errors
    };
  }
  
  async search(
    queryVector: number[],
    options: SearchOptions
  ): Promise<SearchResult[]> {
    const results = await this.index.search(queryVector, {
      top_k: options.top_k || 10,
      filter: options.filter,
      include_metadata: true
    });
    
    return results.matches.map(r => ({
      chunk_id: r.id,
      score: r.score,
      metadata: r.metadata,
      chunk: this.metadataStore.get(r.id)
    }));
  }
  
  async delete(ids: string[]): Promise<void> {
    await this.index.delete(ids);
    await this.metadataStore.delete(ids);
  }
}
```

### Bước 5: Quality Assurance

```typescript
// Đánh giá quality của embeddings
interface QualityMetrics {
  consistency_score: number;  // 0-1: Similar texts → similar vectors
  coherence_score: number;   // 0-1: Chunks maintain context
  diversity_score: number;    // 0-1: Vectors are not too similar
  retention_score: number;    // 0-1: Important info preserved
}

class EmbeddingQualityAnalyzer {
  async analyze(embeddings: EmbeddingResult[]): Promise<QualityMetrics> {
    const vectors = embeddings.map(e => e.vector);
    
    return {
      consistency_score: await this.measureConsistency(vectors),
      coherence_score: await this.measureCoherence(embeddings),
      diversity_score: await this.measureDiversity(vectors),
      retention_score: await this.measureRetention(embeddings)
    };
  }
  
  private async measureConsistency(vectors: number[][]): Promise<number> {
    // Test: Similar inputs should produce similar vectors
    // Use known similar pairs và check distances
    const testPairs = getKnownSimilarPairs();
    
    const similarities = testPairs.map(pair => {
      const v1 = vectors[pair.index1];
      const v2 = vectors[pair.index2];
      return cosineSimilarity(v1, v2);
    });
    
    return average(similarities);
  }
  
  private async measureDiversity(vectors: number[][]): Promise<number> {
    // Measure pairwise distances
    const distances: number[] = [];
    
    for (let i = 0; i < Math.min(100, vectors.length); i++) {
      for (let j = i + 1; j < Math.min(100, vectors.length); j++) {
        distances.push(cosineDistance(vectors[i], vectors[j]));
      }
    }
    
    // Good diversity = moderate average distance
    const avgDistance = average(distances);
    return Math.min(1, avgDistance * 2); // Normalize to 0-1
  }
}
```

### Bước 6: Model Comparison và Selection

```typescript
// Compare different embedding models
interface ModelComparison {
  model_name: string;
  dimensions: number;
  avg_latency_ms: number;
  quality_metrics: QualityMetrics;
  cost_per_1k_tokens: number;
  storage_size_mb: number;
  overall_score: number;
}

async function compareModels(
  testDataset: TestDataset,
  models: EmbeddingModel[]
): Promise<ModelComparison[]> {
  const results: ModelComparison[] = [];
  
  for (const model of models) {
    const generator = new EmbeddingGenerator(model, apiKey);
    const start = Date.now();
    
    const embeddings = await generator.generateBatch(testDataset.chunks);
    const latency = Date.now() - start;
    
    const analyzer = new EmbeddingQualityAnalyzer();
    const metrics = await analyzer.analyze(embeddings);
    
    results.push({
      model_name: model.name,
      dimensions: model.dimensions,
      avg_latency_ms: latency / testDataset.chunks.length,
      quality_metrics: metrics,
      cost_per_1k_tokens: getModelCost(model),
      storage_size_mb: calculateStorageSize(embeddings),
      overall_score: this.calculateOverallScore(metrics, latency, model.cost)
    });
  }
  
  return results.sort((a, b) => b.overall_score - a.overall_score);
}
```

