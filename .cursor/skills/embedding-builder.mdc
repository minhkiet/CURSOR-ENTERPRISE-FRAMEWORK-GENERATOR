## Examples (Ví dụ)

### Ví dụ 1: Building Codebase Embeddings

```typescript
// Embed codebase với code-aware chunking
class CodebaseEmbedder {
  private generator: EmbeddingGenerator;
  private storage: VectorStorage;
  
  async embedCodebase(repo: Repository): Promise<void> {
    // Extract code files
    const files = await this.extractCodeFiles(repo);
    
    // Process each file with code-aware chunking
    const chunks: Chunk[] = [];
    
    for (const file of files) {
      const parser = this.getLanguageParser(file.language);
      const ast = parser.parse(file.content);
      
      // Chunk by function/class boundaries
      const codeChunks = this.chunkByStructure(ast, {
        strategy: 'semantic',
        chunk_size: 512,
        preserve_function_context: true,
        include_imports: true
      });
      
      chunks.push(...codeChunks.map(c => ({
        ...c,
        metadata: {
          file_path: file.path,
          language: file.language,
          entity_type: c.type,
          entity_name: c.name
        }
      })));
    }
    
    // Generate embeddings
    const embeddings = await this.generator.generateBatch(chunks);
    
    // Store with filtering metadata
    await this.storage.upsert(embeddings, chunks.map(c => c.metadata));
  }
  
  async searchCode(query: string): Promise<CodeSearchResult[]> {
    const queryEmbedding = await this.generator.generate([query]);
    const results = await this.storage.search(queryEmbedding, {
      top_k: 10,
      filter: { language: 'typescript' }
    });
    
    return results.map(r => ({
      code: r.chunk.content,
      file: r.metadata.file_path,
      score: r.score,
      context: this.extractContext(r.chunk)
    }));
  }
}
```

### Ví dụ 2: Hybrid Search with Multiple Models

```typescript
// Combine dense và sparse embeddings
class HybridSearchEngine {
  private denseIndex: VectorStorage;
  private sparseIndex: SparseVectorIndex;
  private reranker: Reranker;
  
  async search(
    query: string,
    options: HybridSearchOptions
  ): Promise<SearchResult[]> {
    // Dense search (semantic)
    const denseQuery = await this.denseEncoder.encode(query);
    const denseResults = await this.denseIndex.search(denseQuery, {
      top_k: options.top_k * 2
    });
    
    // Sparse search (keyword)
    const sparseQuery = this.sparseEncoder.encode(query);
    const sparseResults = await this.sparseIndex.search(sparseQuery, {
      top_k: options.top_k * 2
    });
    
    // Reciprocal Rank Fusion
    const fused = this.reciprocalRankFusion(
      denseResults,
      sparseResults,
      options.fusion_alpha // 0 = pure sparse, 1 = pure dense
    );
    
    // Rerank with cross-encoder
    const reranked = await this.reranker.rerank(query, fused);
    
    return reranked.slice(0, options.top_k);
  }
  
  private reciprocalRankFusion(
    dense: Result[],
    sparse: Result[],
    alpha: number
  ): ScoredResult[] {
    const scores = new Map<string, number>();
    
    for (const [rank, result] of dense.entries()) {
      const current = scores.get(result.id) || 0;
      scores.set(result.id, current + alpha * (1 / (rank + 60)));
    }
    
    for (const [rank, result] of sparse.entries()) {
      const current = scores.get(result.id) || 0;
      scores.set(result.id, current + (1 - alpha) * (1 / (rank + 60)));
    }
    
    return [...scores.entries()]
      .map(([id, score]) => ({ id, score }))
      .sort((a, b) => b.score - a.score);
  }
}
```

### Ví dụ 3: Real-time Embedding Updates

```typescript
// Handle real-time updates cho embedding index
class LiveEmbeddingManager {
  private pendingUpdates: Map<string, EmbeddingUpdate>;
  private batchInterval: number = 5000; // 5 seconds
  
  async update(id: string, newContent: string): Promise<void> {
    // Queue update
    this.pendingUpdates.set(id, {
      id,
      content: newContent,
      timestamp: Date.now()
    });
    
    // Debounce updates
    this.scheduleFlush();
  }
  
  private async scheduleFlush(): Promise<void> {
    if (this.flushScheduled) return;
    
    this.flushScheduled = true;
    setTimeout(async () => {
      await this.flushPending();
      this.flushScheduled = false;
    }, this.batchInterval);
  }
  
  private async flushPending(): Promise<void> {
    const updates = [...this.pendingUpdates.values()];
    this.pendingUpdates.clear();
    
    if (updates.length === 0) return;
    
    // Regenerate embeddings
    const chunks = updates.map(u => this.createChunk(u));
    const embeddings = await this.generator.generateBatch(chunks);
    
    // Batch update
    await this.storage.upsert(embeddings, chunks.map(c => c.metadata));
    
    // Invalidate related caches
    await this.cache.invalidate(updates.map(u => u.id));
  }
}
```

## Anti Patterns (Các pattern cần tránh)

### 1. Fixed Size Chunking
```typescript
// ❌ BAD: Arbitrary chunk sizes ignore content structure
function badChunk(content: string): Chunk[] {
  const chunks: Chunk[] = [];
  for (let i = 0; i < content.length; i += 500) {
    chunks.push({ content: content.slice(i, i + 500), index: chunks.length });
  }
  return chunks;
}

// ✅ GOOD: Content-aware chunking preserves meaning
function goodChunk(content: string, docType: string): Chunk[] {
  const strategy = getChunkingStrategy(docType);
  return strategy.chunk(content);
}
```

### 2. Single Model for Everything
```typescript
// ❌ BAD: One model fits all use cases
const embeddings = await openai.embed('text-embedding-ada-002', texts);

// ✅ GOOD: Task-specific model selection
const embeddings = await Promise.all({
  semantic: codeModel.embed(codeTexts),
  keyword: bm25.encode(keywordTexts),
  multilingual: multilingualModel.embed(vietnameseTexts)
});
```

### 3. No Quality Validation
```typescript
// ❌ BAD: Blindly trust embeddings
const embeddings = await generator.generate(chunks);
await storage.upsert(embeddings, metadata);

// ✅ GOOD: Validate before deploying
const metrics = await analyzer.analyze(embeddings);
if (metrics.quality_score < MIN_QUALITY) {
  throw new QualityError('Embeddings below quality threshold');
}
```

### 4. Ignoring Token Limits
```typescript
// ❌ BAD: Exceed model token limits
const hugeText = await readFile('huge_document.txt');
const embedding = await model.embed(hugeText); // May truncate or fail

// ✅ GOOD: Respect token limits
const chunks = chunkByTokenLimit(hugeText, model.maxTokens * 0.9);
const embeddings = await Promise.all(chunks.map(c => model.embed(c)));
```

### 5. No Index Optimization
```typescript
// ❌ BAD: Default index settings
const index = await pinecone.createIndex({ 
  metric: 'cosine' // Just default
});

// ✅ GOOD: Optimized for query patterns
const index = await pinecone.createIndex({ 
  metric: 'cosine',
  index_type: 'hnsw',
  parameters: {
    m: 16,  // Connections per node
    efConstruction: 200  // Build quality
  }
});
```

## Best Practices (Thực hành tốt nhất)

1. **Use appropriate chunk sizes**: 256-512 tokens cho most use cases
2. **Include overlap**: 20-30% overlap để maintain context across chunks
3. **Preserve metadata**: Always store source, timestamps, and identifiers
4. **Validate quality**: Use consistency và diversity metrics
5. **Monitor drift**: Re-evaluate embeddings periodically
6. **Hybrid search**: Combine dense và sparse for better results
7. **Use rerankers**: Cross-encoder reranking improves result quality
8. **Batch efficiently**: Optimize batch size for API limits
9. **Handle failures gracefully**: Retry logic với backoff
10. **Track costs**: Monitor embedding generation costs

