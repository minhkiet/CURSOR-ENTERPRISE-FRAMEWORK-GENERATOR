### Phase 2: Communication Patterns

### Bước 3: Synchronous Communication (REST/gRPC)

```typescript
// Service client for synchronous calls
// clients/order-client.ts
import { Client } from '@nestjs/microservices';
import { Injectable } from '@nestjs/common';
import { Observable } from 'rxjs';

@Injectable()
export class OrderServiceClient {
  constructor(
    private httpClient: HttpService,
    private logger: Logger
  ) {}
  
  async createOrder(request: CreateOrderRequest): Promise<OrderResponse> {
    try {
      const response = await this.httpClient
        .post('/orders', request)
        .toPromise();
      
      return response.data;
    } catch (error) {
      this.logger.error(`Failed to create order: ${error.message}`);
      throw this.transformError(error);
    }
  }
  
  async getOrder(orderId: string): Promise<OrderResponse> {
    return this.httpClient.get(`/orders/${orderId}`).toPromise();
  }
  
  async cancelOrder(orderId: string): Promise<void> {
    await this.httpClient.delete(`/orders/${orderId}`).toPromise();
  }
  
  private transformError(error: any): Error {
    if (error.response) {
      const { status, data } = error.response;
      
      switch (status) {
        case 400:
          return new ValidationError(data.message);
        case 404:
          return new NotFoundError(`Order not found`);
        case 409:
          return new ConflictError(data.message);
        default:
          return new ServiceError(data.message);
      }
    }
    
    return new ServiceError('Service unavailable');
  }
}

// gRPC service definition
// proto/order.proto
syntax = "proto3";

package order;

service OrderService {
  rpc CreateOrder(CreateOrderRequest) returns (CreateOrderResponse);
  rpc GetOrder(GetOrderRequest) returns (Order);
  rpc CancelOrder(CancelOrderRequest) returns (CancelOrderResponse);
  rpc StreamOrderUpdates(StreamOrderRequest) returns (stream OrderUpdate);
}

message CreateOrderRequest {
  string customer_id = 1;
  repeated OrderItem items = 2;
  Address shipping_address = 3;
  string payment_method_id = 4;
}

message Order {
  string id = 1;
  string customer_id = 2;
  OrderStatus status = 3;
  repeated OrderItem items = 4;
  Money total_amount = 5;
  google.protobuf.Timestamp created_at = 6;
}

enum OrderStatus {
  PENDING = 0;
  CONFIRMED = 1;
  PROCESSING = 2;
  SHIPPED = 3;
  DELIVERED = 4;
  CANCELLED = 5;
}
```

### Bước 4: Asynchronous Communication (Events)

```typescript
// Event definitions
// events/order.events.ts
export interface OrderCreatedEvent {
  eventType: 'ORDER_CREATED';
  orderId: string;
  customerId: string;
  items: OrderItem[];
  totalAmount: Money;
  timestamp: Date;
  correlationId: string;
}

export interface OrderConfirmedEvent {
  eventType: 'ORDER_CONFIRMED';
  orderId: string;
  confirmedAt: Date;
  timestamp: Date;
}

export interface OrderCancelledEvent {
  eventType: 'ORDER_CANCELLED';
  orderId: string;
  reason: string;
  timestamp: Date;
}

// Event publisher
// services/event-publisher.service.ts
@Injectable()
export class EventPublisher {
  constructor(
    private kafka: KafkaService,
    private logger: Logger
  ) {}
  
  async publishOrderCreated(event: OrderCreatedEvent): Promise<void> {
    await this.publish('order.events', event);
  }
  
  async publishOrderConfirmed(event: OrderConfirmedEvent): Promise<void> {
    await this.publish('order.events', event);
  }
  
  private async publish(topic: string, event: any): Promise<void> {
    const message: KafkaMessage = {
      key: event.orderId,
      value: JSON.stringify(event),
      headers: {
        'event-type': event.eventType,
        'timestamp': event.timestamp.toISOString(),
        'correlation-id': event.correlationId
      }
    };
    
    try {
      await this.kafka.emit(topic, [message]);
      this.logger.debug(`Published event: ${event.eventType}`, { orderId: event.orderId });
    } catch (error) {
      this.logger.error(`Failed to publish event: ${error.message}`, { event });
      throw error;
    }
  }
}

// Event consumer (in another service)
// consumers/inventory.consumer.ts
@Injectable()
export class InventoryConsumer {
  constructor(
    private inventoryService: InventoryService,
    private logger: Logger
  ) {}
  
  @MessagePattern('order.events')
  async handleOrderEvent(@Payload() message: any, @Ctx() context: KafkaContext) {
    const event = JSON.parse(message.value);
    
    this.logger.info(`Received event: ${event.eventType}`, { orderId: event.orderId });
    
    try {
      switch (event.eventType) {
        case 'ORDER_CREATED':
          await this.reserveInventory(event);
          break;
          
        case 'ORDER_CANCELLED':
          await this.releaseInventory(event);
          break;
          
        default:
          this.logger.warn(`Unknown event type: ${event.eventType}`);
      }
      
      // Commit offset
      const partition = context.getPartition();
      const offset = context.getOffset();
      await context.commitOffsets([{ partition, offset }]);
      
    } catch (error) {
      this.logger.error(`Failed to process event: ${error.message}`, { event });
      // Don't commit - message will be reprocessed
      throw error;
    }
  }
  
  private async reserveInventory(event: OrderCreatedEvent): Promise<void> {
    for (const item of event.items) {
      await this.inventoryService.reserveStock(
        event.orderId,
        item.productId,
        item.quantity
      );
    }
  }
  
  private async releaseInventory(event: OrderCancelledEvent): Promise<void> {
    const reservations = await this.inventoryService.getReservationsForOrder(event.orderId);
    for (const reservation of reservations) {
      await this.inventoryService.releaseReservation(reservation.id);
    }
  }
}
```

