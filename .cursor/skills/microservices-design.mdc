      - "3002:3000"
    environment:
      - DATABASE_URL=postgresql://postgres:postgres@customer-db:5432/customers
      - KAFKA_BROKERS=kafka:9092
    depends_on:
      - customer-db
      - kafka

  inventory-service:
    build: ./services/inventory-service
    ports:
      - "3003:3000"
    environment:
      - DATABASE_URL=postgresql://postgres:postgres@inventory-db:5432/inventory
      - KAFKA_BROKERS=kafka:9092
    depends_on:
      - inventory-db
      - kafka

  api-gateway:
    image: kong:latest
    ports:
      - "8000:8000"
    environment:
      - KONG_DATABASE=postgres
      - KONG_PG_HOST=gateway-db
    depends_on:
      - gateway-db

  order-db:
    image: postgres:15
    environment:
      POSTGRES_DB: orders
      POSTGRES_PASSWORD: postgres
    volumes:
      - order-db-data:/var/lib/postgresql/data

  kafka:
    image: confluentinc/cp-kafka:7.5.0
    environment:
      KAFKA_BROKER_ID: 1
      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181
      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092
    depends_on:
      - zookeeper

  jaeger:
    image: jaegertracing/all-in-one:latest
    ports:
      - "16686:16686"  # UI
      - "6831:6831"    # Agent

volumes:
  order-db-data:
  customer-db-data:
  inventory-db-data:
```

## Anti Pattern

- [ ] **Distributed Monolith**: Services tightly coupled
- [ ] **Shared Databases**: Cross-service data access
- [ ] **Synchronous Everywhere**: No async communication
- [ ] **No API Contracts**: Implicit interfaces
- [ ] **N+1 API Calls**: Chatty interactions
- [ ] **Missing Idempotency**: Non-idempotent operations

## Best Practice

- [ ] **Single Responsibility**: One bounded context per service
- [ ] **Database per Service**: Independent data storage
- [ ] **Async by Default**: Event-driven communication
- [ ] **API Contracts First**: OpenAPI/Proto definitions
- [ ] **Circuit Breakers**: Resilience patterns
- [ ] **Saga Pattern**: Distributed transactions

