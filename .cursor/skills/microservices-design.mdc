### Bước 5: API Gateway Configuration

```yaml
# api-gateway/nginx.conf
events {
    worker_connections 1024;
}

http {
    # Upstream definitions
    upstream order_service {
        server order-service-1:3000;
        server order-service-2:3000;
        server order-service-3:3000;
    }
    
    upstream customer_service {
        server customer-service-1:3000;
        server customer-service-2:3000;
    }
    
    upstream payment_service {
        server payment-service-1:3000;
        server payment-service-2:3000;
        least_conn;  # Load balancing strategy
    }
    
    server {
        listen 80;
        
        # Rate limiting zones
        limit_req_zone $binary_remote_addr zone=api:10m rate=100r/s;
        limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/s;
        
        location /api/orders {
            limit_req zone=api burst=20 nodelay;
            
            rewrite ^/api/(.*) /$1 break;
            proxy_pass http://order_service;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Request-ID $request_id;
            
            # Circuit breaker
            proxy_connect_timeout 5s;
            proxy_next_upstream error timeout http_502;
        }
        
        location /api/customers {
            limit_req zone=api burst=20 nodelay;
            
            rewrite ^/api/(.*) /$1 break;
            proxy_pass http://customer_service;
        }
        
        location /api/payments {
            limit_req zone=api burst=10 nodelay;
            
            rewrite ^/api/(.*) /$1 break;
            proxy_pass http://payment_service;
        }
        
        # Health check
        location /health {
            return 200 'OK';
            add_header Content-Type text/plain;
        }
    }
}

