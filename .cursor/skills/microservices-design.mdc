### Bước 8: Saga Pattern for Distributed Transactions

```typescript
// Saga orchestrator
// sagas/order-saga.orchestrator.ts
export class OrderSagaOrchestrator {
  private steps: SagaStep[] = [
    {
      name: 'ReserveInventory',
      execute: (context: OrderContext) => 
        this.inventoryService.reserve(context.orderId, context.items),
      compensate: (context: OrderContext) =>
        this.inventoryService.release(context.orderId)
    },
    {
      name: 'ProcessPayment',
      execute: (context: OrderContext) =>
        this.paymentService.charge(context.orderId, context.totalAmount),
      compensate: (context: OrderContext) =>
        this.paymentService.refund(context.orderId)
    },
    {
      name: 'ConfirmOrder',
      execute: (context: OrderContext) =>
        this.orderService.confirm(context.orderId),
      compensate: (context: OrderContext) =>
        this.orderService.cancel(context.orderId, 'Saga compensation')
    },
    {
      name: 'SendNotification',
      execute: (context: OrderContext) =>
        this.notificationService.sendOrderConfirmation(context.orderId),
      compensate: async () => {} // No compensation needed
    }
  ];
  
  async execute(orderContext: OrderContext): Promise<void> {
    const completedSteps: SagaStep[] = [];
    
    try {
      for (const step of this.steps) {
        this.logger.info(`Executing step: ${step.name}`);
        await step.execute(orderContext);
        completedSteps.push(step);
        this.logger.info(`Completed step: ${step.name}`);
      }
      
      this.logger.info(`Saga completed successfully for order: ${orderContext.orderId}`);
      
    } catch (error) {
      this.logger.error(`Saga failed at step ${completedSteps.length + 1}: ${error.message}`);
      await this.compensate(completedSteps.reverse(), orderContext);
      throw new SagaExecutionError(`Order creation failed: ${error.message}`);
    }
  }
  
  private async compensate(
    completedSteps: SagaStep[],
    context: OrderContext
  ): Promise<void> {
    for (const step of completedSteps) {
      try {
        this.logger.info(`Compensating step: ${step.name}`);
        await step.compensate(context);
        this.logger.info(`Compensated step: ${step.name}`);
      } catch (compensationError) {
        this.logger.error(
          `Failed to compensate step ${step.name}: ${compensationError.message}`
        );
        // Store for retry or manual intervention
        await this.sagaLog.recordFailure(step.name, context.orderId, compensationError);
      }
    }
  }
}

// Choreography-based saga
// events/order-saga.events.ts
export class OrderSagaChoreography {
  constructor(
    private eventBus: EventBus,
    private orderService: OrderService,
    private inventoryService: InventoryService,
    private paymentService: PaymentService
  ) {}
  
  subscribe() {
    // Step 1: Reserve inventory
    this.eventBus.subscribe('order.requested', async (event) => {
      try {
        await this.inventoryService.reserve(event.orderId, event.items);
        this.eventBus.publish('inventory.reserved', {
          orderId: event.orderId,
          correlationId: event.correlationId
        });
      } catch (error) {
        this.eventBus.publish('inventory.reservation.failed', {
          orderId: event.orderId,
          reason: error.message
        });
      }
    });
    
    // Step 2: Process payment
    this.eventBus.subscribe('inventory.reserved', async (event) => {
      try {
        const order = await this.orderService.getOrder(event.orderId);
        await this.paymentService.charge(event.orderId, order.totalAmount);
        this.eventBus.publish('payment.successful', {
          orderId: event.orderId,
          correlationId: event.correlationId
        });
      } catch (error) {
        // Compensate inventory
        await this.inventoryService.release(event.orderId);
        this.eventBus.publish('order.creation.failed', {
          orderId: event.orderId,
          reason: error.message
        });
      }
    });
  }
}
```

## Checklist

- [ ] Service boundaries clearly defined
- [ ] API contracts documented (OpenAPI/gRPC)
- [ ] Communication patterns selected (sync/async)
- [ ] Database ownership assigned per service
- [ ] Saga pattern for distributed transactions
- [ ] API Gateway configured
- [ ] Service mesh setup (if needed)
- [ ] Circuit breakers implemented
- [ ] Retry policies defined
- [ ] Health checks configured
- [ ] Distributed tracing enabled
- [ ] Centralized logging setup

