## Workflow (Quy trình)

### Bước 1: Project Discovery

```typescript
// Discover và document current Supabase setup
interface SupabaseProject {
  ref: string;
  region: string;
  plan: 'free' | 'pro' | 'team' | 'enterprise';
  database: DatabaseConfig;
  auth: AuthConfig;
  storage: StorageConfig;
  realtime: RealtimeConfig;
  functions: FunctionsConfig;
}

async function discoverProject(
  supabase: SupabaseClient
): Promise<SupabaseProject> {
  // Get project info
  const { data: project } = await supabase.rpc('get_project_info');
  
  // Get database stats
  const dbStats = await getDatabaseStats(supabase);
  
  // Get auth providers
  const authConfig = await getAuthConfig(supabase);
  
  // Get storage buckets
  const storageConfig = await getStorageConfig(supabase);
  
  // Get realtime status
  const realtimeConfig = await getRealtimeConfig(supabase);
  
  return {
    ref: project.ref,
    region: project.region,
    plan: project.plan,
    database: dbStats,
    auth: authConfig,
    storage: storageConfig,
    realtime: realtimeConfig,
    functions: await getFunctionsConfig()
  };
}

async function getDatabaseStats(
  supabase: SupabaseClient
): Promise<DatabaseConfig> {
  const queries = await Promise.all([
    supabase.rpc('get_table_count'),
    supabase.rpc('get_total_rows'),
    supabase.rpc('get_index_count'),
    supabase.rpc('get_database_size')
  ]);
  
  return {
    tables: queries[0].data,
    totalRows: queries[1].data,
    indexes: queries[2].data,
    size: queries[3].data,
    extensions: await getEnabledExtensions(supabase)
  };
}
```

### Bước 2: Schema Analysis

```typescript
// Analyze database schema
interface SchemaAnalysis {
  tables: TableAnalysis[];
  relationships: Relationship[];
  indexes: IndexAnalysis[];
  missingIndexes: IndexRecommendation[];
  denormalizationOpportunities: Suggestion[];
  partitionOpportunities: Suggestion[];
  issues: SchemaIssue[];
}

async function analyzeSchema(
  supabase: SupabaseClient
): Promise<SchemaAnalysis> {
  // Get all tables
  const tables = await getAllTables(supabase);
  
  const tableAnalyses: TableAnalysis[] = [];
  const allRelationships: Relationship[] = [];
  
  for (const table of tables) {
    // Analyze each table
    const tableAnalysis = await analyzeTable(supabase, table);
    tableAnalyses.push(tableAnalysis);
    
    // Extract relationships
    allRelationships.push(...tableAnalysis.foreignKeys);
    
    // Analyze indexes
    await analyzeIndexes(supabase, table);
  }
  
  return {
    tables: tableAnalyses,
    relationships: allRelationships,
    indexes: await analyzeAllIndexes(supabase, tables),
    missingIndexes: await findMissingIndexes(supabase, tables),
    denormalizationOpportunities: await findDenormOpportunities(tables),
    partitionOpportunities: await findPartitionOpportunities(tables),
    issues: await identifySchemaIssues(tables)
  };
}

async function analyzeTable(
  supabase: SupabaseClient,
  table: TableInfo
): Promise<TableAnalysis> {
  // Get table structure
  const columns = await getTableColumns(supabase, table.name);
  
  // Get row count
  const { count } = await supabase
    .from(table.name)
    .select('*', { count: 'exact', head: true });
  
  // Get column stats
  const stats = await getColumnStats(supabase, table.name);
  
  // Get constraints
  const constraints = await getTableConstraints(supabase, table.name);
  
  // Check for UUID primary keys
  const hasUUIDPK = columns.some(c => 
    c.isPrimaryKey && c.dataType === 'uuid'
  );
  
  // Check for timestamps
  const hasCreatedAt = columns.some(c => 
    c.name === 'created_at' && c.dataType === 'timestamp with time zone'
  );
  
  return {
    name: table.name,
    rowCount: count || 0,
    columns: columns.map(c => ({
      name: c.name,
      type: c.dataType,
      nullable: c.isNullable,
      hasDefault: !!c.columnDefault,
      isPrimaryKey: c.isPrimaryKey,
      isForeignKey: !!c.references
    })),
    sizeEstimate: estimateTableSize(columns, count || 0),
    issues: identifyTableIssues(columns, count || 0, constraints),
    suggestions: generateTableSuggestions(columns, stats, count || 0)
  };
}
```

### Bước 3: RLS Policy Review

```typescript
// Review Row Level Security policies
interface RLSPolicyAnalysis {
  tables: TableRLSAnalysis[];
  publicAccessRisks: Risk[];
  policyGaps: Gap[];
  performanceIssues: Issue[];
  recommendations: Recommendation[];
}

async function analyzeRLSPolicies(
  supabase: SupabaseClient
): Promise<RLSPolicyAnalysis> {
  const tables = await getAllTables(supabase);
  const tableAnalyses: TableRLSAnalysis[] = [];
  const risks: Risk[] = [];
  
  for (const table of tables) {
    const policies = await getTablePolicies(supabase, table.name);
    const rlsEnabled = await isRLSEnabled(supabase, table.name);
    
    const analysis: TableRLSAnalysis = {
      table: table.name,
      rlsEnabled,
      policies,
      issues: []
    };
    
    // Check for public access
    if (rlsEnabled && policies.some(p => p.roles.includes('anon'))) {
      const publicPolicies = policies.filter(p => 
        p.roles.includes('anon') && !p.withCheck && !p.using
      );
      
      if (publicPolicies.length > 0) {
        risks.push({
          severity: 'high',
          table: table.name,
          issue: 'Public access with no conditions',
          policies: publicPolicies.map(p => p.name)
        });
      }
    }
    
    // Check for missing SELECT policies
    const selectPolicies = policies.filter(p => p.command === 'SELECT');
    if (rlsEnabled && selectPolicies.length === 0) {
      analysis.issues.push({
        type: 'missing_policy',
        command: 'SELECT',
        message: 'No SELECT policy - may cause access denied'
      });
    }
    
    // Check for missing INSERT policies
    const insertPolicies = policies.filter(p => p.command === 'INSERT');
    if (rlsEnabled && insertPolicies.length === 0) {
      analysis.issues.push({
        type: 'missing_policy',
        command: 'INSERT',
        message: 'No INSERT policy - inserts may be denied'
      });
    }
    
    tableAnalyses.push(analysis);
  }
  
  return {
    tables: tableAnalyses,
    publicAccessRisks: risks,
    policyGaps: findPolicyGaps(tableAnalyses),
    performanceIssues: analyzeRLSPerformance(tableAnalyses),
    recommendations: generateRLSRecommendations(tableAnalyses)
  };
}

function analyzeRLSPerformance(
  analyses: TableRLSAnalysis[]
): Issue[] {
  const issues: Issue[] = [];
  
  for (const analysis of analyses) {
    for (const policy of analysis.policies) {
      // Check for non-deterministic functions in policies
      if (policy.using?.includes('now()') || 
          policy.using?.includes('random()')) {
        issues.push({
          severity: 'medium',
          table: analysis.table,
          policy: policy.name,
          issue: 'Non-deterministic functions may cause performance issues'
        });
      }
      
      // Check for subqueries in policies
      if (policy.using?.includes('SELECT')) {
        issues.push({
          severity: 'medium',
          table: analysis.table,
          policy: policy.name,
          issue: 'Subqueries in policies may impact performance'
        });
      }
      
      // Check for complex conditions
      if (policy.using && policy.using.length > 500) {
        issues.push({
          severity: 'low',
          table: analysis.table,
          policy: policy.name,
          issue: 'Very long policy expression - consider simplifying'
        });
      }
    }
  }
  
  return issues;
}
```

### Bước 4: Query Performance Analysis

```typescript
// Analyze query performance
interface QueryPerformanceAnalysis {
  slowQueries: SlowQuery[];
  missingIndexes: MissingIndex[];
  n_plus_one_patterns: Pattern[];
  inefficient_joins: JoinIssue[];
  recommendations: QueryRecommendation[];
}

async function analyzeQueryPerformance(
  supabase: SupabaseClient
): Promise<QueryPerformanceAnalysis> {
  // Get query statistics from pg_stat_statements
  const queryStats = await getQueryStats(supabase);
  
  // Find slow queries
  const slowQueries = queryStats
    .filter(q => q.mean_exec_time > 100) // > 100ms average
    .map(q => ({
      query: normalizeQuery(q.query),
      meanTime: q.mean_exec_time,
      calls: q.calls,
      totalTime: q.total_exec_time,
      suggestions: suggestOptimizations(q)
    }))
    .sort((a, b) => b.totalTime - a.totalTime);
  
  // Find missing indexes
  const missingIndexes = await findMissingIndexesFromStats(queryStats);
  
  // Detect N+1 patterns
  const nPlusOne = await detectNPlusOnePatterns(supabase);
  
  // Analyze joins
  const joinIssues = await analyzeJoins(supabase, queryStats);
  
  return {
    slowQueries,
    missingIndexes,
    n_plus_one_patterns: nPlusOne,
    inefficient_joins: joinIssues,
    recommendations: generateQueryRecommendations(slowQueries, missingIndexes)
  };
}

async function detectNPlusOnePatterns(
  supabase: SupabaseClient
): Promise<Pattern[]> {
  const patterns: Pattern[] = [];
  
  // Get recent queries
  const recentQueries = await getRecentQueries(supabase);
  
  // Group queries by pattern
  const queryGroups = groupByPattern(recentQueries);
  
  for (const [pattern, queries] of Object.entries(queryGroups)) {
    if (pattern.includes('SELECT') && 
        pattern.includes('FROM') && 
        queries.length > 10) {
      // Check if this looks like N+1
      const hasSubquery = queries.some(q => 
        q.includes('SELECT') && q.includes('WHERE id IN')
      );
      
      if (hasSubquery) {
        patterns.push({
          type: 'n_plus_one',
          severity: 'high',
          pattern: pattern.substring(0, 200),
          occurrenceCount: queries.length,
          suggestion: 'Use JOIN or batch query instead'
        });
      }
    }
  }
  
  return patterns;
}
```

### Bước 5: Auth Security Review

```typescript
// Review authentication configuration
interface AuthSecurityReview {
  providers: ProviderConfig[];
  securitySettings: SecuritySettings;
  vulnerabilities: Vulnerability[];
  mfaStatus: MFAStatus;
  sessionConfig: SessionConfig;
  recommendations: AuthRecommendation[];
}

async function reviewAuthSecurity(
  supabase: SupabaseClient
): Promise<AuthSecurityReview> {
  // Get auth providers
  const providers = await getAuthProviders(supabase);
  
  // Get security settings
  const settings = await getSecuritySettings(supabase);
  
  // Analyze vulnerabilities
  const vulnerabilities: Vulnerability[] = [];
  
  // Check for weak password policy
  if (settings.passwordMinLength < 8) {
    vulnerabilities.push({
      severity: 'medium',
      type: 'weak_password_policy',
      message: 'Password minimum length should be at least 8',
      current: settings.passwordMinLength
    });
  }
  
  // Check for email confirmations
  if (!settings.emailConfirm) {
    vulnerabilities.push({
      severity: 'high',
      type: 'no_email_confirmation',
      message: 'Email confirmation is disabled - users may use unverified emails'
    });
  }
  
  // Check session configuration
  const sessionIssues = analyzeSessionConfig(settings);
  vulnerabilities.push(...sessionIssues);
  
  // Check MFA status
  const mfaStatus = await checkMFAStatus(supabase);
  
  return {
    providers,
    securitySettings: settings,
    vulnerabilities,
    mfaStatus,
    sessionConfig: settings.session,
    recommendations: generateAuthRecommendations(vulnerabilities)
  };
}

function analyzeSessionConfig(settings: SecuritySettings): Vulnerability[] {
  const issues: Vulnerability[] = [];
  
  // Check JWT expiry
  if (settings.session.jwtExpiry > 3600) { // > 1 hour
    issues.push({
      severity: 'low',
      type: 'long_jwt_expiry',
      message: 'Long JWT expiry increases window for token theft',
      current: `${settings.session.jwtExpiry}s`,
      recommended: '3600'
    });
  }
  
  // Check for refresh token rotation
  if (!settings.session.refreshTokenRotation) {
    issues.push({
      severity: 'medium',
      type: 'no_refresh_rotation',
      message: 'Refresh token rotation is disabled',
      recommendation: 'Enable refresh token rotation'
    });
  }
  
  // Check for secure cookie settings
  if (!settings.session.secureCookie) {
    issues.push({
      severity: 'medium',
      type: 'insecure_cookie',
      message: 'Secure cookie flag is disabled',
      recommendation: 'Enable secure cookie for HTTPS'
    });
  }
  
  return issues;
}
```

### Bước 6: Cost Analysis

```typescript
// Analyze Supabase costs
interface CostAnalysis {
  currentUsage: UsageMetrics;
  costBreakdown: CostItem[];
  optimizationOpportunities: Opportunity[];
  projectedCosts: ProjectedCost[];
  recommendations: CostRecommendation[];
}

async function analyzeCosts(
  supabase: SupabaseClient
): Promise<CostAnalysis> {
  // Get usage metrics
  const usage = await getUsageMetrics(supabase);
  
  // Calculate current costs
  const currentCosts = calculateCurrentCosts(usage);
  
  // Find optimization opportunities
  const opportunities = [];
  
  // Database size optimization
  if (usage.databaseSize > 8 * 1024 * 1024 * 1024) { // > 8GB
    opportunities.push({
      type: 'database_size',
      potential: '30-50%',
      description: 'Archive old data or implement cleanup policies'
    });
  }
  
  // API request optimization
  if (usage.apiRequests > 500000) { // > 500k
    opportunities.push({
      type: 'api_requests',
      potential: '20-40%',
      description: 'Implement query caching and batch operations'
    });
  }
  
  // Storage optimization
  if (usage.storageUsed > 100 * 1024 * 1024) { // > 100MB
    opportunities.push({
      type: 'storage',
      potential: '40-60%',
      description: 'Compress images and remove unused files'
    });
  }
  
  // Realtime optimization
  if (usage.realtimeConnections > 200) {
    opportunities.push({
      type: 'realtime',
      potential: '30-50%',
      description: 'Reduce realtime subscriptions or implement pooling'
    });
  }
  
  return {
    currentUsage: usage,
    costBreakdown: currentCosts,
    optimizationOpportunities: opportunities,
    projectedCosts: projectFutureCosts(usage, opportunities),
    recommendations: generateCostRecommendations(opportunities)
  };
}
```

