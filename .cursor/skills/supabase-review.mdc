### Ví dụ 2: RLS Policy Generator

```typescript
// Generate secure RLS policies
function generateSecureRLSPolicies(
  table: TableInfo,
  userRole: 'user' | 'admin' | 'public'
): Policy[] {
  const policies: Policy[] = [];
  
  switch (userRole) {
    case 'user':
      // User can only see their own data
      policies.push({
        name: `${table.name}_owner_select`,
        command: 'SELECT',
        definition: `auth.uid() = ${table.name}.user_id`
      });
      
      // User can only insert their own data
      policies.push({
        name: `${table.name}_owner_insert`,
        command: 'INSERT',
        definition: `auth.uid() = new.user_id`
      });
      
      // User can only update their own data
      policies.push({
        name: `${table.name}_owner_update`,
        command: 'UPDATE',
        definition: `auth.uid() = ${table.name}.user_id`
      });
      
      // User can only delete their own data
      policies.push({
        name: `${table.name}_owner_delete`,
        command: 'DELETE',
        definition: `auth.uid() = ${table.name}.user_id`
      });
      break;
      
    case 'admin':
      // Admin can see all data
      policies.push({
        name: `${table.name}_admin_select`,
        command: 'SELECT',
        definition: `auth.jwt()->>'role' = 'admin'`
      });
      
      // Admin can do everything
      policies.push({
        name: `${table.name}_admin_all`,
        command: 'ALL',
        definition: `auth.jwt()->>'role' = 'admin'`
      });
      break;
      
    case 'public':
      // Public can only see published items
      policies.push({
        name: `${table.name}_public_select`,
        command: 'SELECT',
        definition: `${table.name}.is_published = true`
      });
      break;
  }
  
  return policies;
}
```

## Anti Patterns (Các pattern cần tránh)

### 1. Disabled RLS
```typescript
// ❌ BAD: RLS disabled for convenience
ALTER TABLE users DISABLE ROW LEVEL SECURITY;

// ✅ GOOD: Enable RLS with proper policies
ALTER TABLE users ENABLE ROW LEVEL SECURITY;
CREATE POLICY "Users can view own profile" ON users
  FOR SELECT USING (auth.uid() = id);
```

### 2. Bypassing RLS with Service Key
```typescript
// ❌ BAD: Using service role key in frontend
const supabase = createClient(
  'https://xxx.supabase.co',
  'service-role-key', // Never in frontend!
  { auth: { persistSession: false } }
);

// ✅ GOOD: Use anon key in frontend
const supabase = createClient(
  'https://xxx.supabase.co',
  'anon-key', // Safe for frontend
  { auth: { persistSession: true } }
);
```

### 3. Non-performant RLS
```typescript
// ❌ BAD: Complex subquery in every row check
CREATE POLICY "slow_policy" ON orders
  FOR SELECT USING (
    auth.uid() = user_id AND
    EXISTS (SELECT 1 FROM user_teams WHERE team_id = orders.team_id)
  );

// ✅ GOOD: Denormalized flag for fast checks
CREATE POLICY "fast_policy" ON orders
  FOR SELECT USING (auth.uid() = user_id);
```

### 4. Missing Indexes on Foreign Keys
```typescript
// ❌ BAD: Foreign key without index
ALTER TABLE orders ADD COLUMN user_id uuid REFERENCES users(id);

// ✅ GOOD: Add index for RLS performance
ALTER TABLE orders ADD COLUMN user_id uuid REFERENCES users(id);
CREATE INDEX idx_orders_user_id ON orders(user_id);
```

### 5. No Pagination
```typescript
// ❌ BAD: Fetching all rows
const { data } = await supabase.from('posts').select('*');

// ✅ GOOD: Paginated queries
const { data } = await supabase
  .from('posts')
  .select('*')
  .range(0, 9); // First 10 items
```

## Best Practices (Thực hành tốt nhất)

1. **Always enable RLS**: Security first, convenience second
2. **Use proper indexes**: Especially on foreign keys và RLS columns
3. **Test policies thoroughly**: Use `supabase.test' để verify
4. **Monitor query performance**: Use pg_stat_statements
5. **Implement proper error handling**: Handle RLS errors gracefully
6. **Use appropriate auth providers**: Match security requirements
7. **Enable MFA for sensitive apps**: User security matters
8. **Regular security audits**: Review RLS policies periodically
9. **Optimize costs proactively**: Monitor usage dashboards
10. **Document your schema**: Especially RLS policy rationale

