```

```typescript
// Memory Analysis Script
interface MemoryAnalysis {
  usedMemoryMB: number;
  peakMemoryMB: number;
  fragmentationRatio: number;
  memoryPerKey: number;
  topKeysByMemory: Array<{ key: string; memoryBytes: number }>;
}

async function analyzeRedisMemory(): Promise<MemoryAnalysis> {
  const info = await redis.info('memory');
  
  // Get top memory consuming keys
  const topKeys = await redis.execute(['MEMORY', 'USAGE', '*'], {
    pipeline: true
  });
  
  return {
    usedMemoryMB: info.used_memory / 1024 / 1024,
    peakMemoryMB: info.used_memory_peak / 1024 / 1024,
    fragmentationRatio: info.mem_fragmentation_ratio,
    memoryPerKey: calculateMemoryPerKey(info),
    topKeysByMemory: topKeys.slice(0, 10)
  };
}

// Key sampling for pattern analysis
async function sampleKeys(pattern: string = '*', count: number = 1000) {
  const keys = await redis.sampleKeys(pattern, count);
  
  const analysis = {
    strings: 0,
    lists: 0,
    sets: 0,
    hashes: 0,
    sortedSets: 0,
    streams: 0,
    totalKeys: 0,
    avgTTL: 0
  };
  
  for (const key of keys) {
    const type = await redis.type(key);
    analysis[`${type}s`]++;
    analysis.totalKeys++;
    
    const ttl = await redis.ttl(key);
    if (ttl > 0) analysis.avgTTL += ttl;
  }
  
  analysis.avgTTL /= count;
  return analysis;
}
```

### Bước 2: Cache Efficiency Analysis

```typescript
interface CacheMetrics {
  hits: number;
  misses: number;
  hitRate: number;
  evictions: number;
  expiredKeys: number;
  keyspace: {
    keys: number;
    expires: number;
    avgTTL: number;
  };
}

async function getCacheMetrics(): Promise<CacheMetrics> {
  const info = await redis.info('stats');
  const keyspace = await redis.info('keyspace');
  
  return {
    hits: info.keyspace_hits,
    misses: info.keyspace_misses,
    hitRate: info.keyspace_hits / (info.keyspace_hits + info.keyspace_misses) * 100,
    evictions: info.evicted_keys,
    expiredKeys: keyspace.keys - keyspace.expires,
    keyspace: {
      keys: keyspace.keys,
      expires: keyspace.expires,
      avgTTL: keyspace.avgttl || 0
    }
  };
}

// Cache hit rate by pattern
async function analyzeCachePatterns() {
  const patterns = [
    'user:*',
    'product:*',
    'session:*',
    'cart:*',
    'order:*'
  ];
  
  const analysis = [];
  
  for (const pattern of patterns) {
    const keys = await redis.keys(pattern);
    const sample = keys.slice(0, 100);
    
    let hits = 0;
    for (const key of sample) {
      const exists = await redis.exists(key);
      if (exists) hits++;
    }
    
    analysis.push({
      pattern,
      keyCount: keys.length,
      sampleHitRate: (hits / sample.length) * 100
    });
  }
  
  return analysis;
}
```

### Phase 2: Configuration Review

### Bước 3: Configuration Analysis

```bash
# Get all configuration
redis-cli CONFIG GET *

# Check specific settings
redis-cli CONFIG GET maxmemory
redis-cli CONFIG GET maxmemory-policy
redis-cli CONFIG GET save
redis-cli CONFIG GET appendonly
```

```typescript
interface RedisConfig {
  maxmemory: string;
  maxmemoryPolicy: string;
  persistence: 'rdb' | 'aof' | 'both' | 'no';
  savePoints: Array<{ seconds: number; changes: number }>;
  tcpBacklog: number;
  timeout: number;
  tcpKeepalive: number;
  replicaReadOnly: boolean;
}

async function analyzeConfiguration(): Promise<{
  issues: string[];
  recommendations: string[];
}> {
  const config = await redis.configGet('*');
  
  const issues: string[] = [];
  const recommendations: string[] = [];
  
  // Memory policy
  if (config.maxmemory_policy === 'noeviction') {
    issues.push('Using noeviction policy - may cause errors under memory pressure');
    recommendations.push('Consider volatile-lru for cached data');
  }
  
  // Persistence
  if (config.appendonly === 'no') {
    recommendations.push('Enable AOF for better durability');
    recommendations.push('Use appendfsync everysec for balance of safety and performance');
  }
  
  // Save points
  if (config.save === '') {
    issues.push('No RDB snapshots configured - risk of data loss');
    recommendations.push('Add save points: save 900 1 save 300 10 save 60 10000');
  }
  
  // Connection settings
  if (parseInt(config.timeout) === 0) {
    recommendations.push('Consider setting client timeout for production');
  }
  
  return { issues, recommendations };
}
```

### Phase 3: Optimization Implementation

### Bước 4: Data Structure Optimization

```typescript
// BEFORE: Multiple strings for user profile
await redis.set(`user:${id}:name`, user.name);
await redis.set(`user:${id}:email`, user.email);
await redis.set(`user:${id}:avatar`, user.avatar);
// 3 separate key lookups!

// AFTER: Hash for related data
await redis.hset(`user:${id}`, {
  name: user.name,
  email: user.email,
  avatar: user.avatar
});
// Single lookup for all fields

// Get specific field
const name = await redis.hget(`user:${id}`, 'name');

// Get multiple fields
const profile = await redis.hmget(`user:${id}`, 'name', 'email');

// BEFORE: List for recent items (unbounded growth)
await redis.lpush('recent:items', itemId);
await redis.ltrim('recent:items', 0, 99); // Manual trim needed

// AFTER: Sorted Set with timestamp score
await redis.zadd('recent:items', Date.now(), itemId);
await redis.zremrangebyrank('recent:items', 0, -101); // Keep top 100

// Get recent items
const recentItems = await redis.zrevrange('recent:items', 0, 9);
```

### Bước 5: Caching Strategy Implementation

```typescript
// Multi-layer Cache Implementation
interface CacheLayer {
  name: string;
  ttl: number;
  get: (key: string) => Promise<any>;
  set: (key: string, value: any, ttl?: number) => Promise<void>;
  invalidate: (key: string) => Promise<void>;
}

class RedisCache implements CacheLayer {
  name = 'redis';
  ttl: number;
  
  constructor(ttl: number = 300) {
    this.ttl = ttl;
  }
  
  async get(key: string): Promise<any> {
    const data = await redis.get(key);
    return data ? JSON.parse(data) : null;
  }
  
  async set(key: string, value: any, ttl?: number): Promise<void> {
    await redis.setex(key, ttl || this.ttl, JSON.stringify(value));
  }
  
  async invalidate(key: string): Promise<void> {
    await redis.del(key);
  }
}

// Cache-aside pattern
async function getWithCache<T>(
  key: string,
  fetcher: () => Promise<T>,
  ttl: number = 300
): Promise<T> {
  // L1: Local cache (in-memory)
  const local = localCache.get(key);
  if (local) return local;
  
  // L2: Redis cache
  const cached = await redisCache.get(key);
  if (cached) {
    localCache.set(key, cached, ttl / 2); // Half TTL for local
    return cached;
  }
  
  // Fetch from source
  const data = await fetcher();
  
  // Store in both layers
  await redisCache.set(key, data, ttl);
  localCache.set(key, data, ttl / 2);
  
  return data;
}

// Cache invalidation patterns
async function invalidateCache(pattern: string) {
  const keys = await redis.keys(pattern);
  
  // Use SCAN for production (non-blocking)
  let cursor = '0';
  const keysToDelete: string[] = [];
  
  do {
    const [newCursor, keys] = await redis.scan(cursor, {
      MATCH: pattern,
      COUNT: 100
    });
    cursor = newCursor;
    keysToDelete.push(...keys);
  } while (cursor !== '0');
  
  if (keysToDelete.length > 0) {
    await redis.del(...keysToDelete);
  }
  
  return keysToDelete.length;
}
```

### Bước 6: Connection Pool Optimization

```typescript
// Redis connection pool configuration
import IORedis from 'ioredis';

const redis = new IORedis.Cluster([
  { host: 'redis-1.example.com', port: 6379 },
  { host: 'redis-2.example.com', port: 6379 },
  { host: 'redis-3.example.com', port: 6379 }
], {
  // Connection pool settings
  maxRetriesPerRequest: 3,
  enableReadyCheck: true,
  retryStrategy: (times) => {
    if (times > 3) return null; // Stop retrying
    return Math.min(times * 200, 2000);
  },
  
  // Lua scripts for atomic operations
  scripts: {
    // Atomic get-or-set
    getOrSet: `
      local val = redis.call('GET', KEYS[1])
      if val then
        return val
      end
      local newVal = ARGV[1]
      local ttl = ARGV[2]
      redis.call('SETEX', KEYS[1], ttl, newVal)
      return nil
    `
  }
});

// Pipeline for batch operations
async function batchOperations() {
  const pipeline = redis.pipeline();
  
  for (const userId of userIds) {
    pipeline.hgetall(`user:${userId}`);
  }
  
  const results = await pipeline.exec();
  return results.map(([err, data]) => {
    if (err) return null;
    return data;
  });
}

// Pub/Sub for cache invalidation
const subscriber = new IORedis();
const publisher = new IORedis();

async function subscribeToInvalidation() {
  await subscriber.psubscribe('cache:invalidate:*');
  
  subscriber.on('pmessage', (pattern, channel, message) => {
    const key = channel.replace('cache:invalidate:', '');
    redis.del(key);
  });
}

async function publishInvalidation(key: string) {
  await publisher.publish(`cache:invalidate:${key}`, 'invalidate');
}
```

