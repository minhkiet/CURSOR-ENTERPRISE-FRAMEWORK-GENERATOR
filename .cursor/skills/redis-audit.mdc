## Examples (Ví dụ)

### Ví dụ: Session Store Optimization

**Before:**

```typescript
// Storing sessions as separate keys
async function createSession(sessionId: string, data: SessionData) {
  await redis.set(`session:${sessionId}`, JSON.stringify(data));
  // TTL set separately (race condition possible)
}

async function getSession(sessionId: string) {
  const data = await redis.get(`session:${sessionId}`);
  return data ? JSON.parse(data) : null;
}
```

**After:**

```typescript
// Optimized session management
class SessionStore {
  private readonly prefix = 'session:';
  private readonly defaultTTL = 86400; // 24 hours
  
  async create(sessionId: string, data: SessionData): Promise<void> {
    const key = `${this.prefix}${sessionId}`;
    
    // Store with TTL atomically
    await redis.setex(key, this.defaultTTL, JSON.stringify({
      ...data,
      createdAt: Date.now()
    }));
    
    // Track session for user
    await redis.sadd(`user:${data.userId}:sessions`, sessionId);
  }
  
  async get(sessionId: string): Promise<SessionData | null> {
    const key = `${this.prefix}${sessionId}`;
    const data = await redis.get(key);
    
    if (data) {
      // Refresh TTL on access
      await redis.expire(key, this.defaultTTL);
      return JSON.parse(data);
    }
    
    return null;
  }
  
  async invalidate(sessionId: string): Promise<void> {
    const key = `${this.prefix}${sessionId}`;
    const data = await redis.get(key);
    
    if (data) {
      const session = JSON.parse(data);
      await redis.srem(`user:${session.userId}:sessions`, sessionId);
    }
    
    await redis.del(key);
  }
  
  async invalidateUserSessions(userId: string): Promise<number> {
    const sessionIds = await redis.smembers(`user:${userId}:sessions`);
    
    if (sessionIds.length === 0) return 0;
    
    const keys = sessionIds.map(id => `${this.prefix}${id}`);
    keys.push(`user:${userId}:sessions`);
    
    return await redis.del(...keys);
  }
}
```

## Anti Pattern

- [ ] **Key Proliferation**: Too many small keys
- [ ] **No TTL**: Keys never expire
- [ ] **SET vs HSET**: Wrong data structure choice
- [ ] **Blocking Operations**: Long-running commands
- [ ] **No Connection Pooling**: Creating connections per request
- [ ] **SCAN abuse**: Using KEYS in production
- [ ] **Big Values**: Storing large objects without compression
- [ ] **Hot Keys**: Single keys receiving too many requests

## Best Practice

- [ ] **Use appropriate data structures**: Hash vs String
- [ ] **Set TTL**: Always set expiration
- [ ] **Pipeline commands**: Batch operations
- [ ] **Monitor memory**: Keep fragmentation low
- [ ] **Use connection pooling**: Reuse connections
- [ ] **SCAN not KEYS**: Use SCAN in production
- [ ] **Key naming convention**: Consistent naming
- [ ] **Cache invalidation**: Strategic invalidation

