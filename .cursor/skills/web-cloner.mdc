## Phase 1: Discovery

### 1.1 URL Analysis

```bash
# Mở trang web gốc
"$PWCLI" open https://target-website.com

# Lấy basic info
"$PWCLI" snapshot
"$PWCLI" eval "document.title"
"$PWCLI" eval "document.contentType"
"$PWCLI" eval "document.domain"

# Lấy meta information
"$PWCLI" eval "JSON.stringify({
  title: document.title,
  description: document.querySelector('meta[name=description]')?.content,
  keywords: document.querySelector('meta[name=keywords]')?.content,
  author: document.querySelector('meta[name=author]')?.content,
  viewport: document.querySelector('meta[name=viewport]')?.content
})"
```

### 1.2 Technology Detection

```bash
# Detect frontend framework
"$PWCLI" eval "JSON.stringify({
  framework: (() => {
    if (document.querySelector('[data-reactroot]')) return 'React';
    if (document.querySelector('[data-ng-app]') || document.querySelector('ng-app')) return 'Angular';
    if (document.querySelector('#__nuxt') || document.querySelector('[data-vue-app]')) return 'Vue/Nuxt';
    if (document.querySelector('[data-sveltekit]')) return 'SvelteKit';
    if (document.querySelector('#___gatsby')) return 'Gatsby';
    if (document.querySelector('#next')) return 'Next.js';
    return 'Vanilla/Unknown';
  })(),
  cssFramework: (() => {
    if (document.querySelector('[class*=bootstrap]')) return 'Bootstrap';
    if (document.querySelector('[class*=tailwind]')) return 'Tailwind';
    if (document.querySelector('[class*=material]')) return 'Material UI';
    if (document.querySelector('[class*=bulma]')) return 'Bulma';
    if (document.querySelector('[class*=foundation]')) return 'Foundation';
    return 'Custom/Unknown';
  })()
})"

# Detect JavaScript libraries
"$PWCLI" eval "Array.from(document.querySelectorAll('script[src]')).map(s => s.src).filter(src => src.match(/jquery|vue|react|angular|lodash|axios|fetch|moment|chart|d3|three/i))"

# Detect build tools
"$PWCLI" eval "Array.from(document.querySelectorAll('script[src]')).map(s => s.src).filter(src => src.match(/webpack|vite|esbuild|rollup|parcel|babel/i))"
```

### 1.3 Resource Inventory

```bash
# Lấy tất cả resources
"$PWCLI" eval "JSON.stringify({
  stylesheets: Array.from(document.querySelectorAll('link[rel=stylesheet]')).map(l => ({href: l.href, media: l.media})),
  scripts: Array.from(document.querySelectorAll('script[src]')).map(s => ({src: s.src, async: s.async, defer: s.defer})),
  images: Array.from(document.querySelectorAll('img')).map(img => ({src: img.src, alt: img.alt, width: img.width, height: img.height})),
  fonts: Array.from(document.querySelectorAll('link[href*=\"font\"]')).map(l => l.href)
})"
```

### 1.4 Navigation Structure

```bash
# Lấy sitemap (nếu có)
"$PWCLI" eval "fetch('/sitemap.xml').then(r => r.text()).catch(() => 'No sitemap')"

# Lấy all links
"$PWCLI" eval "Array.from(document.querySelectorAll('a[href]')).map(a => ({text: a.textContent.trim(), href: a.href, target: a.target})).filter(l => l.href.startsWith('http') || l.href.startsWith('/'))"

# Lấy menu/navigation structure
"$PWCLI" eval "JSON.stringify(Array.from(document.querySelectorAll('nav, header, [class*=nav], [class*=menu]')).map(nav => ({
  tag: nav.tagName,
  classes: nav.className,
  items: Array.from(nav.querySelectorAll('a')).map(a => ({text: a.textContent.trim(), href: a.href}))
})))"
```

## Phase 2: Extraction

### 2.1 HTML Structure Extraction

```bash
# Lấy full HTML
"$PWCLI" eval "document.documentElement.outerHTML"

# Lấy chỉ body content
"$PWCLI" eval "document.body.innerHTML"

# Lấy inline styles
"$PWCLI" eval "Array.from(document.querySelectorAll('[style]')).map(el => ({
  selector: (() => {
    if (el.id) return '#' + el.id;
    if (el.className) return '.' + el.className.split(' ').join('.');
    return el.tagName.toLowerCase();
  })(),
  styles: el.getAttribute('style')
}))"

# Lấy computed styles cho key elements
"$PWCLI" eval "JSON.stringify(Array.from(document.querySelectorAll('header, nav, main, section, footer, [class*=hero], [class*=banner]')).map(el => ({
  tag: el.tagName,
  class: el.className,
  styles: {
    display: getComputedStyle(el).display,
    width: getComputedStyle(el).width,
    height: getComputedStyle(el).height,
    background: getComputedStyle(el).background,
    color: getComputedStyle(el).color,
    fontSize: getComputedStyle(el).fontSize,
    margin: getComputedStyle(el).margin,
    padding: getComputedStyle(el).padding
  }
})))"
```

### 2.2 CSS Extraction

```bash
# Extract all CSS rules (cần extension hoặc CDP)
"$PWCLI" eval "Array.from(document.styleSheets).flatMap(sheet => {
  try {
    return Array.from(sheet.cssRules || []).map(rule => rule.cssText);
  } catch {
    return [];
  }
}).join('\\n')"

# Get critical CSS cho above-the-fold content
"$PWCLI" eval "Array.from(document.querySelectorAll('style')).map(s => s.textContent).join('\\n')"
```

### 2.3 JavaScript Extraction

```bash
# Lấy inline scripts
"$PWCLI" eval "Array.from(document.querySelectorAll('script:not([src])')).map(s => s.textContent)"

# Lấy external script URLs
"$PWCLI" eval "Array.from(document.querySelectorAll('script[src]')).map(s => s.src)"

# Check cho module scripts
"$PWCLI" eval "Array.from(document.querySelectorAll('script[type=module]')).map(s => s.src || s.textContent)"
```

### 2.4 Assets Download

```bash
# Tạo thư mục structure
mkdir -p clone-project/{css,js,images,fonts,assets}

# Download images
"$PWCLI" eval "JSON.stringify(Array.from(document.querySelectorAll('img')).map(img => img.src))"

# Download background images
"$PWCLI" eval "Array.from(document.querySelectorAll('*')).filter(el => getComputedStyle(el).backgroundImage !== 'none').map(el => getComputedStyle(el).backgroundImage.replace(/url\\(['\"]?(.+?)['\"]?\\)/, '$1'))"
```

### 2.5 Interactive Elements

```bash
# Lấy tất cả event listeners (cần CDP)
"$PWCLI" eval "JSON.stringify({
  forms: Array.from(document.querySelectorAll('form')).map(f => ({
    action: f.action,
    method: f.method,
    inputs: Array.from(f.querySelectorAll('input, select, textarea')).map(i => ({
      name: i.name,
      type: i.type,
      required: i.required
    }))
  })),
  buttons: Array.from(document.querySelectorAll('button, [onclick], [role=button]')).map(b => ({
    text: b.textContent.trim(),
    type: b.type || 'button'
  })),
  modals: Array.from(document.querySelectorAll('[class*=modal], [class*=dialog], dialog')).map(m => m.className)
})"

# Lấy any Web Components
"$PWCLI" eval "Array.from(document.querySelectorAll('*')).filter(el => el.shadowRoot).map(el => el.tagName.toLowerCase())"
```

