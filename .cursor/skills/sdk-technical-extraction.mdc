## Code Examples

### Basic Usage (basic-usage.ts)

```typescript
import { Client } from '{package-name}';

// Initialize client
const client = new Client({
  apiKey: process.env.API_KEY
});

// Make API call
const result = await client.{method}({
  param: 'value'
});

console.log(result);
```

### Authentication (authentication.ts)

```typescript
import { Client, AuthProvider } from '{package-name}';

// API Key authentication
const client = new Client({
  apiKey: 'your_api_key'
});

// OAuth authentication
const oauthClient = new Client({
  authProvider: new AuthProvider.OAuth({
    clientId: 'your_client_id',
    clientSecret: 'your_client_secret',
    redirectUri: 'your_redirect_uri'
  })
});
```

### Error Handling (error-handling.ts)

```typescript
import { Client, ValidationError, AuthError, ServerError } from '{package-name}';

const client = new Client({ apiKey: process.env.API_KEY });

try {
  const result = await client.{method}(params);
} catch (error) {
  if (error instanceof ValidationError) {
    console.error('Invalid parameters:', error.details);
  } else if (error instanceof AuthError) {
    console.error('Authentication failed:', error.message);
  } else if (error instanceof ServerError) {
    console.error('Server error:', error.message);
  } else {
    throw error;
  }
}
```

