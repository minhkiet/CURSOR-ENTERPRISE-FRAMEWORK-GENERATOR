## Workflow (Quy trình)

### Bước 1: Risk Analysis

```typescript
// Analyze application risks
interface RiskAnalysis {
  areas: RiskArea[];
  priority_order: string[];
  testing_focus: TestingFocus;
}

interface RiskArea {
  name: string;
  risk_level: 'critical' | 'high' | 'medium' | 'low';
  components: string[];
  failure_impact: string;
  mitigation_required: string[];
}

function analyzeRisks(application: Application): RiskAnalysis {
  const areas: RiskArea[] = [];
  
  // Identify high-risk areas
  for (const component of application.components) {
    const risk = assessComponentRisk(component);
    areas.push(risk);
  }
  
  return {
    areas,
    priority_order: areas
      .sort((a, b) => riskOrder(a.risk_level) - riskOrder(b.risk_level))
      .map(a => a.name),
    testing_focus: determineTestingFocus(areas)
  };
}

function assessComponentRisk(component: Component): RiskArea {
  let riskLevel: 'critical' | 'high' | 'medium' | 'low' = 'medium';
  
  if (component.type === 'payment') riskLevel = 'critical';
  if (component.type === 'auth') riskLevel = 'high';
  if (component.type === 'reporting') riskLevel = 'low';
  
  return {
    name: component.name,
    risk_level: riskLevel,
    components: [component.name],
    failure_impact: describeImpact(component),
    mitigation_required: determineMitigations(component, riskLevel)
  };
}
```

### Bước 2: Test Pyramid Design

```typescript
// Design test pyramid
interface TestPyramid {
  layers: PyramidLayer[];
  distribution: Distribution;
  coverage_targets: CoverageTarget[];
}

interface PyramidLayer {
  name: string;
  test_types: TestType[];
  percentage: number;
  count_target: number;
  automation_level: number;
}

function designTestPyramid(
  risks: RiskAnalysis,
  qualityReqs: QualityRequirements
): TestPyramid {
  // Standard pyramid distribution
  const layers: PyramidLayer[] = [
    {
      name: 'Unit',
      test_types: ['unit', 'mutation'],
      percentage: 70,
      count_target: calculateUnitTarget(risks),
      automation_level: 100
    },
    {
      name: 'Integration',
      test_types: ['api', 'database', 'service'],
      percentage: 20,
      count_target: calculateIntegrationTarget(risks),
      automation_level: 95
    },
    {
      name: 'E2E',
      test_types: ['e2e', 'smoke', 'regression'],
      percentage: 10,
      count_target: calculateE2ETarget(risks),
      automation_level: 80
    }
  ];
  
  return {
    layers,
    distribution: calculateDistribution(layers),
    coverage_targets: defineCoverageTargets(layers, qualityReqs)
  };
}

function defineCoverageTargets(
  layers: PyramidLayer[],
  qualityReqs: QualityRequirements
): CoverageTarget[] {
  return [
    {
      metric: 'line_coverage',
      layer: 'unit',
      target: qualityReqs.minLineCoverage || 80,
      critical: true
    },
    {
      metric: 'branch_coverage',
      layer: 'unit',
      target: qualityReqs.minBranchCoverage || 70,
      critical: false
    },
    {
      metric: 'api_coverage',
      layer: 'integration',
      target: 100,
      critical: true
    },
    {
      metric: 'critical_path_coverage',
      layer: 'e2e',
      target: 100,
      critical: true
    }
  ];
}
```

### Bước 3: Test Type Definition

```typescript
// Define test types and implementation
interface TestTypeDefinition {
  type: string;
  purpose: string;
  scope: string;
  implementation: ImplementationGuide;
  examples: Example[];
}

const testTypeDefinitions: TestTypeDefinition[] = [
  {
    type: 'Unit',
    purpose: 'Test individual functions/methods in isolation',
    scope: 'Single function or class',
    implementation: {
      framework: 'Jest|Vitest|Mocha',
      mocking: 'Required for external dependencies',
      assertions: 'Multiple per test',
      naming: 'describe method behavior'
    },
    examples: [
      {
        scenario: 'Calculate order total',
        test: `
describe('OrderCalculator', () => {
  it('calculates total with tax', () => {
    const calc = new OrderCalculator(taxRate = 0.1);
    const total = calc.calculateTotal(100);
    expect(total).toBe(110);
  });
});`
      }
    ]
  },
  {
    type: 'Integration',
    purpose: 'Test component interactions',
    scope: 'Multiple components/services',
    implementation: {
      framework: 'Supertest|Playwright|Postman',
      mocking: 'External services mocked',
      database: 'Test database or transaction rollback',
      assertions: 'Verifies contracts'
    },
    examples: [
      {
        scenario: 'API endpoint with database',
        test: `
it('creates user and returns 201', async () => {
  const res = await request(app)
    .post('/api/users')
    .send({ email: 'test@example.com' });
  
  expect(res.status).toBe(201);
  expect(await db.users.findByEmail('test@example.com')).toBeDefined();
});`
      }
    ]
  },
  {
    type: 'E2E',
    purpose: 'Test complete user flows',
    scope: 'Full application',
    implementation: {
      framework: 'Cypress|Playwright|Selenium',
      environment: 'Staging or production-like',
      users: 'Real users or automated',
      assertions: 'Business outcomes'
    },
    examples: [
      {
        scenario: 'User checkout flow',
        test: `
it('completes checkout successfully', () => {
  cy.login('user@test.com', 'password');
  cy.addToCart('Product A');
  cy.checkout();
  cy.assertOrderConfirmation();
});`
      }
    ]
  }
];
```

### Bước 4: Automation Planning

```typescript
// Plan test automation
interface AutomationPlan {
  phases: Phase[];
  ci_integration: CIConfig;
  reporting: ReportConfig;
  quality_gates: QualityGate[];
}

interface Phase {
  name: string;
  duration_weeks: number;
  activities: string[];
  deliverables: string[];
}

function createAutomationPlan(
  currentState: TestState,
  targetPyramid: TestPyramid
): AutomationPlan {
  const phases: Phase[] = [];
  
  // Phase 1: Foundation
  phases.push({
    name: 'Test Infrastructure',
    duration_weeks: 2,
    activities: [
      'Setup test frameworks',
      'Configure CI pipeline',
      'Create test database',
      'Establish test utilities'
    ],
    deliverables: [
      'Working test framework',
      'CI integration',
      'Test database scripts'
    ]
  });
  
  // Phase 2: Unit Tests
  phases.push({
    name: 'Unit Test Automation',
    duration_weeks: 4,
    activities: [
      'Train team on TDD',
      'Write unit tests for core modules',
      'Set up mutation testing',
      'Achieve coverage targets'
    ],
    deliverables: [
      'Unit tests for critical paths',
      'Coverage reports',
      'Mutation testing results'
    ]
  });
  
  return {
    phases,
    ci_integration: defineCIIntegration(targetPyramid),
    reporting: defineReporting(),
    quality_gates: defineQualityGates(targetPyramid)
  };
}

function defineQualityGates(pyramid: TestPyramid): QualityGate[] {
  return [
    {
      name: 'Unit Coverage Gate',
      check: 'line_coverage >= 80',
      failOnError: true,
      blocking: true
    },
    {
      name: 'All Tests Pass',
      check: 'failed_tests == 0',
      failOnError: true,
      blocking: true
    },
    {
      name: 'No Critical Bugs',
      check: 'critical_bugs == 0',
      failOnError: true,
      blocking: true
    },
    {
      name: 'Performance Baseline',
      check: 'regression_score >= 95',
      failOnError: false,
      blocking: false
    }
  ];
}
```

