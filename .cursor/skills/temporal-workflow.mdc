## Workflow (Quy trình)

### Bước 1: Workflow Design

```typescript
// Design Temporal workflow
interface WorkflowDesign {
  name: string;
  tasks: Task[];
  signals: Signal[];
  queries: Query[];
  retry_policy: RetryPolicy;
  timeout_config: TimeoutConfig;
}

function designWorkflow(
  requirements: ProcessRequirements
): WorkflowDesign {
  return {
    name: requirements.name,
    tasks: decomposeToTasks(requirements),
    signals: defineSignals(requirements),
    queries: defineQueries(requirements),
    retry_policy: createRetryPolicy(requirements),
    timeout_config: createTimeouts(requirements)
  };
}

function decomposeToTasks(
  requirements: ProcessRequirements
): Task[] {
  const tasks: Task[] = [];
  
  for (const step of requirements.steps) {
    tasks.push({
      name: step.name,
      activity: createActivityName(step),
      input: step.input,
      timeout: step.timeout,
      retry: step.retryEnabled ? defaultRetryPolicy : undefined
    });
  }
  
  return tasks;
}
```

### Bước 2: Workflow Implementation

```typescript
// Implement Temporal workflow
import { proxyActivities, defineSignal, defineQuery } from '@temporalio/workflow';

// Type definitions
interface OrderWorkflowInput {
  customerId: string;
  items: OrderItem[];
  shippingAddress: Address;
}

interface OrderWorkflowState {
  orderId?: string;
  status: 'pending' | 'confirmed' | 'processing' | 'shipped' | 'completed' | 'cancelled';
  paymentId?: string;
  trackingNumber?: string;
}

// Activities interface
const activities = proxyActivities<typeof import('../activities/order.activities')>({
  start: 'default',
  retry: {
    maximumAttempts: 3,
    initialInterval: '1 second',
    backoffCoefficient: 2.0,
    maximumInterval: '100 seconds'
  }
});

// Signals
const updateShippingAddress = defineSignal<[Address]>('updateShippingAddress');
const cancelOrder = defineSignal('cancelOrder');

// Queries
const getOrderStatus = defineQuery<string>('getOrderStatus');
const getOrderDetails = defineQuery<OrderWorkflowState>('getOrderDetails');

// Workflow implementation
export async function orderWorkflow(
  input: OrderWorkflowInput
): Promise<OrderResult> {
  // Initialize workflow state
  let state: OrderWorkflowState = {
    status: 'pending'
  };
  
  try {
    // Step 1: Validate order
    await activities.validateOrder(input);
    state.status = 'confirmed';
    
    // Step 2: Process payment
    const paymentResult = await activities.processPayment({
      customerId: input.customerId,
      amount: calculateTotal(input.items),
      currency: 'USD'
    });
    state.paymentId = paymentResult.paymentId;
    state.status = 'processing';
    
    // Step 3: Reserve inventory
    await activities.reserveInventory({
      items: input.items
    });
    
    // Step 4: Create shipment
    const shipment = await activities.createShipment({
      orderId: state.orderId!,
      address: input.shippingAddress,
      items: input.items
    });
    state.trackingNumber = shipment.trackingNumber;
    state.status = 'shipped';
    
    // Step 5: Send notifications
    await activities.sendOrderConfirmation({
      customerId: input.customerId,
      orderId: state.orderId!,
      trackingNumber: shipment.trackingNumber
    });
    
    state.status = 'completed';
    
    return {
      success: true,
      orderId: state.orderId!,
      trackingNumber: shipment.trackingNumber
    };
    
  } catch (error) {
    // Compensating transactions
    if (state.paymentId) {
      await activities.refundPayment({ paymentId: state.paymentId });
    }
    if (state.orderId) {
      await activities.cancelReservation({ orderId: state.orderId });
    }
    
    state.status = 'cancelled';
    
    return {
      success: false,
      error: error.message
    };
  }
}
```

### Bước 3: Activity Implementation

```typescript
// Implement Temporal activities
import { Context } from '@temporalio/activity';

interface OrderActivities {
  validateOrder(input: OrderValidationInput): Promise<ValidationResult>;
  processPayment(input: PaymentInput): Promise<PaymentResult>;
  reserveInventory(input: InventoryInput): Promise<InventoryResult>;
  createShipment(input: ShipmentInput): Promise<ShipmentResult>;
  sendOrderConfirmation(input: NotificationInput): Promise<void>;
  refundPayment(input: RefundInput): Promise<void>;
  cancelReservation(input: CancelInput): Promise<void>;
}

export async function validateOrder(
  input: OrderValidationInput
): Promise<ValidationResult> {
  const log = Context.current().log;
  
  log.info('Validating order', { customerId: input.customerId });
  
  // Validate customer exists
  const customer = await customerService.findById(input.customerId);
  if (!customer) {
    throw new ApplicationError('Customer not found', 'CUSTOMER_NOT_FOUND');
  }
  
  // Validate items exist
  for (const item of input.items) {
    const product = await productService.findById(item.productId);
    if (!product) {
      throw new ApplicationError(
        `Product not found: ${item.productId}`,
        'PRODUCT_NOT_FOUND'
      );
    }
    
    if (product.stock < item.quantity) {
      throw new ApplicationError(
        `Insufficient stock for ${product.name}`,
        'INSUFFICIENT_STOCK'
      );
    }
  }
  
  return {
    valid: true,
    customerName: customer.name,
    validatedItems: input.items.map(item => ({
      productId: item.productId,
      price: item.price
    }))
  };
}

export async function processPayment(
  input: PaymentInput
): Promise<PaymentResult> {
  const log = Context.current().log;
  
  log.info('Processing payment', { 
    customerId: input.customerId, 
    amount: input.amount 
  });
  
  try {
    const payment = await paymentGateway.charge({
      amount: input.amount,
      currency: input.currency,
      customerId: input.customerId,
      idempotencyKey: Context.current().info.workflowExecution.workflowId
    });
    
    return {
      success: true,
      paymentId: payment.id,
      transactionId: payment.transactionId
    };
  } catch (error) {
    log.error('Payment failed', { error });
    throw new ApplicationError(
      'Payment processing failed',
      'PAYMENT_FAILED',
      true // Non-retryable
    );
  }
}
```

### Bước 4: Client Implementation

```typescript
// Implement Temporal client
import { Connection, Client, WorkflowClient } from '@temporalio/client';
import { orderWorkflow, OrderWorkflowInput, OrderResult } from '../workflows/order.workflow';

class OrderWorkflowClient {
  private client: Client;
  
  constructor() {
    this.client = new Client({
      connection: Connection.connect({
        address: process.env.TEMPORAL_ADDRESS || 'localhost:7233'
      })
    });
  }
  
  async startOrderWorkflow(
    input: OrderWorkflowInput,
    options?: {
      workflowId?: string;
      taskQueue?: string;
      memo?: Record<string, unknown>;
    }
  ): Promise<string> {
    const handle = await this.client.workflow.start(orderWorkflow, {
      taskQueue: options?.taskQueue || 'order-queue',
      args: [input],
      workflowId: options?.workflowId || `order-${Date.now()}`,
      memo: options?.memo,
      retryPolicy: {
        maximumAttempts: 1 // Workflow-level retries
      }
    });
    
    console.log(`Started workflow ${handle.workflowId}`);
    return handle.workflowId;
  }
  
  async sendSignal(
    workflowId: string,
    signalName: string,
    signalArgs: any[]
  ): Promise<void> {
    const handle = this.client.workflow.getHandle(workflowId);
    
    switch (signalName) {
      case 'updateShippingAddress':
        await handle.signal(
          // @ts-ignore - signal type
          orderWorkflow.updateShippingAddress,
          ...signalArgs
        );
        break;
      case 'cancelOrder':
        await handle.signal(orderWorkflow.cancelOrder);
        break;
    }
  }
  
  async queryWorkflow(
    workflowId: string,
    queryType: string
  ): Promise<any> {
    const handle = this.client.workflow.getHandle(workflowId);
    
    switch (queryType) {
      case 'getOrderStatus':
        return handle.query(orderWorkflow.getOrderStatus);
      case 'getOrderDetails':
        return handle.query(orderWorkflow.getOrderDetails);
    }
  }
  
  async terminateWorkflow(
    workflowId: string,
    reason: string
  ): Promise<void> {
    const handle = this.client.workflow.getHandle(workflowId);
    await handle.terminate(reason);
  }
  
  async listWorkflows(filter?: {
    workflowType?: string;
    status?: WorkflowStatus;
    startTime?: Date;
  }): Promise<WorkflowExecution[]> {
    const workflows = await this.client.workflow.list({
      type: { name: filter?.workflowType },
      status: filter?.status,
      startTime: filter?.startTime
    });
    
    return workflows.executions;
  }
}
```

### Bước 5: Error Handling

```typescript
// Implement error handling strategies
interface ErrorHandlingStrategy {
  retryable: boolean;
  retryPolicy?: RetryPolicy;
  compensatingAction?: string;
  fallbackAction?: string;
}

const errorStrategies: Record<string, ErrorHandlingStrategy> = {
  'NETWORK_ERROR': {
    retryable: true,
    retryPolicy: {
      maximumAttempts: 5,
      initialInterval: '1 second',
      backoffCoefficient: 2.0
    }
  },
  'TIMEOUT': {
    retryable: true,
    retryPolicy: {
      maximumAttempts: 3,
      initialInterval: '5 seconds'
    }
  },
  'PAYMENT_DECLINED': {
    retryable: false,
    compensatingAction: 'releaseInventory'
  },
  'INSUFFICIENT_STOCK': {
    retryable: false,
    fallbackAction: 'notifyCustomer'
  },
  'CUSTOMER_NOT_FOUND': {
    retryable: false
  }
};

function determineErrorStrategy(error: Error): ErrorHandlingStrategy {
  const errorCode = (error as ApplicationError).code;
  return errorStrategies[errorCode] || {
    retryable: false
  };
}

// Workflow error handling
export async function resilientWorkflow(input: WorkflowInput) {
  try {
    return await mainWorkflow(input);
  } catch (error) {
    const strategy = determineErrorStrategy(error);
    
    if (strategy.compensatingAction) {
      await executeCompensation(strategy.compensatingAction, error);
    }
    
    if (strategy.fallbackAction) {
      return await executeFallback(strategy.fallbackAction, error);
    }
    
    throw error;
  }
}
```

