### Ví dụ 2: Compiling Codebase Patterns

```typescript
// Extract và compile coding patterns
async function compileCodePatterns(rootPath: string) {
  const compiler = new KnowledgeCompiler({
    root_path: rootPath,
    source_patterns: [
      'src/**/*.ts',
      'src/**/*.tsx',
      '*.md'
    ],
    extraction_rules: {
      patterns: [
        { type: 'naming_convention', regex: /^[a-z][a-z0-9]*$/ },
        { type: 'component_pattern', extraction: extractReactPatterns },
        { type: 'hook_pattern', extraction: extractHookPatterns }
      ]
    }
  });
  
  const kb = await compiler.compile();
  
  // Query patterns
  const reactPatterns = kb.query({ type: 'component_pattern' });
  const namingRules = kb.query({ type: 'naming_convention' });
  
  return { kb, reactPatterns, namingRules };
}
```

### Ví dụ 3: Incremental Compilation

```typescript
// Incremental compile chỉ changed files
class IncrementalCompiler extends KnowledgeCompiler {
  async compileIncremental(changes: FileChange[]): Promise<Diff> {
    const affectedEntities = new Set<string>();
    
    for (const change of changes) {
      const source = await this.readSource(change.path);
      const normalized = this.normalizeContent(source);
      const entities = this.extractEntities(normalized);
      
      // Remove old entities
      const oldEntities = await this.getEntitiesAtPath(change.path);
      await this.removeEntities(oldEntities);
      
      // Add new entities
      await this.addEntities(entities);
      
      // Update relationships
      await this.updateRelationships(entities);
      
      entities.forEach(e => affectedEntities.add(e.id));
    }
    
    // Regenerate affected embeddings
    await this.regenerateEmbeddings([...affectedEntities]);
    
    return { affectedEntities, timestamp: new Date() };
  }
}
```

## Anti Patterns (Các pattern cần tránh)

### 1. Monolithic Compilation
```typescript
// ❌ BAD: Compile toàn bộ một lần, không incremental
async function badCompile(path: string) {
  const allFiles = await getAllFiles(path);
  const allContent = await Promise.all(allFiles.map(readFile));
  return parse(allContent.join('\n'));
}

// ✅ GOOD: Incremental compilation với change detection
async function goodCompile(path: string) {
  const changes = await detectChanges(path);
  return incrementalCompile(changes);
}
```

### 2. Ignoring Provenance
```typescript
// ❌ BAD: Không track nguồn gốc
function badExtract(doc: string) {
  return { content: doc, id: generateId() };
}

// ✅ GOOD: Full provenance tracking
function goodExtract(doc: Document) {
  return {
    content: doc.content,
    id: generateId(),
    source: doc.path,
    author: doc.metadata.author,
    version: doc.metadata.version,
    lineage: doc.metadata.derived_from
  };
}
```

### 3. Shallow Relationships
```typescript
// ❌ BAD: Chỉ direct relationships, no transitive
function badMap(entities: Entity[]) {
  return entities.flatMap(e => 
    e.references.map(r => ({ source: e.id, target: r }))
  );
}

// ✅ GOOD: Full transitive closure
function goodMap(entities: Entity[]) {
  const direct = extractDirectRelationships(entities);
  return transitiveClosure(direct);
}
```

### 4. Static Embeddings
```typescript
// ❌ BAD: Embeddings không update khi content thay đổi
function badEmbed(entities: Entity[]) {
  return entities.map(e => ({
    entity_id: e.id,
    vector: staticEmbed(e.text)
  }));
}

// ✅ GOOD: Dynamic embedding với versioning
function goodEmbed(entities: Entity[]) {
  return entities.map(e => ({
    entity_id: e.id,
    vector: currentEmbed(e.text),
    version: hash(e.text),
    embedding_model: CURRENT_MODEL
  }));
}
```

### 5. Flat Structure
```typescript
// ❌ BAD: Flat list, no hierarchy
function badStore(entities: Entity[]) {
  return { entities: entities.flat() };
}

// ✅ GOOD: Hierarchical structure với indexes
function goodStore(entities: Entity[]) {
  return {
    entities: nestByType(entities),
    indexes: {
      by_type: indexBy(entities, 'type'),
      by_domain: indexBy(entities, 'domain'),
      by_dependency: buildDependencyIndex(entities)
    }
  };
}
```

## Best Practices (Thực hành tốt nhất)

1. **Always use incremental compilation**: Chỉ rebuild phần thay đổi, không rebuild toàn bộ
2. **Maintain bidirectional references**: Cập nhật cả source và target references
3. **Version everything**: Track versions cho cả content và relationships
4. **Validate after extraction**: Đảm bảo extracted entities có integrity
5. **Use canonical IDs**: Consistent ID scheme across all entities
6. **Separate concerns**: Tách biệt extraction, normalization, và storage
7. **Cache intermediate results**: Tránh recomputation không cần thiết
8. **Monitor quality metrics**: Track precision, recall của extraction
9. **Support rollback**: Có mechanism để revert bad compilations
10. **Document provenance**: Rõ ràng về nguồn gốc và transformation chain

