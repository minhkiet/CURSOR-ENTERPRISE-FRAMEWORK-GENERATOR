})"

# Mobile (375px - iPhone)
"$PWCLI" resize 375 667
"$PWCLI" screenshot responsive-iphone.png

# Tablet (768px)
"$PWCLI" resize 768 1024
"$PWCLI" snapshot
"$PWCLI" screenshot responsive-tablet.png

# Desktop (1920px)
"$PWCLI" resize 1920 1080
"$PWCLI" snapshot
"$PWCLI" screenshot responsive-desktop.png
```

### Phase 6: Performance Comparison

```bash
# Network requests comparison
"$PWCLI" tab-select 0  # Original
"$PWCLI" network
# Navigate to trigger all requests
"$PWCLI" reload
"$PWCLI" eval "JSON.stringify({
  resourceCount: performance.getEntriesByType('resource').length,
  totalSize: performance.getEntriesByType('resource').reduce((sum, r) => sum + (r.transferSize || 0), 0),
  domComplete: performance.timing.domContentLoaded,
  loadComplete: performance.timing.loadComplete
})"

"$PWCLI" tab-select 1  # Clone
"$PWCLI" network
"$PWCLI" reload
"$PWCLI" eval "JSON.stringify({
  resourceCount: performance.getEntriesByType('resource').length,
  totalSize: performance.getEntriesByType('resource').reduce((sum, r) => sum + (r.transferSize || 0), 0),
  domComplete: performance.timing.domContentLoaded,
  loadComplete: performance.timing.loadComplete
})"
```

