  // Infrastructure Metrics
  cpuUsage: number;
  memoryUsage: number;
  networkLatency: number;
  
  // Custom Business Metrics
  checkoutConversionRate: number;
  searchLatency: number;
}

// Data Collection Script
async function collectMetrics(): Promise<PerformanceMetrics> {
  const [apmData, dbMetrics, infraMetrics] = await Promise.all([
    fetchAPMData(),
    fetchDatabaseMetrics(),
    fetchInfraMetrics()
  ]);
  
  return mergeMetrics(apmData, dbMetrics, infraMetrics);
}
```

### Bước 2: Profiling Setup

```typescript
// Node.js Profiling
// Enable CPU profiling
import { profiler } from 'v8';

// Start profiling
profiler.startProfiling('performance-audit');

// Run representative load
await simulateUserTraffic(1000);

// Stop and save profile
const profile = profiler.stopProfiling();
await writeFile('profile.cpuprofile', JSON.stringify(profile));

// Memory profiling
const heapBefore = process.memoryUsage();
await runWorkload();
const heapAfter = process.memoryUsage();

console.log({
  heapDelta: heapAfter.heapUsed - heapBefore.heapUsed,
  externalDelta: heapAfter.external - heapBefore.external
});
```

### Phase 2: Analysis

### Bước 3: Bottleneck Identification

```
Performance Bottleneck Categories:

1. CPU Bound
   - Inefficient algorithms
   - Heavy computation
   - Crypto operations
   - Image processing

2. I/O Bound
   - Database queries
   - Network calls
   - File operations
   - External API calls

3. Memory Bound
   - Memory leaks
   - Large data structures
   - Memory allocation patterns
   - Garbage collection pressure

4. Concurrency Bound
   - Lock contention
   - Thread pool exhaustion
   - Connection pool limits
   - Rate limiting
```

### Bước 4: Database Analysis

```sql
-- Slow Query Analysis
SELECT 
  query,
  calls,
  mean_time,
  total_time,
  rows
FROM pg_stat_statements
WHERE mean_time > 100  -- Queries taking > 100ms on average
ORDER BY total_time DESC
LIMIT 20;

-- Query Execution Plan Analysis
EXPLAIN (ANALYZE, BUFFERS, FORMAT JSON)
SELECT o.*, u.name 
FROM orders o
JOIN users u ON o.user_id = u.id
WHERE o.created_at > NOW() - INTERVAL '7 days'
ORDER BY o.total DESC;

-- Index Usage Analysis
SELECT 
  schemaname,
  tablename,
  indexname,
  idx_tup_read,
  idx_tup_fetch,
  idx_scan
FROM pg_stat_user_indexes
ORDER BY idx_tup_read DESC;
```

### Phase 3: Optimization

### Bước 5: Optimization Implementation

```typescript
// Example: Optimizing N+1 Query Problem

// BEFORE: N+1 Query
async function getOrdersWithUsers(orderIds: string[]) {
  const orders = await db.query(
    'SELECT * FROM orders WHERE id = ANY($1)',
    [orderIds]
  );
  
  // N+1 Problem: Separate query for each order's user
  for (const order of orders) {
    order.user = await db.query(
      'SELECT * FROM users WHERE id = $1',
      [order.userId]
    );
  }
  
  return orders;
}

// AFTER: Single JOIN Query
async function getOrdersWithUsers(orderIds: string[]) {
  const result = await db.query(`
    SELECT 
      o.*,
      u.id as user_id,
      u.name as user_name,
      u.email as user_email
    FROM orders o
    JOIN users u ON o.user_id = u.id
    WHERE o.id = ANY($1)
  `, [orderIds]);
  
  // Group results back into orders
  return groupByOrderId(result);
}

// AFTER: Batch Query with IN clause
async function getOrdersWithUsersBatch(orderIds: string[]) {
  const orders = await db.query(
    'SELECT * FROM orders WHERE id = ANY($1)',
    [orderIds]
  );
  
  // Single batch query for all users
  const userIds = [...new Set(orders.map(o => o.userId))];
  const users = await db.query(
    'SELECT * FROM users WHERE id = ANY($1)',
    [userIds]
  );
  
  // Map users to orders in memory
  const userMap = new Map(users.map(u => [u.id, u]));
  orders.forEach(o => o.user = userMap.get(o.userId));
  
  return orders;
}
```

### Bước 6: Caching Strategy

```typescript
// Multi-layer Caching Implementation

// Layer 1: Application Cache
const productCache = new NodeCache({ 
  stdTTL: 300,  // 5 minutes
  checkperiod: 60 
});

async function getProduct(productId: string) {
  // Check cache first
  const cached = productCache.get<Product>(productId);
  if (cached) return cached;
  
  // Fetch from database
  const product = await db.products.findById(productId);
  
  // Cache result
  productCache.set(productId, product);
  
  return product;
}

// Layer 2: Redis Distributed Cache
async function getProductRedis(productId: string) {
  const cacheKey = `product:${productId}`;
  
  // Try Redis first
  const cached = await redis.get(cacheKey);
  if (cached) {
    return JSON.parse(cached);
  }
  
  // Fetch from database
  const product = await db.products.findById(productId);
  
  // Store in Redis with TTL
  await redis.setex(cacheKey, 300, JSON.stringify(product));
  
  return product;
}

// Cache Invalidation
async function invalidateProductCache(productId: string) {
  productCache.del(productId);
  await redis.del(`product:${productId}`);
}

// Event-driven cache invalidation
eventBus.subscribe('product.updated', async (event) => {
  await invalidateProductCache(event.productId);
});
```

### Bước 7: Benchmarking

```typescript
// Benchmark Suite
import Benchmark from 'benchmark';

const suite = new Benchmark.Suite('Database Query Optimization');

// Original implementation
suite.add('N+1 Query', async () => {
  const orders = await getOrdersNPlusOne(userId);
});

// Optimized with JOIN
suite.add('JOIN Query', async () => {
  const orders = await getOrdersWithJoin(userId);
});

// Optimized with batch query
suite.add('Batch Query', async () => {
  const orders = await getOrdersBatch(userId);
});

suite
  .on('cycle', (event) => {
    console.log(String(event.target));
  })
  .on('complete', function() {
    console.log('Fastest: ' + this.filter('fastest').map('name'));
  })
  .run({ async: true });

// Results:
// N+1 Query:    245 ms  (± 5.2%)
// JOIN Query:   45 ms   (± 1.1%)
// Batch Query:  38 ms   (± 0.8%)
```

