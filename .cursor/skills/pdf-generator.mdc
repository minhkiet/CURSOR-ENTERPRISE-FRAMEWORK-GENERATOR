### Ví dụ 3: Batch PDF Generation

```typescript
// Batch generate multiple PDFs
class BatchPDFGenerator {
  private queue: PQueue;
  private generator: PDFGenerator;
  
  constructor(concurrency: number = 3) {
    this.queue = new PQueue({ concurrency });
    this.generator = new PDFGenerator();
  }
  
  async generateBatch(
    jobs: PDFJob[]
  ): Promise<BatchResult> {
    const results: JobResult[] = [];
    const errors: JobError[] = [];
    
    const promises = jobs.map(job => 
      this.queue.add(async () => {
        try {
          const pdf = await this.generate(job);
          results.push({ jobId: job.id, success: true, pdf });
        } catch (error) {
          errors.push({ jobId: job.id, error });
        }
      })
    );
    
    await Promise.all(promises);
    
    return {
      total: jobs.length,
      successful: results.length,
      failed: errors.length,
      results,
      errors
    };
  }
  
  async generate(job: PDFJob): Promise<Buffer> {
    const content = await this.parseJobContent(job);
    
    return await this.generator.generate(content, {
      ...job.options,
      // Add job-specific options
      filename: job.filename,
      metadata: { ...job.metadata, jobId: job.id }
    });
  }
}

// Usage
const batch = new BatchPDFGenerator(3);
const results = await batch.generateBatch([
  { id: '1', type: 'invoice', data: invoiceData },
  { id: '2', type: 'report', data: reportData },
  { id: '3', type: 'certificate', data: certData }
]);
```

## Anti Patterns (Các pattern cần tránh)

### 1. Hard-coded Content
```typescript
// ❌ BAD: Inline all content
async function badGenerate() {
  const pdf = await generator.create({
    title: 'Report',
    content: '<h1>Title</h1><p>Lots of hardcoded content...</p>'
  });
}

// ✅ GOOD: Separate content from generation
async function goodGenerate(config: DocConfig) {
  const content = await loadContent(config.contentPath);
  const pdf = await generator.create({ ...config, content });
}
```

### 2. Ignoring Page Breaks
```typescript
// ❌ BAD: No page break handling
async function badGenerate(sections) {
  for (const section of sections) {
    page.drawText(section.content);
  }
}

// ✅ GOOD: Smart pagination
async function goodGenerate(sections) {
  for (const section of sections) {
    if (!fitsOnPage(section)) {
      newPage();
    }
    renderSection(section);
  }
}
```

### 3. Missing Font Embedding
```typescript
// ❌ BAD: System fonts only
const pdf = await generator.generate({ fonts: 'system' });

// ✅ GOOD: Embed all fonts
const pdf = await generator.generate({
  fonts: {
    regular: await embedFont('Roboto-Regular.ttf'),
    bold: await embedFont('Roboto-Bold.ttf'),
    mono: await embedFont('RobotoMono-Regular.ttf')
  }
});
```

### 4. No Error Handling
```typescript
// ❌ BAD: Silent failures
async function badGenerate(config) {
  return await generator.create(config);
}

// ✅ GOOD: Comprehensive error handling
async function goodGenerate(config) {
  try {
    const content = await parser.parse(config.content);
    const pdf = await generator.generate(content, config.options);
    await validator.validate(pdf);
    return pdf;
  } catch (error) {
    logger.error('PDF generation failed', { config, error });
    throw new PDFGenerationError(error);
  }
}
```

### 5. Ignoring Compression
```typescript
// ❌ BAD: No compression
const pdf = await doc.save(); // Large file

// ✅ GOOD: Optimize output
const pdf = await doc.save({
  useCompression: true,
  objectStreams: 'generate',
  addDefaultPage: false
});
```

## Best Practices (Thực hành tốt nhất)

1. **Use templates**: Define consistent styling in templates
2. **Separate content từ formatting**: Keep data và styles separate
3. **Embed fonts**: Always embed fonts for portability
4. **Optimize images**: Resize images before embedding
5. **Test pagination**: Verify page breaks work correctly
6. **Add metadata**: Include document metadata for searchability
7. **Compress output**: Balance quality và file size
8. **Use PDF/A for archives**: Long-term preservation requires PDF/A
9. **Add bookmarks**: Improve navigation in long documents
10. **Validate output**: Check generated PDFs before distribution

