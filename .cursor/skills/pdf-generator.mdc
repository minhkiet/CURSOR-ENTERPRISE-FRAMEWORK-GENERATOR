## Examples (Ví dụ)

### Ví dụ 1: Generate Documentation PDF

```typescript
// Generate documentation từ markdown files
async function generateDocumentationPDF(
  docsPath: string,
  outputPath: string
): Promise<void> {
  const generator = new PDFGenerator({
    template: 'technical-docs',
    pageSize: 'A4',
    margins: { top: 25, bottom: 25, left: 20, right: 20 }
  });
  
  // Collect all markdown files
  const files = await glob('**/*.md', { cwd: docsPath });
  
  // Parse content
  const content = await generator.parseContent(files, {
    includeCodeExamples: true,
    syntaxHighlighting: 'prism',
    includeImages: true
  });
  
  // Generate PDF
  const pdf = await generator.generate(content, {
    title: 'Technical Documentation',
    author: 'Engineering Team',
    subject: 'API Documentation',
    version: '1.0.0',
    includeToc: true,
    includeBookmarks: true,
    pageNumberFormat: 'Page {current} of {total}'
  });
  
  // Save
  await fs.writeFile(outputPath, pdf);
}
```

