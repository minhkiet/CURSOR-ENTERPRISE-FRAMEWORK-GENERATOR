## Workflow (Quy trình)

### Bước 1: Project Structure Analysis

```typescript
// Analyze Nuxt project structure
interface NuxtStructure {
  version: string;
  renderingMode: RenderingMode;
  modules: ModuleInfo[];
  plugins: PluginInfo[];
  middleware: MiddlewareInfo[];
  directories: DirectoryInfo;
  issues: StructureIssue[];
}

type RenderingMode = 'ssr' | 'ssg' | 'swr' | 'spa' | 'hybrid';

async function analyzeNuxtStructure(
  rootPath: string
): Promise<NuxtStructure> {
  const nuxtConfig = await parseNuxtConfig(`${rootPath}/nuxt.config.ts`);
  const pkg = JSON.parse(await readFile(`${rootPath}/package.json`));
  
  // Determine rendering mode
  const renderMode = detectRenderingMode(nuxtConfig);
  
  // Analyze modules
  const modules = analyzeModules(nuxtConfig, pkg);
  
  // Analyze directories
  const directories = await analyzeDirectories(rootPath);
  
  // Check for issues
  const issues = checkNuxtIssues(nuxtConfig, modules, directories);
  
  return {
    version: pkg.dependencies?.nuxt || 'unknown',
    renderingMode: renderMode,
    modules,
    plugins: await analyzePlugins(rootPath),
    middleware: await analyzeMiddleware(rootPath),
    directories,
    issues
  };
}

function detectRenderingMode(config: NuxtConfig): RenderingMode {
  if (config.ssr === false && !config.routeRules) {
    return 'spa';
  }
  if (config.routeRules) {
    const rules = Object.values(config.routeRules)[0] as any;
    if (rules.prerender) return 'ssg';
    if (rules.swr) return 'swr';
  }
  if (config.prerender?.routes) {
    return 'ssg';
  }
  return 'ssr';
}

function analyzeModules(config: NuxtConfig, pkg: PackageJson): ModuleInfo[] {
  const moduleNames = config.modules || [];
  const moduleInfos: ModuleInfo[] = [];
  
  for (const module of moduleNames) {
    const version = pkg.devDependencies?.[module] || pkg.dependencies?.[module];
    moduleInfos.push({
      name: module,
      version: version || 'unknown',
      isDeprecated: isDeprecated(module),
      hasBreakingChanges: hasBreakingChanges(module)
    });
  }
  
  return moduleInfos;
}

function checkNuxtIssues(
  config: NuxtConfig,
  modules: ModuleInfo[],
  directories: DirectoryInfo
): StructureIssue[] {
  const issues: StructureIssue[] = [];
  
  // Check for deprecated modules
  for (const mod of modules) {
    if (mod.isDeprecated) {
      issues.push({
        type: 'deprecated_module',
        module: mod.name,
        severity: 'high',
        message: `${mod.name} is deprecated - consider alternatives`
      });
    }
  }
  
  // Check for missing essential modules
  if (!modules.find(m => m.name.includes('image'))) {
    issues.push({
      type: 'missing_module',
      module: '@nuxt/image',
      severity: 'low',
      message: 'Consider adding @nuxt/image for optimized images'
    });
  }
  
  // Check for TypeScript
  if (!config Typescript?.strict && !config Typescript === false) {
    issues.push({
      type: 'typescript_config',
      severity: 'medium',
      message: 'Consider enabling strict TypeScript'
    });
  }
  
  return issues;
}
```

### Bước 2: Rendering Analysis

```typescript
// Analyze rendering strategies
interface RenderingAnalysis {
  routes: RouteRenderingInfo[];
  hybrid_routes: HybridRoute[];
  prerender_config: PrerenderConfig;
  issues: RenderingIssue[];
}

async function analyzeRendering(
  rootPath: string,
  config: NuxtConfig
): Promise<RenderingAnalysis> {
  const pages = await glob('**/*.vue', { cwd: `${rootPath}/pages` });
  const routes: RouteRenderingInfo[] = [];
  const issues: RenderingIssue[] = [];
  
  for (const page of pages) {
    const content = await readFile(page);
    const rendering = detectPageRendering(content, config);
    
    routes.push({
      path: pageToRoute(page),
      file: page,
      mode: rendering.mode,
      hasStreaming: rendering.hasStreaming,
      hasSuspense: rendering.hasSuspense
    });
    
    // Check for issues
    if (rendering.mode === 'ssr' && content.includes('window.')) {
      issues.push({
        type: 'window_access_in_ssr',
        file: page,
        severity: 'high',
        message: 'window access during SSR can cause hydration errors'
      });
    }
    
    if (rendering.mode === 'ssg' && content.includes('useAsyncData')) {
      issues.push({
        type: 'dynamic_data_in_ssg',
        file: page,
        severity: 'medium',
        message: 'useAsyncData in SSG page - data is static'
      });
    }
  }
  
  return {
    routes,
    hybrid_routes: analyzeHybridRoutes(config),
    prerender_config: analyzePrerenderConfig(config),
    issues
  };
}

function detectPageRendering(
  content: string,
  config: NuxtConfig
): { mode: RenderingMode; hasStreaming: boolean; hasSuspense: boolean } {
  // Check for SPA directive
  if (content.includes('definePageMeta({ ssr: false })')) {
    return { mode: 'spa', hasStreaming: false, hasSuspense: false };
  }
  
  // Check for streaming
  const hasStreaming = content.includes('<Suspense>') || 
                      content.includes('useLazyAsyncData');
  
  // Check for client-only
  const isClientOnly = content.includes('<ClientOnly>');
  
  return {
    mode: isClientOnly ? 'csr' : 'ssr',
    hasStreaming,
    hasSuspense: hasStreaming
  };
}
```

### Bước 3: Data Fetching Analysis

```typescript
// Analyze Nuxt data fetching patterns
interface DataFetchingAnalysis {
  patterns: DataPattern[];
  issues: DataIssue[];
  recommendations: DataRecommendation[];
}

async function analyzeDataFetching(
  rootPath: string
): Promise<DataFetchingAnalysis> {
  const pages = await glob('**/*.vue', { cwd: `${rootPath}/pages` });
  const composables = await glob('**/*.ts', { cwd: `${rootPath}/composables` });
  const patterns: DataPattern[] = [];
  const issues: DataIssue[] = [];
  
  // Analyze pages
  for (const page of pages) {
    const content = await readFile(page);
    const pattern = analyzePageDataFetching(page, content);
    patterns.push(...pattern);
    
    // Check for issues
    if (content.includes('$fetch') && !content.includes('useFetch')) {
      issues.push({
        type: 'direct_fetch',
        file: page,
        severity: 'medium',
        message: 'Consider using useFetch or useAsyncData for automatic caching'
      });
    }
    
    if (content.includes('useFetch') && content.includes('key:') === false) {
      issues.push({
        type: 'missing_cache_key',
        file: page,
        severity: 'low',
        message: 'useFetch without explicit key - consider adding for better caching'
      });
    }
  }
  
  // Analyze composables
  for (const composable of composables) {
    const content = await readFile(composable);
    
    if (content.includes('$fetch(') && !content.includes('useRequestHeaders')) {
      issues.push({
        type: 'server_only_fetch',
        file: composable,
        severity: 'low',
        message: 'Consider using useFetch for client-side data'
      });
    }
  }
  
  return {
    patterns,
    issues,
    recommendations: generateDataRecommendations(issues)
  };
}

function analyzePageDataFetching(
  page: string,
  content: string
): DataPattern[] {
  const patterns: DataPattern[] = [];
  
  // useFetch usage
  const useFetchMatches = content.match(/useFetch\([^)]*\)/g) || [];
  for (const match of useFetchMatches) {
    patterns.push({
      type: 'useFetch',
      code: match,
      hasCaching: match.includes('getCachedData') || match.includes('lazy'),
      hasSSR: !match.includes('lazy: true')
    });
  }
  
  // useAsyncData usage
  const useAsyncDataMatches = content.match(/useAsyncData\([^)]*\)/g) || [];
  for (const match of useAsyncDataMatches) {
    patterns.push({
      type: 'useAsyncData',
      code: match,
      hasCaching: match.includes('getCachedData'),
      hasSSR: true
    });
  }
  
  // $fetch usage
  const $fetchMatches = content.match(/\$fetch\([^)]*\)/g) || [];
  for (const match of $fetchMatches) {
    patterns.push({
      type: '$fetch',
      code: match,
      hasCaching: false,
      hasSSR: false
    });
  }
  
  return patterns;
}
```

### Bước 4: Auto-import Analysis

```typescript
// Analyze auto-imports
interface AutoImportAnalysis {
  auto_imported: AutoImportItem[];
  manually_imported: ManualImportItem[];
  unused_imports: UnusedImport[];
  issues: ImportIssue[];
}

async function analyzeAutoImports(
  rootPath: string
): Promise<AutoImportAnalysis> {
  const components = await glob('**/*.vue', { cwd: rootPath });
  const autoImported = new Set<string>();
  const manuallyImported: ManualImportItem[] = [];
  const usedInComponents = new Set<string>();
  const issues: ImportIssue[] = [];
  
  // Collect Nuxt auto-imports
  const nuxtImports = [
    'ref', 'reactive', 'computed', 'watch', 'watchEffect',
    'useState', 'useNuxtApp', 'useRoute', 'useRouter',
    'useFetch', 'useAsyncData', '$fetch'
  ];
  
  for (const component of components) {
    const content = await readFile(component);
    
    // Check which Nuxt composables are actually used
    for (const imp of nuxtImports) {
      if (content.includes(imp + '(') || content.includes(imp + '<')) {
        usedInComponents.add(imp);
      }
    }
    
    // Check for manual imports of auto-importable items
    const importMatches = content.match(/import\s+{([^}]+)}\s+from\s+'vue'/g) || [];
    for (const match of importMatches) {
      const imports = match.match(/import\s+{([^}]+)}/)?.[1];
      if (imports) {
        const items = imports.split(',').map(i => i.trim());
        for (const item of items) {
          if (nuxtImports.includes(item)) {
            manuallyImported.push({
              item,
              file: component,
              suggestion: `${item} is auto-imported by Nuxt`
            });
          }
        }
      }
    }
  }
  
  // Check for unused imports
  for (const item of manuallyImported) {
    issues.push({
      type: 'unnecessary_import',
      file: item.file,
      item: item.item,
      suggestion: item.suggestion
    });
  }
  
  return {
    auto_imported: nuxtImports.map(i => ({ name: i, used: usedInComponents.has(i) })),
    manually_imported: manuallyImported,
    unused_imports: [],
    issues
  };
}
```

### Bước 5: Server Routes Analysis

```typescript
// Analyze server routes
interface ServerRoutesAnalysis {
  routes: ServerRouteInfo[];
  middleware: ServerMiddlewareInfo[];
  issues: ServerIssue[];
}

async function analyzeServerRoutes(
  rootPath: string
): Promise<ServerRoutesAnalysis> {
  const serverPath = `${rootPath}/server`;
  if (!await checkDirectoryExists(serverPath)) {
    return { routes: [], middleware: [], issues: [] };
  }
  
  const apiFiles = await glob('**/*.ts', { cwd: serverPath });
  const routes: ServerRouteInfo[] = [];
  const middleware: ServerMiddlewareInfo[] = [];
  const issues: ServerIssue[] = [];
  
  for (const file of apiFiles) {
    const content = await readFile(file);
    const info = parseServerRoute(file, content);
    
    routes.push(info);
    
    // Check for issues
    if (info.method === 'ALL' && !info.hasValidation) {
      issues.push({
        type: 'missing_validation',
        file,
        severity: 'medium',
        message: 'Route should validate request body/query'
      });
    }
    
    if (info.hasDatabase && !info.hasTransactions) {
      issues.push({
        type: 'no_transaction',
        file,
        severity: 'low',
        message: 'Database operations should use transactions'
      });
    }
  }
  
  // Analyze middleware
  const middlewareFiles = await glob('**/*.ts', { cwd: `${serverPath}/middleware` });
  for (const file of middlewareFiles) {
    middleware.push({
      file,
      name: extractMiddlewareName(file)
    });
  }
  
  return { routes, middleware, issues };
}

function parseServerRoute(
  file: string,
  content: string
): ServerRouteInfo {
  const method = detectHTTPMethod(content);
  const hasValidation = content.includes('zod') || 
                       content.includes('valibot') ||
                       content.includes('validate');
  const hasDatabase = content.includes('prisma') || 
                     content.includes('drizzle') ||
                     content.includes('db.');
  const hasTransactions = content.includes('$transaction') ||
                          content.includes('beginTransaction');
  
  return {
    file,
    path: fileToRoute(file),
    method,
    hasValidation,
    hasDatabase,
    hasTransactions,
    handlers: content.includes('defineEventHandler')
  };
}
```

### Bước 6: Module Review

```typescript
// Review Nuxt modules
interface ModuleReview {
  modules: ModuleInfo[];
  deprecated: ModuleInfo[];
  security_concerns: SecurityConcern[];
  recommendations: ModuleRecommendation[];
}

async function reviewModules(
  config: NuxtConfig,
  pkg: PackageJson
): Promise<ModuleReview> {
  const modules = config.modules || [];
  const deprecated: ModuleInfo[] = [];
  const securityConcerns: SecurityConcern[] = [];
  
  for (const module of modules) {
    const moduleInfo = {
      name: module,
      version: pkg.devDependencies?.[module] || 'unknown'
    };
    
    // Check for deprecated modules
    if (isDeprecated(module)) {
      deprecated.push(moduleInfo);
    }
    
    // Check for security concerns
    if (hasSecurityConcern(module)) {
      securityConcerns.push({
        module,
        concern: getSecurityConcern(module)
      });
    }
  }
  
  return {
    modules: modules.map(m => ({ name: m, version: 'unknown' })),
    deprecated,
    security_concerns: securityConcerns,
    recommendations: generateModuleRecommendations(modules, deprecated)
  };
}
```

## Checklist (Danh sách kiểm tra)

- [ ] Using Nuxt 3 (not Nuxt 2)
- [ ] Proper rendering mode for each route
- [ ] useFetch/useAsyncData for data fetching
- [ ] Proper caching strategies
- [ ] TypeScript enabled with strict mode
- [ ] Essential modules installed (image, fonts)
- [ ] Server routes for API
- [ ] Middleware for auth
- [ ] Error handling (error.vue)
- [ ] Layouts properly structured
- [ ] SEO metadata configured
- [ ] No unused dependencies
- [ ] Environment variables properly handled
- [ ] nitro preset configured
- [ ] Prerender routes optimized

## Examples (Ví dụ)

### Ví dụ 1: Correct Data Fetching

```vue
<!-- ❌ BEFORE: Wrong data fetching -->
<template>
  <div>{{ data }}</div>
</template>

<script setup>
const { data } = await useFetch('/api/users') // No caching!
</script>

<!-- ✅ AFTER: Proper data fetching -->
<template>
  <div>{{ data }}</div>
</template>

<script setup lang="ts">
// SSR by default, cached
const { data, pending, error } = await useFetch('/api/users', {
  key: 'users', // Explicit cache key
  transform: (data) => data.map(u => ({ ...u, fullName: `${u.first} ${u.last}` })),
  watch: [filters], // Reactive re-fetching
  default: () => [] // Default value
})
</script>
```

### Ví dụ 2: Route Rules for Hybrid Rendering

```typescript
// nuxt.config.ts
export default defineNuxtConfig({
  routeRules: {
    // Static pages - prerendered at build
    '/': { prerender: true },
    '/about': { prerender: true },
    '/pricing': { prerender: true },
    
    // Blog posts - ISR (revalidate every hour)
    '/blog/**': { swr: 3600 },
    
    // Dashboard - SSR (always fresh, but cached)
    '/dashboard/**': { ssr: true },
    
    // Admin - SPA mode (client-side only)
    '/admin/**': { ssr: false },
    
    // API - no caching
    '/api/**': { cache: false }
  }
})
```

## Anti Patterns (Các pattern cần tránh)

### 1. Using $fetch instead of useFetch
```vue
<!-- ❌ BAD: No caching, no SSR -->
<script setup>
const data = ref()
onMounted(async () => {
  data.value = await $fetch('/api/users')
})
</script>

<!-- ✅ GOOD: Proper data fetching -->
<script setup>
const { data } = await useFetch('/api/users')
</script>
```

### 2. Manual Vue Imports
```vue
<!-- ❌ BAD: Manual import -->
<script setup>
import { ref, computed } from 'vue'
const count = ref(0)
</script>

<!-- ✅ GOOD: Auto-imported -->
<script setup>
const count = ref(0) // Auto-imported by Nuxt
</script>
```

### 3. SSR accessing window
```vue
<!-- ❌ BAD: Window during SSR -->
<script setup>
const isClient = window !== undefined
</script>

<!-- ✅ GOOD: Safe check -->
<script setup>
const { process } = useNuxtApp()
const isClient = process.client
</script>
```

### 4. Not using route rules
```typescript
// ❌ BAD: Everything SSR
export default defineNuxtConfig({
  ssr: true
})

// ✅ GOOD: Hybrid rendering
export default defineNuxtConfig({
  routeRules: {
    '/': { prerender: true },
    '/api/**': { cache: false }
  }
})
```

### 5. Not defining page meta
```vue
<!-- ❌ BAD: No page meta -->
<template>
  <div>Page</div>
</template>

<!-- ✅ GOOD: Full metadata -->
<template>
  <div>Page</div>
</template>

<script setup>
definePageMeta({
  title: 'Page Title',
  description: 'Page description',
  middleware: ['auth']
})
</script>
```

## Best Practices (Thực hành tốt nhất)

1. **Use useFetch**: Built-in caching và SSR support
2. **Define cache keys**: Explicit keys for better caching control
3. **Use route rules**: Hybrid rendering for optimal performance
4. **Type everything**: Full TypeScript for better DX
5. **Use server routes**: Type-safe API endpoints
6. **Configure route rules**: Prerender static pages
7. **Use useState**: Built-in SSR-safe state management
8. **Define page meta**: SEO và middleware
9. **Optimize images**: @nuxt/image module
10. **Use auto-imports**: Don't import what's auto-imported

