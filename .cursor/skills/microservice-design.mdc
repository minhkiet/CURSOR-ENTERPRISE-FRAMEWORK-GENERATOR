## Workflow (Quy trình)

### Bước 1: Service Decomposition

```typescript
// Decompose system into services
interface Service {
  name: string;
  responsibilities: string[];
  capabilities: Capability[];
  api: APISpecification;
  database: DatabaseOwnership;
  team: Team;
  dependencies: Dependency[];
  external_dependencies: ExternalDependency[];
}

interface Dependency {
  service: string;
  type: 'sync' | 'async';
  protocol: string;
  data_exchanged: string[];
}

function decomposeSystem(
  domainModel: DomainModel,
  teamStructure: TeamStructure
): Service[] {
  const services: Service[] = [];
  
  // 1. Identify bounded contexts from DDD
  const boundedContexts = domainModel.boundedContexts;
  
  // 2. Map to team ownership
  for (const context of boundedContexts) {
    const team = findTeamForContext(context, teamStructure);
    
    // 3. Create service definition
    const service: Service = {
      name: context.name.toLowerCase().replace(/\s+/g, '-'),
      responsibilities: context.responsibilities,
      capabilities: extractCapabilities(context),
      api: designAPISpecification(context),
      database: {
        type: 'dedicated',
        schema: context.name,
        shared: false
      },
      team: team,
      dependencies: identifyDependencies(context, boundedContexts),
      external_dependencies: context.externalDependencies
    };
    
    services.push(service);
  }
  
  // 4. Verify decomposition
  validateDecomposition(services);
  
  return services;
}

function validateDecomposition(services: Service[]): ValidationResult {
  const issues: ValidationIssue[] = [];
  
  // Check for services that are too small
  for (const service of services) {
    if (service.responsibilities.length < 3) {
      issues.push({
        type: 'service_too_small',
        service: service.name,
        severity: 'warning',
        message: 'Service has few responsibilities - consider merging'
      });
    }
  }
  
  // Check for circular dependencies
  const graph = buildDependencyGraph(services);
  const cycles = detectCycles(graph);
  if (cycles.length > 0) {
    issues.push({
      type: 'circular_dependency',
      cycles,
      severity: 'error',
      message: 'Circular dependencies detected - redesign needed'
    });
  }
  
  // Check for data coupling
  for (const service of services) {
    const sharedData = countSharedDataTypes(service, services);
    if (sharedData > 5) {
      issues.push({
        type: 'high_data_coupling',
        service: service.name,
        sharedTypes: sharedData,
        severity: 'warning',
        message: 'Service shares many data types - consider restructuring'
      });
    }
  }
  
  return { valid: issues.filter(i => i.severity === 'error').length === 0, issues };
}
```

### Bước 2: API Design

```typescript
// Design service APIs
interface APISpecification {
  name: string;
  version: string;
  base_path: string;
  endpoints: Endpoint[];
  authentication: AuthSpec;
  schemas: Schema[];
}

interface Endpoint {
  path: string;
  method: HTTPMethod;
  request: RequestSpec;
  response: ResponseSpec;
  errors: ErrorSpec[];
  rate_limiting: RateLimitSpec;
}

function designAPISpecification(context: BoundedContext): APISpecification {
  return {
    name: `${context.name} API`,
    version: 'v1',
    base_path: `/api/v1/${context.name.toLowerCase().replace(/\s+/g, '-')}`,
    endpoints: [
      ...designCRUDEndpoints(context.entities),
      ...designBusinessOperationEndpoints(context.capabilities)
    ],
    authentication: {
      type: 'oauth2',
      flows: ['client_credentials', 'authorization_code']
    },
    schemas: generateSchemas(context.entities)
  };
}

function designCRUDEndpoints(entities: Entity[]): Endpoint[] {
  const endpoints: Endpoint[] = [];
  
  for (const entity of entities) {
    const resourcePath = `/${entity.name.toLowerCase()}`;
    
    endpoints.push(
      // Create
      {
        path: resourcePath,
        method: 'POST',
        request: {
          body: entity.name + 'CreateRequest',
          headers: ['Authorization: Bearer token']
        },
        response: {
          status: 201,
          body: entity.name + 'Response'
        },
        errors: [
          { status: 400, code: 'VALIDATION_ERROR' },
          { status: 401, code: 'UNAUTHORIZED' }
        ],
        rate_limiting: { requests_per_minute: 100 }
      },
      // List
      {
        path: resourcePath,
        method: 'GET',
        request: {
          query: ['page', 'limit', 'sort', 'filter']
        },
        response: {
          status: 200,
          body: {
            type: 'array',
            item_type: entity.name + 'Response'
          }
        },
        errors: [
          { status: 400, code: 'INVALID_PARAMETERS' }
        ],
        rate_limiting: { requests_per_minute: 300 }
      },
      // Get
      {
        path: `${resourcePath}/{id}`,
        method: 'GET',
        request: {
          path: ['id']
        },
        response: {
          status: 200,
          body: entity.name + 'Response'
        },
        errors: [
          { status: 404, code: 'NOT_FOUND' }
        ],
        rate_limiting: { requests_per_minute: 500 }
      },
      // Update
      {
        path: `${resourcePath}/{id}`,
        method: 'PUT',
        request: {
          path: ['id'],
          body: entity.name + 'UpdateRequest'
        },
        response: {
          status: 200,
          body: entity.name + 'Response'
        },
        errors: [
          { status: 400, code: 'VALIDATION_ERROR' },
          { status: 404, code: 'NOT_FOUND' }
        ],
        rate_limiting: { requests_per_minute: 100 }
      },
      // Delete
      {
        path: `${resourcePath}/{id}`,
        method: 'DELETE',
        request: {
          path: ['id']
        },
        response: {
          status: 204,
          body: null
        },
        errors: [
          { status: 404, code: 'NOT_FOUND' }
        ],
        rate_limiting: { requests_per_minute: 50 }
      }
    );
  }
  
  return endpoints;
}
```

### Bước 3: Communication Patterns

```typescript
// Design inter-service communication
interface CommunicationPattern {
  from_service: string;
  to_service: string;
  pattern: 'request_response' | 'publish_subscribe' | 'event_driven';
  protocol: string;
  contract: Contract;
  reliability: ReliabilityLevel;
  ordering: OrderingGuarantee;
}

function designCommunicationPatterns(
  services: Service[]
): CommunicationPattern[] {
  const patterns: CommunicationPattern[] = [];
  
  for (const service of services) {
    for (const dep of service.dependencies) {
      // Determine best pattern based on use case
      const pattern = determinePattern(service, dep);
      patterns.push(pattern);
    }
  }
  
  return patterns;
}

function determinePattern(
  service: Service,
  dep: Dependency
): CommunicationPattern {
  // Synchronous for real-time queries
  if (dep.type === 'query') {
    return {
      from_service: service.name,
      to_service: dep.service,
      pattern: 'request_response',
      protocol: 'REST' | 'gRPC',
      contract: defineSyncContract(dep),
      reliability: 'at_least_once',
      ordering: 'none'
    };
  }
  
  // Asynchronous for commands and events
  if (dep.type === 'command' || dep.type === 'event') {
    return {
      from_service: service.name,
      to_service: dep.service,
      pattern: 'publish_subscribe',
      protocol: 'Kafka' | 'RabbitMQ',
      contract: defineAsyncContract(dep),
      reliability: 'at_least_once',
      ordering: 'per_partition'
    };
  }
  
  // Event-driven for complex workflows
  if (dep.type === 'workflow') {
    return {
      from_service: service.name,
      to_service: dep.service,
      pattern: 'event_driven',
      protocol: 'Event Grid' | 'CloudEvents',
      contract: defineEventContract(dep),
      reliability: 'exactly_once',
      ordering: 'causal'
    };
  }
}

function defineSyncContract(dep: Dependency): Contract {
  return {
    type: 'openapi',
    version: '1.0',
    endpoints: dep.endpoints,
    schemas: dep.schemas
  };
}

function defineAsyncContract(dep: Dependency): Contract {
  return {
    type: 'asyncapi',
    version: '2.0',
    channels: {
      [dep.channel]: {
        publish: {
          message: {
            payload: dep.eventPayload,
            schemas: dep.schemas
          }
        }
      }
    }
  };
}
```

### Bước 4: Data Ownership

```typescript
// Define data ownership per service
interface DatabaseOwnership {
  type: 'dedicated' | 'shared';
  schema?: string;
  tables?: string[];
  shared_with?: string[];
  replication?: ReplicationConfig;
}

interface DataOwnershipMap {
  services: ServiceDataOwnership[];
  shared_data: SharedData[];
  data_migration_plan: MigrationPlan[];
}

function designDataOwnership(
  services: Service[]
): DataOwnershipMap {
  const ownership: ServiceDataOwnership[] = [];
  const sharedData: SharedData[] = [];
  
  for (const service of services) {
    ownership.push({
      service: service.name,
      database: service.database,
      entities: service.entities,
      data_access_patterns: analyzeAccessPatterns(service)
    });
  }
  
  // Identify shared data that must be duplicated
  for (const data of findSharedDataTypes(services)) {
    sharedData.push({
      data_type: data.name,
      owners: data.primaryOwner,
      consumers: data.consumers,
      replication_strategy: determineReplicationStrategy(data),
      sync_mechanism: determineSyncMechanism(data)
    });
  }
  
  return {
    services: ownership,
    shared_data: sharedData,
    data_migration_plan: generateMigrationPlan(ownership)
  };
}

function determineReplicationStrategy(
  data: SharedDataType
): ReplicationStrategy {
  // Read replicas for query data
  if (data.accessPattern === 'mostly_read') {
    return {
      type: 'async_replication',
      lag_tolerance_ms: 1000,
      conflict_resolution: 'last_write_wins'
    };
  }
  
  // Event sourcing for critical data
  if (data.criticality === 'high') {
    return {
      type: 'event_sourcing',
      event_store: 'dedicated',
      conflict_resolution: 'domain_logic'
    };
  }
  
  // CQRS for complex data
  return {
    type: 'cqrs',
    read_model: 'optimized_queries',
    write_model: 'canonical_source'
  };
}
```

### Bước 5: Service Mesh Design

```typescript
// Design service mesh configuration
interface ServiceMeshConfig {
  provider: 'istio' | 'linkerd' | 'consul';
  mTLS_enabled: boolean;
  traffic_management: TrafficConfig;
  observability: ObservabilityConfig;
  security: SecurityConfig;
}

function designServiceMesh(
  services: Service[]
): ServiceMeshConfig {
  return {
    provider: 'istio',
    mTLS_enabled: true,
    traffic_management: {
      retries: {
        enabled: true,
        attempts: 3,
        perTryTimeout: '5s'
      },
      circuit_breaker: {
        enabled: true,
        maxConnections: 100,
        maxPendingRequests: 50
      },
      timeout: {
        default: '10s',
        overrides: {
          health_check: '1s',
          long_running: '60s'
        }
      }
    },
    observability: {
      tracing: {
        enabled: true,
        sampling_rate: 0.1
      },
      metrics: {
        enabled: true,
        prometheus_metrics: true
      },
      logging: {
        enabled: true,
        level: 'info'
      }
    },
    security: {
      mTLS: {
        mode: 'STRICT',
        trust_domain: 'cluster.local'
      },
      authorization: {
        mode: 'ALLOW',
        policies: generateAuthPolicies(services)
      }
    }
  };
}

function generateAuthPolicies(services: Service[]): AuthPolicy[] {
  return services.map(service => ({
    name: `${service.name}-auth-policy`,
    selector: `app: ${service.name}`,
    rules: [
      {
        from: { source: { principals: services.map(s => `cluster.local/ns/default/sa/${s.name}`) } },
        to: { operation: { methods: ['GET', 'POST', 'PUT', 'DELETE'] } }
      }
    ]
  }));
}
```

## Checklist (Danh sách kiểm tra)

- [ ] Services aligned with bounded contexts
- [ ] Team ownership clearly defined
- [ ] No circular dependencies
- [ ] APIs well-designed with proper contracts
- [ ] Communication patterns appropriate for use cases
- [ ] Database per service (or clear ownership)
- [ ] Data duplication minimized
- [ ] Service mesh configured
- [ ] Observability built-in
- [ ] Security policies defined
- [ ] Deployment strategy planned
- [ ] Contract testing in place
- [ ] Versioning strategy defined
- [ ] Error handling standardized
- [ ] Resilience patterns implemented

