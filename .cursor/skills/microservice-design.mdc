## Workflow (Quy trình)

### Phase 1: Service Decomposition

### Bước 1: Decomposition Strategies

```typescript
// Decomposition by Business Capability
interface ServiceDefinition {
  name: string;
  capabilities: string[];
  boundedContext: string;
  apiContracts: APIContract[];
  dataOwned: string[];
  scalingProfile: ScalingProfile;
}

const MICROSERVICES: ServiceDefinition[] = [
  {
    name: 'user-service',
    capabilities: [
      'User registration',
      'Authentication',
      'Profile management',
      'Password reset'
    ],
    boundedContext: 'Customer',
    apiContracts: [
      { endpoint: '/users', methods: ['POST', 'GET'] },
      { endpoint: '/users/{id}', methods: ['GET', 'PATCH', 'DELETE'] },
      { endpoint: '/auth/login', methods: ['POST'] }
    ],
    dataOwned: ['users', 'sessions', 'refresh_tokens'],
    scalingProfile: { minInstances: 3, maxInstances: 10 }
  },
  {
    name: 'order-service',
    capabilities: [
      'Order creation',
      'Order management',
      'Order status tracking',
      'Order history'
    ],
    boundedContext: 'Sales',
    apiContracts: [
      { endpoint: '/orders', methods: ['POST', 'GET'] },
      { endpoint: '/orders/{id}', methods: ['GET', 'PATCH', 'DELETE'] }
    ],
    dataOwned: ['orders', 'order_items'],
    scalingProfile: { minInstances: 3, maxInstances: 20 }
  },
  {
    name: 'catalog-service',
    capabilities: [
      'Product management',
      'Category management',
      'Search and filtering',
      'Inventory tracking'
    ],
    boundedContext: 'Catalog',
    apiContracts: [
      { endpoint: '/products', methods: ['POST', 'GET'] },
      { endpoint: '/products/{id}', methods: ['GET', 'PUT', 'DELETE'] },
      { endpoint: '/search', methods: ['GET'] }
    ],
    dataOwned: ['products', 'categories', 'inventory'],
    scalingProfile: { minInstances: 2, maxInstances: 15 }
  }
];
```

### Bước 2: Data Management Strategies

```typescript
// Database per Service
interface DataStrategy {
  service: string;
  databaseType: 'postgres' | 'mongodb' | 'redis' | 'elasticsearch';
  schema: 'schema-per-service' | 'database-per-service';
  connections: ConnectionPool;
}

// Choreography vs Orchestration
enum IntegrationPattern {
  CHOREOGRAPHY = 'choreography',  // Events
  ORCHESTRATION = 'orchestration' // Commands
}

// Saga Pattern for distributed transactions
class OrderSaga {
  constructor(
    private eventBus: EventBus,
    private orderService: OrderServiceClient,
    private inventoryService: InventoryServiceClient,
    private paymentService: PaymentServiceClient
  ) {}
  
  async execute(orderId: string): Promise<void> {
    try {
      // Step 1: Reserve inventory
      await this.inventoryService.reserve(orderId, items);
      
      // Step 2: Process payment
      await this.paymentService.charge(orderId, amount);
      
      // Step 3: Confirm order
      await this.orderService.confirm(orderId);
      
    } catch (error) {
      // Compensating transactions
      await this.paymentService.refund(orderId);
      await this.inventoryService.release(orderId);
      await this.orderService.cancel(orderId);
    }
  }
}
```

### Phase 2: Service Communication

### Bước 3: API Design

```typescript
// API Contract Definition
interface APIService {
  name: string;
  version: string;
  basePath: string;
  endpoints: Endpoint[];
  schemas: Schema[];
}

interface Endpoint {
  path: string;
  method: 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE';
  request: Schema;
  response: Schema;
  errors: ErrorSchema[];
  auth: AuthRequirement;
}

// OpenAPI Specification
const ORDER_SERVICE_API: APIService = {
  name: 'order-service',
  version: '1.0.0',
  basePath: '/api/v1',
  endpoints: [
    {
      path: '/orders',
      method: 'POST',
      request: {
        type: 'object',
        required: ['customerId', 'items', 'shippingAddress'],
        properties: {
          customerId: { type: 'string', format: 'uuid' },
          items: {
            type: 'array',
            items: {
              type: 'object',
              properties: {
                productId: { type: 'string' },
                quantity: { type: 'integer', minimum: 1 }
              }
            }
          },
          shippingAddress: { $ref: '#/components/schemas/Address' }
        }
      },
      response: {
        201: { description: 'Order created', schema: { $ref: '#/components/schemas/Order' } },
        400: { description: 'Validation error' },
        401: { description: 'Unauthorized' }
      },
      errors: [
        { code: 'INVALID_ITEMS', message: 'Some items are invalid' },
        { code: 'INSUFFICIENT_INVENTORY', message: 'Not enough inventory' }
      ],
      auth: { type: 'bearer' }
    }
  ]
};
```

### Bước 4: Service Mesh

```yaml
# Kubernetes Service Mesh Configuration (Istio)
apiVersion: networking.istio.io/v1beta1
kind: VirtualService
metadata:
  name: order-service
spec:
  hosts:
    - order-service
  http:
    - match:
        - headers:
            x-service-version:
              exact: v2
      route:
        - destination:
            host: order-service
            subset: v2
          weight: 100
    - route:
        - destination:
            host: order-service
            subset: v1
          weight: 100

---
apiVersion: networking.istio.io/v1beta1
kind: DestinationRule
metadata:
  name: order-service
spec:
  host: order-service
  trafficPolicy:
    connectionPool:
      tcp:
        maxConnections: 100
      http:
        h2UpgradePolicy: UPGRADE
        http1MaxPendingRequests: 100
        http2MaxRequests: 1000
    loadBalancer:
      simple: LEAST_CONN
    circuitBreaker:
      consecutiveGatewayErrors: 5
      interval: 30s
      baseEjectionTime: 60s
  subsets:
    - name: v1
      labels:
        version: v1
    - name: v2
      labels:
        version: v2
```

