    "letterSpacing": {
      "tight": "-0.02em",
      "tighter": "-0.035em",
      "tightest": "-0.045em",
      "wide": "0.04em",
      "wider": "0.08em"
    },
    "lineHeight": {
      "tight": 1.1,
      "snug": 1.25,
      "normal": 1.5,
      "relaxed": 1.625,
      "loose": 1.875
    }
  },
  "spacing": [4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128],
  "radius": {
    "none": 0,
    "xs": 4,
    "sm": 6,
    "md": 8,
    "lg": 12,
    "xl": 16,
    "2xl": 20,
    "3xl": 24,
    "pill": 9999,
    "full": "50%"
  },
  "shadow": {
    "xs": "0 1px 2px 0 rgba(10, 22, 40, 0.04)",
    "sm": "0 2px 4px 0 rgba(10, 22, 40, 0.06), 0 1px 2px 0 rgba(10, 22, 40, 0.04)",
    "md": "0 4px 12px 0 rgba(10, 22, 40, 0.08), 0 2px 4px 0 rgba(10, 22, 40, 0.04)",
    "lg": "0 8px 24px 0 rgba(10, 22, 40, 0.10), 0 4px 8px 0 rgba(10, 22, 40, 0.06)",
    "xl": "0 16px 48px 0 rgba(10, 22, 40, 0.12), 0 8px 16px 0 rgba(10, 22, 40, 0.08)",
    "2xl": "0 24px 64px 0 rgba(10, 22, 40, 0.16)",
    "brand": "0 8px 24px 0 rgba(13, 148, 136, 0.20)",
    "accent": "0 8px 24px 0 rgba(234, 88, 12, 0.20)",
    "inner": "inset 0 1px 2px 0 rgba(10, 22, 40, 0.06)"
  },
  "motion": {
    "duration": {
      "instant": "80ms",
      "fast": "150ms",
      "normal": "240ms",
      "slow": "400ms",
      "slower": "600ms"
    },
    "easing": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "inOut": "cubic-bezier(0.4, 0, 0.2, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "z": {
    "hide": -1,
    "base": 0,
    "raised": 10,
    "dropdown": 20,
    "sticky": 30,
    "overlay": 40,
    "modal": 50,
    "popover": 60,
    "toast": 70,
    "max": 9999
  },
  "icons": {
    "library": "phosphor-react",
    "altLibrary": "lucide-react",
    "defaultWeight": "regular",
    "actionWeight": "bold",
    "size": {
      "xs": 12,
      "sm": 16,
      "md": 20,
      "lg": 24,
      "xl": 32
    }
  },
  "assets": {
    "image": {
      "provider": "unsplash",
      "fallback": "picsum",
      "video": {
        "provider": "coverr",
        "cdn": "https://cdn.coverr.co/videos/coverr-{slug}/1080p.mp4"
      }
    },
    "logo": {
      "provider": "simpleicons",
      "cdn": "https://cdn.simpleicons.org/{slug}/{color}"
    }
  }
}