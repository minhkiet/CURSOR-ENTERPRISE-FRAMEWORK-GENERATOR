  "radius": {
    "none": "0",
    "md": "6px",
    "xs": "12px",
    "lg": "20px",
    "sm": "9999px"
  },
  "shadow": {
    "1": "rgba(0, 0, 0, 0.28) 0px 10px 30px 0px",
