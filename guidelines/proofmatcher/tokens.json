    "easing": {
      "default": "cubic-bezier(0.22, 1, 0.36, 1)",
      "out": "cubic-bezier(0.22, 1, 0.36, 1)",
      "in": "cubic-bezier(0.65, 0, 0.35, 1)",
      "in-out": "cubic-bezier(0.65, 0, 0.35, 1)"
    }
