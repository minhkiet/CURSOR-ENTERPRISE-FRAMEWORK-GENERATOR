{
  "brand": {
    "name": "Inkwell",
    "tagline": "Long-form journalism for the curious reader.",
    "locale": "en-US, vi-VN"
  },
  "meta": {
    "version": "2026.1",
    "redesign": "market-pro-editorial"
  },
  "color": {
    "text": {
      "primary": "#0e0e0c",
      "secondary": "#3d3d39",
      "tertiary": "#73736e",
      "muted": "#a3a39c",
      "inverse": "#fafaf7",
      "accent": "#c87f2e",
      "link": "#0e0e0c",
      "linkHover": "#c87f2e"
    },
    "surface": {
      "paper": "#fafaf7",
      "paperAlt": "#f5f5f0",
      "card": "#ffffff",
      "dark": "#0e0e0c",
      "footer": "#0e0e0c",
      "raised": "#ffffff"
    },
    "border": {
      "subtle": "#f0f0eb",
      "default": "#e5e5e0",
      "strong": "#d4d4cf",
      "accent": "#c87f2e"
    }
  },
  "typography": {
    "family": {
      "display": "Newsreader, Lora, Georgia, serif",
      "body": "Newsreader, Lora, Georgia, serif",
      "mono": "JetBrains Mono, ui-monospace, monospace"
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "size": {
      "eyebrow": "11px",
      "sm": "14px",
      "md": "16.5px",
      "lg": "19px",
      "base": "19px",
      "xl": "22px",
      "h6": "28.5px",
      "h5": "32px",
      "h4": "42.5px",
      "h3": "56.5px",
      "h2": "76.5px",
      "h1": "96.5px",
      "hero": "120px"
    }
  },
  "spacing": [4, 8, 12, 16, 24, 32, 48, 64, 88, 120, 160],
  "radius": {
    "none": 0,
    "pill": 9999,
    "full": "50%"
  },
  "shadow": {
    "paper": "0 1px 0 rgba(14, 14, 12, 0.04)",
    "card": "0 2px 8px rgba(14, 14, 12, 0.06)",
    "lift": "0 8px 24px rgba(14, 14, 12, 0.10)"
  },
  "motion": {
    "duration": { "fast": "200ms", "normal": "320ms" },
    "easing": { "out": "cubic-bezier(0.16, 1, 0.3, 1)" }
  },
  "breakpoint": { "sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px" },
  "icons": { "library": "phosphor-react", "defaultWeight": "regular", "actionWeight": "bold" }
}