{
  "schemaVersion": "1.0.0",
  "framework": {
    "id": "vibe-code-framework",
    "version": "1.0.0",
    "language": "vi",
    "identifierLanguage": "en"
  },
  "canonicalSource": {
    "root": "vibe-code-framework",
    "manifest": "00-governance/resource-manifest.json",
    "sourceType": "SOT-CANONICAL",
    "owner": "LEAD",
    "maintainer": "DEV"
  },
  "executionInputContract": {
    "requiredInputs": [
      "SourcePath",
      "TargetPath",
      "Tool",
      "Category"
    ],
    "sourcePath": {
      "description": "Absolute or working-directory-relative path to the Resource Hub root.",
      "mustContain": [
        "00-governance/resource-manifest.json",
        "01-core-rules",
        "03-skills",
        "04-agents",
        "05-workflows",
        "06-templates",
        "07-adapters",
        "08-scripts"
      ],
      "mustNotBe": [
        "08-scripts",
        ".cursor",
        ".git"
      ]
    },
    "targetPath": {
      "description": "Project directory receiving a tool-specific adapter.",
      "mustBeDirectoryOrCreatable": true,
      "mustNotBe": [
        "SourcePath",
        "SourcePath/.git"
      ]
    },
    "tool": {
      "allowed": [
        "Cursor",
        "ClaudeCode",
        "Codex",
        "Copilot",
        "Windsurf",
        "Antigravity",
        "All"
      ]
    },
    "category": {
      "allowed": [
        "rules",
        "skills",
        "agents",
        "workflows",
        "all"
      ]
    },
    "safety": {
      "defaultDirection": "SOT-CANONICAL to adapter/consumer",
      "overwriteRequiresExplicitTarget": true,
      "deletionAllowed": false,
      "rollback": "Restore the target from the caller-owned backup or version control; the canonical source is never deleted by sync."
    }
  },
  "canonicalLocations": {
    "coreRules": "01-core-rules",
    "stackGuides": "02-stacks",
    "skills": "03-skills",
    "agents": "04-agents",
    "workflows": "05-workflows",
    "templates": "06-templates",
    "adapters": "07-adapters",
    "scripts": "08-scripts",
    "governance": "00-governance"
  },
  "recordLocations": {
    "resourceInventory": "00-governance/records/cursor-inventory.json",
    "conflictRegister": "00-governance/records/conflicts.json",
    "approvalRegister": "00-governance/records/approvals.json",
    "rollbackProcedure": "00-governance/records/rollback.md",
    "evidenceRegister": "00-governance/records/evidence.json",
    "externalSkillRegistry": "00-governance/records/external-skills.json"
  },
  "scopeBoundaries": {
    "SCOPE-RESOURCE-HUB": "vibe-code-framework",
    "SCOPE-CORE": "cursor_framework",
    "SCOPE-WEB": "cursor_framework_web",
    "SCOPE-SETUP": "cursor-setup-gui-wpf",
    "CURSOR-ADAPTER-BOUNDARY": ".cursor"
  },
  "resources": [
    {
      "resourceId": "hub-core-rules",
      "resourceType": "rules",
      "canonicalSource": "01-core-rules",
      "sourceType": "SOT-CANONICAL",
      "owner": "LEAD",
      "maintainer": "DEV",
      "consumers": ["07-adapters/*", "project consumers"],
      "distributionMethod": "08-scripts/sync-adapters.ps1",
      "generationMethod": "Cursor .mdc frontmatter is generated by the adapter sync when required",
      "version": "1.0.0"
    },
    {
      "resourceId": "hub-skills",
      "resourceType": "skills",
      "canonicalSource": "03-skills",
      "sourceType": "SOT-CANONICAL",
      "owner": "LEAD",
      "maintainer": "DEV",
      "consumers": ["07-adapters/*", "project consumers"],
      "distributionMethod": "08-scripts/sync-adapters.ps1",
      "generationMethod": "Copy to tool-specific skill directories",
      "version": "1.0.0"
    },
    {
      "resourceId": "hub-agents",
      "resourceType": "agents",
      "canonicalSource": "04-agents",
      "sourceType": "SOT-CANONICAL",
      "owner": "LEAD",
      "maintainer": "DEV",
      "consumers": ["07-adapters/*", "project consumers"],
      "distributionMethod": "08-scripts/sync-adapters.ps1",
      "generationMethod": "Copy to tool-specific agent directories",
      "version": "1.0.0"
    },
    {
      "resourceId": "cursor-project-boundary",
      "resourceType": "adapter-boundary",
      "canonicalSource": "vibe-code-framework/07-adapters/cursor",
      "sourceType": "SOT-CANONICAL",
      "owner": "LEAD",
      "maintainer": "DEV",
      "consumers": [".cursor"],
      "distributionMethod": "08-scripts/install.ps1 or sync-adapters.ps1",
      "generationMethod": "Tool-specific adapter files",
      "version": "1.0.0",
      "notes": "Existing root .cursor content is not bulk-migrated automatically; project-specific, generated, and legacy content requires per-resource classification."
    }
  ],
  "cursorClassification": {
    "sharedResourceCanonicalSource": "vibe-code-framework",
    "defaultAdapterBoundary": ".cursor",
    "classifications": {
      "rules": "CURSOR_SPECIFIC or LEGACY_RESOURCE until each file is mapped",
      "skills": "SHARED_RESOURCE only when a matching canonical skill exists; otherwise UNKNOWN_RESOURCE",
      "agent-skills": "LEGACY_RESOURCE",
      "cache": "GENERATED_RESOURCE",
      "memory": "GENERATED_RESOURCE",
      "context.json": "GENERATED_RESOURCE",
      "project-files": "PROJECT_SPECIFIC",
      "unmapped": "UNKNOWN_RESOURCE"
    },
    "destructiveMigration": "BLOCKED until per-resource dependency, owner, consumer, and rollback evidence exist"
  },
  "unblockConditions": [
    {
      "conditionId": "COND-RUNTIME-001",
      "status": "PASS",
      "owner": "DEV",
      "requiredFor": ["TEST-001"],
      "requirement": "Install Python >= 3.10, create an isolated environment, install the project's dev dependencies, and run python -m pytest -q.",
      "evidenceRequired": ["python --version", "dependency installation output", "pytest output and exit code"],
      "evidenceIds": ["EVD-RUNTIME-LOCAL-001", "EVD-VERIFY-006"]
    },
    {
      "conditionId": "COND-INVENTORY-001",
      "status": "BLOCKED",
      "owner": "DEV",
      "requiredFor": ["SOT-001", "SOT-002", "SOT-005", "SOT-008"],
      "requirement": "Resolve every UNKNOWN_RESOURCE under .cursor with classification, canonical source, owner, maintainer, consumer, dependency, version, and distribution method.",
      "evidenceRequired": ["per-resource inventory", "old-to-new mapping", "dependency/consumer scan"],
      "evidenceIds": ["EVD-INVENTORY-001"]
    },
    {
      "conditionId": "COND-CONFLICT-001",
      "status": "BLOCKED",
      "owner": "LEAD",
      "requiredFor": ["SOT-003", "SOT-007"],
      "requirement": "Review duplicate or conflicting resources and record one canonical authority plus a conflict-resolution decision for each conflict.",
      "evidenceRequired": ["content comparison", "history/ownership review", "approved conflict decision"]
    },
    {
      "conditionId": "COND-APPROVAL-001",
      "status": "PENDING",
      "owner": "OWN",
      "requiredFor": ["SOT-008", "APPROVAL-001"],
      "requirement": "Obtain named approval for ownership-changing or destructive migration before writing, deleting, or replacing any project .cursor resource.",
      "evidenceRequired": ["Approval Record", "Change IDs", "risk acceptance and conditions"]
    },
    {
      "conditionId": "COND-ROLLBACK-001",
      "status": "PASS",
      "owner": "REL",
      "requiredFor": ["SAFE-001", "SOT-008"],
      "requirement": "Define and test a target-only rollback/restore procedure, including backup location, restore command, and verification after restore.",
      "evidenceRequired": ["rollback procedure", "isolated dry-run", "restore verification"],
      "evidenceIds": ["EVD-ROLLBACK-TARGET-001"]
    },
    {
      "conditionId": "COND-ACCEPTANCE-001",
      "status": "PASS",
      "owner": "QA",
      "requiredFor": ["BUILD-001", "TEST-001", "ADAPTER-001", "SOT-001"],
      "requirement": "Re-run validator, inventory, adapter discovery/smoke tests, Python tests, web build, and WPF build after all approved changes.",
      "evidenceRequired": ["new evidence IDs", "exit codes", "final scope summaries"],
      "evidenceIds": [
        "EVD-VERIFY-006",
        "EVD-VERIFY-009",
        "EVD-ADAPTER-SMOKE-004",
        "EVD-BUILD-WEB-001",
        "EVD-BUILD-WPF-001"
      ]
    }
  ],
  "verificationCriteria": [
    "SOT-001",
    "SOT-002",
    "SOT-003",
    "SOT-004",
    "SOT-005",
    "SOT-006",
    "SOT-007",
    "SOT-008",
    "SOT-009",
    "SOT-010",
    "REF-001",
    "CONFIG-001",
    "DOC-001",
    "HUB-001",
    "ADAPTER-001"
  ]
}
